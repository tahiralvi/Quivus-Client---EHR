			private function cc():void
			{
				vbGridController = new VBGridController(null, null, null, doValidateRecord);
				vbGridController.dataGrid = id_DataGrid;
				
				vbGridController.firstEditableColIdx = 2;
				vbGridController.firstEditablePropertyName = "Status";
				vbGridController.sectionName = QSConstants.SOCIAL_HISTORY_MODULE_NAME;
				
				if (!dataGridActionsData)
					dataGridActionsData = {};
				
				dataGridActionsData["noteDataFields"] = {subject: "", note: "Note", header: "Social", visitDate: "VisitDate"};
				dataGridActionsData["dictationDataField"] = "DictationID";
				//dataGridActionsData["recordIDField"] = "ID";
				//dataGridActionsData["section"] = QIPopUpManager.VB_COMPREHENSIVE_HISTORY;
			}
			
			public function doValidateRecord(event:DataGridEvent):void
			{
				var validationRes:ValidationResultEvent;
				
				var comboEditor:LabelComboBox;
				var yesNoEditor:YesNoItemEditor;
				var dateEditor:DateFieldEditor;
				
				var socialHistoryDTO:SocialHistoryDTO = event.itemRenderer.data as SocialHistoryDTO;
				
				if (!socialHistoryDTO)
					return;
				
				switch (event.dataField)
				{
					case "Status":
						
						comboEditor = SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor;
						
						if (comboEditor.selectedItem)
						{
							event.itemRenderer.data.Status = comboEditor.selectedItem;
						
							event.itemRenderer.data.IsDirty = true;
							
							var canEdit:Boolean = true;
							
							if (comboEditor.selectedItem == "No")
							{
								canEdit = false;
							}
								
							else
							{
								if (comboEditor.selectedItem != "Yes" && comboEditor.selectedItem != "No")
								{
									event.itemRenderer.data.MaritalStatusID = VBUtilityFunctions.getMaritalStatusId(comboEditor.selectedItem);
								}
							}
							
							for (var i:int = 3; i < 9; i++)
							{
								id_DataGrid.columns[i].editable = canEdit;
							}
						}
						
						break;
					
					case "Current":
						
						comboEditor = SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor;
						
						comboValidator.source = comboEditor;
						comboValidator.error = "Select Current from list";
						
						validationRes = comboValidator.validate(comboEditor.selectedItem);
						
						
						if (validationRes && !validationRes.results)
						{
							if (comboEditor.selectedItem == "Present")
								event.itemRenderer.data.Current = QSConstants.STRING_YES_UI;
							
							else
								event.itemRenderer.data.Current = QSConstants.STRING_NO_UI;
							
							event.itemRenderer.data.IsDirty = true;
							
							hasViewChanged = _hasGridChanged = true;
						}
						
						break;
					
					case "Type":
					case "Amount":
						
						comboEditor = SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor;
						
						if (comboEditor.textInput.text)
						{
							if (event.dataField == "Type")
								event.itemRenderer.data.Type = comboEditor.textInput.text;
							
							else
								event.itemRenderer.data.Amount = comboEditor.textInput.text;
							
							event.itemRenderer.data.IsDirty = true;
							
							hasViewChanged = _hasGridChanged = true;
						}
						
						break;
					
					case "Educated":
						
						yesNoEditor = id_DataGrid.itemEditorInstance as YesNoItemEditor;
						
						if (yesNoEditor)
						{
							event.itemRenderer.data.Educated = yesNoEditor.isYes;
							event.itemRenderer.data.IsDirty = true;
						}
						
						break;
					
					case "OnSet":
					case "EndDate":
						
						dateEditor = id_DataGrid.itemEditorInstance as DateFieldEditor;
						
						if (dateEditor)
						{
							if (event.dataField == "OnSet")
								event.itemRenderer.data.OnSet = dateEditor.text;
							
							else
								event.itemRenderer.data.EndDate = dateEditor.text;
							
							event.itemRenderer.data.IsDirty = true;
						}
						
						break;
				}
			}
			
			public function displayRowNum(oItem:Object, iCol:int):String
			{
				var ret:String;
				try
				{
					var rowNumber:int = id_DataGrid.dataProvider.getItemIndex(oItem) + 1; //Sort able column fails some how, don't know why?
					ret = String(rowNumber);
				}
				catch (e:Error)
				{
					ret = "##";
				}
				
				return ret;
			}
			
			public function RecordLevelNotesStatus(hasNotes:Boolean, data:Object):void
			{
				if( hasNotes ) 
					data.Status = QSConstants.STRING_FALSE;
				else
					data.Status = QSConstants.STRING_TRUE;
				
				model.socialHistoryDTOListByPatient.refresh();
			}
			
			public function getStatusLabel(item:Object, iCol:int):String
			{
				if (item.Status == QSConstants.STRING_TRUE)
					return QSConstants.STRING_YES_UI;
				
				else if (item.Status == QSConstants.STRING_FALSE)
					return QSConstants.STRING_NO_UI;
				
				else
					return VBUtilityFunctions.getMeritalStatus(item.MaritalStatusID);
			}
			
			public function getCurrentLabel(obj:Object, dgc:DataGridColumn):String
			{
				if( obj.Current == QSConstants.STRING_YES_UI )
					return "Present";
				if( obj.Current == QSConstants.STRING_NO_UI )
					return "Past";
				
				return "";
			}
			
			public function getEducatedLabel(item:Object, iCol:int):String
			{
				if (!item)
					return "";
				
				if (item.Educated == QSConstants.STRING_TRUE)
					return QSConstants.STRING_YES_UI;
				
				else 
					return QSConstants.STRING_NO_UI;
			}
			
			public function getOnSetDateLabel(oItem:Object, iCol:int):String
			{
				var strDate:String = '';
				
				if (oItem && oItem.OnSet)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.OnSet));
					
					strDate = formatDateTime.format(dateRecieved);
					
					var nullDate:Date = QSConstants.NULL_DATE;
					
					if (dateRecieved.getFullYear() <= nullDate.getFullYear() && dateRecieved.getMonth() <= nullDate.getMonth())
						strDate = "";
				}
				
				return strDate;
			}
			
			public function getEndDateLabel(oItem:Object, iCol:int):String
			{
				var strDate:String = '';
				
				if (oItem && oItem.EndDate)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.EndDate));
					
					strDate = formatDateTime.format(dateRecieved);
					
					var nullDate:Date = QSConstants.NULL_DATE;
					
					if (dateRecieved.getFullYear() <= nullDate.getFullYear() && dateRecieved.getMonth() <= nullDate.getMonth())
						strDate = "";
				}
				
				return strDate;
			}
			
			private function button1_clickHandler(event:MouseEvent):void
			{
				if(model.socialHistoryDTOListByPatient!=null){
					model.socialHistoryDTOListByPatient.filterFunction=myFilter;
					model.socialHistoryDTOListByPatient.refresh();
				}
			}
			
			private function myFilter(obj:*):Boolean
			{
				if(model.vbFilter == QSConstants.BY_VISIT)
				{
					if(model.vbVisitId == obj.VisitID)
					{
						return true;
					}
					else
					{
						return false;
					}
				}
				
				return true;
			}
			
