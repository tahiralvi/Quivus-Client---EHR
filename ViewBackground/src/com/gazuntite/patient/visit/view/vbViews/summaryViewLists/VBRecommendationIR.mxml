<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="true">
	<s:layout>
		<s:VerticalLayout horizontalAlign="center" gap="1" paddingBottom="2" />
	</s:layout>
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			import mx.states.OverrideBase;

			override public function set data(value:Object):void
			{
				super.data= value;
				
				if(data.Description==null || data.Description.length==0)
				{
					id_Plan.visible=true;
					id_description.visible=false;
				}
				else if(data.Description!=null && data.Description.length>0)
				{
					id_Plan.visible=false;
					id_description.visible=true;
				}
			}

		]]>
	</fx:Script>
	<fx:Declarations>
		<mx:DateFormatter id="formatDateTime" formatString="MM/DD/YY" />
	</fx:Declarations>
	<s:SkinnableContainer width="100%" skinClass="com.adobe.gazuntite.skins.viewBackground.skinnableContainers.VB_VisitDate_BG">
		<s:layout>
			<s:HorizontalLayout horizontalAlign="center" verticalAlign="middle" />
		</s:layout>		
		<s:Label text="{formatDateTime.format(data.VisitDate)}" textAlign="center" fontFamily="Calibri" fontSize="10" color="#ffffff"/>
	</s:SkinnableContainer>	
	<s:HGroup width="100%" id="id_Plan">		
		<s:HGroup width="130">			
		<s:Label text="{data.Plan.PlanName}" maxDisplayedLines="1" width="100%" maxWidth="130" fontFamily="Calibri" fontSize="11" color="#333333"/>
		</s:HGroup>
		
		<s:Label text="{data.Duration.DurationName}"  textAlign="left"  fontFamily="Calibri" fontSize="11" color="#333333"/>
	</s:HGroup>
	<s:HGroup width="100%" id="id_description">		
		<s:HGroup width="130">			
			<s:Label text="{data.Description}" maxDisplayedLines="1" width="100%" maxWidth="100" fontFamily="Calibri" fontSize="11" color="#333333"/>
		</s:HGroup>
		
	</s:HGroup>
	
	<s:Line x="1" xTo="{this.width-20}">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#CCCCCC" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Line>
</s:ItemRenderer>
