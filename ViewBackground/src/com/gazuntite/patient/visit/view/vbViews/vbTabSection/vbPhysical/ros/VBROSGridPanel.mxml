			private function switchPageForGridView( event:Event ):void
			{
				if (UtilityFunctions.IsNullOrEmpty(model.rosCurrentPageByPatient))
					model.rosCurrentPageByPatient = VBUtilityFunctions.getNewPageDTOWithDefaultValues();
				
				var lros:LoadROSByPatientIdPagedEvent = new LoadROSByPatientIdPagedEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(lros); 
			}
			
			private function id_PaginationFilterView_RefreshViewHandler(event:Event):void
			{
