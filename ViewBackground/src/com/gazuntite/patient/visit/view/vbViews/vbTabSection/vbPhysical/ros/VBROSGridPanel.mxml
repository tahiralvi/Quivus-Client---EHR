			private function customizeROSData():void
			{
				var dataPvdr:ArrayCollection = new ArrayCollection();
				
				for (var j:int = 0; j < model.rosDTOList.length; j++)
				{
					var rosDTO:Object/*ROSDTO*/ = model.rosDTOList.getItemAt(j);// as ROSDTO;
					
					if (rosDTO)
					{
						var children:ArrayCollection = rosDTO.children;
						
						if (children)
						{
							var childStr:String = "";
							var childNotes:String = "";
							
							for (var i:int = 0; i < children.length; i++)
							{
								var childROS:Object/*ROSDTO*/ = children[i];
								
								if (childROS.IsNormal)
								{
									var normal:String = childROS.IsNormal == QSConstants.STRING_TRUE ? "NORMAL":"ABNORMAL";
									childStr += childROS.SubCategoryName + ": " + normal + ", ";
									if( childROS.Notes && childROS.Notes.length )
										childNotes +=  childROS.SubCategoryName + ": " + childROS.Notes + ", ";
								}
							}  
							
							if( childStr && childStr.length )
							{
								trace (childStr);
								var data:Object = {type: "", typeValue:"", notes:""};
								data["type"] = rosDTO.MainCategoryName;
								data["typeValue"] = childStr.substr(0, childStr.length-2);
								if( childNotes && childNotes.length )
									data["notes"] = childNotes.substr(0, childNotes.length-2);
								data["IsNormal"] = childROS.IsNormal;
								dataPvdr.addItem(data);
							}
						}
					}
				}
				
				if (dataPvdr.length)
				{
					var type:DataGridColumn = new DataGridColumn();
					type.headerText = "Type";
					type.dataField = "type";
					
					var typeValue:DataGridColumn = new DataGridColumn();
					typeValue.headerText = "Type value";
					typeValue.dataField = "typeValue";
					typeValue.wordWrap = true;
					
					var notes:DataGridColumn = new DataGridColumn();
					notes.headerText = "Notes";
					notes.dataField = "notes";
					notes.wordWrap = true;
					
					/* id_DataGrid.columns = new ArrayCollection([{subColumns: 
					[{type: type}, {typeValue: typeValue}, {notes: notes}]
					}]); */
					
					id_DataGrid.dataProvider = new ArrayCollection([{subDataProvider: dataPvdr}]);
				}
			}
			
