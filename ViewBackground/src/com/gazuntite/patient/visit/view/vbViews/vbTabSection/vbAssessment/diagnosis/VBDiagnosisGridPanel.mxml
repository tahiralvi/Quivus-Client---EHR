			private function id_VBViews_changeHandler(event:IndexChangedEvent):void
			{	
				switch (event.newIndex)
				{
					case 0:
						
						vbGridController.dataGrid = acuteGrid.id_DiagnosisAcuteGrid;
						
						break;
					
					case 1:
						
						vbGridController.dataGrid = chronicGrid.id_DiagnosisChronicGrid;
						
						break;
					
					case 2:
						
						vbGridController.dataGrid = resolvedGrid.id_DiagnosisResolvedGrid;
						
						break;
				}
			}
			
			public function doValidateRecord(event:DataGridEvent):void
			{
				if (!event.currentTarget)
					return;
			
				var dataGrid:LabelDataGrid;
				
				if (event.currentTarget is LabelDataGrid)
					dataGrid = event.currentTarget as LabelDataGrid;
				
				if (!dataGrid)
					return;
					
				var validationRes:ValidationResultEvent;
				
				var dateEditor:DateFieldEditor;
				var comboEditor:LabelComboBox;
				var yesNoEditor:YesNoItemEditor;
				
				if (event.dataField == "OnSet")
				{
					dateEditor = event.target.itemEditorInstance as DateFieldEditor;
					
					if (dateEditor && event.itemRenderer && event.itemRenderer.data && event.itemRenderer.data.hasOwnProperty("OnSet"))
					{
						event.itemRenderer.data.OnSet = dateEditor.text;
					}
					
					event.itemRenderer.data.IsDirty = true;
				}
				
				else if (event.dataField == "IcdDto.IcdCodeName" || event.dataField == "IcdDto.IcdCodeDescription")
				{
					comboEditor = SparkComboBoxItemEditor(dataGrid.itemEditorInstance).id_ComboEditor;
					
					comboValidator.error = "Invalid diagnosis";
					comboValidator.source = comboEditor;
					comboValidator.property = "selectedItem";
					
					validationRes = comboValidator.validate(comboEditor.selectedItem);
					
					if (validationRes && !validationRes.results)
					{
						event.itemRenderer.data.IcdDto = comboEditor.selectedItem;
						event.itemRenderer.data.IcdDto.IcdCodeName = comboEditor.selectedItem.IcdCodeName;
						event.itemRenderer.data.IsDirty = true;
					}
				}
				
				else if (event.dataField == "IsChronic" || event.dataField == "IsActive")
				{
					yesNoEditor = dataGrid.itemEditorInstance as YesNoItemEditor;
					
					if (!yesNoEditor)
						return;
					
					var isYes:Boolean = (yesNoEditor.isYes == QSConstants.STRING_TRUE) ? true : false;
					
					if (event.dataField == "IsChronic")
						changeDiagnosisType(isYes, dataGrid, event);
					
					else
						changeDiagnosisStatus(isYes, dataGrid, event);
						
				}
			}
			
			private function changeDiagnosisType(isYes:Boolean, dataGrid:LabelDataGrid, event:DataGridEvent):void
			{
				if (!dataGrid || !event)
					return;
				
				switch (isYes)
				{
					case true:
						
						if (dataGrid.id == "id_DiagnosisChronicGrid")
						{
							event.itemRenderer.data.IsChronic = true;
							event.itemRenderer.data.IsDirty = true;
						}
						
						else if (dataGrid.id == "id_DiagnosisAcuteGrid")
						{
							if (isAlertVisible)
								return;
							
							isAlertVisible = true;
							
							Alert.show("Are you sure want to change diagnosis type  to chronic", "Diagnosis change type confirmation", 
								Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, function(evt:CloseEvent):void
								{
									event.itemRenderer.data.IsDirty = true;
									
									switch (evt.detail)
									{
										case Alert.YES:
											
											event.itemRenderer.data.IsChronic = true;
											
											break;
										
										case Alert.NO:
											
											event.itemRenderer.data.IsChronic = false;
											
											break;
									}
									
									return;
								});
						}
						
						break;
					
					case false:
						
						if (dataGrid.id == "id_DiagnosisChronicGrid")
						{
							if (isAlertVisible)
								return;
							
							isAlertVisible = true;
							
							Alert.show("Are you sure want to change diagnosis type  to acute", "Diagnosis change type confirmation", 
								Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, function(evt:CloseEvent):void
								{
									event.itemRenderer.data.IsDirty = true;
									
									switch (evt.detail)
									{
										case Alert.YES:
											
											event.itemRenderer.data.IsChronic = false;
											
											break;
										
										case Alert.NO:
											
											event.itemRenderer.data.IsChronic = true;
											
											break;
									}
									
									return;
								});
						}
						
						else if (dataGrid.id == "id_DiagnosisAcuteGrid")
						{
							event.itemRenderer.data.IsChronic = false;
							event.itemRenderer.data.IsDirty = true;
						}
						
						break;
				}
			}
			
			private function changeDiagnosisStatus(isYes:Boolean, dataGrid:LabelDataGrid, event:DataGridEvent):void
			{
				switch (isYes)
				{
					case true:
						
						if (dataGrid.id == "id_DiagnosisResolvedGrid")
						{
							if (isAlertVisible)
								return;
							
							isAlertVisible = true;
							
							Alert.show("Are you sure want to change diagnosis status to inactive", "Diagnosis change status confirmation", 
								Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, function(evt:CloseEvent):void
								{
									switch (evt.detail)
									{
										case Alert.YES:
											
											event.itemRenderer.data.IsActive = true;
											event.itemRenderer.data.IsDirty = true;
											
											break;
										
										case Alert.NO:
											
											event.itemRenderer.data.IsActive = false;
											event.itemRenderer.data.IsDirty = true;
											
											break;	
									}
									
									return;
								});
						}
						else
						{
							event.itemRenderer.data.IsActive = true;
							event.itemRenderer.data.IsDirty = true;
						}
						
						break;
					
					case false:
						
						if (dataGrid.id == "id_DiagnosisResolvedGrid")
						{
							event.itemRenderer.data.IsActive = false;
							event.itemRenderer.data.IsDirty = true;
						}
						else
						{
							if (isAlertVisible)
								return;
							
							isAlertVisible = true;
							
							Alert.show("Are you sure want to change diagnosis status to inactive", "Diagnosis change status confirmation", 
								Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, function(evt:CloseEvent):void
								{
									switch (evt.detail)
									{
										case Alert.YES:
											
											event.itemRenderer.data.IsActive = false;
											event.itemRenderer.data.IsDirty = true;
											
											break;
										
										case Alert.NO:
											
											event.itemRenderer.data.IsActive = true;
											event.itemRenderer.data.IsDirty = true;
											
											break;
									}
									
									return;
								});
						}
						
						break;
				}
			}
			
			private function switchPageForGridView4Acute(event:Event):void
			{	
				if (VBUtilityFunctions.isNullOrEmptyPage(model.diagnosisAcuteCurrentPageByPatient))
					model.diagnosisAcuteCurrentPageByPatient = VBUtilityFunctions.getNewPageDTOWithDefaultValues();
				
				var lda:LoadAcuteDiagnosisByPatientIdPagedEvent = new LoadAcuteDiagnosisByPatientIdPagedEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(lda); 
