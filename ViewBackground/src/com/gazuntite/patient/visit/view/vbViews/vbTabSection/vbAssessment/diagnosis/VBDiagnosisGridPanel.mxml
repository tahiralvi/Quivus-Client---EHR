			private function button1_clickHandler(event:MouseEvent):void
			{
				if(model.diagnosisDTOListByPatientId!=null){
					model.diagnosisDTOListByPatientId.filterFunction=myFilter;
					model.diagnosisDTOListByPatientId.refresh();
				}
				
				if(model.diagnosisDTOAcuteListByPatientId!=null)
				{
					model.diagnosisDTOAcuteListByPatientId.filterFunction=myFilter;
					model.diagnosisDTOAcuteListByPatientId.refresh();
				}
				
				if(model.diagnosisDTOChronicListByPatientId!=null)
				{
					model.diagnosisDTOChronicListByPatientId.filterFunction=myFilter;
					model.diagnosisDTOChronicListByPatientId.refresh();
				}
				
				if(model.diagnosisDTOResolvedListByPatientId!=null)
				{
					model.diagnosisDTOResolvedListByPatientId.filterFunction=myFilter;
					model.diagnosisDTOResolvedListByPatientId.refresh();
				}
			}
			
			private function myFilter(obj:*):Boolean
			{
				
				if(model.vbFilter == QSConstants.BY_VISIT)
				{
					if(model.vbVisitId == obj.VisitID)
					{
						return true;
					}
					else
					{
						return false;
					}
				}
				
				return true;
			}
			
