			public function displayVisitDate(item:Object):String
			{
				var vd:Date = item/* as PatientEncounterDTO)*/.VisitDate;
				var formatDateTime:DateFormatter = new DateFormatter();
				var visitDate:String = formatDateTime.format(vd.toDateString());					
				
				return String(visitDate);
			}
			
			
			
