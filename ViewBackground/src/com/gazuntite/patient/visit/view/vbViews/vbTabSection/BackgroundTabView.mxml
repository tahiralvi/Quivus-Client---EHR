			///Tahir Alvi (13-09-2012)- for updated records on every tab openning*******************
			private function loadAllAllergires():void
			{
				if(model.QIAllergyDTOList){
					model.QIAllergyDTOList.removeAll();
				}
				
				if(model.gaxenID.length > 0 && model.gaxenID != "" && model.gaxenID != "0")
				{
					model.thirdSectionLabel = '';
					
					var alEvent : QSAllergyEvent = new QSAllergyEvent(2, model.gaxenID, callBackAllergy);
					CairngormEventDispatcher.getInstance().dispatchEvent( alEvent );
				}
				
				dispatchEvent(new Event('UpdateAllergEvent', true, true));
			}
			
			// call back allergy 
			private function callBackAllergy(arrAllergy:ArrayCollection):void
			{
				if(model.QIAllergyDTOList)
					model.QIAllergyDTOList.removeAll();
				else
					model.QIAllergyDTOList = new ArrayCollection();
				
				model.QIAllergyDTOList.addAll(arrAllergy);
				
				if(model.QIAllergyDTOList.length > 0)
				{					
					var allergyDto:AllergDTO = new AllergDTO();
					allergyDto			= model.QIAllergyDTOList.getItemAt(0) as AllergDTO;
					//Tahir Alvi - Set Third Section data && NKDA LAbel Flag
					
					if(!allergyDto.isNKDA)
					{
						model.thirdSectionLabel = allergyDto.AllergyName;
						model.AllergyNKDAFlag 	= false;
					}
					else if(allergyDto.isNKDA)
					{
						model.thirdSectionLabel = 'No Known Drug Allergies';
						model.AllergyNKDAFlag 	= true;
					}
				}				
			}
			
			private function loadPrescriptionMedication():void
			{
				var securityHeaderXML:XML;
				securityHeaderXML = <Header />;					
				securityHeaderXML.@EUserName = "TESTUSER";
				securityHeaderXML.@EPassword = "TESTPASS";
				securityHeaderXML.@ClinicID	= "sad";
				
				if(model.gaxenID.length > 0 && model.gaxenID != "" && model.gaxenID != "0")
				{
					var loadPatientPrescriptionEvent: LoadPatientMedEvent = new LoadPatientMedEvent("0", model.gaxenID, PrescriptionLoaded);				
					loadPatientPrescriptionEvent.data = securityHeaderXML; 				
					
					CairngormEventDispatcher.getInstance().dispatchEvent(loadPatientPrescriptionEvent);
				}
				
			}
						
			public function PrescriptionLoaded(patientMedAC:ArrayCollection, patientChronicMedAC:ArrayCollection, patientMedAC_inactive:ArrayCollection, patientChronicMedAC_inactive:ArrayCollection):void
			{
				if(model.patientMedACList)
					model.patientMedACList.removeAll();
				else
					model.patientMedACList = new ArrayCollection();
				
				if(model.patientMedACInactiveList)
					model.patientMedACInactiveList.removeAll();
				else
					model.patientMedACInactiveList = new ArrayCollection();
				
				if(model.patientChronicMedACInactiveList)
					model.patientChronicMedACInactiveList.removeAll();
				else
					model.patientChronicMedACInactiveList = new ArrayCollection();
				
				if(model.patientChronicMedACList)
					model.patientChronicMedACList.removeAll();
				else
					model.patientChronicMedACList = new ArrayCollection();
				
				model.patientMedACList = patientMedAC;//prescription list
				model.patientChronicMedACList = patientChronicMedAC;//medication list
				model.patientMedACInactiveList = patientMedAC_inactive;
				model.patientChronicMedACInactiveList = patientChronicMedAC_inactive;
				
				//For QI load
				if(model.chMedicationDTOList)
					model.chMedicationDTOList.removeAll();
				else
					model.chMedicationDTOList = new ArrayCollection();
				
				if(model.prescriptionDTOList)
					model.prescriptionDTOList.removeAll();
				else
					model.prescriptionDTOList = new ArrayCollection();
				
				model.chMedicationDTOList = patientChronicMedAC;
				model.prescriptionDTOList = patientMedAC;
			}
			
		]]>
