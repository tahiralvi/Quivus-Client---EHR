			private function cc():void
			{
				vbGridController = new VBGridController();
				vbGridController.dataGrid = id_LabsRecordGrid;
				
				vbGridController.firstEditableColIdx = 2;
				vbGridController.firstEditablePropertyName = "CollectionDate";
				
				vbGridController.sectionName = QSConstants.LAB_OUT_MODULE_NAME;
				vbGridController.recordValidationCallBack = doValidateRecord;
				
				if (!dataGridActionsData)
					dataGridActionsData = {};
				
				dataGridActionsData["noteDataFields"] = {subject: "NoteSubject", note: "Note", header: "LIONICLabTestType.Name", visitDate: "VisitDate"};
				dataGridActionsData["dictationDataField"] = "DictationID";
				//dataGridActionsData["recordIDField"] = "PatientLabID";
				//dataGridActionsData["section"] = QIPopUpManager.LAB_OUT;
			}
			
			public function doValidateRecord(event:DataGridEvent):void
			{
				var validationRes:ValidationResultEvent;
				
				var comboEditor:LabelComboBox;
				var dateEditor:DateFieldEditor;
				var textEditor:TextInput;
				
				var dataFld:String = event.dataField;
				
				switch (dataFld)
				{
					case "CollectionDate":
						
						dateEditor = id_LabsRecordGrid.itemEditorInstance as DateFieldEditor;
						
						if (!dateEditor)
							return;
						
						validationRes = dateValidator.validate(dateEditor.selectedDate);
						
						if (validationRes && !validationRes.results)
						{
							event.itemRenderer.data.CollectionDate = dateEditor.text;
							
							event.itemRenderer.data.IsDirty = true;
						}
						
						break;
					
					case "LabTestType.Name":
					case "LIONICLabTestType.testNum":
					case "LIONICLabTestType.Name":
					case "LabType.Name":
						
						comboEditor = SparkComboBoxItemEditor(id_LabsRecordGrid.itemEditorInstance).id_ComboEditor;
						
						comboValidator.source = comboEditor;
						comboValidator.property = "selectedItem";
						
						validationRes = comboValidator.validate(comboEditor.selectedItem);
						
						if (validationRes && !validationRes.results)
						{
							if (dataFld == "LabTestType.Name")
								event.itemRenderer.data.LabTestType = comboEditor.selectedItem;
							
							else if (dataFld == "LIONICLabTestType.testNum" || dataFld == "LIONICLabTestType.Name")
								event.itemRenderer.data.LIONICLabTestType = comboEditor.selectedItem;
							
							else if (dataFld == "LabType.Name")
								event.itemRenderer.data.LabType = comboEditor.selectedItem;
							
							event.itemRenderer.data.IsDirty = true;
						}
						
						break;
				}
			}
			
