			protected function id_prevBtn_clickHandler(event:MouseEvent):void
			{
				if(currentIndex > 1)
				{
					currentIndex -= 1 ;
					
					hidePanels();
					SelectNextByIndex();
				}
			}
			
			
			protected function id_nextBtn_clickHandler(event:MouseEvent):void
			{
				if(currentIndex < 16)
				{
					currentIndex += 1 ;
					hidePanels();
					SelectNextByIndex();
				}
			}
			
			private function ShowRespectivePanel(event:MouseEvent):void
			{
				var panelName:String = event.currentTarget.id;
				 var spe:SelectSection = new SelectSection( "selectSection", panelName, true, false );
				dispatchEvent( spe );
				
				(event.currentTarget).setFocus();	
			}
			
			private function onQSViewStateChange(event:QSViewStateEvent):void
			{
				if ( currentExpandedPanel && currentExpandedPanel != event.currentTarget && 
					event.viewState == QSViewStateEvent.EXPANDED_VIEW)
					currentExpandedPanel.expandedView = false;
				
				//ignore state change if panel is in SlideOut state
				if (currentExpandedPanel != event.currentTarget)
				{
					currentExpandedPanel = event.currentTarget as VBCollapsibleView;
				}
			}
