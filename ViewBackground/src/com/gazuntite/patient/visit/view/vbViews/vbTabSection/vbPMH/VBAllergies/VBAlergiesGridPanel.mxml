			private function getOnSet(oItem:Object, iCol:int):String
			{
				var strVisitDate:String = '';
				
				if (oItem && oItem.OnSet)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.OnSet));
					strVisitDate = formatDateTime.format(dateRecieved);
					if( strVisitDate.indexOf('NaN',0) != -1)
						strVisitDate = oItem.OnSet;
				}
				return strVisitDate;
			}
			private function displayVisitDate(oItem:Object, iCol:int):String
			{
				var strVisitDate:String = '';
				
				if (oItem && oItem.VisitDate)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.VisitDate));					
					if( dateRecieved!=null && dateRecieved.fullYear == 1901)
					{
						strVisitDate="N/A";																								
					}
					else						
					{
						strVisitDate= formatDateTime.format(dateRecieved);												
					}
					
				}
				return strVisitDate;
			}
			
			private function setOnSet(oItem:Object,iCol:int):String
			{
				var strVisitDate:String = '';
				
				if (oItem && oItem.OnSet)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.OnSet));
					strVisitDate = formatDateTime.format(dateRecieved);
					if( strVisitDate.indexOf('NaN',0) != -1)
						strVisitDate = oItem.OnSet;
				}
				return strVisitDate;
			}
			private var _isNKDAFlag:Boolean;
			[Bindable]
			public function get isNKDAFlag():Boolean
			{
				return _isNKDAFlag;
			}
			
			public function set isNKDAFlag(value:Boolean):void
			{
				_isNKDAFlag = value;
				
				if(_isNKDAFlag)
				{
					id_DataGrid.visible 			= false;
					id_DataGrid.includeInLayout  = false;
					id_nkda.visible = true;
					id_nkda.includeInLayout = true;
				}
				else
				{
					id_DataGrid.visible 			= true;
					id_DataGrid.includeInLayout  = true;
					id_nkda.visible = false;
					id_nkda.includeInLayout = false;
				}
			}
