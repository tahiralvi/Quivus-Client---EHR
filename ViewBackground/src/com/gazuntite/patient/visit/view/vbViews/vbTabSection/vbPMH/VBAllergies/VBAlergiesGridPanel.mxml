	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
		<mx:DateFormatter id="formatDateTime" formatString="MM/DD/YYYY" />
	</fx:Declarations>
	
	<fx:Binding source="model.AllergyNKDAFlag" destination="isNKDAFlag" />
	
	<common:headerContents>
		<s:Group id="id_mainHeader" width="100%" height="24"> <!--minWidth="{ChromeUtil.topLevelMainContainer.width - 90}"-->
			<s:layout>
				<s:VerticalLayout verticalAlign="bottom" horizontalAlign="center" />
			</s:layout>
			<viewBackground:VBSectionHeader id="id_header" width="{id_mainHeader.width - 8}" HeadingLable="Allergies"
											Skin="com.adobe.gazuntite.skins.viewBackground.skinnableContainers.VBBGSectionSkin"/>	<!--SectionNameID="{QSSecurityUtil.VB_ALLERGIES}"-->				   
		</s:Group>
	</common:headerContents>
	
	<s:SkinnableContainer id="id_contents" width="100%" height="100%"  skinClass="com.adobe.gazuntite.skins.viewBackground.skinnableContainers.VBBGSectionSkin">					
		<s:layout>
			<s:VerticalLayout horizontalAlign="center" verticalAlign="top" gap="1" paddingLeft="4" paddingRight="4" paddingBottom="4" paddingTop="4" />
		</s:layout>
		<!--<s:VGroup id="id_NotesArea" width="100%" paddingTop="0" gap="-2">-->
		<viewBackground:VBSectionLevelNotesDictation id="id_notesDictation" width="100%"  />
		
		<!--</s:VGroup>-->
		<s:Button label="Filter" visible="false" includeInLayout="false" id="id_applyFiler"/>	
		<paging:PaginationFilterView id="id_PaginationFilterView" width="100%" page="{model.allergyCurrentPageByPatient}"
									 GoToFirstPage="switchPageForGridView(event)" GoToNextPage="switchPageForGridView(event)" 
									 GoToPreviousPage="switchPageForGridView(event)" GoToLastPage="switchPageForGridView(event)"
									 RefreshView="id_PaginationFilterView_RefreshViewHandler(event)"
									 />
		<s:Label id="id_nkda" text="NO KNOWN DRUG ALLERGIES" fontFamily="Calibri" fontSize="15"  textAlign="center" fontWeight="bold" verticalAlign="top" 
				 visible="false" includeInLayout="false" width="100%" color="#FFFFFF"/>
		<components:LabelDataGrid id="id_DataGrid" width="100%" useRollOver="false" 
								  dataProvider="{model.QIAllergyDTOList}" 
								  rowCount="{id_DataGrid.dataProvider.length + 1}"
								  rowHeight="23"
								  verticalScrollPolicy="on" maxHeight="150"
								  verticalScrollBarStyleName="VScrollBar"
								  columnWidths="{[25,'10%','20%','20%','15%','10%', 100]}">
			<components:columns>
				<mx:DataGridColumn headerText="NKDA" dataField="NKDA" headerRenderer="mx.controls.Label" wordWrap="true" />
				<mx:DataGridColumn headerText="Visit Date" width="100" dataField="VisitDate" headerWordWrap="true" labelFunction="displayVisitDate"/>
				<mx:DataGridColumn headerText="OnSet" dataField="OnSet" headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="setOnSet"/>
				<mx:DataGridColumn headerText="Allergy" dataField="AllergyName" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
				<mx:DataGridColumn headerText="Reaction" dataField="Reaction" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
				<mx:DataGridColumn headerText="Status" dataField="Status" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
				<grid:DataGridColumnEx itemRenderer="com.gazuntite.patient.visit.view.common.DeleteEditOnlyRenderer"
									   data="{dataGridActionsData}" editable="false"/>
			</components:columns>
		</components:LabelDataGrid>
		
	</s:SkinnableContainer>
</common:VBCollapsibleView>
