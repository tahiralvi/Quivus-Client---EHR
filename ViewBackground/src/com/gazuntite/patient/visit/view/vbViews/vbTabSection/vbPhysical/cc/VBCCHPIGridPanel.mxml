						}
					}
					else
					{
						UtilityFunctions.AskMessage(  "Do you want to delete selected record", function():void
						{
							dto.IsDeleted = true;
							dto.IsDirty = true;
							model.HPI_CCDTOListByPatient.filterFunction = filterDeletedItems;
							model.HPI_CCDTOListByPatient.refresh();
							
							hasViewChanged = true;
						});
					}
					
				}*/
			}
			
			private function switchPageForGridView( event:Event ):void
			{	
				if (VBUtilityFunctions.isNullOrEmptyPage(model.HPI_CCCurrentPageByPatient))
					model.HPI_CCCurrentPageByPatient = VBUtilityFunctions.getNewPageDTOWithDefaultValues();
				
				var lphpicc:LoadHPIByPatientIdPagedEvent = new LoadHPIByPatientIdPagedEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(lphpicc); 
			}
			
			private function id_PaginationFilterView_RefreshViewHandler(event:Event):void
			{
				if (!VBUtilityFunctions.isNullOrEmptyPage(id_PaginationFilterView.page))
				{
					model.HPI_CCCurrentPageByPatient = id_PaginationFilterView.page;
				}
				
				var lhpi:LoadHPIByPatientIdPagedEvent = new LoadHPIByPatientIdPagedEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(lhpi); 
			}	
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<common:headerContents>
		<s:Group id="id_mainHeader" width="100%" height="24"> <!--minWidth="{ChromeUtil.topLevelMainContainer.width - 70}"-->
			<s:layout>
				<s:VerticalLayout verticalAlign="bottom" horizontalAlign="center" />
			</s:layout>
			<viewBackground:VBSectionHeader id="id_header" width="{id_mainHeader.width - 8}" HeadingLable="{QSConstants.VB_SECTION_NAME_CC_HPI}" 
											Skin="com.adobe.gazuntite.skins.viewBackground.skinnableContainers.VBCCPanelSkin"/>	<!-- SectionNameID="{QSSecurityUtil.VB_CCHPI}"	-->				   
		</s:Group>
	</common:headerContents>
	<!--<custom:Contents>-->
		<s:SkinnableContainer id="id_contents" width="100%" height="100%" skinClass="com.adobe.gazuntite.skins.viewBackground.skinnableContainers.VBCCPanelSkin">
			<s:layout>
				<s:VerticalLayout horizontalAlign="center" verticalAlign="top" gap="1" paddingLeft="4" paddingRight="4" paddingBottom="4" paddingTop="0" />
			</s:layout>			
			<s:Button label="Filter" click="button1_clickHandler(event)" visible="false" includeInLayout="false" id="id_applyFiler"/>
			<!--<s:HGroup id="id_NotesArea" width="100%" paddingTop="0" />-->
			<viewBackground:VBSectionLevelNotesDictation id="id_notesDictation" width="100%" />
			
			<paging:PaginationFilterView id="id_PaginationFilterView" width="100%" page="{model.HPI_CCCurrentPageByPatient}"
										 GoToFirstPage="switchPageForGridView(event)" GoToNextPage="switchPageForGridView(event)" 
										 GoToPreviousPage="switchPageForGridView(event)" GoToLastPage="switchPageForGridView(event)"
										 RefreshView="id_PaginationFilterView_RefreshViewHandler(event)"
										 />
			
			<s:List id="id_List" maxHeight="240"  width="100%" itemRenderer="com.gazuntite.patient.visit.view.vbViews.renderer.VBChiefComplaintRenderer"
					contentBackgroundColor="#ECF0DC" selectionColor="#ECF0DC"					
					dataProvider="{model.HPI_CCDTOListByPatient}"
					>
				<s:layout>
					<s:VerticalLayout useVirtualLayout="false" requestedRowCount="{id_List.dataProvider.length}" requestedMinRowCount="0" 
									  paddingLeft="0" paddingRight="0" paddingTop="0" paddingBottom="0" gap="0" verticalAlign="top" horizontalAlign="center"/>
				</s:layout>
			</s:List>
		</s:SkinnableContainer>
