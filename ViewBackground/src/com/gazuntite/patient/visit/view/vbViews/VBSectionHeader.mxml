	<s:SkinnableContainer id="id_pmhHeader" width="100%" height="23" 						  					 
						  skinClass="{Skin}">
		<s:layout>
			<s:HorizontalLayout verticalAlign="middle" />
		</s:layout>
		
		<s:HGroup verticalAlign="middle" horizontalAlign="left" width="100%" paddingLeft="1">
			
			<s:HGroup gap="0" horizontalAlign="left" verticalAlign="middle" width="25">
				
				<s:HGroup verticalAlign="top" paddingTop="-2">				
					<s:Button id="id_CloseBtn" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.whiteCloseButton" toolTip="Close" useHandCursor="true" buttonMode="true"  />
				</s:HGroup>
				
				<buttonSeparators:buttonSeparator />
			</s:HGroup>
			
			<s:HGroup verticalAlign="middle" horizontalAlign="left" width="100%">
				<s:Label id="id_headingLbl" color="#ffffff" fontFamily="Calibri" text="{HeadingLable}"/>	
			</s:HGroup>
			
			<s:HGroup id="commons" horizontalAlign="right" verticalAlign="middle" width="100%" paddingRight="2" gap="0">
				<s:ToggleButton id="id_ChangeIndicator" skinClass="com.adobe.gazuntite.skins.QuickInput.changeIndicator"
								includeInLayout="false" visible="false"/>
				<s:HGroup paddingTop="2" paddingRight="1">
					<s:VGroup width="100%"  horizontalAlign="right" paddingTop="1" gap="-2">
						<s:HGroup gap="0">
							<buttonSeparators:buttonSeparator />
							<s:Button id="id_Save" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.QIHeaderSaveBtn" width="21" height="21" 
									  toolTip="Save" buttonMode="true" useHandCursor="true" click="id_Save_clickHandler(event)"/>
							<buttonSeparators:buttonSeparator />
							
							<s:ToggleButton id="id_iconButtons" height="26"  styleName="whiteIconsToggleButtonSkin" buttonMode="true" useHandCursor="true" 
											click="id_iconButtons_clickHandler(event)" toolTip="Other Options"	/>
							<!--click="id_OptionPopUp.displayPopUp = !id_OptionPopUp.displayPopUp; event.stopImmediatePropagation();"-->
							
						</s:HGroup>
						
						<s:PopUpAnchor id="id_OptionPopUp" width="138"
									   popUpPosition="below"								   
									   displayPopUp="false"								   
									   styleName="popUpBox" 
									   focusOut="id_OptionPopUp_focusOutHandler(event)"
									   focusEnabled="true">
							<s:SkinnableContainer skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.communicationIconsBG" width="100%">
								<s:layout>
									<s:VerticalLayout gap="2" verticalAlign="bottom" horizontalAlign="left" paddingBottom="5" paddingLeft="7" paddingTop="4" />
								</s:layout>
								<s:HGroup width="100%" paddingRight="5" >
									<s:RichText color="#000000" fontSize="12" height="12" kerning="off" text="Other Options" whiteSpaceCollapse="preserve"
												fontFamily="Calibri Bold"/>
									<s:Spacer width="100%"/>
									<s:Button buttonMode="true" id="id_CloseButtonn" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.popupCloseBtnSkin" 
											  toolTip="Close" height="16" width="16"
											  click="id_CloseButtonn_clickHandler(event)"/>
								</s:HGroup>
								
								<s:Button id="id_Voice" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.VBdictationBtnSelected" 
										  buttonMode="true" useHandCursor="true" toolTip="Record Dictation"/>
								<s:Button id="id_NotesBtn" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.VBnotesBtnSelected" 
										  buttonMode="true" useHandCursor="true" toolTip="Record Dictation"/>						
							</s:SkinnableContainer>
						</s:PopUpAnchor>
					</s:VGroup>
				</s:HGroup>
				
				<buttonSeparators:buttonSeparator />
				<s:HGroup paddingTop="0">
					<s:ToggleButton id="id_expandBtn" styleName="whiteExpandButtonSkin"    
									buttonMode="true" useHandCursor="true" toolTip="{id_expandBtn.selected?'Collapse':'Expand'}"
									width="23" height="23" selected="true"/>
				</s:HGroup>
			</s:HGroup>
		</s:HGroup>
	</s:SkinnableContainer>	
</s:Group>
