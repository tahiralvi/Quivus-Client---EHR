			public function setHeaderCapitalCase(value:Boolean):void
			{
				if( value )
				{
					HeadingLable = HeadingLable.toUpperCase();
				}
				else
				{
					HeadingLable = QSAppUtils.TitleCase( HeadingLable );
				}
			}
			
			
