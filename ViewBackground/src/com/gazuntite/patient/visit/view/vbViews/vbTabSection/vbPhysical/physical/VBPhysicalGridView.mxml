			<paging:PaginationFilterView id="id_PaginationFilterView" width="100%" page="{model.physicalsCurrentPageByPatient}"
										 GoToFirstPage="switchPageForGridView(event)" GoToNextPage="switchPageForGridView(event)" 
										 GoToPreviousPage="switchPageForGridView(event)" GoToLastPage="switchPageForGridView(event)"
										 RefreshView="id_PaginationFilterView_RefreshViewHandler(event)"/>
			<components:LabelDataGrid id="id_DataGrid"
									  rowCount="{id_DataGrid.dataProvider.length + 1}" rowHeight="24"
									  width="100%" useRollOver="false" height="100%" maxHeight="150" verticalScrollPolicy="on" horizontalScrollPolicy="off"
						 			  dataProvider="{model.physicalDTOList}"
									  columnWidths="{[30, '15%', '20%', '25%', '15%', 100]}">
				<components:columns>
					<mx:DataGridColumn headerText="Sr.#" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
									   editable="false" labelFunction="displayRowNum"/>
					<mx:DataGridColumn headerText="Visit Date" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
									   editable="false" labelFunction="displayVisitDate"/>
					<mx:DataGridColumn headerText="Physical" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
									   dataField="MainCategoryName" editable="false"/>
					<mx:DataGridColumn headerText="Type Value" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
									   dataField="SubCategoryName" editable="false"/>
					<mx:DataGridColumn headerText="Status" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"
									   dataField="IsNormal" labelFunction="displayStatus">	
						<mx:itemEditor>
							<fx:Component>
								<itemEditors:YesNoItemEditor property="IsYesSelected" isNormalAbnormal="true"/>							
							</fx:Component>
						</mx:itemEditor>
					</mx:DataGridColumn>
					<grid:DataGridColumnEx itemRenderer="com.gazuntite.patient.visit.view.itemrenderer.VBRenderer" 
										   data="{dataGridActionsData}" editable="false"/>
				</components:columns>
			</components:LabelDataGrid>
		</s:SkinnableContainer>
