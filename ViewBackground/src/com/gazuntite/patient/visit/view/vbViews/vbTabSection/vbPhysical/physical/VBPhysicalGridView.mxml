			private function RecordLevelNotesStatus(hasNotes:Boolean, data:Object):void
			{
				if( hasNotes ) 
					data.IsNormal = QSConstants.STRING_FALSE;
				else
					data.IsNormal = QSConstants.STRING_TRUE;
				
				model.physicalDTOList.refresh();
			}
			
			private function filterDeletedItems(item:Object):Boolean
