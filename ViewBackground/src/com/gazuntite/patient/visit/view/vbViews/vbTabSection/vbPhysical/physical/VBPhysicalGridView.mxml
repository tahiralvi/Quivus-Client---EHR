			public function displayStatus(oItem:Object,iCol:int):String
			{
				//Tahir - New implementation of IsAbnormal property in PhysicalsDTO
				var result:String;
				var isNormal:Boolean = (oItem as Object/*PhysicalsDTO*/).IsNormal 	== QSConstants.STRING_TRUE;
				var isAbNormal:Boolean = (oItem as Object/*PhysicalsDTO*/).IsAbNormal == QSConstants.STRING_TRUE;

				if(isNormal)
				{
					result =  "Normal";
				}
				else // if(isAbNormal)
				{
					result =  "Abnormal";
				}
				
				return result; 
			}
			
			protected function slideoutpanel1_QSViewStateChangeHandler(event:QSViewStateEvent):void
