			private function switchPageForGridView( event:Event ):void
			{
				
				if (UtilityFunctions.IsNullOrEmpty(model.physicalsCurrentPageByPatient))
					model.physicalsCurrentPageByPatient = VBUtilityFunctions.getNewPageDTOWithDefaultValues();
				
				 var lp:LoadPhysicalsByPatientIdPagedEvent = new LoadPhysicalsByPatientIdPagedEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(lp); 
			}

			private function id_PaginationFilterView_RefreshViewHandler(event:Event):void
			{
