								 GoToFirstPage="switchPageForGridView(event)" GoToNextPage="switchPageForGridView(event)" 
								 GoToPreviousPage="switchPageForGridView(event)" GoToLastPage="switchPageForGridView(event)"
								 RefreshView="id_PaginationFilterView_RefreshViewHandler(event)"/>
	
	<components:LabelDataGrid id="id_DataGrid"
							  rowCount="{id_DataGrid.dataProvider.length + 1}"
							  width="100%" useRollOver="false" height="100%" maxHeight="150" verticalScrollPolicy="on" horizontalScrollPolicy="off"
							  dataProvider="{model.inHouseLabDTOListByPatient}"
							  columnWidths="{[30, '15%', '10%', '20%', '25%', '15%', 100]}">
		<components:columns>
			<mx:DataGridColumn headerText="Sr.#" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
							   editable="false" labelFunction="displayRowNum"/>
			<mx:DataGridColumn headerText="Visit Date" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
							   editable="false" labelFunction="displayVisitDate"/>
			<mx:DataGridColumn headerText="Test Code" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
							   dataField="InHouseLabTestType.Code" editorDataField="editorText">
				<mx:itemEditor>
					<fx:Component>	
						<itemEditors:SparkComboBoxItemEditor dataProvider="{outerDocument.model.inHouseLabTestTypeDTOList}" labelField="Code" width="80"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Test Name" width="80" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
							   dataField="InHouseLabTestType.Name" editorDataField="editorText">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor dataProvider="{outerDocument.model.inHouseLabTestTypeDTOList}" labelField="Name" width="100%"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Result" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
							   dataField="TestResult" editorDataField="text"/>
