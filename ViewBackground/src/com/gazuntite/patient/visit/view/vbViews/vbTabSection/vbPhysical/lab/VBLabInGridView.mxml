				vbGridController.firstEditablePropertyName = "InHouseLabTestType.Code";
				
				vbGridController.sectionName = QSConstants.LAB_IN_MODULE_NAME;
				vbGridController.recordValidationCallBack = doValidateRecord;
				
				if (!dataGridActionsData)
					dataGridActionsData = {};
				
				dataGridActionsData["noteDataFields"] = {subject: "NoteSubject", note: "Note", header: "InHouseLabTestType.Name", visitDate: "VisitDate"};
				dataGridActionsData["dictationDataField"] = "DictationID";
			}
			
			public function doValidateRecord(event:DataGridEvent):void
			{
				var validationRes:ValidationResultEvent;
				
				var comboEditor:LabelComboBox;
				var textEditor:TextInput;
				
				switch (event.dataField)
				{
					case "InHouseLabTestType.Code":
					case "InHouseLabTestType.Name":
						
						comboEditor = SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor;
						
						comboValidator.error = "Invalid InHouse Lab";
						comboValidator.source = comboEditor;
						comboValidator.property = "selectedItem";
						
						validationRes = comboValidator.validate(comboEditor.selectedItem);
						
						if (validationRes && !validationRes.results)
						{
							event.itemRenderer.data.InHouseLabTestType = comboEditor.selectedItem;
							
							event.itemRenderer.data.IsDirty = true;
						}
						
						break;
					
					case "TestResult":
						
						if (id_DataGrid.itemEditorInstance is TextInput)
							textEditor = id_DataGrid.itemEditorInstance as TextInput;
						
						if (!textEditor)
							return;
						
						event.itemRenderer.data.TestResult = textEditor.text;
						
						event.itemRenderer.data.IsDirty = true;
						
						break;
				}
			}
			
