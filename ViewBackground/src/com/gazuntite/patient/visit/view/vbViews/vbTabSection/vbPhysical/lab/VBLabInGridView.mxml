			protected function button1_clickHandler(event:MouseEvent):void
			{
				/* var mpiEvent : ManagePatientImmunizationEvent = new ManagePatientImmunizationEvent(  );
				CairngormEventDispatcher.getInstance().dispatchEvent( mpiEvent ); */
				if(model.inHouseLabDTOListByPatient!=null){	
					model.inHouseLabDTOListByPatient.filterFunction=myFilter;
					model.inHouseLabDTOListByPatient.refresh();
				}
			}
			
			private function myFilter(obj:*):Boolean
			{
				
				if(model.vbFilter == QSConstants.BY_VISIT)
				{
					if(model.vbVisitId == obj.VisitID)
					{
						return true;
					}
					else
					{
						return false;
					}
				}
				
				return true;
				
			}
			
			public function displayRowNum(item:Object, iCol:int):String
			{
				var strRowNum:String = "";
				
				if (id_DataGrid.dataProvider)
				{
					var rowNum:int = id_DataGrid.dataProvider.getItemIndex(item) + 1;
					strRowNum = String(rowNum);
				}
				
				return strRowNum;
			}
			
			public function displayVisitDate(oItem:Object, iCol:int):String
			{
				var strVisitDate:String = '';
				
				if (oItem && oItem.VisitDate)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.VisitDate));
					strVisitDate = formatDateTime.format(dateRecieved);
					var nullDate:Date = QSConstants.NULL_DATE;
					
					if (dateRecieved.getFullYear() <= nullDate.getFullYear() && dateRecieved.getMonth() <= nullDate.getMonth())
						strVisitDate = "";
				}
				
				return strVisitDate;
			}
			
			private function switchPageForGridView(event:Event):void
			{
				if (UtilityFunctions.IsNullOrEmpty(model.inHouseLabCurrentPageByPatient))
					model.inHouseLabCurrentPageByPatient = VBUtilityFunctions.getNewPageDTOWithDefaultValues();
				
				var lpihl:LoadInHouseLabsByPatientIdPagedEvent = new LoadInHouseLabsByPatientIdPagedEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(lpihl); 
			}
			
			private function id_PaginationFilterView_RefreshViewHandler(event:Event):void
			{
				if (!VBUtilityFunctions.isNullOrEmptyPage(id_PaginationFilterView.page))
					model.inHouseLabCurrentPageByPatient = id_PaginationFilterView.page;
				
				var lpihl:LoadInHouseLabsByPatientIdPagedEvent = new LoadInHouseLabsByPatientIdPagedEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(lpihl); 
