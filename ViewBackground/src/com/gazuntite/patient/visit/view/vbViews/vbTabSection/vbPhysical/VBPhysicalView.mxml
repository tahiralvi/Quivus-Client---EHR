<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 creationComplete="group1_creationCompleteHandler(event)" 
		 xmlns:vitals="com.gazuntite.patient.visit.view.vbViews.vbTabSection.vbPhysical.vitals.*" 
		 xmlns:cc="com.gazuntite.patient.visit.view.vbViews.vbTabSection.vbPhysical.cc.*" 
		 xmlns:ros="com.gazuntite.patient.visit.view.vbViews.vbTabSection.vbPhysical.ros.*" 
		 xmlns:physical="com.gazuntite.patient.visit.view.vbViews.vbTabSection.vbPhysical.physical.*" 
		 xmlns:lab="com.gazuntite.patient.visit.view.vbViews.vbTabSection.vbPhysical.lab.*"
		 >
	<s:layout>
		<s:VerticalLayout gap="0"/>
	</s:layout>
	
	<fx:Script>
		<![CDATA[
			private var currentIndex:int = 0;
			import mx.events.FlexEvent;
			
			//private var slideoutManager:SlideoutUtils = new SlideoutUtils();;
			
			public function ScrollUp():void
			{
				id_Scroller.viewport.verticalScrollPosition = id_Scroller.viewport.verticalScrollPosition + 15;
			}
			
			public function ScrollDown():void
			{
				id_Scroller.viewport.verticalScrollPosition = id_Scroller.viewport.verticalScrollPosition - 15;
			}

			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				//slideoutManager.currentExpandedPanel = id_VBVitalsGridPanel;
				currentIndex++;
				SelectNextByIndex();
				launchFilterEvent();
			}

			
			private function launchFilterEvent():void
			{
				var eve:MouseEvent = new MouseEvent(MouseEvent.CLICK);
				
				//################# PHYSICAL################################################
				this.id_ros.id_applyFiler.dispatchEvent(eve);
				this.id_physical.id_applyFiler.dispatchEvent(eve);
				this.id_VBVitalsGridPanel.id_applyFiler.dispatchEvent(eve);
				
				/* this.id_lab.id_labIn.id_applyFiler.dispatchEvent(eve);
				this.id_lab.id_labOut.id_applyFiler.dispatchEvent(eve); */
				
				this.id_hpi.id_applyFiler.dispatchEvent(eve);
				//##########################################################################
				
				
			}
			
			private function ShowPanel(event:MouseEvent):void
			{
				event.currentTarget.selected = true;
				
				setSelectedById( event.currentTarget.id );
				
			}
			private function setSelectedById(tabId:String):void
			{
				DeSelectAllNavButton();
				
				switch( tabId )
				{
					case "id_VBVitalBtn":
					case "id_VBAlergiesGridPanel":
						
						id_VBVitalBtn.selected				= true;
						//id_VBVitalsGridPanel.ExpandedView 	= true;						
						id_VBVitalsGridPanel.visible			= true;
						
						currentIndex							= 1;
						
						//id_VBAllergiesBtn.setStyle("skinClass", QIAllergiesBtn);
						
						break;
					
					case "id_VBCC_HPIBtn":
					case "id_history":
						
						id_VBCC_HPIBtn.selected		= true;
						//id_hpi.ExpandedView 		= true;						
						id_hpi.visible		 		= true;
						
						
						//id_VBHistoryBtn.setStyle("skinClass", QIComprehensiveHistoryBtn);
						currentIndex					= 2;
						break;
					
					case "id_VBROSBtn":
					case "id_QIMedicationPanel":
						
						id_VBROSBtn.selected		= true;
						//id_ros.ExpandedView 		= true;						
						id_ros.visible		 	= true;						
						
						
						//id_VBMedicationBtn.setStyle("skinClass", QIChronicMedicationBtn);
						currentIndex							= 3;
						break;
					
					case "id_VBPhysicalBtn":
					case "id_VBImGridP":
						
						id_VBPhysicalBtn.selected	= true;
						//id_physical.ExpandedView 	= true;						
						id_physical.visible		 	= true;						
						
						
						//id_VBImmunizationBtn.setStyle("skinClass", QIImmunizationBtn);
						currentIndex							= 4;
						break;
					
					case "id_VBLabBtn":
					case "id_VBImGridP":
						
						id_VBLabBtn.selected		= true;
						//id_lab.ExpandedView 		= true;						
						id_lab.visible		 		= true;						
						
						
						//id_VBImmunizationBtn.setStyle("skinClass", QIImmunizationBtn);
						currentIndex							= 4;
						break;
					
				}
				trace( "selected index", currentIndex );
			}
			
			private function SelectNextByIndex():void
			{
				if( currentIndex == 0 )
					currentIndex = 4;
				
				switch( currentIndex )
				{
					case 1:
						setSelectedById( "id_VBVitalBtn" );
						break;
					case 2:
						setSelectedById( "id_VBCC_HPIBtn" );
						break;
					case 3:
						setSelectedById( "id_VBROSBtn" );
						break;
					case 4:
						setSelectedById( "id_VBPhysicalBtn" );
						break;
					case 5:
						setSelectedById( "id_VBLabBtn" );
						break;
					
					default:
						setSelectedById( "id_VBVitalBtn" );
						break;
				}
			}
			
			
			private function DeSelectAllNavButton():void
			{
				id_VBVitalBtn.selected			=	false;
				id_VBCC_HPIBtn.selected			=	false;
				id_VBROSBtn.selected			=	false;
				id_VBPhysicalBtn.selected		=	false;
				id_VBLabBtn.selected			=	false;
				
				id_VBVitalsGridPanel.id_header.setHeaderCapitalCase( false );
				id_hpi.id_header.setHeaderCapitalCase( false );
				id_physical.id_header.setHeaderCapitalCase( false );
				id_ros.id_header.setHeaderCapitalCase( false );
				id_lab.id_header.setHeaderCapitalCase( false );
			}
			
			
			
			protected function id_prevBtn_clickHandler(event:MouseEvent):void
			{
				currentIndex -= 1 ;
				SelectNextByIndex();
			}
			
			
			protected function id_nextBtn_clickHandler(event:MouseEvent):void
			{
				currentIndex += 1 ;
				SelectNextByIndex();
			}
			
			public function checkPanels():void
			{
				DeSelectAllNavButton();
				/* if(id_VBVitalsGridPanel.ExpandedView)
				{
					id_VBVitalBtn.selected = true;
					id_VBVitalsGridPanel.id_header.setHeaderCapitalCase( true );
				}
				if(id_hpi.ExpandedView)
				{
					id_VBCC_HPIBtn.selected = true;	
					id_hpi.id_header.setHeaderCapitalCase( true );
				}
				if(id_physical.ExpandedView)
				{
					id_VBPhysicalBtn.selected = true;	
					id_physical.id_header.setHeaderCapitalCase( true );
				}
				if(id_ros.ExpandedView)
				{
					id_VBROSBtn.selected = true;
					id_ros.id_header.setHeaderCapitalCase( true );
				}
				if(id_lab.ExpandedView)
				{
					id_VBLabBtn.selected = true;
					id_lab.id_header.setHeaderCapitalCase( true );
				} */
				
			}
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:HGroup width="100%" horizontalAlign="center" height="40" verticalAlign="middle">
		<s:Button id="id_prevBtn" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.VBPMHPrevBtn" buttonMode="true" toolTip="Previous Section" click="id_prevBtn_clickHandler(event)" />		
		<s:ToggleButton id="id_VBVitalBtn" selected="true" width="80" skinClass="com.adobe.gazuntite.skins.viewBackground.toggleButtonSkins.VBPMHButtonSkin" label="VITALS" buttonMode="true" click="ShowPanel(event)"/>
		<s:ToggleButton id="id_VBCC_HPIBtn" width="150" skinClass="com.adobe.gazuntite.skins.viewBackground.toggleButtonSkins.VBPMHButtonSkin" label="Chief Complaint/HPI" buttonMode="true" click="ShowPanel(event)"/>
		<s:ToggleButton id="id_VBROSBtn" width="140" skinClass="com.adobe.gazuntite.skins.viewBackground.toggleButtonSkins.VBPMHButtonSkin" label="Review of System" buttonMode="true" click="ShowPanel(event)"/>
		<s:ToggleButton id="id_VBPhysicalBtn" width="80" skinClass="com.adobe.gazuntite.skins.viewBackground.toggleButtonSkins.VBPMHButtonSkin" label="Physical" buttonMode="true" click="ShowPanel(event)"/>
		<s:ToggleButton id="id_VBLabBtn" width="70" skinClass="com.adobe.gazuntite.skins.viewBackground.toggleButtonSkins.VBPMHButtonSkin" label="Lab" buttonMode="true" click="ShowPanel(event)"/>
		<s:Button id="id_nextBtn" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.VBPMHNextBtn" buttonMode="true" toolTip="Next Section" click="id_nextBtn_clickHandler(event)"/>
	</s:HGroup>
	
	<s:BorderContainer width="100%" maxHeight="450" cornerRadius="3" backgroundColor="#999AAA" 
					   borderAlpha="0" borderColor="#999AAA" backgroundAlpha="0">
		<s:layout>
			<s:VerticalLayout paddingTop="0" horizontalAlign="left" />
		</s:layout>
		
		<s:Scroller id="id_Scroller" width="100%" height="100%" verticalScrollPolicy="off" horizontalScrollPolicy="off" >
			<s:Group width="100%" height="100%" >
				<s:layout>
					<s:VerticalLayout paddingTop="2" horizontalAlign="center" gap="1" clipAndEnableScrolling="true"/>
				</s:layout>
		
		<vitals:VBVitalsGridPanel id="id_VBVitalsGridPanel" width="100%" />
								  <!--ExpandedView="false" allowSlideOut="true" SlideOutXOffset="35" SlideOutYOffset="0" QSSlideStateChange="slideoutManager.QSAutoSlideChangeHandler(event)"
								  QSViewStateChange="slideoutManager.QSAutoCollapseHandler(event); checkPanels()"-->
								  
		<cc:VBCCHPIGridPanel width="100%"  id="id_hpi"/>
							 <!--ExpandedView="false" allowSlideOut="true" SlideOutXOffset="35" SlideOutYOffset="0" QSSlideStateChange="slideoutManager.QSAutoSlideChangeHandler(event)"
							 QSViewStateChange="slideoutManager.QSAutoCollapseHandler(event); checkPanels()"
							 />-->
		<ros:VBROSGridPanel width="100%" id="id_ros"/>
							<!--ExpandedView="false" allowSlideOut="true" SlideOutXOffset="35" SlideOutYOffset="0" QSSlideStateChange="slideoutManager.QSAutoSlideChangeHandler(event)"
							QSViewStateChange="slideoutManager.QSAutoCollapseHandler(event); checkPanels()"
							/>-->
		<physical:VBPhysicalGridView width="100%"  id="id_physical" />
									<!--ExpandedView="false" allowSlideOut="true" SlideOutXOffset="35" SlideOutYOffset="0"
									QSSlideStateChange="slideoutManager.QSAutoSlideChangeHandler(event)"
									 QSViewStateChange="slideoutManager.QSAutoCollapseHandler(event); checkPanels()"
									 />-->
		
		<lab:VBLabViewPanel width="100%"  id="id_lab" />
							<!--ExpandedView="false" allowSlideOut="true" SlideOutXOffset="35" SlideOutYOffset="0" QSSlideStateChange="slideoutManager.QSAutoSlideChangeHandler(event)"
							QSViewStateChange="slideoutManager.QSAutoCollapseHandler(event); checkPanels()"
							/>-->
		</s:Group></s:Scroller>
	</s:BorderContainer>
</s:Group>
