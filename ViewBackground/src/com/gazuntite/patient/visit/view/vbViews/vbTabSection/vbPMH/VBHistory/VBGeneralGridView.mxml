			public function doValidateRecord(event:DataGridEvent):void
			{
				var validationRes:ValidationResultEvent;
				
				var comboEditor:LabelComboBox;
				var dateEditor:DateFieldEditor;
				var yesNoEditor:YesNoItemEditor;
				
				var mhDTO:MedicalHistoryDTO = event.itemRenderer.data as MedicalHistoryDTO;
				
				if (!mhDTO)
					return;
				
				switch (event.dataField)
				{
					case "IsNone":
						
						yesNoEditor = id_DataGrid.itemEditorInstance as YesNoItemEditor;
						
						if (yesNoEditor)
						{
							var canEdit:Boolean = true;
							
							if (yesNoEditor.isYes == QSConstants.STRING_TRUE)
							{
								mhDTO.ICDDTO = null;
								mhDTO.OnSet = "";
								mhDTO.isActive = false;
								
								canEdit = false;
							}
								
							mhDTO.IsNone = (yesNoEditor.isYes == QSConstants.STRING_TRUE) ? true : false;
							mhDTO.IsDirty = true;
							
							for (var i:int = 3; i < 7; i++)
							{
								id_DataGrid.columns[i].editable = canEdit;
							}
						}
						
						break;
						
					case "ICDDTO.IcdCodeName":
					case "ICDDTO.IcdCodeDescription":
						
						comboEditor = SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor;
						
						comboValidator.error = "Invalid ICD code";
						comboValidator.source = comboEditor;
						comboValidator.property = "selectedItem";
						
						validationRes = comboValidator.validate(comboEditor.selectedItem);
						
						if (validationRes && !validationRes.results)
						{
							mhDTO.ICDDTO = comboEditor.selectedItem;
							mhDTO.IsDirty = true;
						}
						
						break;
					
					case "OnSet":
						
						dateEditor = id_DataGrid.itemEditorInstance as DateFieldEditor;
						
						if (dateEditor)
						{
							mhDTO.OnSet = dateEditor.text;
							mhDTO.IsDirty = true;
						}
						
						break;
				}
			}
			
