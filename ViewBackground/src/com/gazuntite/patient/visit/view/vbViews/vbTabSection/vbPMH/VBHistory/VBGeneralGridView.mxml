				{
					ret = "##";
				}
				return ret;
			}
			
			private function RecordLevelNotesStatus(hasNotes:Boolean, data:Object):void
			{
				var dicID:String = data.DictationID;
				if ( hasNotes || ( dicID && dicID != QSConstants.GUID_FORMAT ) )
					data.IsNone = QSConstants.STRING_FALSE;
				else
					data.IsNone = QSConstants.STRING_TRUE;
				
				model.medicalHistoryDTOListByPatient.refresh();
			}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				if(model.medicalHistoryDTOListByPatient!=null){
					model.medicalHistoryDTOListByPatient.filterFunction=myFilter;
					model.medicalHistoryDTOListByPatient.refresh();
				}
			}
			
			private function myFilter(obj:*):Boolean
			{
				if(model.vbFilter == QSConstants.BY_VISIT)
				{
					if(model.vbVisitId == obj.VisitID)
					{
						return true;
					}
					else
					{
						return false;
					}
				}
				
				return true;
				
			}
			
			public function onStatus(item:Object, iCol:int):String
			{
				if ( item.IsNone.toString() == QSConstants.STRING_TRUE )
					return QSConstants.STRING_NO_UI;
				else
					return QSConstants.STRING_YES_UI;
			}
			
			public function onIsActive(item:Object, iCol:int):String
			{
				if (item.IsNone.toString() == QSConstants.STRING_TRUE)
					return "";
					
				if ( item.isActive )
					return QSConstants.STRING_YES_UI;
				else
					return QSConstants.STRING_NO_UI;
			}
			
