			private function setOnSet(oItem:Object,iCol:int):String
			{
				var strOnSetDate:String = '';
				
				if (oItem && oItem.OnSet)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.OnSet));
					strOnSetDate = formatDateTime.format(dateRecieved);
					
					if (strOnSetDate.indexOf('NaN',0) != -1)
						strOnSetDate = oItem.OnSet;
				}
				
				return strOnSetDate;
