	<s:Button label="Filter" click="button1_clickHandler(event)" visible="false" includeInLayout="false" id="id_applyFiler"/>
	
	<components:LabelDataGrid id="id_DataGrid"
							  rowCount="{id_DataGrid.dataProvider.length + 1}"
							  width="100%" maxHeight="150" editable="false" useRollOver="false" height="100%" horizontalScrollPolicy="off" verticalScrollPolicy="on"
