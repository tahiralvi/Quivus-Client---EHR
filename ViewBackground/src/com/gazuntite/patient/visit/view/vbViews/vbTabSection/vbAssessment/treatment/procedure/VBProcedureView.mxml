			private function myFilter(obj:*):Boolean
			{
				if(model.vbFilter == QSConstants.BY_VISIT)
				{
					if(model.vbVisitId == obj.VisitID)
					{
						return true;
					}
					else
					{
						return false;
					}
				}
				
				return true;
			}
			
			public function displayRowNum(oItem:Object,iCol:int):String
			{
				var rowNumber:int = id_ProcedureGrid.dataProvider.getItemIndex(oItem) + 1;
				return String(rowNumber);
			}
			
			public function displayVisitDate(item:Object, iCol:int):String
			{
				var strVisitDate:String = '';
				
				if (item && item.VisitDate)
				{
					var dateRecieved:Date = new Date(Date.parse(item.VisitDate));
					strVisitDate = formatDateTime.format(dateRecieved);
					var nullDate:Date = QSConstants.NULL_DATE;
					
					if (dateRecieved.getFullYear() <= nullDate.getFullYear() && dateRecieved.getMonth() <= nullDate.getMonth())
						strVisitDate = "";
				}
				
				return strVisitDate;
			}
			
			private function switchPageForGridView(event:*):void
			{
				if (UtilityFunctions.IsNullOrEmpty( model.procedureCurrentPageByPatient))
					model.procedureCurrentPageByPatient = VBUtilityFunctions.getNewPageDTOWithDefaultValues();
				
				 var lpEvent:LoadProcedureByPatientIdPagedEvent = new LoadProcedureByPatientIdPagedEvent(); 
				CairngormEventDispatcher.getInstance().dispatchEvent(lpEvent); 
			}
			
			private function id_PaginationFilterView_RefreshViewHandler(event:Event):void
			{
				if (!VBUtilityFunctions.isNullOrEmptyPage(id_PaginationFilterView.page))
					model.procedureCurrentPageByPatient = id_PaginationFilterView.page;
				
				var lpEvent: LoadProcedureByPatientIdPagedEvent = new LoadProcedureByPatientIdPagedEvent(); 
				CairngormEventDispatcher.getInstance().dispatchEvent(lpEvent); 
			}
			
			private function button1_clickHandler(event:MouseEvent):void
			{
				if(model.procedureDTOListByPatient!=null){
					model.procedureDTOListByPatient.filterFunction=myFilter;
					model.procedureDTOListByPatient.refresh();
