	<s:Button label="Filter" click="button1_clickHandler(event)" visible="false" includeInLayout="false" id="id_applyFiler"/>
	<paging:PaginationFilterView id="id_PaginationFilterView" width="100%" page="{model.procedureCurrentPageByPatient}"
								 GoToFirstPage="switchPageForGridView(event)" GoToNextPage="switchPageForGridView(event)" 
								 GoToPreviousPage="switchPageForGridView(event)" GoToLastPage="switchPageForGridView(event)"
								 RefreshView="id_PaginationFilterView_RefreshViewHandler(event)"
								 />
	<components:LabelDataGrid id="id_ProcedureGrid"
							  rowCount="{id_ProcedureGrid.dataProvider.length + 1}" rowHeight="24"
							  width="100%" useRollOver="false" maxHeight="150" verticalScrollPolicy="on" horizontalScrollPolicy="off"
							  dataProvider="{model.procedureDTOListByPatient}"
							  columnWidths="{[35,'20%', '20%', '40%',85]}">
		<components:columns>
			
			<mx:DataGridColumn headerText="Sr. #" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
							   editable="false" labelFunction="displayRowNum"/>
			<mx:DataGridColumn headerText="Visit Date" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
							   editable="false" labelFunction="displayVisitDate"/>
			<mx:DataGridColumn headerText="CPT" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
							   dataField="cptmedicalDTO.ProcedureCode" editorDataField="editorText">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor labelField="ProcedureCode" dataProvider="{outerDocument.model.cptMedicalTypeDTOList}"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Procedure" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
							   dataField="cptmedicalDTO.ProcedureDescription" editorDataField="editorText">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor labelField="ProcedureDescription" dataProvider="{outerDocument.model.cptMedicalTypeDTOList}"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<grid:DataGridColumnEx headerText="" itemRenderer="com.gazuntite.patient.visit.view.itemrenderer.VBRenderer" 
