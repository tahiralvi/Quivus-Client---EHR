			private var vbGridController:VBGridController;
			
			private function cc():void
			{
				vbGridController = new VBGridController();
				vbGridController.dataGrid = id_RecommendationGrid;
				
				vbGridController.firstEditableColIdx = 2;
				vbGridController.firstEditablePropertyName = "plantype.Name";
				
				vbGridController.sectionName = QSConstants.RECOMMENDATION_MODULE_NAME;
				vbGridController.recordValidationCallBack = doValidateRecord;
				
				if (!dataGridActionsData)
					dataGridActionsData = {};
				
				dataGridActionsData["noteDataFields"] = {subject: "NoteSubject", note: "Note", header: "plantype.Name", visitDate: "VisitDate"};
				dataGridActionsData["dictationDataField"] = "DictationID";
			}
			
			public function doValidateRecord(event:DataGridEvent):void
			{
				var comboEditor:LabelComboBox;
				var yesNoEditor:YesNoItemEditor;
				
				var recommendDTO:RecommendationDTO = RecommendationDTO(event.itemRenderer.data);
				
				switch (event.dataField)
				{
					case "plantype.Name":
						
						comboEditor = SparkComboBoxItemEditor(id_RecommendationGrid.itemEditorInstance).id_ComboEditor;
						
						if (areRequiredFieldsProvidedAndValid(recommendDTO.Description, comboEditor.selectedItem, recommendDTO.methodtype, recommendDTO.DurationType))
						{
							event.itemRenderer.data.plantype = comboEditor.selectedItem;
							
							event.itemRenderer.data.IsDirty = true;
						}
						
						break;
					
					case "methodtype.Name":
						
						comboEditor = SparkComboBoxItemEditor(id_RecommendationGrid.itemEditorInstance).id_ComboEditor;
						
						if (areRequiredFieldsProvidedAndValid(recommendDTO.Description, recommendDTO.plantype, comboEditor.selectedItem, recommendDTO.DurationType))
						{
							event.itemRenderer.data.methodtype = comboEditor.selectedItem;
							
							event.itemRenderer.data.IsDirty = true;
						}
						
						break;
					
					case "Links":
						
						comboEditor = SparkComboBoxItemEditor(id_RecommendationGrid.itemEditorInstance).id_ComboEditor;
						
						event.itemRenderer.data.Links = comboEditor.textInput.text;
						
						event.itemRenderer.data.IsDirty = true;
						
						break;
					
					case "DurationType.Name":
						
						comboEditor = SparkComboBoxItemEditor(id_RecommendationGrid.itemEditorInstance).id_ComboEditor;
						
						if (areRequiredFieldsProvidedAndValid(recommendDTO.Description, recommendDTO.plantype, recommendDTO.methodtype, comboEditor.selectedItem))
						{
							event.itemRenderer.data.DurationType = comboEditor.selectedItem;
							
							event.itemRenderer.data.IsDirty = true;
						}
						
						break;
					
					case "IsDiscussedWithPatient":
						
						yesNoEditor = YesNoItemEditor(id_RecommendationGrid.itemEditorInstance);
						
						event.itemRenderer.data.IsDiscussedWithPatient = yesNoEditor.isYes;
						
						event.itemRenderer.data.IsDirty = true;
						
						break;
					
					case "Description":
						
						var newDescVal:String = TextInput(id_RecommendationGrid.itemEditorInstance).text;
						
						if (areRequiredFieldsProvidedAndValid(newDescVal, recommendDTO.plantype, recommendDTO.methodtype, recommendDTO.DurationType))
						{
							event.itemRenderer.data.Description = newDescVal;
							
							event.itemRenderer.data.IsDirty = true;
						}
						
						break;
				}
			}
			
			private function areRequiredFieldsProvidedAndValid(descVal:String, planTypeVal:GeneralTypeDTO, methodTypeVal:GeneralTypeDTO, durationTypeVal:GeneralTypeDTO):Boolean
			{
				if (!descVal)
				{
					if (planTypeVal && methodTypeVal && durationTypeVal)
						return true;
						
					else
						return false;
				}
				else
					return true;
			}
			
			public function displayRowNum(item:Object, iCol:int):String
			{
				var strRowNum:String = "";
				
				if (id_RecommendationGrid.dataProvider)
				{
					var rowNum:int = id_RecommendationGrid.dataProvider.getItemIndex(item) + 1;
					strRowNum = String(rowNum);
				}
				
				return strRowNum;
			}
			
			public function displayVisitDate(item:Object, iCol:int):String
			{
				var strVisitDate:String = '';
				
				if (item && item.VisitDate)
				{
					var dateRecieved:Date = new Date(Date.parse(item.VisitDate));
					strVisitDate = formatDateTime.format(dateRecieved);
					var nullDate:Date = QSConstants.NULL_DATE;
					
					if (dateRecieved.getFullYear() <= nullDate.getFullYear() && dateRecieved.getMonth() <= nullDate.getMonth())
						strVisitDate = "";
				}
				
				return strVisitDate;
			}
			
			public function discussedWithPatientLabel(oItem:Object, icol:int):String
			{
				var label:String = "";
				
				if (oItem.hasOwnProperty("IsDiscussedWithPatient"))
				{
					if (oItem.IsDiscussedWithPatient)
						label = "Yes";
						
					else
						label = "No";
				}
				
				return label;
			}
			
