			private function button1_clickHandler(event:MouseEvent):void
			{
				/* var mpiEvent : ManagePatientImmunizationEvent = new ManagePatientImmunizationEvent(  );
				CairngormEventDispatcher.getInstance().dispatchEvent( mpiEvent ); */
				if(model.recommendationDTOListByPatientId!=null){
					model.recommendationDTOListByPatientId.filterFunction=myFilter;
					model.recommendationDTOListByPatientId.refresh();
				}
			}
			
			private function myFilter(obj:*):Boolean
			{
				
				if(model.vbFilter == QSConstants.BY_VISIT)
				{
					if(model.vbVisitId == obj.VisitID)
					{
						return true;
					}
					else
					{
						return false;
					}
				}
				
				return true;
			}
			
			private function switchPageForGridView(event:*):void
			{
				
				if( UtilityFunctions.IsNullOrEmpty(model.recommendationCurrentPageByPatient))
					model.recommendationCurrentPageByPatient = VBUtilityFunctions.getNewPageDTOWithDefaultValues();
				
				var lpviEvent:LoadRecommendationByPatientIdPagedEvent = new LoadRecommendationByPatientIdPagedEvent(); 
				CairngormEventDispatcher.getInstance().dispatchEvent( lpviEvent ); 
			}
			
			protected function id_PaginationFilterView_RefreshViewHandler(event:Event):void
			{
				if (!VBUtilityFunctions.isNullOrEmptyPage(id_PaginationFilterView.page))
					model.recommendationCurrentPageByPatient = id_PaginationFilterView.page;
				
				var lrEvent:LoadRecommendationByPatientIdPagedEvent = new LoadRecommendationByPatientIdPagedEvent(); 
				CairngormEventDispatcher.getInstance().dispatchEvent(lrEvent); 
			}
