	<s:layout>
		<s:VerticalLayout gap="0" />
	</s:layout>
		
	<s:Button label="Filter" click="button1_clickHandler(event)" visible="false" includeInLayout="false" id="id_applyFiler"/>
	<paging:PaginationFilterView id="id_PaginationFilterView" width="100%" page="{model.recommendationCurrentPageByPatient}"
								 GoToFirstPage="switchPageForGridView(event)" GoToNextPage="switchPageForGridView(event)" 
								 GoToPreviousPage="switchPageForGridView(event)" GoToLastPage="switchPageForGridView(event)"
								 RefreshView="id_PaginationFilterView_RefreshViewHandler(event)"
								 />
	<components:LabelDataGrid id="id_RecommendationGrid"
							  rowCount="{id_RecommendationGrid.dataProvider.length + 1}"
							  width="100%" useRollOver="false" rowHeight="24" maxHeight="150" editable="false" verticalScrollPolicy="on" horizontalScrollPolicy="off"
							  dataProvider="{model.recommendationDTOListByPatientId}"
							  columnWidths="{[30, '15%', '15%', '10%', '15%', '15%', '15%', '10%', 100]}">
		<components:columns>
			<mx:DataGridColumn headerText="Sr.#" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" editable="false" labelFunction="displayRowNum"/>
			<mx:DataGridColumn headerText="Visit Date" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"
							   editable="false" labelFunction="displayVisitDate"/>
			<mx:DataGridColumn headerText="Plan" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"
							   dataField="plantype.Name">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor labelField="Name" dataProvider="{outerDocument.model.recommendationPlanTypeDTOList}"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Method" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" 
							   wordWrap="true" dataField="methodtype.Name">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor labelField="Name" dataProvider="{outerDocument.model.recommendationMethodTypeDTOList}"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Links" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
							   dataField="Links" editorDataField="editorText">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor labelField="label" dataProvider="{outerDocument.model.recommendationLinkAutoCompleteDTOList}"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Duration" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
							   dataField="DurationType.Name" editorDataField="editorText">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor labelField="Name" dataProvider="{outerDocument.model.recommendationDurationTypeDTOList}"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			
			<mx:DataGridColumn headerText="Description" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" dataField="Description"  />
			
			<mx:DataGridColumn headerText="Discussed With Pat..." itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
							   labelFunction="discussedWithPatientLabel">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:YesNoItemEditor property="IsDiscussedWithPatient"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<grid:DataGridColumnEx headerText="" itemRenderer="com.gazuntite.patient.visit.view.itemrenderer.VBRenderer" 
								   data="{dataGridActionsData}" editable="false"/>
		</components:columns>
	</components:LabelDataGrid>
</s:Group>
