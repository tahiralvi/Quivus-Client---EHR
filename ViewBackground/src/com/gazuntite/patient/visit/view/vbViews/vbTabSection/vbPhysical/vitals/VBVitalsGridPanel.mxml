			private function switchPageForGridView( event:Event ):void
			{
				if( UtilityFunctions.IsNullOrEmpty(model.vitalCurrentPageByPatient))
					model.vitalCurrentPageByPatient = VBUtilityFunctions.getNewPageDTOWithDefaultValues();
				
				 var lpv:LoadVitalsByPatientIdPagedEvent = new LoadVitalsByPatientIdPagedEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(lpv); 
			}
			
			private function id_PaginationFilterView_RefreshViewHandler(event:Event):void
			{
				if (VBUtilityFunctions.isNullOrEmptyPage(id_PaginationFilterView.page))
					model.vitalCurrentPageByPatient = id_PaginationFilterView.page;
				
				 var lpv:LoadVitalsByPatientIdPagedEvent = new LoadVitalsByPatientIdPagedEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(lpv);
