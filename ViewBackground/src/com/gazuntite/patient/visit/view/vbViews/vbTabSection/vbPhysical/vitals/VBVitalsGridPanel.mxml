			public function doValidateRecord(event:DataGridEvent):void
			{
				var validationRes:ValidationResultEvent;
				
				var textEditor:TextInput;
				
				if (id_DataGrid.itemEditorInstance is TextInput)
					textEditor = id_DataGrid.itemEditorInstance as TextInput;
				
				if (!textEditor)
					return;
				
				if (!textEditor.length)
					return;
				
				var value:Number = parseInt(textEditor.text);
				
				if (isNaN(value))
					return;
					
				switch (event.dataField)
				{
					case "Height":
						
						validateHeight(value, textEditor.text, event);
							
						break;
					
					case "Weight":
						
						validateWeight(value, textEditor.text, event);
						
						break;
					
					case "Temperature":
						
						validateTemperature(value, textEditor.text, event)
					
						break;
					
					case "Pulse":
						
						validatePulse(value, textEditor.text, event);
						
						break;
					
					case "Respiration":
						
						validateRespiration(value, textEditor.text, event);
						
						break;
					
					case "Oxygen":
					
						validateOxygen(value, textEditor.text, event);
						
						break;
					
					case "BPSys":
						
						validateBPSys(value, textEditor.text, event);
						
						break;
					
					case "BPDys":
						
						validateBPDys(value, textEditor.text, event);
						
						break;
				}
			}
			
			public function applyNumberFormatOnHeight(item:Object, iCol:int):String
			{
				var str:String = "";
				
				if (item.hasOwnProperty("Height") && item.Height)
				{
					str = numberFormatter.format(item.Height);
				}
				if(str == '0' || str == '0.00')
					str = '';
				
				return str;
			}
			
