	<common:headerContents>
		<s:Group id="id_mainHeader" width="100%" height="24"> <!--minWidth="{ChromeUtil.topLevelMainContainer.width - 70}"-->
			<s:layout>
				<s:VerticalLayout verticalAlign="bottom" horizontalAlign="center" />
			</s:layout>
			<viewBackground:VBSectionHeader id="id_header" width="{id_mainHeader.width - 8}" HeadingLable="VITALS" 
											Skin="com.adobe.gazuntite.skins.viewBackground.skinnableContainers.VBVitalsPanelSkin"/>	<!--SectionNameID="{QSSecurityUtil.VB_VITALS}"	-->				   
		</s:Group>
	</common:headerContents>
	<!--<custom:Contents>-->
		<s:SkinnableContainer id="id_contents" width="100%" height="100%" skinClass="com.adobe.gazuntite.skins.viewBackground.skinnableContainers.VBVitalsPanelSkin">
			<s:layout>
				<s:VerticalLayout horizontalAlign="center" verticalAlign="top" gap="1" paddingLeft="4" paddingRight="4" paddingBottom="4" paddingTop="4" />
			</s:layout>
			
			<viewBackground:VBSectionLevelNotesDictation id="id_notesDictation" width="100%" />
			
			<s:Button label="Filter" click="button1_clickHandler(event)" visible="false" includeInLayout="false" id="id_applyFiler"/>
			
			<paging:PaginationFilterView id="id_PaginationFilterView" width="100%" page="{model.vitalCurrentPageByPatient}"
										 GoToFirstPage="switchPageForGridView(event)" GoToNextPage="switchPageForGridView(event)" 
										 GoToPreviousPage="switchPageForGridView(event)" GoToLastPage="switchPageForGridView(event)"
										 RefreshView="id_PaginationFilterView_RefreshViewHandler(event)"
										 />
			<components:LabelDataGrid id="id_DataGrid"
						 rowCount="{id_DataGrid.dataProvider.length + 1}" 
						 width="100%" editable="false" useRollOver="false" maxHeight="150" rowHeight="24"
						 verticalScrollPolicy="on" horizontalScrollPolicy="off"
						 columnWidths="{[40, 90, 60, 60, 60, 60, 60, 60, 60, 60, 90]}"
						 dataProvider="{model.vitalDTOListByPatient}">
				<components:columns>
					<mx:DataGridColumn headerText="Sr.#" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"
									   labelFunction="displayRowNum" editable="false"/>
					<mx:DataGridColumn headerText="Visit Date" headerRenderer="mx.controls.Label" wordWrap="true" width="90" labelFunction="displayVisitDate"
									   editable="false"/>
					<mx:DataGridColumn headerText="Height (cm)" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"
									   dataField="Height" labelFunction="applyNumberFormatOnHeight"/>
					<mx:DataGridColumn headerText="Weight (Kg)" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
									   dataField="Weight" labelFunction="applyNumberFormatOnWeight"/>
					<mx:DataGridColumn headerText="Temp (C)" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
									   dataField="Temperature" labelFunction="applyNumberFormatOnTemp"/>
					<mx:DataGridColumn headerText="Pulse (Min)" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
									   dataField="Pulse" labelFunction="getPulse"/>
					<mx:DataGridColumn headerText="Resp (Min)" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
									   dataField="Respiration" labelFunction="getResp"/>
					<mx:DataGridColumn headerText="Oxy (%)" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
									   dataField="Oxygen" labelFunction="getOxy"/>
					<mx:DataGridColumn headerText="BP(Sys)" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
									   dataField="BPSys" labelFunction="getBPs"/>
					<mx:DataGridColumn headerText="BP(Dys)" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" 
									   dataField="BPDys" labelFunction="grtBPd"/>
					<grid:DataGridColumnEx  itemRenderer="com.gazuntite.patient.visit.view.itemrenderer.VBRenderer"
											data="{dataGridActionsData}" editable="false"/>
				</components:columns>
			</components:LabelDataGrid>
			
		</s:SkinnableContainer>
