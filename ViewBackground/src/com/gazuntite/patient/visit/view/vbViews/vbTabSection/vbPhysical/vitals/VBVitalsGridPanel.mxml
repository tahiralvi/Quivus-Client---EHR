			private function beginEdit(columnIndex:int, rowIndex:int, property:String):void
			{
				var itemToSetInEditableMode:IListItemRenderer = id_DataGrid.indexToItemRenderer(rowIndex);
				var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
				ev.columnIndex = columnIndex;
				ev.rowIndex = rowIndex;
				ev.itemRenderer = itemToSetInEditableMode;
				ev.dataField = property;
				id_DataGrid.dispatchEvent(ev);
			}
			
			private function validateHeight(value:Number, editorText:String, event:DataGridEvent):void
			{
				if (value < 38 || value > 245)
				{
					if (isAlertVisible)
						return;
					
					isAlertVisible = true;
					
					Alert.show("Provided value for height does not occur in feasible range.\n Do you want to keep these values",
						"Height out of Range error", Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, function(evt:CloseEvent):void
						{									
							switch (evt.detail)
							{
								case Alert.YES:
									
									event.itemRenderer.data.Height = editorText;
									event.itemRenderer.data.IsDirty = true;
									
									break;
								
								case Alert.NO:
									
									beginEdit(event.columnIndex, event.rowIndex, "Height");
									
									break;
							}
							
							isAlertVisible = false;
							
							return;
						});
				}
				else
				{
					event.itemRenderer.data.Height = editorText;
					event.itemRenderer.data.IsDirty = true;
				}
			}
			
