			public function GridRowNumber(item:Object, iCol:int):String
			{
				var strRowNum:String = "";
				
				if (id_DataGrid.dataProvider)
				{
					var rowNum:int = id_DataGrid.dataProvider.getItemIndex(item) + 1;
					strRowNum = String(rowNum);
				}
				
				return strRowNum;
			}
			
			public function GridRowNumber_inactive(item:Object, iCol:int):String
			{
				var strRowNum:String = "";
				
				if (id_DataGrid_inactive.dataProvider)
				{
					var rowNum:int = id_DataGrid_inactive.dataProvider.getItemIndex(item) + 1;
					strRowNum = String(rowNum);
				}
				
				return strRowNum;
			}
			
			public function medicineStrengthLabel(item:Object, iCol:int):String
			{
				var label:String = "";
				
				if (item.hasOwnProperty("GenericName"))
				{
					label += item.BrandName ; 
					label += " ("+item.GenericName +")" + ", ";
					
					
					if (item.hasOwnProperty("Strength"))
					{
						label += item.Strength;
					}
				}
				
				return label;
			}
			protected function button1_clickHandler(event:MouseEvent):void
			{
				if(model.medicationDTOList!=null){
					model.medicationDTOList.filterFunction = myFilter;
					model.medicationDTOList.refresh();
				}
			}
			
			private function myFilter(obj:*):Boolean
			{
				if(model.vbFilter == QSConstants.BY_VISIT)
				{
					if(model.vbVisitId == obj.VisitId)
					{
						return true;
					}
					else
					{
						return false;
					}
				}
				
				return true;
			}
			
