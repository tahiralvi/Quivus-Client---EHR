			//Tahir Alvi  - sep19 
			private function getRefillData(item:Object, iCol:int):String
			{
				var result:String;
				if(item.Refill)
					result = item.Refill;
				
				if(item.isPRN)
					result = item.isPRN;
				
				if(result.toLowerCase() == 'true')
					result = 'AS NEEDED';
				else if(item.Refill)
					result = item.Refill;
				return result;
			}
			//Tahir Alvi  - sep19 
			private function getDose(item:Object, iCol:int):String
			{
				var result:String;
				if(item.Dose)
					result = item.Dose;
				
				if(result == '0')
					result = '';
				
				return result;
			}
			public function getVisitDate(item:Object, iCol:int):String
			{
				//2012-01-01T00:00:00
				var date:String = "";
				
				if (item.hasOwnProperty("VisitDate"))
				{
					date = item.VisitDate;
				}
				
				if(date == '01/01/1901' || date == '02/01/1901')
				{
					date = 'N/A';
				}
				/* else
				{
					//date = formatDateTime.format(date);
					date = date;
				} */
				return date;
			}
			
