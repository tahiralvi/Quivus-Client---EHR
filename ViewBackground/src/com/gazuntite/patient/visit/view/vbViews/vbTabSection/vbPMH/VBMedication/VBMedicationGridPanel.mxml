				<viewBackground:VBSectionLevelNotesDictation id="id_notesDictation" width="100%" />
				<paging:PaginationFilterView id="id_PaginationFilterView" width="100%" page="{model.allergyCurrentPageByPatient}"
											 GoToFirstPage="switchPageForGridView(event)" GoToNextPage="switchPageForGridView(event)" 
											 GoToPreviousPage="switchPageForGridView(event)" GoToLastPage="switchPageForGridView(event)"
											 RefreshView="id_PaginationFilterView_RefreshViewHandler(event)"/>
				<s:Spacer height="6" />
				<s:VGroup width="100%" gap="-5">
					<s:ButtonBar id="id_b1" dataProvider="{viewStack}" styleName="blackButtonBarSkin" buttonMode="true">
						<s:layout>
							<s:ButtonBarHorizontalLayout gap="2" />
						</s:layout>
					</s:ButtonBar>
					
					<mx:ViewStack id="viewStack"  width="100%"  height="100%" top="10" creationPolicy="all" resizeToContent="true" >
						<mx:VBox label="Active Medication" width="100%" >
							
							<components:LabelDataGrid id="id_DataGrid" 
													  dataProvider="{model.patientChronicMedACList}"
													  width="100%" useRollOver="false" maxHeight="150" height="100%"
													  rowCount="{id_DataGrid.dataProvider.length + 1}"
													  verticalScrollPolicy="on" 
													  verticalScrollBarStyleName="VScrollBar" rowHeight="23" horizontalScrollPolicy="off" 
													  columnWidths="{[30,'15%','20%','15%','15%','25%', 100]}">
								<components:columns>
									
									<mx:DataGridColumn headerText="Sr.#" labelFunction="GridRowNumber" itemRenderer="mx.controls.Label" 
													   headerRenderer="mx.controls.Label" wordWrap="true" />
									
									<mx:DataGridColumn headerText="Type" dataField="Type" itemRenderer="mx.controls.Label" 
													   headerRenderer="mx.controls.Label" wordWrap="true" />
									
									<mx:DataGridColumn headerText="Medicine Name Strength (Generic Name)" itemRenderer="mx.controls.Label" 
													   headerRenderer="mx.controls.Label" wordWrap="true" dataField="drugName"/>
									
									<mx:DataGridColumn headerText="Dose" dataField="Dose" itemRenderer="mx.controls.Label" 
													   headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="getDose"/>
									
									<mx:DataGridColumn headerText="No. of Refills" itemRenderer="mx.controls.Label" 
													   headerRenderer="mx.controls.Label" wordWrap="true"  labelFunction="getRefillData" />
									
									<mx:DataGridColumn headerText="SIG" dataField="SIG" itemRenderer="mx.controls.Label" 
													   headerRenderer="mx.controls.Label" wordWrap="true" />
									
									<grid:DataGridColumnEx headerText="" itemRenderer="com.gazuntite.patient.visit.view.itemrenderer.ChronicMedicationGridActionsRenderer"
														   data="{dataGridActionsData}" editable="false"/>
								</components:columns>
							</components:LabelDataGrid>
							
						</mx:VBox>
						
						<mx:VBox label="History" width="100%" >
							<components:LabelDataGrid id="id_DataGrid_inactive"
													  dataProvider="{model.patientChronicMedACInactiveList}"
													  width="100%" useRollOver="false" height="100%"
													  rowCount="{id_DataGrid.dataProvider.length + 1}"
													  verticalScrollPolicy="on" maxHeight="150"
													  verticalScrollBarStyleName="VScrollBar" rowHeight="23" horizontalScrollPolicy="off" 
													  columnWidths="{[30,'15%','20%','15%','15%','25%', 100]}">
								<components:columns>	
									<mx:DataGridColumn headerText="Sr.#" labelFunction="GridRowNumber_inactive" itemRenderer="mx.controls.Label" 
													   headerRenderer="mx.controls.Label" wordWrap="true" />
									
									<mx:DataGridColumn headerText="Type" dataField="Type" itemRenderer="mx.controls.Label" 
													   headerRenderer="mx.controls.Label" wordWrap="true" />
									
									<mx:DataGridColumn headerText="Medicine Name Strength (Generic Name)" itemRenderer="mx.controls.Label" 
													   headerRenderer="mx.controls.Label" wordWrap="true" dataField="drugName"/>
									
									<mx:DataGridColumn headerText="Dose" dataField="Dose" itemRenderer="mx.controls.Label" 
													   headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="getDose"/>
									
									<mx:DataGridColumn headerText="No. of Refills" itemRenderer="mx.controls.Label" 
													   headerRenderer="mx.controls.Label" wordWrap="true"  labelFunction="getRefillData" />
									
									<mx:DataGridColumn headerText="SIG" dataField="SIG" itemRenderer="mx.controls.Label" 
													   headerRenderer="mx.controls.Label" wordWrap="true" />
									
									<grid:DataGridColumnEx headerText="" itemRenderer="com.gazuntite.patient.visit.view.itemrenderer.ChronicMedicationGridActionsRenderer"
														   data="{dataGridActionsData}" editable="false"/>
