<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:views="com.gazuntite.provider.live.services.waitingRoom.view.views.*"
		 width="100%"  height="100%" minHeight="200"
		 initialize="init()" creationComplete="creComp()">
	
	<fx:Declarations>
		<mx:DateFormatter id="dateFormatter" formatString="YYYY-MM-DD"/>
		<mx:DateFormatter id="time" formatString="HH:MM:SS"/>
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.provider.live.services.waitingRoom.dto.AppointmentDTO;
			import com.gazuntite.provider.live.services.waitingRoom.event.LoadClinicRoomByStationIdWREvent;
			import com.gazuntite.provider.live.services.waitingRoom.event.LoadWaitingRoomEvent;
			import com.gazuntite.provider.live.services.waitingRoom.event.ManageAppointmentWaitingRoomEvent;
			import com.gazuntite.provider.live.services.waitingRoom.model.WRModelLocator;
			import com.gazuntite.provider.live.services.waitingRoom.view.components.RoomInPopup;
			import com.gazuntite.provider.live.services.waitingRoom.view.event.LoadAppEvent;
			import com.gazuntite.provider.live.services.waitingRoom.view.util.WRUtils;
			
			import mx.managers.CursorManager;
			import mx.managers.PopUpManager;
			[Bindable]
			private var model:WRModelLocator = WRModelLocator.getInstance();
			private var roomInPopup:RoomInPopup;
			private var wrUtils:WRUtils;
			private var date:Date;
			
			//*********** init & creComp methods ***************************
			private function init():void
			{
				date 	= new Date();
				wrUtils = new WRUtils();
			}
			private function creComp():void
			{
				callLoadWaitingRoom();
				getLoggedInStationRoom();
				
				addEventListener('loadAppointmentsEvent', refreshAppointments);
				addEventListener('OpenRoomInViewEvent', OpenRoomInView);
			}
			//Get room list as user select from TOP BAR of Main Application
			private function getLoggedInStationRoom():void
			{
				var CRWEvent:LoadClinicRoomByStationIdWREvent = new LoadClinicRoomByStationIdWREvent(model.loggedInUserSelectedStationId.toString(), null);
				CairngormEventDispatcher.getInstance().dispatchEvent(CRWEvent);
			}
			
			//Refressh Appointments  Event call	after some opeartion
			private function refreshAppointments(e:LoadAppEvent):void
			{
				removeEventListener('loadAppointmentsEvent', refreshAppointments);
				callLoadWaitingRoom();
				getLoggedInStationRoom();
			}
			//Method on Refresh Button
			private function refresh_handler(event:MouseEvent):void
			{
				callLoadWaitingRoom();
				getLoggedInStationRoom();
			}
			//Service Call LoadWaitingRoom
			private function callLoadWaitingRoom():void
			{
				var LE:LoadWaitingRoomEvent	= new LoadWaitingRoomEvent(model.loggedInUserSelectedStationId);
				CairngormEventDispatcher.getInstance().dispatchEvent(LE);
				CursorManager.showCursor();
			}
			//****************** open Rom popup ********************
			private function OpenRoomInView(event:Event):void
			{
				roomInPopup = PopUpManager.createPopUp(this, RoomInPopup,true) as RoomInPopup;
				PopUpManager.centerPopUp(roomInPopup);
				roomInPopup.addEventListener('hideRoomInPopupEvent', onRemoveRoomInPopup);
			}
			private function onRemoveRoomInPopup(event:Event):void
			{
				roomInPopup.removeEventListener('hideRoomInPopupEvent', onRemoveRoomInPopup);
				PopUpManager.removePopUp(roomInPopup);
				
				onAssignRoomIn(); // assign room in to the grid record
			}
			private function onAssignRoomIn():void
			{
				var appointmentDTO:AppointmentDTO 					= new AppointmentDTO();
				var obj:Object										= new Object();
				obj 												= wrUtils.getNextAction(model.SelectedAppointmentDTO.Action.Name);
				model.SelectedAppointmentDTO.ModifiedAt 			= dateFormatter.format(date.toDateString())+'T'+time.format(date);
				model.SelectedAppointmentDTO.ModifiedBy 			= model.loggedInUserProviderId.toString();
				model.SelectedAppointmentDTO.Action.ID				= obj.ID;
				model.SelectedAppointmentDTO.Action.Name			= obj.Name;
				model.SelectedAppointmentDTO.Action.NextAction		= obj.NextAction;
				model.SelectedAppointmentDTO.Room.ID 			    = model.SelectedRoomDTO.ID;
				model.SelectedAppointmentDTO.Room.Station 		    = model.SelectedRoomDTO.Station;
				model.SelectedAppointmentDTO.Room.Title 			= model.SelectedRoomDTO.Title;
				
				var appointmentXML:XML = appointmentDTO.ToXML(model.SelectedAppointmentDTO);
				manageAppointment(appointmentXML, int(model.SelectedAppointmentDTO.UserID));
			}
			//************ manage appointment*****************************
			private function manageAppointment(appXML:XML, userID:int):void
			{
				var MAPPEvent:ManageAppointmentWaitingRoomEvent = new ManageAppointmentWaitingRoomEvent(appXML, model.loggedInUserProviderId, userID , refreshWRAppointments );
				CairngormEventDispatcher.getInstance().dispatchEvent(MAPPEvent);
				CursorManager.setBusyCursor();
			}
			// Refresh appointment schedule
			private function refreshWRAppointments(val:* = null):void
			{
				callLoadWaitingRoom();
			} 
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout paddingTop="4" paddingBottom="4" paddingLeft="2" paddingRight="2" gap="-4" />
	</s:layout>
	
	<s:ButtonBar dataProvider="{viewStack}" styleName="blackButtonBarSkin" buttonMode="true" useHandCursor="true" >
		<s:layout>
			<s:ButtonBarHorizontalLayout gap="2" />
		</s:layout>
	</s:ButtonBar>
	<s:SkinnableContainer minHeight="100" height="100%" width="100%" styleName="blackTitleBGContainerSkin">
		<s:layout>
			<s:VerticalLayout paddingTop="5" paddingBottom="5" paddingRight="2" horizontalAlign="right" />
		</s:layout>
		
		<s:Button label="R"  right="2" top="0" click="refresh_handler(event)" buttonMode="true" 
				  styleName="refreshButtonSkin" toolTip="Refresh"/>
		
		<mx:ViewStack id="viewStack"  width="100%"  height="100%" top="20">
			<mx:VBox label="Priorty" width="100%" >
				<views:PriorityView width="100%"  height="100%" />
			</mx:VBox>
			<mx:VBox label="Procedure" width="100%" >
				<views:ProcedureView width="100%"  height="100%" />
			</mx:VBox>
			<mx:VBox label="1ST COME"  width="100%" >
				<views:FirstComeView width="100%"  height="100%" />
			</mx:VBox>
			
		</mx:ViewStack>
		
	</s:SkinnableContainer>
</s:Group>
