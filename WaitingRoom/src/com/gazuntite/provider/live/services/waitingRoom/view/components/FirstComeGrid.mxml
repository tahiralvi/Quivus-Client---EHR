<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%" xmlns:components="com.zigron.controls.extended.components.*" xmlns:components1="com.gazuntite.controls.extended.components.*">
	<s:layout>
		<s:VerticalLayout />
	</s:layout>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.provider.live.services.waitingRoom.model.WRModelLocator;
			
			import mx.controls.Label;
			
			[Bindable]
			private var model:WRModelLocator = WRModelLocator.getInstance();
			
			public function getAppoinmentStatus(item:Object,column:DataGridColumn):String
			{
				var str:String;
				if(item.Room.Title.length > 0){
					str = item.Action.Name +' ('+ item.Room.Title+')';
				}else{
					str = item.Action.Name; 
				}
				return str
			}
		]]>
	</fx:Script>
	<components1:LabelDataGrid id="dgAppointments" width="100%"  
							  rowCount="{dgAppointments.dataProvider.length + 1}" 
							  dataProvider="{model.AppointmentsList}"
							  resizableColumns="false" allowDragSelection="false" 
							  visible="{model.AppointmentsList.length > 0 ? true:false }" 
							  includeInLayout="{dgAppointments.visible}"
							  verticalScrollBarStyleName="VScrollBar" horizontalScrollPolicy="off"
							  columnWidths="{['25%','15%','25%','15%','15%',100]}">
		<components1:columns>
			
			<mx:DataGridColumn headerText="Patient Name" dataField="Patient.PatientName"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="GID"    dataField="QuivusID" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Provider"     dataField="ProviderName" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Last Visit"   dataField="LastVisit" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Status"       labelFunction="getAppoinmentStatus" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Action"       dataField="Action.NextAction"	   itemRenderer="com.gazuntite.provider.live.services.waitingRoom.view.itemrenderer.ActionItemrenderer" />
		</components1:columns>
	</components1:LabelDataGrid>
</s:Group>

