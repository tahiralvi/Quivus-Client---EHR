<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%"
		 creationComplete="creComp()" 
		 >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.provider.live.services.waitingRoom.view.components.PriorityGrid;
			
			protected function creComp():void
			{
				var priorityGrid:PriorityGrid = new PriorityGrid();
				priorityGrid.width = vgPriority.width;
				vgPriority.addElement(priorityGrid);
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout paddingTop="5" paddingLeft="5" paddingRight="5" />
	</s:layout>
	<s:VGroup id="vgPriority" width="100%" height="100%" />		
</s:Group>	
	