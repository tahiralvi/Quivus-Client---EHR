			protected function id_AddWriteOffReason_clickHandler(event:MouseEvent):void
			{
				if(id_AddWriteOffReason.label == "Add")
				{
					id_WOAmount.enabled = true;
					id_WOGroupList.enabled = true;
					id_WOReasonList.enabled = true;
					
					id_AddWriteOffReason.label = "Save";
					
				}				
				else
				{
					if(UtilityFunctions.IsNullOrEmpty(id_WOAmount.text) || UtilityFunctions.TrimString(id_WOAmount.text) == "0")
					{
						id_WOAmount.setFocus();
						Alert.show("Please Enter Amount","Mandatory Field",4,FlexGlobals.topLevelApplication.mainContainer);
						return;
					}
					
					if(id_WOGroupList.selectedIndex < 0)
					{
						id_WOGroupList.setFocus();
						Alert.show("Please Select Group Code","Mandatory Field",4,FlexGlobals.topLevelApplication.mainContainer);
						return;
					}
					
					if(id_WOReasonList.selectedIndex < 0)
					{
						id_WOReasonList.setFocus();
						Alert.show("Please Select Reason Code","Mandatory Field",4,FlexGlobals.topLevelApplication.mainContainer);
						return;
					}
					
					if(id_AddWriteOffReason.label == "Save Update")
					{
						(WOReasons[WOSelectedIndex] as ClaimAdjustmentDTO).AdjustmentAmount = id_WOAmount.text;
						(WOReasons[WOSelectedIndex] as ClaimAdjustmentDTO).AdjustmentGroupCodeTypeID = String(id_WOGroupList.selectedIndex + 1);
						(WOReasons[WOSelectedIndex] as ClaimAdjustmentDTO).AdjustmentReasonCodeID = (id_WOReasonList.selectedItem as AdjustmentReasonCodeDTO).AdjustmentReasonCodeID;
						(WOReasons[WOSelectedIndex] as ClaimAdjustmentDTO).GroupCode =  UtilityFunctions.TrimString(id_WOGroupList.textInput.text.split('-')[0]);
						(WOReasons[WOSelectedIndex] as ClaimAdjustmentDTO).ReasonCode =  (id_WOReasonList.selectedItem as AdjustmentReasonCodeDTO).AdjustmentReasonCode;
						(WOReasons[WOSelectedIndex] as ClaimAdjustmentDTO).ModifiedBy = model.LoggedInUserId.toString();
						
						id_writeOff.text = String(Number(id_writeOff.text) - Number(WOoldAmount) );
						id_writeOff.text = String(Number(id_writeOff.text) + Number(id_WOAmount.text) );
						
						id_WOGrid.validateNow();
						id_WOGrid.scrollToIndex(WOSelectedIndex);
						
						id_woEditDel.visible = true;	
					}
					else
					{
						var reason:ClaimAdjustmentDTO = new ClaimAdjustmentDTO();
						
						reason.AdjustmentTypeID = "1";
						reason.ReasonDescription = "";
						reason.GroupDescription = "";
						reason.AdjustmentAmount = id_WOAmount.text;
						reason.AdjustmentGroupCodeTypeID = String(id_WOGroupList.selectedIndex + 1);
						reason.AdjustmentReasonCodeID = (id_WOReasonList.selectedItem as AdjustmentReasonCodeDTO).AdjustmentReasonCodeID;
						reason.GroupCode =  UtilityFunctions.TrimString(id_WOGroupList.textInput.text.split('-')[0]);
						reason.ReasonCode =  (id_WOReasonList.selectedItem as AdjustmentReasonCodeDTO).AdjustmentReasonCode
						reason.ClaimAdjustmentID = "0";
						reason.ClaimPaymentID = ClaimPaymentID;
						reason.CreatedBy = model.LoggedInUserId.toString();
						reason.ModifiedBy = model.LoggedInUserId.toString();
						reason.IsDeleted = "false";
						
						if(WOReasons == null)
							WOReasons = new ArrayCollection();
						
						WOReasons.addItem(reason);
						id_writeOff.text = String(Number(id_writeOff.text) + Number(id_WOAmount.text) );
					}					
					
					id_AddWriteOffReason.label = "Add";
					id_WOAmount.enabled = false;
					id_WOGroupList.enabled = false;
					id_WOReasonList.enabled = false;
					
					id_WOAmount.text = "0";
					id_WOGroupList.selectedIndex = -1;
					id_WOReasonList.selectedIndex = -1;
				}
			}
			
