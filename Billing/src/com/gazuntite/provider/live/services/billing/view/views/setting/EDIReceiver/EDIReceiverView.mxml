<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:components="com.gazuntite.controls.extended.components.*" 
					  xmlns:common="com.gazuntite.provider.live.services.billing.view.common.*" 
					  xmlns:itemEditors="com.gazuntite.provider.live.services.billing.view.common.itemEditors.*"
					  creationComplete="creComp()" xmlns:components1="com.gazuntite.controls.extended.components.*"
					  >
	<s:layout>
		<s:VerticalLayout gap="7" />
	</s:layout>
	
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.util.ValidationUtils;
			import com.gazuntite.common.util.xml.XmlUtils;
			import com.gazuntite.provider.live.services.billing.dto.settings.EDIReceiverDTO;
			import com.gazuntite.provider.live.services.billing.event.BillingEventString;
			import com.gazuntite.provider.live.services.billing.event.settings.LoadEDIReceiverByCriteriaEvent;
			import com.gazuntite.provider.live.services.billing.event.settings.ManageEDIReceiverEvent;
			import com.gazuntite.provider.live.services.billing.model.BillingModelLocator;
			import com.gazuntite.provider.live.services.billing.util.BillingConstants;
			import com.gazuntite.provider.live.services.billing.view.event.DataGridActionEvent;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			import mx.events.ListEvent;
			
			[Bindable]
			private var model:BillingModelLocator = BillingModelLocator.getInstance();
			
			[Bindable] 
			private var SearchTypes:ArrayCollection = new ArrayCollection(["Name","Phone","Contact Person"]);
			
			protected function creComp():void
			{
				var lerEvent:LoadEDIReceiverByCriteriaEvent = new LoadEDIReceiverByCriteriaEvent(0,"0",1);
				CairngormEventDispatcher.getInstance().dispatchEvent(lerEvent);
				
				addEventListeners();
				
				id_EDIReceiverGrid.addEventListener(DataGridActionEvent.EDIT_RECORD_CLICK, editEDIReceiver, false, 0, true);
				id_EDIReceiverGrid.addEventListener(DataGridActionEvent.DELETE_RECORD_CLICK, deleteEDIReceiver, false, 0, true);
				
				id_FilterBar.id_FieldsCmbo.setFocus();
			}
			
			protected function id_EDIReceiverGrid_itemDoubleClickHandler(event:ListEvent):void
			{
				// TODO Auto-generated method stub
			}
									
			protected function id_Add_clickHandler(event:MouseEvent):void
