<?xml version="1.0" encoding="utf-8"?>
<components1:PopupWindow xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  xmlns:components="com.zigron.controls.extended.components.*" 
		  xmlns:PendingBills="com.gazuntite.provider.live.services.billing.view.views.PendingBills.*"
		  creationComplete="Init()" title="Patient Bill"
		  height="{(Capabilities.screenResolutionY)-110}" width="{(Capabilities.screenResolutionX / 2)-21}"
		  skinClass="com.adobe.gazuntite.skins.chrome.titleWindowSkins.reviewAllWindowSkin" xmlns:components1="com.gazuntite.controls.extended.components.*"
		 
		  >
	<!--minHeight="350" minWidth="400"-->
	
	<fx:Script>
		<![CDATA[		
			import com.gazuntite.provider.live.services.billing.dto.PendingBillsDTO;
			import com.gazuntite.provider.live.services.billing.dto.SuperBill.CMS1500DTO;
			import com.gazuntite.provider.live.services.billing.dto.SuperBill.StateCodeDTO;
			import com.gazuntite.provider.live.services.billing.dto.SuperBill.SuperBillENMServiceInfoDTO;
			import com.gazuntite.provider.live.services.billing.dto.SuperBill.SuperBillProcedureInfoDTO;
			import com.gazuntite.provider.live.services.billing.model.BillingModelLocator;
			import com.gazuntite.provider.live.services.billing.util.BillingPopUpManager;
			
			import mx.collections.ArrayCollection;
			import mx.events.CloseEvent;
			
			
			[Bindable]
			public var model:BillingModelLocator = BillingModelLocator.getInstance();
			
			
			[Bindable]
			private var m_oPBDTO:PendingBillsDTO
			
			[Bindable]
			public function get SelectedPendingBill():PendingBillsDTO
			{
				return m_oPBDTO;
			}			
			
			public function set SelectedPendingBill(value:PendingBillsDTO):void
			{
				m_oPBDTO = value;
			}	
			
			[Bindable]
			private var m_aProceduresToManage:ArrayCollection;
			
			public function get ProceduresToManage():ArrayCollection
			{
				return m_aProceduresToManage;
			}
			
			public function set ProceduresToManage(value:ArrayCollection):void
			{
				 m_aProceduresToManage = value;
			}
			
			public function ManageProcedures():void
			{
				ProceduresToManage = new ArrayCollection();
				
				//for (var i:int = 0; i < id_procedures.id_ProcedureGrid.rowCount; i++)
				//{
					//if(id_procedures.id_ProcedureGrid.)
				//}
				
			}

			protected function Init():void
			{				
				//model.TotalCharges = 0;
				//model.CurrentPaymentTypeId = "0";
				//model.CurrentTOSID = "0";				
				for(var i:int = 0; i < SelectedPendingBill.ProcedureInfo.length; i++ )
				{
					var CPTdto:SuperBillProcedureInfoDTO = SelectedPendingBill.ProcedureInfo[i];
					if(CPTdto.Fee != null && CPTdto.Fee != "")
						model.TotalCharges +=  (Number(CPTdto.Fee) * Number(CPTdto.Unit));					
				}					
				model.PatientBalance = 0;
				model.PrimaryResponsibility = Number(SelectedPendingBill.PrimaryResponsibility);
				model.BillingDisallowed = Number(SelectedPendingBill.BillingDisallowed);
				model.SecondaryResponsibility = Number(SelectedPendingBill.SecondaryResponsibility);
				model.AdditionalPayment = Number(SelectedPendingBill.AdditionalPayment);
				model.WriteOff = Number(SelectedPendingBill.WriteOff);
				model.CalculateSuperBill();	
				
				//LoadTypeOfServiceList();
				
				//LoadPlaceOfServiceList();
				
				model.CurrentDiagnosis = SelectedPendingBill.DiagnosisInfo;
				//model.ReceivedProcedures = SelectedPendingBill.ProcedureInfo;
				
				model.CurrentProcedures = new ArrayCollection();
				model.CurrentOtherProcedures = new ArrayCollection();
				if(SelectedPendingBill.ProcedureInfo != null && SelectedPendingBill.ProcedureInfo.length > 0)
				{				
					for(var j:int =0; j < SelectedPendingBill.ProcedureInfo.length; j++)
					{
						var cDTO:SuperBillProcedureInfoDTO = SelectedPendingBill.ProcedureInfo[j];
						
						if(cDTO.Type == "HCPC")
						{
							model.CurrentOtherProcedures.addItem(cDTO);							
						}
						else
						{						
							model.CurrentProcedures.addItem(cDTO);
						}
					}
				}			
				
				model.CurrentENMServiceInfo = new ArrayCollection();
				
				var enm:SuperBillENMServiceInfoDTO = SelectedPendingBill.ENMServiceInfo[0] as SuperBillENMServiceInfoDTO
				model.CurrentENMServiceInfo.addItem(enm);
				
				if(SelectedPendingBill.HCFA != null && SelectedPendingBill.IsSavedSuperBill == true)
				{
					model.CMS1500Info = new CMS1500DTO();
					model.CMS1500Info.CMSID = SelectedPendingBill.HCFA.CMSID;
					model.CMS1500Info.ClaimID = SelectedPendingBill.HCFA.ClaimID;
					model.CMS1500Info.Block10A = SelectedPendingBill.HCFA.Block10A;
					model.CMS1500Info.Block10B = SelectedPendingBill.HCFA.Block10B;
					model.CMS1500Info.Block10C = SelectedPendingBill.HCFA.Block10C;
					model.CMS1500Info.Block20 = SelectedPendingBill.HCFA.Block20;
					model.CMS1500Info.Block20Charges = SelectedPendingBill.HCFA.Block20Charges;
					model.CMS1500Info.Block22 = SelectedPendingBill.HCFA.Block22;
					model.CMS1500Info.Block22RefNumber = SelectedPendingBill.HCFA.Block22RefNumber;
					model.CMS1500Info.Block24B = SelectedPendingBill.HCFA.Block24B;
					model.CMS1500Info.Block32 = SelectedPendingBill.HCFA.Block32;					
					model.CMS1500Info.BlockBStateCode = SelectedPendingBill.HCFA.BlockBStateCode;	
					
					if(model.CMS1500Info.BlockBStateCode.length > 0)
					{
						for(var k:int = 0; k < model.StateCodeList.length; k++)
						{
							var state:StateCodeDTO = model.StateCodeList[k] as StateCodeDTO
							if(state.StateCode == model.CMS1500Info.BlockBStateCode)
							{
								model.CMS1500StateCodeIndex = k;
								break;
							}
							
						}
					}
					else
					{
						model.CMS1500StateCodeIndex = -1;
					}
					
					if(SelectedPendingBill.HCFA.Block16DateFrom != null && SelectedPendingBill.HCFA.Block16DateFrom.indexOf("1901") == -1)
						model.CMS1500Info.Block16DateFrom = SelectedPendingBill.HCFA.Block16DateFrom;
					if(SelectedPendingBill.HCFA.Block16DateTo != null && SelectedPendingBill.HCFA.Block16DateTo.indexOf("1901") == -1)
						model.CMS1500Info.Block16DateTo = SelectedPendingBill.HCFA.Block16DateTo;
					if(SelectedPendingBill.HCFA.Block18DateFrom != null && SelectedPendingBill.HCFA.Block18DateFrom.indexOf("1901") == -1)
						model.CMS1500Info.Block18DateFrom = SelectedPendingBill.HCFA.Block18DateFrom;
					if(SelectedPendingBill.HCFA.Block18DateTo != null && SelectedPendingBill.HCFA.Block18DateTo.indexOf("1901") == -1)
						model.CMS1500Info.Block18DateTo = SelectedPendingBill.HCFA.Block18DateTo;
					
				}
				else
				{
					model.CMS1500Info = new CMS1500DTO();
					model.CMS1500Info.CMSID = "0";
					model.CMS1500Info.ClaimID = "0";
					model.CMS1500Info.Block10A = "false";
					model.CMS1500Info.Block10B = "false";
					model.CMS1500Info.Block10C = "false";
					model.CMS1500Info.Block20 = "false";
					model.CMS1500Info.Block20Charges = "0";
					model.CMS1500Info.Block22 = "";
					model.CMS1500Info.Block22RefNumber = "";
					model.CMS1500Info.Block24B = "";
					model.CMS1500Info.Block32 = "";
					model.CMS1500Info.BlockBStateCode = "";
				}
				
				this.addEventListener(CloseEvent.CLOSE,function ClosePopup(event:CloseEvent):void
				{
					model.ActionButtonEnabled = true;
					if(model.CurrentOtherProcedures != null && model.CurrentOtherProcedures.length > 0)
						model.CurrentOtherProcedures.removeAll();
					if(model.CurrentProcedures != null && model.CurrentProcedures.length > 0)
						model.CurrentProcedures.removeAll();
					BillingPopUpManager.removeAllSectionPopUps(BillingPopUpManager.SUPER_BILL_POPUPS);
				}); 
				
				id_EncounterInfo.id_POSTypes.setFocus();
			}	
			
			/*private function ClosePopup(event:CloseEvent):void
			{
				if(model.CurrentOtherProcedures != null && model.CurrentOtherProcedures.length > 0)
					model.CurrentOtherProcedures.removeAll();
				model.CurrentProcedures = SelectedPendingBill.ProcedureInfo;
				this.removePopup();
			}*/

		]]>
	</fx:Script>

	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:VGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="3" paddingRight="5" gap="1">
	<s:Scroller   height="{(Capabilities.screenResolutionY)-180}" width="{(Capabilities.screenResolutionX / 2)-31}"
				  styleName="blueLargeScrollerSkin" >	
			
	<s:VGroup width="100%" height="100%" gap="1">
		<s:HGroup width="100%" gap="2">
			<PendingBills:PatientInfo width="40%" 							  
									  PatientName="{SelectedPendingBill.Patient}"
									  QuivusId="{SelectedPendingBill.QuivusId}"
									  SSN="{SelectedPendingBill.PatientInfo.SSN}"
									  DOB="{SelectedPendingBill.PatientInfo.DateOfBirth}"
									  Gender="{SelectedPendingBill.PatientInfo.Gender}" 
									  Phone="{SelectedPendingBill.PatientInfo.Phone}"
									  PreferredLocation="{SelectedPendingBill.PatientInfo.PreferredLocation}"
									  ImageData="{SelectedPendingBill.PatientInfo.ImageData}"
									  />
			<PendingBills:InsuranceInfo width="60%" PatientInsuranceInfo="{SelectedPendingBill.PatientInfo.PatientInsuranceInfo}"
										IsSavedSuperBill="{SelectedPendingBill.IsSavedSuperBill}"
										SavedCopay="{SelectedPendingBill.Copay}" 
										/>			
		</s:HGroup>
		<PendingBills:EncounterInfo  id="id_EncounterInfo" width="100%" ServiceDate="{SelectedPendingBill.VisitDate}" 
									PrimaryProvider="{SelectedPendingBill.Provider}" TypeOfServiceTypeId="{SelectedPendingBill.EncounterTypeID}"
									BillingProvider="{SelectedPendingBill.Provider}"
									PlaceOfServiceTypeId="{SelectedPendingBill.ServiceTypeID}"
									PaymentTypeId="{SelectedPendingBill.PaymentTypeID}"
									CheckNo="{SelectedPendingBill.CheckNumber}"	 							
									tabIndex="1"
									/>
		<PendingBills:ENMServiceCharges width="100%" id="id_ENM"
										HistoryLevelSacleValue="{SelectedPendingBill.HistoryLevelScale}" 
										ExaminationLevelSacleValue="{SelectedPendingBill.ExaminationLevelScale}"
										DecisionLevelSacleValue="{SelectedPendingBill.DecisionLevelScale}"
										ENMServiceInfo="{SelectedPendingBill.ENMServiceInfo}"
										tabIndex="8"
										/>
		<s:HGroup width="100%" gap="1">
			<PendingBills:Diagnosis width="40%" id="id_Diagnosis" ICDs="{SelectedPendingBill.DiagnosisInfo}" tabIndex="15"/>
			<components1:CollapsiblePanel skinClass="com.gazuntite.controls.extended.skins.popUpCollapsiblePanelSkin"
										 title="CPT Codes (Laboratory, X-ray &amp; Immunization)" width="60%">
				<PendingBills:Procedures id="id_procedures" width="100%" height="100%" CPTs="{SelectedPendingBill.ProcedureInfo}"
									 VisitId="{SelectedPendingBill.VisitId}"
									 PatientId="{SelectedPendingBill.PatientId}"
									 ServiceDate="{SelectedPendingBill.VisitDate}"
									 ReqNo="{1}"
									 tabIndex="20"
									 />
				</components1:CollapsiblePanel>
			
		</s:HGroup>
		<s:HGroup width="100%" gap="1">		
			<PendingBills:WorkRelatedServices id="id_WRS" width="40%" Services="{SelectedPendingBill.WRSInfo}" tabIndex="28"/>
				<!--<s:TileGroup width="100%" >
					<s:Label text="Other Service Charges" fontWeight="bold"/>
				</s:TileGroup>-->
				<PendingBills:OtherServiceCharges id="id_otherProcedures" width="60%"
												  VisitId="{SelectedPendingBill.VisitId}"
												  PatientId="{SelectedPendingBill.PatientId}"
												  ServiceDate="{SelectedPendingBill.VisitDate}"		
												  SelectedPendingBill="{SelectedPendingBill}"
												  tabIndex="47"
												  />
		 </s:HGroup>
		<PendingBills:AdditionalInfo id="id_additional" width="100%" tabIndex="59"/>
	</s:VGroup>
		
	</s:Scroller>
		<PendingBills:PatientBillButtonBar id="id_generateSuperBillButton" width="100%" SelectedPendingBill="{SelectedPendingBill}" tabIndex="81" />
	</s:VGroup>
</components1:PopupWindow>
