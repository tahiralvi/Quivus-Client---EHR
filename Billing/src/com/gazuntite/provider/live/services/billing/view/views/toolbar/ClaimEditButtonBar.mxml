<?xml version="1.0" encoding="utf-8"?>
<s:HGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx">

	<fx:Metadata>
		[Event(name="Save", type="flash.events.Event")]
		[Event(name="Cancel", type="flash.events.Event")]
		
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			
			public static const SAVE				:String = "Save";
			public static const CANCEL				:String = "Cancel";
			
			protected function clickHandler(event:MouseEvent):void
			{
				var btn:Button = event.currentTarget as Button;
				switch( btn.id )
				{
					case "id_saveBtn":
						dispatchEvent( new Event( SAVE, true ) );
						break;
					case "id_cancelBtn":
						dispatchEvent( new Event( CANCEL, true ) );
						break;								
				}
			}
		]]>
	</fx:Script>

	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	<s:HGroup  width="100%"/>
	<s:Button buttonMode="true" id="id_saveBtn" label="Save"  
			  click="clickHandler(event)" tabIndex="8"
			  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.ListBtn" toolTip="{id_saveBtn.label}"/>
	<s:Button buttonMode="true" id="id_cancelBtn" label="Cancel" 
			  click="clickHandler(event)" tabIndex="9"
			  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.ListBtn" toolTip="{id_cancelBtn.label}"/>
	
	
</s:HGroup>
