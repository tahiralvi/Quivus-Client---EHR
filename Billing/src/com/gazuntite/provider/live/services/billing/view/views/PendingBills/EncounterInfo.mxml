	<s:HGroup width="100%" >	
		<s:VGroup width="80%" gap="2" >
			<s:HGroup width="100%" verticalAlign="middle" >
				<s:Label text="Service Date:"  color="#666666" fontFamily="Calibri"  fontSize="11" width="100"/>
				<s:Label text="{ServiceDate}" width="75"  fontFamily="Calibri"  fontSize="11" color="#333333"/>
				<components1:LabelComboBox id="id_POSTypes"  labelField="POSDescription" width="125" dataProvider="{model.PlaceOfServiceTypeList}"
										  keyUp="id_POSTypes_KeyUpHandler(event)"  change="SetService(event)" focusOut="SetFocus(event)" 
										  prompt="Place of Service" 									  
										  />
				<components1:LabelComboBox id="id_TOSTypes"  labelField="EncounterTypeName" width="125" dataProvider="{model.TypeOfServiceList}"	
										  change="SetService(event)" focusOut="SetFocus(event)"
										  prompt="Type of Service" 
										  />
			</s:HGroup>
			<s:HGroup width="100%" verticalAlign="middle">		
				<s:Label text="Copay:" color="#666666" fontFamily="Calibri"  fontSize="11"  width="100"/>
				<components1:LabelTextInput id="id_Copay" restrict="[0-9]\." text="{model.DisplayCopay}" width="75" focusOut="id_Copay_focusOutHandler(event)"  color="#333333" fontFamily="Calibri"  fontSize="11"
							 toolTip="{ model.ReceivedCopay}"
							  />
				
				<s:Label text="Mode of Payment" color="#666666" fontFamily="Calibri"  fontSize="11" width="85"/>
				<s:HGroup verticalAlign="middle" width="100%">
					<s:RadioButton id="id_cash" label="Cash"  click="rdoPaymentMode_changeHandler(event)" color="#666666" fontFamily="Calibri"  fontSize="11" />
					<s:RadioButton id="id_check" label="Check"  click="rdoPaymentMode_changeHandler(event)" color="#666666" fontFamily="Calibri"  fontSize="11" />
					<s:RadioButton id="id_CC" label="Credit Card"  click="rdoPaymentMode_changeHandler(event)" color="#666666" fontFamily="Calibri"  fontSize="11" />
				</s:HGroup>
			</s:HGroup>
			<s:HGroup width="100%" verticalAlign="middle">
				
				<s:Label text="Primary Provider:"  color="#666666" fontFamily="Calibri"  fontSize="11" width="100"/>
				<s:Label text="{PrimaryProvider}" width="75" color="#333333" fontFamily="Calibri"  fontSize="11"/>
				<s:Label text="Billing Provider:" width="85" color="#666666" fontFamily="Calibri"  fontSize="11"/>
				<s:Label text="{BillingProvider}" width="85" color="#333333" fontFamily="Calibri"  fontSize="11"/>
				<s:HGroup width="100%">
					
					<components1:LabelTextInput  height="19" id="id_CheckNo" prompt="Check #" width="85" visible="{id_check.selected}" 
												focusOut="id_CheckNo_focusOutHandler(event)" includeInLayout="{id_CheckNo.visible}" 
												maxChars="50"												
												/>
					
				</s:HGroup>
			</s:HGroup>
		</s:VGroup> 
		<s:VGroup width="20%" height="100%" verticalAlign="middle">
			<s:Label width="100%" text="{model.TotalCharges}" color="#111111" fontFamily="Calibri Bold"  fontSize="17" textAlign="center"/>
			<s:Label width="100%" text="Total Amount"  textAlign="center" fontFamily="Calibri Bold" fontSize="17" color="#666666"/>
		</s:VGroup>
	</s:HGroup>
