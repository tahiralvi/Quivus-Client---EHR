			private function SetService(event:IndexChangeEvent):void
			{
				var cmb:LabelComboBox = event.currentTarget as LabelComboBox;
				if(cmb.id == "id_POSTypes" && id_POSTypes.selectedIndex > -1)
				{
					model.CurrentPOSCode = (id_POSTypes.selectedItem as PlaceOfServiceTypeDTO).POSCode;
					model.CurrentPOSTypeID = (id_POSTypes.selectedItem as PlaceOfServiceTypeDTO).ServiceTypeID;
				}
				
				if(cmb.id == "id_TOSTypes" && id_TOSTypes.selectedIndex > -1)
					model.CurrentTOSID = (id_TOSTypes.selectedItem as EncounterTypeDTO).EncounterTypeID;
			}	

			protected function SetFocus(event:FocusEvent):void
			{
				var cmb:LabelComboBox = event.currentTarget as LabelComboBox;
				if(cmb.id == "id_POSTypes" && id_POSTypes.selectedIndex > -1)
				{
					model.CurrentPOSCode = (id_POSTypes.selectedItem as PlaceOfServiceTypeDTO).POSCode;
					model.CurrentPOSTypeID = (id_POSTypes.selectedItem as PlaceOfServiceTypeDTO).ServiceTypeID;
				}
				
				if(cmb.id == "id_TOSTypes" && id_TOSTypes.selectedIndex > -1)
					model.CurrentTOSID = (id_TOSTypes.selectedItem as EncounterTypeDTO).EncounterTypeID;
			}

			public var LastChildTabIndex:int = 0; 
			private function SetTabIndexes():void
			{
				var incrementer:int = 0;
				id_POSTypes.tabIndex = tabIndex + (++incrementer);
				id_TOSTypes.tabIndex = tabIndex + (++incrementer);
				id_Copay.tabIndex = tabIndex + (++incrementer);
				id_cash.tabIndex = tabIndex + (++incrementer);
				id_check.tabIndex = tabIndex + (++incrementer);
				id_CheckNo.tabIndex = tabIndex + (++incrementer);
				id_CC.tabIndex = tabIndex + (++incrementer);
				
				LastChildTabIndex = ++incrementer;
			}	
			protected function CC():void
			{
				
				SetTabIndexes();
				model.CheckNo = CheckNo;
				model.CurrentPaymentTypeId = PaymentTypeId;
				
				if(model.CurrentPaymentTypeId == "1")
				{
					id_CheckNo.text = CheckNo;
					id_check.selected = true;
					model.ModeOfPayment = id_check.label;
				}
				else if(model.CurrentPaymentTypeId == "2")
				{
					id_cash.selected = true;
					model.ModeOfPayment = id_cash.label;
				}
				else if(model.CurrentPaymentTypeId == "3")
				{
					id_CC.selected = true;
					model.ModeOfPayment = id_CC.label;
				}				
				
				if(TypeOfServiceTypeId != "0")
				{
					for(var i:int = 0;i < model.TypeOfServiceList.length; i++)
					{
						var tosDTO:EncounterTypeDTO = model.TypeOfServiceList[i] as EncounterTypeDTO;
						
						if(tosDTO.EncounterTypeID == TypeOfServiceTypeId)
						{
							model.CurrentTOSID = TypeOfServiceTypeId
							id_TOSTypes.selectedItem = tosDTO;
							break;
						}
					}
				}
				
				if(PlaceOfServiceTypeId != "0")
				{
					model.CurrentPOSTypeID = PlaceOfServiceTypeId;					
					if(model.PlaceOfServiceTypeList != null && model.PlaceOfServiceTypeList.length > 0)
					{						
						for(var j:int = 0;j < model.PlaceOfServiceTypeList.length; j++)
						{
							var posDTO:PlaceOfServiceTypeDTO = model.PlaceOfServiceTypeList[j] as PlaceOfServiceTypeDTO;
							
							if(posDTO.ServiceTypeID == PlaceOfServiceTypeId)
							{								
								id_POSTypes.selectedItem = posDTO;
								break;
							}
						}
					}
				}				
			}			


			protected function id_CheckNo_focusOutHandler(event:FocusEvent):void
			{
				if(id_check.selected == true && UtilityFunctions.IsNullOrEmpty(id_CheckNo.text) == false)
				{
					model.CheckNo = id_CheckNo.text;
				}
			}

		]]>
