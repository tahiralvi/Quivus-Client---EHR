<?xml version="1.0" encoding="utf-8"?>
<components2:PopupWindow xmlns:fx="http://ns.adobe.com/mxml/2009" 
						xmlns:s="library://ns.adobe.com/flex/spark" 						
						xmlns:mx="library://ns.adobe.com/flex/mx"
						skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.TitleWindowSkin"
						xmlns:components="com.gazuntite.controls.extended.components.*"
						xmlns:components1="com.gazuntite.provider.live.services.billing.view.views.insuranceSettings.views.components.*"
						width="475" height="100%" xmlns:components2="com.gazuntite.controls.extended.components.*" >
	<fx:Metadata>
		[Event(name="saveClick", type="mx.events.Event")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.AddInsuranceDTO;
			import com.gazuntite.provider.live.services.billing.model.BillingModelLocator;
			
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			import mx.events.IndexChangedEvent;
			
			[Bindable]
			private var model:BillingModelLocator = BillingModelLocator.getInstance();
			
			[Bindable]
			private var type:ArrayCollection = new ArrayCollection(["Leave blank","Signature on file",	"Print name"]);
			
			[Bindable]
			private var typeArray:ArrayCollection = new ArrayCollection(["Medicare","Medicaid","Tricare/Champus","ChampsVA","Group","FECA","Blue Cross/Shield","Worker's Comp"
																	,"HMO","PPO"]);
			[Bindable]
			private var defaultArray:ArrayCollection = new ArrayCollection(["Paper","Electronic"]);
		
			//[Bindable]
			//private var ediArray:ArrayCollection = new ArrayCollection(["Direct","Clearing House"]);
						
			[Bindable]
			private var pinsArray:ArrayCollection = new ArrayCollection(["Leave","PinOnly"]);
			
			[Bindable]
			private var code:ArrayCollection = new ArrayCollection([1,2,3,4]);
			
			
			private var _insurance:AddInsuranceDTO;                 
			[Bindable]
			public function get insurance():AddInsuranceDTO
			{
				return _insurance;
			}
			
			public function set insurance(value:AddInsuranceDTO):void
			{
				_insurance = value;
			}
			
			public function EditSave():void
			{
				var objToSetFocus:Object = null;
				if(this.title.indexOf("(NEW)") > -1)
				{					
					model.insuranceDto = new AddInsuranceDTO();
					InitailizeDto();
					objToSetFocus = id_Insurance.SaveInsurance();
					if(objToSetFocus)
					{
						id_EditInsurance.selectedIndex = 0;
						objToSetFocus.setFocus();
						return;
					}
					
					objToSetFocus = id_InsCode.SaveInsurance();
					if(objToSetFocus)
					{
						id_EditInsurance.selectedIndex = 1;
						objToSetFocus.setFocus();
						return;
					}
					
					id_EDI.SaveInsurance();
					objToSetFocus = id_EDI.SaveInsurance();
					if(objToSetFocus)
					{
						id_EditInsurance.selectedIndex = 2;
						objToSetFocus.setFocus();
						return;
					}
				}
				else	
				{		
					objToSetFocus = id_Insurance.UpdateInsurance();
					if(objToSetFocus)
					{
						id_EditInsurance.selectedIndex = 0;
						objToSetFocus.setFocus();
						return;
					}
					
					objToSetFocus = id_InsCode.UpdateInsurance();
					if(objToSetFocus)
					{
						id_EditInsurance.selectedIndex = 1;
						objToSetFocus.setFocus();
						return;
					}					
					
					objToSetFocus = id_EDI.UpdateInsurance();
					if(objToSetFocus)
					{
						id_EditInsurance.selectedIndex = 2;
						objToSetFocus.setFocus();
						return;
					}
				}
				
				/* for (var i:int = 0; i < model.InsList.length; i++) 
				{
					var insName:String = UtilityFunctions.TrimString((model.InsList[i] as AddInsuranceDTO).InsuranceName).toLowerCase();					
					
					if(currentDTO.InsOrganizationID != "0" &&  currentDTO.InsOrganizationID == (model.InsList[i] as AddInsuranceDTO).InsOrganizationID && UtilityFunctions.TrimString(currentDTO.InsuranceName).toLowerCase() == insName ) continue;
					
					if( insName == UtilityFunctions.TrimString(currentDTO.InsuranceName).toLowerCase() )
					{
						Alert.show("Insurance name [" + UtilityFunctions.TrimString(currentDTO.InsuranceName) + "] already exists.","Confirmation", 4, FlexGlobals.topLevelApplication.mainContainer);
						return;
					}					
				} */
				
				dispatchEvent( new Event("saveClick", true, true ));
			}
			
			public function InitailizeDto():void
			{
				model.insuranceDto.CategoryTypeID				= "0";
				model.insuranceDto.InsuranceName				= "";
				model.insuranceDto.Address 						= "";
				model.insuranceDto.City 						= "";
				model.insuranceDto.Phone						= "";
				model.insuranceDto.Extension 					= "";
				model.insuranceDto.FAX							= "";
				model.insuranceDto.State 						= "";
				model.insuranceDto.ZIP							= "";
				model.insuranceDto.PlanName						= "";
				model.insuranceDto.Note							= "";
				model.insuranceDto.ModifiedBy					= "0";
				model.insuranceDto.CreatedBy					= "0";
				
				model.insuranceDto.PatientSignatureOnFile		= "0";
				model.insuranceDto.InsuredSignatureOnFile 		= "0";
				model.insuranceDto.PhysicianSignatureOnFile 	= "0";
				model.insuranceDto.PrintPINsOnInsForm 			= "0";
				model.insuranceDto.PrimaryMediaTypeID 			= "0";
				model.insuranceDto.SecondaryMediaTypeID			= "0";
				model.insuranceDto.TertiaryMediaTypeID			= "0";
			}
			
			public function callBack():void{}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				removePopup();
			}
			
			protected function id_EditInsurance_changeHandler(event:IndexChangedEvent):void
			{
				switch(id_EditInsurance.selectedIndex)
				{
					case 0:
						id_Insurance.id_Name.setFocus();
						break;
					case 1:
						id_InsCode.id_ProcedureCodeSet.setFocus();
						break;
					case 2:
						id_EDI.id_PrimaryEDI.setFocus();
						break;
				}
			}
			
			protected function id_Insurance_creationCompleteHandler(event:FlexEvent):void
			{
				id_Insurance.id_Name.setFocus();
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<components:layout>
		<s:VerticalLayout gap="1" paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5"/>
	</components:layout>
	<s:ButtonBar dataProvider="{id_EditInsurance}" styleName="blackButtonBarSkin" buttonMode="true" useHandCursor="true" width="400"/>
	<mx:ViewStack id="id_EditInsurance" width="100%"  resizeToContent="true" height="100%" creationPolicy="all" change="id_EditInsurance_changeHandler(event)" >
		<s:NavigatorContent width="100%" height="100%" label="Address" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.lightGreyBGContainer">
			<components1:InsuranceAddress id="id_Insurance" insurance="{insurance}"   width="100%" height="100%" creationComplete="id_Insurance_creationCompleteHandler(event)" />
		</s:NavigatorContent>
		<s:NavigatorContent width="100%" height="100%" label="Options and Codes" 
							skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.lightGreyBGContainer">
			<components1:InsuranceCodes id="id_InsCode" width="100%" height="100%" insurance="{insurance}" typeArrayCollection="{type}" defaultArrayCollection="{defaultArray}"
										pinsArray="{pinsArray}" code="{code}" />
		</s:NavigatorContent >
		<s:NavigatorContent width="100%" height="100%" label="EDI/Eligibility" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.lightGreyBGContainer">
			<components1:EDI width="100%" height="100%" id="id_EDI" insurance="{insurance}" typesArray="{typeArray}"  />
		</s:NavigatorContent>
		<s:NavigatorContent width="100%" height="250" label="Allowed" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.lightGreyBGContainer" >
			<components1:Allowed width="100%" height="100%"/>
		</s:NavigatorContent>
	</mx:ViewStack>
	<mx:HRule width="100%" />
	<s:HGroup width="100%" horizontalAlign="right">
		<s:Button styleName="blackButtonSkin" label="Save" width="50" click="EditSave()" useHandCursor="true" buttonMode="true" toolTip="Save"/>
		<s:Button styleName="blackButtonSkin" label="Cancel" width="60" useHandCursor="true" buttonMode="true" toolTip="Cancel" click="button1_clickHandler(event)"/>
	</s:HGroup>
</components2:PopupWindow>