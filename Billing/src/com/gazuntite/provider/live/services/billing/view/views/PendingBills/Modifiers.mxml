	<components:layout>
		<s:VerticalLayout gap="1" paddingBottom="5" paddingLeft="5"  paddingRight="5" paddingTop="5"/>
	</components:layout>
	<s:HGroup width="100%">
		<components1:LabelComboBox id="id_Modi1Cmbo"  labelField="ModifierDescription" width="100" dataProvider="{model.CPTModifierTypeList1}"
								  keyUp="modi1KeyUpHandler(event)" tabIndex="1"
								  prompt="Modifier1" focusAlpha="0" focusEnabled="false" focusRect="false"/>
		<components1:LabelComboBox id="id_Modi2Cmbo"  labelField="ModifierDescription" width="100" dataProvider="{model.CPTModifierTypeList2}"
								  keyUp="modi2KeyUpHandler(event)" tabIndex="2"
								  prompt="Modifier2" focusAlpha="0" focusEnabled="false" focusRect="false"/> 
		<components1:LabelComboBox id="id_Modi3Cmbo"  labelField="ModifierDescription" width="100" dataProvider="{model.CPTModifierTypeList3}"
								  keyUp="modi3KeyUpHandler(event)" tabIndex="3"
								  prompt="Modifier3" focusAlpha="0" focusEnabled="false" focusRect="false"/>
		<components1:LabelComboBox id="id_Modi4Cmbo"  labelField="ModifierDescription" width="100" dataProvider="{model.CPTModifierTypeList4}"
								  keyUp="modi4KeyUpHandler(event)" tabIndex="4"
								  prompt="Modifier4" focusAlpha="0" focusEnabled="false" focusRect="false"/> 
	</s:HGroup>
	<s:HGroup width="100%" horizontalAlign="center">
		<s:Button width="60" styleName="blackButtonSkin" id="id_ADD" label="ADD" click="id_ADD_clickHandler(event)" toolTip="Add" useHandCursor="true" buttonMode="true" tabIndex="5" />
		<s:Button width="60" styleName="blackButtonSkin" id="id_Cancel" label="Cancel" click="id_Cancel_clickHandler(event)" tabIndex="6" />
	</s:HGroup>
	
</components1:PopupWindow>
