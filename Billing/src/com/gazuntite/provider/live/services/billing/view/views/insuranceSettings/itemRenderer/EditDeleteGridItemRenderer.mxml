<?xml version="1.0" encoding="utf-8"?>
<s:MXAdvancedDataGridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
								  xmlns:s="library://ns.adobe.com/flex/spark" 
								  xmlns:mx="library://ns.adobe.com/flex/mx" 
								  focusEnabled="true">
	<fx:Metadata>
		[Event(name="editClick", type="mx.events.Event")]
		[Event(name="deleteClick", type="mx.events.Event")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			

			protected function id_EditBtn_clickHandler(event:MouseEvent):void
			{
				dispatchEvent (new  Event("editClick" ,	true,true)) ;
			}      
			
		
			protected function id_DeleteBtn_clickHandler(event:MouseEvent):void
			{
				dispatchEvent (new  Event("deleteClick" ,	true,true)) ;
			}
			
		]]>
	</fx:Script>
	<s:layout>
		<s:HorizontalLayout verticalAlign="top"/>
	</s:layout>
	<s:Button id="id_EditBtn" click="id_EditBtn_clickHandler(event)" styleName="editButtonSkin"   />
	<s:Button id="id_DeleteBtn" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.deleteButton" click="id_DeleteBtn_clickHandler(event)" />
</s:MXAdvancedDataGridItemRenderer>
