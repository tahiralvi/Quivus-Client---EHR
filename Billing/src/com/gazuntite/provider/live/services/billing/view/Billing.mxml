	<!--<s:BorderContainer width="100%" height="100%"  styleName="greyBGContainerSkin">
		<s:layout>
			<s:VerticalLayout gap="-5" />				
		</s:layout>-->
	
	<s:layout>
		<s:VerticalLayout paddingTop="4" paddingBottom="4" paddingLeft="2" paddingRight="2" gap="-4" />
	</s:layout>
	
	<s:ButtonBar  id= "id_Tabs"   width="625" dataProvider = "{id_vsViews}"  styleName="blackButtonBarSkin" buttonMode="true" useHandCursor="true" />	
	<s:SkinnableContainer minHeight="100" height="100%" width="100%"  skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.blackTitleBGContainer">
		<s:layout>
			<s:VerticalLayout paddingTop="5" paddingBottom="5" paddingRight="2" horizontalAlign="right" />
		</s:layout>
		
		<mx:ViewStack id="id_vsViews" width = "100%" height = "100%"  
					  change="id_vsViews_changeHandler(event)" resizeToContent="true"				  
					  >
			<s:NavigatorContent label="{'Pending Bills'+' '+ '('+model.totalrecords_PB.toString()+')'}" width = "100%" height = "100%">
				<PendingBills:PendingBills  id="id_PendingBills" width="100%" toolTip="Pending Bills"/>
			</s:NavigatorContent>
			<s:NavigatorContent label = "Inbox" width = "100%" height = "100%"  >
				<s:Label text="Work in Progress"  fontFamily="Calibri" fontSize="14" verticalCenter="0" horizontalCenter="0"   />
			</s:NavigatorContent>
			<s:NavigatorContent  label="Claim Management" width = "100%" height = "100%" >
				<claimManagement:ClaimManagement id="id_ClaimManagement" width="100%" />
			</s:NavigatorContent>
			<s:NavigatorContent label = "Accounts And Receivables" width = "100%" height = "100%" >
				<accountsAndReceivables:AccountsAndReceivableView width="100%" />
			</s:NavigatorContent>
			<s:NavigatorContent label = "Reports" width = "100%" height = "100%">
				<report:BillingReportView width="100%" height="100%" />
			</s:NavigatorContent>
			<s:NavigatorContent label = "Settings" width = "100%" height = "100%" >
				<views:BillingSetUp width="100%"/>
			</s:NavigatorContent>
		</mx:ViewStack>		
		</s:SkinnableContainer>
		<!--</s:BorderContainer>-->
</s:Group>
