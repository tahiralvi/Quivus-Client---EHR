	<fx:Style source="..\Skin\src\Styles\AppLevelTextInputSkins.css" />
	<fx:Style source="..\Skin\src\Styles\AppLevelButtonSkins.css" />
	<fx:Style source="..\Skin\src\Styles\AppLevelDataGridSkins.css" />
	<fx:Style source="..\Skin\src\Styles\AppLevelContainerSkins.css" />
	<fx:Style source="..\Skin\src\Styles\AppLevelButtonBarSkins.css" />
