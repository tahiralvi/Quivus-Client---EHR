			private var vResult:ValidationResultEvent;
			protected function id_BillDate_focusOutHandler(event:FocusEvent):void
			{
				if(UtilityFunctions.IsNullOrEmpty(id_BillDate.text) == false )
				{
					vResult = dateVal.validate(id_BillDate.text);
					if(vResult.type == ValidationResultEvent.VALID)					
					{
						if(CarrierNo == 1)
							model.ClaimCarrier1.BillDate = UtilityFunctions.FormatDate(id_BillDate.text);
						else if(CarrierNo == 2)
							model.ClaimCarrier2.BillDate = UtilityFunctions.FormatDate(id_BillDate.text);
						else if(CarrierNo == 3)
							model.ClaimCarrier3.BillDate = UtilityFunctions.FormatDate(id_BillDate.text);	
						else if(CarrierNo == 4)
							model.ClaimPatientBilling.BillDate = UtilityFunctions.FormatDate(id_BillDate.text);
					}
					else
					{
						Alert.show('Please write date in following format'+'\n'+'MM/DD/YYYY', 'Wrong date/format',4,FlexGlobals.topLevelApplication.mainContainer);						
					}
				}
			}
			
			[Bindable] public var EDIReceiverName:String = "";
			
			protected function id_addRemoveButton_clickHandler(event:MouseEvent):void
			{
				if(id_addRemoveButton.label == "Remove From Claim")
				{
					if(ClaimCarrier.InsuranceID != "0")
						ClaimCarrier.IsDeleted = "true";
					
					IsCarrierExists = false;
					id_addRemoveButton.label = "Add To Claim";
				} 
				else if(id_addRemoveButton.label == "Add To Claim")
				{
					if(ClaimCarrier.InsuranceID != "0")
						ClaimCarrier.IsDeleted = "false";
					
					ClaimCarrier.isAddedToClaim = true;
					IsCarrierExists = true;
					id_addRemoveButton.label = "Remove From Claim";
				}
				
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<mx:DateFormatter id="dateFormatter" formatString="MM/DD/YYYY"/>
		<mx:DateValidator id="dateVal"  inputFormat="MM/DD/YYYY"  />
	</fx:Declarations>
		
	<s:HGroup width="100%">
		<s:VGroup width="50%">
			<s:Label text="CLAIM STATUS:" fontFamily="Calibri" fontSize="11"  color="#333333"/>
			<s:HGroup width="100%">
				<s:RadioButton id="id_Hold" width="100"  fontFamily="Calibri" fontSize="11"  color="#333333" label="Hold" 
							   groupName="Status" change="RadioChangeHandler(event)" enabled="{IsCarrierExists}" />
				<s:RadioButton id="id_Alert" width="100" label="Alert" groupName="Status" fontFamily="Calibri" fontSize="11"  color="#333333"
							   change="RadioChangeHandler(event)" enabled="{IsCarrierExists}" />
			</s:HGroup>
			<s:HGroup width="100%">
				<s:RadioButton id="id_Ready" width="100" fontFamily="Calibri" fontSize="11"  color="#333333"
							   label="Ready to Send" groupName="Status" change="RadioChangeHandler(event)" enabled="{IsCarrierExists}" />
				<s:RadioButton id="id_Done" width="100" label="Done" fontFamily="Calibri" fontSize="11"  color="#333333"
							   groupName="Status" change="RadioChangeHandler(event)" enabled="{IsCarrierExists}" />
			</s:HGroup>
			<s:HGroup width="100%">
				<s:RadioButton id="id_Sent" width="100" label="Sent" fontFamily="Calibri" fontSize="11"  color="#333333"
							   groupName="Status" change="RadioChangeHandler(event)"  enabled="{IsCarrierExists}" />
				<s:RadioButton id="id_Pending" width="100" label="Pending" groupName="Status" fontFamily="Calibri" fontSize="11"  color="#333333" 
							   change="RadioChangeHandler(event)"  enabled="{IsCarrierExists}"/>
			</s:HGroup>
			<s:HGroup width="100%">
				<s:RadioButton id="id_Rejected" width="100" label="Rejected"
							   fontFamily="Calibri" fontSize="11"  color="#333333"
							   groupName="Status" change="RadioChangeHandler(event)"  enabled="{IsCarrierExists}"/>
				<s:RadioButton id="id_Challenge" width="100" label="Challenge" fontFamily="Calibri" fontSize="11"  color="#333333"
							   groupName="Status" change="RadioChangeHandler(event)"  enabled="{IsCarrierExists}"/>
			</s:HGroup>
		</s:VGroup>
		<s:VGroup width="50%">
			<s:Label text="BILLING METHOD:"  fontFamily="Calibri" fontSize="11"  color="#333333"/>
			<s:HGroup width="100%">
				<s:RadioButton id="id_Paper" width="100" fontFamily="Calibri" fontSize="11"  color="#333333"
							   label="Paper" groupName="Method" change="RadioChangeHandler(event)"  enabled="{IsCarrierExists}"/>
				<s:RadioButton id="id_Electronic" width="100" fontFamily="Calibri" fontSize="11"  color="#333333"
							   label="Electronic" groupName="Method" change="RadioChangeHandler(event)"  enabled="{IsCarrierExists}"/>
			</s:HGroup>
			<s:HGroup width="100%">
				<s:Label width="100" text="Initial Bill Date:" fontFamily="Calibri" fontSize="11"  color="#333333"/>
				<s:Label width="100"  text="{IniBillDate}" fontFamily="Calibri" fontSize="11"  color="#333333"/>
			</s:HGroup>
			<s:HGroup width="100%">
				<s:Label width="100" text="Batch:" fontFamily="Calibri" fontSize="11"  color="#333333"/>
				<s:Label width="100"  text="{BatchID}" fontFamily="Calibri" fontSize="11"  color="#333333"/>
			</s:HGroup>
			<s:HGroup width="100%">
				<s:Label width="100" text="Submission Count:" fontFamily="Calibri" fontSize="11"  color="#333333"/>
				<s:Label width="100"  text="{ClaimCarrier.SubmissionCount}" fontFamily="Calibri" fontSize="11"  color="#333333"/>
			</s:HGroup>
			<s:HGroup width="100%">
				<s:Label width="100" text="Billing Date:" fontFamily="Calibri" fontSize="11"  color="#333333"/>
				<components1:LabelDateField id="id_BillDate" width="100" fontFamily="calibri" fontSize="11" yearNavigationEnabled="true"
										   minYear="1901" maxYear="{new Date().getFullYear()}" selectableRange="{{rangeStart:new Date() + 1}}"
										   enabled="{IsCarrierExists &amp;&amp; id_Ready.selected ? true : false }" focusOut="id_BillDate_focusOutHandler(event)" disabledRanges="{[{rangeEnd: new Date()}]}"
										   />
			</s:HGroup>
		</s:VGroup>
	</s:HGroup>
	<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="center">
		<components1:LabelComboBox id="id_InsuranceCmb" width="30%" prompt="{'Insurance ' + ClaimCarrier.InsuranceTypeId}" 
								  keyUp="id_InsuranceCmb_keyUpHandler(event)" labelField="InsuranceName"
								  dataProvider="{InsuranceListforCarrier}" change="id_InsuranceCmb_changeHandler(event)"
								  enabled="{IsCarrierExists}" visible="{ CarrierNo == 4 ? false : true }"
								  />
		<!--<components:LabelComboBox id="id_EDIReceiverCmb" width="30%" prompt="{'EDI Receiver ' + ClaimCarrier.InsuranceTypeId}" dataProvider="{EDIReceivers}"
								  change="id_EDIReceiverCmb_changeHandler(event)" labelField="Name"
								  enabled="{IsCarrierExists}"
								  />-->
		<s:Label id="id_Receiver" width="30%" text="{'EDI Receiver: ' + EDIReceiverName  }" visible="{ CarrierNo == 4 ? false : true }" />
		<components1:LabelComboBox id="id_FrequencyCmb" width="30%" prompt="Frequency Code" visible="{ClaimCarrier.InsuranceTypeId == '1' ? true : false}" 
								  dataProvider="{model.FrequencyCodeList}" labelField="FrequencyCode" change="id_FrequencyCmb_changeHandler(event)" enabled="{IsCarrierExists}" />
	</s:HGroup>
	<s:HGroup width="100%" includeInLayout="{ClaimCarrier.InsuranceTypeId == '4' ? true : false}" visible="{ClaimCarrier.InsuranceTypeId == '4' ? true : false}">
		<s:Label text="STATEMENT TYPE:" fontFamily="Calibri" fontSize="11"  color="#333333"/>
		<s:RadioButton id="id_standard" width="100" label="Standard"
					   fontFamily="Calibri" fontSize="11"  color="#333333"
					   groupName="stmntType" change="RadioChangeHandler(event)"  enabled="{IsCarrierExists}"/>
		<s:RadioButton id="id_remainder" width="100" label="Rmainder" fontFamily="Calibri" fontSize="11"  color="#333333"
					   groupName="stmntType" change="RadioChangeHandler(event)"  enabled="{IsCarrierExists}"/>
	</s:HGroup>
	<s:HGroup width="100%">
		<s:Button id="id_addRemoveButton" width="250" click="id_addRemoveButton_clickHandler(event)"/>		
	</s:HGroup>
</s:VGroup>
