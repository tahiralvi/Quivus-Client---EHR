			private function SetTabIndexes():void
			{
				//var incrementer:int = 0;
				//id_POSTypes.tabIndex = tabIndex + (++incrementer);
				id_Hold.tabIndex = 1;	
				id_Alert.tabIndex = 2;
				id_Ready.tabIndex = 3;
				id_Done.tabIndex = 4;
				id_Sent.tabIndex = 5;
				id_Pending.tabIndex = 6;
				id_Rejected.tabIndex = 7;
