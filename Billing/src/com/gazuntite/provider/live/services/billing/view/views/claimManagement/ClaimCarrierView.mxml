			protected function vgroup1_creationCompleteHandler(event:FlexEvent):void
			{
				/* if(model.EDIReceiverList == null || model.EDIReceiverList.length == 0)
				{
					var lerEvent:LoadEDIReceiverByCriteriaEvent = new LoadEDIReceiverByCriteriaEvent(0,"0",0);
					CairngormEventDispatcher.getInstance().dispatchEvent(lerEvent);
				}
				
				 if(model.EDIReceiverList != null && model.EDIReceiverList.length > 0)
				{
					EDIReceivers = new ArrayCollection();
					
					for each (var receiver:EDIReceiverDTO in model.EDIReceiverList) 
					{
						EDIReceivers.addItem(receiver);
					}					
				}  */
				
				IniBillDate = model.ClaimCarrierIniBillDate
				
				ClaimCarrier = null;
				id_addRemoveButton.visible = false;
					
				if(CarrierNo == 1)
				{
					InsuranceListforCarrier = model.InsuranceListforCarrier1;
					ClaimCarrier = model.ClaimCarrier1;					
				}
				else if(CarrierNo == 2)
				{
					InsuranceListforCarrier = model.InsuranceListforCarrier2;
					ClaimCarrier = model.ClaimCarrier2;					
				}
				else if(CarrierNo == 3)
				{
					InsuranceListforCarrier = model.InsuranceListforCarrier3;
					ClaimCarrier = model.ClaimCarrier3;					
				}
				else if(CarrierNo == 4)
				{					
					ClaimCarrier = model.ClaimPatientBilling;					
				}
				
				if( ClaimCarrier == null) 
				{
					id_BillDate.enabled = false;
					IsCarrierExists = false;
					return;
				}
				
				id_addRemoveButton.visible = true;
				InitializeValues();
				
				/* if(ClaimCarrier.InsOrganizationID != "0" )
				{
					InitializeValues();
				}	 */	
				
				if(ClaimCarrier.isAddedToClaim)
				{	IsCarrierExists = true;
					id_addRemoveButton.label = "Remove From Claim";
				}
				else
				{
					IsCarrierExists = false;
					id_addRemoveButton.label = "Add To Claim";
				}
			}
			
			private function InitializeValues():void
			{
				id_BillDate.enabled = false;
				switch(ClaimCarrier.StatusTypeID)
				{
					case "1":
					{
						id_Hold.selected = true;						
						break;
					}
					case "2":
					{
						id_Alert.selected = true;
						break;
					}
					case "3":
					{
						id_Ready.selected = true;
						id_BillDate.enabled = true;
						break;
					}
					case "4":
					{
						id_Done.selected = true;
						break;
					}
					case "5":
					{
						id_Sent.selected = true;
						break;
					}
					case "6":
					{
						id_Pending.selected = true;
						break;
					}
					case "7":
					{
						id_Rejected.selected = true;
						break;
					}
					case "8":
					{
						id_Challenge.selected = true;
						break;
					}
					default:
					{
						id_Hold.selected = true;
						break;
					}
				}
				
				if(ClaimCarrier.MediaTypeID == "2")				
					id_Electronic.selected = true;				
				else
					id_Paper.selected = true;
				
				if(CarrierNo == 4)
				{					
					id_standard.selected = ClaimCarrier.StatementTypeID == "1";
					id_remainder.selected = ClaimCarrier.StatementTypeID == "2";
				}
				
				if(UtilityFunctions.IsNullOrEmpty(ClaimCarrier.BillDate) == false)
					id_BillDate.text = ClaimCarrier.BillDate;
				
				/* if(ClaimCarrier.EDIReceiverTypeID != "0")
				{
					if(EDIReceivers != null && EDIReceivers.length > 0)
					{	
						for each (var receiver:EDIReceiverDTO in EDIReceivers) 
						{
							if(receiver.EDIReceiverID == ClaimCarrier.EDIReceiverTypeID)
							{
								id_EDIReceiverCmb.selectedItem = receiver;
								break;
							}
						}					
					}
					//id_EDIReceiverCmb.selectedIndex = parseInt(ClaimCarrier.EDIReceiverTypeID) - 1;	
				} 
				
				id_EDIReceiverCmb.enabled = false;*/
				
				if(CarrierNo == 1 && ClaimCarrier.FrequencyTypeID != "0")
				{
					var selectedCode:FrequencyCodeTypeDTO = model.FrequencyCodeList[parseInt(ClaimCarrier.FrequencyTypeID) - 1] as FrequencyCodeTypeDTO;
					id_FrequencyCmb.textInput.text = selectedCode.FrequencyCode.split("\-")[0];					
				}
				
				if(CarrierNo == 1 && ClaimCarrier.InsOrganizationID != "0")
				{
					for(var i:int = 0; i < model.InsuranceListforCarrier1.length; i++ )
					{
						var selectedIns:InsOrganizationDTO = model.InsuranceListforCarrier1[i] as InsOrganizationDTO;
						if(selectedIns.InsOrganizationID == ClaimCarrier.InsOrganizationID)
						{
							id_InsuranceCmb.selectedItem = selectedIns;
							//id_InsuranceCmb.textInput.text = selectedIns.InsuranceName;
							break;
						}
					}
				}
				else if(CarrierNo == 2 && ClaimCarrier.InsOrganizationID != "0")
				{
					for(var k:int = 0; k < model.InsuranceListforCarrier2.length; k++ )
					{
						var selectedIns2:InsOrganizationDTO = model.InsuranceListforCarrier2[k] as InsOrganizationDTO;
						if(selectedIns2.InsOrganizationID == ClaimCarrier.InsOrganizationID)
						{
							id_InsuranceCmb.selectedItem = selectedIns2;
							//id_InsuranceCmb.textInput.text = selectedIns.InsuranceName;
							break;
						}
					}				
				}
				else if(CarrierNo == 3 && ClaimCarrier.InsOrganizationID != "0")
				{
					for(var j:int = 0; j < model.InsuranceListforCarrier3.length; j++ )
					{
						var selectedIns3:InsOrganizationDTO = model.InsuranceListforCarrier3[j] as InsOrganizationDTO;
						if(selectedIns3.InsOrganizationID == ClaimCarrier.InsOrganizationID)
						{
							id_InsuranceCmb.selectedItem = selectedIns3;
							//id_InsuranceCmb.textInput.text = selectedIns.InsuranceName;
							break;
						}
					}					
				}
			}			
			
			protected function id_FrequencyCmb_changeHandler(event:IndexChangeEvent):void
			{
				if(id_FrequencyCmb.selectedIndex < 0)
				{
					if(CarrierNo == 1)
						model.ClaimCarrier1.FrequencyTypeID = "0";
					else if(CarrierNo == 2)
						model.ClaimCarrier2.FrequencyTypeID = "0";
					else if(CarrierNo == 3)
						model.ClaimCarrier3.FrequencyTypeID = "0";
					return;
				}
				var selectedCode:FrequencyCodeTypeDTO = id_FrequencyCmb.selectedItem as FrequencyCodeTypeDTO;
				id_FrequencyCmb.textInput.text = selectedCode.FrequencyCode.split("\-")[0];	
				
				if(CarrierNo == 1)
					model.ClaimCarrier1.FrequencyTypeID = selectedCode.FrequencyTypeID;
				else if(CarrierNo == 2)
					model.ClaimCarrier2.FrequencyTypeID = selectedCode.FrequencyTypeID;
				else if(CarrierNo == 3)
					model.ClaimCarrier3.FrequencyTypeID = selectedCode.FrequencyTypeID;
			}
			
			protected function RadioChangeHandler(event:Event):void
			{
				/* if(id_Ready.selected)
					id_BillDate.enabled = true;
				else
					id_BillDate.enabled = false; */
				
				var rdo:RadioButton = event.currentTarget as RadioButton;
				
				switch(rdo.id)
				{
					case "id_Hold":
						if(rdo.selected == true)
						{
							if(CarrierNo == 1)
								model.ClaimCarrier1.StatusTypeID = "1";
							else if(CarrierNo == 2)
								model.ClaimCarrier2.StatusTypeID = "1";
							else if(CarrierNo == 3)
								model.ClaimCarrier3.StatusTypeID = "1";
							else if(CarrierNo == 4)
								model.ClaimPatientBilling.StatusTypeID = "1";
						}
						break;
					
					case "id_Alert":
						if(rdo.selected == true)
						{
							if(CarrierNo == 1)
								model.ClaimCarrier1.StatusTypeID = "2";
							else if(CarrierNo == 2)
								model.ClaimCarrier2.StatusTypeID = "2";
							else if(CarrierNo == 3)
								model.ClaimCarrier3.StatusTypeID = "2";
							else if(CarrierNo == 4)
								model.ClaimPatientBilling.StatusTypeID = "2";
						}
						break;
					
					case "id_Ready":
						if(rdo.selected == true)
						{
							if(CarrierNo == 1)
								model.ClaimCarrier1.StatusTypeID = "3";
							else if(CarrierNo == 2)
								model.ClaimCarrier2.StatusTypeID = "3";
							else if(CarrierNo == 3)
								model.ClaimCarrier3.StatusTypeID = "3";
							else if(CarrierNo == 4)
								model.ClaimPatientBilling.StatusTypeID = "3";				
							
						}
						break;					
					case "id_Done":
						if(rdo.selected == true)
						{
							if(CarrierNo == 1)
								model.ClaimCarrier1.StatusTypeID = "4";
							else if(CarrierNo == 2)
								model.ClaimCarrier2.StatusTypeID = "4";
							else if(CarrierNo == 3)
								model.ClaimCarrier3.StatusTypeID = "4";
							else if(CarrierNo == 4)
								model.ClaimPatientBilling.StatusTypeID = "4";
						}
						break;					
					case "id_Sent":
						if(rdo.selected == true)
						{
							if(CarrierNo == 1)
								model.ClaimCarrier1.StatusTypeID = "5";
							else if(CarrierNo == 2)
								model.ClaimCarrier2.StatusTypeID = "5";
							else if(CarrierNo == 3)
								model.ClaimCarrier3.StatusTypeID = "5";
							else if(CarrierNo == 4)
								model.ClaimPatientBilling.StatusTypeID = "5";
						}						
						break;					
					case "id_Pending":
						if(rdo.selected == true)
						{
							if(CarrierNo == 1)
								model.ClaimCarrier1.StatusTypeID = "6";
							else if(CarrierNo == 2)
								model.ClaimCarrier2.StatusTypeID = "6";
							else if(CarrierNo == 3)
								model.ClaimCarrier3.StatusTypeID = "6";
							else if(CarrierNo == 4)
								model.ClaimPatientBilling.StatusTypeID = "6";
						}						
						break;
					case "id_Rejected":
						if(rdo.selected == true)
						{
							if(CarrierNo == 1)
								model.ClaimCarrier1.StatusTypeID = "7";
							else if(CarrierNo == 2)
								model.ClaimCarrier2.StatusTypeID = "7";
							else if(CarrierNo == 3)
								model.ClaimCarrier3.StatusTypeID = "7";
							else if(CarrierNo == 4)
								model.ClaimPatientBilling.StatusTypeID = "7";
						}
						break;					
					case "id_Challenge":
						if(rdo.selected == true)
						{
							if(CarrierNo == 1)
								model.ClaimCarrier1.StatusTypeID = "8";
							else if(CarrierNo == 2)
								model.ClaimCarrier2.StatusTypeID = "8";
							else if(CarrierNo == 3)
								model.ClaimCarrier3.StatusTypeID = "8";
							else if(CarrierNo == 4)
								model.ClaimPatientBilling.StatusTypeID = "8";
						}					
						break;
					case "id_Paper":
						if(rdo.selected == true)
						{
							if(CarrierNo == 1)
								model.ClaimCarrier1.MediaTypeID = "1";
							else if(CarrierNo == 2)
								model.ClaimCarrier2.MediaTypeID = "1";
							else if(CarrierNo == 3)
								model.ClaimCarrier3.MediaTypeID = "1";
							else if(CarrierNo == 4)
								model.ClaimPatientBilling.MediaTypeID = "1";
						}					
						break;
					case "id_Electronic":
						if(rdo.selected == true)
						{
							if(CarrierNo == 1)
								model.ClaimCarrier1.MediaTypeID = "2";
							else if(CarrierNo == 2)
								model.ClaimCarrier2.MediaTypeID = "2";
							else if(CarrierNo == 3)
								model.ClaimCarrier3.MediaTypeID = "2";
							else if(CarrierNo == 4)
								model.ClaimPatientBilling.MediaTypeID = "2";
						}					
						break;
					case "id_standard":
						if(rdo.selected == true && CarrierNo == 4)
						{ 							
								model.ClaimPatientBilling.StatementTypeID = "1";
						}					
						break;
					case "id_remainder":
						if(rdo.selected == true && CarrierNo == 4)
						{ 							
								model.ClaimPatientBilling.StatementTypeID = "2";
						}					
						break;
				}
			}
			
			protected function id_InsuranceCmb_changeHandler(event:IndexChangeEvent):void
			{
				if(id_InsuranceCmb.selectedIndex < 0) 
				{
					if(CarrierNo == 1)
						model.ClaimCarrier1.InsOrganizationID = "0";
					else if(CarrierNo == 2)
						model.ClaimCarrier2.InsOrganizationID = "0";
					else if(CarrierNo == 3)
						model.ClaimCarrier3.InsOrganizationID = "0";
					
					return;
				}
				var selectedIns:InsOrganizationDTO = id_InsuranceCmb.selectedItem as InsOrganizationDTO;
				if(CarrierNo == 1)
				{
					if(model.ClaimCarrier2.InsOrganizationID == selectedIns.InsOrganizationID && model.ClaimCarrier2.isAddedToClaim && model.ClaimCarrier2.IsDeleted == "false")
					{
						id_InsuranceCmb.setFocus();
						Alert.show("This Insurance is already secondary carrier for the claim.","Invalid Selection", 4, FlexGlobals.topLevelApplication.mainContainer);
						id_InsuranceCmb.selectedIndex -1;
						return;
					}
					else if(model.ClaimCarrier3.InsOrganizationID == selectedIns.InsOrganizationID && model.ClaimCarrier3.isAddedToClaim && model.ClaimCarrier3.IsDeleted == "false")
					{
						id_InsuranceCmb.setFocus();
						Alert.show("This Insurance is already tertiary carrier for the claim.","Invalid Selection", 4, FlexGlobals.topLevelApplication.mainContainer);
						id_InsuranceCmb.selectedIndex -1;
						return;
					}
					model.ClaimCarrier1.InsOrganizationID = selectedIns.InsOrganizationID;
				}
				else if(CarrierNo == 2)
				{
					if(model.ClaimCarrier1.InsOrganizationID == selectedIns.InsOrganizationID && model.ClaimCarrier1.isAddedToClaim && model.ClaimCarrier1.IsDeleted == "false")
					{
						id_InsuranceCmb.setFocus();
						Alert.show("This Insurance is already primary carrier for the claim.","Invalid Selection", 4, FlexGlobals.topLevelApplication.mainContainer);
						id_InsuranceCmb.selectedIndex -1;
						return;
					}
					else if(model.ClaimCarrier3.InsOrganizationID == selectedIns.InsOrganizationID && model.ClaimCarrier3.isAddedToClaim && model.ClaimCarrier3.IsDeleted == "false")
					{
						id_InsuranceCmb.setFocus();
						Alert.show("This Insurance is already tertiary carrier for the claim.","Invalid Selection", 4, FlexGlobals.topLevelApplication.mainContainer);
						id_InsuranceCmb.selectedIndex -1;
						return;
					}
					model.ClaimCarrier2.InsOrganizationID = selectedIns.InsOrganizationID;
				}
				else if(CarrierNo == 3)
				{
					if(model.ClaimCarrier2.InsOrganizationID == selectedIns.InsOrganizationID && model.ClaimCarrier2.isAddedToClaim && model.ClaimCarrier2.IsDeleted  == "false")
					{						
						id_InsuranceCmb.setFocus();
						Alert.show("This Insurance is already secondary carrier for the claim.","Invalid Selection", 4, FlexGlobals.topLevelApplication.mainContainer);
						id_InsuranceCmb.selectedIndex -1;
						return;
					}
					else if(model.ClaimCarrier1.InsOrganizationID == selectedIns.InsOrganizationID && model.ClaimCarrier1.isAddedToClaim && model.ClaimCarrier1.IsDeleted == "false")
					{
						
						id_InsuranceCmb.setFocus();
						Alert.show("This Insurance is already primary carrier for the claim.","Invalid Selection", 4, FlexGlobals.topLevelApplication.mainContainer);
						id_InsuranceCmb.selectedIndex -1;
						return;
					}
					model.ClaimCarrier3.InsOrganizationID = selectedIns.InsOrganizationID;
				}
				
			}
			
