			private var Id_EDIReceiverCmb:LabelComboBox = null;
			private function searchTypeChanged( event:Event ):void
			{
				id_FilterBar.id_SearchTextInput.visible = true;
				searchDTO = null;	
				if(Id_EDIReceiverCmb)
				{
					id_FilterBar.removeElement(Id_EDIReceiverCmb);
					Id_EDIReceiverCmb = null;
				}
				
				id_FilterBar.id_SearchTextInput.text = "";
				
				id_FilterBar.id_SearchTextInput.restrict = null;
				
				var numIndexes:String = "*0*3*4*5*6*";
				var cmbIndexes:String = "*10*11*12*";
				if(numIndexes.indexOf("*" + id_FilterBar.id_FieldsCmbo.selectedIndex.toString() + "*") > -1)
				{
					id_FilterBar.id_SearchTextInput.restrict = "[0-9]";
					
					if(id_FilterBar.id_FieldsCmbo.selectedIndex == 3)
						id_FilterBar.id_SearchTextInput.text = "Ga-";
				}
				else if(cmbIndexes.indexOf("*" + id_FilterBar.id_FieldsCmbo.selectedIndex.toString() + "*") > -1)
				{
					if(EDIReceivers == null && model.EDIReceiverList != null && model.EDIReceiverList.length > 0)
					{
						EDIReceivers = new ArrayCollection();
						var allItem:EDIReceiverDTO = new EDIReceiverDTO();
						allItem.Name = "All";
						allItem.EDIReceiverID = "0";
						EDIReceivers.addItem(allItem);
						for each (var receiver:EDIReceiverDTO in model.EDIReceiverList) 
						{
							EDIReceivers.addItem(receiver);
						}					
					}
					
					id_FilterBar.id_SearchTextInput.visible = false;
					Id_EDIReceiverCmb  = new LabelComboBox();
					id_FilterBar.addElementAt(Id_EDIReceiverCmb,1);
					Id_EDIReceiverCmb.visible = true;
					Id_EDIReceiverCmb.width = 80;
					Id_EDIReceiverCmb.left =id_FilterBar.left + 105;
					Id_EDIReceiverCmb.top =id_FilterBar.top;
					Id_EDIReceiverCmb.dataProvider = EDIReceivers;	
					Id_EDIReceiverCmb.labelField = "Name";
					Id_EDIReceiverCmb.selectedIndex = 0;
				}				
			}

			public static function isValidAlphaNumericWithSpaces2(str:String = ""):Boolean
			{
				var isValid:Boolean = true;
				
				var reg:RegExp = /[a-zA-Z0-9,.'()\/\s]{1,200}/ig;
				var result:Object;
				
				do
				{
					result = reg.exec(str);
					
					if ((result == null) || (result && result.index !=0))
					{
						isValid = false;
						break;
					}
					
				}while (reg.lastIndex < str.length)
				
				return isValid;
			}
			
			private function isValidAlphaNumericWithSpaces(str:String = ""):Boolean
			{
				var isValid:Boolean = true;
				
				var reg:RegExp = /[a-zA-Z0-9,.'()\/\s]{1,200}/ig;
				var result:Object;
				
				do
				{
					result = reg.exec(str);
					
					if ((result == null) || (result && result.index !=0))
					{
						isValid = false;
						break;
					}
					
				}while (reg.lastIndex < str.length)
				
				return isValid;
			}
			
			private var searchDTO:CMSearchDTO = null;
			protected function OnSearchClick(MouseEvent:Event):void
			{
				if(id_FilterBar.id_FieldsCmbo.selectedIndex == -1)
				{
					Alert.show("Please select search type", "Search Type Not Selected",4,FlexGlobals.topLevelApplication.mainContainer);					
					return;
					id_FilterBar.id_FieldsCmbo.setFocus();
				}
				else if(id_FilterBar.id_FieldsCmbo.selectedIndex < 0 && id_FilterBar.id_FieldsCmbo.textInput.text.length > 0)
				{
					Alert.show("Please select proper search type from list", "Search Type Not Selected",4,FlexGlobals.topLevelApplication.mainContainer);					
					return;
					id_FilterBar.id_FieldsCmbo.setFocus();
				}
				if(id_FilterBar.id_SearchTextInput.visible == true && UtilityFunctions.IsNullOrEmpty(id_FilterBar.id_SearchTextInput.text))	
				{
					Alert.show("Please enter something to search ", "Search Field Empty",4,FlexGlobals.topLevelApplication.mainContainer);
					return;
					id_FilterBar.id_SearchTextInput.setFocus();
				}
				
				id_FilterBar.id_SearchTextInput.text = UtilityFunctions.TrimString(id_FilterBar.id_SearchTextInput.text);				
				
				var searchName:String = "";
				var searchFirstName:String = "";
				var searchLastName:String = "";
				if(id_FilterBar.id_FieldsCmbo.selectedIndex == 1 || id_FilterBar.id_FieldsCmbo.selectedIndex == 13)
				{	
					searchName = id_FilterBar.id_SearchTextInput.text;
					if(searchName.indexOf(' ') > -1)
					{
						searchFirstName = UtilityFunctions.TrimString(searchName.split(' ')[0]);
						searchLastName = UtilityFunctions.TrimString(searchName.split(' ')[1]);
					}
					else if(searchName.indexOf(',') > -1)
					{
						searchLastName = UtilityFunctions.TrimString(searchName.split(',')[0]);
						searchFirstName = UtilityFunctions.TrimString(searchName.split(',')[1]);
					}
					else 
						searchFirstName = searchName;					
				}
				
				if(id_FilterBar.id_FieldsCmbo.selectedIndex == 1 || id_FilterBar.id_FieldsCmbo.selectedIndex == 13 )
				{
					if (searchFirstName.length >= 1 && searchFirstName.length <= 50)
					{
						if (!isValidAlphaNumericWithSpaces(searchFirstName))
						{
							Alert.show("Please enter valid " + id_FilterBar.id_FieldsCmbo.textInput.text.replace(" Name","") + " first name", "Invalid Data",4,FlexGlobals.topLevelApplication.mainContainer);
							return;
							id_FilterBar.id_SearchTextInput.setFocus();
						}
					}
					else if (searchFirstName.length > 0 && searchFirstName.length > 50)
					{						
						Alert.show(id_FilterBar.id_FieldsCmbo.textInput.text.replace(" Name","") + " first name is too long", "Invalid Data",4,FlexGlobals.topLevelApplication.mainContainer);
						return;
						id_FilterBar.id_SearchTextInput.setFocus();
					}
					
					if (searchLastName.length >= 1 && searchLastName.length <= 50)
					{
						if (!isValidAlphaNumericWithSpaces(searchLastName))
						{
							Alert.show("Please enter valid " + id_FilterBar.id_FieldsCmbo.textInput.text.replace(" Name","") + " first name", "Invalid Data",4,FlexGlobals.topLevelApplication.mainContainer);
							return;
							id_FilterBar.id_SearchTextInput.setFocus();
						}
					}
					else if (searchLastName.length > 0 && searchLastName.length > 50)
					{						
						Alert.show(id_FilterBar.id_FieldsCmbo.textInput.text.replace(" Name","") + " last name is too long", "Invalid Data",4,FlexGlobals.topLevelApplication.mainContainer);
						return;
						id_FilterBar.id_SearchTextInput.setFocus();
					}
					
					/* if( !  ValidationUtils.isValidNameString(id_FilterBar.id_SearchTextInput.text))
					{
						Alert.show("Please enter correct " + id_FilterBar.id_FieldsCmbo.textInput.text, "Invalid Data",4,FlexGlobals.topLevelApplication.mainContainer);
						return;
						id_FilterBar.id_SearchTextInput.setFocus();
					} */
				}
				else if(id_FilterBar.id_FieldsCmbo.selectedIndex == 2 || id_FilterBar.id_FieldsCmbo.selectedIndex == 14 )
				{
					if( !  ValidationUtils.isValidDateFormat(id_FilterBar.id_SearchTextInput.text) || !  ValidationUtils.isValidDateString(id_FilterBar.id_SearchTextInput.text))
					{
						Alert.show("Please enter valid " + id_FilterBar.id_FieldsCmbo.textInput.text + " in valid format [MM/DD/YYYY]", "Invalid Data/format",4,FlexGlobals.topLevelApplication.mainContainer);
						return;
						id_FilterBar.id_SearchTextInput.setFocus();
					}
				}
				
				searchDTO = new CMSearchDTO();
				
				searchDTO.BatchID = "0";
				searchDTO.BillDate = "1900-01-01";
				searchDTO.ClaimID = "0";
				searchDTO.ClinicBranchId = model.LoggedInUserSelectedBranchId.toString();
				searchDTO.DateCreated "1900-01-01";
				searchDTO.EDIReceiverTypeID ="0";
				searchDTO.ExcludeDone = "true"
				searchDTO.InsOrganizationID = "0";
				searchDTO.InsuranceTypeId = "0";
				searchDTO.ListType = String(id_FilterBar.id_FieldsCmbo.selectedIndex + 1);
				searchDTO.MediaTypeID = "0";
				searchDTO.PageNo = model.ClaimManagementSearchPageNo.toString();
				searchDTO.PatientID = "0";
				searchDTO.QuivusID = "0";
				searchDTO.SearchString = id_FilterBar.id_SearchTextInput.text;
				searchDTO.StatusTypeID = "0";
				searchDTO.Type = "1";
				searchDTO.VisitDate = "1900-01-01";	
				searchDTO.DateCreated = "1900-01-01";				
								
				if(id_FilterBar.id_FieldsCmbo.selectedIndex == 4)
				{
					searchDTO.BatchID = id_FilterBar.id_SearchTextInput.text;
					searchDTO.InsuranceTypeId = "1";
				}
				else if(id_FilterBar.id_FieldsCmbo.selectedIndex == 5)
				{
					searchDTO.BatchID = id_FilterBar.id_SearchTextInput.text;
					searchDTO.InsuranceTypeId = "2";
				}
				else if(id_FilterBar.id_FieldsCmbo.selectedIndex == 6)
				{
					searchDTO.BatchID = id_FilterBar.id_SearchTextInput.text;
					searchDTO.InsuranceTypeId = "3";
				}
				else if(id_FilterBar.id_FieldsCmbo.selectedIndex == 7 || id_FilterBar.id_FieldsCmbo.selectedIndex == 10)
				{	
					if(id_FilterBar.id_FieldsCmbo.selectedIndex == 10)
					{
							searchDTO.ListType = "9";
							searchDTO.SearchString = (Id_EDIReceiverCmb.selectedItem as EDIReceiverDTO).EDIReceiverID;
					}
					searchDTO.InsuranceTypeId = "1";
				}
				else if(id_FilterBar.id_FieldsCmbo.selectedIndex == 8 || id_FilterBar.id_FieldsCmbo.selectedIndex == 11)
				{	
					if(id_FilterBar.id_FieldsCmbo.selectedIndex == 8)
						searchDTO.ListType = "8";
					else
					{
						searchDTO.ListType = "9";
						searchDTO.SearchString = (Id_EDIReceiverCmb.selectedItem as EDIReceiverDTO).EDIReceiverID;
					};
					searchDTO.InsuranceTypeId = "2";
				}
				else if(id_FilterBar.id_FieldsCmbo.selectedIndex == 9 || id_FilterBar.id_FieldsCmbo.selectedIndex == 12)
				{	
					if(id_FilterBar.id_FieldsCmbo.selectedIndex == 9)
						searchDTO.ListType = "8";
					else
					{
						searchDTO.ListType = "9";
						searchDTO.SearchString = (Id_EDIReceiverCmb.selectedItem as EDIReceiverDTO).EDIReceiverID;
					}
					searchDTO.InsuranceTypeId = "3";
				}	
				else if(id_FilterBar.id_FieldsCmbo.selectedIndex == 13 )
				{
					searchDTO.ListType = "10";
				}
				else if(id_FilterBar.id_FieldsCmbo.selectedIndex == 14 )
				{
					searchDTO.ListType = "11";
				}
				
				var ce:LoadClaimByCriteriaEvent = new LoadClaimByCriteriaEvent(searchDTO.ToXML(), RecordStatus);
				CairngormEventDispatcher.getInstance().dispatchEvent(ce);
			}
			
