			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				if(model.EDIReceiverList == null || model.EDIReceiverList.length == 0)
				{
					var lerEvent:LoadEDIReceiverByCriteriaEvent = new LoadEDIReceiverByCriteriaEvent(0,"0",0);
					CairngormEventDispatcher.getInstance().dispatchEvent(lerEvent);
				}
				
				if(model.EDIReceiverList != null && model.EDIReceiverList.length > 0)
				{
					EDIReceivers = new ArrayCollection();
					var allItem:EDIReceiverDTO = new EDIReceiverDTO();
					allItem.Name = "All";
					allItem.EDIReceiverID = "0";
					EDIReceivers.addItem(allItem);
					for each (var receiver:EDIReceiverDTO in model.EDIReceiverList) 
					{
						EDIReceivers.addItem(receiver);
					}					
				}
				
				addEventListeners();
				model.ClaimManagementSearchPageNo = 1;
				var claimevent:LoadAllClaimbyProviderIdEvent = new LoadAllClaimbyProviderIdEvent(model.LoggedInUserProviderId,model.LoggedInUserSelectedBranchId,model.ClaimManagementSearchPageNo, RecordStatus);
				CairngormEventDispatcher.getInstance().dispatchEvent(claimevent);
				
				//if(id_FilterBar.id_FieldsCmbo.selectedIndex == -1 )
					//id_FilterBar.id_ListOnly.enabled = false;
				
				searchDTO = null;
				id_FilterBar.id_FieldsCmbo.setFocus();
			}	
			
			public function addEventListeners():void
			{
				id_FilterBar.id_FieldsCmbo.addEventListener(ListEvent.CHANGE,searchTypeChanged);
				id_FilterBar.id_btnSearch.addEventListener(MouseEvent.CLICK, OnSearchClick);
				id_FilterBar.id_SearchTextInput.addEventListener(KeyboardEvent.KEY_UP, OnSearchKeyUp);
				id_FilterBar.id_SearchTextInput.addEventListener(KeyboardEvent.KEY_DOWN, OnSearchKeyDown);
				id_FilterBar.addEventListener( BillingEventString.LIST_ONLY , 			id_FilterBar_ListOnlyHandler );
				id_FilterBar.addEventListener( BillingEventString.CHANGE_STAUS , 		id_FilterBar_ChangeStatusHandler );
				id_FilterBar.addEventListener( BillingEventString.GOTO_FIRST_PAGE , 	switchPageForPendingBills );
				id_FilterBar.addEventListener( BillingEventString.GOTO_LAST_PAGE , 		switchPageForPendingBills );
				id_FilterBar.addEventListener( BillingEventString.GOTO_NEXT_PAGE , 		switchPageForPendingBills );
				id_FilterBar.addEventListener( BillingEventString.GOTO_PREVIOUS_PAGE ,  switchPageForPendingBills );
				id_FilterBar.addEventListener( BillingEventString.REFRESH_VIEW , 		id_FilterBar_RefreshViewHandler);
			}
			
			private function switchPageForPendingBills( event:Event ):void
			{
				//model.isPendingBillRemoved = false;
				switch( event.type ) 
				{
					case BillingEventString.GOTO_FIRST_PAGE:
						model.ClaimManagementSearchPageNo = 1;							
						break;
					case BillingEventString.GOTO_NEXT_PAGE:
						model.ClaimManagementSearchPageNo += 1; 						
						break;
					case BillingEventString.GOTO_PREVIOUS_PAGE:
						model.ClaimManagementSearchPageNo -= 1;						
						break;
					case BillingEventString.GOTO_LAST_PAGE:
						model.ClaimManagementSearchPageNo = model.ClaimManagementTotalPageNo;						
						break;
				}	
				
				if(searchDTO == null)
				{
					var claimevent:LoadAllClaimbyProviderIdEvent = new LoadAllClaimbyProviderIdEvent(model.LoggedInUserProviderId,model.LoggedInUserSelectedBranchId,model.ClaimManagementSearchPageNo, RecordStatus);
					CairngormEventDispatcher.getInstance().dispatchEvent(claimevent);	
				}
				else
				{
					searchDTO.PageNo = model.ClaimManagementSearchPageNo.toString();
					var ce:LoadClaimByCriteriaEvent = new LoadClaimByCriteriaEvent(searchDTO.ToXML());
					CairngormEventDispatcher.getInstance().dispatchEvent(ce);
				}
			}
			
			public var popup:ClaimListOnlyPopup;
			protected function id_FilterBar_ListOnlyHandler(event:Event):void
			{
				if( popup && popup.isPopUp )
				{
					popup.removePopup();					
					return; 
				}			
				
				popup = new ClaimListOnlyPopup();				
				
				popup.addEventListener( ListOnlySelectionEvent.LIST_ONLY_SELECTION, ListOnlySelectionEventHandler );
				
				var pLoc:Point = id_FilterBar.id_ListOnly.parent.localToGlobal(new Point(id_FilterBar.id_ListOnly.x ,id_FilterBar.id_ListOnly.height));
				
				popup.x 		= pLoc.x - 100; 
				popup.y 		= pLoc.y  + 10 ;			
				
				popup.ShowPopup( this ); 
				BillingPopUpManager.addPopUp(popup,BillingPopUpManager.CLAIM_MANAGEMENT_POPUPS);
			}		
			
			public var changeStatusPopup:ClaimChangeStatusView;
			protected function id_FilterBar_ChangeStatusHandler(event:Event):void
			{
				var selectedclaimIds:ArrayCollection = new ArrayCollection();
				if(id_ClaimGrid.selectedItems.length > 0)
				{					
					for(var i:int = 0; i < id_ClaimGrid.selectedItems.length; i++)
					{
						selectedclaimIds.addItem((id_ClaimGrid.selectedItems[i] as SearchClaimDTO).ClaimID);
					}
				}
				else
				{
					Alert.show('Please select at least one claim', 'No record selected',4,FlexGlobals.topLevelApplication.mainContainer);
					return;
				}
				if( changeStatusPopup && changeStatusPopup.isPopUp )
				{
					changeStatusPopup.removePopup();					
					return; 
				}			
				
				changeStatusPopup = new ClaimChangeStatusView();			
				
				changeStatusPopup.addEventListener( ListOnlySelectionEvent.LIST_ONLY_SELECTION, ChangeStatusSelectionEventHandler );
				
				var pLoc:Point = id_FilterBar.id_ListOnly.parent.localToGlobal(new Point(id_FilterBar.id_ChangeStaus.x ,id_FilterBar.id_ChangeStaus.height));
				
				changeStatusPopup.x 		= pLoc.x - 100; 
				changeStatusPopup.y 		= pLoc.y  + 10 ;			
				
				changeStatusPopup.ShowPopup( this ); 				
				BillingPopUpManager.addPopUp(changeStatusPopup,BillingPopUpManager.CLAIM_MANAGEMENT_POPUPS);
				
				changeStatusPopup.BatchId = (id_ClaimGrid.selectedItems[0] as SearchClaimDTO).Batch1;				
				changeStatusPopup.ClaimIDs = selectedclaimIds;
			}
			
