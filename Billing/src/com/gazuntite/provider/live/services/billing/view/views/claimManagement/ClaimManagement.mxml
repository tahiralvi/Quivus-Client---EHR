			private function loadInsuranceStatus(insList:ArrayCollection):void
			{
				if(editClaim && editClaim.isPopUp) return;
				
				model.InsuranceListforCarrier1 = null;
				model.InsuranceListforCarrier2 = null;
				model.InsuranceListforCarrier3 = null;
				
				model.InsuranceListforCarrier1 = insList;
				
				//model.InsuranceListfoClaimListOnly = insList;
				
				var insListForCarrier1:ArrayCollection = new ArrayCollection();
				for(var i:int = 0; i < model.ClaimCurrentCarriers.length; i++)
				{
					var car:CarrierDTO = model.ClaimCurrentCarriers[i] as CarrierDTO;						
					
					for each (var ins:InsOrganizationDTO in model.InsuranceListforCarrier1) 
					{
						if(ins.InsOrganizationID == car.InsOrganizationID)
						{
							if(model.InsuranceListforCarrier2 == null)
								model.InsuranceListforCarrier2 = new ArrayCollection();
							
							model.InsuranceListforCarrier2.addItem(ins);
							
							if(model.InsuranceListforCarrier3 == null)
								model.InsuranceListforCarrier3 = new ArrayCollection();
							
							model.InsuranceListforCarrier3.addItem(ins);
							
							insListForCarrier1.addItem(ins);
							break;
						}						
					}
					
					if( car.InsuranceTypeId == "1" )
					{
						carrier1.CreatedBy = car.CreatedBy;
						carrier1.ModifiedBy = model.LoggedInUserId.toString();
						carrier1.EDIReceiverTypeID = car.EDIReceiverTypeID;
						carrier1.FrequencyTypeID = car.FrequencyTypeID;
						carrier1.InsOrganizationID = car.InsOrganizationID;
						carrier1.InsuranceID = car.InsuranceID;
						carrier1.MediaTypeID = car.MediaTypeID;
						carrier1.StatusTypeID = car.StatusTypeID;
						carrier1.SubmissionCount = car.SubmissionCount;	
						carrier1.isAddedToClaim = car.isAddedToClaim;	
						if(carrier1.InsOrganizationID != "0" && carrier1.StatusTypeID == "3" && (car.BillDate != null && car.BillDate != "") )
							carrier1.BillDate = UtilityFunctions.FormatDate(car.BillDate,"MM/DD/YYYY");
					}
					else if( car.InsuranceTypeId == "2" )
					{
						carrier2.CreatedBy = car.CreatedBy;
						carrier2.ModifiedBy = model.LoggedInUserId.toString();
						carrier2.EDIReceiverTypeID = car.EDIReceiverTypeID;
						carrier2.FrequencyTypeID = car.FrequencyTypeID;
						carrier2.InsOrganizationID = car.InsOrganizationID;
						carrier2.InsuranceID = car.InsuranceID;
						carrier2.MediaTypeID = car.MediaTypeID;
						carrier2.StatusTypeID = car.StatusTypeID;
						carrier2.SubmissionCount = car.SubmissionCount;	
						carrier2.isAddedToClaim = car.isAddedToClaim;
						if(carrier2.InsOrganizationID != "0" && carrier2.StatusTypeID == "3" && (car.BillDate != null && car.BillDate != "") )
							carrier2.BillDate = UtilityFunctions.FormatDate(car.BillDate,"MM/DD/YYYY");
					}
					else if( car.InsuranceTypeId == "3" )
					{
						carrier3.CreatedBy = car.CreatedBy;
						carrier3.ModifiedBy = model.LoggedInUserId.toString();
						carrier3.EDIReceiverTypeID = car.EDIReceiverTypeID;
						carrier3.FrequencyTypeID = car.FrequencyTypeID;
						carrier3.InsOrganizationID = car.InsOrganizationID;
						carrier3.InsuranceID = car.InsuranceID;
						carrier3.MediaTypeID = car.MediaTypeID;
						carrier3.StatusTypeID = car.StatusTypeID;
						carrier3.SubmissionCount = car.SubmissionCount;	
						carrier3.isAddedToClaim = car.isAddedToClaim;
						if(carrier3.InsOrganizationID != "0" && carrier3.StatusTypeID == "3" && (car.BillDate != null && car.BillDate != "") )
							carrier3.BillDate = UtilityFunctions.FormatDate(car.BillDate,"MM/DD/YYYY");
					}
					else if( car.InsuranceTypeId == "4" )
					{
						patientBilling.CreatedBy = car.CreatedBy;
						patientBilling.ModifiedBy = model.LoggedInUserId.toString();
						patientBilling.EDIReceiverTypeID = car.EDIReceiverTypeID;
						patientBilling.FrequencyTypeID = car.FrequencyTypeID;
						patientBilling.InsOrganizationID = car.InsOrganizationID;
						patientBilling.InsuranceID = car.InsuranceID;
						patientBilling.MediaTypeID = car.MediaTypeID;
						patientBilling.StatusTypeID = car.StatusTypeID;
						patientBilling.SubmissionCount = car.SubmissionCount;	
						patientBilling.isAddedToClaim = car.isAddedToClaim;
						patientBilling.StatementTypeID = car.StatementTypeID;
						if(patientBilling.StatusTypeID == "3" && (car.BillDate != null && car.BillDate != "") )
							patientBilling.BillDate = UtilityFunctions.FormatDate(car.BillDate,"MM/DD/YYYY");
					}
					
					model.ClaimCarrierIniBillDate = id_ClaimGrid.selectedItem.DateCreated;
					
