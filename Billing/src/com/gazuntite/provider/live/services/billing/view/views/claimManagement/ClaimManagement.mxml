			private var editClaim:ClaimEditView = null;
			protected function claimmanagementbuttonbar1_EditHandler(event:Event):void
			{
				if(editClaim && editClaim.isPopUp) return;
								
				if(id_ClaimGrid.selectedItems.length == 0)
				{
					Alert.show("Please select claim.","Information",4,FlexGlobals.topLevelApplication.mainContainer);
					return;
				}			
				
				editClaim = null;
				
