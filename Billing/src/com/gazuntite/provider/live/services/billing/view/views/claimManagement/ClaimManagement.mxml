			private function CheckForInsuranceType(): void
			{
				
				var isPopupOpen: Boolean = false;
				var PriInsOrganizationID:String = "0";
				var SecInsOrganizationID:String = "0";
				var TerInsOrganizationID:String = "0";
				
				BillingConstants.REPORT_PARAMETERS = "";				
				
				for (var i:int = 0; i < (id_ClaimGrid.selectedItem as SearchClaimDTO).CarrierInfo.length; i++)
				{
					var crr:CarrierDTO = (id_ClaimGrid.selectedItem as SearchClaimDTO).CarrierInfo[i] as CarrierDTO;
					if(crr.InsOrganizationID != "0")
					{
						if(crr.InsuranceTypeId == "1")
							PriInsOrganizationID = crr.InsOrganizationID;
						else if(crr.InsuranceTypeId == "2")
							SecInsOrganizationID = crr.InsOrganizationID;
						else if(crr.InsuranceTypeId == "3")
							TerInsOrganizationID = crr.InsOrganizationID;
					}
				}
			
				model.CMSViewInsuranceType = "P";
				/* if(PriInsOrganizationID != "0" && SecInsOrganizationID == "0" && TerInsOrganizationID == "0")
				{
					model.CMSViewInsuranceType = "P";
				}
				else  */ 
				if(SecInsOrganizationID != "0" && PriInsOrganizationID == "0" && TerInsOrganizationID == "0")
				{
					model.CMSViewInsuranceType = "S";
				}
				else if(TerInsOrganizationID != "0" && PriInsOrganizationID == "0" && SecInsOrganizationID == "0")
				{
					model.CMSViewInsuranceType = "T";
				}
				else if(PriInsOrganizationID != "0" && SecInsOrganizationID != "0" && TerInsOrganizationID == "0")
				{
					isPopupOpen = true;
					var insTypePopup:CMSInsuranceTypePopup = new CMSInsuranceTypePopup();					
					insTypePopup.height =  130 ;
					insTypePopup.width  =  250;
					insTypePopup.viewTertiary = false;
					insTypePopup.ShowPopup(this.parent,true);
					BillingPopUpManager.addPopUp(insTypePopup,BillingPopUpManager.CLAIM_MANAGEMENT_POPUPS);
					
					insTypePopup.id_Ok.addEventListener(MouseEvent.CLICK,function(event:MouseEvent):void
					{
						insTypePopup.removePopup();
						BillingConstants.REPORT_PARAMETERS = "&CMSInsType=" + model.CMSViewInsuranceType;
						BillingPopUpManager.removePopUp(insTypePopup,BillingPopUpManager.CLAIM_MANAGEMENT_POPUPS);
						ViewCMS1500();
					});
					
					insTypePopup.id_Cancel.addEventListener(MouseEvent.CLICK,function(event:MouseEvent):void
					{
						insTypePopup.removePopup();
						BillingPopUpManager.removePopUp(insTypePopup,BillingPopUpManager.CLAIM_MANAGEMENT_POPUPS);
						return;
					});
					
					insTypePopup.addEventListener(CloseEvent.CLOSE,function ClosePopup(event:CloseEvent):void
					{
						BillingPopUpManager.removePopUp(insTypePopup,BillingPopUpManager.CLAIM_MANAGEMENT_POPUPS);
						return;
						
					}); 					
					
				}
				else if(PriInsOrganizationID != "0" && SecInsOrganizationID != "0" && TerInsOrganizationID != "0")
				{
					isPopupOpen = true;
				//	var insTypePopup:CMSInsuranceTypePopup = new CMSInsuranceTypePopup();
					
					insTypePopup.viewTertiary = true;					
					insTypePopup.ShowPopup(this.parent,true);
					BillingPopUpManager.addPopUp(insTypePopup,BillingPopUpManager.CLAIM_MANAGEMENT_POPUPS);
					
					insTypePopup.id_Ok.addEventListener(MouseEvent.CLICK,function(event:MouseEvent):void
					{
						insTypePopup.removePopup();
						BillingConstants.REPORT_PARAMETERS = "&CMSInsType=" + model.CMSViewInsuranceType;
						BillingPopUpManager.removePopUp(insTypePopup,BillingPopUpManager.CLAIM_MANAGEMENT_POPUPS);
						ViewCMS1500();
					});
					
					insTypePopup.id_Cancel.addEventListener(MouseEvent.CLICK,function(event:MouseEvent):void
					{
						insTypePopup.removePopup();
						BillingPopUpManager.removePopUp(insTypePopup,BillingPopUpManager.CLAIM_MANAGEMENT_POPUPS);
						return;
					});
					
					insTypePopup.addEventListener(CloseEvent.CLOSE,function ClosePopup(event:CloseEvent):void
					{
						BillingPopUpManager.removePopUp(insTypePopup,BillingPopUpManager.CLAIM_MANAGEMENT_POPUPS);
						return;						
					}); 
				}
				
				if( ! isPopupOpen)
				{
					BillingConstants.REPORT_PARAMETERS = "&CMSInsType=" + model.CMSViewInsuranceType;
					ViewCMS1500();
				}
			}
			
			private var isPrintCMS:Boolean = false;
			private function ClaimTransactionStatus():void
			{
				if(model.SearchClaimTransactionResults.ClaimTransactions && model.SearchClaimTransactionResults.ClaimTransactions.length > 0 )
				{				
					
					if(isPrintCMS)
						BillingConstants.REPORT_TYPE_ID = "41";
					else
						BillingConstants.REPORT_TYPE_ID = "4";
					BillingConstants.REPORT_ID = "0";
					
					BillingConstants.REPORT_PARAMETERS += "&VisitId=" + (id_ClaimGrid.selectedItem as SearchClaimDTO).VisitID +
						"&ClaimId=" + (id_ClaimGrid.selectedItem as SearchClaimDTO).ClaimID				
					openReportPanelPopup();
				}
				else
				{
					Alert.show("Claim has no trancastion/procedure.","Information",4,FlexGlobals.topLevelApplication.mainContainer);
					return;
				}
			}
			
			private function RecordStatus():void
			{
				if(model.totalrecords_CM < BillingConstants.PAGE_SIZE)
				{
					id_FilterBar.id_GoToFirstPage.enabled = false;
					id_FilterBar.id_GoToLastPage.enabled = false;
					id_FilterBar.id_GoToNextPage.enabled = false;
					id_FilterBar.id_GoToPreviousPage.enabled = false;
				}
				else
				{
					if(model.ClaimManagementSearchPageNo == 1)
					{
						id_FilterBar.id_GoToFirstPage.enabled = false;
						id_FilterBar.id_GoToPreviousPage.enabled = false;
					}
					else
					{
						id_FilterBar.id_GoToFirstPage.enabled = true;
						id_FilterBar.id_GoToPreviousPage.enabled = true;
					}
					if(model.ClaimManagementSearchPageNo == model.ClaimManagementTotalPageNo)
					{
						id_FilterBar.id_GoToNextPage.enabled = false;
						id_FilterBar.id_GoToLastPage.enabled = false;
					}
					else
					{
						id_FilterBar.id_GoToNextPage.enabled = true;
						id_FilterBar.id_GoToLastPage.enabled = true;
					}					
					
				}
				
			}	
			
