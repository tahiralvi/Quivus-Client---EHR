			private function SetTabIndexes():void
			{
				var incrementer:int = 0;
				id_ICDCode.tabIndex = tabIndex + (++incrementer);
				id_Diagnosis.tabIndex = tabIndex + (++incrementer);
				id_Add.tabIndex = tabIndex + (++incrementer);
				id_DiagnisisGrid.tabIndex = tabIndex + (++incrementer);
				
				LastChildTabIndex = ++incrementer;
			}				
			
			private function Init():void
			{	
				SetTabIndexes();
				
				id_DiagnisisGrid.addEventListener(DataGridActionEvent.EDIT_RECORD_CLICK, editRecordClickHandler, false, 0, true);
				id_DiagnisisGrid.addEventListener(DataGridActionEvent.DELETE_RECORD_CLICK, deleteRecordClickHandler, false, 0, true);
				id_DiagnisisGrid.addEventListener(DataGridActionEvent.ITEM_EDIT_KEY_UP, itemEditKeyUpHandler, false, 0, true);
				
