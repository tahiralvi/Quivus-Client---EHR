			public function set ICDs(value:ArrayCollection):void
			{
				m_aDiagnosis = value;
				
				if (m_aDiagnosis)
				{
					m_aDiagnosis.addEventListener(CollectionEvent.COLLECTION_CHANGE, diagnosisCollectionChangeHandler, false, 0, true);
					
					if (m_aDiagnosis.length)
						includeGridInLayout = true;
						
					else
						includeGridInLayout = false;		
				}
				else
					includeGridInLayout = false;
			}
			
