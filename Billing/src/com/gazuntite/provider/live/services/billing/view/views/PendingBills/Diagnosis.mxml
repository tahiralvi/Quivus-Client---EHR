			private function diagnosisItemEditHandler(event:DataGridEvent):void 
			{					
				var dto:SuperBillDiagnosisInfoDTO = event.itemRenderer.data as SuperBillDiagnosisInfoDTO;			
				
				if( dto.DiagnosisID != "0" )
				{
					id_ICDCode.textInput.text = dto.ICDCodeName;
					id_Diagnosis.textInput.text = dto.ICDCodeDescription;
					return;
				}			 
				
				var validationRes:ValidationResultEvent;				
				var editor:LabelComboBox = ComboBoxEditor(id_DiagnisisGrid.itemEditorInstance).id_ComboEditor;
				
				comboValidator.source = editor;
				
				if (event.dataField == "ICDCodeName")
				{
					comboValidator.error = "Select ICD Code from list";
				}
				else
				{
					comboValidator.error = "Select diagnosis from list";
				}
				
				validationRes = comboValidator.validate(editor.selectedItem);
				
				if (validationRes && !validationRes.results)
				{
					//event.itemRenderer.data.ICDCode = editor.selectedItem;
					dto.ICDCodeID 	= (editor.selectedItem as ICDCodeTypeDTO).ICDCodeID;
					dto.ICDCodeDescription 	= (editor.selectedItem as ICDCodeTypeDTO).ICDCodeDescription;
					dto.ICDCodeName = (editor.selectedItem as ICDCodeTypeDTO).ICDCodeName;					
										
					hasViewChanged = _hasGridChanged = true;
				}
				
				/* if( editor.selectedItem )							
				{
					dto.ICDCodeID 	= (editor.selectedItem as ICDCodeTypeDTO).ICDCodeID;
					dto.ICDCodeDescription 	= (editor.selectedItem as ICDCodeTypeDTO).ICDCodeDescription;
					dto.ICDCodeName = (editor.selectedItem as ICDCodeTypeDTO).ICDCodeName;
				}	 */		
				
				event.currentTarget.dataProvider.refresh();
				id_DiagnisisGrid.destroyItemEditor();
				event.stopImmediatePropagation();
				event.preventDefault();
			}
			
			protected function Icdcode_clickHandler(event:MouseEvent, index:uint):void
			{
				if( (addDiagnosisPopup && addDiagnosisPopup.isPopUp) || event.target as RichEditableText)
				{
					return;
				}
				else 
				{
					if(serachTermDiagnosis == null)
						return
					if(serachTermDiagnosis.indexOf(".")  > -1 && serachTermDiagnosis.indexOf(".") == serachTermDiagnosis.length - 1  )
					{
						Alert.show("Dot(.) is not allowed at the end of text","Info",4,this);
						return;
					}
					if(serachTermDiagnosis.length > 2)
					{
						openDiagnosisPopup(index);
					}
				}
			}
			private var addDiagnosisPopup:SuperBillDiagnosisPopup = null;
			private function openDiagnosisPopup(index:int):void
			{
				addDiagnosisPopup = new SuperBillDiagnosisPopup();
				addDiagnosisPopup.ShowPopup( this );
				BillingPopUpManager.addPopUp(addDiagnosisPopup,BillingPopUpManager.SUPER_BILL_POPUPS);
				addDiagnosisPopup.title  = "Add Diagnosis";
				addDiagnosisPopup.height = 410;
				addDiagnosisPopup.width  = 600;
				addDiagnosisPopup.move(addDiagnosisPopup.x, Capabilities.screenResolutionY/4);
				addDiagnosisPopup.searchAndLoadDiagnosis(serachTermDiagnosis,  index);
				resetFields();
			}
			
			
			private function icdDescriptionChangeHandler():void
			{
				serachTermDiagnosis = '';
				serachTermDiagnosis = id_Diagnosis.textInput.text;
			}

			protected function id_ICDCode_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == 13 )
				{
					if(serachTermDiagnosis == null)
						return
					if(serachTermDiagnosis.indexOf(".")  > -1 && serachTermDiagnosis.indexOf(".") == serachTermDiagnosis.length - 1  )
					{
						Alert.show("Dot(.) is not allowed at the end of text","Info",4,this);
						return;
					}
					if(serachTermDiagnosis.length > 2)
					{
						openDiagnosisPopup(0);
					}
				}
			}


			protected function id_Diagnosis_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == 13 )
				{
					if(serachTermDiagnosis == null)
						return
					if(serachTermDiagnosis.indexOf(".")  > -1 && serachTermDiagnosis.indexOf(".") == serachTermDiagnosis.length - 1  )
					{
						Alert.show("Dot(.) is not allowed at the end of text","Info",4,this);
						return;
					}
					if(serachTermDiagnosis.length > 2)
					{
						openDiagnosisPopup(1);
					}
				}
			}

