				if(ICDs == null)
					ICDs = new ArrayCollection();
				//NewDiagnosis = new ArrayCollection();
			}
			
			private function itemEditKeyUpHandler(event:DataGridActionEvent):void
			{
				if (event.searchString.length > 2)
				{
					var icdEvent : LoadICDCodeTypesEvent = new LoadICDCodeTypesEvent(event.searchString,model.LoggedInUserSelectedBranchId.toString());
					CairngormEventDispatcher.getInstance().dispatchEvent( icdEvent );
				}
			}
			
			private function addRecordClickHandler(event:Event):void
			{
				if(UtilityFunctions.IsNullOrEmpty(id_ICDCode.textInput.text) || UtilityFunctions.IsNullOrEmpty(id_Diagnosis.textInput.text))
				{
					Alert.show("Please enter valid ICD","Info",4,this);
					return; // invalid data
				}
				
				if( !areRequiredFieldsProvidedAndValid() )
				{
					Alert.show("Invalid ICD","Info",4,this);
					return; // invalid data
				}
				
				if(hasDuplicateValues(selectedIcdCodeDTO.ICDCodeID))
				{
					Alert.show("This diagnosis already exists","Info",4,this);
					id_ICDCode.setFocus();
					return;
				}
				
				var diagnosisDTO:SuperBillDiagnosisInfoDTO = new SuperBillDiagnosisInfoDTO(); 
				
				if(id_ICDCode.textInput.text && id_Diagnosis.textInput.text)
				{
					diagnosisDTO.ICDCodeID			= selectedIcdCodeDTO.ICDCodeID; 
					diagnosisDTO.ICDCodeName        = selectedIcdCodeDTO.ICDCodeName;
					diagnosisDTO.ICDCodeDescription = id_Diagnosis.textInput.text;
				}
				
				diagnosisDTO.ModifiedBy ="0";
				diagnosisDTO.DiagnosisID = "0";
				diagnosisDTO.VisitID = "0";
				diagnosisDTO.PatientID = "0";							
				diagnosisDTO.CreatedBy = model.LoggedInUserId.toString();												
				diagnosisDTO.IncludeInBilling = "true";
				diagnosisDTO.IsCreatedFromSuperBill = "true";
				diagnosisDTO.VisitDate = UtilityFunctions.FormatDate(QSConstants.NULL_DATE);
				
								
				if(model.CurrentDiagnosis==null)
					model.CurrentDiagnosis = new ArrayCollection();
				
				
				model.CurrentDiagnosis.addItem(diagnosisDTO);
					
				
				resetFields();
				
				hasViewChanged = _hasGridChanged = true;			
				
			}
			
			private function addRecordClickHandlerOld():void
			{
				if(id_ICDCode.selectedIndex == -1 )
				{
					Alert.show("Please select code","Info",4,this);
					id_ICDCode.setFocus();
					return;
				}	
				
				if(hasDuplicateValues(id_ICDCode.textInput.text))
				{
					Alert.show("This diagnosis already exists","Info",4,this);
					id_ICDCode.setFocus();
					return;
				}
				
				var diagnosisDTO:SuperBillDiagnosisInfoDTO = new SuperBillDiagnosisInfoDTO();
				
				diagnosisDTO.ModifiedBy ="0";
				diagnosisDTO.DiagnosisID = "0";
				diagnosisDTO.VisitID = "0";
				diagnosisDTO.PatientID = "0";
				diagnosisDTO.ICDCodeID = id_ICDCode.selectedItem.ICDCodeID;				
				diagnosisDTO.CreatedBy = model.LoggedInUserId.toString();
				diagnosisDTO.ICDCodeName = id_ICDCode.selectedItem.ICDCodeName;
				diagnosisDTO.ICDCodeDescription = id_ICDCode.selectedItem.ICDCodeDescription;								
				diagnosisDTO.IncludeInBilling = "true";
				diagnosisDTO.IsCreatedFromSuperBill = "true";
				diagnosisDTO.VisitDate = UtilityFunctions.FormatDate(QSConstants.NULL_DATE);					
				
				model.CurrentDiagnosis.addItem(diagnosisDTO);
				
				resetFields();
				
				hasViewChanged = _hasGridChanged = true;
				
			}
			
			public function areRequiredFieldsProvidedAndValid():Boolean
			{
				var result:Boolean = false;				
				
				if(model.ICDCodeTypeList.length)
				{
					for(var i:uint=0; i < model.ICDCodeTypeList.length; i++)
					{
						if(id_ICDCode.textInput.text == model.ICDCodeTypeList[i].ICDCodeName && id_Diagnosis.textInput.text == model.ICDCodeTypeList[i].ICDCodeDescription)
						{
							result = true;
							break;
						}							
					}
				}				
				
				return result;
			}
			
			private function hasDuplicateValues(ICDCode:String):Boolean
			{
				for(var j:uint =0; j<model.CurrentDiagnosis.length; j++)
				{
					var patDiaDTO:SuperBillDiagnosisInfoDTO = model.CurrentDiagnosis[j] as SuperBillDiagnosisInfoDTO;
					
					if(ICDCode == patDiaDTO.ICDCodeID)
						return true;
				}				
				return false;
			}
			
