			private function icdKeyUpHandler(event:KeyboardEvent):void
			{
				if (event.charCode >= 32 && event.charCode <= 127 || event.charCode == 8) //including only alphabets, digits, special characters, del n backspace
				{
					var searchString:String = id_ICDCode.textInput.text;
					if(searchString.length > 2)
					{
						var icdEvent : LoadICDCodeTypesEvent = new LoadICDCodeTypesEvent(searchString,model.LoggedInUserSelectedBranchId.toString());
						CairngormEventDispatcher.getInstance().dispatchEvent( icdEvent );
					}
					
					//id_Add.enableAll = false;
					id_Add.enabled = isGetEdited();
				}
			}
			
			private var serachTermDiagnosis:String;//Search term for the records
			[Bindable]
			private var selectedIcdCodeDTO:ICDCodeTypeDTO;
			
			private function icdKeyUpHandlerNew():void
			{
				serachTermDiagnosis = '';
				serachTermDiagnosis = id_ICDCode.textInput.text;
				//if value exceeds 4 characters then search Icd Code and map the Icd Code.
				if(serachTermDiagnosis.indexOf(".")  > -1 && serachTermDiagnosis.indexOf(".") == serachTermDiagnosis.length - 1  )
				{
					id_Diagnosis.textInput.text = '';
					id_Diagnosis.selectedIndex = -1;
					selectedIcdCodeDTO = null;
					id_Add.enabled = isGetEdited();
					return;
				}
				if(serachTermDiagnosis.length >=5){
					id_Diagnosis.textInput.text = '';
					id_Diagnosis.selectedIndex = -1;
					selectedIcdCodeDTO = null;	
					id_Add.enabled = isGetEdited();
					var icdEvent : LoadICDCodeTypesEvent = new LoadICDCodeTypesEvent(serachTermDiagnosis,model.LoggedInUserSelectedBranchId.toString(), loadData);
					CairngormEventDispatcher.getInstance().dispatchEvent( icdEvent );
					
				}else{
					id_Diagnosis.textInput.text = "";
					id_Diagnosis.selectedIndex = -1;
					selectedIcdCodeDTO = null;
					id_Add.enabled = isGetEdited();
				}
			}
			
			public  function loadData(val:* = null):void
			{
				if(model.ICDCodeTypeList.length)
				{
					for(var i:uint=0; i < model.ICDCodeTypeList.length; i++)
					{
						if(serachTermDiagnosis.toUpperCase() ==  UtilityFunctions.TrimString(model.ICDCodeTypeList[i].ICDCodeName).toUpperCase() && ! hasDuplicateValues(model.ICDCodeTypeList[i].ICDCodeID))
						{							
							id_ICDCode.textInput.text 	= model.ICDCodeTypeList[i].ICDCodeName; 
							id_Diagnosis.textInput.text = model.ICDCodeTypeList[i].ICDCodeDescription;
							selectedIcdCodeDTO			= model.ICDCodeTypeList[i];
							id_Add.enabled 		= isGetEdited();
							return;
						}							
					}
				}
			}
			
			public function set hasViewChanged(value:Boolean):void
			{
				_hasViewChanged = value;
			}
			
			public function isGetEdited():Boolean
			{
				var edited:Boolean = false;
				
				if (id_ICDCode.textInput.text || id_ICDCode.selectedItem  || 
					id_Diagnosis.textInput.text || id_Diagnosis.selectedItem)
				{					
					edited = true;
				}
				hasViewChanged = (_hasGridChanged)? _hasGridChanged : edited;
				
				return edited;
			}
			
			private var _hasGridChanged:Boolean;
			private var _hasViewChanged:Boolean;
			private var _previouslySelectedItem:ICDCodeTypeDTO;
			
			private function validateICDCode():void
			{
				if (id_ICDCode.selectedItem)
				{
					var selectedItem:ICDCodeTypeDTO = id_ICDCode.selectedItem as ICDCodeTypeDTO;
					
					if (selectedItem)
					{
						id_Diagnosis.selectedItem = selectedItem;
						_previouslySelectedItem = id_Diagnosis.selectedItem;
					}
					else
					{
						id_ICDCode.selectedItem = _previouslySelectedItem;
						id_Diagnosis.selectedItem = _previouslySelectedItem;
					}
				}				
			}
			
			private function diagnosisKeyUpHandler(event:KeyboardEvent):void
			{
				if (event.charCode >= 32 && event.charCode <= 127 || event.charCode == 8) //including only alphabets, digits, special characters, del n backspace
				{
					var searchString:String = id_Diagnosis.textInput.text;
					if(searchString.length > 2)
					{
						var icdEvent : LoadICDCodeTypesEvent = new LoadICDCodeTypesEvent(searchString,model.LoggedInUserSelectedBranchId.toString());
						CairngormEventDispatcher.getInstance().dispatchEvent( icdEvent );
					}					
					
					id_Add.enabled = isGetEdited();
				}
			}
			
			private function validateDiagnosis():void
			{
				if (id_Diagnosis.selectedItem)
				{
					var selectedItem:ICDCodeTypeDTO = id_Diagnosis.selectedItem as ICDCodeTypeDTO;
					
					if (selectedItem)
					{
						id_ICDCode.selectedItem = selectedItem;
						_previouslySelectedItem = selectedItem;
					}
					else
					{
						id_ICDCode.selectedItem = _previouslySelectedItem;
						id_Diagnosis.selectedItem = _previouslySelectedItem;
					}
				}				
			}
			
