			private function resetFields():void
			{
				id_Diagnosis.selectedIndex = -1;
				id_ICDCode.selectedIndex = -1;				
								
				//id_form1.enabled = false;				
				serachTermDiagnosis	= "";
				id_Diagnosis.textInput.text = "";
				id_ICDCode.textInput.text = "";
				selectedIcdCodeDTO = null;
				
				id_Add.enabled = false;				
			}
			
			private function deleteRecordClickHandler(event:DataGridActionEvent):void
			{
				var curTar:DataGrid = DataGrid(event.currentTarget);
				var diagnosisID:String = SuperBillDiagnosisInfoDTO(event.currentTarget.selectedItem).DiagnosisID;
				if(diagnosisID != "0") return;
				
				UtilityFunctions.AskMessage(  "Are you sure, you want to delete diagnosis [" + SuperBillDiagnosisInfoDTO(event.currentTarget.selectedItem).ICDCodeName + "]?" , function():void
				{	
					//NewDiagnosis.removeItemAt(NewDiagnosis.getItemIndex((model.CurrentDiagnosis.getItemAt(curTar.selectedIndex))));
					model.CurrentDiagnosis.removeItemAt(curTar.selectedIndex);					
					
					hasViewChanged = _hasGridChanged = true;
				});
				
			}
			
			private function editRecordClickHandler(event:DataGridActionEvent):void
			{
				id_DiagnisisGrid.editable = true;
				
				var rowIndex:int = DataGrid(event.currentTarget).selectedIndex;
				
				var itemToSetInEditableMode:IListItemRenderer = id_DiagnisisGrid.indexToItemRenderer(rowIndex);
				
				var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
				//ev.columnIndex = 0;
				ev.rowIndex = rowIndex;
				ev.itemRenderer = itemToSetInEditableMode;
				//ev.dataField = "ICDCodeName";
				id_DiagnisisGrid.dispatchEvent(ev);			
				
			}
			
			[Bindable]
