		<components1:LabelDataGrid id="id_DiagnisisGrid" width="100%" height="70"  editable="false"
								  itemEditBegin="diagnosisItemEditBeginHandler(event)" itemEditEnd="diagnosisItemEditHandler(event)"		 
								  verticalScrollPolicy="auto"  horizontalScrollPolicy="off"
								  maxHeight="150" variableRowHeight="true"		
								  resizableColumns="false"
								  dataProvider="{model.CurrentDiagnosis}"
								  columnWidths="{['30%','80','20%']}"								  
