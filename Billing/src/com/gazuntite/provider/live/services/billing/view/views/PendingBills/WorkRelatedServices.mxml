			protected function FeeEdit_clickHandler(event:MouseEvent):void
			{
				var btn:Button = event.currentTarget as Button;
				oldFee = 0.00;
				switch(btn.id)
				{
					case "id_Type1FeeEdit":
						if(id_Type1.selected == true)
						{
							id_Type1Fee.editable = true;
							oldFee = Number(id_Type1Fee.text);	
							id_Type1Fee.setFocus();
						}
						break;
					case "id_Type2FeeEdit":
						if(id_Type2.selected == true)
						{
							id_Type2Fee.editable = true;
							oldFee = Number(id_Type2Fee.text);	
