			protected function fee_focusOutHandler(event:FocusEvent):void
			{
				var txt:TextInput = event.currentTarget as TextInput
				switch(txt.id)
				{
					case "id_Type1Fee":	
						if(id_Type1Fee.editable == true && id_Type1Fee.text != "")	
						{
							if(Number(id_Type1Fee.text) != oldFee)
							{
								//var WRS1:WorkRelatedServiceDTO = Services[0];
								model.TotalCharges -= oldFee;
								model.TotalCharges += Number(id_Type1Fee.text);
								//(Services[0] as WorkRelatedServiceDTO).Fee = id_Type1Fee.text;
								(model.CurrentWRServices[0] as WorkRelatedServiceDTO).Fee = id_Type1Fee.text;
							}
