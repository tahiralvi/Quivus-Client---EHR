			public function set CPTs(value:ArrayCollection):void
			{
				m_aProcedures = value;				
				
				if (m_aProcedures)
				{
					m_aProcedures.addEventListener(CollectionEvent.COLLECTION_CHANGE, procedureCollectionChangeHandler, false, 0, true);
					
					if (m_aProcedures.length)
						includeGridInLayout = true;
						
					else
						includeGridInLayout = false;		
				}
				else
					includeGridInLayout = false;
			}
			
			private function procedureCollectionChangeHandler(event:CollectionEvent):void
			{
				switch(event.kind)
				{
					case CollectionEventKind.ADD:
						includeGridInLayout = true;
						break;
					
					case CollectionEventKind.REMOVE:
						if (CPTs && CPTs.length < 1)
							includeGridInLayout = false;
						break;
				}
			}
			
			private function itemEditKeyUpHandler(event:DataGridActionEvent):void	
			{
				var searchString:String;
				if (event.charCode >= 32 && event.charCode <= 127 || event.charCode == 8) //including only alphabets, digits, special characters, del n backspace
				{
					searchString = event.searchString;
					if(event.labelFiled == "ProcedureCode" || event.labelFiled == "ProcedureDescription")
					{
						if(searchString.length > 2)
						{							
							var cptEvent : LoadCPTMedicalTypesEvent = new LoadCPTMedicalTypesEvent(searchString,ReqNo);
							CairngormEventDispatcher.getInstance().dispatchEvent( cptEvent );								
						}
					}
					else if (event.labelFiled == "Modifier1" )
					{
						searchString = event.searchString;
						if(searchString.length > 0)
						{
							var modi1Event : LoadCPTModifierTypesEvent = new LoadCPTModifierTypesEvent(searchString,1);
							CairngormEventDispatcher.getInstance().dispatchEvent( modi1Event );
						}
					}
					else if (event.labelFiled == "Modifier2" )
					{
						if(searchString.length > 0)
						{
							var modi2Event : LoadCPTModifierTypesEvent = new LoadCPTModifierTypesEvent(searchString,2);
							CairngormEventDispatcher.getInstance().dispatchEvent( modi2Event );
						}
					}
					else if (event.labelFiled == "Modifier3" )
					{
						if(searchString.length > 0)
						{
								var modi3Event : LoadCPTModifierTypesEvent = new LoadCPTModifierTypesEvent(searchString,3);
								CairngormEventDispatcher.getInstance().dispatchEvent( modi3Event );
						}
					}
					else if (event.labelFiled == "Modifier4" )
					{
						if(searchString.length > 0)
						{
							var modi4Event : LoadCPTModifierTypesEvent = new LoadCPTModifierTypesEvent(searchString,4);
							CairngormEventDispatcher.getInstance().dispatchEvent( modi4Event );
