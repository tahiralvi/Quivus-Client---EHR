			public  function loadData(val:* = null):void
			{
				if(ReqNo == 1)
				{
					if(model.CPTMedicalTypeList.length)
					{
						for(var i:uint=0; i < model.CPTMedicalTypeList.length; i++)
						{
							if(serachTerm.toUpperCase() == UtilityFunctions.TrimString(model.CPTMedicalTypeList[i].ProcedureCode).toUpperCase() && ! hasDuplicateValues(model.CPTMedicalTypeList[i].ProcedureCode))
							{
								id_CPTCode.textInput.text 	= model.CPTMedicalTypeList[i].ProcedureCode;
								id_Procedure.textInput.text = model.CPTMedicalTypeList[i].ProcedureDescription;
								selectedDTO					= model.CPTMedicalTypeList[i];
								id_Add.enabled 				= isGetEdited();
								
								return;
							}							
						}
					}
				}
				else
				{
					if(model.CPTMedicalTypeListOther.length)
					{
						for(var j:uint=0; j < model.CPTMedicalTypeListOther.length; j++)
						{
							if(serachTerm.toUpperCase() == UtilityFunctions.TrimString(model.CPTMedicalTypeListOther[j].ProcedureCode).toUpperCase()  && ! hasDuplicateValues(model.CPTMedicalTypeListOther[j].ProcedureCode))
							{
								id_CPTCode.textInput.text 	= model.CPTMedicalTypeListOther[j].ProcedureCode;
								id_Procedure.textInput.text = model.CPTMedicalTypeListOther[j].ProcedureDescription;
								selectedDTO					= model.CPTMedicalTypeListOther[j];
								id_Add.enabled 				= isGetEdited();
								return;
							}							
						}
					}
				}
			}		
			
