			private function cptKeyUpHandlerNew():void
			{
				serachTerm = '';
				serachTerm = id_CPTCode.textInput.text;
				//if value exceeds 4 characters then search Icd Code and map the Icd Code.
				if(serachTerm.length >= 4)
				{
					id_Procedure.textInput.text 	= '';
					id_Procedure.selectedIndex 		= -1;
					selectedDTO 					= null;
					id_Add.enabled 					= isGetEdited();
					var cptEvent : LoadCPTMedicalTypesEvent = new LoadCPTMedicalTypesEvent(serachTerm,ReqNo, loadData);
					CairngormEventDispatcher.getInstance().dispatchEvent( cptEvent );
					
				}else{
					id_Procedure.textInput.text 	= '';
					id_Procedure.selectedIndex 		= -1;
					selectedDTO 					= null;
					id_Add.enabled 					= isGetEdited();
				}
			}
			
			private function hasDuplicateValues(CPTCode:String):Boolean
			{
				if( model.CurrentProcedures != null && model.CurrentProcedures.length > 0  )
					for(var j:uint =0; j < model.CurrentProcedures.length; j++)
					{
						var labDTO:SuperBillProcedureInfoDTO = model.CurrentProcedures[j] as SuperBillProcedureInfoDTO;
						
						if(CPTCode == labDTO.ProcedureCode)
							return true;
					}
				
				if( model.CurrentOtherProcedures != null && model.CurrentOtherProcedures.length > 0  )
					for(var k:uint =0; k < model.CurrentOtherProcedures.length; k++)
					{
						var labDTOother:SuperBillProcedureInfoDTO = model.CurrentOtherProcedures[k] as SuperBillProcedureInfoDTO;
						
						if(CPTCode == labDTOother.ProcedureCode)
							return true;
					}
				
				return false;
			}
			
