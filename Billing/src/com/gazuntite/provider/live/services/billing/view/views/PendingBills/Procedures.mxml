					edited = true;
				}
				
				/* if (id_CPTCode.textInput.text || id_CPTCode.selectedItem  || 
					id_Procedure.textInput.text || id_Procedure.selectedItem)
				{
					model.CurrentModifiers =new ArrayCollection();
					edited = true;
				} */
				hasViewChanged = (_hasGridChanged)? _hasGridChanged : edited;
				
				return edited;
			}
			
