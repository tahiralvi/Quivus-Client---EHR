				if (id_CPTCode.selectedItem)
				{
					var selectedItem:CPTMedicalTypeDTO = id_CPTCode.selectedItem as CPTMedicalTypeDTO;
					
					if (selectedItem)
					{
						id_Procedure.selectedItem = selectedItem;
						_previouslySelectedItem = id_Procedure.selectedItem;
