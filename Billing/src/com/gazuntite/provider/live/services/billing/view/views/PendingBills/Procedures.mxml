				procedureDTO.IncludeInBilling = "true";
				procedureDTO.IsCreatedFromSuperBill = "true";
				procedureDTO.IsDeleted = "false";
				
				//NewProcedures.addItem(procedureDTO);
				
				
				if(ReqNo == 1)
				{
					if(model.CurrentProcedures == null)
						model.CurrentProcedures = new ArrayCollection();
					procedureDTO.Type = "CPT";
					model.CurrentProcedures.addItem(procedureDTO);
				}
				else
				{
					if(model.CurrentOtherProcedures == null)
						model.CurrentOtherProcedures = new ArrayCollection();
					procedureDTO.Type = "HCPC";
					model.CurrentOtherProcedures.addItem(procedureDTO);
				}
					
				
				model.TotalCharges += Number(procedureDTO.Fee) * Number(procedureDTO.Unit);						
				model.CalculateSuperBill();
				resetFields();				
								
				hasViewChanged = _hasGridChanged = true;
								
			}
			
