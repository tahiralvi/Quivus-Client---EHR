			private var comboValidator:ComboValidator;
			private var bMsgShown:Boolean;
			private function procedureItemEditHandler(event:DataGridEvent):void
			{	
				
				var dto:SuperBillProcedureInfoDTO = event.itemRenderer.data as SuperBillProcedureInfoDTO;
				if( dto.ProcedureID != "0" && (event.dataField == "ProcedureCode" || event.dataField == "ProcedureDescription"))
				{
					id_CPTCode.textInput.text = dto.ProcedureCode;
					id_Procedure.textInput.text = dto.ProcedureDescription;
					return;
				}
				
				var validationRes:ValidationResultEvent;
				
				if (event.dataField == "ProcedureCode" || event.dataField == "ProcedureDescription")
				{
					var editor:LabelComboBox = ComboBoxEditor(id_ProcedureGrid.itemEditorInstance).id_ComboEditor;
					//var validationRes:ValidationResultEvent;
								
					//validationRes = comboValidator.validate(editor.selectedItem)
					
					if( editor.selectedItem )						
					//if( validationRes  && !validationRes.results)
					{
						dto.ProcedureCode 	= (editor.selectedItem as CPTMedicalTypeDTO).ProcedureCode;
						dto.ProcedureDescription 	= (editor.selectedItem as CPTMedicalTypeDTO).ProcedureDescription;
						dto.CPTMedicalTypeID = (editor.selectedItem as CPTMedicalTypeDTO).CPTMedicalTypeID;
					}
					
				}
				else if (event.dataField == "Modifier1")
				{
					var editorM1:LabelComboBox = ComboBoxEditor(id_ProcedureGrid.itemEditorInstance).id_ComboEditor;
					//var validationRes:ValidationResultEvent;
					
					//validationRes = comboValidator.validate(editorM1.selectedItem)					
					if( editorM1.selectedItem )					
					//if( validationRes  && !validationRes.results)					
					{
						dto.ModifierTypeId1 	= (editorM1.selectedItem as CPTModifierTypeDTO).ModifierTypeId;
						dto.Modifier1 	= (editorM1.selectedItem as CPTModifierTypeDTO).ModifierDescription.split("\-")[0];
					}
				}				
				else if (event.dataField == "Modifier2")
				{
					var editorM2:LabelComboBox = ComboBoxEditor(id_ProcedureGrid.itemEditorInstance).id_ComboEditor;				
									
					if( editorM2.selectedItem )											
					{
						dto.ModifierTypeId2 	= (editorM2.selectedItem as CPTModifierTypeDTO).ModifierTypeId;
						dto.Modifier2 	= (editorM2.selectedItem as CPTModifierTypeDTO).ModifierDescription.split("\-")[0];
					}
				}
				
				else if (event.dataField == "Modifier3")
				{
					var editorM3:LabelComboBox = ComboBoxEditor(id_ProcedureGrid.itemEditorInstance).id_ComboEditor;				
					
					if( editorM3.selectedItem )											
					{
						dto.ModifierTypeId3 	= (editorM3.selectedItem as CPTModifierTypeDTO).ModifierTypeId;
						dto.Modifier3 	= (editorM3.selectedItem as CPTModifierTypeDTO).ModifierDescription.split("\-")[0];
					}
				}
				
				else if (event.dataField == "Modifier4")
				{
					var editorM4:LabelComboBox = ComboBoxEditor(id_ProcedureGrid.itemEditorInstance).id_ComboEditor;				
					
					if( editorM4.selectedItem )											
					{
						dto.ModifierTypeId4 	= (editorM4.selectedItem as CPTModifierTypeDTO).ModifierTypeId;
						dto.Modifier4 	= (editorM4.selectedItem as CPTModifierTypeDTO).ModifierDescription.split("\-")[0];
					}
				}
				else
				{						
					var row:Number = Number(event.rowIndex);
					var col:int = event.columnIndex;					
					
					if (event.dataField == "Fee")
					{	
						var feeEditor:mx.controls.TextInput = mx.controls.TextInput(id_ProcedureGrid.itemEditorInstance);
						
						
						id_NumberValidator.domain="Float";
						id_NumberValidator.source = feeEditor;
						id_NumberValidator.property = "text";
						
						validationRes = id_NumberValidator.validate(UtilityFunctions.TrimString(feeEditor.text));
						
						if (validationRes && !validationRes.results)
						{
							var oldFee:String = String(id_ProcedureGrid.dataProvider.getItemAt(row)["Fee"]);
							var newFee:String = String(id_ProcedureGrid.itemEditorInstance[id_ProcedureGrid.columns[col].editorDataField]);														
							var Unit:String = String(id_ProcedureGrid.dataProvider.getItemAt(row)["Unit"]);
							if(oldFee != newFee)
							{
								model.TotalCharges -= (Number(oldFee) * Number(Unit));
								dto.Fee = newFee;
								model.TotalCharges += (Number(newFee) * Number(Unit));
								model.CalculateSuperBill();
							}
						}
						else
						{
							if( ! bMsgShown )
							{
								bMsgShown = true;
								Alert.show("Please enter valid amount","Invalid Data", Alert.OK, FlexGlobals.topLevelApplication.mainContainer, function(e:Event):void{
									SetFocusOnCell(id_ProcedureGrid,row,col,event.dataField);
								});
							}
							else
								bMsgShown = false;
							
							id_ProcedureGrid.destroyItemEditor();
							event.stopImmediatePropagation();
							event.preventDefault();
						}
						
						
					}				
					else if (event.dataField == "Unit")
					{
						
						var unitEditor:mx.controls.TextInput = mx.controls.TextInput(id_ProcedureGrid.itemEditorInstance);
						
						id_NumberValidator.domain="Float";
						id_NumberValidator.source = unitEditor;
						id_NumberValidator.property = "text";
						
						validationRes = id_NumberValidator.validate(UtilityFunctions.TrimString(unitEditor.text));
						
						if (validationRes && !validationRes.results)
						{
							var Fee:String = String(id_ProcedureGrid.dataProvider.getItemAt(row)["Fee"]);
							var oldUnit:String = String(id_ProcedureGrid.dataProvider.getItemAt(row)["Unit"]);
							var newUnit:String = String(id_ProcedureGrid.itemEditorInstance[id_ProcedureGrid.columns[col].editorDataField]);
							
							dto.Unit = newUnit;						
							model.TotalCharges -= (Number(Fee) * Number(oldUnit));
							model.TotalCharges += (Number(Fee) * Number(newUnit));
							model.CalculateSuperBill();
							
						}
						else
						{
							if( ! bMsgShown )
							{
								bMsgShown = true;
								Alert.show("Please enter valid units","Invalid Data", Alert.OK, FlexGlobals.topLevelApplication.mainContainer, function(e:Event):void{
									SetFocusOnCell(id_ProcedureGrid,row,col,event.dataField);
								});
							}
							else
								bMsgShown = false;
							
							id_ProcedureGrid.destroyItemEditor();
							event.stopImmediatePropagation();
							event.preventDefault();
						}
						
					}
				}	
				if(dto.IsCreatedFromSuperBill == "false")
					dto.ModifiedBy = model.LoggedInUserId.toString();
				
				event.currentTarget.dataProvider.refresh();
				id_ProcedureGrid.destroyItemEditor();
				event.stopImmediatePropagation();
				event.preventDefault();
			}
			
			private function SetFocusOnCell(id_DataGrid:LabelDataGrid,row:int,col:int,field:String):void
			{
				id_DataGrid.editable = true;				
				var itemToSetInEditableMode:IListItemRenderer = id_DataGrid.indexToItemRenderer(row);
				var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
				ev.columnIndex = col;
				ev.rowIndex = row;
				ev.itemRenderer = itemToSetInEditableMode;
				ev.dataField = field;
				id_DataGrid.dispatchEvent(ev);

			}
			
			protected function id_CPTCode_clickHandler(event:MouseEvent, index:uint):void
			{
				if(procedurePopup && procedurePopup.isPopUp) return;						
				
				if(event.target as RichEditableText || event.target as mx.controls.Label)
				{
					return;
				}
				else 
				{
					if(serachTerm == null)
						return
					
					if(serachTerm.length > 2)
					{
						openProcedurePopup(index);
					}
				}
			}
			
			private var procedurePopup:SuperBillProcedurePopup = null;
			private function openProcedurePopup(index:int):void
			{				
				procedurePopup = new SuperBillProcedurePopup();
				procedurePopup.VisitId = VisitId;
				procedurePopup.PatientId = PatientId;
				procedurePopup.ServiceDate = ServiceDate;
				procedurePopup.ReqNo = ReqNo;
				procedurePopup.ShowPopup( this )
				BillingPopUpManager.addPopUp(procedurePopup,BillingPopUpManager.SUPER_BILL_POPUPS)
				procedurePopup.title  = "Add Procedure";
				procedurePopup.height = 410;
				procedurePopup.width  = 550;
				//procedurePopup.move((Capabilities.screenResolutionX/4)-(procedurePopup.width/2), Capabilities.screenResolutionY/4);
				procedurePopup.move((procedurePopup.x) -(procedurePopup.width/2 - 30),Capabilities.screenResolutionY/4);
				procedurePopup.addEventListener(CloseEvent.CLOSE, function (event:CloseEvent):void
				{					
					isGetEdited();
				});
				//procedurePopup.move((Capabilities.screenResolutionX/4)-(procedurePopup.width/2), procedurePopup.y - 37);
				procedurePopup.searchAndLoadLabIn(serachTerm, index);
				resetFields();
			}


			protected function id_CPTCode_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == 13 )
				{
					if(serachTerm == null)
						return
					
					if(serachTerm.length > 2)
					{
						openProcedurePopup(0);
					}
				}
			}


			protected function id_Procedure_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == 13 )
				{
					if(serachTerm == null)
						return
					
					if(serachTerm.length > 2)
					{
						openProcedurePopup(1);
					}
				}
			}

		]]>
	</fx:Script>

