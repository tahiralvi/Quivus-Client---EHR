<?xml version="1.0" encoding="utf-8"?>
<s:HGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx">
	
	<fx:Metadata>
		[Event(name="Add", type="flash.events.Event")]
		[Event(name="Split", type="flash.events.Event")]
		[Event(name="Remove", type="flash.events.Event")]
	</fx:Metadata>

	<fx:Script>
		<![CDATA[
			
			public static const ADD					:String = "Add";
			public static const SPLIT				:String = "Split";
			public static const REOMOVE				:String = "Remove";
						
			protected function clickHandler(event:MouseEvent):void
			{
				var btn:Button = event.currentTarget as Button;
				switch( btn.id )
				{
					case "id_addBtn":
						dispatchEvent( new Event( ADD, true ) );
						break;
					case "id_splitBtn":
						dispatchEvent( new Event( SPLIT, true ) );
						break;
					case "id_removeBtn":
						dispatchEvent( new Event( REOMOVE, true ) );
						break;					
				}
				trace("clicked:", btn.id);
			}
		]]>
	</fx:Script>

	
	
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:Button buttonMode="true" id="id_addBtn" label="Add"  fontFamily="Calibri" fontSize="12"
			  click="clickHandler(event)" tabIndex="3"
			  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.ListBtn" toolTip="{id_addBtn.label}"/>
	<s:Button buttonMode="true" id="id_splitBtn" label="Split"  fontFamily="Calibri" fontSize="12"
			  click="clickHandler(event)" tabIndex="4"
			  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.ListBtn" toolTip="{id_splitBtn.label}"/>
	<s:Button buttonMode="true" id="id_removeBtn" label="Remove"  fontFamily="Calibri" fontSize="12"
			  click="clickHandler(event)" tabIndex="5"
			  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.ListBtn" toolTip="{id_removeBtn.label}"/>
	
</s:HGroup>
