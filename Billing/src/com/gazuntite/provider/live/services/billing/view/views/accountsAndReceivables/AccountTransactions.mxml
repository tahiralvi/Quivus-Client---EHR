			</s:HGroup>
			<s:HGroup width="100%">				
				<s:Label width="50%" text="Visit:" />
				<s:Label width="50%" text="{(model.CurrentPatienAccount.PatientClaims != null  &amp;&amp; model.CurrentPatienAccount.PatientClaims.length > 0) ? 
						 	String(id_claimsGrid.selectedIndex + 1) + ' of ' + model.CurrentPatienAccount.PatientClaims.length.toString() : '0 of 0' }"  />
			</s:HGroup>
			<s:HGroup width="100%">				
				<s:Label width="50%" text="Global Coverage Until:" />
