		</components:columns>
	</components1:LabelDataGrid>	
	<s:VGroup width="100%" >
		<s:Label width="100%" text="Visit Claim Detail:" />	
		<s:VGroup width="100%">
			<s:Label width="100%" text="Diagnoses:" />
			<s:HGroup id="id_DG1" width="100%" />			
			<s:HGroup id="id_DG2" visible="false" includeInLayout="false" width="100%" />
			<s:HGroup id="id_DG3" visible="false" includeInLayout="false" width="100%" />
			<s:Label width="100%" text="Charges:" />
