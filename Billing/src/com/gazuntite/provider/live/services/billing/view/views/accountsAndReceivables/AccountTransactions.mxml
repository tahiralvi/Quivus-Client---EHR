					<mx:DataGridColumn headerText="Modifier1" dataField="Modifier1" width="110" sortable="true" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label"/>
					<mx:DataGridColumn headerText="Modifier2" dataField="Modifier2" width="110" sortable="true" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label"/>
					<mx:DataGridColumn headerText="Modifier3" dataField="Modifier3" width="110" sortable="true" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label"/>
