<?xml version="1.0" encoding="utf-8"?>
<components1:PopupGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
						xmlns:s="library://ns.adobe.com/flex/spark" 
						xmlns:mx="library://ns.adobe.com/flex/mx" 
						xmlns:components="com.zigron.controls.extended.components.*" 
						xmlns:view="com.zigron.provider.search.services.patient.view.*"
						creationComplete="ListOnlyPopup_creationCompleteHandler(event)" xmlns:components1="com.gazuntite.controls.extended.components.*"
						>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.InsOrganizationDTO;
			import com.gazuntite.common.util.ValidationUtils;
			import com.gazuntite.provider.live.services.billing.dto.ClaimManagement.CMSearchDTO;
			import com.gazuntite.provider.live.services.billing.dto.SuperBill.SuperBillPatientInfoDTO;
			import com.gazuntite.provider.live.services.billing.model.BillingModelLocator;
			import com.gazuntite.provider.live.services.billing.util.BillingConstants;
			import com.gazuntite.provider.live.services.billing.util.BillingPopUpManager;
			import com.gazuntite.provider.live.services.billing.view.views.events.ListOnlySelectionEvent;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			
			[Bindable]
			private var model:BillingModelLocator = BillingModelLocator.getInstance();
			
			[Bindable] 
			private var receiverTypes:ArrayCollection = new ArrayCollection(["All","Direct","Clearing House"]);
			
			public function hide():void
			{
				removePopup();
			}
			
			
			
			protected function Apply_clickHandler(event:MouseEvent):void
			{
				if(id_PatientList.selectedIndex > -1)
					model.ClaimListOnlyCritera.PatientID = (id_PatientList.selectedItem as SuperBillPatientInfoDTO).PatientId;
				if(id_Carrier.selectedIndex > -1)
					model.ClaimListOnlyCritera.InsOrganizationID = (id_Carrier.selectedItem as InsOrganizationDTO).InsOrganizationID;
						
				if(id_EDIReceiver.selectedIndex > -1)
					model.ClaimListOnlyCritera.EDIReceiverTypeID = id_EDIReceiver.selectedIndex.toString();
				
				if(! UtilityFunctions.IsNullOrEmpty(id_ClaimCreated.text) && ValidationUtils.isValidDateFormat(id_ClaimCreated.text))
				{
					model.ClaimListOnlyCritera.DateCreated = UtilityFunctions.FormatDate(id_ClaimCreated.text);			
				}
				
				if(! UtilityFunctions.IsNullOrEmpty(id_ClaimCreated.text) && ValidationUtils.isValidDateFormat(id_ClaimCreated.text))
				{
					model.ClaimListOnlyCritera.DateCreated = UtilityFunctions.FormatDate(id_ClaimCreated.text);			
				}	
				
				if(! UtilityFunctions.IsNullOrEmpty(id_BillingDate.text) && ValidationUtils.isValidDateFormat(id_BillingDate.text))
				{
					model.ClaimListOnlyCritera.BillDate = UtilityFunctions.FormatDate(id_BillingDate.text);			
				}	
				
				if(! UtilityFunctions.IsNullOrEmpty(id_BatchId.text) && id_BatchId.text != "Batch Number")
				{
					model.ClaimListOnlyCritera.BatchID = id_BatchId.text;			
				}	
				
				if(id_ExcludeDone.enabled == true && id_ExcludeDone.selected == true)
					model.ClaimListOnlyCritera.ExcludeDone = "true";
				else
					model.ClaimListOnlyCritera.ExcludeDone = "false";
				
				var e:ListOnlySelectionEvent	= new ListOnlySelectionEvent();
				
				dispatchEvent(e);
				removePopup();
				BillingPopUpManager.removePopUp(this,BillingPopUpManager.CLAIM_MANAGEMENT_POPUPS);
			}
			
			protected function Cancel_clickHandler(event:MouseEvent):void
			{
				model.ClaimListOnlyCritera = null;
				removePopup();
				BillingPopUpManager.removePopUp(this,BillingPopUpManager.CLAIM_MANAGEMENT_POPUPS);
			}		
			
			protected function ListOnlyPopup_creationCompleteHandler(event:FlexEvent):void
			{	
				
				model.ClaimListOnlyCritera = new CMSearchDTO();	
				
				model.ClaimListOnlyCritera.BatchID = "0";
				model.ClaimListOnlyCritera.BillDate = "1900-01-01";
				model.ClaimListOnlyCritera.ClaimID = "0";
				model.ClaimListOnlyCritera.ClinicBranchId = model.LoggedInUserSelectedBranchId.toString();
				model.ClaimListOnlyCritera.DateCreated "1900-01-01";
				model.ClaimListOnlyCritera.EDIReceiverTypeID ="0";
				model.ClaimListOnlyCritera.ExcludeDone = "true"
				model.ClaimListOnlyCritera.InsOrganizationID = "0";
				model.ClaimListOnlyCritera.InsuranceTypeId = "0";
				model.ClaimListOnlyCritera.ListType = "0";
				model.ClaimListOnlyCritera.MediaTypeID = "0";
				model.ClaimListOnlyCritera.PageNo = BillingConstants.FIRST_PAGE_NUMBER.toString();
				model.ClaimListOnlyCritera.PatientID = "0";
				model.ClaimListOnlyCritera.QuivusID = "0";
				model.ClaimListOnlyCritera.SearchString = "0";
				model.ClaimListOnlyCritera.StatusTypeID = "0";
				model.ClaimListOnlyCritera.Type = "2";
				model.ClaimListOnlyCritera.VisitDate = "1900-01-01";	
				model.ClaimListOnlyCritera.DateCreated = "1900-01-01";
			}
			
			protected function default_clickHandler(event:MouseEvent):void
			{
				model.ClaimListOnlyCritera = new CMSearchDTO();	
				
				model.ClaimListOnlyCritera.BatchID = "0";
				model.ClaimListOnlyCritera.BillDate = "1900-01-01";
				model.ClaimListOnlyCritera.ClaimID = "0";
				model.ClaimListOnlyCritera.ClinicBranchId = model.LoggedInUserSelectedBranchId.toString();
				model.ClaimListOnlyCritera.DateCreated "1900-01-01";
				model.ClaimListOnlyCritera.EDIReceiverTypeID ="0";
				model.ClaimListOnlyCritera.ExcludeDone = "true"
				model.ClaimListOnlyCritera.InsOrganizationID = "0";
				model.ClaimListOnlyCritera.InsuranceTypeId = "0";
				model.ClaimListOnlyCritera.ListType = "0";
				model.ClaimListOnlyCritera.MediaTypeID = "0";
				model.ClaimListOnlyCritera.PageNo = BillingConstants.FIRST_PAGE_NUMBER.toString();
				model.ClaimListOnlyCritera.PatientID = "0";
				model.ClaimListOnlyCritera.QuivusID = "0";
				model.ClaimListOnlyCritera.SearchString = "0";
				model.ClaimListOnlyCritera.StatusTypeID = "0";
				model.ClaimListOnlyCritera.Type = "2";
				model.ClaimListOnlyCritera.VisitDate = "1900-01-01";	
				model.ClaimListOnlyCritera.DateCreated = "1900-01-01";
				
				id_ClaimCreated.text = "";
				id_AllIns.selected = true;
				id_Carrier.selectedIndex = -1;
				id_EDIReceiver.selectedIndex = -1;
				id_AllMethod.selected = true;
				id_BillingDate.text = "";
				id_BatchId.text = "";
				id_AllStatus.selected = true;
				id_ExcludeDone.selected = true;
			}
			
			protected function RadioChangeHandler(event:Event):void
			{				
				var rdo:RadioButton = event.currentTarget as RadioButton;
				if (rdo.groupName == "Status" )	
					id_ExcludeDone.enabled = false;
				
				switch(rdo.id)
				{
					
					case "id_AllIns":
						if(rdo.selected == true)
						{
							model.ClaimListOnlyCritera.InsuranceTypeId = "0";
						}
						break;
					case "id_Pri":
						if(rdo.selected == true)
						{							
							model.ClaimListOnlyCritera.InsuranceTypeId = "1";
						}
						break;
					case "id_Sec":
						if(rdo.selected == true)
						{							
							model.ClaimListOnlyCritera.InsuranceTypeId = "2";
						}
						break;
					case "id_Ter":
						if(rdo.selected == true)
						{							
							model.ClaimListOnlyCritera.InsuranceTypeId = "3";
						}
						break;
					case "id_AllMethod":
						if(rdo.selected == true)
						{								
							model.ClaimListOnlyCritera.MediaTypeID = "0";
						}
						break;
					case "id_Paper":
						if(rdo.selected == true)
						{								
							model.ClaimListOnlyCritera.MediaTypeID = "1";
						}
						break;
					case "id_Electronic":
						if(rdo.selected == true)
						{								
							model.ClaimListOnlyCritera.MediaTypeID = "2";
						}
						break;
					case "id_AllStatus":
						if(rdo.selected == true)
						{
							model.ClaimListOnlyCritera.StatusTypeID = "0";	
							id_ExcludeDone.enabled = true;
						}
						break;					
					case "id_Hold":
						if(rdo.selected == true)
						{
							model.ClaimListOnlyCritera.StatusTypeID = "1";
						}
						break;
					
					case "id_Alert":
						if(rdo.selected == true)
						{
							model.ClaimListOnlyCritera.StatusTypeID = "2";
						}
						break;
					
					case "id_Ready":
						if(rdo.selected == true)
						{
							model.ClaimListOnlyCritera.StatusTypeID = "3";
						}
						break;					
					case "id_Done":
						if(rdo.selected == true)
						{
							model.ClaimListOnlyCritera.StatusTypeID = "4";
						}
						break;					
					case "id_Sent":
						if(rdo.selected == true)
						{
							model.ClaimListOnlyCritera.StatusTypeID = "5";
						}						
						break;					
					case "id_Pending":
						if(rdo.selected == true)
						{
							model.ClaimListOnlyCritera.StatusTypeID = "6";
						}						
						break;
					case "id_Rejected":
						if(rdo.selected == true)
						{
							model.ClaimListOnlyCritera.StatusTypeID = "7";
						}
						break;					
					case "id_Challenge":
						if(rdo.selected == true)
						{
							model.ClaimListOnlyCritera.StatusTypeID = "8";
						}					
						break;					
				}
			}
			
			protected function id_BatchId_focusInHandler(event:FocusEvent):void
			{
				if(id_BatchId.text == "Batch Number")
					id_BatchId.text = "";
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:SkinnableContainer width="100%" skinClass="com.adobe.gazuntite.skins.chrome.popUpSkins.listonlyPopupSkin" 
						  maxWidth="460">
		
		<s:layout>
			<s:VerticalLayout paddingLeft="12" paddingRight="12"  paddingBottom="10"  paddingTop="3" gap="5"/>
		</s:layout>
		<s:HGroup  verticalAlign="middle"  width="100%" >	
			<s:Label text="List Only Claims That Match" fontFamily="Calibri" fontSize="12" color="#FFFFFF"/>
			<s:Spacer width="100%"/>
			<s:Button buttonMode="true" id="id_CloseBtn" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.whiteCloseButton"  
					  click="Cancel_clickHandler(event)"
					  toolTip="Close"  height="25" width="16"/>
			
		</s:HGroup>
		<!--<s:VGroup width="100%">-->
			<s:HGroup width="100%" >				
				<components1:LabelComboBox id="id_PatientList" prompt="Patient" width="50%" dataProvider="{model.ClaimPatientList}" labelField="Patient" height="28" tabIndex="1" />
				<components1:LabelDateField id="id_ClaimCreated"  width="50%" prompt="Claim Created"  selectableRange="{{rangeEnd:new Date()}}"	 fontFamily="calibri" fontSize="11"	
										   yearNavigationEnabled="true" minYear="1901" maxYear="{new Date().getFullYear()}" tabIndex="2"
										   />
			</s:HGroup>
			<mx:HRule width="100%"/>
			<s:HGroup width="100%"  textAlign="left" verticalAlign="middle" >
				<s:Label text="SELECT CLAIMS FOR ONLY" width="120"  color="#333333" fontFamily="Calibri" fontSize="11"/>
				<s:RadioButton id="id_AllIns" width="85" color="#333333"  fontFamily="Calibri" fontSize="11" label="All" groupName="InsType" selected="true" change="RadioChangeHandler(event)" tabIndex="3" />
				<s:RadioButton id="id_Pri" width="70" color="#333333" fontFamily="Calibri" fontSize="11" label="Primary" groupName="InsType" change="RadioChangeHandler(event)" tabIndex="4" />
				<s:RadioButton id="id_Sec" width="80" color="#333333" fontFamily="Calibri" fontSize="11" label="Secondary" groupName="InsType" change="RadioChangeHandler(event)" tabIndex="5" />
				<s:RadioButton id="id_Ter" width="70" color="#333333"  fontFamily="Calibri" fontSize="11" label="Tertiary" groupName="InsType" change="RadioChangeHandler(event)" tabIndex="6" />				
			</s:HGroup>	
		<mx:HRule width="100%"/>
				<s:Label text="THAT MATCH ONE OR MORE OF THESE CRITERIA:"  verticalAlign="middle" textAlign="left" fontFamily="Calibri" fontSize="11"  />
			<s:HGroup width="100%">
				<components1:LabelComboBox id="id_Carrier" prompt="Insurance Carrier" width="50%" dataProvider="{model.InsuranceListfoClaimListOnly}" labelField="InsuranceName" tabIndex="7" />
				<components1:LabelComboBox id="id_EDIReceiver" prompt="EDI Receiver" width="50%" dataProvider="{receiverTypes}" tabIndex="8"/>
			</s:HGroup>
		<mx:HRule width="100%"/>
			<s:HGroup width="100%" verticalAlign="middle">
				<s:Label text="BILLING METHOD:" width="120" color="#333333" textAlign="left" fontFamily="Calibri" fontSize="11"   />
				<s:RadioButton id="id_AllMethod" width="85" color="#333333" fontFamily="Calibri" fontSize="11" label="All" groupName="Method" selected="true" change="RadioChangeHandler(event)" tabIndex="9" />
				<s:RadioButton id="id_Paper" width="70" color="#333333" fontFamily="Calibri" fontSize="11" label="Paper" groupName="Method" change="RadioChangeHandler(event)" tabIndex="10" />
				<s:RadioButton id="id_Electronic" width="80" color="#333333" fontFamily="Calibri" fontSize="11" label="Electronic" groupName="Method" change="RadioChangeHandler(event)" tabIndex="11" />
			</s:HGroup>
			<s:HGroup width="100%">
				<components1:LabelDateField id="id_BillingDate"  width="50%" prompt="Billing Date"  selectableRange="{{rangeEnd:new Date()}}"	
										   fontFamily="calibri" fontSize="11" tabIndex="12"	
										   yearNavigationEnabled="true" minYear="1901" maxYear="{new Date().getFullYear()}" 
										   />
				<s:TextInput id="id_BatchId" text="Batch Number" width="50%" restrict="[0-9]"  height="18" focusIn="id_BatchId_focusInHandler(event)" tabIndex="13" />
			</s:HGroup>
		<mx:HRule width="100%"/>
			<s:HGroup width="100%" >
				<s:Label text="CLAIM STATUS:" verticalAlign="middle" textAlign="left"  fontFamily="Calibri" width="120" fontSize="11"  />				
				<s:HGroup width="100%">
					<s:VGroup width="85">
						<s:RadioButton id="id_AllStatus"  color="#333333"  fontFamily="Calibri" fontSize="11"	 label="All" groupName="Status" selected="true" change="RadioChangeHandler(event)" tabIndex="14" />
						<s:RadioButton id="id_Hold"  color="#333333" fontFamily="Calibri" fontSize="11"	 label="Hold" groupName="Status" change="RadioChangeHandler(event)" tabIndex="18" />
						<s:RadioButton id="id_Ready"  color="#333333"  fontFamily="Calibri" fontSize="11"	 label="Ready to Send" groupName="Status" change="RadioChangeHandler(event)" tabIndex="21" />
					</s:VGroup>	
					<s:VGroup width="70">
						<s:RadioButton id="id_Sent" fontFamily="Calibri" color="#333333" fontSize="11" label="Sent" groupName="Status" change="RadioChangeHandler(event)" tabIndex="16" />
						<s:RadioButton id="id_Rejected"   fontFamily="Calibri" color="#333333" fontSize="11" label="Rejected" groupName="Status" change="RadioChangeHandler(event)" tabIndex="19" />
						<s:RadioButton id="id_Challenge"  fontFamily="Calibri" color="#333333" fontSize="11" label="Challenge" groupName="Status" change="RadioChangeHandler(event)" tabIndex="22" />
					</s:VGroup>	
					<s:VGroup width="100%">
						<s:RadioButton id="id_Alert"  fontFamily="Calibri" color="#333333" fontSize="11" label="Alert" groupName="Status" change="RadioChangeHandler(event)" tabIndex="17" />
						<s:RadioButton id="id_Done"  label="Done"  color="#333333" groupName="Status" fontFamily="Calibri" fontSize="11" change="RadioChangeHandler(event)" tabIndex="20" />
						<s:HGroup width="100%" gap="2" verticalAlign="middle" >
							<s:RadioButton id="id_Pending"  color="#333333" fontFamily="Calibri" fontSize="11" label="Pending"  groupName="Status" change="RadioChangeHandler(event)" tabIndex="23" />
							<s:CheckBox id="id_ExcludeDone"  label="Exclude Done" selected="true" tabIndex="15" />
						</s:HGroup>
						
					</s:VGroup>	
				</s:HGroup>				
			</s:HGroup>
		<mx:HRule width="100%"/>
			<s:HGroup width="100%" verticalAlign="middle"  >	
				<s:Button label="Restore Default"  width="100" buttonMode="true" useHandCursor="true"  toolTip="Default" click="default_clickHandler(event)"  styleName="blackButtonSkin" tabIndex="24" />
				<s:Spacer width="100%"/>
				<s:Button label="Apply" click="Apply_clickHandler(event)" width="50" toolTip="Apply" useHandCursor="true" styleName="blackButtonSkin"  buttonMode="true" tabIndex="25" />
				<s:Button label="Cancel" click="Cancel_clickHandler(event)" width="60" toolTip="Cancel" useHandCursor="true" styleName="blackButtonSkin"   buttonMode="true" tabIndex="26" />				
			</s:HGroup>
<!--		</s:VGroup>-->
	</s:SkinnableContainer>
	
</components1:PopupGroup>
