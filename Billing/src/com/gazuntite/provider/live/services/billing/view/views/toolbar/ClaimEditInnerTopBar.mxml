<?xml version="1.0" encoding="utf-8"?>
<s:HGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		  paddingLeft="10"  paddingRight="10">
	
	<fx:Script>
		<![CDATA[
			[Bindable]
			private var m_sClaimId:String;
			[Bindable]
			private var m_sClaimCreated:String;
						
			public function set EditClaimId(value:String):void
			{
				m_sClaimId = value;
			}
			public function set DateCreated(value:String):void
			{
				m_sClaimCreated = value;
			}			
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:Label text="Claim" width="100" fontFamily="Calibri"  fontSize="12" />
	<s:Label id="id_lblClaimId" text="{m_sClaimId}" width="100" fontFamily="Calibri"  fontSize="12"  />
	<s:Spacer width="100%"/>
	<s:Label text="Claim Created" width="100" fontFamily="Calibri"  fontSize="12"/>
	<s:Label id="id_lblClaimCreated" text="{m_sClaimCreated}" width="100" fontFamily="Calibri"  fontSize="12" />
	
</s:HGroup>
