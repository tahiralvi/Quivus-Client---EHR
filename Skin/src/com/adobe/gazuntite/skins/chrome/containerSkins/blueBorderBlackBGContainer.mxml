<!--- The default skin class for a Spark SkinnableContainer container.

@see spark.components.SkinnableContainer

@langversion 3.0
@playerversion Flash 10
@playerversion AIR 1.5
@productversion Flex 4
-->
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5" width.normal="214">
	
	<fx:Metadata>
		<![CDATA[
		/**
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("spark.components.SkinnableContainer")]
		]]>
	</fx:Metadata>
	<s:states>
		<s:State name="normal" />
		<s:State name="disabled" />
	</s:states>
	
	<!--- Defines the appearance of the SkinnableContainer class's background. -->
	<s:VGroup width="100%" height="100%" gap="1">
		
		<s:Rect height="7" radiusX="0" width="100%" >
			<s:filters>
				<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#333333" distance="2" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			</s:filters>
			<s:fill>
				<s:LinearGradient rotation="270">
					<s:GradientEntry alpha="1.0" color="#B7C9E8" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#3862C2" ratio="0.5215686274509804"/>
					<s:GradientEntry alpha="1.0" color="#4872D3" ratio="0.5254901960784314"/>
					<s:GradientEntry alpha="1.0" color="#557EE6" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
		</s:Rect>
		<s:Rect height="100%" radiusX="0" width="100%">
			<s:filters>
				<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#333333" distance="2" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
				<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="0x000000" distance="0" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
			</s:filters>
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#7F9BD7" joints="miter" miterLimit="4" weight="1"/>
			</s:stroke>
			<s:fill>
				<s:SolidColor color="#484C51"/>
			</s:fill>
		</s:Rect>
		
	</s:VGroup>
	<!--
	Note: setting the minimum size to 0 here so that changes to the host component's
	size will not be thwarted by this skin part's minimum size. This is a compromise,
	more about it here: http://bugs.adobe.com/jira/browse/SDK-21143
	-->
	<!--- @copy spark.components.SkinnableContainer#contentGroup -->
	<s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
		<s:layout>
			<s:BasicLayout/>
		</s:layout>
	</s:Group>
	
</s:Skin>

