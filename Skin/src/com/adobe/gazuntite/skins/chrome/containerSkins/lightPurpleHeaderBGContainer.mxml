<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin width="100%" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5" xmlns:mx="library://ns.adobe.com/flex/mx"	
			  mouseOver="sparkskin1_mouseOverHandler(event)"
			  mouseOut="sparkskin1_mouseOutHandler(event)">
	
	<fx:Metadata>
		<![CDATA[ 
		/** 
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("spark.components.SkinnableContainer")]
		]]>
	</fx:Metadata> 

	<fx:Script>
		<![CDATA[
			protected function sparkskin1_mouseOverHandler(event:MouseEvent):void
			{
				id_over.visible = true;
				id_normal.visible = false;
			}

			protected function sparkskin1_mouseOutHandler(event:MouseEvent):void
			{
				id_over.visible = false;
				id_normal.visible = true;
			}

		]]>
	</fx:Script>

	
	<s:states>
		<s:State name="normal" />
		<s:State name="disabled" />
	</s:states>
	<s:Group width="100%">
		<!--<s:BitmapImage width="100%" source="@Embed('com/adobe/gazuntite/view/controls/skins/assets/mainContainer.swf', symbol='bar_email')"
					   />-->
		<!--<s:Rect height="22" radiusX="4" radiusY="4" width="100%">
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#B5B5C4" ratio="0.01568627450980392"/>
					<s:GradientEntry alpha="1" color="#858699" ratio="0.043137254901960784"/>
					<s:GradientEntry alpha="1.0" color="#676782" ratio="0.9607843137254902"/>
					<s:GradientEntry alpha="1.0" color="#8D8DA5" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
		</s:Rect>-->
		<s:Rect id="id_normal" height="22" radiusX="4" radiusY="4" width="100%">
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#EFF0FE" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#C6C7E2" ratio="0.5254901960784314"/>
					<s:GradientEntry alpha="1.0" color="#A1A3C8" ratio="0.5333333333333333"/>
					<s:GradientEntry alpha="1.0" color="#A3A4BA" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
				<s:DropShadowFilter alpha="0.75" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
			</s:filters>
		</s:Rect>
		
		
		<s:Rect id="id_over" height="22" radiusX="4" radiusY="4" width="100%">
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#EFF0FE" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#9FA0C6" ratio="0.5411764705882353"/>
					<s:GradientEntry alpha="1.0" color="#8688B5" ratio="0.5450980392156862"/>
					<s:GradientEntry alpha="1.0" color="#A3A4BA" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
				<s:DropShadowFilter alpha="0.75" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1" />
			</s:filters>
		</s:Rect>
		
		
	</s:Group>
	<!--- @copy spark.components.SkinnableContainer#contentGroup -->
	<s:Group width="100%" id="contentGroup" clipAndEnableScrolling="false" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
		<s:layout>
			<s:BasicLayout />
		</s:layout>
	</s:Group>
	
</s:SparkSkin>
