<!--- The default skin class for a Spark SkinnableContainer container.  

     @see spark.components.SkinnableContainer
        
      @langversion 3.0
      @playerversion Flash 10
      @playerversion AIR 1.5
      @productversion Flex 4
-->
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
    xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5">

    <fx:Metadata>
    <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.SkinnableContainer")]
    ]]>
    </fx:Metadata> 
    
    <fx:Script fb:purpose="styling">
        
    </fx:Script>
    
    <s:states>
        <s:State name="normal" />
        <s:State name="disabled" />
    </s:states>
    
    <!--- Defines the appearance of the SkinnableContainer class's background. -->
	<s:Rect height="100%" radiusX="3" minWidth="600" width="100%" x="0" y="27">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#CFCFCF" ratio="0.1843137254901961"/>
				<s:GradientEntry alpha="1.0" color="#C9C9C9" ratio="0.5176470588235295"/>
				<s:GradientEntry alpha="1.0" color="#BFBFBF" ratio="0.5215686274509804"/>
				<s:GradientEntry alpha="1.0" color="#BFBFBF" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:GlowFilter blurX="5" blurY="5" color="#ee0202" inner="true" strength="5" alpha="1.0" quality="2" knockout="false"   />
			<s:DropShadowFilter alpha="1" angle="90" blurX="4.0" blurY="4.0" color="0x000000" distance="0" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:RichText color="#111111" fontSize="14"  id="labelDisplay" fontFamily="Calibri Bold"/>
	
	<s:HGroup width="100%" horizontalAlign="right" right="17">		
		
		<s:Rect height="33" radiusX="3" width="124">
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#BFBFBF" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#BFBFBF" ratio="0.5137254901960784"/>
					<s:GradientEntry alpha="1.0" color="#C9C9C9" ratio="0.5176470588235295"/>
					<s:GradientEntry alpha="1.0" color="#CFCFCF" ratio="0.8509803921568627"/>
				</s:LinearGradient>
			</s:fill>
			<s:filters>
				<s:GlowFilter blurX="5" blurY="5" color="#ee0202" inner="true" strength="3"  alpha="1.0" quality="2" knockout="false"   />
				<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#333333" distance="2" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
			</s:filters>
		</s:Rect>
	</s:HGroup>
	
    
    <!--
        Note: setting the minimum size to 0 here so that changes to the host component's
        size will not be thwarted by this skin part's minimum size.   This is a compromise,
        more about it here: http://bugs.adobe.com/jira/browse/SDK-21143
    -->
    <!--- @copy spark.components.SkinnableContainer#contentGroup -->
    <s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
        <s:layout>
            <s:BasicLayout/>
        </s:layout>
    </s:Group>

</s:Skin>
