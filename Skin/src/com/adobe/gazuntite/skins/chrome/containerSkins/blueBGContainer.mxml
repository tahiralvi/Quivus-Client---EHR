<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
		xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5">
	
	<fx:Metadata>
		<![CDATA[ 
		/** 
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("spark.components.SkinnableContainer")]
		]]>
	</fx:Metadata> 
	
	<s:states>
		<s:State name="normal" />
		<s:State name="disabled" />
	</s:states>
	
	
	<s:VGroup gap="0" width="100%" height="100%">
		
		<s:Rect  height="15" radiusX="0" width="100%">
			<s:filters>
				<s:DropShadowFilter alpha="1" angle="90" blurX="0" blurY="0" color="#666666" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
			</s:filters>
			<s:fill>
				<s:LinearGradient rotation="270">
					<s:GradientEntry alpha="1.0" color="#8A969E" ratio="0.00784313725490196"/>
					<s:GradientEntry alpha="1.0" color="#AEB6BD" ratio="0.08235294117647059"/>
					<s:GradientEntry alpha="1.0" color="#8D9BA6" ratio="0.996078431372549"/>
					<s:GradientEntry alpha="1.0" color="#B1BCC3" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
		</s:Rect>
		
		<s:Rect height="100%" radiusX="0" width="100%">
			<s:filters>
				<s:DropShadowFilter alpha="1" angle="90" blurX="4" blurY="4" color="#333333" distance="0" hideObject="false" inner="true" knockout="false" quality="2" strength="2"/>
			</s:filters>
			<s:fill>
				<s:LinearGradient rotation="270">
					<s:GradientEntry alpha="1.0" color="#AFD4F1" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#AFD4F1" ratio="0.49411764705882355"/>
					<s:GradientEntry alpha="1.0" color="#BEE0F1" ratio="0.4980392156862745"/>
					<s:GradientEntry alpha="1.0" color="#E0EBF3" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
		</s:Rect>
	</s:VGroup>
	
	<!--
	Note: setting the minimum size to 0 here so that changes to the host component's
	size will not be thwarted by this skin part's minimum size.   This is a compromise,
	more about it here: http://bugs.adobe.com/jira/browse/SDK-21143
	-->
	<!--- @copy spark.components.SkinnableContainer#contentGroup -->
	<s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
		<s:layout>
			<s:BasicLayout/>
		</s:layout>
	</s:Group>
	
</s:Skin>
