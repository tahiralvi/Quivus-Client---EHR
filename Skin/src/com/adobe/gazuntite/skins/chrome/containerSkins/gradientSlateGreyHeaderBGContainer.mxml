<?xml version="1.0" encoding="utf-8"?>

<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
    xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5"
	mouseOver="skin1_mouseOverHandler(event)" mouseDown="skin1_mouseDownHandler(event)"
	mouseOut="skin1_mouseOutHandler(event)"
	>

    <fx:Metadata>
    <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.SkinnableContainer")]
    ]]>
    </fx:Metadata> 

	<fx:Script>
		<![CDATA[
			protected function skin1_mouseOverHandler(event:MouseEvent):void
			{
				//var lg:LinearGradient = new LinearGradient();
				id_rect.fill = id_overcolor;
				
			}

			protected function skin1_mouseDownHandler(event:MouseEvent):void
			{
				id_rect.fill = id_downcolor;
			}


			protected function skin1_mouseOutHandler(event:MouseEvent):void
			{
				id_rect.fill = id_outcolor;
			}

		]]>
	</fx:Script>

    
    <s:states>
        <s:State name="normal" />
        <s:State name="disabled" />
    </s:states>
    
	<fx:Declarations>
		<s:LinearGradient id="id_downcolor"  rotation="90">
			<s:GradientEntry ratio="0" color="#BAC5D3" alpha="1.0"/>
			<s:GradientEntry ratio="1" color="#758CBA" alpha="1.0"/>
		</s:LinearGradient>
		
		<s:LinearGradient id="id_overcolor"  rotation="90">
			<!--<s:GradientEntry alpha="1" color="#BAE5FF" ratio="0"/>
			<s:GradientEntry alpha="1.0" color="#73B5DD" ratio="1"/>-->
			<s:GradientEntry ratio="0" color="#BAC5D3" alpha="1.0"/>
			<s:GradientEntry ratio="1" color="#758CBA" alpha="1.0"/>
		</s:LinearGradient>
		
		<s:LinearGradient id="id_outcolor"  rotation="90">
			<s:GradientEntry alpha="1.0" color="#B0B6C0" ratio="0"/>
			<s:GradientEntry alpha="1.0" color="#A7ADB7" ratio="0.5058823529411764"/>
			<s:GradientEntry alpha="1.0" color="#A0A6B0" ratio="0.5098039215686274"/>
			<s:GradientEntry alpha="1.0" color="#A0A6B0" ratio="1"/>
		</s:LinearGradient>
	</fx:Declarations>
    <!--- Defines the appearance of the SkinnableContainer class's background. -->
	<!--<s:Rect id="id_rect" includeIn="normal" height="21" width="100%" >
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#FFFFFF" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient  rotation="90">
				<s:GradientEntry alpha="1" color="#FFFFFF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#DEDDDE" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
    -->
	<s:Rect id="id_rect" includeIn="normal" height="22" width="100%" radiusX="5" >
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1" />
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#B0B6C0" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#A7ADB7" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#A0A6B0" ratio="0.5098039215686274"/>
				<s:GradientEntry alpha="1.0" color="#A0A6B0" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	
	
    <!--
        Note: setting the minimum size to 0 here so that changes to the host component's
        size will not be thwarted by this skin part's minimum size.   This is a compromise,
        more about it here: http://bugs.adobe.com/jira/browse/SDK-21143
    -->
    <!--- @copy spark.components.SkinnableContainer#contentGroup -->
    <s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
        <s:layout>
            <s:BasicLayout/>
        </s:layout>
    </s:Group>

</s:Skin>
