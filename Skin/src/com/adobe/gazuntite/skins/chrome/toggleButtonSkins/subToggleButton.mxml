<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:d="http://ns.adobe.com/fxg/2008/dt">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect height="15" id="rect0" includeIn="disabled,disabledAndSelected,down,downAndSelected,over,overAndSelected,upAndSelected" radiusX="3" width="120" x="0.5" y="0.5">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#333333" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill.disabled>
			<s:SolidColor color="#CCCCCC"/>
		</s:fill.disabled>
		<s:fill.over>
		<!--	<s:LinearGradient rotation="90">
				<s:GradientEntry ratio="0" color="#009CFF" alpha="1.0"/>
				<s:GradientEntry ratio="1" color="#6FC9FF" alpha="1.0"/>
			</s:LinearGradient>-->
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill.over>
		<s:fill.down>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill.down>
		<s:fill.upAndSelected>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill.upAndSelected>
		<s:fill.overAndSelected>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill.overAndSelected>
		<s:fill.downAndSelected>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill.downAndSelected>
		<s:fill.disabledAndSelected>
			<s:SolidColor color="#CCCCCC"/>
		</s:fill.disabledAndSelected>
	</s:Rect>
	
	
	<s:Label id="labelDisplay"
			 textAlign="left" fontFamily="Calibri"
			 verticalAlign="middle" color="#000000" color.over="#ffffff" color.upAndSelected="#ffffff" color.overAndSelected="#ffffff" color.downAndSelected="#ffffff"
			 maxDisplayedLines="1"
			 horizontalCenter="0" verticalCenter="1"
			 left="10" right="10" top="2" bottom="2">
	</s:Label>
	
</s:Skin>    
