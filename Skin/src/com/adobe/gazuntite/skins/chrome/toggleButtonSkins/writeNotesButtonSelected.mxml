	<s:Rect height="21" includeIn="disabled,over, upAndSelected, overAndSelected" radiusX="0" width="20" x.disabled="0" x.disabledAndSelected="0" x.down="0" x.downAndSelected="0" x.overAndSelected="0" x.upAndSelected="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#FF7200" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FF7800" ratio="0.00784313725490196"/>
				<s:GradientEntry alpha="1.0" color="#FF7800" ratio="0.19215686274509805"/>
				<s:GradientEntry alpha="1.0" color="#FF4B13" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#FFBB5A" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		
	</s:Rect>
	
	<s:Rect height="16" includeIn="disabled,down,over,overAndSelected" radiusX="2" visible.disabled="false" width="16" x.disabled="1" x.down="1" x.over="0" y.disabled="0" y.down="0" y.over="2" visible.over="false">
