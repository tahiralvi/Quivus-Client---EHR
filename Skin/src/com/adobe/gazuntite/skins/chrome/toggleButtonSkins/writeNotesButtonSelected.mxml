				<s:GradientEntry alpha="1.0" color="#FFBB5A" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX.disabled="2" blurX.down="2" blurX.over="1" blurY.disabled="2" blurY.down="2" blurY.over="1" color="#333333" distance.disabled="2" distance.down="2" distance.over="1" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
