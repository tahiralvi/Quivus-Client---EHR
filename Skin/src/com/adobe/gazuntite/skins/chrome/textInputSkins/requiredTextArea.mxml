<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
    xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5" blendMode="normal">
    <fx:Metadata>[HostComponent("com.gazuntite.controls.extended.components.LabelTextArea")]</fx:Metadata>

    <fx:Script>
        <![CDATA[
        /** 
         * @private 
         */     
        private static const focusExclusions:Array = ["textDisplay"];

        /**
         *  @private
         */
        override public function get focusSkinExclusions():Array { return focusExclusions;};
        ]]>
    </fx:Script>
    
	<s:states>
		<s:State name="normal"/><s:State name="normalWithPrompt"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
    
    <!-- border --> 
    <!--- @private -->
    <s:Rect id="border" left="0" right="0" top="0" bottom="0">
        <s:stroke>
            <!--- @private -->
            <s:SolidColorStroke id="borderStroke" weight="1" alpha="0"/>            
        </s:stroke>
    </s:Rect>

    <!-- fill -->
    <!--- Defines the appearance of the TextArea component's background. -->
   
	<s:Group width="100%" >
		<s:Rect height="100%" id="rect72" radiusX="2" width="100%"  bottom="1"
				left="1"
				right="1"
				top="1">
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#7F7F7F" joints="miter" miterLimit="4" weight="1"/>
			</s:stroke>
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#CCCCCC"  ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#F7F3F7"  ratio="1"/>
				</s:LinearGradient>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
			</s:filters>
		</s:Rect>
		<s:Rect height="100%" id="rect19"  radiusX="2" width="5" x="2"  y="2" >
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#EE0202" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#AF0000" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
		</s:Rect>
	</s:Group>
	
    <!-- shadow -->
    <!--- @private -->
    <s:Rect id="shadow" left="1" top="1" right="1" height="1">
        <s:fill>
            <s:SolidColor color="0x000000" alpha="0.12" />
        </s:fill>
    </s:Rect>

    <!--- Defines the scroller that is used to scroll the TextArea control. -->
    <s:Scroller id="scroller" left="0" top="0" right="0" bottom="0" minViewportInset="1" measuredSizeIncludesScrollBars="false" hasFocusableChildren="false">
        <!--- @copy spark.components.supportClasses.SkinnableTextBase#textDisplay -->
        <s:RichEditableText id="textDisplay"
                  heightInLines="10" color="#000000" fontFamily="Calibri" paddingTop="3" paddingLeft="2"
                  widthInChars="15" />
		
	
		
	
    </s:Scroller>
	<s:Label 
		id="promptView"
		bottom="1"
		color="#666666"
		fontStyle="normal"
		left="1"
		paddingBottom="3"
		paddingLeft="3"
		paddingRight="3"
		paddingTop="5"
		right="1"
		top="1"
		fontFamily="Calibri Bold"
		
		/>
</s:SparkSkin>
