<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
    xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5" blendMode="normal">

    <fx:Metadata>
    <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.TextInput")]
    ]]>
    </fx:Metadata> 
    
    
    <fx:Script>
        <![CDATA[
        /** 
         * @private 
         */     
        private static const focusExclusions:Array = ["textDisplay"];

        /**
         *  @private
         */
        override public function get focusSkinExclusions():Array { return focusExclusions;};
        ]]>
    </fx:Script>
    
	<s:states>
		<s:State name="normal"/><s:State name="normalWithPrompt"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
    
    <!-- border --> 
    <!--- @private -->
    <s:Rect left="0" right="0" top="0" bottom="0" id="border">
        <s:stroke>     
            <!--- @private -->
            <s:SolidColorStroke id="borderStroke" weight="0" />
        </s:stroke>
    </s:Rect>

    <!-- fill -->
    <!--- Defines the appearance of the TextInput component's background. -->
	
	<s:Rect height="17" radiusX="4" radiusY="4" width="210">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#9EA1AF" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1" color="#FFFFFF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="2" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
	
    <!--<s:Rect id="background" left="1" right="1" top="1" bottom="1">
        <s:fill>
            
            <s:SolidColor id="bgFill" color="0xFFFFFF" />
        </s:fill>
    </s:Rect>-->
    
    <!-- shadow -->
    <!--- @private -->
   <!-- <s:Rect left="1" top="1" right="1" height="1" id="shadow">
        <s:fill>
            <s:SolidColor color="0x000000" alpha="0.12" />
        </s:fill>
    </s:Rect>-->
    
    <!-- text -->
    <!--- @copy spark.components.supportClasses.SkinnableTextBase#textDisplay -->
    <s:RichEditableText id="textDisplay" height="17"
              verticalAlign="middle"
              widthInChars="10" paddingLeft="3"
              left="1" right="1" top="1" bottom="1" />
	<s:Label 
		id="promptView"
		bottom="1"
		color="#333333"	
		left="1"
		paddingBottom="3"
		paddingLeft="3"
		paddingRight="3"
		paddingTop="3"
		right="1"
		top="1"
		fontFamily="Calibri"
		fontSize="11"
		
		/>

</s:SparkSkin>
