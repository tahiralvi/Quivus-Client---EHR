<!--- The default skin class for Spark TextArea component.  

@see spark.components.TextArea

@langversion 3.0
@playerversion Flash 10
@playerversion AIR 1.5
@productversion Flex 4
-->
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5" blendMode="normal" xmlns:components="com.gazuntite.controls.extended.components.*">
	<fx:Metadata>[HostComponent("com.gazuntite.controls.extended.components.LabelTextArea")]</fx:Metadata>
	
	
	<s:states>
		<s:State name="normal"/>
		<s:State name="normalWithPrompt"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	<s:Rect height="100%" radiusX="3" width="100%">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#999999" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#F7F3F7" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
	
	
	
	
	<!--- Defines the scroller that is used to scroll the TextArea control. -->
	<s:Scroller id="scroller" left="0" top="0" right="0" bottom="0" minViewportInset="1" measuredSizeIncludesScrollBars="false" hasFocusableChildren="false">
		<!--- @copy spark.components.supportClasses.SkinnableTextBase#textDisplay -->
		<s:RichEditableText id="textDisplay"
							heightInLines="10"
							widthInChars="15" focusIn="{textDisplay.selectRange(0,textDisplay.text.length) }" fontFamily="CalibriCFF" fontSize="11"
							paddingLeft="3"
							paddingRight="3"
							paddingTop="4"
							/>
	</s:Scroller>
	
	
	<s:Label 
		id="promptView"
		bottom="1"
		color="#333333"
		left="1"
		paddingBottom="3"
		paddingLeft="3"
		paddingRight="3"
		paddingTop="5"
		right="1"
		top="1"
		fontSize="11"
		fontFamily="CalibriCFFBold"
		/>
	
	
</s:SparkSkin>
