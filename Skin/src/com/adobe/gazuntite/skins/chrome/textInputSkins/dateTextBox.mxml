<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin  xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:s="library://ns.adobe.com/flex/spark" 
		xmlns:mx="library://ns.adobe.com/flex/mx"
		creationComplete="skin1_creationCompleteHandler(event)">
	
	
	<fx:Metadata>
		<![CDATA[
		
		[HostComponent("com.gazuntite.controls.extended.components.LabelDateField")]
		
		]]>
	</fx:Metadata>
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;

			protected function skin1_creationCompleteHandler(event:FlexEvent):void
			{
				//hostComponent.prompt
			}

		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal"/><s:State name="normalWithControlBar" />
		<s:State name="disabled"/>
	</s:states>
	
	<!--- @private -->
	
	
	<s:Group width="100%" >
		<s:Rect height="18" id="rect72" radiusX="2" width="100%"   bottom="1"
				left="1"
				right="1"
				top="1" >
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#7F7F7F" joints="miter" miterLimit="4" weight="1" />
			</s:stroke>
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#CCCCCC"  ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#F7F3F7"  ratio="1"/>
				</s:LinearGradient>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
			</s:filters>
		</s:Rect>
		<s:Rect height="18" id="rect19"  radiusX="2" width="5" x="2" y="2" >
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#EE0202" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#AF0000" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
		</s:Rect>
	</s:Group>
	<s:Label id="prompt"  verticalAlign="middle" maxDisplayedLines="1" 
			 mouseEnabled="false" mouseChildren="false"   color="#FF0000"
			 left="1"  paddingLeft="15" right="1" top="2" bottom="2" width="75"  /> 
	
	<s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
		<s:layout>
			<s:BasicLayout/>
		</s:layout>
	</s:Group>
	
</s:SparkSkin>