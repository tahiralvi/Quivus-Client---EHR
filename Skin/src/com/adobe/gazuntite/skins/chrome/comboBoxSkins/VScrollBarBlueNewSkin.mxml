<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009" minWidth="8" minHeight="15" 
			 alpha.disabled="0.5" alpha.inactive="0.5" >
	
	<fx:Metadata>[HostComponent("spark.components.VScrollBar")]</fx:Metadata>
	
	<!--
	NOTE: this skin file contains sub-parts that may continue to react to
	Style code.  To remove this behavior create new copies of those skins
	and remove the styles.
	-->
	<s:states>
		<s:State name="normal" />
		<s:State name="disabled" />
		<s:State name="inactive" />
	</s:states>
	
	<!---  The default skin class is VScrollBarTrackSkin.  
	@copy spark.components.supportClasses.TrackBase#track 
	@see spark.skins.spark.VScrollBarTrackSkin -->
	<s:Button skinClass="com.adobe.gazuntite.skins.chrome.scrollerSkins.track" y="5" id="track" x="0"/>
	<s:Button toolTip="Scroll" skinClass="com.adobe.gazuntite.skins.chrome.scrollerSkins.thumbBtn" id="thumb" x="1" y="8" y.normal="12" buttonMode.normal="true"/>
	<s:Button skinClass="com.adobe.gazuntite.skins.chrome.scrollerSkins.button1" y="0" id="decrementButton" x="1" buttonMode.normal="true"/>
	<s:Button skinClass="com.adobe.gazuntite.skins.chrome.scrollerSkins.downBtn" y="{track.height + 10}" id="incrementButton" x="1" buttonMode.normal="true"/>
	
	
</s:SparkSkin>
