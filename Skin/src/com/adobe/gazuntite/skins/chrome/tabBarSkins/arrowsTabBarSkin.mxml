<?xml version="1.0" encoding="utf-8"?>

<s:Skin 
    xmlns:fx="http://ns.adobe.com/mxml/2009" 
    xmlns:s="library://ns.adobe.com/flex/spark"
    xmlns:fb="http://ns.adobe.com/flashbuilder/2009"     
    alpha.disabled="0.5" xmlns:components="com.zigron.controls.extended.components.*"
	creationComplete="skin1_creationCompleteHandler(event)" xmlns:components1="com.gazuntite.controls.extended.components.*">
    <fx:Metadata>
        <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.TabBar")]
        ]]>
    </fx:Metadata> 
	<fx:Script>
		<![CDATA[
			import com.gazuntite.controls.extended.components.CheckButtonBarButton;
			
			import mx.events.FlexEvent;
			
			import spark.components.TabBar;
			import spark.events.IndexChangeEvent;
			
			private var currentSelection:*;
			
			protected function skin1_creationCompleteHandler(event:FlexEvent):void
			{
				hostComponent.addEventListener(IndexChangeEvent.CHANGING, OnTabIndexChange);
				//hostComponent.addEventListener(MouseEvent.CLICK, OnClick);
				currentSelection = hostComponent.selectedItem;
			}
			
			private function OnTabIndexChange( event:IndexChangeEvent ):void
			{
				var b:CheckButtonBarButton = dataGroup.getElementAt( event.oldIndex ) as CheckButtonBarButton;
				b.hasChange = currentSelection.hasChange; 
				currentSelection = hostComponent.selectedItem;
			}
			
		 	private function OnClick( event:MouseEvent):void
			{
				var b:CheckButtonBarButton = dataGroup.getElementAt( event.currentTarget.currentSelection ) as CheckButtonBarButton;
				b.hasChange = currentSelection.hasChange; 												
				currentSelection = hostComponent.selectedItem;
			} 
			
		]]>
	</fx:Script>
    
    <s:states>
        <s:State name="normal" />
        <s:State name="disabled" />
    </s:states>
	
	<s:Rect height="33" width="10" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#8C8F94" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#62686F" ratio="0.47843137254901963"/>
				<s:GradientEntry alpha="1.0" color="#5A5F66" ratio="0.47843137254901963"/>
				<s:GradientEntry alpha="1.0" color="#6D727A" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
		<!--	<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="0x000000" distance="2" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>-->
			<s:DropShadowFilter alpha="0.5" angle="270" blurX="1" blurY="1" color="#FFFFFF" distance="0" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<s:Path data="M 0 0 L 0 33 L 600.692 33 L 609.818 16.499 L 600.692 0" winding="nonZero" x="15" y="0" width="100%">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#8C8F94" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#62686F" ratio="0.47843137254901963"/>
				<s:GradientEntry alpha="1.0" color="#5A5F66" ratio="0.47843137254901963"/>
				<s:GradientEntry alpha="1.0" color="#6D727A" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="0x000000" distance="2" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="270" blurX="1" blurY="1" color="#FFFFFF" distance="0" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Path>
    
    <!--- @copy spark.components.SkinnableDataContainer#dataGroup -->
    <s:DataGroup id="dataGroup" width="100%" height="100%" x="15">
        <s:layout>
            <s:ButtonBarHorizontalLayout gap="-1" />
        </s:layout>
        <s:itemRenderer>
            <fx:Component>
                <!--<s:ButtonBarButton skinClass="com.zigron.provider.eprescription.services.patient.view.skins.arrowToggleBtn" />-->
				<components1:CheckButtonBarButton skinClass="com.adobe.gazuntite.skins.chrome.toggleButtonSkins.arrowToggleBtn"  
												 buttonMode="true" useHandCursor="true">
					
				</components1:CheckButtonBarButton>
				
            </fx:Component>
        </s:itemRenderer>
    </s:DataGroup>
    
</s:Skin>
