<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect height="16" includeIn="down,over" radiusX="2" width="16" visible.down="false" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#FF7200" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FF7800" ratio="0.00784313725490196"/>
				<s:GradientEntry alpha="1.0" color="#FF7800" ratio="0.19215686274509805"/>
				<s:GradientEntry alpha="1.0" color="#FF4B13" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#FFBB5A" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.98" angle="270" blurX="0" blurY="0" color="#333333" distance="1" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect height="16" includeIn="down,over" radiusX="2" width="16" visible.over="false" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#FF7200" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FF7800" ratio="0.00784313725490196"/>
				<s:GradientEntry alpha="1.0" color="#FF7800" ratio="0.19215686274509805"/>
				<s:GradientEntry alpha="1.0" color="#FF4B13" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#FFBB5A" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="1" blurY="1" color="#333333" distance="1" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage smooth="true" source="@Embed('com/adobe/gazuntite/skins/chrome/assets/grid_delete.png')" y.over="5" y.down="5" y.disabled="5" y.up="6" x="4">
		<s:filters>
			<s:GlowFilter includeIn="over" blurX="10" blurY="10" color="#000000" inner="true" strength="10" alpha="1.0" quality="3" knockout="false"/>
			<s:GlowFilter includeIn="down" blurX="10" blurY="10" color="#000000" inner="true" strength="10" alpha="1.0" quality="3" knockout="false"/>
			<s:GlowFilter includeIn="disabled" blurX="10" blurY="10" color="#ffffff" inner="true" strength="10" alpha="1.0" quality="3" knockout="false"/>
		</s:filters>
	</s:BitmapImage>
</s:Skin>
