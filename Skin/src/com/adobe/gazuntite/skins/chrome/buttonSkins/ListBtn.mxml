<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:d="http://ns.adobe.com/fxg/2008/dt" xmlns:ai="http://ns.adobe.com/ai/2009" xmlns:flm="http://ns.adobe.com/flame/2008">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect height="23" includeIn="disabled,up" radiusX="3" minWidth="60" width="100%" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#454B54" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#2B323B" ratio="0.5450980392156862"/>
				<s:GradientEntry alpha="1.0" color="#363E46" ratio="0.5490196078431373"/>
				<s:GradientEntry alpha="1.0" color="#6D7278" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="true" knockout="false" quality="2" strength="1" alpha="0.5"/>
			<s:DropShadowFilter angle="90" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1" blurX="2" blurY="2" alpha="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect height="23" includeIn="down,over,up" radiusX="3" minWidth="60" width="100%" x="0" y="0" visible.up="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#F4CF85" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#EFA74E" ratio="0.5137254901960784"/>
				<s:GradientEntry alpha="1.0" color="#EC923A" ratio="0.5176470588235295"/>
				<s:GradientEntry alpha="1.0" color="#F1983B" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="true" knockout="false" quality="2" strength="1" color.down="#333333" alpha.down="0.75" blurX.down="2" blurY.down="2"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:RichText width="100%" paddingLeft="3" paddingRight="3" textAlign="center" id="labelDisplay" columnCount="1" whiteSpaceCollapse="preserve" color="#C8CACB" tabStops="S0" y="6" fontFamily="Calibri" fontSize="14" kerning="on" text="" color.over="#000000" color.down="#000000"/>
</s:Skin>
