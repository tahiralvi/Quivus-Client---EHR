<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect height="20" includeIn="disabled,disabledAndSelected,up" radiusX="3" width="100%" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#AAADB1" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#8D9296" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#878B90" ratio="0.5098039215686274"/>
				<s:GradientEntry alpha="1.0" color="#94989D" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<s:Rect height="20" includeIn="disabledAndSelected,down,over,up,upAndSelected" radiusX="3" width="100%" x="0" y="0" visible.disabledAndSelected="false" visible.up="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#F2BF65" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#EFA64D" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#EC923A" ratio="0.5098039215686274"/>
				<s:GradientEntry alpha="1.0" color="#F1983B" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter includeIn="down" blurX="2" blurY="2" distance="1" hideObject="false" color="0x000000" inner="true" strength="1" alpha="0.5" quality="3" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	<s:Rect height="20" includeIn="downAndSelected,overAndSelected,up" radiusX="3" width="100%" x="0" y="0" visible.up="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#F8B43C" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#F59C25" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#F38712" ratio="0.5098039215686274"/>
				<s:GradientEntry alpha="1.0" color="#F78E12" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter includeIn="downAndSelected" blurX="2" blurY="2" distance="1" hideObject="false" color="0x000000" inner="true" strength="1" alpha="0.5" quality="3" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	<s:RichText width="100%" textAlign="center" id="labelDisplay" color="#000000" color.up="#4D5155" color.disabled="#4D5155" fontSize="13" includeIn="down,downAndSelected,over,overAndSelected,up,upAndSelected,disabled" tabStops="S0" 
				text="" y="5"  fontFamily="Calibri" fontWeight="bold">
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:RichText>
</s:Skin>

