<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>

	<s:Rect height="21" radiusX="2" width="18" x="0.5" y="0.5" visible.up="false" visible.disabled="false" >
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#505152" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#313233" ratio="0.49411764705882355"/>
				<s:GradientEntry alpha="1.0" color="#1D1E20" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#1D1E20" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#333333" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" includeIn="down,up" inner="true" knockout="false" quality="2" strength="1" distance.down="2"/>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<s:RichText text="x" color="#ffffff"  fontSize="14" tabStops="S0" y="5.5" x="9" color.up="#ffffff" fontFamily="Arial" fontWeight="bold" x.over="6" y.over="4.5" x.up="6" y.up="4.5" x.down="6" y.down="4.5" >
		<s:filters>
			<s:DropShadowFilter blurX="1" blurY="1" distance="1" hideObject="false" color="#FFFFFF" inner="false" strength="1" alpha="0.25" quality="2" knockout="false" angle="90"/>
		</s:filters>
	</s:RichText>
</s:Skin>
