<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect height="24" includeIn="disabled,over,up" radiusX="3" width="26" x="0.5" visible.over="false" y="0.5">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#666666" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#D9D9D9" ratio="0" color.disabled="#CCCCCC"/>
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:Rect height="24" includeIn="down,over,up" radiusX="3" width="26" x="0.5" visible.up="false" y="1.5">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#454545" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter includeIn="down" blurX="2" blurY="2" distance="1" hideObject="false" color="0x000000" inner="true" strength="1" alpha="0.75" quality="3" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage includeIn="disabled,up" smooth="true" source="@Embed('../assets/icons/blackshareicon.png')" x="3" alpha.disabled="0.48" y="3"/>
	<s:BitmapImage smooth="true" source="@Embed('../assets/icons/whiteshareicon.png')" includeIn="down,over" x="3" y="3"/>
</s:Skin>
