<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
             xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5">
    
    <!-- host component -->
    <fx:Metadata>
        <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.Button")]
        ]]>
    </fx:Metadata>
    
    <!-- states -->
    <s:states>
        <s:State name="up" />
        <s:State name="over" />
        <s:State name="down" />
        <s:State name="disabled" />
    </s:states>
    
    <!-- layer 1: shadow -->
    <!--- @private -->
    
    <!-- layer 2: fill -->
    <!--- @private -->
	<s:Group x="0" y="0">
		<s:Rect includeIn="up" height="21" radiusX="3" radiusY="3" width="78" x="0" y="0">
			<s:fill>
				<s:LinearGradient rotation="270" scaleX="21" x="39" y="21">
					<s:GradientEntry color="#494C69" ratio="0"/>
					<s:GradientEntry color="#0C112D" ratio="0.25"/>
					<s:GradientEntry color="#494C69" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
		</s:Rect>
		
		
		<s:Rect includeIn="over, down" height="21" radiusX="3" radiusY="3" width="78">
			<s:fill>
				
				<s:LinearGradient rotation="270" scaleX="24">
					<s:GradientEntry alpha="1.0" color="#6FC9FF" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#009CFF" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
			
		</s:Rect>
		
	</s:Group>
    

    
    <!-- layer 8: text -->
    <!--- @copy spark.components.supportClasses.ButtonBase#labelDisplay -->
    <s:Label id="labelDisplay"
             textAlign="center"
             verticalAlign="middle"
             maxDisplayedLines="1"
			 color="#ffffff" color.over="#000000"
			 fontSize="10"
			 fontFamily="Calibri"
             verticalCenter="1"
             top="2" bottom="2"
			 width="78"
			 paddingLeft="1" paddingRight="1">
    </s:Label>
    
</s:SparkSkin>
