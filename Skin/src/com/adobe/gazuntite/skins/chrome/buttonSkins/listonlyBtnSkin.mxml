<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:d="http://ns.adobe.com/fxg/2008/dt">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect height="19" id="rect17" radiusX="3" width="100%" x="0.5" y="0.5">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#D28553" color.over="#FFCB00" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#AB623B" ratio="1" color.over="#FF9300"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:GlowFilter alpha="1.0" blurX="6" blurY="6" color="#FFCB00" includeIn="down,over,up" inner="true" knockout="false" quality="2" strength="1"/>
			<s:DropShadowFilter alpha="1" angle="90" blurX="0" blurY="0" color="#9B6D1E" distance="1" hideObject="false" includeIn="down,over,up" inner="false" knockout="false" quality="2" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="2" hideObject="false" includeIn="down" inner="true" knockout="false" quality="2" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#D28553" color.disabled="#999999" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill.disabled>
			<s:SolidColor color="#CCCCCC"/>
		</s:fill.disabled>
	</s:Rect>
	
	<s:Label id="labelDisplay" color="#FFFFFF" fontFamily="Calibri" fontSize="13" 
			 textAlign="center"
			 verticalAlign="middle"
			 maxDisplayedLines="1"
			 horizontalCenter="0" verticalCenter="1"
			 left="10" right="10" top="2" bottom="2">
	</s:Label>
</s:Skin>