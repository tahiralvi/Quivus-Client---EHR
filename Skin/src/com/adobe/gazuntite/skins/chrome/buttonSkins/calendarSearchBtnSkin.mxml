<!--- The default skin class for the Spark Button component.  

       @see spark.components.Button
        
      @langversion 3.0
      @playerversion Flash 10
      @playerversion AIR 1.5
      @productversion Flex 4
-->
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
             xmlns:fb="http://ns.adobe.com/flashbuilder/2009" minWidth="21" minHeight="21" alpha.disabled="0.5">
    
    <!-- host component -->
    <fx:Metadata>
        <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.Button")]
        ]]>
    </fx:Metadata>
    
    <!-- states -->
    <s:states>
        <s:State name="up" />
        <s:State name="over" />
        <s:State name="down" />
        <s:State name="disabled" />
    </s:states>
    
    <!-- layer 1: shadow -->
    <!--- @private -->
	<s:Rect alpha="1" height="20" radiusX="2" width="88" >
		<s:stroke>
			<s:SolidColorStroke alpha="1" caps="none" color="#333333" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#666666" ratio="0.5215686274509804"/>
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#999999" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:fill.over>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="0.0"/>
				<s:GradientEntry alpha="0.5" color="#666666" ratio="0.5215686274509804"/>
				<s:GradientEntry alpha="0.8" color="#333333" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#999999" ratio="1"/>
			</s:LinearGradient>
		</s:fill.over>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
    
    <!-- layer 8: text -->
    <!--- @copy spark.components.supportClasses.ButtonBase#labelDisplay -->
    <s:Label id="labelDisplay" width="100%"
             textAlign="center" color="#ffffff"
             verticalAlign="middle"
             maxDisplayedLines="1" fontFamily="Calibri"
             horizontalCenter="0" verticalCenter="1"
             left="10" right="10" top="2" bottom="2">
    </s:Label>
    
</s:SparkSkin>
