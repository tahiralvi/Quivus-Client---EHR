<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:ATE="http://ns.adobe.com/ate/2009" xmlns:ai="http://ns.adobe.com/ai/2009" xmlns:d="http://ns.adobe.com/fxg/2008/dt" xmlns:flm="http://ns.adobe.com/flame/2008" xmlns:lib="assets.graphics.*" xmlns:fc="http://ns.adobe.com/flashcatalyst/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	
	<s:Rect height="16" id="rect2" radiusX="2.99979" radiusY="2.99979" width="70" >
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#CFF47F" color.upAndSelected="#AFD1FF" color.overAndSelected="#AFD1FF" ratio="0"/>
				<s:GradientEntry alpha="0.5" color="#86A723" color.upAndSelected="#6593D5" color.overAndSelected="#6593D5" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.7000000000000001" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" 
								hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.1" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1"
								hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<s:Label id="labelDisplay" verticalCenter="0" text=""  horizontalCenter="0" color="#333333" fontFamily="CalibriCFF" fontSize="10"/>
</s:Skin>
