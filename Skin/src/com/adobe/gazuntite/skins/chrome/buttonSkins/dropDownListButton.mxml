<!--- The default skin class for the Spark Button component.  

       @see spark.components.Button
        
      @langversion 3.0
      @playerversion Flash 10
      @playerversion AIR 1.5
      @productversion Flex 4
-->
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
             xmlns:fb="http://ns.adobe.com/flashbuilder/2009" minWidth="21" minHeight="15" alpha.disabled="0.5"
			 creationComplete="sparkskin1_creationCompleteHandler(event)" >
    
    <!-- host component -->
    <fx:Metadata>
        <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.Button")]
        ]]>
    </fx:Metadata>
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			protected function sparkskin1_creationCompleteHandler(event:FlexEvent):void
			{
				if(hostComponent.label=="Busy")
				{
					rect2.fill = id_overcolor;
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:LinearGradient id="id_overcolor"  rotation="90">
			<s:GradientEntry alpha="1.0" color="#AFD1FF" ratio="0"/>
			<s:GradientEntry alpha="1.0" color="#6593D5" ratio="1"/>
		</s:LinearGradient>
	</fx:Declarations>
    
    <!-- states -->
    <s:states>
        <s:State name="up" />
        <s:State name="over" />
        <s:State name="down" />
        <s:State name="disabled" />
    </s:states>
    
	<s:Rect height="100%" id="rect2" radiusX="2.99979" radiusY="2.99979" width="100%" x="0" y="0" >
		<s:fill >
			<s:LinearGradient rotation="90" id="id_Available">
				<s:GradientEntry alpha="1.0" color="#CFF47F"  ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#86A723"  ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.7000000000000001" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.2" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Path data="M 0 0 L 4.127 3.843 L 8.254 0 L 0 0 Z"  width="8" height="5" verticalCenter="0"  right="6" >
		<s:fill>
			<s:SolidColor color="#2B2B2B"/>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.2" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" 
								hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Path>
	
	<s:Line  verticalCenter="0" yTo="12" right="18" >
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#4C4D51" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Line> 
</s:SparkSkin>
