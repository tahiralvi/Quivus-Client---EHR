<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect alpha="0.25" height="19" radiusX="2" width="24" x="0.5" y="0.5" alpha.over="0.5">
		<s:stroke>
			<s:SolidColorStroke alpha="1" caps="none" color="#FFFFFF" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#EBEBEB" ratio="0.5215686274509804"/>
				<s:GradientEntry alpha="1.0" color="#D9D9D9" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter includeIn="down" blurX="2" blurY="2" distance="1" hideObject="false" color="0x000000" inner="true" strength="1" alpha="0.5" quality="3" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage smooth="true" source="@Embed('../assets/icons/goback.png')" x="5" y="3"/>
</s:Skin>
