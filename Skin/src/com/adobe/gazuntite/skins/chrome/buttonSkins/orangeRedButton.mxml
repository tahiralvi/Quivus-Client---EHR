<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect height="16" radiusX="8" width="49" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#F7903B" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FF770A" ratio="0.4235294117647059"/>
				<s:GradientEntry alpha="1.0" color="#FFB347" ratio="0.4627450980392157" ratio.over="0.5254901960784314" color.over="#FFC675"/>
				<s:GradientEntry alpha="1.0" color="#FF7300" ratio="0.9137254901960784" ratio.over="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter blurX="3" blurY="3" distance="1" hideObject="false" color="0x000000" inner="false" strength="1" alpha="0.5" quality="2" knockout="false" angle="90" blurX.up="1" blurY.up="1"/>
			<s:DropShadowFilter includeIn="down" blurX="2" blurY="2" distance="2" hideObject="false" color="0x000000" inner="true" strength="1" alpha="0.5" quality="2" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	<s:RichText color="#000000" fontSize="12" tabStops="S0"  text="{hostComponent.label}" x="13" y="3" fontFamily="Calibri">
		<s:filters>
			<s:DropShadowFilter blurX="1" blurY="1" distance="1" hideObject="false" color="#7F4F0B" inner="false" strength="1" alpha="0.5" quality="2" knockout="false" angle="270"/>
		</s:filters>
	</s:RichText>
</s:Skin>
