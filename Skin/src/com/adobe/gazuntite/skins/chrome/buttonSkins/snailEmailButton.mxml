<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect height="19" visible.disabled="false" visible.up="false" width="28" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="90" rotation.over="270">
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter includeIn="down" blurX="2" blurY="2" distance="2" hideObject="false" color="0x000000" inner="true" strength="1" alpha="0.5" quality="2" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage smooth="true" source="@Embed('../assets/icons/pe_snailmail.png')" visible.down="false" visible.over="false" x="3" y="3">
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="0" blurY="0" color="#250F73" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:BitmapImage>
	<s:BitmapImage includeIn="down,over" smooth="true" source="@Embed('../assets/icons/pe_snailmail_hover.png')" x="3" y="3" y.down="4"/>
</s:Skin>
