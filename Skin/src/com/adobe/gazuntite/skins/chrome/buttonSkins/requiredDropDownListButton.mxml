			<s:SolidColorStroke caps="none" color="#4C4D51" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Line> -->
	
	<s:Line x="1" y="3.5" yTo="13" right="17">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#7F7F7F" joints="miter" miterLimit="4" weight="1" />
		</s:stroke>
	</s:Line>
