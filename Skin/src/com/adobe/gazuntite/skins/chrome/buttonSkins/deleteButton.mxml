<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect height="18" includeIn="down,over" radiusX="2" width="18" y="0.5" x="0.5">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#FF7200" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FF7800" ratio="0.00784313725490196"/>
				<s:GradientEntry alpha="1.0" color="#FF7800" ratio="0.19215686274509805"/>
				<s:GradientEntry alpha="1.0" color="#FF4B13" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#FFBB5A" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.98" angle="270" blurX="0" blurY="0" color="#333333" distance="1" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage smooth="true" source="@Embed('../assets/icons/grid_delete.png')" y="4" x="4">
		<s:filters>
			<s:GlowFilter alpha="1.0" blurX="6.0" blurY="6.0" color="#555555" includeIn="up" inner="true" knockout="false" quality="3" strength="6"/>
			<s:DropShadowFilter alpha="1" angle="90" blurX="1" blurY="1" color="#666666" distance="1" hideObject="false" includeIn="up" inner="true" knockout="false" quality="3" strength="1"/>
			<s:GlowFilter includeIn="over" blurX="6.0" blurY="6.0" color="#666666" inner="true" strength="6" alpha="1.0" quality="2" knockout="false"/>
			<s:DropShadowFilter includeIn="over" blurX="1" blurY="1" distance="1" hideObject="false" color="0x000000" inner="false" strength="1" alpha="0.5" quality="3" knockout="false" angle="90"/>
			<s:GlowFilter includeIn="down" blurX="6.0" blurY="6.0" color="#FFFFFF" inner="true" strength="6" alpha="1.0" quality="2" knockout="false"/>
			<s:DropShadowFilter includeIn="down" blurX="1" blurY="1" distance="1" hideObject="false" color="0x000000" inner="false" strength="1" alpha="0.5" quality="3" knockout="false" angle="90"/>
			<s:GlowFilter includeIn="disabled" blurX="6.0" blurY="6.0" color="#999999" inner="true" strength="2" alpha="1.0" quality="2" knockout="false"/>
		</s:filters>
	</s:BitmapImage>
</s:Skin>
	
