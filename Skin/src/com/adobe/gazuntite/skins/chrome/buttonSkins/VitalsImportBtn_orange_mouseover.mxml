<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:d="http://ns.adobe.com/fxg/2008/dt">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect height="16" radiusX="1" visible.disabled="false" visible.downAndSelected="false" visible.overAndSelected="false" visible.up="false" visible.upAndSelected="false" width="20" x="0.5" y="0.5">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1" color="#727272" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#727272" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" includeIn="down" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		
		<s:fill.over>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#F4CF85" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#EFA74E" ratio="0.5137254901960784"/>
				<s:GradientEntry alpha="1.0" color="#EC923A" ratio="0.5176470588235295"/>
				<s:GradientEntry alpha="1.0" color="#F1983B" ratio="1"/>
			</s:LinearGradient>
		</s:fill.over>
		<s:filters.over>
			<s:DropShadowFilter includeIn="over" blurX="2" blurY="2" distance="1" hideObject="false" color="0x000000" inner="false" strength="1" alpha="0.5" quality="2" knockout="false" angle="90"/>
			
		</s:filters.over>
		
	</s:Rect>
	<s:Rect height="21" includeIn="disabled,downAndSelected,overAndSelected,upAndSelected" radiusX="1" width="21" y="0" visible.disabled="false">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1" color.overAndSelected="#999999" alpha.overAndSelected="1.0" color.downAndSelected="#999999" alpha.downAndSelected="1.0"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter includeIn="downAndSelected" blurX="2" blurY="2" distance="1" hideObject="false" color="0x000000" inner="true" strength="1" alpha="0.75" quality="3" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage smooth="true" source="@Embed('com/adobe/gazuntite/skins/chrome/assets/black_import.png')" x="5" y="3" alpha.disabledAndSelected="0.65">
		<s:filters>
			<s:GlowFilter alpha="1.0" blurX="6.0" blurY="6.0" color="#FFFFFF" color.over="#333333" inner="true" knockout="false" quality="2" strength="6"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:BitmapImage>
</s:Skin>
