<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect height="18" includeIn="down,over,up" radiusX="2" width="18" x="0.5" y="0.5" visible.up="false">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1" color="#727272" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#727272" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
		<s:filters>
		</s:filters>
	</s:Rect>
	<s:BitmapImage smooth="true" source="@Embed('../assets/icons/qi_writenotes_black.png')" x="4" y="4">
		<s:filters>
			<s:GlowFilter alpha="1.0" blurX="10" blurY="10" color="#CCCCCC" includeIn="disabled" inner="true" knockout="false" quality="3" strength="10"/>
			<s:GlowFilter alpha="1.0" blurX="6.0" blurY="6.0" color="#555555" includeIn="up" inner="true" knockout="false" quality="3" strength="6"/>
			<s:DropShadowFilter alpha="0.89" angle="90" blurX="1" blurY="1" color="#666666" distance="1" hideObject="false" includeIn="up" inner="true" knockout="false" quality="3" strength="1"/>
			<s:GlowFilter includeIn="over" blurX="6.0" blurY="6.0" color="#FFFFFF" inner="true" strength="6" alpha="1.0" quality="2" knockout="false"/>
			<s:DropShadowFilter includeIn="over" blurX="1" blurY="1" distance="1" hideObject="false" color="0x000000" inner="false" strength="1" alpha="0.5" quality="3" knockout="false" angle="90"/>
			<s:GlowFilter includeIn="down" blurX="6.0" blurY="6.0" color="#FFFFFF" inner="true" strength="6" alpha="1.0" quality="3" knockout="false"/>
			<s:DropShadowFilter includeIn="down" blurX="1" blurY="1" distance="1" hideObject="false" color="0x000000" inner="false" strength="1" alpha="0.5" quality="3" knockout="false" angle="90"/>
		</s:filters>
	</s:BitmapImage>
	<s:transitions>
		<s:Transition autoReverse="true" fromState="over" toState="up"></s:Transition>
	</s:transitions>
</s:Skin>
