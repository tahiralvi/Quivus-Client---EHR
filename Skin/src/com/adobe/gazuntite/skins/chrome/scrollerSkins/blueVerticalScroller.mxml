<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.VScrollBar")]</fx:Metadata>
	<s:states>
		<s:State name="normal"/>
		<s:State name="disabled"/>
		<s:State name="inactive"/>
	</s:states>
	<s:Button  styleName="trackButtonSkin" y="5" id="track" x="0"  />
	<s:Button toolTip="Scroll"   styleName="thumbButtonSkin"  id="thumb" x="1" y="8" y.normal="12" buttonMode.normal="true"/>
	<s:Button  y="0" id="decrementButton" x="1" buttonMode.normal="true"  styleName="scrollUpDownButtonSkin" />
	<s:Button  styleName="scrollUpDownButtonSkin"  y="{track.height + 5}" id="incrementButton" x="5" buttonMode.normal="true"  rotation="180" />
	
	
	
	

