<?xml version="1.0" encoding="utf-8"?>

<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009" minWidth="112"
			 alpha.disabled="0.5" blendMode="normal" xmlns:mx="library://ns.adobe.com/flex/mx"> 
	
	<fx:Metadata>
		<![CDATA[ 
		/** 
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("spark.components.List")]
		]]>
	</fx:Metadata> 
	
	<s:states>
		<s:State name="normal" />
		<s:State name="disabled" />
	</s:states>
	
	<fx:Declarations>
		<!--- 
		Defines the appearance of the the List's drop indicator.
		To customize the drop indicator appearance, create a custom ListSkin class.
		The List's layout takes care to size and position the dropIndicator.
		The size of the <code>dropIndicator</code> is typically set to the size of the gaps between the items.
		The minimum and maximum settings are typically respected only in the direction
		along the major axis (the gap axis).  For example a VerticalLayout ignores the 
		<code>minWidth</code> and <code>maxWidth</code> settings, 
		but respect <code>minHeight</code> and <code>maxHeight</code>. 
		
		@copy spark.components.List#dropIndicator
		-->
		<fx:Component id="dropIndicator">
			<s:Group minWidth="1" minHeight="1" maxWidth="2" maxHeight="2">
				<s:Rect left="0" right="0" top="0" bottom="0">
					<s:fill>
						<!--- Defines the color of the background. -->
						<s:SolidColor color="0xffffff" />
					</s:fill>
					<s:stroke>
						<s:SolidColorStroke color="0x999999" weight="1"/>
					</s:stroke>
				</s:Rect>
			</s:Group>
		</fx:Component>
	</fx:Declarations>
	
	<!-- border -->
	
	<!--<s:Rect left="0" right="0" top="0" bottom="0" id="border">
	<s:stroke>
	
	<s:SolidColorStroke id="borderStroke" weight="1"/>
	</s:stroke>
	</s:Rect>-->
	
	<!-- fill -->
	<!--- Defines the background appearance of the list-based component. -->
	
	
	
	<s:Rect width="100%" height="100%" id="background" left="1" right="1" top="1" bottom="1" alpha="1" >
		<s:fill>
			
			<s:SolidColor id="bgFill" color="0xffffff" />
		</s:fill>
	</s:Rect>
	<!--<mx:Image source="@Embed('com/adobe/gazuntite/view/controls/skins/assets/mainContainer.swf', symbol='btn_contact')" />
	-->
	
	<!--- The Scroller component to add scroll bars to the list. -->
	<s:Scroller width="100%" height="100%" left="0" top="0" right="0" bottom="0" id="scroller" minViewportInset="1" hasFocusableChildren="false"
				horizontalScrollPolicy="off" skinClass="com.adobe.gazuntite.skins.chrome.scrollerSkins.listScrolller" >
	
		<!--skinClass="com.adobe.Quivus.view.controls.skins.ScrollBarSkins.buttonsScroller_grey"-->
		<!--skinClass="com.adobe.Quivus.view.controls.skins.ScrollBarSkins.ScrollBlues">-->
		<!--skinClass="com.adobe.Quivus.view.controls.skins.ScrollblueSkin"-->
		<!--- @copy spark.components.SkinnableDataContainer#dataGroup -->
		<s:DataGroup width="100%" id="dataGroup" itemRenderer="spark.skins.spark.DefaultItemRenderer">
			<s:layout>
				<!--- The default layout is vertical and measures at least for 5 rows.  
				When switching to a different layout, HorizontalLayout for example,
				make sure to adjust the minWidth, minHeihgt sizes of the skin -->
				<s:VerticalLayout verticalAlign="middle" horizontalAlign="contentJustify" requestedMinRowCount="5" 
								  paddingLeft="0" paddingRight="0"/>
			</s:layout>			
		</s:DataGroup>		
	</s:Scroller>
	
</s:SparkSkin>
