<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009" minWidth="21" minHeight="21" alpha.disabled="0.5">
	
	<!-- host component -->
	<fx:Metadata>
		<![CDATA[ 
		/** 
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("spark.components.Button")]
		]]>
	</fx:Metadata>
	
	<!-- states -->
	<s:states>
		<s:State name="up" />
		<s:State name="over" />
		<s:State name="down" />
		<s:State name="disabled" />
	</s:states>
	
	<!-- layer 1: shadow -->
	<!--- @private -->
	<s:Rect alpha="1" height="20" radiusX="2" width="88" >
		
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#454B54" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#2B323B" ratio="0.47843137254901963"/>
				<s:GradientEntry alpha="1.0" color="#363E46" ratio="0.47843137254901963"/>
				<s:GradientEntry alpha="1.0" color="#6D7278" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:fill.over>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#F4CF85" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#EFA74E" ratio="0.5137254901960784"/>
				<s:GradientEntry alpha="1.0" color="#EC923A" ratio="0.5176470588235295"/>
				<s:GradientEntry alpha="1.0" color="#F1983B" ratio="1"/>
			</s:LinearGradient>
		</s:fill.over>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<!-- layer 8: text -->
	<!--- @copy spark.components.supportClasses.ButtonBase#labelDisplay -->
	<s:Label id="labelDisplay" width="100%"
			 textAlign="center" color="#ffffff"
			 verticalAlign="middle"
			 maxDisplayedLines="1" fontFamily="Calibri"
			 horizontalCenter="0" verticalCenter="1"
			 left="10" right="10" top="2" bottom="2">
	</s:Label>
	
</s:SparkSkin>
