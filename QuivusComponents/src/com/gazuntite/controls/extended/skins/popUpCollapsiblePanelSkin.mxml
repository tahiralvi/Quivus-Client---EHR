<?xml version="1.0" encoding="utf-8"?>


<!--- The skin class for a CollapsiblePanel based on default Spark Panel skin.  -->
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
			 alpha.disabled="0.5" blendMode="normal"
			 >
	
	<fx:Metadata>
		<![CDATA[ 
		/** 
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("com.gazuntite.controls.extended.components.CollapsiblePanel")]
		]]>
	</fx:Metadata> 

	<fx:Script>
		<![CDATA[

			
			protected function titleBarGroup_mouseOverHandler(event:MouseEvent):void
			{
			/* 	id_rect.fill = id_overcolor; */
			}
			


			protected function titleBarGroup_mouseOutHandler(event:MouseEvent):void
			{
				/* id_rect.fill = id_downcolor; */
			}

		]]>
	</fx:Script>

	
	<fx:Declarations>
		<s:Power id="collapseEaser" easeInFraction="1" />
		<s:Power id="uncollapseEaser" easeInFraction="0" />
	</fx:Declarations>
	
	
	<s:states>
		<s:State name="normal" />
		<s:State name="normalWithControlBar" />
		<s:State name="collapsed" />
		<s:State name="disabled" />
		<s:State name="disabledWithControlBar" />
	</s:states>
	<fx:Declarations>
			<s:LinearGradient  id="id_downcolor" rotation="90">
				<s:GradientEntry alpha="1.0" color="#D3D3D3" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#A1A1A1" ratio="1"/>
			</s:LinearGradient>
		<!--<s:LinearGradient id="id_downcolor"  rotation="90">
			<s:GradientEntry alpha="1" color="#999999" ratio="0"/>
			<s:GradientEntry alpha="1.0" color="#999999" ratio="1"/>
		</s:LinearGradient>-->
		
		<s:LinearGradient id="id_overcolor"  rotation="90">
				<s:GradientEntry alpha="1.0" color="#AFD1FF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#6593D5" ratio="1"/>
		</s:LinearGradient>
		
		<s:LinearGradient id="id_outcolor"  rotation="90">
			<s:GradientEntry alpha="1" color="0x999999" ratio="0"/>
			<s:GradientEntry alpha="1.0" color="0x999999" ratio="1"/>
		</s:LinearGradient>
	</fx:Declarations>
	<s:transitions>
		<s:Transition fromState="normal" toState="collapsed">
			<s:Sequence>
				<s:Fade target="{contentGroup}" duration="250" />
				<s:Parallel targets="{[titleBarGroup, this]}" >
					<s:Rotate target="{titleBarGroup}" duration="250" />
					<s:Resize target="{this}" duration="250" easer="{collapseEaser}" />
				</s:Parallel>
			</s:Sequence>
		</s:Transition>
		<s:Transition fromState="collapsed" toState="normal">
			<s:Sequence>
				<s:Parallel targets="{[titleBarGroup, this]}" >
					<s:Rotate target="{titleBarGroup}" duration="250" />
					<s:Resize target="{this}" duration="250" easer="{uncollapseEaser}" />
				</s:Parallel>
				<s:Fade target="{contentGroup}" duration="250" />
			</s:Sequence>
		</s:Transition>
	</s:transitions>
	
	<!-- drop shadow -->
	<!--<s:RectangularDropShadow id="shadow" blurX="20" blurY="20" alpha="0.32" distance="11" 
							 angle="90" color="#000000" left="0" top="0" right="0" bottom="0"/>
	-->
	<!-- layer 2: background fill -->
	<!--- Defines the appearance of the PanelSkin class's background. -->
	<s:Rect id="background"  alpha="1"  height="0"  left="1" right="1" top="1"  bottom="1" >
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="#6B7E89" distance="2" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#999999" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1" color="#FFFFFF" ratio="0.49019607843137253"/>
				<s:GradientEntry alpha="1.0" color="#E0E0E0" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	
	<!-- title bar (not a skin part) -->
	<s:Group id="titleBarGroup" left="0" top="0" right="0" bottom="0" buttonMode="true" useHandCursor="true" 
			 maxHeight="22" rotation.collapsed="0" click="hostComponent.collapsed = !hostComponent.collapsed"
			 mouseOut="titleBarGroup_mouseOutHandler(event)"
			 mouseOver="titleBarGroup_mouseOverHandler(event)"	
			 >
		<!--mouseOver="titleBarGroup_mouseOverHandler(event)"
		mouseOut="titleBarGroup_mouseOutHandler(event)"-->
		
		<!-- layer 3: title bar fill -->
		<!--<s:Rect id="id_rect" left="1" right="1" top="1" height="21">
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#D4D4D4" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
				<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
			</s:filters>
		</s:Rect>-->
		<s:Path includeIn="normal,collapsed" data="M 278 0 L 4 0 C 1.791 0 0 1.791 0 4 L 0 21 L 282 21 L 282 4 C 282 1.791 280.209 0 278 0 Z" height="20" id="path1"  width="100%" winding="nonZero" x="2" y="2">
			<s:fill>
				<s:LinearGradient rotation="90" scaleX="17.946" x="120.5" y="0">
					<s:GradientEntry color="#99AAB4" ratio="0"/>
					<s:GradientEntry color="#8599A4" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
		</s:Path>
		
		
		<!-- layer 4: title bar highlight -->
		<s:Rect left="1" right="1" top="1" height="20" alpha="0">
			<s:stroke>
				<s:LinearGradientStroke rotation="90" weight="1">
					<s:GradientEntry color="0xEAEAEA" />
					<s:GradientEntry color="0xD9D9D9" />
				</s:LinearGradientStroke>
			</s:stroke>
		</s:Rect>
		<!--<s:Rect left="1" right="1" top="31" height="1">
			<s:fill>
				<s:SolidColor color="0xC0C0C0" />
			</s:fill>
		</s:Rect>-->
		
		<!-- layer 5: text -->
		<!--- Defines the appearance of the PanelSkin class's title bar. -->
		<s:Label id="titleDisplay" lineBreak="explicit" typographicCase.normal = "uppercase"
					  left="10" right="30" top="2" height="20"
					  verticalAlign="middle" fontFamily="Calibri Bold" color="#000000">
		</s:Label>
		
		<!-- TODO: Custom skin for collapse button should be created with some fancy arrow or cross -->
		<!--<s:Button id="collapseButton" width="16" height="16" top="7" right="7"
			label="-" label.collapsed="+" toolTip="Collapse" toolTip.collapsed="Open" />-->
		
		<!--<s:ToggleButton id="id_ChangeIndicator"  visible="{hostComponent.hasChange}"   includeInLayout="{id_ChangeIndicator.visible}"
						right="30" width ="20"/>-->
		<s:ToggleButton id="collapseExpandButton"  buttonMode="true" useHandCursor="true"  styleName="greyExpandButtonSkin"  width="19" height="16" 
						toolTip="{collapseExpandButton.selected ? 'Expand' : 'Collapse '}" selected=" {hostComponent.collapsed}"
						 right="10" />
		<!--<s:Button id="collapseButton"  styleName="greyExpandButtonSkin"  
						width="19" height="16"	buttonMode="true" useHandCursor="true" toolTip="Collapse" toolTip.collapsed="Open" right="10"/>
		-->
	</s:Group>
	
	<!-- layer 1: border -->
	<!--<s:Rect left="0" right="0" top="0" bottom="0">
		<s:stroke>
			<s:SolidColorStroke color="0" alpha="0.50" weight="1" />
		</s:stroke>
	</s:Rect>-->
	
	<!--
	Note: setting the minimum size to 0 here so that changes to the host component's
	size will not be thwarted by this skin part's minimum size.   This is a compromise,
	more about it here: http://bugs.adobe.com/jira/browse/SDK-21143
	-->
	<s:Group id="contentGroup" left="1" right="1" top="22" bottom="1" minWidth="0" minHeight="0" 
			 visible.collapsed="false" excludeFrom="collapsed">
	</s:Group>
	
</s:SparkSkin>
