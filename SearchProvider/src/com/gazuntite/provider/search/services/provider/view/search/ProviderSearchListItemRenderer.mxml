	<s:Path data="M 0 0 L 0 20 L 139.692 20 L 145.818 10 L 139.692 0" width="100%" includeIn="selected" winding="nonZero" height="19">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#FFD2BE" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FFB4A0" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="3" blurY="3" color="0x000000" distance="0" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Path>
