<?xml version="1.0" encoding="utf-8"?>
<s:NavigatorContent xmlns:fx="http://ns.adobe.com/mxml/2009"  
					xmlns:s="library://ns.adobe.com/flex/spark" 
					xmlns:mx="library://ns.adobe.com/flex/mx" 
					width="100%" height="100%"
					>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:HorizontalLayout  paddingBottom="10" paddingTop="10" paddingLeft="5" paddingRight="5"/>
	</s:layout>
	
	<fx:Script>
		<![CDATA[
			import com.adobe.gazuntite.skins.chrome.scrollerSkins.purpleScroller;
			import com.adobe.gazuntite.skins.chrome.scrollerSkins.slimWhiteScroller;
			import com.adobe.gazuntite.skins.chrome.scrollerSkins.whiteScroller;
			
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			
			[Bindable]
			private var currentDocument:File
			
			public function LoadDocument(file:File):void
			{
				try
				{
					currentDocument = file;
					id_htmlArea.location=currentDocument.url;
				}
				catch(error:Error)
				{
					trace( error.errorID, error.name, error.message );
					cursorManager.removeBusyCursor();
				}
			}
			
			private function DocumentLoadingComplete(e:Event):void
			{
				try
				{
					label   = currentDocument.name.substring(0,10) + "...";
					toolTip = currentDocument.name ;
					
				}
				catch(e:Error)
				{
					trace( "error loading document" );
				}
			}
			
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here
		skinClass="com.adobe.Quivus.view.controls.skins.CustomWindowSkin"
		-->
	</fx:Declarations>
	
		
	
	<s:Scroller width="100%" height="100%" skinClass="com.adobe.gazuntite.skins.chrome.scrollerSkins.slimWhiteScroller">
		<s:Group width="100%" height="100%">
			<mx:HTML id="id_htmlArea" width="100%" height="100%" location="{currentDocument.url}" 
					 complete="DocumentLoadingComplete(event)" contentBackgroundAlpha="0"   />
			
		</s:Group>
		
	</s:Scroller>
	
</s:NavigatorContent>
