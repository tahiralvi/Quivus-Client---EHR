<?xml version="1.0" encoding="utf-8"?>
<components1:CollapsiblePanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
							 xmlns:s="library://ns.adobe.com/flex/spark" 
							 xmlns:mx="library://ns.adobe.com/flex/mx" 
							 title="Health Hx" 
							 xmlns:registeration="com.adobe.Quivus.view.controls.registeration.*" 
							 creationComplete="collapsiblepanel1_creationCompleteHandler(event)"
							 hasChange="{model.healthHX.PatientMedicalHistoryDTOList.length>0 ?true:false ||
							 model.healthHX.PatientFamilyHistoryDTOList.length>0 ?true:false || (model.patientDTO.AlcoholStatus.length >0 ?true:false || 
							 model.patientDTO.DrugStatus.length >0 ?true:false ||model.patientDTO.SmokingStatus.length >0 ?true:false)}"
							 xmlns:components1="com.gazuntite.controls.extended.components.*">
	<components1:layout>
		<s:VerticalLayout gap="3" paddingBottom="8" paddingLeft="8" paddingRight="8" paddingTop="8"/>
	</components1:layout>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.DTOInitializationUtility;
			
			import mx.events.FlexEvent;
			import mx.events.IndexChangedEvent;
			
			import spark.events.IndexChangeEvent;
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			private var isEditMode:Boolean;
			
			protected function collapsiblepanel1_creationCompleteHandler(event:FlexEvent):void
			{
				DTOInitializationUtility.InitializeHealthInfoDTO();
			}
			
			public function isInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				var errorStr:String = "";
				var toSetFocus:*;
				
				if (id_SocialHistory.isInvalid())
					isNotValid = true;
				
				return isNotValid;
			}
			
			public function loadDataHealthHX():void
			{
				try
				{
					id_Allergies.loadAllergiesData();
					id_FamilyHistory.loadFamilyHistoryData();
					id_MedicalProblems.loadMedicalProblemData();
					id_SocialHistory.loadSocialHistoryData();
					isEditMode = true;
				}
				catch(e:Error)
				{
					trace ( "HealthHx::loadDataEPP", e.message );
				}
			}
			
			public function clearForm():void
			{
				if (id_Allergies)
					id_Allergies.resetFields();
				
				if (id_MedicalProblems)
					id_MedicalProblems.resetFields();
				
				if (id_FamilyHistory)
					id_FamilyHistory.resetFields();
				
				if (id_SocialHistory)
					id_SocialHistory.clearForm();
				
				DTOInitializationUtility.InitializeHealthInfoDTO();
			}
			public function clearFormRecord():void
			{
				if (id_Allergies)
					id_Allergies.clearForm();
				
				if (id_MedicalProblems)
					id_MedicalProblems.clearForm();
				
				if (id_FamilyHistory)
					id_FamilyHistory.clearForm();
				
				if (id_SocialHistory)
					id_SocialHistory.clearForm();
				
				DTOInitializationUtility.InitializeHealthInfoDTO();
			}
			
		]]>
	</fx:Script>
	<registeration:Allergies id="id_Allergies" width="100%"  />
	<registeration:MedicalProblems id="id_MedicalProblems" width="100%"/>
	<registeration:FamilyHistory id="id_FamilyHistory" width="100%"  />
	<registeration:SocialHistory id="id_SocialHistory" width="100%"  hasFocusableChildren="true" />
</components1:CollapsiblePanel>
