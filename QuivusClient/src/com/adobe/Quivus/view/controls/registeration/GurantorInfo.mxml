			private function getPhoneNo(item:Object,column:DataGridColumn):String
			{
				var add:String = "";
				if(!item.AddressBook)
					return '';
				if(!item.AddressBook.PhoneDTOlist)
					return '';
				
				if(item.AddressBook.PhoneDTOlist.length > 0)
				{
					for(var i:uint=0; i<item.AddressBook.PhoneDTOlist.length; i++)
					{
						var adDTO:PhoneDTO = item.AddressBook.PhoneDTOlist[i] as PhoneDTO;
						add                  = ValidationUtils.setPhoneNumberMasking(adDTO.PhoneNumber);
						break;
					}
				}
				
				return add;
			}
			private function getPhoneType(item:Object,column:DataGridColumn):String
			{
				var add:String = "";
				if(!item.AddressBook)
					return '';
				if(!item.AddressBook.PhoneDTOlist)
					return '';
				
				if(item.AddressBook.PhoneDTOlist.length > 0)
				{
					for(var i:uint=0; i<item.AddressBook.PhoneDTOlist.length; i++)
					{
						var adDTO:PhoneDTO = item.AddressBook.PhoneDTOlist[i] as PhoneDTO;
						add                  = adDTO.NumberTypeName;
						break;
					}
				}
				
				return add;
			}
			private function getPhoneExt(item:Object,column:DataGridColumn):String
			{
				var add:String = "";
				if(!item.AddressBook)
					return '';
				if(!item.AddressBook.PhoneDTOlist)
					return '';
				
				if(item.AddressBook.PhoneDTOlist.length > 0)
				{
					for(var i:uint=0; i<item.AddressBook.PhoneDTOlist.length; i++)
					{
						var adDTO:PhoneDTO = item.AddressBook.PhoneDTOlist[i] as PhoneDTO;
						add                  = adDTO.Extension;
						break;
					}
				}
				
				return add;
			}
			
			protected function id_FName_changeHandler(event:TextOperationEvent):void
			{
				// TODO Auto-generated method stub
				if(id_FName.text.length > 0)					
				{
					enableDisableFields(true);
				}
				else
				{
					
					enableDisableFields(false);
				}
			}
			
			public function enableDisableFields(value:Boolean):void
			{
				id_DOB.enabled 								= value;
				id_Gender.enabled 							= value;
				id_ZipCityStateCombine.id_City.enabled		= value;
				id_ZipCityStateCombine.id_ZIP.enabled		= value;					
				id_ZipCityStateCombine.id_State.enabled 	= value;
				id_LName.enabled 							= value;					
				id_Address.enabled 							= value;					
				id_PhoneNumberAddMore.enabled 				= value;					
				id_Relation.enabled 						= value;					
				id_addGBtn.enabled							= value;
			}
			
			//Tahir Alvi - apply masking on the phone number at load time
			public function setPhoneNumberMasking(val:String):String
			{
				var val_Format:String = '(' + val.substring(0,3) + ')' + val.substring(3,6) + '-' + val.substring(6,10);
				return val_Format;
			}
			
		]]>
	</fx:Script>
	
	<s:CheckBox id="id_Self" 
				label="Self as Guarantor" selected="false" click="setSelfGurantor()" toolTip="Select for Self as Guarantor"/>
	<s:HGroup width="100%" >
		<s:VGroup width="33%" >
			<components3:LabelTextInput id="id_FName"
									   width="100%"  prompt="First Name" fontFamily="Calibri" fontSize="11" tabIndex="1" restrict="[A-Z a-z , . 0-9]" maxChars="100" 
									   toolTip="Enter first name" change="id_FName_changeHandler(event)" required="true"/>
			<s:HGroup width="100%">
				<components3:LabelMaskDate id="id_DOB" width="55%" tabIndex="4" />
				<components3:LabelComboBox id="id_Gender" 
										  prompt="Gender" width="45%" toolTip="Select gender"
										  dataProvider="{model.registrationStaticDataDTO.GenderTypes}" 
										  labelField="GenderName" autoWidth="false"
										  fontFamily="Calibri" fontSize="11"  tabIndex="5"/>
			</s:HGroup>	
			<s:HGroup width="100%">
				<components2:ZipCityStateCombine id="id_ZipCityStateCombine" width="100%" tabIndex="7"/>
			</s:HGroup>
		</s:VGroup>
		<s:VGroup width="43%">
			<components3:LabelTextInput id="id_LName" 
									   prompt="Last Name" width="100%"  restrict="[A-Z a-z , . 0-9]" maxChars="50" toolTip="Enter last name"
									   fontFamily="Calibri" fontSize="11" paddingTop="6" paddingBottom="6" paddingLeft="3" paddingRight="3"  tabIndex="2"/>
			<components3:LabelTextInput id="id_Address" 
									   prompt="Address" width="100%"   maxChars="200" toolTip="Enter Address"
									   fontFamily="Calibri" fontSize="11"  tabIndex="6" paddingTop="6" paddingBottom="6" paddingLeft="3" paddingRight="3" />
			<s:HGroup width="100%" >
				<registeration:PhoneNumberAddMore id="id_PhoneNumberAddMore" width="100%" tabIndex="10"/>
			</s:HGroup>
		</s:VGroup>
		<s:VGroup width="23%" >
			<components3:LabelComboBox id="id_Relation" 
									  prompt="Relation" width="100%" autoWidth="false" toolTip="Select relation"
									  dataProvider="{model.registrationStaticDataDTO.RelationshipTypes}" 
									  labelField="RelationshipName"  tabIndex="3" required="true"/>
			
			
			<s:HGroup width="100%" verticalAlign="bottom">
				<s:HGroup width="35%"  verticalAlign="bottom">
					<s:Button id="id_addGBtn" 
							  click="addGurantor()"  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.AddMoreTooltipBtn"
							  buttonMode="true" useHandCursor="true" toolTip="Add Gurantor" tabIndex="13"  label="Add Gurantor" />
					
				</s:HGroup>	
			</s:HGroup>
		</s:VGroup>
	</s:HGroup>
	<components3:LabelDataGrid id="id_GuarantorGrid" 
							  width="100%"
							  visible="false"  includeInLayout="{id_GuarantorGrid.visible}"
							  rowCount="{id_GuarantorGrid.dataProvider.length+1}"
							  editable="false" sortableColumns="false" 
							  columnWidths="{['10%','10%','8%','8%','10%','7%','7%','7%','7%','7%','5%','5%',15]}">
		<components3:columns>
			<mx:DataGridColumn headerText="First Name" dataField="GurantorFirstName" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Last Name" dataField="GuarantorLastName" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Relation" dataField="RelationshipType.RelationshipName" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="DOB" dataField="DOB" labelFunction="getDate" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Gender" dataField="GenderType.GenderName" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Address" dataField="AddressBook.AddressDTO.StreetName" labelFunction="getAddress" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="State" dataField="AddressBookDTO.AddressDTO.StateName" labelFunction="getState" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="City" dataField="AddressBookDTO.AddressDTO.CityName" labelFunction="getCity" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Zip" dataField="AddressBookDTO.AddressDTO.ZipCodeID" labelFunction="getZip" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="PhoneNumber" dataField="AddressBookDTO.PhoneDTO.PhoneNumber" labelFunction="getPhoneNo" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Ext" dataField="AddressBookDTO.PhoneDTO.Extension" labelFunction="getPhoneExt" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Phone Type" dataField="AddressBookDTO.PhoneDTO.NumberTypeName" labelFunction="getPhoneType" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn itemRenderer="com.adobe.Quivus.view.controls.registeration.DeleteRecordRendererOnly" />
		</components3:columns>
	</components3:LabelDataGrid>
</components3:CollapsiblePanel>
