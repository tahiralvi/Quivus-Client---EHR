<?xml version="1.0" encoding="utf-8"?>
<s:MXDataGridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
						  xmlns:s="library://ns.adobe.com/flex/spark" 
						  xmlns:mx="library://ns.adobe.com/flex/mx" 
						  focusEnabled="true">
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.commons.DataGridActionsEvent;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.closeButton;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.gridButtons.removeBtn;
			
			private function onDeleteClick(event:MouseEvent):void	
			{
				dispatchEvent(new DataGridActionsEvent(DataGridActionsEvent.DELETE_RECORD_ONLY_CLICK, true));
			}
		]]>
	</fx:Script>
	
	<s:Button id="id_Delete" width="12" height="12" click="onDeleteClick(event)"
			  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.gridButtons.removeBtn"
			  buttonMode="true" toolTip="Click to Delete record"/>
</s:MXDataGridItemRenderer>
