			public function getEDIInformation():void 
			{				
				if(id_AssignmentIndicator.selectedIndex!=-1)				
					model.patientDTO.AcceptAssignmentTypeID  = id_AssignmentIndicator.selectedItem.TypeID;				
				else
					model.patientDTO.AcceptAssignmentTypeID = 0;
				
				if(id_delayReason.selectedIndex!=-1)				
					model.patientDTO.DelayReasonCodeTypeID  = id_delayReason.selectedItem.TypeID;
				else
					model.patientDTO.DelayReasonCodeTypeID = 0;
				
				if(id_secType.selectedIndex!=-1)				
					model.patientDTO.CMSSecondaryTypeID  = id_secType.selectedItem.TypeID;
				else
					model.patientDTO.CMSSecondaryTypeID = 0;
				
				if(id_excpCode.selectedIndex!=-1)
					model.patientDTO.ExceptionCodeTypeID  = id_excpCode.selectedItem.TypeID;
				else
					model.patientDTO.ExceptionCodeTypeID = 0;
				
				model.patientDTO.IDENumber = id_IDENumber.text;
				model.patientDTO.ReferralNumber = id_ReferralNumber.text;
				model.patientDTO.PriorAuthorizationNumber = id_PANumber.text;
				
				model.patientDTO.Emergency = id_emergency.selected; 
				model.patientDTO.SignatureOnFile = id_signature.selected; 
				if(model.isPatientFemale)
					model.patientDTO.PregnancyIndicator = id_preg.selected; 
				else
					model.patientDTO.PregnancyIndicator = false;
				
				model.patientDTO.EPSDT = id_epsdt.selected; 
				model.patientDTO.FamilyPlanning = id_family.selected; 
				
				if(id_expiryDate.selectedDate!=null)
					model.patientDTO.ExpiryDate = UtilityFunctions.FormatDate(id_expiryDate.selectedDate);
				else
					model.patientDTO.ExpiryDate = null;
				
				if(id_signDate.selectedDate!=null)
					model.patientDTO.SignatureDate = UtilityFunctions.FormatDate(id_signDate.selectedDate);
				else
					model.patientDTO.SignatureDate = null;
				
				if(id_seenDate.selectedDate!=null)
					model.patientDTO.LastSeenDate = UtilityFunctions.FormatDate(id_seenDate.selectedDate);
				else
					model.patientDTO.LastSeenDate = null;
				
				if(id_illnessDate.selectedDate!=null)
					model.patientDTO.IllnessDate = UtilityFunctions.FormatDate(id_illnessDate.selectedDate);
				else
					model.patientDTO.IllnessDate = null;
				
				if(id_xrayDate.selectedDate!=null)
					model.patientDTO.LastXRayDate = UtilityFunctions.FormatDate(id_xrayDate.selectedDate);
				else
					model.patientDTO.LastXRayDate = null;
				
				if(id_workDate.selectedDate!=null)
					model.patientDTO.LastWorkedDate = UtilityFunctions.FormatDate(id_workDate.selectedDate);
				else
					model.patientDTO.LastWorkedDate = null;
				
				if(id_admissionDate.selectedDate!=null)
					model.patientDTO.AdmissionDate = UtilityFunctions.FormatDate(id_admissionDate.selectedDate);
				else
					model.patientDTO.AdmissionDate = null
				
				if(id_dischargeDate.selectedDate!=null)
					model.patientDTO.DischargeDate = UtilityFunctions.FormatDate(id_dischargeDate.selectedDate);	
				else
					model.patientDTO.DischargeDate = null;
				
			}
			
