			private function filterDeletedItems(item:Object):Boolean
			{
				var b:Boolean = item["IsDeleted"];
				return (!b);
			}
			
			public function clearEDIInformation():void 
			{	
				id_AssignmentIndicator.selectedIndex	= -1;
				id_delayReason.selectedIndex			= -1;
				id_secType.selectedIndex				= -1;
				id_excpCode.selectedIndex				= -1;
				id_admissionDate.text					= "";
				id_dischargeDate.text					= "";
				id_emergency.selected					= false;
				id_epsdt.selected						= false;
				id_family.selected						= false;
				id_signature.selected					= false;
				id_preg.selected						= false;
				id_IDENumber.text						= "";
				id_PANumber.text						= "";
				id_ReferralNumber.text					= "";
				id_seenDate.text						= "";
				id_signDate.text						= "";
				id_workDate.text						= "";
				id_xrayDate.text						= "";
				id_illnessDate.text						= "";
				
				hasChange = false;
			}
			
			public function isInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				var errorStr:String = "";
				var toSetFocus:*;
				ValidationUtils.Trim(id_IDENumber);
				ValidationUtils.Trim(id_ReferralNumber);
				ValidationUtils.Trim( id_PANumber );
								
				if (id_illnessDate.selectedDate != null && !ValidationUtils.isValidDateString(id_illnessDate.text))
				{
					isNotValid = true;
					errorStr += "The data in Current Illness/LMP Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_illnessDate;
				}
				else if(id_illnessDate.text != id_illnessDate.prompt && UtilityFunctions.IsNotNullOrEmpty(id_illnessDate.text) && !ValidationUtils.isValidDateString(id_illnessDate.text))
				{
					isNotValid = true;
					errorStr += "The data in Current Illness/LMP Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_illnessDate;
				}
				
				if (id_seenDate.selectedDate != null && !ValidationUtils.isValidDate(id_seenDate))
				{
					isNotValid = true;
					errorStr += "The data in Last Seen Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_seenDate;
				}
				else if(id_seenDate.text != id_seenDate.prompt && UtilityFunctions.IsNotNullOrEmpty(id_seenDate.text) && !ValidationUtils.isValidDateString(id_seenDate.text))
				{
					isNotValid = true;
					errorStr += "The data in Last Seen Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_illnessDate;
				}
				
				if (id_xrayDate.selectedDate != null && !ValidationUtils.isValidDate(id_xrayDate))
				{
					isNotValid = true;
					errorStr += "The data in Last X-Ray Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_xrayDate;
				}
				else if(id_xrayDate.text != id_xrayDate.prompt && UtilityFunctions.IsNotNullOrEmpty(id_xrayDate.text) && !ValidationUtils.isValidDateString(id_xrayDate.text))
				{
					isNotValid = true;
					errorStr += "The data in Last X-Ray Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_xrayDate;
				}
				
				if (id_workDate.selectedDate != null && !ValidationUtils.isValidDate(id_workDate))
				{
					isNotValid = true;
					errorStr += "The data in Last worked Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_workDate;
				}
				else if(id_workDate.text != id_workDate.prompt && UtilityFunctions.IsNotNullOrEmpty(id_workDate.text) && !ValidationUtils.isValidDateString(id_workDate.text))
				{
					isNotValid = true;
					errorStr += "The data in Last worked Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_workDate;
				}
				
				
				if (id_admissionDate.selectedDate != null && !ValidationUtils.isValidDate(id_admissionDate))
				{
					isNotValid = true;
					errorStr += "The data in Admission Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_admissionDate;
				}
				else if(id_admissionDate.text != id_admissionDate.prompt && UtilityFunctions.IsNotNullOrEmpty(id_admissionDate.text) && !ValidationUtils.isValidDateString(id_admissionDate.text))
				{
					isNotValid = true;
					errorStr += "The data in Admission Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_admissionDate;
				}
				
				if (id_admissionDate.selectedDate == null && id_dischargeDate.selectedDate != null )
				{
					isNotValid = true;
					errorStr += "Discharge Date is selected but Admission Date is missing.\n";
					
					if (!toSetFocus)
						toSetFocus = id_admissionDate;
				}
				
				
				if (id_dischargeDate.selectedDate != null && !ValidationUtils.isValidDate(id_dischargeDate))
				{
					isNotValid = true;
					errorStr += "The data in Discharge Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_dischargeDate;
				}
				else if(id_dischargeDate.text != id_dischargeDate.prompt && UtilityFunctions.IsNotNullOrEmpty(id_dischargeDate.text) && !ValidationUtils.isValidDateString(id_dischargeDate.text))
				{
					isNotValid = true;
					errorStr += "The data in Discharge Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_dischargeDate;
				}
				
				if (id_admissionDate.selectedDate != null && id_dischargeDate.selectedDate != null && !ValidationUtils.isValidDateRange(id_admissionDate.selectedDate,id_dischargeDate.selectedDate))
				{
					isNotValid = true;
					errorStr += "Discharge Date should be equal or later than Admission Date.\n";
					
					if (!toSetFocus)
						toSetFocus = id_admissionDate;
				}
				
				if (id_expiryDate.selectedDate != null && !ValidationUtils.isValidDate(id_expiryDate))
				{
					isNotValid = true;
					errorStr += "The data in Expiry Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_expiryDate;
				}
				else if(id_expiryDate.text != id_expiryDate.prompt && UtilityFunctions.IsNotNullOrEmpty(id_expiryDate.text) && !ValidationUtils.isValidDateString(id_expiryDate.text))
				{
					isNotValid = true;
					errorStr += "The data in Expiry Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_expiryDate;
				}
				
				if (id_admissionDate.selectedDate != null && id_expiryDate.selectedDate != null && !ValidationUtils.isValidDateRange(id_admissionDate.selectedDate,id_expiryDate.selectedDate))
				{
					isNotValid = true;
					errorStr += "Expiray Date should be equal or later than Admission Date.\n";
					
					if (!toSetFocus)
						toSetFocus = id_expiryDate;
				}
				
				if (id_signature.selected == true && id_signDate.selectedDate == null  )
				{
					isNotValid = true;
					errorStr += "Signature On File is selected, please select Signature Date.\n";
					
					if (!toSetFocus)
						toSetFocus = id_signDate;
				}
				
				if (id_signDate.selectedDate != null && !ValidationUtils.isValidDate(id_signDate))
				{
					isNotValid = true;
					errorStr += "The data in Signature Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_signDate;
				}
				else if(id_signDate.text != id_signDate.prompt && UtilityFunctions.IsNotNullOrEmpty(id_signDate.text) && !ValidationUtils.isValidDateString(id_signDate.text))
				{
					isNotValid = true;
					errorStr += "The data in Signature Date is invalid, valid format is [MM/DD/YYYY].\n";
					
					if (!toSetFocus)
						toSetFocus = id_signDate;
				}
				
				if (id_AssignmentIndicator.selectedIndex != -1 && !ValidationUtils.isValidValueSelected(id_AssignmentIndicator))
				{
					isNotValid = true;
					errorStr += "Select valid Assignment Indicator.\n";
					if (!toSetFocus)
						toSetFocus = id_AssignmentIndicator;
				}
				
				if (id_delayReason.selectedIndex != -1 && !ValidationUtils.isValidValueSelected(id_delayReason))
				{
					isNotValid = true;
					errorStr += "Select valid Timely Filing Indicator.\n";
					if (!toSetFocus)
						toSetFocus = id_delayReason;
				}
				
				if (id_secType.selectedIndex != -1 && !ValidationUtils.isValidValueSelected(id_secType))
				{
					isNotValid = true;
					errorStr += "Select valid CMS Secondary Type.\n";
					if (!toSetFocus)
						toSetFocus = id_secType;
				}
				
				if (id_excpCode.selectedIndex != -1 && !ValidationUtils.isValidValueSelected(id_excpCode))
				{
					isNotValid = true;
					errorStr += "Select valid Service Authorization Exception Code.\n";
					if (!toSetFocus)
						toSetFocus = id_excpCode;
				}
				
				if (isNotValid)
				{
					Alert.show(errorStr, "Patient Registration Required Fields", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						
						if (toSetFocus)
							toSetFocus.setFocus();
					});
				}
				return isNotValid;
			}
			
