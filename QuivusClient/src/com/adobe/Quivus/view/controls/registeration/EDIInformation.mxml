			public function SetIsDirty():void 
			{				
				if(id_AssignmentIndicator.selectedIndex !=-1 && model.patientDTO.AcceptAssignmentTypeID != id_AssignmentIndicator.selectedItem.TypeID )
				{
					model.patientDTO.IsDirty = true;
					return;
				} 
				if(id_delayReason.selectedIndex !=-1 && model.patientDTO.DelayReasonCodeTypeID != id_delayReason.selectedItem.TypeID )
				{
					model.patientDTO.IsDirty = true;
					return;
				} 
				
				if(id_delayReason.selectedIndex !=-1 && model.patientDTO.DelayReasonCodeTypeID != id_delayReason.selectedItem.TypeID )
				{
					model.patientDTO.IsDirty = true;
					return;
				} 
				
				if(id_secType.selectedIndex !=-1 && model.patientDTO.CMSSecondaryTypeID != id_secType.selectedItem.TypeID )
				{
					model.patientDTO.IsDirty = true;
					return;
				} 
				
				if(id_excpCode.selectedIndex !=-1 && model.patientDTO.ExceptionCodeTypeID != id_excpCode.selectedItem.TypeID )
				{
					model.patientDTO.IsDirty = true;
					return;
				} 
				
				if(id_signature.selected.toString().toLocaleLowerCase() != String(model.patientDTO.SignatureOnFile)  )
				{
					model.patientDTO.IsDirty = true;
					return;
				} 
				
				if(id_preg.selected.toString().toLocaleLowerCase() != String(model.patientDTO.PregnancyIndicator)  )
				{
					model.patientDTO.IsDirty = true;
					return;
				} 
				
				if(id_epsdt.selected.toString().toLocaleLowerCase() != String(model.patientDTO.EPSDT)  )
				{
					model.patientDTO.IsDirty = true;
					return;
				} 
				
				if(id_emergency.selected.toString().toLocaleLowerCase() != String(model.patientDTO.Emergency)  )
				{
					model.patientDTO.IsDirty = true;
					return;
				} 
				
				if(id_family.selected.toString().toLocaleLowerCase() != String(model.patientDTO.FamilyPlanning)  )
				{
					model.patientDTO.IsDirty = true;
					return;
				} 
				
				if( model.patientDTO.IDENumber != id_IDENumber.text || 
					model.patientDTO.ReferralNumber != id_ReferralNumber.text ||
					model.patientDTO.PriorAuthorizationNumber != id_PANumber.text 
				 )
				{
					model.patientDTO.IsDirty = true;
					return;
				}
				
				if( (id_signDate.selectedDate && UtilityFunctions.IsNotNullOrEmpty(model.patientDTO.SignatureDate) ) 
					&& UtilityFunctions.FormatDate(id_signDate.selectedDate,"MM/DD/YYYY") != UtilityFunctions.FormatDate(model.patientDTO.SignatureDate,"MM/DD/YYYY") )
				{
					model.patientDTO.IsDirty = true;
					return;
				}
				
				if( (id_expiryDate.selectedDate && UtilityFunctions.IsNotNullOrEmpty(model.patientDTO.ExpiryDate) ) 
					&& UtilityFunctions.FormatDate(id_expiryDate.selectedDate,"MM/DD/YYYY") != UtilityFunctions.FormatDate(model.patientDTO.ExpiryDate,"MM/DD/YYYY") )
				{
					model.patientDTO.IsDirty = true;
					return;
				}
				
				if( (id_seenDate.selectedDate && UtilityFunctions.IsNotNullOrEmpty(model.patientDTO.LastSeenDate) ) 
					&& UtilityFunctions.FormatDate(id_seenDate.selectedDate,"MM/DD/YYYY") != UtilityFunctions.FormatDate(model.patientDTO.LastSeenDate,"MM/DD/YYYY") )
				{
					model.patientDTO.IsDirty = true;
					return;
				}
				
				if( (id_illnessDate.selectedDate && UtilityFunctions.IsNotNullOrEmpty(model.patientDTO.IllnessDate) ) 
					&& UtilityFunctions.FormatDate(id_illnessDate.selectedDate,"MM/DD/YYYY") != UtilityFunctions.FormatDate(model.patientDTO.IllnessDate,"MM/DD/YYYY") )
				{
					model.patientDTO.IsDirty = true;
					return;
				}
				
				if( (id_xrayDate.selectedDate && UtilityFunctions.IsNotNullOrEmpty(model.patientDTO.LastXRayDate) ) 
					&& UtilityFunctions.FormatDate(id_xrayDate.selectedDate,"MM/DD/YYYY") != UtilityFunctions.FormatDate(model.patientDTO.LastXRayDate,"MM/DD/YYYY") )
				{
					model.patientDTO.IsDirty = true;
					return;
				}
				
				if( (id_workDate.selectedDate && UtilityFunctions.IsNotNullOrEmpty(model.patientDTO.LastWorkedDate) ) 
					&& UtilityFunctions.FormatDate(id_workDate.selectedDate,"MM/DD/YYYY") != UtilityFunctions.FormatDate(model.patientDTO.LastWorkedDate,"MM/DD/YYYY") )
				{
					model.patientDTO.IsDirty = true;
					return;
				}
				
				if( (id_admissionDate.selectedDate && UtilityFunctions.IsNotNullOrEmpty(model.patientDTO.AdmissionDate) ) 
					&& UtilityFunctions.FormatDate(id_admissionDate.selectedDate,"MM/DD/YYYY") != UtilityFunctions.FormatDate(model.patientDTO.AdmissionDate,"MM/DD/YYYY") )
				{
					model.patientDTO.IsDirty = true;
					return;
				}
				
				if( (id_dischargeDate.selectedDate && UtilityFunctions.IsNotNullOrEmpty(model.patientDTO.DischargeDate) ) 
					&& UtilityFunctions.FormatDate(id_dischargeDate.selectedDate,"MM/DD/YYYY") != UtilityFunctions.FormatDate(model.patientDTO.DischargeDate,"MM/DD/YYYY") )
				{
					model.patientDTO.IsDirty = true;
					return;
				}
								
			}
			
			public function loadDataEDIInfo():void
			{
				try
				{
					 if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.AcceptAssignmentTypeID ) )
						selectListItem(id_AssignmentIndicator, model.patientProfileDTO._PatientDTO.AcceptAssignmentTypeID );
					 
					 if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.ExceptionCodeTypeID ) )
						 selectListItem(id_excpCode, model.patientProfileDTO._PatientDTO.ExceptionCodeTypeID );
					 
					 if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.CMSSecondaryTypeID ) )
						 selectListItem(id_secType, model.patientProfileDTO._PatientDTO.CMSSecondaryTypeID );
					 
					 if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.DelayReasonCodeTypeID ) )
						 selectListItem(id_delayReason, model.patientProfileDTO._PatientDTO.DelayReasonCodeTypeID );
					
					if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.IDENumber ) )
						id_IDENumber.text = model.patientProfileDTO._PatientDTO.IDENumber; 	
					
					if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.ReferralNumber ) )
						id_ReferralNumber.text = model.patientProfileDTO._PatientDTO.ReferralNumber; 
					
					if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.PriorAuthorizationNumber ) )
						id_PANumber.text = model.patientProfileDTO._PatientDTO.PriorAuthorizationNumber;
					
					id_emergency.selected = model.patientProfileDTO._PatientDTO.Emergency; 
					id_epsdt.selected = model.patientProfileDTO._PatientDTO.EPSDT; 
					id_family.selected = model.patientProfileDTO._PatientDTO.FamilyPlanning; 
					id_preg.selected = model.patientProfileDTO._PatientDTO.PregnancyIndicator; 
					id_signature.selected = model.patientProfileDTO._PatientDTO.SignatureOnFile; 
					
					if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.ExpiryDate ) )
					{
						id_expiryDate.selectedDate = UtilityFunctions.toDate(model.patientProfileDTO._PatientDTO.ExpiryDate);
						id_expiryDate.text = UtilityFunctions.FormatDate(id_expiryDate.selectedDate,"MM/DD/YYYY");
					}
					
					if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.SignatureDate ) )
					{
						id_signDate.selectedDate = UtilityFunctions.toDate(model.patientProfileDTO._PatientDTO.SignatureDate);
						id_signDate.text = UtilityFunctions.FormatDate(id_signDate.selectedDate,"MM/DD/YYYY");
					}
					
					if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.LastSeenDate ) )
					{
						id_seenDate.selectedDate = UtilityFunctions.toDate(model.patientProfileDTO._PatientDTO.LastSeenDate);
						id_seenDate.text = UtilityFunctions.FormatDate(id_seenDate.selectedDate,"MM/DD/YYYY");
					}
					
					if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.IllnessDate ) )
					{
						id_illnessDate.selectedDate = UtilityFunctions.toDate(model.patientProfileDTO._PatientDTO.IllnessDate);
						id_illnessDate.text = UtilityFunctions.FormatDate(id_illnessDate.selectedDate,"MM/DD/YYYY");
					}
					
					if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.LastXRayDate ) )
					{
						id_xrayDate.selectedDate = UtilityFunctions.toDate(model.patientProfileDTO._PatientDTO.LastXRayDate);
						id_xrayDate.text = UtilityFunctions.FormatDate(id_xrayDate.selectedDate,"MM/DD/YYYY");
					}
					
					if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.LastWorkedDate ) )
					{
						id_workDate.selectedDate = UtilityFunctions.toDate(model.patientProfileDTO._PatientDTO.LastWorkedDate);
						id_workDate.text = UtilityFunctions.FormatDate(id_workDate.selectedDate,"MM/DD/YYYY");
					}
					
					if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.AdmissionDate ) )
					{
						id_admissionDate.selectedDate = UtilityFunctions.toDate(model.patientProfileDTO._PatientDTO.AdmissionDate);
						id_admissionDate.text = UtilityFunctions.FormatDate(id_admissionDate.selectedDate,"MM/DD/YYYY");
					}
					
					if( ! AppUtils.IsNullOrEmpty( model.patientProfileDTO._PatientDTO.DischargeDate ) )
					{
						id_dischargeDate.selectedDate = UtilityFunctions.toDate(model.patientProfileDTO._PatientDTO.DischargeDate);
						id_dischargeDate.text = UtilityFunctions.FormatDate(id_dischargeDate.selectedDate,"MM/DD/YYYY");
					}
				}
				catch(e:Error)
				{
					trace ( "EDIInfo::loadDataEPP", e.message );
				}
			}
			
			private function selectListItem(ddl:LabelComboBox, typeId:int):void
			{
				var list:ArrayCollection = ArrayCollection(ddl.dataProvider);
				var i:int;
				for( i = 0; i < list.length; i++ )
				{					
					if( typeId.toString() == String(list[i].TypeID) )
					{
						ddl.selectedIndex = i; 
						hasChange = true;
						break;
					}
				}
			}
			
