<s:SparkSkin resizeMode="scale" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
    xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabledGroup="0.5" xmlns:mx="library://ns.adobe.com/flex/mx" 
	minHeight="698" minWidth="644"
	>
     
	<fx:Metadata>
		[HostComponent("spark.components.WindowedApplication")]
	</fx:Metadata>

  
    
     <s:states>
        <s:State name="normal" />
        <s:State name="disabled" stateGroups="disabledGroup" />
        <s:State name="normalAndInactive" stateGroups="inactiveGroup" />
        <s:State name="disabledAndInactive" stateGroups="disabledGroup, inactiveGroup" />
    </s:states>

    <!-- layer 1: background fill -->
    <!--- Defines the background color of the skin. -->
	
	<s:Group width="100%" height="{this.height}">
		<!--<s:BitmapImage source="@Embed('com/adobe/Quivus/view/controls/skins/assets/mainContainer.swf', symbol='bg1')"
					   width="{this.width}" height="{this.height}"  />-->
		
		
			
		<s:Path data="M 636.946 0 L 5 0 C 2.238 0 0 2.238 0 5 L 0 727 C 0 729.762 2.238 732 5 732 L 636.946 732 C 639.708 732 641.946 729.762 641.946 727 L 641.946 5 C 641.946 2.238 639.708 0 636.946 0 Z" width="100%" height="{this.height}">
			<s:fill>
				<s:SolidColor color="#373737"/>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter alpha="1" angle="90" blurX="255" blurY="255" color="0x000000" distance="0" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
			</s:filters>
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#333333" joints="miter" miterLimit="4" weight="1"/>
			</s:stroke>
		</s:Path>
			

	
		
	
		
		
		<!--<mx:Image source="@Embed('com/adobe/Quivus/view/controls/skins/assets/mainContainer.swf', symbol='bg1')" />
		
		-->
		</s:Group>
	<s:Group width="{this.width - 5}" x="2.5" y="2.5">
		<s:Path data="M 627 0 L 5 0 C 2.239 0 0 2.239 0 5 L 0 60.855 L 632 60.855 L 632 5 C 632 2.239 629.762 0 627 0 Z" height="60" width="{this.width - 5}">
			<s:fill>
				<s:LinearGradient rotation="90" scaleX="61.239" x="318" y="0">
					<s:GradientEntry alpha="1.0" color="#959595" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#757575" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter alpha="0.15" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
				<s:DropShadowFilter alpha="0.5" angle="90" blurX="4.0" blurY="4.0" color="0x000000" distance="4.0" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
			</s:filters>
		</s:Path>
	</s:Group>
		<!--<s:filters>
			<s:DropShadowFilter alpha="0.6" angle="45" blurX="15" blurY="13" />
		</s:filters>-->
    

    <!-- layer 2: content + status bar -->
    <s:Group left="0" right="0" top="0" bottom="0" minHeight="24" minWidth="0" >
        <s:layout>
            <s:VerticalLayout gap="0"/>
        </s:layout>
    
        <!-- content -->
        <!--- @copy spark.components.SkinnableContainer#contentGroup -->
        <s:Group id="contentGroup" width="100%" height="100%" minHeight="0" minWidth="0"/>
        
        <!-- status bar -->
        <!--- @copy spark.components.WindowedApplication#statusBar -->
        <s:Group id="statusBar" width="100%" minHeight="24" visible="false" includeInLayout="false">
        
            <!-- status bar fill -->
            <s:Rect left="0" right="0" top="0" bottom="0">
               <s:fill>
                    <s:LinearGradient rotation="90">
                        <s:GradientEntry color="0xE2E2E2" />
                        <s:GradientEntry color="0xD9D9D9" />
                    </s:LinearGradient>
               </s:fill>
            </s:Rect>
            
            <!-- status bar highlight -->
            <s:Rect left="1" right="1" top="1" bottom="0" >
               <s:stroke>
                    <s:LinearGradientStroke rotation="90" weight="1">
                        <s:GradientEntry color="0xEAEAEA" />
                        <s:GradientEntry color="0xBEBEBE" />
                    </s:LinearGradientStroke>
               </s:stroke>
            </s:Rect>
        
            <!-- status text -->
            <!--- @copy spark.components.WindowedApplication#statusText -->
            <s:Label id="statusText" top="2" bottom="2" left="10" right="10" verticalAlign="middle" 
                fontSize="10" color="0x585858" width="100%" maxDisplayedLines="1" />

        </s:Group> 
    </s:Group>

</s:SparkSkin>
