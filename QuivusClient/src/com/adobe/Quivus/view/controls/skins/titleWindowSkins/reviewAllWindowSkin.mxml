<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009" blendMode="normal" mouseEnabled="false"
			 minWidth="76" minHeight="76" alpha.disabled="0.5" alpha.disabledWithControlBar="0.5">
	
	<fx:Metadata>
		<![CDATA[
		/**
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("spark.components.TitleWindow")]
		]]>
	</fx:Metadata>
	
	<!--
	NOTE: this skin file contains sub-parts that may continue to react to
	Style code. To remove this behavior create new copies of those skins
	and remove the styles.
	-->
	<s:states>
		<s:State name="normal" />
		<s:State name="inactive" stateGroups="inactiveGroup" />
		<s:State name="disabled" />
		<s:State name="normalWithControlBar" stateGroups="withControls" />
		<s:State name="inactiveWithControlBar" stateGroups="withControls, inactiveGroup" />
		<s:State name="disabledWithControlBar" stateGroups="withControls" />
	</s:states>
	
	<!--- drop shadow can't be hittable so it stays sibling of other graphics @private-->
	<!--<s:RectangularDropShadow id="dropShadow" blurX="20" blurY="20" alpha="0.32"
	alpha.inactiveGroup="0.22" distance="11" distance.inactiveGroup="7"
	angle="90" color="0x000000" left="0" top="0" right="0" bottom="0"/>-->
	
	<!--- drop shadow can't be hittable so all other graphics go in this group -->
	<s:Group left="0" right="0" top="0" bottom="0">
		
		<!--- top group mask @private-->
		<s:Group left="1" top="1" right="1" bottom="1" id="topGroupMask">
			<s:Rect id="topMaskRect" left="0" top="0" right="0" bottom="0">
				<s:fill>
					<s:SolidColor alpha="0"/>
				</s:fill>
			</s:Rect>
		</s:Group>
		
		<!--- bottom group mask @private-->
		<s:Group left="1" top="1" right="1" bottom="1" id="bottomGroupMask"
				 includeIn="withControls">
			<s:Rect id="bottomMaskRect" left="0" top="0" right="0" bottom="0">
				<s:fill>
					<s:SolidColor alpha="0"/>
				</s:fill>
			</s:Rect>
		</s:Group>
		
		<s:SkinnableContainer skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.reviewAllSkin" width="100%">
			<!--- layer 1: border @private -->
			<!--<s:Rect id="border" left="0" right="0" top="0" bottom="0" >
			<s:stroke>
			<s:SolidColorStroke id="borderStroke" weight="1" />
			</s:stroke>
			</s:Rect>-->
			
			<!-- layer 2: background fill -->
			<!--- Defines the appearance of the TitleWindowSkin class's background. -->
			<!--<s:Rect id="background" left="1" top="1" right="1" bottom="1">
			<s:fill>
			<s:SolidColor id="backgroundFill" color="#FFFFFF"/>
			</s:fill>
			</s:Rect>-->
			<!-- layer 3: contents -->
			<!--- Contains the vertical stack of title bar content and control bar. -->
			<s:Group left="1" right="1" top="1" bottom="1" id="contents" top.normal="1" left.normal="1" bottom.normal="-167.1" right.normal="1">
				<s:layout>
					<s:VerticalLayout gap="0" horizontalAlign="justify" />
				</s:layout>
				<!--- @private -->
				<s:Group id="topGroup" mask="{topGroupMask}">
					
					<!--- layer 0: title bar fill @private -->
					
					
					<!--- layer 1: title bar highlight @private -->
					
					<!--- layer 2: title bar divider @private -->
					
					
					
					
					<s:Label id="titleDisplay" maxDisplayedLines="1" top="18"
							 right="80" bottom="0" minHeight="30" fontSize="12"
							 verticalAlign="middle" fontFamily="Calibri Bold" color="#ffffff" />
					
					
					
					<s:Group id="moveArea" left="0" right="0" top="0" bottom="0" />
					
					<s:Button id="closeButton" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.ReviewAllCrossBtnSkin"
							  width="15" height="15" right="40" top="22" useHandCursor="true" buttonMode="true" toolTip="Close" />
					
					
					
					
					
					
					
					
				</s:Group>
				
				<!--
				Note: setting the minimum size to 0 here so that changes to the host component's
				size will not be thwarted by this skin part's minimum size. This is a compromise,
				more about it here: http://bugs.adobe.com/jira/browse/SDK-21143
				-->
				<!--- @copy spark.components.SkinnableContainer#contentGroup -->
				
				
				
				<s:Group id="contentGroup" width="100%" height="100%" minWidth="0" minHeight="0" height.normal="486">
					
				</s:Group>
				
				
				
				<!--- @private -->
				<s:Group id="bottomGroup" minWidth="0" minHeight="0"
						 includeIn="withControls">
					
					<s:Group left="0" right="0" top="0" bottom="0" mask="{bottomGroupMask}">
						
						
					</s:Group>
					
					<!--- @copy spark.components.Panel#controlBarGroup -->
					<s:Group id="controlBarGroup" left="0" right="0" top="1" bottom="1" minWidth="0" minHeight="0">
						<s:layout>
							<s:HorizontalLayout paddingLeft="10" paddingRight="10" paddingTop="7" paddingBottom="7" gap="10" />
						</s:layout>
					</s:Group>
				</s:Group>
			</s:Group>
		</s:SkinnableContainer>
	</s:Group>
</s:SparkSkin>
