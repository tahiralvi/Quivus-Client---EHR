<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:graphics="assets.graphics.*" xmlns:d="http://ns.adobe.com/fxg/2008/dt">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	<s:Rect height="16" includeIn="disabled,down,over" radiusX="2" width="16" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#FF7200" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FF7800" ratio="0.00784313725490196"/>
				<s:GradientEntry alpha="1.0" color="#FF7800" ratio="0.19215686274509805"/>
				<s:GradientEntry alpha="1.0" color="#FF4B13" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#FFBB5A" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.99" angle="90" blurX="2" blurY="2" color="#F6C32D" distance="0" hideObject="false" includeIn="down" inner="false" knockout="false" quality="2" strength="1"/>
			<s:DropShadowFilter alpha="0.98" alpha.down="1" angle="90" angle.over="270" blurX="0" blurX.down="2" blurY="0" blurY.down="2" color="#333333" distance="2" distance.over="1" hideObject="false" includeIn="down,over" inner="true" knockout="false" quality="2" strength="1"/>
		</s:filters>
		<s:fill.disabled>
			<s:SolidColor color="#CCCCCC"/>
		</s:fill.disabled>
	</s:Rect>
	<s:BitmapImage x="7" y="4" source="@Embed('com/adobe/Quivus/view/controls/skins/assets/slideout.png')" />
</s:Skin>
