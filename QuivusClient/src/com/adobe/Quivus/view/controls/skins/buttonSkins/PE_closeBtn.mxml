<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	<s:Rect height="23" includeIn="down,over" width="21" x="0" y="0" radiusX="2">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1" color="#727272" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#727272" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="4.0" blurY="4.0" color="0x000000" distance="0" hideObject="false"
								inner="true" knockout="false" quality="2" strength="1" includeIn="down"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage height="9" smooth="true" source="@Embed('com/adobe/Quivus/view/controls/skins/assets/patienthistory.png')" 
				   width="8" visible.up="false" visible.disabled="false" x="7" y="10"/>
	<s:BitmapImage height="9" smooth="true" source="@Embed('com/adobe/Quivus/view/controls/skins/assets/users.png')" width="8"
				   visible.over="false" visible.down="false" x="7" y="10">
		<s:filters>
			<s:GlowFilter includeIn="disabled" blurX="6.0" blurY="6.0" color="#999999" inner="true" strength="10" alpha="1.0" quality="2" knockout="false"/>
		</s:filters>
	</s:BitmapImage>
	<s:BitmapImage smooth="true" source="@Embed('com/adobe/Quivus/view/controls/skins/assets/pe_cross.png')" x="10" y="6">
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="0" blurY="0" color="#14302F" distance="1" hideObject="false" 
								inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:BitmapImage>
</s:Skin>


