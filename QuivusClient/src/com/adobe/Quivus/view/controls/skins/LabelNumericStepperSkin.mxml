<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:s="library://ns.adobe.com/flex/spark" 
		xmlns:mx="library://ns.adobe.com/flex/mx" creationComplete="cc()">
	<!-- host component -->
	<fx:Metadata>
		<![CDATA[
			[HostComponent("com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.physical.vitals.LabelNumericStepper2")]
		]]>
	</fx:Metadata>
	<fx:Script>
		<![CDATA[
			private var selectedColor:uint = 0xDFF6FF;
			private var deselectedColor:uint = 0xE2E3E3;
			
			private function cc():void
			{
				/*var c:Object = hostComponent.getStyle("selectedColor");
				
				if (c)
					selectedColor = c as uint;
				
				c = hostComponent.getStyle("deselectedColor");
				
				if (c)
					deselectedColor = c as uint;*/
			}
		]]>
	</fx:Script>
	<s:states>
		<s:State name="normal"/><s:State name="normalWithPrompt"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
		<s:State name="selected"/>
		<s:State name="deSelected"/>
	</s:states>
	<s:Rect x="0" y="0" width="100%" height="100%">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry color.selected="{selectedColor}" color.deSelected="{deselectedColor}"/>
				<s:GradientEntry color="#FFFFFF"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	
	<s:VGroup width="100%">
		<s:Label id="labelField" text="{hostComponent.label}" fontFamily="calibri" fontSize="11" width="100%"/>
		<s:HGroup width="100%" gap="2">
			<s:NumericStepper id="firstNumericStepper" skinClass="com.gazuntite.controls.extended.skins.LabelNumericStepperSkin2" width="100%"/>
			<s:NumericStepper id="secondNumericStepper" skinClass="com.gazuntite.controls.extended.skins.LabelNumericStepperSkin2" width="100%"
							  visible="{hostComponent.doubleModeOn}" 
							  />
		</s:HGroup>
	</s:VGroup>
</s:SparkSkin>
