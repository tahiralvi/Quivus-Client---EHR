<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	<s:Rect height="20" radiusX="3" width="103" x="0.5" y="0.5" visible.over="false" visible.down="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#FFF0F0" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#CEB8B8" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="0" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
			<s:GlowFilter alpha="1.0" blurX="4" blurY="4" color="#FFFFFF" inner="true" knockout="false" quality="2" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#331906" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Rect>
	<s:Rect height="20" radiusX="3" width="103" x="0.5" y="0.5" visible.up="false">
		<s:fill>
			<s:LinearGradient rotation="90" rotation.down="270">
				<s:GradientEntry alpha="1.0" color="#7676A2" ratio="0.5058823529411764" ratio.down="0.396078431372549"/>
				<s:GradientEntry alpha="1.0" color="#646490" ratio="0.5254901960784314" ratio.down="0.49019607843137253"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="0" blurY="0" color="0x000000" distance="0" hideObject="false" inner="false" knockout="false" quality="2" strength="1" includeIn="down,over,up"/>
			<s:GlowFilter alpha="1.0" blurX="3" blurY="3" color="#FFFFFF" inner="true" knockout="false" quality="3" strength="1" includeIn="over,up"/>
			<s:DropShadowFilter includeIn="down" blurX="3" blurY="3" distance="5" hideObject="false" color="#333333" inner="true" strength="1" alpha="1" quality="2" knockout="false" angle="90"/>
		</s:filters>
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#000000" joints="miter" miterLimit="4" weight="1" color.down="#333333" color.disabled="#999999"/>
		</s:stroke>
		<s:fill.disabled>
			<s:SolidColor color="#CCCCCC"/>
		</s:fill.disabled>
	</s:Rect>
	
	
	<s:Label id="labelDisplay"
			 fontFamily="Calibri" fontSize="12"
			 textAlign="center"
			 verticalAlign="middle"
			 maxDisplayedLines="1"
			 horizontalCenter="0" verticalCenter="1"
			 left="10" right="10" top="2" bottom="2"
			 color="#000000" color.up="#333333" color.disabled="#666666">
	</s:Label>
	
</s:Skin>
