<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	<s:Rect height="23" includeIn="down,over,up" radiusX="2" width="23" x="0.5" visible.up="false" y="0.5">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1" color="#727272" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#727272" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
		<s:filters>
			<s:DropShadowFilter includeIn="down" blurX="2" blurY="2" distance="2" hideObject="false" color="0x000000" inner="true" strength="1" alpha="0.5" quality="3" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage smooth="true" source="@Embed('com/adobe/Quivus/view/controls/skins/assets/qi_save.png')" y="7" x="7">
		<s:filters>
			<s:GlowFilter blurX="6.0" blurY="6.0" color="#FFFFFF" inner="true" strength="6" alpha="1.0" quality="3" knockout="false" color.up="#333333"/>
			<s:DropShadowFilter includeIn="up" blurX="1" blurY="1" distance="1" hideObject="false" color="#FFFFFF" inner="false" strength="1" alpha="0.25" quality="3" knockout="false" angle="90"/>
		</s:filters>
	</s:BitmapImage>
</s:Skin>