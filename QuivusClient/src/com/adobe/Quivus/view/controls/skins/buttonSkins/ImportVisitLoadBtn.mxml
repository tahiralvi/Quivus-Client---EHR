<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009"
		useHandCursor="true" buttonMode="true">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	<s:Rect height="16" radiusX="3" width="50" x="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#8B8F94" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#3C4E60" ratio="0.49019607843137253"/>
				<s:GradientEntry alpha="1.0" color="#263242" ratio="0.49411764705882355"/>
				<s:GradientEntry alpha="1.0" color="#070707" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter includeIn="up" blurX="1" blurY="1" distance="1" hideObject="false" color="0x000000" inner="false" strength="1" alpha="0.25" quality="2" knockout="false" angle="90"/>
		</s:filters>
		
		
		<s:fill.over>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#F4CF85" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#EFA74E" ratio="0.5137254901960784"/>
				<s:GradientEntry alpha="1.0" color="#EC923A" ratio="0.5176470588235295"/>
				<s:GradientEntry alpha="1.0" color="#F1983B" ratio="1"/>
			</s:LinearGradient>
		</s:fill.over>
		<s:filters.over>
			<s:DropShadowFilter includeIn="over" blurX="2" blurY="2" distance="1" hideObject="false" color="0x000000" inner="false" strength="1" alpha="0.5" quality="2" knockout="false" angle="90"/>
			
		</s:filters.over>
		
		
		<s:fill.down>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#F4CF85" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#EFA74E" ratio="0.5137254901960784"/>
				<s:GradientEntry alpha="1.0" color="#EC923A" ratio="0.5176470588235295"/>
				<s:GradientEntry alpha="1.0" color="#F1983B" ratio="1"/>
			</s:LinearGradient>
		</s:fill.down>
		<s:filters.down>
			<s:DropShadowFilter includeIn="down" blurX="2" blurY="2" distance="1" hideObject="false" color="0x000000" inner="false" strength="1" alpha="0.5" quality="2" knockout="false" angle="90"/>
		</s:filters.down>
		
		
	</s:Rect>
	<s:RichText fontFamily="Calibri" fontSize="12" text="Load" x="13" y="3" color="#FFFFFF" color.over="#333333" color.down="#333333">
		<s:filters>
			<s:DropShadowFilter blurX="0" blurY="0" distance="1" hideObject="false" color="0x000000" inner="false" strength="1" alpha="0.2" quality="2" knockout="false" angle="270"/>
		</s:filters>
	</s:RichText>
</s:Skin>
