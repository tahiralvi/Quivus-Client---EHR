<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:d="http://ns.adobe.com/fxg/2008/dt">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect height="25" radiusX="3" width="100" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="90" rotation.over="270">
				<s:GradientEntry alpha="1.0" color="#6D7278" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#363E46" ratio="0.5254901960784314" ratio.over="0.4392156862745098"/>
				<s:GradientEntry alpha="1.0" color="#2B323B" ratio="0.5294117647058824" ratio.over="0.44313725490196076"/>
				<s:GradientEntry alpha="1.0" color="#454B54" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.65" angle="90" blurX="2" blurY="2" color="#000000" distance="2" hideObject="false" includeIn="down" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:RichText  color="#ffffff" fontFamily="CalibriCFFBold" fontSize="12" horizontalCenter="0"
				height="12" id="labelDisplay" lineHeight="120%" tabStops="S0 S50" text="" whiteSpaceCollapse="preserve"  verticalCenter="0"></s:RichText>
</s:Skin>
