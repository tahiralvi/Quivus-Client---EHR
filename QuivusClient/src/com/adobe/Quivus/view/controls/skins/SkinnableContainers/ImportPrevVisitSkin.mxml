<?xml version="1.0" encoding="utf-8"?>

<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
    xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5">

    <fx:Metadata>
    <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.SkinnableContainer")]
    ]]>
    </fx:Metadata> 
    
    <s:states>
        <s:State name="normal" />
        <s:State name="disabled" />
    </s:states>
    
    <!--- Defines the appearance of the SkinnableContainer class's background. -->
	<s:Group width="100%" height="100%">
		<s:Group width="100%" height="100%">
			<s:filters>
				<s:DropShadowFilter alpha="0.5" angle="90" blurX="8" blurY="8" color="0x000000" distance="0" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
			</s:filters>
			<s:Rect id="id_outer" height="100%" minHeight="129" radiusX="5" width="250" x="0" y="8">
				<s:fill>
					<s:LinearGradient rotation="90">
						<s:GradientEntry alpha="1.0" color="0xF27100" ratio="0"/>
						<s:GradientEntry alpha="1.0" color="#FFCB00" ratio="0.7568627450980392"/>
						<s:GradientEntry alpha="1.0" color="0xCD6E17" ratio="1"/>
					</s:LinearGradient>
				</s:fill>
			</s:Rect>
			<s:Path data="M 16.37 14.17 L 0.03 14.17 8.20 0.02 Z " height="9.15" width="18.35" x="194" y="0.55">
				<s:fill>
					<s:SolidColor color="0xF27100"/>
				</s:fill>
			</s:Path>
		</s:Group>
		<s:Rect height="{id_outer.height - 10}" minHeight="119" id="rect80" width="240" x="5" y="12">
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#509BCB" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#2181BD" ratio="0.11764705882352941"/>
				</s:LinearGradient>
			</s:fill>
		</s:Rect>
		<s:RichText color="#FFFFFF" fontFamily="Calibri Bold" fontSize="14" id="richtext4" kerning="off" tabStops="S0 S50 S100" text="IMPORT PREVIOUS VISIT" x="14" y="17">
			<s:filters>
				<s:DropShadowFilter alpha="0.5" angle="270" blurX="1" blurY="1" color="#0E1E28" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
			</s:filters>
		</s:RichText>
	</s:Group>
    
    <!--
        Note: setting the minimum size to 0 here so that changes to the host component's
        size will not be thwarted by this skin part's minimum size.   This is a compromise,
        more about it here: http://bugs.adobe.com/jira/browse/SDK-21143
    -->
    <!--- @copy spark.components.SkinnableContainer#contentGroup -->
    <s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
        <s:layout>
            <s:BasicLayout/>
        </s:layout>
    </s:Group>

</s:Skin>
