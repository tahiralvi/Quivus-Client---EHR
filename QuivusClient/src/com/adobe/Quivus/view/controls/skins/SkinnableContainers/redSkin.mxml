<?xml version="1.0" encoding="utf-8"?>

<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
    xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5">

    <fx:Metadata>
    <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.SkinnableContainer")]
    ]]>
    </fx:Metadata> 
    
    <s:states>
        <s:State name="normal" />
        <s:State name="disabled" />
    </s:states>
    
    <!--- Defines the appearance of the SkinnableContainer class's background. -->
	
	
<!--	<s:Path height="100%" width="100%" data="M 629.999 242 C 629.999 244.209 628.208 246 625.999 246 L 4 246 C 1.791 246 0 244.209 0 242 L 0 0 L 629.999 0 L 629.999 242 Z" winding="nonZero" x="0" y="0" >
		<s:fill>
			<s:SolidColor color="#DF1313"/>
		</s:fill>
	</s:Path>-->
	
	
	<s:Rect height="100%" width="100%" radiusX="5" >		
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#FFAFB2" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="0.5529411764705883"/>
				<s:GradientEntry alpha="1.0" color="#FFC8C9" ratio="0.94" />
				<s:GradientEntry alpha="1.0" color="#F4A6A8" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="86" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="#000000" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect width="100%" radiusX="0" height="6" >		
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#FFAFB2" ratio="0"/>
			
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
    
    <!--
        Note: setting the minimum size to 0 here so that changes to the host component's
        size will not be thwarted by this skin part's minimum size.   This is a compromise,
        more about it here: http://bugs.adobe.com/jira/browse/SDK-21143
    -->
    <!--- @copy spark.components.SkinnableContainer#contentGroup -->
    <s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
        <s:layout>
            <s:BasicLayout/>
        </s:layout>
    </s:Group>

</s:Skin>
