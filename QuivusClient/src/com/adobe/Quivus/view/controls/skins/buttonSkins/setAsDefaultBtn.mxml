<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>

	</s:states>
	<s:Rect height="16" radiusX="9" visible.down="false" visible.over="false" width="75" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#818994" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#515A67" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x616976" distance="1" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
			<s:DropShadowFilter alpha="1" angle="90" blurX="1" blurY="1" color="#333333" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect height="16" radiusX="9" width="75" visible.up="false" visible.disabled="false" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#AFD1FF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#6593D5" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" includeIn="down" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:RichText color="#DBE3E6" fontFamily="Calibri" fontSize="10" tabStops="S0 S50" text="Set as Default" x="10" y="4"></s:RichText>
</s:Skin>
