<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	<s:Rect height="17" radiusX="4" width="49" x="0.5" y="0.5">
		<s:stroke>
			<s:SolidColorStroke caps="none" joints="miter" miterLimit="4" weight="1" color="#808191"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="90" rotation.over="270" rotation.down="270">
				<s:GradientEntry alpha="1.0" color="#C3C5E5" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#ABADCD" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:GlowFilter alpha="1.0" blurX="2" blurY="2" color="#FFFFFF" inner="true" knockout="false" quality="2" strength="1" includeIn="disabled,over,up"/>
			<s:DropShadowFilter includeIn="down" blurX="4.0" blurY="4.0" distance="4.0" hideObject="false" color="0x000000" inner="true" strength="1" alpha="0.5" quality="2" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	<s:RichText color="#2E2F32" fontFamily="Calibri" fontSize="12" tabStops="S0" text="{hostComponent.label}" x="8" y="4"/>
</s:Skin>