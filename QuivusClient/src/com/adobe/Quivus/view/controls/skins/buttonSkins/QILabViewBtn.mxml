<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:d="http://ns.adobe.com/fxg/2008/dt">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect height="23" height.down="20" height.over="20" height.up="20" id="rect4" includeIn="down,over,up" radiusX="3" width="97" width.down="50" width.over="50" width.up="50" x.down="0" x.over="0" x.up="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#F1983B" color.up="#424952" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#EC923A" color.up="#2C333C" ratio="0.5450980392156862" ratio.up="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#EFA74E" color.up="#373F47" ratio="0.5490196078431373" ratio.up="0.5019607843137255"/>
				<s:GradientEntry alpha="1.0" color="#F4CF85" color.up="#6A6F75" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="#333333" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" alpha.down="1" angle="90" blurX="1" blurX.down="3" blurY="1" blurY.down="3" color="#FFFFFF" color.down="#000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect alpha="1" height="20" id="rect0" includeIn="disabled" radiusX="3" width="50" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#898989" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#AFAFAF" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:RichText color="#FFFFFF" color.disabled="#333333" color.down="#333333" color.over="#333333" text="{hostComponent.label}"
				fontFamily="Calibri" fontSize="13" id="richtext15"  kerning="off" tabStops="S0 S50" x="12" y="5">
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	
</s:Skin>