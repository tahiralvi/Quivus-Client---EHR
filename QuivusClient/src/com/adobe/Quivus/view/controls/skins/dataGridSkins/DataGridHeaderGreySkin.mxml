<?xml version="1.0" encoding="utf-8"?>
<!-- http://blog.flexexamples.com/2009/07/19/setting-the-header-colors-on-the-halo-datagrid-control-in-flex-4/ -->
<s:SparkSkin name="CustomDataGridHeaderBackgroundSkin"
			 xmlns:fx="http://ns.adobe.com/mxml/2009"
			 xmlns:s="library://ns.adobe.com/flex/spark"
			 minWidth="21" minHeight="22">
	
	<s:states>
		<s:State name="over"/>
		<s:State name="normal"/><s:State name="normalWithPrompt"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	
	<s:Rect height="22" width="100%" x="0" y="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#999999" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="0" blurY="0" color="#666666" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
</s:SparkSkin>