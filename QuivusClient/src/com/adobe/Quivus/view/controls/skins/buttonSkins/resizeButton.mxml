<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
             xmlns:fb="http://ns.adobe.com/flashbuilder/2009" minWidth="21" minHeight="21" alpha.disabled="0.5">
    
    <!-- host component -->
    <fx:Metadata>
        <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.Button")]
        ]]>
    </fx:Metadata>
    
    <!-- states -->
    <s:states>
        <s:State name="up" />
        <s:State name="over" />
        <s:State name="down" />
        <s:State name="disabled" />
    </s:states>

	<s:Group includeIn="up, over, down" alpha.up="0.05" alpha.down="1" alpha.over="1" xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:flm="http://ns.adobe.com/flame/2008" xmlns:ai="http://ns.adobe.com/ai/2009">
		<s:BitmapImage smooth="true" source="@Embed('com/adobe/Quivus/view/controls/skins/assets/righttopexpanderbg.png')" y="-3" x="0"/>
		<s:BitmapImage smooth="true" source="@Embed('com/adobe/Quivus/view/controls/skins/assets/righttopexpanderlines.png')" x="8" y="0" alpha="0.45"/>
	</s:Group>
    
</s:SparkSkin>
