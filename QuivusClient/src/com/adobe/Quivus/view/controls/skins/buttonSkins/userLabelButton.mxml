<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	<s:Rect height="10" id="rect1" radiusX="2" visible="false" width="95" x="0" y.up="1" y.over="0" y.down="0" y.disabled="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="0.027450980392156862"/>
				<s:GradientEntry alpha="1.0" color="#999999" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
		</s:filters>
	</s:Rect>
	<s:Rect height="10" id="rect0" radiusX="2.99979" radiusY="2.99979" visible.disabled="false" width="100%" minWidth="90" x="0" y="0" visible.up="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#AFD1FF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#6593D5" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.7000000000000001" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.2" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Label id="labelDisplay"
			 textAlign="center" textAlign.up="left"
			 verticalAlign="middle" fontSize="13"
			 maxDisplayedLines="1"
			 color="#333333" fontFamily="Calibri Bold"
			 horizontalCenter="0" verticalCenter="1"
			 left="0" right="10" top="2" bottom="2">
	
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="2" blurY="2" color="0x000000" color.down="#FFFFFF" color.over="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Label>
	<s:transitions>
		<s:Transition autoReverse="true" fromState="down" toState="up">
			<s:Parallel>
				<s:Parallel target="{rect1}">
					<s:Fade duration="0"/>
				</s:Parallel>
			</s:Parallel>
		</s:Transition>
	</s:transitions>
</s:Skin>
