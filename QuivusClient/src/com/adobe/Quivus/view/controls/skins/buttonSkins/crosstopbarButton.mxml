<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>

	<s:Rect height="21" radiusX="2" width="18" x="0.5" y="0.5" visible.up="false" visible.disabled="false" >
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.47058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:stroke>
			<s:LinearGradientStroke weight="1" caps="none" miterLimit="4" joints="miter" rotation="90">
				<s:GradientEntry color="#727272" alpha="1" ratio="0"/>
				<s:GradientEntry color="#000000" alpha="1" ratio="0.5058823529411764"/>
				<s:GradientEntry ratio="1" color="#727272" alpha="1.0"/>
			</s:LinearGradientStroke>
		</s:stroke>
		<s:filters>
			<s:DropShadowFilter includeIn="down" blurX="4.0" blurY="4.0" distance="0" hideObject="false" color="0x000000" inner="true" strength="1" alpha="0.5" quality="2" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	
	<s:RichText text="x" color="#333333" fontSize="14" tabStops="S0" y="5.5" x="9" color.up="#ffffff" fontFamily="Arial" fontWeight="bold" x.over="6" y.over="4.5" color.over="#FCF8F8" x.up="6" y.up="4.5" x.down="6" y.down="4.5" color.down="#EFE9E9">
		<s:filters>
			<s:DropShadowFilter blurX="1" blurY="1" distance="1" hideObject="false" color="#FFFFFF" inner="false" strength="1" alpha="0.25" quality="2" knockout="false" angle="90"/>
		</s:filters>
	</s:RichText>
</s:Skin>
