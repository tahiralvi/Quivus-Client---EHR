<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
    xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5">

    <fx:Metadata>
    <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.SkinnableContainer")]
    ]]>
    </fx:Metadata> 
    
    <s:states>
        <s:State name="normal" />
        <s:State name="disabled" />
    </s:states>
    
    <!--- Defines the appearance of the SkinnableContainer class's background. -->
	<s:Group id="id_slideBG" width="100%" height="100%">	
		<s:BitmapImage smooth="true" source="@Embed('com/adobe/Quivus/view/controls/skins/assets/slideout_hud.png')" y="0" alpha="0.95" 
					   />
		<!--<s:Rect id="id_bg" x="10" y="0" width="{(Capabilities.screenResolutionX / 2)-20}" height="{Capabilities.screenResolutionY - 200}" minWidth="200" minHeight="200" >-->
		<s:Rect id="id_bg" x="10" y="0" width="{(Capabilities.screenResolutionX / 2)}" height="100%" minWidth="200" minHeight="200" alpha="0.8" >
			<s:fill>
				<s:SolidColor color="0x1D1D1D"/>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter blurX="4.0" blurY="4.0" distance="4.0" hideObject="false" color="0x000000" inner="false" strength="1" alpha="0.5" quality="3" knockout="false" angle="90"/>
			</s:filters>
		</s:Rect>
	</s:Group>
	
    
    <!--
        Note: setting the minimum size to 0 here so that changes to the host component's
        size will not be thwarted by this skin part's minimum size.   This is a compromise,
        more about it here: http://bugs.adobe.com/jira/browse/SDK-21143
    -->
    <!--- @copy spark.components.SkinnableContainer#contentGroup -->
    <s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
        <s:layout>
            <s:BasicLayout/>
        </s:layout>
    </s:Group>

</s:Skin>
