			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" color.up="#333333" distance="1" hideObject="false" includeIn="down,over,up" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
