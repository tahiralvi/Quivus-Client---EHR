<?xml version="1.0" encoding="utf-8"?>
<custom:SlideOutPanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:custom="com.adobe.Quivus.view.controls.custom.*"
					  xmlns:components="com.gazuntite.controls.extended.components.*"
					  xmlns:skins="com.adobe.Quivus.view.controls.skins.*" 
					  creationComplete="slideoutpanel1_creationCompleteHandler(event)"
					 xmlns:buttonSeparators="com.adobe.Quivus.view.controls.skins.buttonSeparators.*" 
					  					
					  >

	<fx:Metadata>
		[Event(name="close", type="mx.events.CloseEvent")]
	</fx:Metadata>

	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.AppEventStrings;
			import com.adobe.Quivus.utils.ChromeUtil;
			import com.adobe.Quivus.view.events.WebSearchEvent;
			
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			private var loadUrl:URLRequest ;
			
			//public var chUtil:ChromeUtil = new ChromeUtil();
			
			
			[Bindable]
			public function get UrlRequest():URLRequest
			{
				return loadUrl;
			}
			
			public function set UrlRequest(value:URLRequest):void
			{
				loadUrl = value;
				id_htmlArea.location =  loadUrl.url
			}

			protected function slideoutpanel1_creationCompleteHandler(event:FlexEvent):void
			{
				
				if( loadUrl )
				{
					id_htmlArea.location =  loadUrl.url ;

				}
				id_SearchText.setFocus();
				
				
			}
			protected function button2_clickHandler(event:MouseEvent):void
			{
				var query:String = id_SearchText.text;
				
				
				
				this.UrlRequest = new URLRequest(model.userPrefferedSearchEngineDTO.URL /* + "/search?q=" */ + query);
				/* var webSearch:WebSearchEvent = new WebSearchEvent( AppEventStrings.SEARCH_WEB, query, true, true);
				this.dispatchEvent( webSearch ); */
				
				event.stopImmediatePropagation();
			}
			public function CloseHandler(event:MouseEvent):void
			{
				//chUtil.removeWindowsCount();
				dispatchEvent( new CloseEvent("close") );
			}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				this.ToggleSlideOut();
				
				
				if(isSlideOut)
				{
					id_slideoutBtn1.selected = true;
					id_slideoutBtn.selected = true;
				}
				else
				{
					id_slideoutBtn1.selected = false;
					id_slideoutBtn.selected = false;
				}
				event.stopImmediatePropagation();
				
			}
			
			public function GoBack(event:MouseEvent):void
			{
				id_htmlArea.historyBack();
				event.stopImmediatePropagation();
			}
			
			public function GoForward(event:MouseEvent):void
			{
				id_htmlArea.historyForward();
				event.stopImmediatePropagation();
			}
						



			protected function textinput1_clickHandler(event:MouseEvent):void
			{
				event.stopImmediatePropagation();
			}

		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<custom:HeaderContents>
		<s:Group width="100%" minWidth="{ChromeUtil.topLevelMainContainer.width - 22}" id="id_header" height="22">
			<s:layout>
				<s:VerticalLayout paddingLeft="{isSlideOut? 5:0}"  horizontalAlign="center" />
			</s:layout>
		<s:SkinnableContainer width="100%" minWidth="560" skinClass="com.adobe.Quivus.view.controls.skins.PatientRegHeaderSkin">
			
			
		<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="left">
			<s:Label paddingLeft="12" color="#000000" paddingTop="6" fontFamily="Calibri Bold" text="WEB SEARCH" />
			<!--<mx:Spacer width="100%" />-->
		</s:HGroup>
		<s:HGroup width="100%" horizontalAlign="center" verticalAlign="middle">
			
			<s:HGroup gap="0">
				
			
			<buttonSeparators:buttonSeparatorGrey />
			<s:Button skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.leftButton_web" click="GoBack(event)" toolTip="Back" buttonMode="true" />
			<buttonSeparators:buttonSeparatorGrey />
			<s:Button skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.rightbutton_web" click="GoForward(event)" toolTip="Forward" buttonMode="true"/>
			<buttonSeparators:buttonSeparatorGrey />
			</s:HGroup>
			
			<s:SkinnableContainer styleName="patientSearchBGContainerSkin"  width="210" >
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" gap="1" />
				</s:layout>

			<s:TextInput id='id_SearchText' width="100%" text="" skinClass="com.adobe.gazuntite.skins.chrome.textInputSkins.transparentTextInput"
						 click="textinput1_clickHandler(event)" />
			
			<s:Button styleName="orangeSearchButtonSkin" click="button2_clickHandler(event)"   height="20"  width="23"  
					  buttonMode="true" toolTip="Search" />
			</s:SkinnableContainer>	
			
		</s:HGroup>	
			
		<s:HGroup horizontalAlign="right" width="100%" paddingRight="0" paddingTop="0" gap="0">
			<buttonSeparators:buttonSeparatorGrey />
			<s:HGroup paddingTop="0">
				
				<s:Button skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.QICrossButtonSkin" 
								buttonMode="true" useHandCursor="true" toolTip="Close Web Panel" click="CloseHandler(event)"/>
			</s:HGroup>
			<buttonSeparators:buttonSeparatorGrey />
			<s:HGroup paddingTop="0">
				
			<s:ToggleButton id="id_expandBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.expandButton_grey" 
							buttonMode="true" useHandCursor="true" toolTip="{id_expandBtn.selected?'Collapse':'Expand'}"/>
			</s:HGroup>
			<buttonSeparators:buttonSeparatorGrey />
			<s:HGroup paddingTop="0" paddingRight="0">
			<s:ToggleButton id="id_slideoutBtn" skinClass="com.adobe.Quivus.view.controls.skins.toggleButtonSkins.slideOutBtn"
							buttonMode="true" useHandCursor="true" toolTip="{id_slideoutBtn.selected?'Slide-In':'Slide-Out'}" 
							width="19" height="21"  click="button1_clickHandler(event)" />
			</s:HGroup>
		</s:HGroup>
			</s:SkinnableContainer>
			</s:Group>
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		<s:SkinnableContainer depth="100" height="21" width="100%" minWidth="500" skinClass="com.adobe.Quivus.view.controls.skins.PatientRegHeaderSkin">
			
			
			<!--<s:Label text="{Label}" top="2" left="5" />			-->	
			
			
			<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="{isSlideOut? 'left':'left'}">
				<s:Label paddingLeft="12" color="#ffffff" paddingTop="6" fontFamily="Calibri Bold" text="WEB SEARCH" />
				
			</s:HGroup>
			
			<s:HGroup horizontalAlign="right" width="100%" paddingRight="1" paddingTop="0" gap="1">
				<buttonSeparators:buttonSeparatorGrey />
				<s:HGroup paddingTop="0">
					
					<s:Button skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.crosstopbarButton" 
							  buttonMode="true" useHandCursor="true" toolTip="Close Web Panel" click="CloseHandler(event)"/>
				</s:HGroup>
				<buttonSeparators:buttonSeparatorGrey />				
				<s:HGroup paddingTop="0" paddingRight="3">
					<s:ToggleButton id="id_slideoutBtn1" skinClass="com.adobe.Quivus.view.controls.skins.toggleButtonSkins.slideOutBtn"
									buttonMode="true" useHandCursor="true" toolTip="{id_slideoutBtn.selected?'Slide-In':'Slide-Out'}" 
									width="18" height="18"  click="button1_clickHandler(event)" />
				</s:HGroup>
			</s:HGroup>
			
			
			
		</s:SkinnableContainer>
	</custom:SlideHeaderContents>
	<custom:Contents>
		<s:VGroup id="id_content" height="295" minWidth="560" paddingTop="-8" gap="0" width="{id_header.width}" verticalAlign="top" horizontalAlign="center"
				  paddingLeft="{isSlideOut? 10:0}" 
				  >
			
			<s:VGroup gap="-2" height="100%" width="{isSlideOut? id_header.width :id_header.width }"  verticalAlign="top" horizontalAlign="center" 
					  paddingTop="0">
				
				
		
	<!--<s:BorderContainer height="100%" width="100%" cornerRadius="3" backgroundColor="#999AAA" 
								   borderWeight="3" borderAlpha="1" borderColor="#999AAA" borderVisible="true" >-->
				<s:SkinnableContainer skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.webpanelbodySkin" width="100%" height="100%">
					
					<s:layout>
						<s:HorizontalLayout paddingTop="16" paddingLeft="8" paddingRight="8" paddingBottom="8" verticalAlign="middle" horizontalAlign="center" />
					</s:layout>
				
					<mx:HTML id="id_htmlArea" location="" width="100%" height="100%" />
				</s:SkinnableContainer>
				
<!--				</s:BorderContainer>
-->			
				
				<s:Button id="id_CloseBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.closeBtnSkin" 
						  click="CloseHandler(event)" buttonMode="true" useHandCursor="true" toolTip="Close Web Section"/>
				
			</s:VGroup>
		</s:VGroup>
	</custom:Contents>
</custom:SlideOutPanel>
