<?xml version="1.0" encoding="utf-8"?>
<custom:SlideOutPanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:custom="com.adobe.Quivus.view.controls.custom.*" 
					  xmlns:skins="com.adobe.Quivus.view.controls.skins.*" 
					  xmlns:components="com.gazuntite.controls.extended.components.*" 
					  xmlns:buttonSeparators="com.adobe.Quivus.view.controls.skins.buttonSeparators.*" 
					  xmlns:patientEncounter="com.adobe.Quivus.view.controls.custom.patientExamView.viewBackground.patientEncounter.*"   >
	
	<fx:Metadata>
		[Event(name="close", type="mx.events.CloseEvent")]
	</fx:Metadata>
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.ChromeUtil;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.expandButton_grey;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.expandButton_grey_expanded;
			import com.gazuntite.provider.eprescription.services.patient.view.ePrescription;
			
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			
			import valueObjects.UserTypeDTO;
			
			[Bindable]
			public var headerLabel:String;
			[Bindable]
			public var toolTipLabel:String = "Close ";
			private var _ePrescription:ePrescription;
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				this.ToggleSlideOut();
				event.stopImmediatePropagation();
			}
			
			protected function CloseHandler(event:MouseEvent):void
			{
				dispatchEvent( new CloseEvent("close") );
			}
			
			protected function id_content_creationCompleteHandler(event:FlexEvent):void
			{
				var usertype_dto:UserTypeDTO 						= new UserTypeDTO();
				var userTypeDTO:XML 								= <OwnerUserType />
				userTypeDTO.IsClinicUser 							= usertype_dto.IsClinicUser?"true":"false";
				userTypeDTO.IsProvider 								= usertype_dto.IsProvider?"true":"false";
				userTypeDTO.UserTypeId 								= usertype_dto.UserTypeId;
				userTypeDTO.UserTypeName 							= usertype_dto.UserTypeName;
				
				_ePrescription = new ePrescription();
				
				(_ePrescription as ePrescription).userID 			= model.loggedInUserDTO.UserId;
				(_ePrescription as ePrescription).clinicBranchID 	= model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq;
				(_ePrescription as ePrescription).templateId 		= "1";
				(_ePrescription as ePrescription).encounterTypeId 	= "1";
				(_ePrescription as ePrescription).userTypeDTO 		= userTypeDTO;
				
				_ePrescription.percentWidth 						= 100;
				//_ePrescription.percentHeight 						= 100;
				id_content.addElement( _ePrescription );
			}
			protected function ScrollUp(event:MouseEvent):void
			{
				id_Scroller.viewport.verticalScrollPosition = id_Scroller.viewport.verticalScrollPosition + 15;
			}
			
			protected function ScrollDown(event:MouseEvent):void
			{
				id_Scroller.viewport.verticalScrollPosition = id_Scroller.viewport.verticalScrollPosition - 15;
			}
			protected function button2_buttonDownHandler(event:Event):void
			{
				id_Scroller.viewport.verticalScrollPosition = id_Scroller.viewport.verticalScrollPosition + 15;
			}
			protected function button3_buttonDownHandler(event:Event):void
			{
				id_Scroller.viewport.verticalScrollPosition = id_Scroller.viewport.verticalScrollPosition - 15;
			}
		]]>
		
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<custom:HeaderContents>
		<s:Group width="100%" id="id_header" height="22">
			<s:layout>
				<s:VerticalLayout paddingLeft="{isSlideOut? 5:0}"  horizontalAlign="center" />
			</s:layout>
			<s:SkinnableContainer width="100%" minWidth="550" skinClass="com.adobe.Quivus.view.controls.skins.PatientRegHeaderSkin">
				
				<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="{isSlideOut? 'left':'center'}" >
					<s:Label  paddingLeft="12" color="#000000" paddingTop="6" fontFamily="Calibri Bold"  text="e-Prescription" />
					<mx:Spacer width="100%" />
				</s:HGroup>
				<s:HGroup horizontalAlign="right" width="100%" paddingRight="1" paddingTop="0" gap="0">
					<buttonSeparators:buttonSeparatorGrey />
					<s:HGroup paddingTop="0">
						<s:Button skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.crosstopbarButton" 
								  buttonMode="true" useHandCursor="true" toolTip="Close Prescription Panel" click="CloseHandler(event)"/>
					</s:HGroup>
					<buttonSeparators:buttonSeparatorGrey />
					<s:HGroup paddingTop="0">
						<s:ToggleButton id="id_expandBtn" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.expandButton_white" 
										buttonMode="true" useHandCursor="true" toolTip="{id_expandBtn.selected?'Collapse':'Expand'}"/>
					</s:HGroup>
					<buttonSeparators:buttonSeparatorGrey />
					<s:HGroup paddingTop="0" paddingRight="0">
						<s:ToggleButton id="id_slideoutBtn" skinClass="com.adobe.gazuntite.skins.chrome.toggleButtonSkins.slideOutBtn_white"
										buttonMode="true" useHandCursor="true" toolTip="{id_slideoutBtn.selected?'Slide-In':'Slide-Out'}" 
										width="18" height="18"  click="button1_clickHandler(event)" />
					</s:HGroup>
				</s:HGroup>
			</s:SkinnableContainer>
		</s:Group>
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		
		<s:SkinnableContainer height="22" width="100%" minWidth="550" skinClass="com.adobe.Quivus.view.controls.skins.PatientRegHeaderSkin">
			<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="center" >
				<s:Label  paddingLeft="12" color="#ffffff" paddingTop="6" fontFamily="Calibri Bold" typographicCase="uppercase" text="{headerLabel}" />				
				
			</s:HGroup>
			
		</s:SkinnableContainer>
		
	</custom:SlideHeaderContents>
	
	<custom:Contents>
		
		<s:VGroup paddingTop="0" gap="0" height="100%" width="{id_header.width}" verticalAlign="top" horizontalAlign="center"
				  paddingLeft="{isSlideOut? 10:0}"  >
			<s:SkinnableContainer width="100%" height="100%"
								  minHeight="30" skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.grayPanelBodySkin">
				<s:layout>
					<s:VerticalLayout gap="5" paddingTop="0" paddingLeft="4" paddingRight="4" paddingBottom="5" horizontalAlign="left"  />
				</s:layout>
				
				<s:Scroller id="id_Scroller" width="100%" height="400" horizontalScrollPolicy="off" verticalScrollPolicy="off">
					<s:Group id="id_content" width="100%" height="100%" creationComplete="id_content_creationCompleteHandler(event)" />
				</s:Scroller>
				
				<s:HGroup width="100%" horizontalAlign="center" paddingTop="11" >
					<s:HGroup width="100%" horizontalAlign="center" paddingTop="-10" paddingRight="15" paddingBottom="5">
						<s:Button height="8" width="40" toolTip="Scroll Up" click="ScrollUp(event)" 
								  buttonDown="button2_buttonDownHandler(event)"
								  autoRepeat="true" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.PEscrollUp" 
								  buttonMode="true" useHandCursor="true"/>
						<s:Button height="8" width="40" toolTip="Scroll Down" click="ScrollDown(event)" 
								  buttonDown="button3_buttonDownHandler(event)" autoRepeat="true"
								  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.PEScrollDown" 
								  buttonMode="true" useHandCursor="true"/>
					</s:HGroup>
				</s:HGroup>
			</s:SkinnableContainer>
			<s:Button id="id_CloseBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.closeBtnSkin" toolTip="Close e-Prescription"
					  click="CloseHandler(event)" buttonMode="true" useHandCursor="true" />
			
		</s:VGroup>
	</custom:Contents>
	
</custom:SlideOutPanel>
