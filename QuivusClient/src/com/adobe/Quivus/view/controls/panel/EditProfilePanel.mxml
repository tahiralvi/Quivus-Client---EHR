<?xml version="1.0" encoding="utf-8"?>
<custom:SlideOutPanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:custom="com.adobe.Quivus.view.controls.custom.*" 
					  xmlns:skins="com.adobe.Quivus.view.controls.skins.*" 
					  xmlns:components="com.gazuntite.controls.extended.components.*" 
					  creationComplete="slideoutpanel1_creationCompleteHandler(event)"					 
					  xmlns:buttonSeparators="com.adobe.Quivus.view.controls.skins.buttonSeparators.*" 
					  xmlns:profile="com.adobe.Quivus.view.controls.custom.profile.*" 
					  xmlns:view="com.gazuntite.provider.search.services.patient.view.*" 
					  xmlns:view1="com.zigron.provider.eprescription.services.patient.view.*" xmlns:view2="com.gazuntite.provider.eprescription.services.patient.view.*"  >
	<fx:Metadata>
		[Event(name="close", type="mx.events.CloseEvent")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.events.staticData.addressBook.LoadAddressBookStaticDataEvent;
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.ChromeUtil;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.expandButton_grey;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.expandButton_grey_expanded;
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			
			[Bindable] private var model : AppModelLocator = AppModelLocator.getInstance();
			[Bindable] public var headerLabel:String;
			[Bindable] public var toolTipLabel:String = "Close ";
			
			protected function slideoutpanel1_creationCompleteHandler(event:FlexEvent):void
			{
				id_editprofileview.id_cancelBtn.addEventListener(MouseEvent.CLICK, function(evt:MouseEvent):void 
				{					
					CloseHandler(evt);
				});

				if(model.addressBookStaticDataDTO == null)
				{
					var abSDEvent : LoadAddressBookStaticDataEvent = new LoadAddressBookStaticDataEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( abSDEvent );
				}
			}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				this.ToggleSlideOut();
				event.stopImmediatePropagation();
			}
			
			protected function CloseHandler(event:MouseEvent):void
			{
				if (id_editprofileview.id_viewmodePersonal.visible == false)
				{
					Alert.show("Unsaved changes will be lost, do you want to exit?",	"Are you sure?", Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, function( event:CloseEvent):void
					{
						if( event.detail == Alert.YES )
						{							
							dispatchEvent( new CloseEvent("close") );
						}
						else if( event.detail == Alert.NO )
						{
							//onNo.call( noParams );
						}
					});	
				}
				else
				{
					dispatchEvent( new CloseEvent("close") );
					
				}
			}
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<custom:HeaderContents>
		<s:SkinnableContainer id="id_header" height="22" width="100%" minWidth="{ChromeUtil.AppWidth - 18}" skinClass="com.adobe.Quivus.view.controls.skins.PatientRegHeaderSkin">
			<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="left" >
				<s:Label  paddingLeft="12" color="#111111" paddingTop="6" fontFamily="Calibri Bold" text="{headerLabel}" />
				<mx:Spacer width="100%" />
			</s:HGroup>
			<s:HGroup horizontalAlign="right" width="100%" paddingRight="1" paddingTop="0" gap="0">
				<buttonSeparators:buttonSeparatorGrey />
				<s:HGroup paddingTop="0">
					<s:Button skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.QICrossButtonSkin"
							  buttonMode="true" useHandCursor="true" toolTip="Close Edit Profile Panel" click="CloseHandler(event)"/>
				</s:HGroup>
				<buttonSeparators:buttonSeparatorGrey />
				<s:HGroup paddingTop="0">
					
					<s:ToggleButton id="id_expandBtn" 
									skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.expandButton_grey" 
									buttonMode="true" useHandCursor="true" toolTip="{id_expandBtn.selected?'Collapse':'Expand'}"/>
				</s:HGroup>
				<buttonSeparators:buttonSeparatorGrey />
				<s:HGroup paddingTop="0" paddingRight="0">
					<s:ToggleButton id="id_slideoutBtn" 
									skinClass="com.adobe.Quivus.view.controls.skins.toggleButtonSkins.slideOutBtn"
									buttonMode="true" useHandCursor="true" toolTip="{id_slideoutBtn.selected?'Slide-In':'Slide-Out'}" 
									width="18" height="18"  click="button1_clickHandler(event)" />
				</s:HGroup>
			</s:HGroup>
		</s:SkinnableContainer>
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		<s:SkinnableContainer height="22" width="100%" minWidth="550" skinClass="com.adobe.Quivus.view.controls.skins.PatientRegHeaderSkin">
			<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="center" >
				<s:Label  paddingLeft="12" color="#ffffff" paddingTop="6" fontFamily="Calibri Bold" text="{headerLabel}" />				
			</s:HGroup>
		</s:SkinnableContainer>
	</custom:SlideHeaderContents>
	
	<custom:Contents>
		<s:VGroup paddingTop="-5" gap="0" height="100%" width="100%" verticalAlign="top" horizontalAlign="center" paddingLeft="{isSlideOut? 10:0}" >
			<s:VGroup paddingTop="{isSlideOut? 2:2}" gap="-2" height="100%" width="100%"  verticalAlign="top" horizontalAlign="center" >
				<s:SkinnableContainer width="100%" height="100%"  minHeight="30" skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.grayPanelBodySkin">		
					<s:layout>
						<s:HorizontalLayout paddingTop="7" paddingBottom="5" verticalAlign="middle" horizontalAlign="center" />
					</s:layout>
					<view2:EditProfileView id="id_editprofileview"  width="100%" height="100%" clinicBranchID="{model.userSelectedStationDTO.ClinicBranchID}" userID="{model.loggedInUserDTO.UserId}"
											 PhoneNumberTypes="{model.addressBookStaticDataDTO.PhoneNumberTypes}" 
											 LoggedInUserIsProvider="{model.userSelectedRoleDTO.UserTypeRole.IsProvider}"
											 LoggedInUserTypeID="{model.userSelectedRoleDTO.UserTypeRole.UserTypeId}"	/>
				</s:SkinnableContainer>
			
				<s:Button id="id_CloseBtn" 
						  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.closeBtnSkin" 
						  click="CloseHandler(event)" buttonMode="true" useHandCursor="true" toolTip="{toolTipLabel+headerLabel.toLowerCase()}"/>
			</s:VGroup>
		</s:VGroup>
	</custom:Contents>
	
</custom:SlideOutPanel>
