			//New quickInput implementation true
			protected function ViewBackgroundPanel_CreateVisitUIHandler(event:CreateVisitUIEvent):void
			{
				if(id_QIPanel.visible)
				{
					return ;
				}
					
				else
				{
					updateModelForQuickInput();
					
					QIModelLocator.getInstance().patientID = model.patientDTO.PatientId;
					QIModelLocator.getInstance().gaxenID = model.gaxenID;
					
					var lp:LoadPatientbyPatientIDEvent = new LoadPatientbyPatientIDEvent(model.patientDTO.PatientId, function(patientDTO:PatientDTO):void
					{
						QIModelLocator.getInstance().patientDTO = patientDTO;
						QIModelLocator.getInstance().gaxenID 	= patientDTO.GAXENID;
					});	
					
					CairngormEventDispatcher.getInstance().dispatchEvent(lp); 
					
					if(event.createNewVisit)
					{
						CreateVisit(event.visitDate);// New Visit
					}
					else // Load previous visit
					{
						var NV: LoadModuleNotesByVisitIdEvent = new LoadModuleNotesByVisitIdEvent();
						CairngormEventDispatcher.getInstance().dispatchEvent(NV);
						
						var DE: LoadModuleDictationByVisitIdEvent= new LoadModuleDictationByVisitIdEvent();
						CairngormEventDispatcher.getInstance().dispatchEvent(DE);
					}
					
					
					/**
					 * Ayesha 19/02/2013
					 * Every time quickinput is loaded, Chronic diagnosis of that patient will also be loaded*/
					var ev:LoadPatientChronicDiagnosisByPatientIdEvent = new LoadPatientChronicDiagnosisByPatientIdEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent(ev);
					
					id_QIPanel.AppearUI(event.createNewVisit);
					id_QIPanel.visible = true;
					id_QIPanel.ExpandedView = true;
					
					m_oViewbackgroundPanel.expandedView = false;
					id_PatientProfilePanel.ExpandedView = false;
					
				}
			}
			
			// By Moeen , to bind the values to the newQI			
			public function CreateVisit(createDate:Date):void
			{
				var visit:VisitDTO = new VisitDTO(	model.patientDTO.PatientId,
					model.loggedInUserDTO.UserId,
					model.userSelectedRoleDTO.UserTypeRole.UserTypeId,
					0,
					0,
					model.userSelectedStationDTO.StationID,
					model.placeOfServiceID ,
					model.loggedInUserDTO.UserId,
					createDate,
					createDate,model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq);
				
				QIModelLocator.getInstance().VisitDate = createDate;
				
				var cve:CreateVisitEvent = new CreateVisitEvent(visit);
				CairngormEventDispatcher.getInstance().dispatchEvent( cve );
			}
			
