				currentSlideOutPanel 						= comingSoonPanel;
				currentSlideOutPanel.percentWidth 			= 100;
				id_patientExamArea.addElementAt( currentSlideOutPanel, 0 );
				
				comingSoonPanel.addEventListener( CloseEvent.CLOSE, removeCurrentSlidePanel); 
				
				id_MainBGPanel.addElementAt(currentSlideOutPanel, 0);
				id_MainBGPanel.includeInLayout 	= true;
				id_MainBGPanel.visible			= true;
			}
			
