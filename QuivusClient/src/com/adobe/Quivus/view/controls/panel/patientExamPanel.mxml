				} */
			}
			
			protected function id_patientExamControls_PatientSelectedHandler(event:PatientSelectedEvent):void
			{
				clearOldData();
				var selectedPatient:PatientDTO 	= event.selection as PatientDTO;
				model.selectedPatientDTO        = event.selection as PatientDTO;
				model.gaxenID					= selectedPatient.GAXENID;
				if( !AppUtils.IsNullOrEmpty( model.loadedPatientId ) )
				{					
					Alert.show(Constants.MSG_SURE_CLOSE_PATIENT, Constants.MSG_CLOSE_PATIENT, Alert.YES | Alert.NO, FlexGlobals.topLevelApplication.mainContainer, 
						function quickInputCloseHandler(e:CloseEvent):void
						{
							if( e.detail == Alert.YES )
							{
								//RemoveQuickInputPanel();
								RemoveViewbackgroundPanel();
								OnLoadingPatient( event );
								AddViewbackgroundPanel();
							}
						});
				}
				else
				{
					OnLoadingPatient( event );
					AddViewbackgroundPanel();
				}
				//AddViewbackgroundPanel(); When patient loaded and remove old patient just hide the VB summary and visible it on new Load
				
				if(selectedPatient.GAXENID != '')
				{
					model.gaxenIDSaved 				= true;
					loadAllergyPrescription(selectedPatient.GAXENID)
				}else
				{
					//clearOldData();
				}
				
				event.stopImmediatePropagation();
				event.preventDefault();
			}
			private function loadAllergyPrescription(gaxenID:String):void
			{
				loadAllergies(gaxenID);
				loadPrescription(gaxenID);
			}
			
			private function OnLoadingPatient(event:PatientSelectedEvent):void
			{
				RemoveRecentPatientPanel();
				this.ExpandedView 								= true;
				//this.allowSlideOut							= true;
				//id_PatientProfilePanel.ExpandedView 			= true;
				id_PatientProfilePanel.includeInLayout			= true;
				id_PatientProfilePanel.visible					= true;
				switchSearchView();
				RemoveQuickInputPanel();
				allowUserControl( true );
				//time to load patient data, user sucessfully selected a patient...
				dispachServiceEvents( event.selection.ID, event.selection.UserID);
				clearPatientData();
			}
			
			private function OnEmailAddressResult(value:String):void
			{
				patientEmail = value;
				if( currentSlideOutPanel is emailPanel)
				{
					(currentSlideOutPanel as emailPanel).id_emailView.id_email.text = value;
					//trace("OnEmailAddressResult", value);
				}
			}
			
			private function AddEmailPanel():void
			{
				var emailui:emailPanel 		= new emailPanel();
				emailui.EmailAddress		= patientEmail;
				emailui.percentWidth 		= 100;
				currentSlideOutPanel 			= emailui;
				emailui.ShowAttachButton 	= true;
				emailui.ExpandedView 		= true;
				id_patientExamArea.addElementAt( emailui, 0 );
				emailui.addEventListener(CloseEvent.CLOSE, removeCurrentSlidePanel);
				
				id_MainBGPanel.addElementAt(currentSlideOutPanel, 0);
				id_MainBGPanel.includeInLayout 	= true;
				id_MainBGPanel.visible			= true;
			}
			
			private function LoadRecentPatientList():void
			{
				if( ! LoadUserMostRecentPatientEvent.isAlreadyLoaded  )// load only if not loaded ... 
				{
					var mrpEvent : LoadUserMostRecentPatientEvent = new LoadUserMostRecentPatientEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( mrpEvent );
				}
			}
			
			private function AddRecentPatientPanel():void
			{
				LoadRecentPatientList();
				
				var recentPatientPanel:RecentPatientPanel	= new RecentPatientPanel();
				BindingUtils.bindProperty( recentPatientPanel, "DataProvider", model, "mostRecentPatientList" );
				recentPatientPanel.DataProvider 			= model.mostRecentPatientList;
				recentPatientPanel.percentWidth				= 100;
				recentPatientPanel.ExpandedView 			= true;
				id_patientExamArea.addElementAt( recentPatientPanel, 0 );
				recentPatientPanel.addEventListener(CloseEvent.CLOSE, function (event:Event):void
				{
					RemoveRecentPatientPanel();
				});
				recentPatientPanel.id_RecentPatientView.addEventListener(AppEventStrings.PATIENT_SELECTED_EVENT, onRecentPaitentSelected);
				currentSlideOutPanel 							= recentPatientPanel;
				
				id_MainBGPanel.addElementAt(currentSlideOutPanel, 0);
				id_MainBGPanel.includeInLayout 	= true;
				id_MainBGPanel.visible			= true;
				
				switchSearchView();			
			}
			
			private function RemoveRecentPatientPanel():void
			{
				removeCurrentSlidePanel();
				id_patientExamControls.id_RecentPatientBtn.selected = false;
				if( id_PatientProfilePanel.visible == false )
				{
					this.ExpandedView = false;
				}
				
				switchSearchView();
			}
			
			protected function onRecentPaitentSelected(event:PatientSelectedEvent):void
			{
				if( model.loadedPatientId == event.selection.PatientId )
				{
					Alert.show(Constants.MSG_ALREADY_LOADED_PATIENT, Constants.MSG_SAME_PATIENT, Alert.OK, FlexGlobals.topLevelApplication.mainContainer );
					switchSearchView();
					return;
					
				}
				if( !AppUtils.IsNullOrEmpty( model.loadedPatientId ) )
				{
					Alert.show(Constants.MSG_SURE_CLOSE_PATIENT, Constants.MSG_CLOSE_PATIENT, Alert.YES | Alert.NO, FlexGlobals.topLevelApplication.mainContainer, 
						function quickInputCloseHandler(e:CloseEvent):void
						{
							if( e.detail == Alert.YES )
							{
								onRecentPaitentSelected2(event );
							}
						});
				}
				else
				{
					onRecentPaitentSelected2(event );
				}
				
				if(model.loadedPatientId)
				{
					switchSearchView();
				}
				
				AddViewbackgroundPanel();
				//ShowProgressWindow("Loading Patient");
				//UtilityFunctions.showBusyPointer();
			}
			
			protected function onRecentPaitentSelected2(event:PatientSelectedEvent):void
			{
				try
				{
					clearOldData();
					clearPatientData();
					allowUserControl( true );
					id_PatientProfilePanel.InitComponent();
					//model.selectedPatientDTO        				=  event.selection as PatientDTO;//For Qi Load
					id_patientExamControls.id_emailBtn.enabled 		=  event.selection.IsEmailIdAvailable;
					id_patientExamControls.id_snailBtn.enabled 		=  event.selection.IsSnailIdAvailable;
					id_patientExamControls.id_messageBtn.enabled 	=  event.selection.IsChatIdAvailable;
					id_patientExamControls.id_commentBtn.enabled 	=  event.selection.IsSMSNoAvalable;
					id_patientExamControls.id_PhoneBtn.enabled 		=  event.selection.IsPhoneNoAvailable;
					
					//time to load patient data, user sucessfully selected a patient...
					dispachServiceEvents( event.selection.PatientId, event.selection.PatientUserID);
					RemoveQuickInputPanel();
