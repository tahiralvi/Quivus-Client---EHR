				}
			}
			
			protected function searchpatientview1_PatientSelectedHandler(event:PatientSelectedEvent):void
			{
				clearOldData();
				var selectedPatient:PatientDTO 	= event.selection as PatientDTO;
				model.selectedPatientDTO		= event.selection as PatientDTO;
				//todo.. jawad
				
				/* id_emailBtn.enabled 			= selectedPatient.IsEmailIdAvailable;
				id_snailBtn.enabled 			= selectedPatient.IsSnailIdAvailable;
				id_messageBtn.enabled 			= selectedPatient.IsChatIdAvailable;
				id_commentBtn.enabled 			= selectedPatient.IsSMSNoAvalable;
				id_PhoneBtn.enabled 			= selectedPatient.IsPhoneNoAvailable;  */
				
				//update ui / FE event
				var ps:PatientSelectedEvent = new PatientSelectedEvent(AppEventStrings.PATIENT_SELECTED_EVENT);
				ps.selection = selectedPatient;
				dispatchEvent( ps );
				
				//update model / BE events
				var lppEvent : LoadPatientProfilePopUpDataEvent = new LoadPatientProfilePopUpDataEvent(selectedPatient.ID);
				CairngormEventDispatcher.getInstance().dispatchEvent( lppEvent );
				
				if(model.userPatientProfileBarSettingTemp==null)
				{
					var lppcsEvent : LoadPatientProfileCustomizedSettingEvent = new LoadPatientProfileCustomizedSettingEvent(selectedPatient.ID,true);
					CairngormEventDispatcher.getInstance().dispatchEvent( lppcsEvent );
				}
				else
				{
					lppcsEvent = new LoadPatientProfileCustomizedSettingEvent( selectedPatient.ID, false);
					CairngormEventDispatcher.getInstance().dispatchEvent( lppcsEvent );
				}
				
				switchSearchView();
				AddViewbackgroundPanel();
				//load 
				model.gaxenID  = selectedPatient.GAXENID;
				if( model.gaxenID != '')
				{
					model.gaxenIDSaved 		= true;
					loadAllergyPrescription(selectedPatient.GAXENID);
				}
				else
				{
					//clearOldData();
				}
			}
			
			public function loadAllergies(GaxenID:String):void
			{
				if(GaxenID.length > 0 && GaxenID != "" && GaxenID != "0")
				{
					var alEvent : QSAllergyEvent = new QSAllergyEvent(2, GaxenID, callBackAllergy);
					CairngormEventDispatcher.getInstance().dispatchEvent( alEvent ); 
				}
			}
			private function callBackAllergy(arrAllergy:ArrayCollection):void
			{
				model.ThirdSectionLabel = '';
				if(model.QIAllergyDTOList)
					model.QIAllergyDTOList.removeAll();
				else
					model.QIAllergyDTOList = new ArrayCollection();
				
				model.QIAllergyDTOList.addAll(arrAllergy);
				
				if(model.QIAllergyDTOList.length > 0)
				{					
					var allergyDto:AllergDTO = new AllergDTO();
					allergyDto			= model.QIAllergyDTOList.getItemAt(0) as AllergDTO;
					//Tahir Alvi - Set Third Section data && NKDA LAbel Flag
					
					if(!allergyDto.isNKDA)
					{
						model.ThirdSectionLabel = allergyDto.AllergyName;
						model.AllergyNKDAFlag 	= false;
					}
					else if(allergyDto.isNKDA)
					{
						model.ThirdSectionLabel = 'No Known Drug Allergies';
						model.AllergyNKDAFlag 	= true;
					}
				}
				
				//Ayesha 28/02/2013
				//on loading allergies, VB Model should be updated
				VBModelLocator.getInstance().updateVBAllergies(model.gaxenID, model.QIAllergyDTOList, model.ThirdSectionLabel, model.AllergyNKDAFlag);
			}
			
			public function loadPrescription(GaxenID:String):void
			{
				var securityHeaderXML:XML;
				securityHeaderXML	 			= <Header />;					
				securityHeaderXML.@EUserName	= "TESTUSER";
				securityHeaderXML.@EPassword	= "TESTPASS";
				securityHeaderXML.@ClinicID		= "sad";
				//trace("Going to load prescription for "+GaxenID);
				model.gaxenID = GaxenID;//Tahir Alvi - assign patient gaxen id
				
				if(GaxenID.length > 0 && GaxenID != "" && GaxenID != "0")
				{
					var loadPatientPrescriptionEvent: LoadPatientMedEvent = new LoadPatientMedEvent("0", GaxenID, PrescriptionLoaded);				
					loadPatientPrescriptionEvent.data = securityHeaderXML; 				
					CairngormEventDispatcher.getInstance().dispatchEvent(loadPatientPrescriptionEvent);
				}
				else
				{
					if(model.patientMedACList)
						model.patientMedACList.removeAll();
					if(model.patientChronicMedACList)
						model.patientChronicMedACList.removeAll();
					if(model.patientMedAC_inactiveList)
						model.patientMedAC_inactiveList.removeAll();
					if(model.patientChronicMedAC_inactiveList)
						model.patientChronicMedAC_inactiveList.removeAll();
				}
			}
			
			public function PrescriptionLoaded(patientMedAC:ArrayCollection, patientChronicMedAC:ArrayCollection, patientMedAC_inactive:ArrayCollection, patientChronicMedAC_inactive:ArrayCollection):void
			{
				if(model.patientMedACList)
					model.patientMedACList.removeAll();
				else
					model.patientMedACList = new ArrayCollection();
				
				if(model.patientMedAC_inactiveList)
					model.patientMedAC_inactiveList.removeAll();
				else
					model.patientMedAC_inactiveList = new ArrayCollection();
				
				if(model.patientChronicMedAC_inactiveList)
					model.patientChronicMedAC_inactiveList.removeAll();
				else
					model.patientChronicMedAC_inactiveList = new ArrayCollection();
				
				if(model.patientChronicMedACList)
					model.patientChronicMedACList.removeAll();
				else
					model.patientChronicMedACList = new ArrayCollection();
				
				//For QI load
				if(model.chMedicationDTOList)
					model.chMedicationDTOList.removeAll();
				else
					model.chMedicationDTOList = new ArrayCollection();
				
				if(model.prescriptionDToList)
					model.prescriptionDToList.removeAll();
				else
					model.prescriptionDToList = new ArrayCollection();
				
				model.patientMedACList 						= patientMedAC;//prescription list
				model.patientChronicMedACList 				= patientChronicMedAC;//medication list
				model.patientMedAC_inactiveList			 	= patientMedAC_inactive;
				model.patientChronicMedAC_inactiveList	 	= patientChronicMedAC_inactive;
				model.chMedicationDTOList 					= patientChronicMedAC;//for Qi
				model.prescriptionDToList 					= patientMedAC;//for Qi
				
				//Ayesha 28/02/2013
				//on loading prescription, VB Model should be updated
				VBModelLocator.getInstance().updateVBPrescription(model.gaxenID, model.patientMedACList, model.patientChronicMedACList, model.patientMedAC_inactiveList, 
					model.patientChronicMedAC_inactiveList, model.chMedicationDTOList, model.prescriptionDToList);
			}
			// Clear Allergies Prescription and chronic medication on every patient Load
			// Tahir Alvi - Clear All previous visit or VB summary data when patient is switch to new patient
			private function clearOldData():void
			{
				// for VB summary and detail
				if(model.patientMedACList)
					model.patientMedACList.removeAll();
				if(model.patientChronicMedACList)
					model.patientChronicMedACList.removeAll();
				if(model.patientMedAC_inactiveList)
					model.patientMedAC_inactiveList.removeAll();
				if(model.patientChronicMedAC_inactiveList)
					model.patientChronicMedAC_inactiveList.removeAll();
				
				//For QI load
				if(model.chMedicationDTOList)
					model.chMedicationDTOList.removeAll();
				if(model.prescriptionDToList)
					model.prescriptionDToList.removeAll();
				
				if(model.QIAllergyDTOList)
					model.QIAllergyDTOList.removeAll();
			}
			//--clear fron end data before close/load and load new patient
			private function clearPatientData():void
			{
				model.patientName 			='';
				model.gaxenID 				= '';
				model.ThirdSectionLabel 	= '';
				model.gaxenIDSaved 			= false;
				if(model.QIAllergyDTOList)
					model.QIAllergyDTOList.removeAll();
			}

			
