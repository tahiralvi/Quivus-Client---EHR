			private function onRecentPatientClick(event:MouseEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleViewable( QSSecurityUtil.RECENT_PATIENT_PANEL ) )
				{
					event.stopImmediatePropagation(); //button is clicked not the header itself, stop it...
					if( ! id_patientExamControls.id_RecentPatientBtn.selected &&
						currentSlideOutPanel is RecentPatientPanel )
					{
						RemoveRecentPatientPanel();
						return;
					}
					
					removeCurrentSlidePanel();
					
					if( null == currentSlideOutPanel )
					{
						AddRecentPatientPanel();
					}
					
					event.stopImmediatePropagation();
					
					this.ExpandedView  = true;
					//				this.allowSlideOut = true;
				}
			}
			
			private function onEmailClick(event:MouseEvent):void
			{
				event.stopImmediatePropagation();
				if( QSSecurityUtil.Security.IsModuleViewable( QSSecurityUtil.EMAIL ) )
				{
					if( currentSlideOutPanel is emailPanel ) //! id_patientExamControls.id_emailBtn.selected &&
					{
						removeCurrentSlidePanel();
						return;
					}
					
					if( null == currentSlideOutPanel )
					{
						AddEmailPanel();
						id_patientExamControls.id_OptionPopUp.displayPopUp = false;
						this.ExpandedView = true;
						switchSearchView();
					}
				}
			}
			
			public function removeConnectors():void
