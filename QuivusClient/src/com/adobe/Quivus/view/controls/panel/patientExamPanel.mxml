			private function removeCurrentSlidePanel(event:CloseEvent = null):void
			{
				if( currentSlideOutPanel && currentSlideOutPanel != id_PatientProfilePanel )	//don't remove above panels.
					//currentSlideOutPanel != m_oQuickInputPanel 			//user will explicitly remove this panel.
					
				{
					if( id_MainBGPanel.contains( currentSlideOutPanel ) )
					{
						id_MainBGPanel.removeElement( currentSlideOutPanel );
						id_MainBGPanel.includeInLayout 	= false;
						id_MainBGPanel.visible			= false;
						switchSearchView();
					}
					else if(id_VB.contains( currentSlideOutPanel ) )
					{
						id_VB.removeElement( currentSlideOutPanel );
					}
					else
						id_patientExamArea.removeElement( currentSlideOutPanel );
					
					removeConnectors();		
				}
				currentSlideOutPanel = null;
				ExpandDefaultPanel();
			}
			
			private function ExpandDefaultPanel():void
