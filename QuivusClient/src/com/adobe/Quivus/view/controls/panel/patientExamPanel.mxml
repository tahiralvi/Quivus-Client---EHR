			public function switchSearchView():void
			{
				if( !AppUtils.IsNullOrEmpty( model.loadedPatientId ) )
				{
					if(model.basicUserDTO)
					{
						patientName = model.basicUserDTO.FirstName+' '+ model.basicUserDTO.LastName;
					}
					//patientName = model.userPatientProfileBarInfoPopUpData.PatientProfileBasicInfoData.FirstName + ' ' +  model.userPatientProfileBarInfoPopUpData.PatientProfileBasicInfoData.LastName;					
					patientName = patientName.toUpperCase();
				}
				else
				{
					patientName = "Patient Search";
				}
				
				if(model.loadedPatientId != 0 && id_MainBGPanel.includeInLayout == false)
				{
					//if patient is loaded then change the skin..
					// patient loaded at first level..
					id_patientExamControls.id_patientSearchBoxContainer.visible = true;
					id_patientExamControls.id_patientSearchBoxContainer.setStyle("skinClass", patientSearchBGSkinNew);
					//remove patient search view from profile header..
					id_patientExamControls.id_PatientImage.includeInLayout = true;
					id_patientExamControls.id_PatientImage.visible = true;
					id_patientExamControls.id_PatientNameGroup.includeInLayout = true;
					id_patientExamControls.id_PatientNameGroup.visible = true;
					//Tahir			id_patientExamControls.lbl_PatientName.text = patientName;
					id_patientExamControls.id_patientSearch.visible = false;
					id_patientExamControls.id_patientSearch.includeInLayout = false;
					id_patientSearchBoxContainer.includeInLayout = false;
					id_patientSearchBoxContainer.visible = false;
					//id_PatientProfilePanel.headerOverBody = false;
				}
				else if(model.loadedPatientId != 0 && id_MainBGPanel.includeInLayout == true)
				{
					//if patient is loaded then change the skin..
					id_patientExamControls.id_patientSearchBoxContainer.visible = false;
					id_patientExamControls.id_patientSearch.visible = false;
					id_patientExamControls.id_patientSearch.includeInLayout = false;
					//id_patientExamControls.id_patientSearchBoxContainer.includeInLayout = false;
					
					id_patientSearchBoxContainer.includeInLayout = true;
					id_patientSearchBoxContainer.visible = true;
					
					id_patientSearch.includeInLayout	 = true;
					id_patientSearch.visible			 = true;
					id_PatientImage.includeInLayout      = true;
					id_PatientImage.visible	             = true;
					//Tahir		lbl_PatientName.text 				= patientName;
