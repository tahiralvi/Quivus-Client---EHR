					id_patientExamControls.id_patientSearchBoxContainer.visible = true;
					id_patientExamControls.id_patientSearchBoxContainer.alpha = 1;
					id_patientExamControls.id_patientSearchBoxContainer.setStyle("skinClass", patientSearchBGSkin);			
					
					id_patientExamControls.id_PatientImage.includeInLayout = false;
					id_patientExamControls.id_PatientImage.visible = false;
					//id_patientExamControls.id_patientSearch.id_patientSearchTextInput.setStyle("skinClass",noHudTextInput );
