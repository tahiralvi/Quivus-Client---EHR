			private var _hasViewChanged:Boolean;
			private var _hasGridChanged:Boolean;
			
			[Bindable]
			public function get hasViewChanged():Boolean
			{
				return _hasViewChanged;
			}
			
			public function set hasViewChanged(value:Boolean):void
			{
				_hasViewChanged = value;
			}
			private var moduleConstantName:String = Constants.PHYSICAL_MODULE_NAME;
			private var vb_IsModelUpdated:Boolean;
			
			public function get IsModelUpdated():Boolean{
				
				return vb_IsModelUpdated;
				
			}
			
			public function set IsModelUpdated(value:Boolean):void{
				
				vb_IsModelUpdated = value;
				
				if(vb_IsModelUpdated )
				{
					var notesDTOList:ArrayCollection = QSUtilityFunctions.getModuleNoteListForViewBackGround
						( moduleConstantName);
					var dictationDTOList:ArrayCollection = QSUtilityFunctions.getModuleDictationListForViewBackGround
						(moduleConstantName);
					
					/* if(notesDTOList && notesDTOList.length > 0) {
					id_header.id_NotesBtn.setStyle("skinClass", VBnotesBtnSelected); 
					} else {
					id_header.id_NotesBtn.setStyle("skinClass", VBnotesBtn);
					}
					
					if( dictationDTOList && dictationDTOList.length > 0) {
					id_header.id_Voice.setStyle("skinClass", VBdictationBtnSelected);
					} else {
					id_header.id_Voice.setStyle("skinClass", VBdictationBtn);
					} */
					
					if(dictationDTOList && dictationDTOList.length > 0)
					{
						id_header.id_Voice.setStyle("skinClass", VBdictationBtnSelected);
						id_header.id_iconButtons.setStyle("skinClass", VBIconsButtonFilled);
					}
					
					if(notesDTOList && notesDTOList.length > 0)
					{
						id_header.id_NotesBtn.setStyle("skinClass", VBnotesBtnSelected);
						id_header.id_iconButtons.setStyle("skinClass", VBIconsButtonFilled);
					}		
					
				}
			}
			public function GridRowNumber(item:Object, iCol:int):String
			{
				var strRowNum:String = "";
				
				if (id_DataGrid.dataProvider)
				{
					var rowNum:int = id_DataGrid.dataProvider.getItemIndex(item) + 1;
					strRowNum = String(rowNum);
				}
				
				return strRowNum;
			}
			protected function button1_clickHandler(event:MouseEvent):void
			{
				/* var mpiEvent : ManagePatientImmunizationEvent = new ManagePatientImmunizationEvent(  );
				CairngormEventDispatcher.getInstance().dispatchEvent( mpiEvent ); */
				if(model.physicalsDTOListVB!=null){
					model.physicalsDTOListVB.filterFunction=myFilter;
					model.physicalsDTOListVB.refresh();
				}
			}
			
			private function myFilter(obj:*):Boolean
			{
				
				if(model.vbFilter == Constants.BY_VISIT)
				{
					if(model.vbVisitId == obj.VisitID)
					{
						return true;
					}
					else
					{
						return false;
					}
				}
				
				return true;
				
			}
			
			private var notesGridPanel:VBSectionNotes;
			private var m_oNotesDTOList:ArrayCollection;
			private var dictationGridPanel:VBSectionDictation;
			
			public function get notesDTOList():ArrayCollection
			{
				return m_oNotesDTOList;
			}
			
			public function set notesDTOList(value:ArrayCollection):void
			{
				m_oNotesDTOList = value;
			}
			//var dictationDTOList:ArrayCollection = UtilityFunctions.getModuleDictationListForViewBackGround(Constants.PHYSICAL_MODULE_NAME);
			protected function slideoutpanel1_creationCompleteHandler(event:FlexEvent):void
			{
				if(this.ExpandedView)
				{
					id_header.HeadingLable = id_header.HeadingLable.toUpperCase();
				}
				else
				{
					id_header.HeadingLable = id_header.HeadingLable.toLowerCase();
				}
				id_header.id_OptionPopUp.displayPopUp = true;
				id_header.id_iconButtons.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					//if(id_Area.visible)
					{
						
						if(id_header.id_OptionPopUp.displayPopUp)
						{
							id_header.id_iconButtons.setStyle("skinClass", VBIconsBlackButton);
						}
						else
						{
							id_header.id_iconButtons.setStyle("skinClass", VBIconsButton);	
						}
					}
					
				});	
				id_header.id_Voice.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					var notesDTOList:ArrayCollection = QSUtilityFunctions.getModuleNoteListForViewBackGround
					( moduleConstantName);
					var dictationDTOList:ArrayCollection = QSUtilityFunctions.getModuleDictationListForViewBackGround
					(moduleConstantName);
					
					id_notesDictation.notesDTOList = notesDTOList;
					id_notesDictation.DictationDTOList = dictationDTOList;
					id_notesDictation.id_Area.visible 		= true;
					id_notesDictation.id_Area.includeInLayout = true;
					//id_notesDictation.id_VBViews.selectedIndex = 1;						
					id_header.id_iconButtons.setStyle("skinClass", VBIconsBlackButton);
					id_header.id_iconButtons.selected = false;
					id_header.id_OptionPopUp.displayPopUp = false;
					
					if(this.ExpandedView)
					{
						event.stopImmediatePropagation();
					}
				});			
				
				id_header.id_slideoutBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					ToggleSlideOut();
					event.stopImmediatePropagation();
				});
				
				id_header.id_NotesBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					var notesDTOList:ArrayCollection = QSUtilityFunctions.getModuleNoteListForViewBackGround
					( moduleConstantName);
					var dictationDTOList:ArrayCollection = QSUtilityFunctions.getModuleDictationListForViewBackGround
					(moduleConstantName);
					
					id_notesDictation.notesDTOList = notesDTOList;
					id_notesDictation.DictationDTOList = dictationDTOList;
					{
						id_notesDictation.id_Area.visible 		= true;
						id_notesDictation.id_Area.includeInLayout = true;						
						//id_notesDictation.id_VBViews.selectedIndex = 0;
						id_header.id_iconButtons.setStyle("skinClass", VBIconsBlackButton);
						id_header.id_iconButtons.selected = false;
						id_header.id_OptionPopUp.displayPopUp = false;
						
					}
					
					if(this.ExpandedView)
					{
						event.stopImmediatePropagation();
					}
				});
				id_header.id_OptionPopUp.displayPopUp = false;
				
				if(this.ExpandedView)
				{
					//id_header.id_pmhHeader.setStyle("skinClass", VBinternalBarSkin);	
				}
				else
				{
				//	id_header.id_pmhHeader.setStyle("skinClass", VBInternalBarInactiveSkin);
				}
			//}

				id_DataGrid.addEventListener(DataGridActionsEvent.DELETE_RECORD_CLICK, deleteRecordClickHandler, false, 0, true);
				id_DataGrid.addEventListener(DataGridActionsEvent.EDIT_RECORD_CLICK, editRecordClickHandler, false, 0, true);
			}
			
			private function preInitializeHandler():void
			{
				if (!deleteColumnData)
					deleteColumnData = {};
				
				deleteColumnData["noteDataFields"] 		= {subject: "NoteSubject", note: "Notes", header: "SubCategoryName", statusFunction:RecordLevelNotesStatus};
				deleteColumnData["dictationDataField"] 	= "DictationID";
				deleteColumnData["recordIDField"] 		= "PatientPhysicalID";
				deleteColumnData["section"] 			= QIPopUpManager.VB_PHYSICAL;
			}
			
			private function RecordLevelNotesStatus(hasNotes:Boolean, data:Object):void
			{
				if( hasNotes ) 
					data.IsNormal = Constants.STRING_FALSE;
				else
					data.IsNormal = Constants.STRING_TRUE;
				
				model.physicalsDTOListVB.refresh();
			}
			
			private function filterDeletedItems(item:Object):Boolean
			{
				var b:Boolean = item["IsDeleted"];
				return (!b);
			}
			
			private function deleteRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.VB_PHYSICAL ))//Tahir Alvi - implement security check
				{
					var curTar:LabelDataGrid = LabelDataGrid(event.currentTarget);
					
					if (curTar.selectedItem)
					{
						var pID:int = PhysicalsDTO(curTar.selectedItem).PatientPhysicalID;
						
						if (pID == 0)
						{
							model.physicalsDTOListVB.removeItemAt(curTar.selectedIndex);
							if (model.physicalsDTOListVB.length <= 0)
							{
								_hasGridChanged = false;
								//hasViewChanged = isGetEdited();
							}
						}
						else
						{
							UtilityFunctions.AskMessage(  "Do you want to delete selected record", function():void
							{
								curTar.selectedItem.IsDeleted = true;
								model.physicalsDTOListVB.filterFunction = filterDeletedItems;
								model.physicalsDTOListVB.refresh();
								
								hasViewChanged = _hasGridChanged = true;
							});
						}
					}
					
				}
			}
			
			private function editRecordClickHandler(event:DataGridActionsEvent):void
			{
				id_DataGrid.editable = true;
				var rowIndex:int = id_DataGrid.selectedIndex;
				var itemToSetInEditableMode:IListItemRenderer = id_DataGrid.indexToItemRenderer(rowIndex);
				
				var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
				ev.columnIndex = 2;
				ev.rowIndex = rowIndex;
				ev.itemRenderer = itemToSetInEditableMode;
				ev.dataField = "DateAdmin";
				
				id_DataGrid.dispatchEvent(ev);
			}
			public function displayStatus(oItem:Object,iCol:int):String
			{
				//Tahir - New implementation of IsAbnormal property in PhysicalsDTO
				var result:String;
				var isNormal:Boolean = (oItem as PhysicalsDTO).IsNormal 	== Constants.STRING_TRUE;
				var isAbNormal:Boolean = (oItem as PhysicalsDTO).IsAbNormal == Constants.STRING_TRUE;

				if(isNormal)
				{
					result =  "Normal";
				}
				else // if(isAbNormal)
				{
					result =  "Abnormal";
				}
				return result; 
			}
			
			protected function slideoutpanel1_QSViewStateChangeHandler(event:QSViewStateEvent):void
			{
				if(id_header && id_header.id_pmhHeader)
				{
					if(event.viewState == QSViewStateEvent.EXPANDED_VIEW)
					{				
						
						//id_header.id_pmhHeader.setStyle("skinClass", VBinternalBarSkin);
						id_header.HeadingLable = id_header.HeadingLable.toUpperCase();
						id_header.id_expandBtn.selected = true;
					}
					else
					{
						//id_header.id_pmhHeader.setStyle("skinClass", VBInternalBarInactiveSkin);
						id_header.HeadingLable = AppUtils.TitleCase(id_header.HeadingLable);
						id_header.id_expandBtn.selected = false;
					}
				}
			}


			protected function id_DataGrid_itemEditBeginHandler(event:DataGridEvent):void
			{
				id_DataGrid.createItemEditor(event.columnIndex, event.rowIndex);
			}


			protected function id_DataGrid_itemEditEndHandler(event:DataGridEvent):void
			{
				if(event.columnIndex == 4)
				{
					//var editor_cb:ComboBox = SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor;
					var isYes:String = (id_DataGrid.itemEditorInstance as YesNoItemEditor).isYes;
					
					
					
					isYes = (id_DataGrid.itemEditorInstance as YesNoItemEditor).isYes;
					//event.itemRenderer.data.Educated = isYes == Constants.STRING_TRUE ? Constants.STRING_YES_UI : Constants.STRING_NO_UI ;
					
					event.itemRenderer.data.IsNormal = isYes == Constants.STRING_TRUE ? Constants.STRING_YES_UI : Constants.STRING_NO_UI ;
					event.itemRenderer.data.IsAbNormal = isYes == Constants.STRING_TRUE ? Constants.STRING_NO_UI : Constants.STRING_YES_UI ;
					
					/* event.itemRenderer.data.IsNormal = editor_cb.textInput.text == "Normal" ? true: false;
					event.itemRenderer.data.IsAbNormal = editor_cb.textInput.text == "Abnormal" ? true: false; */
					event.itemRenderer.data.IsDirty = true; 					
					
				}
			}
			
			private function switchPageForGridView( event:Event ):void
			{
				
				if( UtilityFunctions.IsNullOrEmpty( model.physicalsCurrentPageByPatient ) )
					model.vitalCurrentPageByPatient = new PageDTO();
				
				var pvital:PageDTO 		= model.vitalCurrentPageByPatient;
				pvital.fromDate 		= model.defaultFilterAndPaging.fromDate;
				pvital.toDate 			= model.defaultFilterAndPaging.toDate;
				pvital.pageSize 		= model.defaultFilterAndPaging.pageSize;
				pvital.LastVisitNumber 	= model.defaultFilterAndPaging.LastVisitNumber;
				
				var lpp:LoadPatientPhysicalsByPatientIdEvent = new LoadPatientPhysicalsByPatientIdEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( lpp );
			}

			protected function id_PaginationFilterView_RefreshViewHandler(event:Event):void
			{
				var lpp:LoadPatientPhysicalsByPatientIdEvent = new LoadPatientPhysicalsByPatientIdEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( lpp );
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Binding source="model.vbDataLoadedFlag" destination="IsModelUpdated" />
	<custom:HeaderContents>
		<s:Group id="id_mainHeader" width="100%" height="24" minWidth="{ChromeUtil.topLevelMainContainer.width - 70}">
			<s:layout>
				<s:VerticalLayout verticalAlign="bottom" horizontalAlign="center" />
			</s:layout>
			<viewBackground:VBSectionHeader id="id_header" width="{id_mainHeader.width - 8}" HeadingLable="{Constants.VB_SECTION_NAME_PHYSICAL}" SectionNameID="{QSSecurityUtil.VB_PHYSICAL}"
											Skin="com.adobe.Quivus.view.controls.skins.SkinnableContainers.VBPhysicalPanelSkin" />						   
		</s:Group>
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		<viewBackground:VBSectionSlideoutHeader width="100%" label="{Constants.VB_SECTION_NAME_PHYSICAL}" />
		
	</custom:SlideHeaderContents>
	<custom:Contents>
		<s:SkinnableContainer id="id_contents" width="100%" height="100%" skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.VBPhysicalPanelSkin">
			<s:layout>
				<s:VerticalLayout horizontalAlign="center" verticalAlign="top" gap="1" paddingLeft="4" paddingRight="4" paddingBottom="4" paddingTop="4" />
			</s:layout>
			<!--<s:HGroup id="id_NotesArea" width="100%" paddingTop="0" />-->
			
			<viewBackground:VBSectionLevelNotesDictation id="id_notesDictation" width="100%" />
			
			<s:Button label="Filter" click="button1_clickHandler(event)" visible="false"
					  includeInLayout="false" id="id_applyFiler"/>
			<paging:PaginationFilterView id="id_PaginationFilterView" width="100%" Page="{model.physicalsCurrentPageByPatient}"
										 GoToFirstPage="switchPageForGridView(event)" GoToNextPage="switchPageForGridView(event)" 
										 GoToPreviousPage="switchPageForGridView(event)" GoToLastPage="switchPageForGridView(event)"
										 RefreshView="id_PaginationFilterView_RefreshViewHandler(event)"
										 />
			<components1:LabelDataGrid id="id_DataGrid" width="100%" useRollOver="false" height="100%"
						 dataProvider="{model.physicalsDTOListVB}" rowCount="{id_DataGrid.dataProvider.length + 1}" verticalScrollPolicy="auto"
						 maxHeight="150"
						  itemEditBegin="id_DataGrid_itemEditBeginHandler(event)"
						  itemEditEnd="id_DataGrid_itemEditEndHandler(event)">
				<components1:columns>
					<mx:DataGridColumn headerText="Sr.#" width="50" labelFunction="GridRowNumber" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
					<mx:DataGridColumn headerText="Visit Date" width="80" dataField="VisitDate" 
									   itemRenderer="com.adobe.Quivus.view.controls.custom.itemRenderer.DateRenderer4DG" headerRenderer="mx.controls.Label" wordWrap="true"/>
					<mx:DataGridColumn headerText="Physical" dataField="MainCategoryName" width="120" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" editable="false"/>
					<mx:DataGridColumn headerText="Type Value" dataField="SubCategoryName" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" editable="false"/>
					<!--<mx:DataGridColumn headerText="Status"  labelFunction="displayStatus" width="70" headerWordWrap="true" wordWrap="true"/>-->
					<mx:DataGridColumn headerText="Status" dataField="IsNormal" labelFunction="displayStatus" width="70" editorDataField="isYes"
									   itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true">	
						<!--<mx:itemEditor>
						<fx:Component>
						<itemEditors:SparkComboBoxItemEditor dataProvider="{outerDocument.id_normal}" />
						</fx:Component>
						</mx:itemEditor>	-->
						<mx:itemEditor>
							<fx:Component>
								<diagnosis:YesNoItemEditor width="100%" height="90%" property="IsYesSelected" isNormalAbnormal="true"/>								
							</fx:Component>
						</mx:itemEditor>
					</mx:DataGridColumn>	
					<commons:DataGridColumnEx width="85" data="{deleteColumnData}" itemRenderer="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.commons.VBRenderer" editable="false"/>
				</components1:columns>
			</components1:LabelDataGrid>
			
		</s:SkinnableContainer>
	</custom:Contents>
</custom:SlideOutPanel>
