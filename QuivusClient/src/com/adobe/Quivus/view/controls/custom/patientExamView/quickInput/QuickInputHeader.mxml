						event.stopImmediatePropagation();
				}
			}
			// Place of service change handler
			protected function id_PlaceOfService_changeHandler(event:IndexChangeEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_VISIT_PROPERTIES ) )
				{
					model.placeOfServiceID 		  						= id_PlaceOfService.selectedItem.ServiceTypeID;
					model.placeOfServiceName      						= id_PlaceOfService.selectedItem.POSDescription;
					
					model.visitDTO.PlaceOfServiceTypeID 				= id_PlaceOfService.selectedItem.ServiceTypeID;
					model.quickInputDTO.Visit.PlaceOfServiceTypeID 		= id_PlaceOfService.selectedItem.ServiceTypeID;
					model.quickInputDTO.Visit.PlaceOfServiceTypeName 	= id_PlaceOfService.selectedItem.POSDescription;
					
				}else
				{
					if(event)
						event.stopImmediatePropagation();
				}
			}
			// Encounter Type Click handler
			protected function EncounterType_clickHandler(event:MouseEvent):void
			{
				if(!QSSecurityUtil.Security.IsModuleViewable( QSSecurityUtil.QI_VISIT_PROPERTIES ) )
				{
					if(event)
						event.stopImmediatePropagation();
				}
				event.stopImmediatePropagation();
			}
			// Place of service click handler
			protected function id_PlaceOfService_clickHandler(event:MouseEvent):void
			{
				if( !QSSecurityUtil.Security.IsModuleViewable( QSSecurityUtil.QI_VISIT_PROPERTIES ) )
				{
					if(event)
						event.stopImmediatePropagation();
				}
				event.stopImmediatePropagation();
			}
			// Set encounter type item
			private function setEncounterTypeItem(encounterTypeId:int):void
			{
				if (id_EncounterType.dataProvider)
				{
					for (var i:int=0; i < id_EncounterType.dataProvider.length; i++)
					{
						var item:EncounterTypeDTO = EncounterTypeDTO(id_EncounterType.dataProvider[i]);
						if (encounterTypeId == item.VisitEncounterTypeID)
						{
							id_EncounterType.selectedIndex = i;
							break;
						}
					}
				}
			}
			// Set place of service item
			private function setPlaceOfService(serviceTypeId:int):void
			{
				if (id_PlaceOfService.dataProvider)
				{
					for (var i:int=0; i < id_PlaceOfService.dataProvider.length; i++)
					{
						var item:PlaceOfServiceTypeDTO = id_PlaceOfService.dataProvider[i] as PlaceOfServiceTypeDTO;
						if (serviceTypeId.toString() == item.ServiceTypeID)
						{
							id_PlaceOfService.selectedIndex 					= i;
							model.placeOfServiceID 		  						= id_PlaceOfService.selectedItem.ServiceTypeID;
							model.placeOfServiceName      						= id_PlaceOfService.selectedItem.POSDescription;
							
							model.visitDTO.PlaceOfServiceTypeID 				= int(item.ServiceTypeID);
							model.quickInputDTO.Visit.PlaceOfServiceTypeID 		= int(item.ServiceTypeID);
							model.quickInputDTO.Visit.PlaceOfServiceTypeName 	= item.POSDescription;
							break;
						}
					}
				}
			}
			// Encounter Type creation complete hadnler
			protected function id_EncounterType_creationCompleteHandler(event:FlexEvent):void
			{
				selectEncounterType();
			}
			// Place of service creation complete hadnler
			protected function id_PlaceOfService_creationCompleteHandler(event:FlexEvent):void
			{
				selectPlaceOfService();
			}
			// Select encounter type
			private function selectEncounterType():void
			{
				if(model.encounterTypeDTOList && isNewVisit)
				{
					if(model.encounterTypeDTOList.length >0)
					{
						for(var i:uint=0; i<model.encounterTypeDTOList.length; i++)
						{
							var encounterTypeDTO:EncounterTypeDTO =  model.encounterTypeDTOList[i] as EncounterTypeDTO;
							if(encounterTypeDTO.EncounterTypeName == 'Complete PE')
							{
								id_EncounterType.selectedIndex = i;
								break;
							}
						}
					}
				}
			}
			// Select place of service
			private function selectPlaceOfService():void
			{
				if(model.placeOfServiceList && isNewVisit)
				{
					if(model.placeOfServiceList.length >0)
					{
						for(var i:uint=0; i<model.placeOfServiceList.length; i++)
						{
							var placeOfServiceTypeDTO:PlaceOfServiceTypeDTO =  model.placeOfServiceList[i] as PlaceOfServiceTypeDTO;
							if(placeOfServiceTypeDTO.POSCode == '11')
							{
								id_PlaceOfService.selectedIndex = i;
								model.placeOfServiceID 		  = int(placeOfServiceTypeDTO.ServiceTypeID);
								model.placeOfServiceName      = placeOfServiceTypeDTO.POSDescription;
								
								model.visitDTO.PlaceOfServiceTypeID 				= int(placeOfServiceTypeDTO.ServiceTypeID);
								model.quickInputDTO.Visit.PlaceOfServiceTypeID 		= int(placeOfServiceTypeDTO.ServiceTypeID);
								model.quickInputDTO.Visit.PlaceOfServiceTypeName 	= placeOfServiceTypeDTO.POSDescription;
								break;
							}
						}
					}
				}
			}
