				var pLoc:Point = id_IndicatorGrp.localToGlobal( new Point( id_dictationIndicator.x - 125 +  (id_dictationIndicator.width /2) , id_dictationIndicator.y + 14) );
				dictationPanel.move( pLoc.x, pLoc.y );*/
				
			}
			
			protected function nextSection_clickHandler(event:MouseEvent):void
			{
				if( id_DiagnosisView.id_AddRecord.enableAll )
				{
					UtilityFunctions.AskMessage( "There are changes in the form, do you still want to leave form in current state?", function ():void
					{
						dispactchSelectSectionEvent();
					}); 
				}
				else
				{
					dispactchSelectSectionEvent();
				}
			}
			
			private function dispactchSelectSectionEvent():void
			{
				dispatchEvent( new SelectSection('SelectSection', 'id_DiagnosisPanel', true, true) )
			}
			
			
			protected function id_DiagnosisView_creationCompleteHandler(event:FlexEvent):void
			{
				id_DiagnosisView.id_nextBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{					
					AllowMoveToNextPanel( dispactchSelectSectionEvent );
				});
			}
			
			public override function AllowMoveToNextPanel( callBack:Function ):void
			{
				if( id_DiagnosisView.id_AddRecord.enableAll )
				{
					UtilityFunctions.AskMessage( "There are changes in the form, do you still want to leave form in current state?", function ():void
					{
						callBack(); 
					}); 
				}
				else
				{
					callBack();
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Binding source="model.quickInputDataLoadedFlag" destination="IsModelUpdated" /> 
	<fx:Binding source="id_DiagnosisView.hasViewChanged" destination="hasChange"  /> 
	
	
	<custom:HeaderContents>
		<quickInput:PMHSectionHeader id="id_Header" width="100%" height="22" minWidth="{ChromeUtil.topLevelMainContainer.width - 70}" HeadingLable="Diagnosis" SectionNameID="{QSSecurityUtil.QI_DIAGNOSIS}"/>
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		
		<s:SkinnableContainer width="100%" minHeight="36" height="100%"  skinClass="com.adobe.Quivus.view.controls.skins.QISlideHeaderOuterSkin">						
			<s:layout>
				<s:HorizontalLayout horizontalAlign="center" verticalAlign="middle" paddingRight="5" />
			</s:layout>
			<custom:slideOutQIHeader Label="Diagnosis" width="100%" height="22" />								   
		</s:SkinnableContainer>				   
		
	</custom:SlideHeaderContents>
	<custom:Contents>
		
		<s:SkinnableContainer id="sc_Diagnosis" skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.QISectionBGSkin" width="{id_Header.width}" 
							  visible="{model.securityProxyObject.PatientExam.QuickInput.Assessment.Diagnosis.IsViewAllowed}" includeInLayout="{sc_Diagnosis.visible}">
			<s:layout>
				<s:VerticalLayout  verticalAlign="top" gap="0"   horizontalAlign="{isSlideOut? 'right':'center'}" paddingRight="3"
								   paddingTop="{isSlideOut? -2:0}" paddingLeft="{isSlideOut? 1:1}"/>
			</s:layout>
			<!--<s:VGroup width="{id_Header.width}" verticalAlign="top" gap="0" 
			horizontalAlign="{isSlideOut? 'right':'center'}" paddingTop="{isSlideOut? -2:0}" paddingLeft="{isSlideOut? 30:1}">-->
			<notes:QISectionLevelNotesDictation id="id_notesDictation" width="100%" 
												/>
			<s:SkinnableContainer skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.QISectionBGSkin" width="{id_Header.width}" minHeight="50">
				<s:layout>
					<s:VerticalLayout gap="-7" horizontalAlign="right"  paddingLeft="3" paddingRight="3" paddingTop="1" paddingBottom="5"/>
				</s:layout>
				
				<diagnosis:DiagnosisView id="id_DiagnosisView" width="100%" creationComplete="id_DiagnosisView_creationCompleteHandler(event)" />
				<s:HGroup width="100%">					
					<s:HGroup id="id_IndicatorGrp" width="100%" horizontalAlign="left" >
						<s:Button id="id_noteIndicator" label="Notes" visible="false" includeInLayout="{id_noteIndicator.visible}"
								  click="id_noteIndicator_clickHandler(event)" toolTip="View Notes" 
								  useHandCursor="true" buttonMode="true" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.notesIndicatorBtnSkin" />
						<s:Button id="id_dictationIndicator" label="Dictation" visible="false" includeInLayout="{id_dictationIndicator.visible}"
								  click="id_dictationIndicator_clickHandler(event)" toolTip="Play Dictation" 
								  useHandCursor="true" buttonMode="true" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.dictationIndicatorBtnSkin"/>
					</s:HGroup>
					<s:Group id="id_spacer" width="100%" height="2" />
					
				</s:HGroup>
			</s:SkinnableContainer>
		</s:SkinnableContainer>
	</custom:Contents>
</custom:PinableSlideOutPanel>
