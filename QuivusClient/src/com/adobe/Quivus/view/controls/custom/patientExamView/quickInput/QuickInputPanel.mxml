				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.REVIEW_HISTORY ) )
				{
					showReviewAllPopUp.ShowPopup(FlexGlobals.topLevelApplication.mainContainer);
					showReviewAllPopUp.title = "Review All";
					var loadreviewhistroyevent:CairngormEvent = new LoadReviewHistroyEvent (model.sessionDTO.SessionID,model.visitDTO.VisitId,model.visitDTO.UserId,callBackFunction);
					CairngormEventDispatcher.getInstance().dispatchEvent(loadreviewhistroyevent);
					return;
				}
				
			}
			private  function callBackFunction():void
			{
				showReviewAllPopUp.allSelected();
				
			}
			
			private function setLoadedVisitEncountryTypeInCombo():void
			{
				
				if(model.visitDTO!=null && model.visitDTO.EncounterTypeId>0 && model.encounterTypeDTOList!=null)
				{
					var i:int;
					for(i=0;i<model.encounterTypeDTOList.length;i++)
					{
						var dto:EncounterTypeDTO = model.encounterTypeDTOList.getItemAt(i) as EncounterTypeDTO;
						if(dto.VisitEncounterTypeID == model.visitDTO.EncounterTypeId)
						{
							//							id_header.id_EncounterType.searchFromBeginning = i;
							break;
							
						}
					}
					
				}
				
			}
			
			/**
			 * Ayesha: 18th May 2011
			 * checkAndSetEncounterType() returns true if encounter type is selected else false
			 **/
			private function checkAndSetEncounterType():Boolean
			{
				var isEncounterTypeSelected:Boolean = false;
				
				if(model.visitDTO!=null && model.visitDTO.EncounterTypeId>0 && model.visitDTO.VisitId==0)
				{
					return true;
				} 
				// Tahir Alvi - this is done in Quick Input header on change/select/creation complete.
				/* if( id_header.id_PlaceOfService.selectedItem )
				{
				model.visitDTO.PlaceOfServiceTypeID = ( id_header.id_PlaceOfService.selectedItem as PlaceOfServiceTypeDTO ).ServiceTypeID as int ;
				model.quickInputDTO.Visit.PlaceOfServiceTypeID =  Number ( ( id_header.id_PlaceOfService.selectedItem as PlaceOfServiceTypeDTO ).ServiceTypeID ) as int ;
				model.quickInputDTO.Visit.PlaceOfServiceTypeName = ( id_header.id_PlaceOfService.selectedItem as PlaceOfServiceTypeDTO ).POSDescription ;
				} */
				
				if (id_header.id_EncounterType.selectedItem)
				{
					isEncounterTypeSelected = true;
					
					model.encounterTypeId 						= (id_header.id_EncounterType.selectedItem as EncounterTypeDTO).VisitEncounterTypeID;
					model.quickInputDTO.Visit.EncounterTypeId 	= (id_header.id_EncounterType.selectedItem as EncounterTypeDTO).VisitEncounterTypeID;
					model.quickInputDTO.Visit.EncounterTypeName	= (id_header.id_EncounterType.selectedItem as EncounterTypeDTO).EncounterTypeName;
					model.visitDTO.EncounterTypeId 				= (id_header.id_EncounterType.selectedItem as EncounterTypeDTO).VisitEncounterTypeID;
				}
				else if (id_header.id_EncounterType.selectedIndex > -1)
				{
					isEncounterTypeSelected = true;
					
					model.encounterTypeId 						= (id_header.id_EncounterType.dataProvider.getItemAt(id_header.id_EncounterType.selectedIndex) as EncounterTypeDTO).VisitEncounterTypeID;
					model.quickInputDTO.Visit.EncounterTypeId 	= (id_header.id_EncounterType.dataProvider.getItemAt(id_header.id_EncounterType.selectedIndex) as EncounterTypeDTO).VisitEncounterTypeID;
					model.visitDTO.EncounterTypeId 				= (id_header.id_EncounterType.dataProvider.getItemAt(id_header.id_EncounterType.selectedIndex) as EncounterTypeDTO).VisitEncounterTypeID;
				}
				else
				{
					/* Alert.show("Please select visit encounter type", "Encounter type missing", Alert.OK, FlexGlobals.topLevelApplication.mainContainer,
					function():void
					{
					id_header.id_EncounterType.setFocus();
					}); */
					isEncounterTypeSelected = true;
					if(model.visitDTO!=null)
					{
						if(model.encounterTypeDTOList!=null && model.encounterTypeDTOList.length>0)
						{
							model.visitDTO.EncounterTypeId = (model.encounterTypeDTOList.getItemAt(0) as EncounterTypeDTO).VisitEncounterTypeID;
						}
					}
				}
				
				return isEncounterTypeSelected;
			}
			
