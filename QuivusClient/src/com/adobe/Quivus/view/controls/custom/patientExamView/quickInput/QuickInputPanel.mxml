			private function set quickInputDTO(value:QuickInputDTO):void
			{
				if (value)
				{
					if (value.Visit && model.visitDTO && value.Visit != model.visitDTO)
					{
						/**
						 * Visit import:
						 * import visit is like creating/updating visit, so visit in quickInputDTO should be 
						 * the same as in model.visitDTO
						 * read encounter type from imported visit assign it to model.visitDTO.EncounterTypeId
						 **/
						model.visitDTO.EncounterTypeId = value.Visit.EncounterTypeId;
						
						value.Visit = model.visitDTO;
						value.VisitId = model.visitDTO.VisitId;
					}
				}
			}
			
			
