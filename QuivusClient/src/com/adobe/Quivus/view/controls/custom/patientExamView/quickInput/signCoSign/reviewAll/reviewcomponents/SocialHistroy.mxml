<?xml version="1.0" encoding="utf-8"?>
<components1:CollapsiblePanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
							 xmlns:s="library://ns.adobe.com/flex/spark" 
							 title="Social Histroy" skinClass="com.adobe.quivus.skins.chrome.containerSkins.checkboxCollapsiblePanelSkin" 
							 xmlns:mx="library://ns.adobe.com/flex/mx" 
							 xmlns:components="com.zigron.controls.extended.components.*" xmlns:components1="com.gazuntite.controls.extended.components.*">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			[Bindable]
			private var model:AppModelLocator = AppModelLocator.getInstance();
			
			
			[Bindable]
			override public function set isSelected(value:Boolean):void
			{
				super.isSelected = value;
				
				model.reviewHistroy.IsSocialReviewed = value;
			}
			
		]]>
	</fx:Script>
	<components:layout>
		<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5"/>
	</components:layout>
	<components1:LabelDataGrid id="id_SocialHistroy" horizontalScrollPolicy="off" verticalScrollPolicy="auto" width="100%" maxHeight="150"
							  rowCount="{id_SocialHistroy.dataProvider.length?id_SocialHistroy.dataProvider.length:1}"
							  columnWidths="{['30%','20%','20%','30%']}" verticalGridLines="false"
							  dataProvider="{model.socialHistoryDTOListByPatient}"
							  >
		<components:columns>
			<mx:DataGridColumn  headerText="Description" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" dataField="Social"/>
			<mx:DataGridColumn  headerText="Type" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label"  dataField="Type"/>
			<mx:DataGridColumn  headerText="Amount" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" dataField="Amount"/>
			<mx:DataGridColumn  headerText="Status" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label"  dataField="Status"/>
			<mx:DataGridColumn  headerText="Notes" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label"  dataField="Note"/>
		</components:columns>
	</components1:LabelDataGrid>
</components1:CollapsiblePanel>

