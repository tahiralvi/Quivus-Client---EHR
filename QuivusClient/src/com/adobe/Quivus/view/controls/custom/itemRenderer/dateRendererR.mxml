<?xml version="1.0" encoding="utf-8"?>
<s:MXDataGridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
						  xmlns:s="library://ns.adobe.com/flex/spark" 
						  xmlns:mx="library://ns.adobe.com/flex/mx" 
						  focusEnabled="true">
	<fx:Declarations>
		<mx:DateFormatter id="formatDateTime" formatString="MM/DD/YYYY" />
	</fx:Declarations>
	<s:Label id="lblData" top="0"  fontFamily="Calibri" fontSize="12" width="75"  verticalCenter="0" horizontalCenter="0"
			 text="{formatDateTime.format(dataGridListData.label)}" maxDisplayedLines="1" />
</s:MXDataGridItemRenderer>
