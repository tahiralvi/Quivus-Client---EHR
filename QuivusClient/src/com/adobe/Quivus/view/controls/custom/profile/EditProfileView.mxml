		 xmlns:registeration="com.adobe.Quivus.view.controls.registeration.*" xmlns:components1="com.gazuntite.controls.extended.components.*" >
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.events.staticData.addressBook.LoadCitiesByStateIdEvent;
			import com.adobe.Quivus.events.staticData.addressBook.LoadZipcodesByStateIdAndCityNameEvent;
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.Constants;
			import com.adobe.Quivus.view.controls.registeration.PhoneNumberAddMoreTitleWindow;
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.controls.extended.skins.LabelTextInputRequiredSkin;
			import com.gazuntite.controls.extended.skins.comboBoxRegisterationRequiredSkin;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.events.IndexChangeEvent;
			
			import valueObjects.CityDTO;
			import valueObjects.StateDTO;
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			private var phoneNumberAddMorePopUp:PhoneNumberAddMoreTitleWindow;
			private var personalPhoneNumbers:ArrayCollection;
			
			protected function id_PhoneNumberAddMore_creationCompleteHandler(event:FlexEvent):void
			{
				id_PhoneNumberAddMore.id_TelNumber.setStyle("skinClass", LabelTextInputRequiredSkin);
				id_PhoneNumberAddMore.id_TelNumberKind.setStyle("skinClass", comboBoxRegisterationRequiredSkin);
			}
			
			protected function id_Gender_creationCompleteHandler(event:FlexEvent):void
			{
				id_Gender.setStyle("skinClass", comboBoxRegisterationRequiredSkin);
			}
			
			protected function id_State_changeHandler(event:IndexChangeEvent):void
			{
				if (event.newIndex > -1)
				{
					var state:StateDTO  = id_State.selectedItem;
					if(model.zipcodeList!=null){
						model.zipcodeList.removeAll();
					}
					var qlEvent : LoadCitiesByStateIdEvent = new LoadCitiesByStateIdEvent(state.StateID,Constants.PERSONAL);
					CairngormEventDispatcher.getInstance().dispatchEvent( qlEvent );
				}
				else
				{
					id_City.selectedIndex = -1;
					id_ZIP.selectedIndex = -1;
					
					id_City.dataProvider = null;
					id_ZIP.dataProvider = null;
				}
			}
			
			protected function id_City_changeHandler(event:IndexChangeEvent):void
			{
				var city:CityDTO  	= id_City.selectedItem as CityDTO;
				var state:StateDTO  = id_State.selectedItem as StateDTO;
				if(model.zipcodeList!=null)
				{
					model.zipcodeList.removeAll();
				}
				if( city && state )
				{
					var qlEvent : LoadZipcodesByStateIdAndCityNameEvent = new LoadZipcodesByStateIdAndCityNameEvent(state.StateID,city.CityName,Constants.PERSONAL);
					CairngormEventDispatcher.getInstance().dispatchEvent( qlEvent );
				}
			}
			
			private function AddMorePhoneNumbers(event:Event):void
			{
				if (!personalPhoneNumbers)
					personalPhoneNumbers = new ArrayCollection();
				
				if (!personalPhoneNumbers.length)
				{
					var result:Object = id_PhoneNumberAddMore.isInValid(true);
					if (result.hasOwnProperty("isNotValid") && result.isNotValid)
					{
						if (result.hasOwnProperty("errorStr") && result.errorStr)
						{
							Alert.show(result.errorStr, "Phone number entry error", 4, FlexGlobals.topLevelApplication.mainContainer, function():void
							{
								if (result.hasOwnProperty("toSetFocus") && result.toSetFocus)
									result.toSetFocus.setFocus();
							});
						}
						return;
					}
					personalPhoneNumbers.addItem(id_PhoneNumberAddMore.getPhoneNumberDetails());
				}
				
				if (!phoneNumberAddMorePopUp)
					phoneNumberAddMorePopUp = new PhoneNumberAddMoreTitleWindow();
				
				if (!phoneNumberAddMorePopUp.phoneNumbers)
					phoneNumberAddMorePopUp.phoneNumbers = personalPhoneNumbers;
				
				var btn:Button = Button(event.currentTarget);
				
				var pt:Point = btn.parent.localToGlobal(new Point(btn.x, btn.y));
				
				pt.x += btn.width/2 - 100;
				pt.y += btn.height;
				
				phoneNumberAddMorePopUp.display(this, pt);
			}
			
		]]>
	</fx:Script>
