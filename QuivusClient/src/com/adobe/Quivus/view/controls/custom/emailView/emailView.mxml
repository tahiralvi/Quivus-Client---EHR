<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 height="100%"
		 xmlns:components1="com.gazuntite.controls.extended.components.*"
		 creationComplete="group1_creationCompleteHandler(event)" 
		 >

	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.gazuntite.skins.chrome.textInputSkins.optionalTextArea;
			
			import mx.events.FlexEvent;
			
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			private var emailAddress:String;
			[Bindable]
			public function get EmailAddress():String
			{
				return emailAddress;
			}
			
			public function set EmailAddress(value:String):void
			{
				emailAddress = value;
				trace("set email", value);
			} 
			

			protected function id_SendBtn_clickHandler(event:MouseEvent):void
			{
				// see emailPanle for Send functionality
				
				id_Sending.visible = true;
			}


			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				id_Sending.visible = false;
			}

		]]>
	</fx:Script>

	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
	</s:layout>
	
	<s:HGroup width="100%" >
		<!--<mx:Button label="" id="id_SendBtn" buttonMode="true" useHandCursor="true" toolTip="Click here to send an Email"
		upSkin="@Embed('com/adobe/Quivus/view/controls/skins/assets/mainContainer.swf', symbol='btn_email_send')"	  
		overSkin="@Embed('com/adobe/Quivus/view/controls/skins/assets/mainContainer.swf', symbol='btn_email_send_over')"
		downSkin="@Embed('com/adobe/Quivus/view/controls/skins/assets/mainContainer.swf', symbol='btn_email_send_over')"
		
		click="id_SendBtn_clickHandler(event)"
		/>-->
		
		<s:Button id="id_SendBtn" buttonMode="true" useHandCursor="true" click="id_SendBtn_clickHandler(event)"
				  toolTip="Click here to send an Email" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.btn_Email_emailpanel" />
		
		
		
		<s:VGroup width="100%" >
			<s:HGroup width="100%" verticalAlign="middle" >
				<s:Label color="#ffffff" text="To" width="50" textAlign="right" />
				<components1:LabelTextInput id="id_email" width="100%" fontFamily="Calibri" text="{ this.EmailAddress }" prompt="Email Address"  />
			</s:HGroup>
			<s:HGroup width="100%" verticalAlign="middle"  >
				<s:Label color="#ffffff" text="Subject" width="50" textAlign="right" fontFamily="Calibri" />
				<components1:LabelTextInput id="id_subject" width="100%" fontFamily="Calibri" prompt="Subject" />
			</s:HGroup>
		</s:VGroup>
	</s:HGroup>
	<s:Label id="id_Sending" text="Sending ... " visible="true" includeInLayout="{id_Sending.visible}" fontFamily="Calibri"  />
	<components1:LabelTextArea  id="id_message" width="100%" height="100%" fontFamily="Calibri" prompt="Email "
							   skinClass="com.adobe.Quivus.view.controls.skins.textAreaReqSkin" />
</s:Group>
