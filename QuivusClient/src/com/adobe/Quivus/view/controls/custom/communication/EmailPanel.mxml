<?xml version="1.0" encoding="utf-8"?>
<custom:SlideOutPanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:custom="com.adobe.Quivus.view.controls.custom.*" 
					  xmlns:view="com.gazuntite.provider.services.sms.view.*" 
					  xmlns:communication="com.adobe.Quivus.view.controls.custom.communication.*" 
					  
					  creationComplete="slideoutpanel1_creationCompleteHandler(event)" xmlns:view1="com.zigron.provider.services.email.view.*" xmlns:view2="com.gazuntite.provider.services.email.view.*"
					  >
	
	<fx:Metadata>
		[Event(name="close", type="mx.events.CloseEvent")]
	</fx:Metadata>
	<fx:Script>
		<![CDATA[
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			
			
			private var _EmailAddress:String;
			private var _userID:int;
			
			protected function CloseHandler(event:MouseEvent = null):void
			{
				dispatchEvent( new CloseEvent(CloseEvent.CLOSE) );
			}
			
			
			protected function slideoutpanel1_creationCompleteHandler(event:FlexEvent):void
			{
				id_header.id_slideoutBtn.addEventListener(MouseEvent.CLICK, SlideoutHandler);
				id_header.id_btnClose.addEventListener(MouseEvent.CLICK, CloseHandler);
				
			}
			
			protected function SlideoutHandler(event:MouseEvent):void
			{
				this.ToggleSlideOut();
				event.stopImmediatePropagation();
			}

			public function get EmailAddress():String
			{
				return _EmailAddress;
			}

			public function set EmailAddress(value:String):void
			{
				_EmailAddress = value;
			}

			public function get userID():int
			{
				return _userID;
			}

			public function set userID(value:int):void
			{
				_userID = value;
			}

			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	
	<custom:HeaderContents>
		<s:Group width="100%" height="22">
			<s:layout>
				<s:VerticalLayout paddingLeft="{isSlideOut? 5:0}"  horizontalAlign="center" />
			</s:layout>
			
			<communication:CommunicationHeaderView id="id_header" minWidth="560" width="100%" height="22" />
			
		</s:Group>
		
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		<!--<custom:slideOutGreyHeader minWidth="{id_contents.width}" />				-->		   
		
		<s:SkinnableContainer height="22" width="100%" minWidth="550" skinClass="com.adobe.Quivus.view.controls.skins.PatientRegHeaderSkin">
			<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="center" >
				<s:Label  paddingLeft="12" color="#ffffff" paddingTop="6" fontFamily="Calibri Bold" text="COMMUNICATIONS" />				
				
			</s:HGroup>
			
		</s:SkinnableContainer>
		
	</custom:SlideHeaderContents>
	<custom:Contents>
		
		
		
		<s:VGroup paddingTop="-3" gap="0" height="100%" width="{id_header.width}" verticalAlign="top" horizontalAlign="center"
				  paddingLeft="{isSlideOut? 10:0}" maxHeight="450" 
				  >
			<s:BorderContainer height="100%" width="100%" cornerRadius="3" backgroundColor="#999AAA" borderAlpha="0" borderColor="#999AAA">
				<s:layout>
					<s:HorizontalLayout paddingTop="0" horizontalAlign="left" />
					
					
				</s:layout>
				
				<view2:CommunicationView width="100%" height="100%"   EmailAddress ="{EmailAddress}" userID="{userID}"/>
				
			</s:BorderContainer>
			
			<s:Button id="id_CloseBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.closeBtnSkin" 
					  click="CloseHandler(event)" buttonMode="true" useHandCursor="true" toolTip="Close Email Section"/>
			
			
		</s:VGroup>
		
	</custom:Contents>
	
</custom:SlideOutPanel>
