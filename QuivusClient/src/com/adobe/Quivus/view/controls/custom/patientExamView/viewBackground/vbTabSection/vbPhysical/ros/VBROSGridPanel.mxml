			private function switchPageForGridView( event:Event ):void
			{
				
				if( UtilityFunctions.IsNullOrEmpty( model.rosCurrentPageByPatient ) )
					model.rosCurrentPageByPatient = new PageDTO();
				
				var pvital:PageDTO 		= model.rosCurrentPageByPatient;
				pvital.fromDate 		= model.defaultFilterAndPaging.fromDate;
				pvital.toDate 			= model.defaultFilterAndPaging.toDate;
				pvital.pageSize 		= model.defaultFilterAndPaging.pageSize;
				pvital.LastVisitNumber 	= model.defaultFilterAndPaging.LastVisitNumber;
				
				var lpros:LoadPatientROSByPatientIdEvent = new LoadPatientROSByPatientIdEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( lpros );
			}
			
