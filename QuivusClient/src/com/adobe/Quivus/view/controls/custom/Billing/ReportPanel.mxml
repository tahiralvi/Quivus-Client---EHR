<?xml version="1.0" encoding="utf-8"?>
<components1:PopupWindow xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.adobe.gazuntite.skins.chrome.titleWindowSkins.reviewAllWindowSkin"
					  creationComplete="CreationCompleteHandler(event)" width="100%" height="100%" 
					  xmlns:components1="com.gazuntite.controls.extended.components.*"
					  >
<!--	skinClass="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.assessment.diagnosis.TitleWindowSkin"-->
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.Constants;
			import com.gazuntite.provider.live.services.billing.util.BillingConstants;
			
			import mx.events.FlexEvent;		
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			protected function CreationCompleteHandler(event:FlexEvent):void
			{
				//var appendParameters:String = "";					
				id_html.location = Constants.BILLING_REPORT_BASE_URL + "?ID=" + BillingConstants.REPORT_ID +"&TypeID=" + 
																				BillingConstants.REPORT_TYPE_ID + 
																				BillingConstants.REPORT_PARAMETERS;
				
				BillingConstants.REPORT_PARAMETERS = "";
			}

			protected function id_html_completeHandler(event:Event):void
			{
				id_loading.visible = false;
				id_loading.includeInLayout = false;				
			}
			
		]]>
	</fx:Script>
		
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<components1:layout>
		<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5"/>
	</components1:layout>
		<s:Label id="id_loading" text="Loading............" width="100%" visible="true" includeInLayout="true" fontWeight="bold"/>
		<mx:HTML id="id_html" width="100%" height="600" complete="id_html_completeHandler(event)"/>
</components1:PopupWindow>
