<?xml version="1.0" encoding="utf-8"?>
<itemEditors:ComboBoxItemEditor xmlns:fx="http://ns.adobe.com/mxml/2009" 
								xmlns:s="library://ns.adobe.com/flex/spark" 
								xmlns:mx="library://ns.adobe.com/flex/mx" xmlns:itemEditors="com.adobe.Quivus.view.controls.custom.itemEditors.*"
								keyUp="diagnosisItemEditorKeyUpHandler(event)" dataProvider="{model.icdCodeDTOList}">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.events.staticData.lab.LoadICDCodeEvent;
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			
			import mx.events.IndexChangedEvent;
			import mx.events.ListEvent;
			
			[Bindable]
			public var model : AppModelLocator = AppModelLocator.getInstance();
			
			private function diagnosisItemEditorKeyUpHandler(event:KeyboardEvent):void
			{
				if (event.keyCode != 9)
				{
					var curTarget:* = event.currentTarget;
					
					if (curTarget.text.length > 2)
					{
						var icdEvent : LoadICDCodeEvent = new LoadICDCodeEvent(curTarget.text);
						CairngormEventDispatcher.getInstance().dispatchEvent( icdEvent );
						curTarget.dataProvider = model.icdCodeDTOList;
					}
				}
			}
			
		]]>
	</fx:Script>
</itemEditors:ComboBoxItemEditor>
