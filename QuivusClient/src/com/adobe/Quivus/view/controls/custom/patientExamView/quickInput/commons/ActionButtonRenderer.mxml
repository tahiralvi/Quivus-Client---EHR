<?xml version="1.0" encoding="utf-8"?>
<s:MXDataGridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
						  xmlns:s="library://ns.adobe.com/flex/spark" 
						  xmlns:mx="library://ns.adobe.com/flex/mx">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.utils.Constants;
			import com.adobe.Quivus.view.controls.custom.DictationPopup;
			import com.adobe.Quivus.view.controls.custom.patientExamView.notes.NotesPanel;
			import com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.commons.manager.QIPopUpManager;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.gridButtons.dictationBtn;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.gridButtons.editButton;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.gridButtons.notesBtn;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.gridDictationButtonSelectedSkin;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.gridDictationButtonSkin;
			import com.adobe.Quivus.view.controls.skins.toggleButtonSkins.writeNotesButtonSelected;
			
			import mx.controls.DataGrid;
			import mx.controls.dataGridClasses.DataGridListData;
			import mx.controls.listClasses.BaseListData;
			import mx.events.CloseEvent;
			import mx.events.DataGridEvent;
			
			import valueObjects.ModuleDictationDTO;
			import valueObjects.ModuleNoteDTO;
			
			private var recordGridNotesPopUp:NotesPanel;
			private var gridNotesDTO:ModuleNoteDTO;
			private var notesField:String;
			private var notesSubjectField:String;
			private var recordIDField:String;
			private var headerField:String;
			private var dictationIDField:String;
			
			private var section:String;
			
			override public function set data(value:Object):void
			{
				super.data = value;
			}
			
			private function onEmailClick(event:MouseEvent):void
			{
				dispatchEvent(new Event("emailRecordClick", true));
				dispatchEvent(new DataGridActionsEvent(DataGridActionsEvent.EMAIL_RECORD_CLICK, true));
			}
			
			private function onEditClick(event:MouseEvent):void
			{
				dispatchEvent(new DataGridActionsEvent(DataGridActionsEvent.EDIT_RECORD_CLICK, true));
			}
			
			private function onDeleteClick(event:MouseEvent):void	
			{
				dispatchEvent(new DataGridActionsEvent(DataGridActionsEvent.DELETE_RECORD_CLICK, true));
			}
			
		]]>
	</fx:Script>
	<s:HGroup paddingLeft="0" paddingRight="0" paddingTop="0" paddingBottom="0" horizontalAlign="center" verticalAlign="middle">
		<s:Button id="id_Email" width="12" height="12" click="onEmailClick(event)" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.gridButtons.emailBtn"
				  buttonMode="true" toolTip="Email"/>
		<s:Button id="id_Edit" width="12" height="12" click="onEditClick(event)" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.gridButtons.editButton"
				  buttonMode="true" toolTip="Edit"/>
		<s:Button id="id_Delete" width="12" height="12" click="onDeleteClick(event)"
				  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.gridButtons.removeBtn"
				  buttonMode="true" toolTip="Delete"/>
	</s:HGroup>
</s:MXDataGridItemRenderer>
