<?xml version="1.0" encoding="utf-8"?>
<custom:SlideOutPanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:custom="com.adobe.Quivus.view.controls.custom.*" 
					  xmlns:components="com.gazuntite.controls.extended.components.*" 
					  creationComplete="slideoutpanel1_creationCompleteHandler(event)"
					  
					  
					  allowSlideOut="true" xmlns:buttonSeparators="com.adobe.Quivus.view.controls.skins.buttonSeparators.*"
					  >
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			

			
			

			protected function slideoutpanel1_creationCompleteHandler(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
			/* 	if (chUtil.getWindowsCount() < 2)
				{
					chUtil.setWindowsCount();
				} */
			}

		]]>
		
		
	</fx:Script>
	<fx:Metadata>
		[Event(name="close", type="mx.events.CloseEvent")]
	</fx:Metadata>
	<fx:Script>
		<![CDATA[
			import mx.events.CloseEvent;
			
			[Bindable]
			public var headerLabel:String;
			public var toolTipLabel:String = "Close ";
			
			protected function CloseHandler(event:MouseEvent):void
			{
				//chUtil.removeWindowsCount();
				dispatchEvent( new CloseEvent("close") );
			}
			protected function button1_clickHandler(event:MouseEvent):void
			{
				this.ToggleSlideOut();
				event.stopImmediatePropagation();
			}
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	
	<custom:HeaderContents>
		<s:Group width="100%" id="id_header" height="22">
			<s:layout>
				<s:VerticalLayout paddingLeft="{isSlideOut? 5:0}"  horizontalAlign="center" />
			</s:layout>
			<s:SkinnableContainer width="100%" minWidth="560" skinClass="com.adobe.Quivus.view.controls.skins.PatientRegHeaderSkin">
				
				
				<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="left">
					<s:Label paddingLeft="12" color="#000000" paddingTop="6" fontFamily="Calibri Bold" text="{headerLabel}" />
					<!--<mx:Spacer width="100%" />-->
				</s:HGroup>
				<s:HGroup horizontalAlign="right" width="100%" paddingRight="1" paddingTop="0" gap="1">
					<buttonSeparators:buttonSeparatorGrey />
					<s:HGroup paddingTop="0">
						
						<s:ToggleButton id="id_expandBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.expandButton_grey" 
										buttonMode="true" useHandCursor="true" toolTip="{id_expandBtn.selected?'Collapse':'Expand'}"/>
					</s:HGroup>
					<buttonSeparators:buttonSeparatorGrey />
					<s:HGroup paddingTop="0" paddingRight="3">
						<s:ToggleButton id="id_slideoutBtn" skinClass="com.adobe.Quivus.view.controls.skins.toggleButtonSkins.slideOutBtn"
										buttonMode="true" useHandCursor="true" toolTip="{id_slideoutBtn.selected?'Slide-In':'Slide-Out'}" 
										width="18" height="18"  click="button1_clickHandler(event)" />
					</s:HGroup>
				</s:HGroup>
			</s:SkinnableContainer>
		</s:Group>
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		
		<!--<custom:slideOutGreyHeader width="{id_content.width}" />-->
		<s:SkinnableContainer depth="100" height="21" width="100%" minWidth="500" skinClass="com.adobe.Quivus.view.controls.skins.PatientRegHeaderSkin">
			
			
			<!--<s:Label text="{Label}" top="2" left="5" />			-->	
			
			
			<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="{isSlideOut? 'center':'left'}">
				<s:Label paddingLeft="12" color="#111111" paddingTop="6" fontFamily="Calibri Bold" text="Gazuntite WEBSITE" />
				
			</s:HGroup>
			
			
			
		</s:SkinnableContainer>	
		
		
		
	</custom:SlideHeaderContents>
	
	<custom:Contents>
			
		<s:VGroup id="id_content" height="550" minWidth="560" paddingTop="-8" gap="0" width="{id_header.width}" verticalAlign="top" horizontalAlign="center"
				  paddingLeft="{isSlideOut? 10:0}" 
				  >
			
			<s:VGroup gap="-3" height="100%" width="{isSlideOut? id_header.width :id_header.width }"  verticalAlign="top" horizontalAlign="center" 
					  paddingTop="0">
				
				
				<s:SkinnableContainer skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.webpanelbodySkin" width="100%" height="100%">
					
					
					<s:layout>
						<s:HorizontalLayout paddingTop="16" paddingLeft="8" paddingRight="8" paddingBottom="8" verticalAlign="middle" horizontalAlign="center" />
					</s:layout>
					
					<mx:HTML id="id_htmlArea" width="100%" height="100%" location="http://www.quivus.com" />
					
			</s:SkinnableContainer>
				
				
				<s:Button id="id_CloseBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.closeBtnSkin" 
						  click="CloseHandler(event)" buttonMode="true" useHandCursor="true" toolTip="Close Gazuntite Online Clinic Services"/>
				
			</s:VGroup>
		</s:VGroup>
		
	</custom:Contents>
	
</custom:SlideOutPanel>
