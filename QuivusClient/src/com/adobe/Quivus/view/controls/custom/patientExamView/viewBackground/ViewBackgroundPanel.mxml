					  ButtonAreaSourceOver="{ButtonBGOver}" 
					  QSSlideStateChange="slideoutpanel1_QSSlideStateChangeHandler(event)"
					  QSViewStateChange="slideoutpanel1_QSViewStateChangeHandler(event)"
					  creationComplete="slideoutpanel1_creationCompleteHandler(event)" xmlns:components1="com.gazuntite.controls.extended.components.*" 
					  >
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.events.viewBackground.immunization.LoadPatientVisitImmunizationEvent;
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.AppUtils;
			import com.adobe.Quivus.utils.ChromeUtil;
