	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.events.search.SearchAllergyTypeByNameEvent;
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.ValidationUtils;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.blueButtonSkin;
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.controls.extended.components.LabelComboBox;
			
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CalendarLayoutChangeEvent;
			import mx.events.FlexEvent;
			
			import valueObjects.AllergySearchDTO;
			import valueObjects.AllergyTypeDTO;
			import valueObjects.PatientAllergyDTO;
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			

			public function isInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				var errorStr:String = "";
				var toSetFocus:*;
				
				/* if (!ValidationUtils.isValidDOB(id_OnsetDate)) // date to string converion
				{
					isNotValid = true;
					errorStr += "Enter valid onset date.\n";
					
					if (!toSetFocus)
						toSetFocus = id_OnsetDate;
				} */
				
				if (!ValidationUtils.isValidValueSelected(id_AllergyNameList))
				{
					isNotValid = true;
					errorStr += "Select valid allergy name.\n";
					
					if (!toSetFocus)
						toSetFocus = id_AllergyNameList;
				}
				
				if (!ValidationUtils.isValidName(id_Reaction.text))
				{
					isNotValid = true;
					errorStr += "Enter reaction of allergy.\n";
					
					if (!toSetFocus)
						toSetFocus =id_Reaction;
				}
				if (isNotValid && errorStr.length)
				{
					Alert.show(errorStr, "Add allergy entry error", 4, FlexGlobals.topLevelApplication.mainContainer, function():void
					{
						if (toSetFocus)
							toSetFocus.setFocus();
					});
				}
				
				return isNotValid;
			}
			
			protected function id_AllergyNameList_keyUpHandler(event:KeyboardEvent):void
			{
				// TODO Auto-generated method stub
				var searchString:String = id_AllergyNameList.textInput.text;
				trace(searchString);
				if(searchString.length > 2)
				{
					var allergyEvent : SearchAllergyTypeByNameEvent = new SearchAllergyTypeByNameEvent(searchString);
					CairngormEventDispatcher.getInstance().dispatchEvent( allergyEvent );					
					//id_AllergyNameList.dataProvider = model.allergyDTOList;
					//allergyHistoryList
				}
			}

			protected function Add_clickHandler(event:MouseEvent):void
			{
				//see patientHealthSectionPopup.xml for click listener....
			}


			protected function button1_clickHandler(event:MouseEvent):void
			{
				removePopup();
			}

			private function id_AllergyNameListClickHandler(e:MouseEvent):void
			{
				e.currentTarget.setFocus();
			}
			
			private function id_ReactionClickHandler(e:MouseEvent):void
			{
				e.currentTarget.setFocus();
			}

			protected function id_OnsetDate_changeHandler(event:CalendarLayoutChangeEvent):void
			{
				id_OnsetDate.setFocus();
			}

		]]>
	</fx:Script>
