<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 xmlns:containerSkins="com.adobe.gazuntite.skins.chrome.containerSkins.*" 
		 xmlns:buttonSeparators="com.adobe.Quivus.view.controls.skins.buttonSeparators.*"
		 creationComplete="group1_creationCompleteHandler(event)" 
		 >
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.utils.ChromeUtil;
			
			import mx.events.FlexEvent;
			
			private var _Heading:String;
			private var _ProviderName:String;
			private var _sessionStatus:String;

			[Bindable]
			public function get sessionStatus():String
			{
				return _sessionStatus;
			}

			public function set sessionStatus(value:String):void
			{
				_sessionStatus = value;
			}

			
			[Bindable]
			public function get ProviderName():String
			{
				return _ProviderName;
			}

			public function set ProviderName(value:String):void
			{
				/* if(value.length < 10) */
				_ProviderName = value;
				/* else
				_ProviderName = value.substring(0,10)+"..";	 */
			}
			[Bindable]
			public function get Heading():String
			{
				return _Heading;
			}

			public function set Heading(value:String):void
			{
				_Heading = value;
			}

			protected function id_CloseBtn_clickHandler(event:MouseEvent):void
			{
				id_OptionPopUp.displayPopUp = false;
				id_optionsBtn.selected = false;
			}
			
			protected function id_OptionPopUp_focusOutHandler(event:FocusEvent):void
			{
				/* id_OptionPopUp.displayPopUp = false;
				id_optionsBtn.selected = false; */
			}

			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				/* ChromeUtil.topLevelMainContainer.addEventListener(MouseEvent.MOUSE_DOWN, function(event:MouseEvent):void
				{ */
					id_OptionPopUp.displayPopUp = false;
					//Heading=" Profile Information";
				//});
			}

		]]>
	</fx:Script>
	
	<s:layout>
		<s:HorizontalLayout gap="5" paddingLeft="5" verticalAlign="middle" />
	</s:layout>
	<s:HGroup width="100%" horizontalAlign="left" verticalAlign="middle">
	    <mx:Image id="statusImage"  />
		<s:Label id="id_Name" color="#333333"  fontFamily="Calibri Bold" fontSize="14"  toolTip="{ProviderName}"
				 typographicCase="uppercase" text="{ProviderName}"  maxDisplayedLines="1" maxWidth="100"/>

		<containerSkins:pointer/>
		<s:Label color="#294C6F" fontFamily="Calibri Bold" fontSize="14"  toolTip="{Heading}"
				 typographicCase="uppercase" text="{Heading}" />
	</s:HGroup>
	
	<s:VGroup gap="-4" horizontalAlign="right" width="100%" paddingRight="7" verticalAlign="middle">
		<s:HGroup gap="4" verticalAlign="middle" >
			
			<!--<s:Button  id="btnStatus"  toolTip="{sessionStatus}"
					   typographicCase="uppercase" visible="false" label="{sessionStatus}" width="70"   maxHeight="16"/>-->
			<buttonSeparators:buttonSeparator />
			<s:ToggleButton id="id_optionsBtn" label="Communication Methods" styleName="blackIconsToggleButtonSkin"
							buttonMode="true" useHandCursor="true" toolTip="Communication Methods"
							click="id_OptionPopUp.displayPopUp = !id_OptionPopUp.displayPopUp; event.stopImmediatePropagation(); "/>
		</s:HGroup>
		<s:PopUpAnchor id="id_OptionPopUp" width="140"
					   popUpPosition="below"
					   displayPopUp="false"
					   focusOut="id_OptionPopUp_focusOutHandler(event)">
			<s:SkinnableContainer id="id_buttons" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.silverishWhiteBGContainer" width="100%">
				<s:layout>
					<s:VerticalLayout gap="2" verticalAlign="bottom" horizontalAlign="left" paddingBottom="6" paddingTop="5" paddingLeft="7" />
				</s:layout>
				
				<s:HGroup width="100%" gap="35" verticalAlign="top">
					
					<s:RichText color="#000000" fontSize="12" height="12" kerning="off" text="Communicate" whiteSpaceCollapse="preserve" fontFamily="Calibri Bold"/>
					<s:Button buttonMode="true" id="id_CloseBtn" styleName="ovalPopUpCloseButtonSkin"
							  toolTip="Close" height="16" width="16"
							  click="id_CloseBtn_clickHandler(event)"/>
				</s:HGroup>
				
				
				<!--skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.PEemailBtn"-->
				<s:Button id="id_emailBtn" label="Email" styleName="enlargedEmailButtonSkin"
						  buttonMode="true" useHandCursor="true" toolTip="Email" />
				
				<!--
				<s:Button id="id_snailBtn" label="Snailmail" styleName="enlargedSnailEmailButtonSkin"
						  buttonMode="true" useHandCursor="true" toolTip="Snailmail" />-->
				
				
				<!--<s:Button id="id_messageBtn" label="Contact" styleName="enlargedMessageButtonSkin"
						  buttonMode="true" useHandCursor="true" toolTip="Contact" />-->
				
				
				<s:Button id="id_commentBtn" label="SMS" styleName="enlargedChatButtonSkin"
						  buttonMode="true" useHandCursor="true" toolTip="SMS" />
				
				
				<s:Button id="id_VideoChatBtn" label="Video" styleName="enlargedPhoneButtonSkin"
						  buttonMode="true" useHandCursor="true" toolTip="Video" />
				
			</s:SkinnableContainer>
		</s:PopUpAnchor>
		
	</s:VGroup>
</s:Group>
