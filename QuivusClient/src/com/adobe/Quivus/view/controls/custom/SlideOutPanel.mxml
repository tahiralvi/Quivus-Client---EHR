			private function AddSlideOut():void
			{
				
				 trace("ADD SLIDE OUT :");
				
				 if(FlexGlobals.topLevelApplication.slideout_count < 4)
				 {
				 
				 
				FlexGlobals.topLevelApplication.id_slideout_main.visible = true;
								
				var s1:NavigatorContent = new NavigatorContent();
				//s1.id = "id_nav1";
				s1.label = slideoutPanelName;	
				
				
				s1.percentWidth = 100;
				s1.percentHeight = 100;
				
				s1.width = FlexGlobals.topLevelApplication.id_VS.width - 8;
				//s1.maxHeight = FlexGlobals.topLevelApplication.id_VS.height - 5;
				
				//s1.height =  id_PanelBody.height + 50;
				
				//FlexGlobals.topLevelApplication.id_tabs.height  = s1.height + 50;
				
				
				FlexGlobals.topLevelApplication.slideout_array.push(slideoutPanelName);
				trace("Currently slided out panels "+ FlexGlobals.topLevelApplication.slideout_array);
				
				
				//s1.width = id_HeaderView.width + 10;
				
				s1.minHeight = 140;
								
				//id_PanelBody.width = Capabilities.screenResolutionX / 2 - 10;							
				
				s1.addElement(id_PanelBody);
											
				id_PanelBody.width = id_HeaderView.width;
				//id_PanelBody.percentHeight = 100;
				//id_PanelBody.height = 140;
				//id_PanelBody.minHeight = 40;
				
				
				trace("s1.height: "+s1.height);
				trace("s1.width: "+s1.width);
				
				trace("id_PanelBody.height: "+id_PanelBody.height);
				trace("id_PanelBody.width: "+id_PanelBody.width);
				
				trace("FlexGlobals.topLevelApplication.id_tabs.height: "+FlexGlobals.topLevelApplication.id_tabs.height);
				trace("id_sheetView.height: "+id_sheetView.height);
				trace("id_panelArea.height: "+id_panelArea.height);
				trace("FlexGlobals.topLevelApplication.id_VS.height: "+FlexGlobals.topLevelApplication.id_VS.height);
							
				
				//add navigator content to view stack
				FlexGlobals.topLevelApplication.id_tabs.addElement(s1);
				
				//select new tab as focused..
				FlexGlobals.topLevelApplication.id_tabs.selectedIndex = FlexGlobals.topLevelApplication.id_tabs.length-1;
				
				
				//assign new tab index with this slideout
				slideoutPanelIndex = FlexGlobals.topLevelApplication.id_tabs.selectedIndex;				
				
				
				//assign new count
				FlexGlobals.topLevelApplication.slideout_count = FlexGlobals.topLevelApplication.id_tabs.length;
				
				
				
				// called when navigator content will be remove. 
				// and it will be removed when we click on cross button.. so we acutally needs to call removeSlideout
				
				s1.addEventListener(Event.REMOVED_FROM_STAGE, function(evt:Event):void
				{
					trace("REMOVED_FROM_STAGE");
					//if(slideoutPanelIndex == FlexGlobals.topLevelApplication.id_tabs.selectedIndex)
					{
						
						if(FlexGlobals.topLevelApplication.slideout_crossed == true)
						{
							trace("REMOVED_FROM_STAGE --- cross button clicked --- ");
							
							//trace("VS length "+FlexGlobals.topLevelApplication.id_tabs.length);					
							RemoveSlideOut();
							FlexGlobals.topLevelApplication.slideout_crossed = false;
							
							trace("VS length after remove Slideout"+FlexGlobals.topLevelApplication.id_tabs.length);
							//trace("tabbar length after remove Slideout "+FlexGlobals.topLevelApplication.id_TabBar.numChildren);
							if(FlexGlobals.topLevelApplication.id_tabs.length == 1)
							{
								FlexGlobals.topLevelApplication.id_slideout_main.visible = false;
							}
						}
					
					}
					
				});							
								
										
				ContentsVisible(true);
							
				id_sheetView.percentHeight = 100;
	
				var reqWidth:Number = this.width + id_PanelBody.width + 10;
				if ( ChromeUtil.topLevelWindow.width < reqWidth )
				{
					ChromeUtil.topLevelWindow.width = reqWidth;
				}
		
				
							
					isSlideOut = true;
					ExpandedView = true;
					scaleEffectX.play();
									 	
				
				 }
			}
			
			private function AdjustSlideOutPosition(event:Event = null):void
			{
				var loc:Point = new Point( id_panelArea.x + id_panelArea.width, 0 );
				var gLoc:Point = localToGlobal( loc );
				
				var regHeight:int = gLoc.y + id_PanelBody.height;
				var pos:int = Math.min( 500, regHeight )
				if( regHeight > pos )
					gLoc.y += getPositionOffset( gLoc.y, regHeight );
				if( gLoc.y < 10 ) 
					gLoc.y = 10;
				
				
				
				id_PanelBody.percentHeight = 100; 						
				
			}
			
			
			
			private function getPositionOffset( yPos:int, currentHeight:int ):int
			{
				var maxAvlblHeight:int = ChromeUtil.topLevelWindow.height;
				var halfHeight:int = maxAvlblHeight / 2;
				
				if( ( currentHeight + yPos ) > maxAvlblHeight )
					return -currentHeight / 2;
				
				return 10;
				
			}
			
