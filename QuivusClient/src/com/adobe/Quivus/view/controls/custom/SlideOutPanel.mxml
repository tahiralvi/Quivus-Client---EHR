			protected function id_PanelBody_removeHandler(event:FlexEvent):void
			{
				if (isSlideOut)
				{
					trace("this panel is removed, while it was slided out");
					//now remove its tab too..and navigator content..
					
					//make sure, this code is not executed when user clicked through cross button..
					if(FlexGlobals.topLevelApplication.slideout_crossed == false)
					{
						//RemoveSlideTab();
						if(FlexGlobals.topLevelApplication.id_TabBar.numChildren == 3)
						{
							trace("NUM children "+FlexGlobals.topLevelApplication.id_TabBar.numChildren);
							FlexGlobals.topLevelApplication.id_TabBar.closeTab(0, FlexGlobals.topLevelApplication.id_TabBar.selectedIndex);
							FlexGlobals.topLevelApplication.id_TabBar.closeTab(1, FlexGlobals.topLevelApplication.id_TabBar.selectedIndex);
							FlexGlobals.topLevelApplication.id_TabBar.closeTab(2, FlexGlobals.topLevelApplication.id_TabBar.selectedIndex);
							
						}
						if(FlexGlobals.topLevelApplication.id_TabBar.numChildren == 2)
						{
							trace("NUM children "+FlexGlobals.topLevelApplication.id_TabBar.numChildren);
							FlexGlobals.topLevelApplication.id_TabBar.closeTab(0, FlexGlobals.topLevelApplication.id_TabBar.selectedIndex);
							FlexGlobals.topLevelApplication.id_TabBar.closeTab(1, FlexGlobals.topLevelApplication.id_TabBar.selectedIndex);
						}						
						if(FlexGlobals.topLevelApplication.id_TabBar.numChildren == 1)
						{
							trace("NUM children "+FlexGlobals.topLevelApplication.id_TabBar.numChildren);
							FlexGlobals.topLevelApplication.id_TabBar.closeTab(0, FlexGlobals.topLevelApplication.id_TabBar.selectedIndex);
							FlexGlobals.topLevelApplication.id_slideout_main.visible = false;
						}
											
					}
					
					
				}
			}


			private function switchHeaderBody():void
			{
				if(_headerOverBody)
				{
					//id_panelArea.setElementIndex(id_PanelBody, id_panelArea.getElementIndex(id_HeaderView));
					/* id_PanelBody.setElementIndex(id_HeaderView, id_PanelBody.getElementIndex(id_sheetView)); 		
					
					id_PanelBody.y = 0; */
					id_HeaderView.maxHeight  = 44;
				}
				else if(_headerOverBody == false)
				{
					id_HeaderView.maxHeight  = 22;
				}
			}
			
			/*  override protected function createChildren():void
			{
				super.createChildren();
				callLater( switchHeaderBody );
			}  */
			
			protected override function createChildren():void
			{
				super.createChildren();
				if( HeaderContents )
					for (var i:int = 0; i < HeaderContents.length; i++)
						id_HeaderView.addElement(UIComponent(HeaderContents[i].getInstance()));
				
			}
	
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<s:Fade target="{id_sheetView}" id="fadeEffect" duration="600" alphaFrom="0" alphaTo="1" />
		<!--<s:Resize target="{id_sheetView}" id="resizeEffect" repeatCount="1"  duration="2000" heightFrom="20" heightTo="500" />--> 
		
		<s:Animate id="scaleEffectX" repeatCount="1" target="{id_PanelBody}" duration="400">
			
			<s:SimpleMotionPath property="scaleX" valueFrom="0" valueTo="1" />
			
		</s:Animate>
	</fx:Declarations>
	
	<s:Rect id="id_FocusBorder" visible="false" top="0" bottom="0" left="0" right="0" >
		<s:stroke>
			<s:SolidColorStroke color="#FF4F4F" alpha="1" weight="2" />
		</s:stroke>
		
	</s:Rect>
	
	
	<s:Group id="id_panelArea" height="100%" width="100%" 
			 >
		
		<s:Group id="id_PanelBody" height="100%" width="100%" y="{isSlideOut || headerOverBody?0:20}" remove="id_PanelBody_removeHandler(event)" 
				 initialize="OnInitialize(event);" clipAndEnableScrolling="false" 
				 >
			
			<!--<s:VGroup id="id_SlideOutHeader00" gap="0" width="100%" initialize="OnSlideHeaderInitialize(event)" 
			clipAndEnableScrolling="true" click="OnSlideHeaderClick(event)" />	-->
			<!--<s:HGroup y="-5" width="100%" horizontalAlign="center">-->
			
			<s:Button id="id_dragArea"  mouseDown="{changeCursor(event)}" mouseUp="{restoreCursor(event)}" 
					  visible="{id_SlideOutHeader00.visible}" includeInLayout="{id_SlideOutHeader00.visible}" alpha="0.4"
					  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.Handle_dragBtnSkin" toolTip="Move"
					  buttonMode="true" useHandCursor="true"/>
			<!--</s:HGroup>-->
			
			
			<s:VGroup id="id_sheetView" height="100%" width="100%" horizontalAlign="left" tabChildren="true" 
					  initialize="OnInitialize(event);" clipAndEnableScrolling="true" 
					  x="0" y="{isSlideOut?9:0}"
					  />
			<s:VGroup id="id_SlideOutHeader00" gap="0" width="100%" height="100%" initialize="OnSlideHeaderInitialize(event)" 
					  clipAndEnableScrolling="true"  click="OnSlideHeaderClick(event)" visible="false" tabChildren="true" buttonMode="true" useHandCursor="true" />	
			
			
		</s:Group>
		<s:HGroup id="id_HeaderView" height="100%" width="100%" horizontalAlign="right" verticalAlign="middle" tabChildren="true"
				  initialize="OnHeaderInitialize(event);" click="OnHeaderClick(event)" maxHeight="22" x="0" y="0" 
				  />
		
	</s:Group>
	<s:filters>
		<s:GlowFilter id="id_glowFocus" strength="1"  blurX="12" blurY="10" alpha="0"  color="#bb0000" />
	</s:filters>
	
</s:Group>
