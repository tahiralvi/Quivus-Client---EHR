			public function BringToFront():void
			{
				var index:int = id_PanelBody.parent.getChildIndex(id_PanelBody);
				var last:int = id_PanelBody.parent.numChildren - 1;
				if (index != last) {
					id_PanelBody.parent.setChildIndex(id_PanelBody, last);
					
					var vse:Event 	= new Event( "QSBroughtToFront", true, true );
					
					id_PanelBody.dispatchEvent( vse );
				}
			}
