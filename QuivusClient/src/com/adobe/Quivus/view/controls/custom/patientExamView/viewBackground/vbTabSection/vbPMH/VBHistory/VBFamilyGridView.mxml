			private function preInitializeHandler():void
			{
				if (!deleteColumnData)
					deleteColumnData = {};
				
				deleteColumnData["noteDataFields"] = {subject: "NoteSubject", note: "FamilyHistoryNote", header: "FamilyHistoryTypeName", statusFunction:RecordLevelNotesStatus};
				deleteColumnData["dictationDataField"] = "DictationID";
				deleteColumnData["recordIDField"] = "PatientFamilyHistoryID";
				deleteColumnData["section"] = QIPopUpManager.VB_COMPREHENSIVE_HISTORY;
			}
			
			private function vbFamilyGridItemEditBeginHandler(event:DataGridEvent):void
			{
				if (event.columnIndex == 2)
				{
					var rowIndex:int = id_DataGrid.selectedIndex;
					var itemToSetInEditableMode:IListItemRenderer = id_DataGrid.indexToItemRenderer(rowIndex);
					
					var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
					ev.columnIndex = 3;
					ev.rowIndex = rowIndex;
					ev.itemRenderer = itemToSetInEditableMode;
					ev.dataField = "Status";
					id_DataGrid.dispatchEvent(ev);
					
					event.preventDefault();
					event.stopImmediatePropagation();
					return; //don't allow edit on this column
				}
				else if (event.columnIndex > 3 )
				{
					if( event.itemRenderer.data["IsYesSelected"] == Constants.STRING_FALSE )
					{
						id_DataGrid.editable = false;
						event.preventDefault();
						event.stopImmediatePropagation();
						return; //don't allow edit until yes selected
					}
				}
				id_DataGrid.createItemEditor(event.columnIndex, event.rowIndex);
				
				/* if (event.columnIndex == 4)
				{
				SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).data = event.itemRenderer.data; 
				} */
				
				if(event.columnIndex == 5)
				{
					try{
						trace("FamilyHistoryTypeName: ",event.itemRenderer.data["FamilyHistoryTypeName"]);					
						if(event.itemRenderer.data["FamilyHistoryTypeName"] == Constants.FAMILY_HEART_DISEASE_MODULE_NAME)
						{
							//id_DataGrid.createItemEditor(event.columnIndex, event.rowIndex);
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = model.heartDiseaseDiseaseTypesDTOList;
						}
						else if(event.itemRenderer.data["FamilyHistoryTypeName"] == Constants.FAMILY_DIABETES_MODULE_NAME)
						{
							//id_DataGrid.createItemEditor(event.columnIndex, event.rowIndex);
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = model.diabetesDiseaseTypesDTOList;
						}
						else if(event.itemRenderer.data["FamilyHistoryTypeName"] == Constants.FAMILY_CANCER_MODULE_NAME)
						{
							//id_DataGrid.createItemEditor(event.columnIndex, event.rowIndex);
							//SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = model.cancerDiseaseTypesDTOList;
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = model.cancerDiseaseTypesDTOList;
						}
						else if(event.itemRenderer.data["FamilyHistoryTypeName"] == Constants.FAMILY_HYPERTENSION_MODULE_NAME)
						{
							//id_DataGrid.createItemEditor(event.columnIndex, event.rowIndex);
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = model.hypertensionDiseaseTypesDTOList;
						}
						else if(event.itemRenderer.data["FamilyHistoryTypeName"] == Constants.FAMILY_OTHER_MODULE_NAME)
						{
							//id_DataGrid.createItemEditor(event.columnIndex, event.rowIndex);
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = model.otherDiseaseTypesDTOList;
						}
						
					}
					catch(error:*)
					{
						
					}
				}
				
				if (event.columnIndex == 3)
				{
					try{
						if(id_DataGrid.selectedItem["IsYesSelected"] == Constants.STRING_TRUE)
						{
							(id_DataGrid.itemEditorInstance as YesNoItemEditor).isYes = id_DataGrid.selectedItem["IsYesSelected"];
						}
						else if(id_DataGrid.selectedItem["IsYesSelected"] == Constants.STRING_FALSE)
						{
							(id_DataGrid.itemEditorInstance as YesNoItemEditor).isYes = 'false';
						}
						/* else if((id_DataGrid.itemEditorInstance).data["IsYesSelected"] == "false")
						{
						(id_DataGrid.itemEditorInstance).data["IsYesSelected"] = "No";
						} */
					}
					catch(error:*)
					{
						
					}
				}
				
				
				if (event.columnIndex == 4)
				{
					try{
						if((id_DataGrid.itemEditorInstance).data["Current"] == true)
						{
							(id_DataGrid.itemEditorInstance).data["Current"] = "Yes";
						}
						else if((id_DataGrid.itemEditorInstance).data["Current"] == false)
						{
							(id_DataGrid.itemEditorInstance).data["Current"] = "No";
						}
					}
					catch(error:*)
					{
						
					}
				}
			}
			
			private var isAsking:Boolean = false; //@see --- ItemEditEndHandler
			private function vbFamilyGridItemEditEndHandler(event:DataGridEvent):void
			{
				var validationRes:ValidationResultEvent;
				var FHTID:int = FamilyHistoryDTO(event.currentTarget.selectedItem).FamilyHistoryTypeID;
				
				if (event.dataField == "ReletionshipTypeName" || event.dataField == "DiseaseName")
				{
					var editor:LabelComboBox = SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor;
					
					comboValidator.source = editor;
					
					if (event.dataField == "ReletionshipTypeName")
					{
						comboValidator.error = "Select reletionship from list";
					}
					else if (event.dataField == "DiseaseName")
					{
						comboValidator.error = "Select disease name from list";
					}
					
					validationRes = comboValidator.validate(editor.selectedItem);
					
					if (validationRes && !validationRes.results)
					{
						if (event.dataField == "ReletionshipTypeName")
						{
							event.itemRenderer.data.ReletionshipTypeName 	= editor.selectedItem.RelationshipName;
							event.itemRenderer.data.ReletionshipTypeID 		= editor.selectedItem.RelationshipId;
						}
						else if (event.dataField == "DiseaseName")
						{
							event.itemRenderer.data.DiseaseName 	= editor.selectedItem.Description;
							event.itemRenderer.data.DiseaseID 		= editor.selectedItem.DiseaseTypeID;
						}
						
						if (FHTID != 0)
							event.itemRenderer.data.IsDirty = true;
						
						hasViewChanged = _hasGridChanged = true;
					}
					/*else
					{
					id_DiagnosisGrid.destroyItemEditor();
					
					event.stopImmediatePropagation();
					event.preventDefault();
					}*/
					
					id_DataGrid.destroyItemEditor();
					
					event.stopImmediatePropagation();
					event.preventDefault();
				}
					
				else if (event.dataField == "IsYesSelected")
				{
					var isYes:String = (id_DataGrid.itemEditorInstance as YesNoItemEditor).isYes;
					
					if( isYes == Constants.STRING_FALSE && isAsking == false &&
						(
							event.itemRenderer.data.DictationID != Constants.GUID_FORMAT || 
							!AppUtils.IsNullOrEmpty( event.itemRenderer.data.NoteSubject ) ||
							!AppUtils.IsNullOrEmpty( event.itemRenderer.data.FamilyHistoryNote ) ||
							!AppUtils.IsNullOrEmpty( event.itemRenderer.data.ReletionshipTypeID ) ||
							!AppUtils.IsNullOrEmpty( event.itemRenderer.data.DiseaseID ) 
						)
					)
					{
						isAsking = true; // work around -- don't know why this event is firing twice --- look for real cause
						UtilityFunctions.AskMessage( "This action will remove any related data, notes and dictation on the current selected record.", function():void //if yes is selected
						{
							//isAsking = false;
							//event.itemRenderer.data.IsNone 				= Constants.STRING_FALSE;
							event.itemRenderer.data.NoteSubject 			= "";
							event.itemRenderer.data.FamilyHistoryNote 		= "";
							event.itemRenderer.data.DictationID 			= Constants.GUID_FORMAT;
							
							event.itemRenderer.data.ReletionshipTypeName 	= "";
							event.itemRenderer.data.ReletionshipTypeID 		= "";
							event.itemRenderer.data.DiseaseName 			= "";
							event.itemRenderer.data.DiseaseID 				= "";
							
							
							event.itemRenderer.data.DictationID 		= Constants.GUID_FORMAT;
						}, null,function():void //if no is selected
						{
							isAsking = false;
							//event.itemRenderer.data.IsNone 				= Constants.STRING_TRUE;
							//event.itemRenderer.data["IsDirty"] 			= true;
							id_DataGrid.invalidateDisplayList();
						});
					}
				}
				
				
				event.stopImmediatePropagation();
				event.preventDefault();
				
				//id_DataGrid.editable = false;
				id_DataGrid.destroyItemEditor();
				
			}
			private function cc():void
			{
				//addEventListener("addRecordClick", addRecordClickHandler, false, 0, true);
				//addEventListener("writeDictationClick", writeDictationClickHandler, false, 0, true);
				id_DataGrid.addEventListener(DataGridActionsEvent.EDIT_RECORD_CLICK, editRecordClickHandler, false, 0, true);
				id_DataGrid.addEventListener(DataGridActionsEvent.DELETE_RECORD_CLICK, deleteRecordClickHandler, false, 0, true);
				id_DataGrid.addEventListener(DataGridActionsEvent.WRITE_NOTES_CLICK, writeNotesClickHandler, false, 0, true);
				id_DataGrid.addEventListener(DataGridActionsEvent.ITEM_EDIT_KEY_UP, itemEditKeyUpHandler, false, 0, true);
				
				
			}
			
			private function writeNotesClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.VB_COMPREHENSIVE_HISTORY ) )//Tahir Alvi - implement security check 
				{
					
				}
				
				
			}
			private function itemEditKeyUpHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.VB_COMPREHENSIVE_HISTORY ) )//Tahir Alvi - implement security check 
				{
					var lblFld:String = SparkComboBoxItemEditor(event.target).labelField;
					
					if (lblFld == "Dose")
					{
						if( event.searchString.length > 2 )
						{
							var doseEvent : LoadImmunizationDoseStaticDataEvent = new LoadImmunizationDoseStaticDataEvent( event.searchString );
							CairngormEventDispatcher.getInstance().dispatchEvent( doseEvent );					
						}
					}
					else if (lblFld == "LotNumber")
					{
						if( event.searchString.length > 0 )
						{
							var lotNumberEvent : LoadImmunizationLotNumberStaticDataEvent = new LoadImmunizationLotNumberStaticDataEvent( event.searchString );
							CairngormEventDispatcher.getInstance().dispatchEvent( lotNumberEvent );					
						}
					}
					
				}
			}
			
			private function editRecordClickHandler(event:DataGridActionsEvent):void
			{
				id_DataGrid.editable = true;
				var rowIndex:int = id_DataGrid.selectedIndex;
				var itemToSetInEditableMode:IListItemRenderer = id_DataGrid.indexToItemRenderer(rowIndex);
				
				var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
				ev.columnIndex = 3;
				ev.rowIndex = rowIndex;
				ev.itemRenderer = itemToSetInEditableMode;
				ev.dataField = "Status";
				id_DataGrid.dispatchEvent(ev);
			}
			private function filterDeletedItems(item:Object):Boolean
			{
				var b:Boolean = item["IsDeleted"];
				return (!b);
			}
			
			private function deleteRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.VB_COMPREHENSIVE_HISTORY ) )//Tahir Alvi - implement security check 
				{
					var curTar:LabelDataGrid = LabelDataGrid(event.currentTarget);
					
					if (curTar.selectedItem)
					{
						var fhID:int = FamilyHistoryDTO(curTar.selectedItem).PatientFamilyHistoryID;
						
						if (fhID == 0)
						{
							model.familyHistoryDTOListByPatient.removeItemAt(curTar.selectedIndex);
							if (model.familyHistoryDTOListByPatient.length <= 0)
							{
								_hasGridChanged = false;
								//hasViewChanged = isGetEdited();
							}
						}
						else
						{
							UtilityFunctions.AskMessage(  "Do you want to delete selected record", function():void
							{
								var dto:FamilyHistoryDTO = curTar.selectedItem as FamilyHistoryDTO;
								dto.IsDeleted = true;
								model.familyHistoryDTOListByPatient.filterFunction = filterDeletedItems;
								model.familyHistoryDTOListByPatient.refresh();
								
								hasViewChanged = _hasGridChanged = true;
							});
						}
					}
					
					
				}
			}
			
			private var _familyHistoryDTOCollection:ArrayCollection;
			private var _includeInLayout:Boolean;
			private var _includeInLayoutChanged:Boolean = true;
			[Bindable]
			public function get familyHistoryDTOCollection():ArrayCollection
			{
				return _familyHistoryDTOCollection;
			}
			[Bindable]
			public function get includeGridInLayout():Boolean
			{
				return _includeInLayout;
			}
			
			public function set includeGridInLayout(value:Boolean):void
			{
				_includeInLayout = value;
				_includeInLayoutChanged = true;
				
				invalidateProperties();
			}
			public function set familyHistoryDTOCollection(value:ArrayCollection):void
			{
				_familyHistoryDTOCollection = value;
				
				if (_familyHistoryDTOCollection)
				{
					if (!_familyHistoryDTOCollection.hasEventListener(CollectionEvent.COLLECTION_CHANGE))
					{
						familyHistoryDTOCollection.addEventListener(CollectionEvent.COLLECTION_CHANGE, familyHistoryDTOCollectionChangeHandler, false, 0, true);
					}
					
					if (familyHistoryDTOCollection.length)
					{
						includeGridInLayout = true;
					}
					else
					{
						includeGridInLayout = false;
					}
				}
				else
				{
					includeGridInLayout = false;
				}
			}
			
			private function familyHistoryDTOCollectionChangeHandler(event:CollectionEvent):void
			{
				if (familyHistoryDTOCollection && familyHistoryDTOCollection.length)
					includeGridInLayout = true;
					
				else
					includeGridInLayout = false;
			}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				if(familyHistoryDTOCollection!=null){
					familyHistoryDTOCollection.filterFunction=myFilter;
					familyHistoryDTOCollection.refresh();
				}
			}
			
			private function myFilter(obj:*):Boolean
			{
				if(model.vbFilter == Constants.BY_VISIT)
				{
					if(model.vbVisitId == obj.VisitID)
					{
						return true;
					}
					else
					{
						return false;
					}
				}
				
				return true;
				
			}
			
			
			public function displayStatus(oItem:Object,iCol:int):String
			{
				//H
				
				var vd:String = (oItem as FamilyHistoryDTO).IsYesSelected;
				if( vd && vd.toLowerCase() == Constants.STRING_TRUE )
				{
					return "Yes";
				}
				else if( vd && vd.toLowerCase() == Constants.STRING_FALSE )
				{
					return "No";
				}
				return ""; 
				
			}
			
			public function displayCurrent(oItem:Object,iCol:int):String
			{
				//H
				var obj:FamilyHistoryDTO = (oItem as FamilyHistoryDTO);
				var vd:Boolean = (oItem as FamilyHistoryDTO).IsPresent;
				if(obj.IsYesSelected == "true" || obj.IsYesSelected == "True")
				{
					if(vd == true)
					{
						return "Present";
					}
					else if(vd == false)
					{
						return "Past";
					}
				}
				return ""; 
				
			}
			
			private function RecordLevelNotesStatus(hasNotes:Boolean, data:Object):void
			{
				if( hasNotes ) 
					data.IsYesSelected = Constants.STRING_FALSE;
				else
					data.IsYesSelected = Constants.STRING_TRUE;
				
				familyHistoryDTOCollection.refresh();
			}
			
			private function setVisitDate(oItem:Object,iCol:int):String
			{
				var strVisitDate:String = '';
				
				if (oItem && oItem.VisitDate)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.VisitDate));
					strVisitDate = formatDateTime.format(dateRecieved);
					var nullDate:Date = Constants.NULL_DATE;
					
					if (dateRecieved.getFullYear() <= nullDate.getFullYear() && dateRecieved.getMonth() <= nullDate.getMonth())
						strVisitDate = "";
					
					if(oItem.IsNA)
						strVisitDate = 'N/A';
				}
				return strVisitDate;
			}
			
		]]>
