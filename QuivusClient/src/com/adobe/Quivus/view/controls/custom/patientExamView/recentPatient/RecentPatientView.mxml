<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:extended="com.adobe.Quivus.view.controls.extended.*" 
		 xmlns:components="com.gazuntite.controls.extended.components.*" 
		 
		 >
	
	<fx:Metadata>
		[Event(name="PatientSelected", type="com.gazuntite.provider.search.services.patient.view.events.PatientSelectedEvent")]
	</fx:Metadata>
	<s:layout>
		<s:VerticalLayout paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0" />
	</s:layout>
	
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.AppEventStrings;
			import com.adobe.Quivus.utils.security.QSSecurityUtil;
			import com.adobe.Quivus.view.controls.skins.dataGridSkins.DatagridHeaderSeparatorSkin;
			import com.gazuntite.provider.search.services.patient.view.events.PatientSelectedEvent;
			
			import mx.charts.chartClasses.DateRangeUtilities;
			import mx.collections.IList;
			import mx.events.FlexEvent;
			import mx.controls.Label;
			
			import valueObjects.PatientSearchDTO;
			import valueObjects.RecentPatientDTO;
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			private var m_oDataProvider:IList
			
			[Bindable]
			public function get DataProvider():IList
			{
				return m_oDataProvider;
			}
			
			public function set DataProvider(value:IList):void
			{
				m_oDataProvider = value;
			}
			
			public function linkbutton1_clickHandler(event:MouseEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.RECENT_PATIENT_PANEL ))//Tahir Alvi - implement security check
				{
					//trace (id_RecentPatientGrid.selectedItem );
					
					var selectedPatient:RecentPatientDTO = id_RecentPatientGrid.selectedItem as RecentPatientDTO;
					
					var ps:PatientSelectedEvent = new PatientSelectedEvent(AppEventStrings.PATIENT_SELECTED_EVENT);
					ps.selection = selectedPatient;
					dispatchEvent( ps );
					
				}
			}
			
			protected function id_RecentPatientGrid_creationCompleteHandler(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		
	</fx:Declarations>
	
	
	
	<!--<s:BorderContainer height="100%" width="100%" cornerRadius="3" backgroundColor="#999AAA" borderWeight="3" borderAlpha="0" borderColor="#999AAA">-->
	<s:SkinnableContainer skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.grayPanelBodySkin" width="100%" height="100%">
		
		
		<s:layout>
			<s:HorizontalLayout paddingTop="6" paddingBottom="5" paddingLeft="4" paddingRight="4" verticalAlign="middle" horizontalAlign="center" />
		</s:layout>
		
		<!--	<s:BorderContainer width="96%" height="99%" cornerRadius="3" backgroundColor="#ffffff" borderAlpha="0" borderColor="#ffffff">
		<s:layout>
		<s:HorizontalLayout paddingTop="0" horizontalAlign="center" verticalAlign="middle" />
		</s:layout>-->
		
		<mx:DataGrid id="id_RecentPatientGrid"  width="{this.width - 10}" height="100%" dataProvider="{DataProvider}" 
					 creationComplete="id_RecentPatientGrid_creationCompleteHandler(event)"
					 styleName="dataGridStyle" rowHeight="22"
					 
					 fontFamily="Verdana"
					 headerStyleName="MyDataGridStyleHeader"
					 verticalGridLines="false"
					 headerBackgroundSkin="com.adobe.Quivus.view.controls.skins.dataGridSkins.DataGridHeaderDarkBlueSkin"				
					 headerSeparatorSkin ="com.adobe.Quivus.view.controls.skins.dataGridSkins.DatagridHeaderSeparatorSkin"
					 verticalScrollBarStyleName="VScrollBar"
					 >
			<mx:columns>
				<mx:DataGridColumn width="150" dataField="PatientName" headerText="Name" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"  />
				<mx:DataGridColumn width="70" dataField="PatientDOB" headerText="D.O.B" itemRenderer="com.adobe.Quivus.view.controls.custom.itemRenderer.DateRenderer4DG" />					
				<mx:DataGridColumn width="70" dataField="QuivusId" headerText="GID" />
				<mx:DataGridColumn width="90" headerText="">
					<mx:itemRenderer>
						<fx:Component>	
							
							<!--<mx:LinkButton click="outerDocument.linkbutton1_clickHandler(event)" label="Load Patient" />-->
							<mx:HBox buttonMode="true" useHandCursor="true" width="90" height="60%" paddingBottom="2" horizontalAlign="center" verticalAlign="middle">
								
								<!--	<mx:Button buttonMode="true"  click="outerDocument.linkbutton1_clickHandler(event)" label="Load Patient"
								useHandCursor="true" fontSize="9" width="70" height="13" toolTip="Load Selected Patient"  
								upSkin="@Embed('com/adobe/Quivus/view/controls/skins/assets/mainContainer.swf', symbol='btn_loadPatient')"
								overSkin="@Embed('com/adobe/Quivus/view/controls/skins/assets/mainContainer.swf', symbol='btn_loadPatient')"
								downSkin="@Embed('com/adobe/Quivus/view/controls/skins/assets/mainContainer.swf', symbol='btn_loadPatient')"
								/>-->
								
								<s:Button width="85" click="outerDocument.linkbutton1_clickHandler(event)" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.loadPatientBtn"
										  buttonMode="true" useHandCursor="true" toolTip="Load Patient"/>
								
								
							</mx:HBox>
							
						</fx:Component>
					</mx:itemRenderer>
				</mx:DataGridColumn>
			</mx:columns> 
		</mx:DataGrid> 
		
		<!--</s:BorderContainer>-->
	</s:SkinnableContainer>
	
</s:Group>
