	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
		<mx:NumberFormatter id="numberFormatter" precision="2"/>
	</fx:Declarations>
	<fx:Binding source="model.vbDataLoadedFlag" destination="IsModelUpdated"/>
	<custom:HeaderContents>
		<s:Group id="id_mainHeader" width="100%" height="24" minWidth="{ChromeUtil.topLevelMainContainer.width - 70}">
			<s:layout>
				<s:VerticalLayout verticalAlign="bottom" horizontalAlign="center" />
			</s:layout>
			<viewBackground:VBSectionHeader id="id_header" width="{id_mainHeader.width - 8}" HeadingLable="VITALS" SectionNameID="{QSSecurityUtil.VB_VITALS}"
											Skin="com.adobe.Quivus.view.controls.skins.SkinnableContainers.VBVitalsPanelSkin"/>						   
		</s:Group>
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		<viewBackground:VBSectionSlideoutHeader width="100%" label="{Constants.VB_SECTION_NAME_VITALS}" />
	</custom:SlideHeaderContents>
	<custom:Contents>
		<s:SkinnableContainer id="id_contents" width="100%" height="100%" skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.VBVitalsPanelSkin">
			<s:layout>
				<s:VerticalLayout horizontalAlign="center" verticalAlign="top" gap="1" paddingLeft="4" paddingRight="4" paddingBottom="4" paddingTop="4" />
			</s:layout>
			<!--<s:HGroup id="id_NotesArea" width="100%" paddingTop="0" />-->
			
			<viewBackground:VBSectionLevelNotesDictation id="id_notesDictation" width="100%" />
			
			<s:Button label="Filter" click="button1_clickHandler(event)" visible="false" includeInLayout="false" id="id_applyFiler"/>
			
			<paging:PaginationFilterView id="id_PaginationFilterView" width="100%" Page="{model.vitalCurrentPageByPatient}"
										 GoToFirstPage="switchPageForGridView(event)" GoToNextPage="switchPageForGridView(event)" 
										 GoToPreviousPage="switchPageForGridView(event)" GoToLastPage="switchPageForGridView(event)"
										 RefreshView="id_PaginationFilterView_RefreshViewHandler(event)"
										 />
			<mx:DataGrid id="id_DataGrid" width="100%" useRollOver="false"
						 dataProvider="{model.vitalDTOListByPatient}" rowCount="{id_DataGrid.dataProvider.length + 1}" 
						 verticalScrollPolicy="on"
						 itemEditBegin="GridItemEditBeginHandler(event)" 
						 itemEditEnd="GridItemEditEndHandler(event)"
						 horizontalScrollPolicy="off" maxHeight="150">
				<mx:columns>
					<mx:DataGridColumn headerText="Sr.#" width="40" labelFunction="GridRowNumber" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
					<mx:DataGridColumn headerText="Visit Date" headerRenderer="mx.controls.Label" wordWrap="true" width="90" dataField="VisitDate" 
									   itemRenderer="com.adobe.Quivus.view.controls.custom.itemRenderer.DateRenderer4DG"/>
					<mx:DataGridColumn headerText="Height (cm)" dataField="Height" width="60" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="applyNumberFormatOnHeight" />
					<mx:DataGridColumn headerText="Weight (Kg)" dataField="Weight" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" width="60" labelFunction="applyNumberFormatOnWeight"/>
					<mx:DataGridColumn headerText="Temp (C)" dataField="Temperature" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" width="60" labelFunction="applyNumberFormatOnTemp"/>
					<mx:DataGridColumn headerText="Pulse (Min)" dataField="Pulse" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" width="60" labelFunction="getPulse"/>
					<mx:DataGridColumn headerText="Resp (Min)" dataField="Respiration" width="60" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="getResp"/>
					<mx:DataGridColumn headerText="Oxy (%)" dataField="Oxygen" width="60" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="getOxy"/>
					<mx:DataGridColumn headerText="BP(Sys)" dataField="BPSys" width="60" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="getBPs"/>
					<mx:DataGridColumn headerText="BP(Dys)" dataField="BPDys" width="60" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="grtBPd"/>
					<mx:DataGridColumn  width="85" itemRenderer="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.commons.DeleteEditOnlyRenderer" />
				</mx:columns>
			</mx:DataGrid>
			
		</s:SkinnableContainer>
	</custom:Contents>
