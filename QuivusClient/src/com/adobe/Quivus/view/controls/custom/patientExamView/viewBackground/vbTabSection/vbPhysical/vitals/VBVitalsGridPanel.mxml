			private function GridItemEditEndHandler(event:DataGridEvent):void
			{
				
				var pID:int = VitalDTO(id_DataGrid.selectedItem).PatientVitalID;
				var isRecordEditable:Boolean = VitalDTO(id_DataGrid.selectedItem).IsRecordEditable;
				
				if(isRecordEditable)
				{
					
					
					if (event.dataField == "Height")
					{
						var original_value:String = TextInput(id_DataGrid.itemEditorInstance).text;
						var itemEditor:TextInput = TextInput(id_DataGrid.itemEditorInstance);
						
						if (itemEditor.text.length)
						{
							
							
							if((parseInt(itemEditor.text) < 38 || parseInt(itemEditor.text) > 245))
							{
								Alert.show("Provided value for height does not occur in feasible range.\n Do you want to keep these values",
									"Height out of Range error", Alert.YES|Alert.NO, FlexGlobals.topLevelApplication.mainContainer, function(evt:CloseEvent):void
									{									
										switch(evt.detail)
										{
											case Alert.YES:							
												event.itemRenderer.data.Height = itemEditor.text;//selectedDate;
												
												if (pID != 0)
													event.itemRenderer.data.IsDirty = true;
												
												hasViewChanged = _hasGridChanged = true;
												break;
											
											case Alert.NO:
												itemEditor.text = original_value;
												id_DataGrid.destroyItemEditor();
												//event.stopImmediatePropagation();
												//vital.setFocus();
												break;	
										}
										return;	
										
									});
							}
							else
							{
								event.itemRenderer.data.Height = original_value;//selectedDate;
								
								if (pID != 0)
									event.itemRenderer.data.IsDirty = true;
								
								hasViewChanged = _hasGridChanged = true;
							}
							
							
						}
						
						id_DataGrid.destroyItemEditor();
						event.stopImmediatePropagation();
						event.preventDefault();
						
					}
						
