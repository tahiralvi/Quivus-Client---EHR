			private function populateVitalsData():void
			{
				if (model.quickInputDTO!=null && model.quickInputDTO.Physical!=null && model.quickInputDTO.Physical.Vitals!=null)
				{
					var vitalDTO:VitalDTO = VitalDTO(model.quickInputDTO.Physical.Vitals);
					var dataPvdr:ArrayCollection = new ArrayCollection();
					
					/**
					 * If all values in vitals are zero then do not show the grid*/
					var allValuesAreZero:Boolean= true;
					
					var numberFormator:NumberFormatter = new NumberFormatter();
					numberFormator.precision = 2;
					numberFormator.rounding = NumberBaseRoundType.NEAREST;
	//Tahir Alvi [27-08-2011]- Oxygen Column is added								
					if (vitalDTO)
					{
						var data:Object = {BPSys:"", BPDys:"", oxygen:"", pulse:"", respiration:"", temperature:"", height: "", weight:"", notes: ""};
						
						data["oxygen"] = numberFormator.format(vitalDTO.Oxygen);
						if(vitalDTO.Oxygen && vitalDTO.Oxygen != "0")
							allValuesAreZero = false;
						
						data["height"] = numberFormator.format(vitalDTO.Height);
							
						if (vitalDTO.Height && vitalDTO.Height != "0")
							allValuesAreZero = false;
						
						data["weight"] = numberFormator.format(vitalDTO.Weight);
							
						if (allValuesAreZero && (!vitalDTO.Weight || vitalDTO.Weight == "0"))
							allValuesAreZero = true;
						
						else
							allValuesAreZero = false;
						
						data["temperature"] = numberFormator.format(vitalDTO.Temperature);
							
						if (allValuesAreZero && (!vitalDTO.Temperature || vitalDTO.Temperature == "0"))
							allValuesAreZero = true;
						
						else
							allValuesAreZero = false;
						
						data["pulse"] = vitalDTO.Pulse;
							
						if (allValuesAreZero && (!vitalDTO.Pulse || vitalDTO.Pulse == "0"))
							allValuesAreZero = true;
						
						else
							allValuesAreZero = false;
						
						data["respiration"] = vitalDTO.Respiration;
							
						if (allValuesAreZero && (!vitalDTO.Respiration || vitalDTO.Respiration == "0"))
							allValuesAreZero = true;
						
						else
							allValuesAreZero = false;
						
						var bp:String = "";
						
						if (vitalDTO.BPSys)
							bp += vitalDTO.BPSys;
						else
							bp += "0"
							
						if (allValuesAreZero && (!vitalDTO.BPSys || vitalDTO.BPSys == "0"))
							allValuesAreZero = true;
						
						else
							allValuesAreZero = false;
						
						bp += "/";
						
						if (vitalDTO.BPDys)
							bp += vitalDTO.BPDys;
						else 
							bp += "0";
							
						if (allValuesAreZero && (!vitalDTO.BPDys || vitalDTO.BPDys == "0"))
							allValuesAreZero = true;
						
						else
							allValuesAreZero = false;
						
						data["BP"] = bp;
						
						data["notes"] = vitalDTO.VitalNote;
						
						if (!allValuesAreZero)
						{
							dataPvdr.addItem(data);
						
							
							
							var height:DataGridColumn = new DataGridColumn();
							height.headerText = "Height(Cm)";
							height.headerWordWrap="true";
							//height.width=40;
							height.wordWrap="true";
							height.dataField = "height";
							
							var weight:DataGridColumn = new DataGridColumn();
							weight.headerText = "Weight(Kg)";
							weight.dataField = "weight";
							weight.headerWordWrap="true";
							//weight.width=40;
							weight.wordWrap="true";
							
							var temperature:DataGridColumn = new DataGridColumn();
							temperature.headerText = "Temp(F)";
							temperature.dataField = "temperature";
							temperature.headerWordWrap="true";
							//temperature.width=80;
							temperature.wordWrap="true";
						
							
							var pulse:DataGridColumn = new DataGridColumn();
							pulse.headerText = "Pulse(Min)";
							pulse.dataField = "pulse";
							pulse.headerWordWrap="true";
							//pulse.width=50;
							
							
							var respiration:DataGridColumn = new DataGridColumn();
							respiration.headerText = "RR(Min)";
							respiration.dataField = "respiration";
							respiration.headerWordWrap="true";
							//respiration.width=40;
							
					
							var oxygen:DataGridColumn = new DataGridColumn();
							oxygen.headerText = "Oxygen(%)";
							oxygen.dataField = 'oxygen';
							oxygen.headerWordWrap="true";
							//oxygen.width=40;
							
							var bloodPressure:DataGridColumn = new DataGridColumn();
							bloodPressure.headerText = "BP(Sys/Dys)";
							bloodPressure.dataField = "BP";
							bloodPressure.headerWordWrap="true";
							//bloodPressure.width=40;
							
							
							var notes:DataGridColumn = new DataGridColumn();
							notes.headerText = "Notes";
							notes.dataField = "notes";
							notes.wordWrap = true;
							
							vitalsView.columns = new ArrayCollection([{subColumns: 
								[{height: height}, {weight: weight}, {temperature: temperature}, {pulse: pulse}, {respiration: respiration},{oxygen: oxygen}, {BP: bloodPressure}, {notes: notes}]
							}]);
							
							vitalsView.dataProvider = new ArrayCollection([{subDataProvider: dataPvdr}]);
						}
					}
				}
