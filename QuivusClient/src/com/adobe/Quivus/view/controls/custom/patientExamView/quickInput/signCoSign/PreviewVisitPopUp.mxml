			private function populatePatientFollowUp():void
			{
				if (model.quickInputDTO!=null && model.quickInputDTO.Assessment!=null )
				{
					var dataPvdr:ArrayCollection = new ArrayCollection();
					var cols:ArrayCollection = new ArrayCollection();
					
					if(model.quickInputDTO.Assessment.PatientFollowUp!=null)
					{
						var tempData:PatientFollowUpDTO = model.quickInputDTO.Assessment.PatientFollowUp;
						
						if (tempData)
						{
							var subDataPvdr:ArrayCollection = new ArrayCollection();
							var data:Object = {followUpType: "", followUp: "", followUpMethod: ""};
							
							if (tempData.IsByDate)
							{
								data["followUpType"] = "By Date";
								data["followUp"] = "Date( " + tempData.FollowUpDate + " )";
							}
							else if (tempData.IsOnCompletion)
							{
								data["followUpType"] = "Upon Completion Of";
								
								if (tempData.IsLabTestSelected)
								{
									for (var i:int = 0; i < model.followupLabsDTOList.length; i++)
									{
										var labsDTO:FollowupLabsDTO = FollowupLabsDTO(model.followupLabsDTOList[i]);
										
										
											if (tempData.LabTestID == labsDTO.PatientFollowUpLabID)
											{
												data["followUp"] = "Lab Test( " + labsDTO.LabTestDescription + " )";
												break;
											}
									}	
								}
								
								else if (tempData.IsDrugselected)
								{
									for (var j:int = 0; j < model.medicationDTOList.length; j++)
									{
										var drugsDTO:MedicationDTO = MedicationDTO(model.medicationDTOList[j]);
										
										if (tempData.DrugID == drugsDTO.PatientMedicationID)
										{
											data["followUp"] = "Drug( " + drugsDTO.BrandName  + " )";
											break;
										}
									}
								}
							}
							
							if (tempData.FollowUpMethodType)
								data["followUpMethod"] = tempData.FollowUpMethodType.MethodName;
							
							subDataPvdr.addItem(data);
							
							var followUpTypeCol:DataGridColumn = new DataGridColumn("followUpType");
							followUpTypeCol.width = 80;
							followUpTypeCol.headerText = "Follow Up Type";
							
							var followUpCol:DataGridColumn = new DataGridColumn("followUp");
							followUpCol.width = 80;
							followUpCol.headerText = "Follow Up";
							
							/* if (tempData.IsByDate)//commented due to date to string converion
								followUpCol.itemRenderer = new ClassFactory(com.adobe.Quivus.view.controls.custom.itemRenderer.DateRenderer4DG); */
							
							var followUpMethodCol:DataGridColumn = new DataGridColumn("followUpMethod");
							followUpMethodCol.width = 100;
							followUpMethodCol.headerText = "Follow Up Method";
							
							cols.addItem({"subColumns": [{followUpType: followUpTypeCol}, {followUp: followUpCol}, {followUpMethod: followUpMethodCol}]});
								
							dataPvdr.addItem({"subDataProvider": subDataPvdr});
						}
					}
					
					populatePatientFollowUpInstruction(dataPvdr, cols);
					
					followUpView.columns = cols;
					followUpView.dataProvider = dataPvdr;
				}
			}
			
			private function populatePatientFollowUpInstruction(dataPvdr:ArrayCollection, cols:ArrayCollection):void
			{
				if (model.quickInputDTO.Assessment.PatientFollowupInstruction)
				{
					var tempData:ArrayCollection = model.quickInputDTO.Assessment.PatientFollowupInstruction;
					var subDataPvdr:ArrayCollection = new ArrayCollection();
					
					if (tempData)
					{
						for (var i:int = 0; i < tempData.length; i++)
						{
							var patientFollowUpInstruction:PatientFollowupInstructionDTO = PatientFollowupInstructionDTO(tempData[i]);
							
							if (patientFollowUpInstruction)
							{
								var data:Object = {instruction: "", freqType: "", freq: ""};
								
								data["instruction"] = patientFollowUpInstruction.objServiceTypeDTO.FollowupService;
								
								if (patientFollowUpInstruction.IsAgeSelected)
								{
									data["freqType"] = "Age";
									
									if (patientFollowUpInstruction.AgeTypeDTO && patientFollowUpInstruction.AgeTypeDTO.AgeTypeName)
										data["freq"] = patientFollowUpInstruction.AgeTypeDTO.AgeTypeName + " ";
									
									if (patientFollowUpInstruction.AgeValueTypeDTO && patientFollowUpInstruction.AgeValueTypeDTO.AgeValueTypeName)
										data["freq"] += patientFollowUpInstruction.AgeValueTypeDTO.AgeValueTypeName;
								}
								else
								{
									data["freqType"] = "Duration";
									data["freq"] = "After " + patientFollowUpInstruction.AfterDurationValue + " ";
									
									if (patientFollowUpInstruction.AfterInstructionDurationTypeDTO && patientFollowUpInstruction.AfterInstructionDurationTypeDTO.DurationTypeName)
										data["freq"] += patientFollowUpInstruction.AfterInstructionDurationTypeDTO.DurationTypeName +
												   " for " + patientFollowUpInstruction.ForDurationValue + " ";
									
									if (patientFollowUpInstruction.ForInstructionDurationTypeDTO && patientFollowUpInstruction.ForInstructionDurationTypeDTO.DurationTypeName)
										data["freq"] += patientFollowUpInstruction.ForInstructionDurationTypeDTO.DurationTypeName;
								}
								
								subDataPvdr.addItem(data);
							}
						}
						
						var inst:DataGridColumn = new DataGridColumn();
						inst.headerText = "Instruction";
						inst.dataField = "instruction";
						inst.width=80;
						inst.wordWrap="true";
						
						var freqType:DataGridColumn = new DataGridColumn();
						freqType.headerText = "Frequency Type";
						freqType.dataField = "freqType";
						freqType.width=80;
						freqType.wordWrap="true";
						
						var freq:DataGridColumn = new DataGridColumn();
						freq.headerText = "Frequency";
						freq.dataField = "freq";
						freq.width=80;
						freq.wordWrap="true";
						
						cols.addItem({"subColumns": [{instruction: inst}, {freqType: freqType}, {freq: freq}]});
						dataPvdr.addItem({"subDataProvider": subDataPvdr});
					}
				}
			}
			
			private function populateROSData():void
			{
				var dataPvdr:ArrayCollection = new ArrayCollection();
				
				for (var j:int = 0; j < model.rosDTOList.length; j++)
				{
					var rosDTO:ROSDTO = model.rosDTOList[j];
					
					if (rosDTO)
					{
						var children:ArrayCollection = rosDTO.children;
						
						if (children)
						{
							var firstChildStr:String ="";
							var firstchildNotes:String ="";
							var data:Object = {type: "", normal: "", notes: ""};
							
							for (var i:int = 0; i < children.length; i++)
							{
								var childROS:ROSDTO = children[i] ;
								
								if (childROS.children!=null && childROS.children.length>0)
								{
									var innerChildStr:String ="";
									var innerchildNotes:String ="";
									var subdata:Object = {type: "", normal: "", notes: ""};
									for(var k:uint=0;k<childROS.children.length;k++)
									{
										var subChild:ROSDTO = childROS.children.getItemAt(k) as ROSDTO ;
										if ( subChild.IsNormal && subChild.IsNormal.length && subChild.IsNormal != Constants.STRING_NULL)
										{
											var normal:String = (subChild.IsNormal == Constants.STRING_TRUE)? "NORMAL":"ABNORMAL";
											innerChildStr += subChild.label + ": " + normal + ", ";
											if( subChild.Notes && subChild.Notes.length )
												innerchildNotes +=  subChild.label + ": " + subChild.Notes + ", ";
											
										}
									}
									if( innerChildStr && innerChildStr.length )
									{
										subdata["type"] 			= subChild.SubCategoryName;
										subdata["typeValue"] 		= innerChildStr.substr(0,innerChildStr.length-2); 
										subdata["notes"] 			= innerchildNotes.substr(0,innerchildNotes.length-2); 
										dataPvdr.addItem(subdata); 
									}
								}
								else if (childROS.IsNormal && childROS.IsNormal.length && childROS.IsNormal != Constants.STRING_NULL)
								{
									var normal:String = (childROS.IsNormal == Constants.STRING_TRUE)? "NORMAL":"ABNORMAL";
									firstChildStr += childROS.SubCategoryName + ": " + normal + ", ";
									if( childROS.Notes && childROS.Notes.length )
										firstchildNotes +=  childROS.SubCategoryName + ": " + childROS.Notes + ", ";
								}
							}  
							
							if( firstChildStr && firstChildStr.length )
							{
								var data:Object = {type: "", typeValue:"", notes:""};
								data["type"] = rosDTO.MainCategoryName;
								data["typeValue"] = firstChildStr.substr(0, firstChildStr.length-2);
								if( firstchildNotes && firstchildNotes.length )
									data["notes"] = firstchildNotes.substr(0, firstchildNotes.length-2);
									data["IsNormal"] = childROS.IsNormal;
									dataPvdr.addItem(data);
								}
							}
						}
					}
				
				if (dataPvdr.length)
				{
					var type:DataGridColumn = new DataGridColumn();
					type.headerText = "Type";
					type.dataField = "type";
					
					var typeValue:DataGridColumn = new DataGridColumn();
					typeValue.headerText = "Type value";
					typeValue.dataField = "typeValue";
					typeValue.wordWrap = true;
					
					var notes:DataGridColumn = new DataGridColumn();
					notes.headerText = "Notes";
					notes.dataField = "notes";
					notes.wordWrap = true;
					
					rosView.columns = new ArrayCollection([{subColumns: 
						[{type: type}, {typeValue: typeValue}, {notes: notes}]
					}]);
					
					rosView.dataProvider = new ArrayCollection([{subDataProvider: dataPvdr}]);
				}
			}
			
			private function refreshModel():void
			{
				if (model.quickInputDTO)
				{
					if (model.quickInputDTO.PMH)
					{
						if (model.quickInputDTO.PMH.Immunization)
						{
							model.quickInputDTO.PMH.Immunization.filterFunction = null;
							model.quickInputDTO.PMH.Immunization.refresh();
						}
					}
					
					if (model.quickInputDTO.Physical)
					{
						if (model.quickInputDTO.Physical.HPI_CC)
						{
							model.quickInputDTO.Physical.HPI_CC.filterFunction = null;
							model.quickInputDTO.Physical.HPI_CC.refresh();
						}
						
						if (model.quickInputDTO.Physical.InHouseLabs)
						{
							model.quickInputDTO.Physical.InHouseLabs.filterFunction = null;
							model.quickInputDTO.Physical.InHouseLabs.refresh();
						}
						
						if (model.quickInputDTO.Physical.Labs)
						{
							model.quickInputDTO.Physical.Labs.filterFunction = null;
							model.quickInputDTO.Physical.Labs.refresh();
						}
					}
					
					if (model.quickInputDTO.Assessment)
					{
						if (model.quickInputDTO.Assessment.Diagnosis)
						{
							model.quickInputDTO.Assessment.Diagnosis.filterFunction = null;
							model.quickInputDTO.Assessment.Diagnosis.refresh();
						}
						
						if (model.quickInputDTO.Assessment.Procedure)
						{
							model.quickInputDTO.Assessment.Procedure.filterFunction = null;
							model.quickInputDTO.Assessment.Procedure.refresh();
						}
						
						if (model.quickInputDTO.Assessment.Recommendation)
						{
							model.quickInputDTO.Assessment.Recommendation.filterFunction = null;
							model.quickInputDTO.Assessment.Recommendation.refresh();
						}
						
						if (model.quickInputDTO.Assessment.PatientFollowupInstruction)
						{
							model.quickInputDTO.Assessment.PatientFollowupInstruction.filterFunction = null;
							model.quickInputDTO.Assessment.PatientFollowupInstruction.refresh();
						}
					}
				}
			}
			
			private function okBtnClickHandler():void
			{
				refreshModel();
				var statusMessage:String = "Please wait while ";
				switch(previewWindowType)
				{
					case SIGN_COSIGN:
						if (!authenticationPopUp)
							authenticationPopUp = new AuthenticationPopUp();
						
						if (model.visitDTO)
							authenticationPopUp.visitID = model.visitDTO.VisitId;
						
						authenticationPopUp.signBtnLabel = model.signCoSignBtnLabel;
						authenticationPopUp.originName = Constants.QUICK_INPUT_MODULE_NAME;
						authenticationPopUp.onVisitSignCosignCallback = onSucessfullVisitSave;
						authenticationPopUp.ShowPopup(this);
						
						statusMessage = statusMessage + "sign / co-sign visit."
						
						break;
					
					case REVIEW_ALL:
						
						statusMessage = statusMessage + "saving visit data."
						break;
					
					case SAVE_AND_REVIEW:
						var MVDEvent:ManageQuickInputEvent = new ManageQuickInputEvent( true);
						MVDEvent.functionName = onSucessfullVisitSave;
						CairngormEventDispatcher.getInstance().dispatchEvent( MVDEvent );
						
						var uvEvent:UpdateVisitEvent = new UpdateVisitEvent(  );
						CairngormEventDispatcher.getInstance().dispatchEvent( uvEvent );
						
						statusMessage = statusMessage + "saving visit data."
						
						break;
				}
				
				statusCallback( statusMessage );
			}
			
			private function cancelBtnClickHandler():void
			{
				hide();
			}
			
			private function onSucessfullVisitSave(actionName:String = "", visitID:int = 0):void
			{
				hide(true, actionName, visitID);
			}
			
			// for printing
			public function printBtnClickHandler():void {
				// Create a FlexPrintJob instance.
				var printJob:FlexPrintJob = new FlexPrintJob();
				
				// Start the print job.
				if(printJob.start()) 
				{
					// Create a MyPrintView control as a child 
					// of the current view.
					
					/*
					var formPrintView:MyPrintView = new MyPrintView();
					addElement(formPrintView);
					*/
					
					// Populate the print control's contact label 
					// with the text from the form's name, 
					// phone, and e-mail controls.
					/* formPrintView.contact.text = 
						"Contact: " + custName.text + "  " +
						custPhone.text + "  " + custEmail.text;
					 */
					// Set the print control's data grid data provider to be 
					// the displayed data grid's data provider.
					/* formPrintView.myDataGrid.dataProvider = 
						myDataGrid.dataProvider; */
					
					// Add the SimplePrintview control to the print job.
					// For comparison, try setting the 
					// second parameter to "none".
					
					if(this.allergiesView && this.allergiesView.dataProvider && this.allergiesView.dataProvider.length > 0)					
					{
						printJob.addObject(this.allergiesView, FlexPrintJobScaleType.NONE);	
					}
					
					if(this.comprehensiveHistory && this.comprehensiveHistory.dataProvider && this.comprehensiveHistory.dataProvider.length > 0)					
					{
						printJob.addObject(this.comprehensiveHistory, FlexPrintJobScaleType.NONE);
					}
					
					if(this.medicationView && this.medicationView.dataProvider && this.medicationView.dataProvider.length > 0)					
					{
						printJob.addObject(this.medicationView, FlexPrintJobScaleType.NONE);					
					}
					
					if(this.immunizationView && this.immunizationView.dataProvider && this.immunizationView.dataProvider.length > 0)					
					{
						printJob.addObject(this.immunizationView, FlexPrintJobScaleType.NONE);
					}
					
					if(this.vitalsView && this.vitalsView.dataProvider && this.vitalsView.dataProvider.length > 0 )					
					{
						printJob.addObject(this.vitalsView, FlexPrintJobScaleType.NONE);
					}
					
					if(this.ccHPIView && this.ccHPIView.dataProvider && this.ccHPIView.dataProvider.length > 0)					
					{
						printJob.addObject(this.ccHPIView, FlexPrintJobScaleType.NONE);
					}
					
					if(this.rosView && this.rosView.dataProvider && this.rosView.dataProvider.length > 0)					
					{
						printJob.addObject(this.rosView, FlexPrintJobScaleType.NONE);
					}
					
					if(this.physicalView && this.physicalView.dataProvider && this.physicalView.dataProvider.length > 0)					
					{
						printJob.addObject(this.physicalView, FlexPrintJobScaleType.NONE);
					}
					
					if(this.inHouseLabView && this.inHouseLabView.dataProvider && this.inHouseLabView.dataProvider.length > 0)					
					{
						printJob.addObject(this.inHouseLabView, FlexPrintJobScaleType.NONE);
					}
					
					if(this.diagnosisView && this.diagnosisView.dataProvider && this.diagnosisView.dataProvider.length > 0)					
					{
						printJob.addObject(this.diagnosisView, FlexPrintJobScaleType.NONE);
					}
					
					if(this.procedureView && this.procedureView.dataProvider && this.procedureView.dataProvider.length > 0)					
					{
						printJob.addObject(this.procedureView, FlexPrintJobScaleType.NONE);
					}
					
					if(this.labsView && this.labsView.dataProvider && this.labsView.dataProvider.length > 0)					
					{
						printJob.addObject(this.labsView, FlexPrintJobScaleType.NONE);					
					}
					
					if(this.recommendationView && this.recommendationView.dataProvider && this.recommendationView.dataProvider.length > 0)					
					{
						printJob.addObject(this.recommendationView, FlexPrintJobScaleType.NONE);
					}
					
					if(this.followUpView && this.followUpView.dataProvider && this.followUpView.dataProvider.length > 0)					
					{
						printJob.addObject(this.followUpView, FlexPrintJobScaleType.NONE);
					}
					// Send the job to the printer.
					printJob.send();
					
					// Remove the print-specific control to free memory.
					//removeElement(formPrintView);
				}
			}
					
