			public function show(value:String = "", arg_callback:Function = null, status_callback:Function = null):void
			{
				this.previewWindowType = value;
				
				PopUpManager.addPopUp(this, FlexGlobals.topLevelApplication.mainContainer, true);
				
				populateAllergiesData();
				populateChronicMedicationData();
				populateComprehensiveHistoryData();
				populateImmunizationData();
				populateVitalsData();
				populateChiefComplaintAndHPIData();
				populateROSData();
				populatePhysicalData();
				populateInHouseLabData();
				populateDiagnosisData();
				populateProcedureData();
				populateLabsData();
				populateRecommendationData();
				populatePatientFollowUp();
				
				switch(value)
				{
					case REVIEW_ALL:
						this.title = "Patient History for Review";
						this.okBtn.label = "OK";
						this.okBtn.visible = false;
						this.cancelBtn.label = "Close";
						break;
					
					case SIGN_COSIGN:
						this.title = "Final Review";
						this.okBtn.label = model.signCoSignBtnLabel;
						break;
					
					case SAVE_AND_REVIEW:
						this.title = "Final Review";
						this.okBtn.label = "Save";
						break;
				}
				
				callback = arg_callback;
				statusCallback = status_callback
			}
			
			public function hide(doClose:Boolean = false, actionName:String = "", visitID:int = 0):void
			{
				PopUpManager.removePopUp(this);
				
				if (null != callback && doClose)
					callback(actionName, visitID);
			}
			
			private function closePopUpHandler(event:CloseEvent):void
			{
				hide();
			}
			
			private function populateAllergiesData():void
			{	
				var tempData:ArrayCollection = model.quicInputAllergyDTOList;
				
				if (tempData)
				{
					var dataPvdr:ArrayCollection = new ArrayCollection();
					
					for (var i:int = 0; i < tempData.length; i++)
					{
						var data:Object = {onSet: "", allergy: "", reaction: "", notes: ""};
						var allergiesDTO:AllergyDTO = AllergyDTO(tempData[i]);
						
						if (allergiesDTO)
						{
							data["onSet"] = allergiesDTO.OnSet;
							data["allergy"] = allergiesDTO.AllergyName
							data["reaction"] = allergiesDTO.Reaction
							data["notes"] = allergiesDTO.Note;
						}
						
						dataPvdr.addItem(data);
					}
					
					var onSet:DataGridColumn = new DataGridColumn();
					onSet.headerText = "OnSet";
					onSet.dataField = "onSet";
//					onSet.itemRenderer = new ClassFactory(DateRenderer4DG); //commented due to date to string converion
					
					var allergy:DataGridColumn = new DataGridColumn();
					allergy.headerText = "Allergy";
					allergy.dataField = "allergy";
					
					var reaction:DataGridColumn = new DataGridColumn();
					reaction.headerText = "Reaction";
					reaction.dataField = "reaction";
					
					var notes:DataGridColumn = new DataGridColumn();
					notes.headerText = "Notes";
					notes.dataField = "notes";
					notes.wordWrap = true;
					
					allergiesView.columns = new ArrayCollection([{subColumns:
							[{onSet: onSet}, {allergy: allergy}, {notes: notes}]}]);
					
					allergiesView.dataProvider = new ArrayCollection([{subDataProvider: dataPvdr}]);
				}
			}
			
