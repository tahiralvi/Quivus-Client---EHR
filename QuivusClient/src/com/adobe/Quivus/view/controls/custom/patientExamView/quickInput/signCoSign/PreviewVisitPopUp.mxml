			private function populatePhysicalData():void
			{
				var dataPvdr:ArrayCollection = new ArrayCollection();
					
				if (model.physicalsDTOList)
				{
					for (var i:int = 0; i < model.physicalsDTOList.length; i++)
					{
						var dto:PhysicalsDTO = model.physicalsDTOList.getItemAt(i) as PhysicalsDTO ; 
						var children:ArrayCollection = dto.children;
						if (children)
						{
							var j:int;
							var firstChildStr:String ="";
							var firstchildNotes:String ="";
							var data:Object = {type: "", normal: "", notes: ""};
						
							for(j=0;j<dto.children.length;j++)
							{
								var child:PhysicalsDTO = dto.children.getItemAt(j) as PhysicalsDTO ; 
								if(child.children!=null && child.children.length>0)
								{
									var k:int;
									var innerChildStr:String ="";
									var innerchildNotes:String ="";
									var subdata:Object = {type: "", normal: "", notes: ""};
						
									for(k=0;k<child.children.length;k++)
						{
										var subChild:PhysicalsDTO = child.children.getItemAt(k) as PhysicalsDTO ;
										if ( subChild.IsNormal && subChild.IsNormal.length && subChild.IsNormal != Constants.STRING_NULL)
							{
											var normal:String = (subChild.IsNormal == Constants.STRING_TRUE)? "NORMAL":"ABNORMAL";
											innerChildStr += subChild.label + ": " + normal + ", ";
											if( subChild.Notes && subChild.Notes.length )
												innerchildNotes +=  subChild.label + ": " + subChild.Notes + ", ";
								
										}
									}
									if( innerChildStr && innerChildStr.length )
								{
										subdata["type"] 			= subChild.SubCategoryName;
										subdata["typeValue"] 		= innerChildStr.substr(0,innerChildStr.length-2); 
										subdata["notes"] 			= innerchildNotes.substr(0,innerchildNotes.length-2); 
										dataPvdr.addItem(subdata); 
									}
								}
								else if (child.IsNormal && child.IsNormal.length && child.IsNormal != Constants.STRING_NULL)
								{
									var normal:String = (child.IsNormal == Constants.STRING_TRUE)? "NORMAL":"ABNORMAL";
									firstChildStr += child.SubCategoryName + ": " + normal + ", ";
									if( child.Notes && child.Notes.length )
										firstchildNotes +=  child.SubCategoryName + ": " + child.Notes + ", ";
								}
							}
									
							if( firstChildStr && firstChildStr.length )
							{
								data["type"] 			= child.MainCategoryName;
								data["typeValue"] 		= firstChildStr.substr(0, firstChildStr.length-2);
								data["notes"] 			= firstchildNotes.substr(0,firstchildNotes.length-2);
									dataPvdr.addItem(data);
								}
							}
						}
					
					if(dataPvdr.length){
						
					var type:DataGridColumn = new DataGridColumn();
					type.headerText = "Type";
					type.dataField = "type";
						type.width=15;
					
					var typeValue:DataGridColumn = new DataGridColumn();
					typeValue.headerText = "Type Value";
					typeValue.dataField = "typeValue";
						typeValue.width=40;
						typeValue.headerWordWrap="true";
						typeValue.wordWrap = true;
					
					
					var notes:DataGridColumn = new DataGridColumn();
					notes.headerText = "Notes";
					notes.dataField = "notes";
					notes.wordWrap = true;
						notes.width=80;
					
					physicalView.columns = new ArrayCollection([{subColumns: 
							[{type: type}, {typeValue: typeValue}, {notes: notes}]
					}]);
					
					physicalView.dataProvider = new ArrayCollection([{subDataProvider: dataPvdr}]);
				}
			}
			}
			
