			private function populateSocialHistory(dataPvdr:ArrayCollection, cols:ArrayCollection):void
			{
				var data:Object;
				var subDataPvdr:ArrayCollection = new ArrayCollection();
				
				var socialHistoryAddiction:SocialHistoryAddictionDTO;
				
				socialHistoryAddiction = QSUtilityFunctions.getSocialHistoryAddictionDTOByName(Constants.SOCIAL_TOBACCO_MODULE_NAME);
				
				if (socialHistoryAddiction && (socialHistoryAddiction.IsYesSelected || socialHistoryAddiction.IsNoSelected || socialHistoryAddiction.IsUnknown))
				{
					data = {socialHistory: "", current: "", notes: ""};
					
					data["socialHistory"] = Constants.SOCIAL_TOBACCO_MODULE_NAME;
					
					if (socialHistoryAddiction.IsYesSelected && socialHistoryAddiction.IsYesSelected == Constants.STRING_TRUE)
						data["current"] = "Yes";
					
					else if (socialHistoryAddiction.IsNoSelected && socialHistoryAddiction.IsNoSelected == Constants.STRING_TRUE)
						data["current"] = "No";
					
					else if (socialHistoryAddiction.IsUnknown)
						data["current"] = "Unknown";
					
					/* data["notes"] = socialHistoryAddiction.;
					data["notes"] = socialHistoryAddiction.AddictionNotes; */
					data["notes"] = socialHistoryAddiction.AddictionNotes;
					
					subDataPvdr.addItem(data);
				}
				
				socialHistoryAddiction = QSUtilityFunctions.getSocialHistoryAddictionDTOByName(Constants.SOCIAL_ALCOHOL_MODULE_NAME);
				
				if (socialHistoryAddiction && (socialHistoryAddiction.IsYesSelected || socialHistoryAddiction.IsNoSelected))
				{
					data = {socialHistory: "", current: "", notes: ""};
					
					data["socialHistory"] = Constants.SOCIAL_ALCOHOL_MODULE_NAME;
					
					if (socialHistoryAddiction.IsYesSelected && socialHistoryAddiction.IsYesSelected.toLowerCase() == Constants.STRING_TRUE)
						data["current"] = "Yes";
						
					else if (socialHistoryAddiction.IsNoSelected && socialHistoryAddiction.IsNoSelected.toLowerCase() == Constants.STRING_TRUE)
						data["current"] = "No";
					
					data["notes"] = socialHistoryAddiction.AddictionNotes;
					
					subDataPvdr.addItem(data);
				}
				
				socialHistoryAddiction = QSUtilityFunctions.getSocialHistoryAddictionDTOByName(Constants.SOCIAL_DRUGS_MODULE_NAME);
				
				if (socialHistoryAddiction && (socialHistoryAddiction.IsYesSelected || socialHistoryAddiction.IsNoSelected))
				{
					data = {socialHistory: "", current: "", notes: ""};
					
					data["socialHistory"] = Constants.SOCIAL_DRUGS_MODULE_NAME;
					
					if (socialHistoryAddiction.IsYesSelected && socialHistoryAddiction.IsYesSelected.toLowerCase() == Constants.STRING_TRUE)
						data["current"] = "Yes";
						
					else if (socialHistoryAddiction.IsNoSelected && socialHistoryAddiction.IsNoSelected.toLowerCase() == Constants.STRING_TRUE)
						data["current"] = "No";
					
					data["notes"] = socialHistoryAddiction.AddictionNotes;
					
					subDataPvdr.addItem(data);
				}
				
				if (model.socialHistoryDTO)
				{
					var otherSocialHistory:SocialHistoryDTO = SocialHistoryDTO(model.socialHistoryDTO);
					
					if (otherSocialHistory.IsWorkStatusYesSelected)
					{
						data = {socialHistory: "", current: "", notes: ""};
						data["socialHistory"] = Constants.SOCIAL_WORK_STATUS_MODULE_NAME;
						
						if (otherSocialHistory.IsWorkStatusYesSelected == Constants.STRING_TRUE)
							data["current"] = "Yes";
						else 
							data["current"] = "No";
						
						data["notes"] = otherSocialHistory.WorkStatusNotes;
						
						subDataPvdr.addItem(data);
					}
					
					var maritalStatus:String = QSUtilityFunctions.getMaritalStatusNameById(otherSocialHistory.MaritalStatusID);
					
					if (maritalStatus && maritalStatus.length)
					{
						data = {socialHistory: "", current: "", notes: ""};
						data["socialHistory"] = Constants.SOCIAL_MERITAL_STATUS_MODULE_NAME;
						
						data["current"] = maritalStatus;
						
						subDataPvdr.addItem(data);
					}
					
					if (otherSocialHistory.IsOtherYesSelected)
					{
						data = {socialHistory: "", current: "", notes: ""};
						data["socialHistory"] = Constants.OTHER_MODULE_NAME;
						
						if (otherSocialHistory.IsOtherYesSelected == Constants.STRING_TRUE)
							data["current"] = "Yes";
						else
							data["current"] = "No";
						
						data["notes"] = otherSocialHistory.OtherNotes;
						
						subDataPvdr.addItem(data);
					}
					
				}
				var socialHistory:DataGridColumn = new DataGridColumn();
				socialHistory.headerText = "Social History";
				socialHistory.dataField = "socialHistory";
				socialHistory.width = 100;
				socialHistory.wordWrap="true";
				
				var current:DataGridColumn = new DataGridColumn();
				current.headerText = "Current";
				current.dataField = "current";
				current.width = 100;
				current.wordWrap=true;
				
				var notes:DataGridColumn = new DataGridColumn();
				notes.headerText = "Notes";
				notes.dataField = "notes";
				notes.wordWrap = true;
				notes.width = 200;
				
				cols.addItem({"subColumns": [{socialHistory: socialHistory}, {current: current}, {notes: notes}]});
				dataPvdr.addItem({"subDataProvider": subDataPvdr});
			}
			
			private function populateComprehensiveHistoryData():void
			{
				var dataPvdr:ArrayCollection = new ArrayCollection();
				var comprehensiveHistoryCols:ArrayCollection = new ArrayCollection();
				
				populateGeneralHistory(dataPvdr, comprehensiveHistoryCols);
				populateFamilyHistory(dataPvdr, comprehensiveHistoryCols);
				populateSocialHistory(dataPvdr, comprehensiveHistoryCols);
				
				comprehensiveHistory.columns =  comprehensiveHistoryCols;
				comprehensiveHistory.dataProvider = dataPvdr;
			}
			
			private function populateImmunizationData():void
			{
				if(model.quickInputDTO!=null && model.quickInputDTO.PMH!=null &&  model.quickInputDTO.PMH.Immunization!=null)
				{
					var tempData:ArrayCollection = model.quickInputDTO.PMH.Immunization;
					
					if (tempData)
					{
						var dataPvdr:ArrayCollection = new ArrayCollection();
						
						for (var i:int = 0; i < tempData.length; i++)
						{
							var data:Object = {immunization: "", dose: "", lotNo: "", dateAdmin: "", nextDue: "", notes: ""};
							var immunizationDTO:ImmunizationDTO = ImmunizationDTO(tempData[i]);
							
							if (immunizationDTO)
							{
								if (immunizationDTO.ImmunizationType)
									data["immunization"] = ImmunizationTypeDTO(immunizationDTO.ImmunizationType).ImmunizationTypeName;
								
								data["dose"] = immunizationDTO.Dose;
								data["lotNo"] = immunizationDTO.LotNumber;
								data["dateAdmin"] = immunizationDTO.DateAdmin;
								data["nextDue"] = immunizationDTO.NextDoseDue;
								data["notes"] = immunizationDTO.Note;
							}
							
							dataPvdr.addItem(data);
						}
					}
					
					var immunization:DataGridColumn = new DataGridColumn();
					immunization.headerText = "Immunization";
					immunization.dataField = "immunization";
					immunization.width=60;
					immunization.wordWrap="true";
					//immunization.itemRenderer = new ClassFactory(Label);
					
					var dose:DataGridColumn = new DataGridColumn();
					dose.headerText = "Dose";
					dose.dataField = "dose";
					dose.width=40;
					
					var lotNo:DataGridColumn = new DataGridColumn();
					lotNo.headerText = "Lot #";
					lotNo.dataField = "lotNo";
					lotNo.width=40;
					
					var dateAdmin:DataGridColumn = new DataGridColumn();
					dateAdmin.headerText = "Date Admin";
					dateAdmin.headerWordWrap="true"
