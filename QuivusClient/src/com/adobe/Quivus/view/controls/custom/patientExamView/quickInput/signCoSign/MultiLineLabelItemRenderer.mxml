<?xml version="1.0" encoding="utf-8"?>
<s:MXDataGridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
						  xmlns:s="library://ns.adobe.com/flex/spark" 
						  xmlns:mx="library://ns.adobe.com/flex/mx" 
						  focusEnabled="true">
	<fx:Script>
		<![CDATA[
			
			override protected function measure():void
			{
				super.measure();
				
				var w:Number = lblData.getExplicitOrMeasuredHeight() + 2 + 2;
				
				if (w != measuredHeight)
				{
					measuredMinHeight = measuredHeight = w;
					dispatchEvent(new Event("multiLineLabelItemRendererHeightChanged", true));
				}
				
			}
		]]>
	</fx:Script>
	<s:Label id="lblData" left="2" right="2" text="{dataGridListData.label}"/>
</s:MXDataGridItemRenderer>
