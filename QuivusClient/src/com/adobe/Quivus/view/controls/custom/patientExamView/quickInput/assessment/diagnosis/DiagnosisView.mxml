			//Tahir Alvi - Associate popup implementation
			private function setVisitDate(oItem:Object, iCol:int):String
			{
				var strVisitDate:String = '';
				
				if (oItem && oItem.VisitDate)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.VisitDate));
					strVisitDate = formatDateTime.format(dateRecieved);
					var nullDate:Date = Constants.NULL_DATE;
					
					if (dateRecieved.getFullYear() <= nullDate.getFullYear() && dateRecieved.getMonth() <= nullDate.getMonth())
						strVisitDate = "";
					
					if(oItem.IsNA)
						strVisitDate = 'N/A';
				}
				return strVisitDate;
			}
			//Icdcode click handler
			protected function Icdcode_clickHandler(event:MouseEvent, index:uint):void
			{
				if(event.target as RichEditableText || event.target as mx.controls.Label)
				{
					return;
				}
				else 
				{
					if(serachTermDiagnosis == null)
						return
					
					if(serachTermDiagnosis.length > 2)
					{
						openDiagnosisPopup(index);
					}
				}
			}
			
			private function openDiagnosisPopup(index:int):void
			{
				var addDiagnosisPopup:DiagnosisPopup = new DiagnosisPopup();
				addDiagnosisPopup.ShowPopup( this )
				addDiagnosisPopup.title  = "Add Diagnosis";
				addDiagnosisPopup.height = 410;
				addDiagnosisPopup.width  = 600;
				addDiagnosisPopup.move(addDiagnosisPopup.x, addDiagnosisPopup.y - 20);
				addDiagnosisPopup.searchAndLoadDiagnosis(serachTermDiagnosis, id_Onset.text, index);
				resetFields();
			}
			
			private function icdCodeChangeHandler():void
			{
				serachTermDiagnosis = '';
				serachTermDiagnosis = id_ICDCode.textInput.text;
				//if value exceeds 4 characters then search Icd Code and map the Icd Code.
				if(serachTermDiagnosis.length >=5){
					id_Diagnosis.textInput.text = '';
					id_Diagnosis.selectedIndex = -1;
					selectedIcdCodeDTO = null;
					id_AddRecord.enabled 		= isGetEdited();
					var icdEvent : LoadICDCodeEvent = new LoadICDCodeEvent(serachTermDiagnosis, loadData);
					CairngormEventDispatcher.getInstance().dispatchEvent( icdEvent );
					
				}else{
					id_Diagnosis.textInput.text = '';
					id_Diagnosis.selectedIndex = -1;
					selectedIcdCodeDTO = null;
					id_AddRecord.enabled 		= isGetEdited();
				}
			}
			
			private function icdDescriptionChangeHandler():void
			{
				serachTermDiagnosis = '';
				serachTermDiagnosis = id_Diagnosis.textInput.text;
			}
			
			public  function loadData(val:* = null):void
			{
				if(model.icdCodeDTOList.length)
				{
					for(var i:uint=0; i < model.icdCodeDTOList.length; i++)
					{
						if(serachTermDiagnosis == model.icdCodeDTOList[i].IcdCodeName)
						{
							id_ICDCode.textInput.text 	= model.icdCodeDTOList[i].IcdCodeName;
							id_Diagnosis.textInput.text = model.icdCodeDTOList[i].IcdCodeDescription;
							selectedIcdCodeDTO			= model.icdCodeDTOList[i];
							id_AddRecord.enabled 		= isGetEdited();
							return;
						}							
					}
				}
			}
			//reset All forms fields
			private function resetForm():void
			{
				id_Onset.selectedDate 			= null;
				id_Onset.text 					= '';
				id_Onset.prompt					= 'OnSet';
				id_Diagnosis.textInput.text		= '';
				id_ICDCode.textInput.text 		= '';
				//				id_LinkICD.selected				= false;
				id_ChronicYes.selected 			= false;
				id_ChronicNo.selected 			= false;
				id_AddRecord.enabled 			= false;
				id_AddRecord.enableAll 			= false;
				id_add.enabled					= false;
				id_AddRecord.notesDTO 			= new ModuleNoteDTO();
				id_AddRecord.dictationDTO 		= new ModuleDictationDTO();
				recordNotesDTO 					= new ModuleNoteDTO();
				selectedIcdCodeDTO				= null;
				
				if (recordNotesPanel)
					recordNotesPanel.removePopup();
			}
			
			protected function id_ICDCode_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == 13 ){
					serachTermDiagnosis = id_ICDCode.textInput.text;
					if(serachTermDiagnosis.length >2)
						openDiagnosisPopup(0);
				}
				
			}
			
			protected function id_Diagnosis_keyDownHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ENTER )
					serachTermDiagnosis = id_Diagnosis.textInput.text;
				
				serachTermDiagnosis = id_Diagnosis.textInput.text
					
				if(serachTermDiagnosis.length >2)
					openDiagnosisPopup(1);
			}
			
