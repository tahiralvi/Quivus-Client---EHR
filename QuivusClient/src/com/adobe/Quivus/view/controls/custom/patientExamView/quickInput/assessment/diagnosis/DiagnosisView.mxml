			public function chronicLabelFunction(oItem:Object,iCol:int):String
			{
				var label:String = ""; 
				if (oItem.hasOwnProperty("IsChronic"))
				{
					if (oItem.IsChronic)
						label = "Yes";
					else
						label = "No";
				}
				
				return label;
			}
			
			public function showNotes(loc:Point):void
			{
				if (loc)
				{
					if( recordNotesPanel )
						recordNotesPanel.removePopup();
					
					if (!recordNotesDTO)
						recordNotesDTO = new ModuleNoteDTO();
					
					recordNotesPanel 					= new NotesPanel();
					recordNotesPanel.width			= 550
					recordNotesPanel.height			= 150
					recordNotesPanel.HeadingLable 	= id_Diagnosis.textInput.text;
					recordNotesPanel.VisitDateLable 	= new Date().toDateString();
					recordNotesPanel.notesDTO	= recordNotesDTO;
					recordNotesPanel.ShowPopup( this );
					recordNotesPanel.move( loc.x, loc.y );
					
					recordNotesPanel.id_header.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						recordNotesPanel.SaveNotes();
						recordNotesPanel.removePopup();
						event.stopImmediatePropagation();
						
						if(recordNotesPanel.id_body.id_message.text.length > 0)
						{
							id_AddRecord.id_WriteNotes.setStyle("skinClass", ImmunizationNotesFilledBtn);
							
						}
						else
						{
							id_AddRecord.id_WriteNotes.setStyle("skinClass", ImmunizationWriteNotesBtn);
						}
						
					});
				}
			}
			
			private function filterDeletedItems(item:Object):Boolean
			{
				var b:Boolean = item["IsDeleted"];
				return (!b);
			}
			
			private function cc():void
			{
				addEventListener("writeDictationClick", writeDictationClickHandler, false, 0, true);
				id_DiagnosisGrid.addEventListener(DataGridActionsEvent.ITEM_EDIT_KEY_UP, itemEditKeyUpHandler, false, 0, true);
				id_DiagnosisGrid.addEventListener(DataGridActionsEvent.EDIT_RECORD_CLICK, editRecordClickHandler, false, 0, true);
				id_DiagnosisGrid.addEventListener(DataGridActionsEvent.DELETE_RECORD_CLICK, deleteRecordClickHandler, false, 0, true);
				
				if(model.quickInputDTO.Assessment == null)
					model.quickInputDTO.Assessment = new AssessmentDTO();
				
				if(model.quickInputDTO.Assessment.Diagnosis==null)
					model.quickInputDTO.Assessment.Diagnosis = new ArrayCollection();
				
				BindingUtils.bindProperty(model, "signCosignBtnEnabled", model.quickInputDTO.Assessment.Diagnosis, "length");
				
				if (!deleteColumnData)
					deleteColumnData = {};
				
				deleteColumnData["noteDataFields"] = {subject: "NoteSubject", note: "Note", header: "ICDCode.IcdCodeDescription"};
				deleteColumnData["dictationDataField"] = "DictationID";
				deleteColumnData["recordIDField"] = "PatientDiagnosisID";
				deleteColumnData["section"] = QIPopUpManager.DIAGNOSIS;
				
				var checkAllChronicDiagnosisTemplateAvailable:Boolean = true;
				var evt:LoadPatientAllChronicDiagnosisByPatientIdEvent = new LoadPatientAllChronicDiagnosisByPatientIdEvent(checkAllChronicDiagnosisTemplateAvailable);
				CairngormEventDispatcher.getInstance().dispatchEvent( evt );
			}
			
			private function itemEditKeyUpHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_DIAGNOSIS ) )//Tahir Alvi - implement security check 
				{
					if (event.searchString.length > 2)
					{
						var icdEvent : LoadICDCodeEvent = new LoadICDCodeEvent(event.searchString);
						CairngormEventDispatcher.getInstance().dispatchEvent( icdEvent );
					}
				}
			}
			
			private function editRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_DIAGNOSIS ) )//Tahir Alvi - implement security check 
				{
					id_DiagnosisGrid.editable = true;
					
					var rowIndex:int = LabelDataGrid(event.currentTarget).selectedIndex;
					
					var itemToSetInEditableMode:IListItemRenderer = id_DiagnosisGrid.indexToItemRenderer(rowIndex);
					
					var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
					ev.columnIndex = 2;
					ev.rowIndex = rowIndex;
					ev.itemRenderer = itemToSetInEditableMode;
					ev.dataField = "OnSet";
					
					id_DiagnosisGrid.dispatchEvent(ev);
				}
			}
			
			private function deleteRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_DIAGNOSIS ) )
				{
					var selectedIdx:int = id_DiagnosisGrid.selectedIndex;
					
					var diagnosisID:int = PatientDiagnosisDTO(event.currentTarget.selectedItem).PatientDiagnosisID;
					UtilityFunctions.AskMessage(  "Do you want to delete selected record", function():void
					{
						if (diagnosisID == 0)
						{
							model.quickInputDTO.Assessment.Diagnosis.removeItemAt(selectedIdx);
							if (model.quickInputDTO.Assessment.Diagnosis.length <= 0)
							{
								_hasGridChanged = false;
								hasViewChanged = isGetEdited();
							}
						}
						else
						{
							
							id_DiagnosisGrid.selectedItem.IsDeleted = true;
							model.quickInputDTO.Assessment.Diagnosis.filterFunction = filterDeletedItems; 
							model.quickInputDTO.Assessment.Diagnosis.refresh();
							hasViewChanged = _hasGridChanged = true;
						}
					});
				}
			}
			
			private function addRecordClickHandler(event:Event):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_DIAGNOSIS ) )
				{
					id_add.enabled = areRequiredFieldsProvidedAndValid();
					if( ! id_add.enabled )
					{
						return; // invalid data
					}
					
					var patientDiagnosisDTO:PatientDiagnosisDTO = new PatientDiagnosisDTO();
					//Not valid due to hide adding custom description feature.
					/* if(id_ICDCodeCustom.selectedItem && id_CustomDiagnosis.text.length)
					{
					patientDiagnosisDTO.ICDCode 			= id_ICDCodeCustom.selectedItem;
					patientDiagnosisDTO.OnSet 				= id_Onset.text;
					patientDiagnosisDTO.ICDCodeDescription 	= id_CustomDiagnosis.text;
					}//else if(id_ICDCode.selectedItem && id_Diagnosis.textInput.text)
					else if(id_ICDCode.textInput.text && id_Diagnosis.textInput.text)
					{
					patientDiagnosisDTO.ICDCode 			= selectedIcdCodeDTO; //id_ICDCode.selectedItem;
					patientDiagnosisDTO.OnSet 				= id_Onset.text;//new Date(Date.parse(id_Onset.text));
					patientDiagnosisDTO.ICDCodeDescription 	= id_Diagnosis.textInput.text;
					} */
					if(id_ICDCode.textInput.text && id_Diagnosis.textInput.text)
					{
						patientDiagnosisDTO.ICDCode 			= selectedIcdCodeDTO; //id_ICDCode.selectedItem;
						patientDiagnosisDTO.OnSet 				= id_Onset.text;//new Date(Date.parse(id_Onset.text));
						patientDiagnosisDTO.ICDCodeDescription 	= id_Diagnosis.textInput.text;
					}
					
					if (id_ChronicYes.selected)
						patientDiagnosisDTO.IsChronic = true;
					else
						patientDiagnosisDTO.IsChronic = false;
					
					patientDiagnosisDTO.IsActive = true;
					
					patientDiagnosisDTO.CreatedAt = formatDateTime.format(new Date());//datetostring(Tahir)
					patientDiagnosisDTO.CreatedBy = model.loggedInUserDTO.UserId;
					
					patientDiagnosisDTO.DictationID = Constants.GUID_FORMAT;
					
					patientDiagnosisDTO.ModifiedAt = Constants.NULL_DATE;
					
					/* if( model.visitDTO!=null)
					{
					patientDiagnosisDTO.VisitDate 	= model.visitDTO.VisitDate;				
					patientDiagnosisDTO.VisitID 	= model.visitDTO.VisitId;
					}
					else if(model.quickInputDTO!= null && model.quickInputDTO.Visit!=null)
					{
					patientDiagnosisDTO.VisitDate 	= model.quickInputDTO.Visit.VisitDate;				
					patientDiagnosisDTO.VisitID 	=  model.quickInputDTO.Visit.VisitId;
					
					} */
					
					patientDiagnosisDTO.PatientID = model.loadedPatientId;
					
					if (id_AddRecord.notesDTO)
					{
						patientDiagnosisDTO.Note = id_AddRecord.notesDTO.Note;
						patientDiagnosisDTO.NoteSubject = id_AddRecord.notesDTO.NoteSubject;
					}
					//H		
					if (id_AddRecord.dictationDTO && id_AddRecord.dictationDTO.DictationID!=null)
						patientDiagnosisDTO.DictationID = id_AddRecord.dictationDTO.DictationID;
					
					model.signCosignBtnEnabled = true;
					
					if(model.quickInputDTO.Assessment==null)
						model.quickInputDTO.Assessment = new AssessmentDTO();
					
					if(model.quickInputDTO.Assessment.Diagnosis==null)
						model.quickInputDTO.Assessment.Diagnosis = new ArrayCollection();
					
					//Tahir Alvi - New Feature implemented of associate record with visit.
					patientDiagnosisDTO.VisitDate 	= formatDateTime.format(model.DiagnosisAssociatedVisit.VisitDate);//datetostring(Tahir)				
					patientDiagnosisDTO.VisitID 	= model.DiagnosisAssociatedVisit.ID;
					
					if((id_AssociateVisitzCombo.selectedIndex == 2) || (id_AssociateVisitzCombo.selectedIndex == 1 && id_VisitDatesCombo.selectedIndex != -1))
					{
						//if(model.patientDiagnosisDTOListByPatientId == null)
						model.patientDiagnosisDTOListByPatientId = new ArrayCollection();
						
						patientDiagnosisDTO.IsDirty = true;
						model.patientDiagnosisDTOListByPatientId.addItem(patientDiagnosisDTO);
						Alert.show('Are you sure, you want to save this record.', 'Save Confirmation', Alert.YES | Alert.NO, FlexGlobals.topLevelApplication.mainContainer, alertSaveDBListener, null, Alert.OK)
					}else
					{
						model.quickInputDTO.Assessment.Diagnosis.addItem(patientDiagnosisDTO);
						//CombinedQIVBDiagnosisList = new ArrayCollection();
					}
					
					
					if (model.sessionDTO.IsProvider)
						model.canSign = true;
					
					resetFields();
					
					hasViewChanged = _hasGridChanged = true;
					
					//id_AddRecord.id_WriteNotes.setStyle("skinClass", ImmunizationWriteNotesBtn);
					//id_AddRecord.id_WriteDictation.setStyle("skinClass", ImmunizationDictationBtn);
					id_AddRecord.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
					id_AddRecord.id_WriteDictation.setStyle("skinClass", QIDictationBtn);
				}
			}
