				id_add.enabled	= false;
				
				id_AddRecord.notesDTO = new ModuleNoteDTO();
				id_AddRecord.dictationDTO = new ModuleDictationDTO();
				
				recordNotesDTO = new ModuleNoteDTO();
				
				if (recordNotesPanel)
					recordNotesPanel.removePopup();
				
				id_form1.enabled = false;
				id_ImportAllChronic.enabled = false;
				id_AssociateVisitzCombo.selectedIndex =-1;
				id_VisitDatesCombo.selectedIndex = -1;
				id_VisitDatesCombo.visible = false;
				serachTermDiagnosis	= '';
