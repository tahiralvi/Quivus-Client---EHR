	<s:HGroup width="100%">
		<components1:LabelDataGrid id="id_DiagnosisGrid" includeInLayout="{includeGridInLayout}" visible="{includeGridInLayout}"
								  rowCount="{id_DiagnosisGrid.dataProvider.length + 1}"
								  width="100%" verticalScrollPolicy="on"
								  itemEditBegin="diagnosisGridItemEditBeginHandler(event)"
								  itemEditEnd="diagnosisGridItemEditEndHandler(event)"
								  dataProvider="{diagnosisCollection}" draggableColumns="false" useRollOver="false"
								  maxHeight="150" columnWidths="{[25, '13%', '15%', '15%', '25%', '12%', 100]}">
			<components:columns>
				
				<!-- Changes by baber waqas for displaying serial number  -->	
				<mx:DataGridColumn headerText="Sr.#" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" editable="false" labelFunction="GridRowNumber" />
				<mx:DataGridColumn headerText="Visit Date" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" dataField="VisitDate" editable="false" labelFunction="setVisitDate"/>
				<mx:DataGridColumn headerText="On Set" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" dataField="OnSet" editorDataField="selectedDate" >
					<!-- itemRenderer="com.adobe.Quivus.view.controls.custom.itemRenderer.DateRenderer4DG">-->
					<!--<mx:itemEditor>
					<fx:Component>
					<mx:DateField width="45" selectedDate="{outerDocument.id_Onset.selectedDate}" editable="true"
					selectableRange="{{rangeEnd : new Date()}}"/>
					</fx:Component>
					</mx:itemEditor>-->
				</mx:DataGridColumn>
				<mx:DataGridColumn headerText="ICD Code"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" dataField="ICDCode.IcdCodeName" editorDataField="editorText">
					<mx:itemEditor>
						<fx:Component>
							<itemEditors:SparkComboBoxItemEditor labelField="IcdCodeName" dataProvider="{outerDocument.model.icdCodeDTOList}"/>
						</fx:Component>
					</mx:itemEditor>
				</mx:DataGridColumn>
				<mx:DataGridColumn headerText="Diagnosis"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" dataField="ICDCode.IcdCodeDescription" editorDataField="editorText" >
					<mx:itemEditor>
						<fx:Component>
							<itemEditors:SparkComboBoxItemEditor labelField="IcdCodeDescription" dataProvider="{outerDocument.model.icdCodeDTOList}"/>
						</fx:Component>
					</mx:itemEditor>
				</mx:DataGridColumn>
				<mx:DataGridColumn headerText="Chronic" dataField="IsChronic"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" editorDataField="isYes" labelFunction="chronicLabelFunction">
					<mx:itemEditor>
						<fx:Component>
							<diagnosis:YesNoItemEditor  height="100%"/>
						</fx:Component>
					</mx:itemEditor>
				</mx:DataGridColumn>
				<commons:DataGridColumnEx data="{deleteColumnData}" headerText="" itemRenderer="com.gazuntite.patient.visit.view.itemrenderers.DeleteRecordRenderer" editable="false"/>
			</components:columns>
		</components1:LabelDataGrid>
	</s:HGroup>
</s:Group>
