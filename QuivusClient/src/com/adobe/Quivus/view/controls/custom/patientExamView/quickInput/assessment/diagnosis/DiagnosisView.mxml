			private function diagnosisCollectionChangeHandler(event:CollectionEvent):void
			{
				switch (event.kind)
				{
					case CollectionEventKind.ADD:
						includeGridInLayout = true;
						if (diagnosisCollection && diagnosisCollection.length > 1)
							hasViewChanged = true;
						break;
					
					case CollectionEventKind.REMOVE:
						if (diagnosisCollection && diagnosisCollection.length < 1)
							includeGridInLayout = false;
						break;
				}
			}
			
			private var _diagnosisCollection:ArrayCollection;
			[Bindable]
			public function get diagnosisCollection():ArrayCollection
			{
				return _diagnosisCollection;	
			}
			
			public function set diagnosisCollection(value:ArrayCollection):void
			{
				_diagnosisCollection = value;
				
				if (_diagnosisCollection)
				{
					_diagnosisCollection.addEventListener(CollectionEvent.COLLECTION_CHANGE, diagnosisCollectionChangeHandler, false, 0, true);
					
					if (_diagnosisCollection.length)
						includeGridInLayout = true;
						
					else
						includeGridInLayout = false;	
				}
				else
					includeGridInLayout = false;
				
				if( value.length > 0 )
				{
					hasViewChanged = _hasGridChanged = true;
				}
			}
			
			[Bindable]
			public function get includeGridInLayout():Boolean
			{
				return _includeInLayout;
			}
			
			public function set includeGridInLayout(value:Boolean):void
			{
				_includeInLayout = value;
				_includeInLayoutChanged = true;
				
				invalidateProperties();
				invalidateSize();
				invalidateDisplayList();
			}
			
			private function diagnosisGridItemEditBeginHandler(event:DataGridEvent):void
			{
				id_DiagnosisGrid.createItemEditor(event.columnIndex, event.rowIndex);
				
				if (event.columnIndex == 5 || event.columnIndex == 6)
				{
					//id_DiagnosisGrid.createItemEditor(event.columnIndex, event.rowIndex);
					
					if (event.columnIndex == 5)
						YesNoItemEditor(id_DiagnosisGrid.itemEditorInstance).property = "IsChronic";
					else
						YesNoItemEditor(id_DiagnosisGrid.itemEditorInstance).property = "IsActive";
					
					YesNoItemEditor(id_DiagnosisGrid.itemEditorInstance).data = event.itemRenderer.data;
					
				}
			}
			
			private function diagnosisGridItemEditEndHandler(event:DataGridEvent):void
			{
				var validationRes:ValidationResultEvent;
				var diagnosisID:int = PatientDiagnosisDTO(event.currentTarget.selectedItem).PatientDiagnosisID;
				
				if (event.dataField == "ICDCode.IcdCodeDescription" || event.dataField == "ICDCode.IcdCodeName")
				{
					var editor:LabelComboBox = SparkComboBoxItemEditor(id_DiagnosisGrid.itemEditorInstance).id_ComboEditor;
					
					comboValidator.source = editor;
					
					if (event.dataField == "ICDCode.IcdCodeDescription")
					{
						comboValidator.error = "Select diagnosis from list";
					}
					else
					{
						comboValidator.error = "Select ICD Code from list";
					}
					
					validationRes = comboValidator.validate(editor.selectedItem);
					
					if (validationRes && !validationRes.results)
					{
						event.itemRenderer.data.ICDCode = editor.selectedItem;
						
						if (diagnosisID != 0)
							event.itemRenderer.data.IsDirty = true;
						
						hasViewChanged = _hasGridChanged = true;
					}
					/*else
					{
					id_DiagnosisGrid.destroyItemEditor();
					
					event.stopImmediatePropagation();
					event.preventDefault();
					}*/
					
					id_DiagnosisGrid.destroyItemEditor();
					
					event.stopImmediatePropagation();
					event.preventDefault();
				}
					
				else if (event.dataField == "OnSet")
				{
					var dateEditor:* = id_DiagnosisGrid.itemEditorInstance;
					
					onSetValidator.source = dateEditor;
					//	onSetValidator.error = "Invalid OnSet";
					//	validationRes = onSetValidator.validate(dateEditor.text);
					
					//	if (validationRes && !validationRes.results)
					//	{
					if (dateEditor.text)
					{
						event.itemRenderer.data.OnSet = dateEditor.text;
						
						if (diagnosisID != 0)
							event.itemRenderer.data.IsDirty = true;
						
						hasViewChanged = _hasGridChanged = true;
					}
					//	}
					/*else
					{
					id_DiagnosisGrid.destroyItemEditor();
					
					event.stopImmediatePropagation();
					event.preventDefault();
					}*/
					
					id_DiagnosisGrid.destroyItemEditor();
					
					event.stopImmediatePropagation();
					event.preventDefault();
				}
					
				else if (event.dataField == "IsChronic")
				{
					hasViewChanged = _hasGridChanged = true;
				}
			}
			
			override protected function commitProperties():void
			{
				super.commitProperties();
				
				if (_includeInLayoutChanged)
				{
					_includeInLayoutChanged = false;
					
					id_DiagnosisGrid.includeInLayout = _includeInLayout;
					id_DiagnosisGrid.visible = _includeInLayout;
					
					if (_includeInLayout)
					{
						id_DiagnosisGrid.horizontalScrollPolicy="on";
						id_DiagnosisGrid.columns[0].width = 35;
						id_DiagnosisGrid.columns[1].width = 60;
						id_DiagnosisGrid.columns[2].width = 60;
						id_DiagnosisGrid.columns[3].width = 60;
						id_DiagnosisGrid.columns[4].width = 120;
						id_DiagnosisGrid.columns[5].width = 50;
						id_DiagnosisGrid.columns[6].width = 100;
						id_DiagnosisGrid.horizontalScrollPolicy="off";
					}
				}
			}
			
