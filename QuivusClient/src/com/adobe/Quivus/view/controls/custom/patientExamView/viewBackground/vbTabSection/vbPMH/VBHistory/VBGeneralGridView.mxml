			private var isAsking:Boolean = false; //@see --- ItemEditEndHandler
			private function ItemEditEndHandler(event:DataGridEvent):void
			{
				var validationRes:ValidationResultEvent;
				
				if (event.dataField == "IsNone")
				{
					var editor:YesNoItemEditor = id_DataGrid.itemEditorInstance as YesNoItemEditor;
					
					if( editor.isChanged && editor.isYes == Constants.STRING_FALSE && isAsking == false &&
						(
							event.itemRenderer.data.DictationID != Constants.GUID_FORMAT || 
							!AppUtils.IsNullOrEmpty( event.itemRenderer.data.NoteSubject ) ||
							!AppUtils.IsNullOrEmpty( event.itemRenderer.data.MedicalHistoryNote ) 
						)
					)
					{
						isAsking = true; // work around -- don't know why this event is firing twice --- look for real cause
						editor.isChanged = false;//user has interacted with editor ...
						UtilityFunctions.AskMessage( "This action will remove any notes and dictation on the current selected record.",
							function():void //yes is selected
							{
								isAsking = false;
								event.itemRenderer.data.IsNone 				= Constants.STRING_TRUE;
								event.itemRenderer.data.NoteSubject 		= "";
								event.itemRenderer.data.MedicalHistoryNote 	= "";
								event.itemRenderer.data.DictationID 		= Constants.GUID_FORMAT;
							}, null,
							function():void //no is selected
							{
								isAsking = false;
								event.itemRenderer.data.IsNone 				= Constants.STRING_FALSE;
								//event.itemRenderer.data["IsDirty"] 			= true;
								id_DataGrid.invalidateDisplayList();
							});
