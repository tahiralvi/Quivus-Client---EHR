			<mx:DataGridColumn headerText="Sr.#"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="GridRowNumber"/>
			<!--<mx:DataGridColumn headerText="Visit Date" width="160" headerWordWrap="true" wordWrap="true" labelFunction="setVisitDate" dataField="VisitDate" />-->
			<mx:DataGridColumn headerText="General History"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" dataField="MedicalHistoryType.MedicalHistoryTypeName" editorDataField="editorText">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor dataProvider="{outerDocument.model.medicalHistoryDTOListByPatient}" labelField="MedicalHistoryTypeName" />												
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>	
			<mx:DataGridColumn headerText="Status"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" dataField="IsNone" labelFunction="OnStatus" >
				<mx:itemEditor>
					<fx:Component>
						<diagnosis:YesNoItemEditor width="50" height="100%" property="IsNone" SwapYesNo="true" />
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="ICD Code" dataField="IcdCodeName"  editable="false" sortable="false" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Description" dataField="IcdCodeDescription" editable="false" sortable="false" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Onset" dataField="OnSet" editable="false" sortable="false" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="setOnSet"/>
			<mx:DataGridColumn headerText="Active" dataField="IsActive"  editable="false" sortable="false" labelFunction="OnIsActive" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" >
