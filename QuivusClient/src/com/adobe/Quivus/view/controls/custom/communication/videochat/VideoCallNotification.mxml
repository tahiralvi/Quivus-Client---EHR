					objTest.addEventListener(MouseEvent.CLICK,onEndCallClick);
					objTest.currentLoggedInUserID = model.loggedInUserDTO.UserId;
					objTest.clinicBranchID = parseInt(clinicBranchID);
					objTest.token = videoChatTokenID;
					objTest.opentoksession = videochatSessionID;
					
					
					//PopUpManager.addPopUp(objTest,this.parent,true);
					
					//PopUpManager.removePopUp(this);
					
				}
				else
