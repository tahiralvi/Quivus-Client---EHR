<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="true">
	<s:layout>
		<s:VerticalLayout gap="50"/>
	</s:layout>
	<s:HGroup width="100%" horizontalAlign="left" paddingLeft="5" verticalAlign="middle">
		<s:Label color="#333333" id="id_Name" text="{ data.Description }"  height="20" 
				 fontFamily="Calibri" fontSize="12" verticalAlign="middle" 
				 maxDisplayedLines="1" maxWidth="55" />
	</s:HGroup>
	
</s:ItemRenderer>