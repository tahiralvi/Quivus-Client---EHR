<?xml version="1.0" encoding="utf-8"?>
<quickInput:PMHSectionHeader xmlns:fx="http://ns.adobe.com/mxml/2009" 
							 xmlns:s="library://ns.adobe.com/flex/spark" 
							 xmlns:mx="library://ns.adobe.com/flex/mx" 
							 xmlns:quickInput="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.*" 
							 xmlns:comprehensiveHistory="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.comprehensiveHistory.*"
							 >
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.Constants;
			
			import mx.events.ItemClickEvent;
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			
			
			protected function id_SpinerList_clickHandler(event:MouseEvent):void
			{
				event.stopImmediatePropagation();
			}
			
			public function setIsDressed(value:String):void
			{
				if( value == Constants.STRING_TRUE )
					id_Y.selected = true;
				else
					id_N.selected = true;
			}
			
			protected function rbGroup_itemClickHandler(event:ItemClickEvent):void
			{
				model.quickInputDTO.Visit.IsDressedForPhysical = event.item as String;
				event.stopImmediatePropagation();
			}
			

			protected function hgroup1_clickHandler(event:MouseEvent):void
			{
				event.stopImmediatePropagation();
			}

		]]>
	</fx:Script>
	<fx:Declarations>
		<s:RadioButtonGroup id="rbGroup" itemClick="rbGroup_itemClickHandler(event)" />
	</fx:Declarations>
	
	<s:HGroup width="100%" horizontalAlign="left" verticalAlign="middle">
		<s:HGroup gap="0" click="hgroup1_clickHandler(event)">
			<s:RadioButton id="id_Y" groupName="rbGroup" value="{Constants.STRING_TRUE}" visible="true" toolTip="Yes"  buttonMode="true" useHandCursor="true"
						   skinClass="com.adobe.Quivus.view.controls.skins.radioButtonSkins.YRadioButton"
						   enabled="{model.securityProxyObject.PatientExam.QuickInput.Physicals.Physical.IsEditAllowed}"/>
			<s:RadioButton id="id_N" groupName="rbGroup" value="{Constants.STRING_FALSE}" visible="true" toolTip="No" buttonMode="true" useHandCursor="true"
						   skinClass="com.adobe.Quivus.view.controls.skins.radioButtonSkins.NRadioButton"
						   enabled="{model.securityProxyObject.PatientExam.QuickInput.Physicals.Physical.IsEditAllowed}"/>
			
			<s:Label id="id_dressedLbl" text="Dressed?" fontFamily="Calibri" paddingLeft="5" />
		</s:HGroup>
		<s:HGroup paddingTop="-1">			
			<comprehensiveHistory:SpinerList id="id_SpinerList" width="130" DataProvider="{model.physicalsDTOList}" click="id_SpinerList_clickHandler(event)"	/>
		</s:HGroup>
		<mx:Spacer width="100%" />
		<s:HGroup width="100%" horizontalAlign="right" paddingTop="0">			
			<s:Button id="id_AllNormalBtn" textAlignLast="left" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.ROSallNormalBtn" toolTip="All Normal" buttonMode="true" />
		</s:HGroup>
	</s:HGroup>
	
	
</quickInput:PMHSectionHeader>
