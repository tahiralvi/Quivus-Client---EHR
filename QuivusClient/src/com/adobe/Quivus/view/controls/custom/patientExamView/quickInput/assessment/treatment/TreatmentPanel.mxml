<?xml version="1.0" encoding="utf-8"?>
<custom:PinableSlideOutPanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
							 xmlns:s="library://ns.adobe.com/flex/spark" 
							 xmlns:mx="library://ns.adobe.com/flex/mx" 
							 xmlns:custom="com.adobe.Quivus.view.controls.custom.*" 
							 xmlns:quickInput="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.*" 
							 xmlns:followUp="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.assessment.plan.followUp.*" 
							 xmlns:treatment="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.assessment.treatment.*"
							 xmlns:notes="com.adobe.Quivus.view.controls.custom.patientExamView.notes.*"
							 
							 creationComplete="pinableslideoutpanel1_creationCompleteHandler(event)"
							 QSViewStateChange="pinableslideoutpanel1_QSViewStateChangeHandler(event)"
							 move="pinableslideoutpanel1_moveHandler(event)" 
							 >
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.AppUtils;
			import com.adobe.Quivus.utils.Constants;
			import com.adobe.Quivus.utils.QSUtilityFunctions;
			import com.adobe.Quivus.utils.security.QSSecurityUtil;
			import com.adobe.Quivus.view.controls.custom.DictationPopup;
			import com.adobe.Quivus.view.controls.custom.patientExamView.notes.NotesPanel;
			import com.adobe.Quivus.view.controls.custom.patientExamView.notes.NotesPopup;
			import com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.commons.AddRecord;
			import com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.commons.manager.QIPopUpManager;
			import com.adobe.Quivus.view.controls.skins.QIinternalBarFocusSkin;
			import com.adobe.Quivus.view.controls.skins.QIinternalBarSkin;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.gridDictationButtonSelectedSkin;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.gridDictationButtonSkin;
			import com.adobe.Quivus.view.controls.skins.toggleButtonSkins.ImmunizationNotesFilledBtn;
			import com.adobe.Quivus.view.controls.skins.toggleButtonSkins.ImmunizationWriteNotesBtn;
			import com.adobe.Quivus.view.controls.skins.toggleButtonSkins.VBIconsButton;
			import com.adobe.Quivus.view.controls.skins.toggleButtonSkins.writeNotesButton;
			import com.adobe.Quivus.view.controls.skins.toggleButtonSkins.writeNotesButtonSelected;
			import com.adobe.Quivus.view.events.SelectSection;
			import com.adobe.quivus.skins.chrome.buttonSkins.VBdictationBtnSelected;
			import com.adobe.quivus.skins.chrome.buttonSkins.VBnotesBtnSelected;
			import com.adobe.quivus.skins.chrome.toggleButtonSkins.VBIconsBlackButton;
			import com.adobe.quivus.skins.chrome.toggleButtonSkins.VBIconsButtonFilled;
			import com.gazuntite.common.view.events.QSViewStateEvent;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.binding.utils.BindingUtils;
			import mx.events.FlexEvent;
			import mx.events.IndexChangedEvent;
			import mx.events.MoveEvent;
			
			import valueObjects.ModuleDictationDTO;
			import valueObjects.ModuleNoteDTO;
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			private var isSectionLevel:Boolean; // this boolean is true is notePanel is representing section level notes 
			private var notesPanel:NotesPanel;
			
			private var dictationPanel:DictationPopup;
			
			private var m_bHasChange:Boolean;
			
			[Bindable]
			public function get hasChange():Boolean
			{
				return m_bHasChange;
			}
			
			public function set hasChange(value:Boolean):void
			{
				m_bHasChange = value;
				
				if( value )
				{
					id_Header.id_ChangeIndicator.visible		 = true;
					id_Header.id_ChangeIndicator.includeInLayout = true;
				}
				else
				{
					id_Header.id_ChangeIndicator.visible		 = false;
					id_Header.id_ChangeIndicator.includeInLayout = false;
				}
			}
			
			private var m_bIsModelUpdated:Boolean;
			
			private var moduleConstantName:String = Constants.TREATMENT_MODULE_NAME;
			public function get IsModelUpdated():Boolean
			{
				return m_bIsModelUpdated;
			}
			
			public function set IsModelUpdated(value:Boolean):void
			{
				m_bIsModelUpdated = value;
				
				UpdateChange();
				
				if( value )
				{
					
					var module:ModuleDictationDTO = QSUtilityFunctions.getModuleDictationDTO(moduleConstantName);					
					var noteDto:ModuleNoteDTO = QSUtilityFunctions.getModuleNoteDTO( moduleConstantName);
					
					if(module.DictationID && module.DictationID != Constants.GUID_FORMAT)
					{
						id_Header.id_Voice.setStyle("skinClass", VBdictationBtnSelected);
						id_Header.id_iconButtons.setStyle("skinClass", VBIconsButtonFilled);
						//id_dictationIndicator.visible = true;
					}
					
					if(noteDto.Note && noteDto.Note != "")
					{
						id_Header.id_NotesBtn.setStyle("skinClass", VBnotesBtnSelected);
						id_Header.id_iconButtons.setStyle("skinClass", VBIconsButtonFilled);
						//id_noteIndicator.visible = true;
					}								
					
				}
			}
			
			private function UpdateChange():void
			{
				try
				{
					if( model.prescriptionMedicationDTOList )
					{
						var hasData:Boolean = model.prescriptionMedicationDTOList.length > 0;
						hasChange =  hasData;
					}
					
					if( model.quickInputDTO.Assessment && model.quickInputDTO.Assessment.Procedure )
					{
						var hasData:Boolean = model.quickInputDTO.Assessment.Procedure.length > 0;
						hasChange =  hasData;
					}
				}
				catch( e:Error )
				{
					trace( "UpdateChange -> QIAssessment::Treatment", e.message );
				}
			}
			
			
			public override function set AllowOtherPopup(value:Boolean):void
			{
				super.AllowOtherPopup = value;
				/*if( ! value && notesPanel)
				notesPanel.removePopup();
				
				if( ! value && id_ImmunizationBodyView.recordNotesPanel )
				id_ImmunizationBodyView.recordNotesPanel.removePopup(); */
				
				if( ! value && dictationPanel)
					dictationPanel.removePopup();
			}
			
			protected function pinableslideoutpanel1_creationCompleteHandler(event:FlexEvent):void
			{
				if( model.quickInputDataLoadedFlag )
					UpdateChange();
				
				id_Prescription.id_nextBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void {
					id_TreatmentViews.selectedIndex = 1;									
				});
				
				id_Header.id_OptionPopUp.displayPopUp = true;
				id_Header.id_iconButtons.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					if(id_notesDictation.id_Area.visible)
					{
						
						if(id_Header.id_OptionPopUp.displayPopUp)
						{
							id_Header.id_iconButtons.setStyle("skinClass", VBIconsBlackButton);
						}
						else
						{
							id_Header.id_iconButtons.setStyle("skinClass", VBIconsButton);	
						}
					}
					
					this.ExpandedView = true;
					
					event.stopImmediatePropagation();
					
				});	
				
				id_Header.id_Voice.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_TREATMENTS ) )
					{
						id_notesDictation.notesDTO = QSUtilityFunctions.getModuleNoteDTO( Constants.TREATMENT_MODULE_NAME );
						id_notesDictation.DictationDTO = QSUtilityFunctions.getModuleDictationDTO(Constants.TREATMENT_MODULE_NAME);
						
						id_notesDictation.id_Area.visible 		= true;
						id_notesDictation.id_Area.includeInLayout = true;		
						id_notesDictation.id_VBViews.selectedIndex = 1;						
						//id_header.id_iconButtons.setStyle("skinClass", VBIconsBlackButton);
						id_Header.id_iconButtons.selected = false;
						id_Header.id_OptionPopUp.displayPopUp = false;
						
						id_notesDictation.dictationPanel.rec_btn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
						{													
							id_Header.setIcons(true, 
								id_notesDictation.id_notesPanel.id_body.id_message.text.length > 0);
							hasChange = true;
						});	
						id_notesDictation.id_notesPanel.id_body.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
						{						
							id_Header.setIcons(id_notesDictation.DictationDTO.DictationID && id_notesDictation.DictationDTO.DictationID != Constants.GUID_FORMAT, 
								id_notesDictation.id_notesPanel.id_body.id_message.text.length > 0);
							id_notesDictation.id_Area.visible 		= false;
							id_notesDictation.id_Area.includeInLayout = false;
						});
						ExpandedView = true;
						if(this.ExpandedView)
						{
							event.stopImmediatePropagation();
						}
					}
				});			
				
				id_Header.id_NotesBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_TREATMENTS ) )
					{
						id_notesDictation.notesDTO = QSUtilityFunctions.getModuleNoteDTO( Constants.TREATMENT_MODULE_NAME );
						id_notesDictation.DictationDTO = QSUtilityFunctions.getModuleDictationDTO(Constants.TREATMENT_MODULE_NAME);
						
						id_notesDictation.id_Area.visible 		= true;
						id_notesDictation.id_Area.includeInLayout = true;						
						id_notesDictation.id_VBViews.selectedIndex = 0;
						//id_header.id_iconButtons.setStyle("skinClass", VBIconsBlackButton);
						id_Header.id_iconButtons.selected = false;
						id_Header.id_OptionPopUp.displayPopUp = false;
						
						
						id_notesDictation.dictationPanel.rec_btn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
						{													
							id_Header.setIcons(true, 
								id_notesDictation.id_notesPanel.id_body.id_message.text.length > 0);
							hasChange = true;
						});	
						id_notesDictation.id_notesPanel.id_body.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
						{						
							id_Header.setIcons(id_notesDictation.DictationDTO.DictationID && id_notesDictation.DictationDTO.DictationID != Constants.GUID_FORMAT, 
								id_notesDictation.id_notesPanel.id_body.id_message.text.length > 0);
							id_notesDictation.id_Area.visible 		= false;
							id_notesDictation.id_Area.includeInLayout = false;
						});
						ExpandedView = true;
						if(this.ExpandedView)
						{
							event.stopImmediatePropagation();
						}
					}
				});
				
				
				id_Header.id_slideoutBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					ToggleSlideOut();
					event.stopImmediatePropagation();
				});
				id_Header.id_Pin.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_TREATMENTS ) )
					{
						PinView = event.currentTarget.selected;
						//event.stopImmediatePropagation();
					}
				});
				
				
				id_Header.id_OptionPopUp.displayPopUp = false;
				
			}
			
			
			
			private function showSectionNotesIndicator():void
			{
				/* var noteDto:ModuleNoteDTO = QSUtilityFunctions.getModuleNoteDTO( Constants.TREATMENT_MODULE_NAME );
				if( noteDto.Note )
				id_noteIndicator.visible  = noteDto.Note.length > 0;
				else
				id_noteIndicator.visible  = false;
				
				if(notesPanel.id_body.id_message.text.length > 0)
				{
				id_Header.id_NotesBtn.setStyle("skinClass", writeNotesButtonSelected);
				}
				else
				{
				id_Header.id_NotesBtn.setStyle("skinClass", writeNotesButton);
				} */
			}
			
			
			
			
			protected function slideoutpanel1_moveHandler(event:MoveEvent):void
			{
				
			}
			
			
			protected function pinableslideoutpanel1_QSViewStateChangeHandler(event:QSViewStateEvent):void
			{
				if( event.viewState == QSViewStateEvent.EXPANDED_VIEW )
				{
					if( id_Header )
					{
						id_Header.HeadingLable = id_Header.HeadingLable.toUpperCase();
						id_Header.id_pmhHeader.setStyle("skinClass", QIinternalBarFocusSkin);
						id_Header.id_headingLbl.setStyle("color", 0xffffff);
						id_Header.id_expandBtn.selected = true;
					}
				}
				else
				{
					if( id_Header )
					{
						id_Header.HeadingLable = AppUtils.TitleCase(id_Header.HeadingLable);
						id_Header.id_pmhHeader.setStyle("skinClass", QIinternalBarSkin);
						id_Header.id_headingLbl.setStyle("color", 0x000000);
						id_Header.id_expandBtn.selected = false;
					}
					
					QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.PROCEDURE);
				}
			}
			
			
			protected function pinableslideoutpanel1_moveHandler(event:MoveEvent):void
			{
				
			}
			
			/**
			 * Ayesha: 13th May 2011
			 * remove record level notes component before adding record in grid
			 * */
			private function addRecordClickProcedureHandler(event:Event):void
			{
				if (!isSectionLevel)
				{
					var target:AddRecord = AddRecord(event.target);
					target.id_WriteNotes.selected = false;
					//removeNotesPanel();
				}
			}
			
			private function writeRecordNotesClickProcedureHandler(event:Event):void
			{
				/* var target:AddRecord = AddRecord(event.target);
				if (target.id_WriteNotes.selected)
				{
				isSectionLevel = false;
				var procedureName:String = id_ProcedureView.id_Procedure.selectedItem.ProcedureDescription;
				showNotes(target.notesDTO, procedureName);
				}
				else
				{
				removeNotesPanel();
				} */
			}
			
			private function procedureCreationHandler():void
			{
				id_ProcedureView.addEventListener("addRecordClick", addRecordClickProcedureHandler, false, 0, true);
				id_ProcedureView.addEventListener("writeNotesClick", writeRecordNotesClickProcedureHandler, false, 0, true);
				//BindingUtils.bindProperty(this, "hasChange", id_ProcedureView, "hasViewChanged");
			}
			
			protected function id_noteIndicator_clickHandler(event:MouseEvent):void
			{
				/* var popup:NotesPopup = new NotesPopup();
				popup.height = 30;
				popup.ShowPopup( this );
				popup.HeaderLabel = "Notes";
				
				var noteDto:ModuleNoteDTO = QSUtilityFunctions.getModuleNoteDTO( Constants.TREATMENT_MODULE_NAME );
				if( noteDto.Note )
				popup.id_message.text  = noteDto.Note;
				
				var pLoc:Point = id_IndicatorGrp.localToGlobal( new Point( id_noteIndicator.x - 15 +  (id_noteIndicator.width /2) , id_noteIndicator.y + 10) ); 
				popup.move(pLoc.x,pLoc.y );
				*/
			}
			
			
			/**
			 * Ayesha: May 09 2011
			 * hiding all popUps under treatment panel if its view changes
			 * */
			private function id_TreatmentViews_changeHandler(event:IndexChangedEvent):void
			{
				QIPopUpManager.hideAllPopUps();
				
				if (!isSectionLevel)
				{
					if (id_ProcedureView)
					{
						id_ProcedureView.id_Add.id_WriteNotes.selected = false;
					}
					//	removeNotesPanel();
				}
			}
			
			protected function id_dictationIndicator_clickHandler(event:MouseEvent):void
			{
				/* var module:ModuleDictationDTO = QSUtilityFunctions.getModuleDictationDTO(Constants.TREATMENT_MODULE_NAME);
				
				if( dictationPanel )
				{
				dictationPanel.removePopup();					
				}
				
				dictationPanel 					= new DictationPopup();
				dictationPanel.width			= 200;
				dictationPanel.height			= 75;
				dictationPanel.HeadingLable 	= "Dictation";
				dictationPanel.DictationID	 	= module.DictationID;
				
				dictationPanel.ModuleID	 		= module.ModuleTypeID.toString();
				dictationPanel.ShowPopup( this );
				
				var pLoc:Point = id_IndicatorGrp.localToGlobal( new Point( id_dictationIndicator.x - 125 +  (id_dictationIndicator.width /2) , id_dictationIndicator.y + 14) );
				dictationPanel.move( pLoc.x, pLoc.y );*/
				
			}
			
			protected function nextSection_clickHandler(event:MouseEvent):void
			{
				if( id_TreatmentViews.selectedIndex == 1 && id_ProcedureView.id_Add.enableAll )
				{
					AllowMoveToNextPanel( dispactchSelectSectionEvent );
				}
			}
			
			private function dispactchSelectSectionEvent():void
			{
				dispatchEvent( new SelectSection('SelectSection', 'id_TreatmentPanel', true, true) );
			}
			
			public override function AllowMoveToNextPanel( callBack:Function ):void
			{
				if( id_ProcedureView.id_Add.enableAll )
				{
					UtilityFunctions.AskMessage( "There are changes in the form, do you still want to leave form in current state?", function ():void
					{
						callBack(); 
					}); 
				}
				else
				{
					callBack();
				}
			}
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Binding source="model.quickInputDataLoadedFlag" destination="IsModelUpdated" /> 
	<fx:Binding source="id_Prescription.hasViewChanged" destination="hasChange" /> 
	<fx:Binding source="id_ProcedureView.hasViewChanged" destination="hasChange"  />
	
	<custom:HeaderContents>
		
		<quickInput:PMHSectionHeader id="id_Header" width="100%" height="22" HeadingLable="Treatment" SectionNameID="{QSSecurityUtil.QI_TREATMENTS}"/>
		
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		
		<s:SkinnableContainer width="100%" minHeight="36" height="100%"  skinClass="com.adobe.Quivus.view.controls.skins.QISlideHeaderOuterSkin">						
			<s:layout>
				<s:HorizontalLayout horizontalAlign="center" verticalAlign="middle" paddingRight="5" />
			</s:layout>
			<custom:slideOutQIHeader Label="Treatment" width="100%" height="22" />								   
		</s:SkinnableContainer>			   
		
	</custom:SlideHeaderContents>
	<custom:Contents>
		<!--<s:VGroup width="{id_Header.width}" verticalAlign="top" gap="0" 
		horizontalAlign="{isSlideOut? 'right':'center'}" paddingTop="{isSlideOut? -2:0}" paddingLeft="{isSlideOut? 30:1}">-->
		<s:SkinnableContainer skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.QISectionBGSkin" width="{id_Header.width}" >
			<s:layout>
				<s:VerticalLayout  verticalAlign="top" gap="0"   horizontalAlign="{isSlideOut? 'right':'center'}" paddingRight="3"
								   paddingTop="{isSlideOut? -2:0}" paddingLeft="{isSlideOut? 1:1}"/>
			</s:layout>
			<notes:QISectionLevelNotesDictation id="id_notesDictation" width="100%" 
												/>
			
			<s:SkinnableContainer id="sc_Treatment" skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.QISectionBGSkin" width="{id_Header.width}" minHeight="50"
								  visible="{model.securityProxyObject.PatientExam.QuickInput.Assessment.Treatments.IsViewAllowed}" includeInLayout="{sc_Treatment.visible}">
				
				<!--<s:BorderContainer width="{id_Header.width}" backgroundColor="#F8F8F8" borderWeight="2" borderAlpha="{isSlideOut?1:0}" borderColor="#368CC3" minHeight="50"> -->
				<s:layout>
					<s:VerticalLayout gap="-7" horizontalAlign="left"  paddingLeft="3" paddingRight="3" paddingTop="5" paddingBottom="0"/>
				</s:layout>
				
				<s:HGroup >
					
					<s:TabBar dataProvider="{id_TreatmentViews}" skinClass="com.adobe.quivus.skins.chrome.tabBarSkins.QIrecordingsTabBar"
							  buttonMode="true"/>
					
				</s:HGroup>
				<!--<s:BorderContainer width="100%" height="100%" borderAlpha="1" borderColor="#827E71" backgroundAlpha="1" backgroundColor="#000000">	-->
				<s:SkinnableContainer width="100%" height="100%" skinClass="com.adobe.quivus.skins.chrome.containerSkins.planPanel">
					<s:layout>
						<s:VerticalLayout paddingTop="5" paddingLeft="0" paddingRight="0" paddingBottom="0"/>
					</s:layout>
					<mx:ViewStack id="id_TreatmentViews" width="100%" height="100%" resizeToContent="true" change="id_TreatmentViews_changeHandler(event)">
						<s:NavigatorContent width="100%" label="Prescription" height="100%">
							
							<treatment:PrescriptionView id="id_Prescription" width="100%" includeInLayout="{id_Prescription.visible}"
														visible="{model.securityProxyObject.PatientExam.QuickInput.Assessment.Treatments.Prescription.IsViewAllowed}"/>
						</s:NavigatorContent>
						
						<s:NavigatorContent width="100%" label="Procedure" >
							
							<treatment:ProcedureView id="id_ProcedureView" width="100%" creationComplete="procedureCreationHandler()" includeInLayout="{id_ProcedureView.visible}"
													 visible="{model.securityProxyObject.PatientExam.QuickInput.Assessment.Treatments.Procedures.IsViewAllowed}" />
							
						</s:NavigatorContent>
						
					</mx:ViewStack>
					<!--<treatment:TreatmentView width="100%" height="100%" id="id_TreatmentView"/>-->
					<s:HGroup width="100%">					
						<s:HGroup id="id_IndicatorGrp" width="100%" horizontalAlign="left" >
							<s:Button id="id_noteIndicator" label="Notes" visible="false" includeInLayout="{id_noteIndicator.visible}"
									  click="id_noteIndicator_clickHandler(event)" toolTip="View Notes" 
									  useHandCursor="true" buttonMode="true" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.notesIndicatorBtnSkin" />
							<s:Button id="id_dictationIndicator" label="Dictation" visible="false" includeInLayout="{id_dictationIndicator.visible}"
									  click="id_dictationIndicator_clickHandler(event)" toolTip="Play Dictation" 
									  useHandCursor="true" buttonMode="true" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.dictationIndicatorBtnSkin"/>
						</s:HGroup>
						<s:Group id="id_spacer" width="100%" height="1" />
						<!--<s:Button label="Next" click="dispatchEvent( new SelectSection('SelectSection', 'id_TreatmentPanel', true, true) )" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.QInextBtnSkin" toolTip="Next Section" />-->
					</s:HGroup>
					
					<!--</s:BorderContainer>-->
					<!--</s:BorderContainer>-->
					
				</s:SkinnableContainer>
			</s:SkinnableContainer>
		</s:SkinnableContainer>
	</custom:Contents>
	
</custom:PinableSlideOutPanel>
