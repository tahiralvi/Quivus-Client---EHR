<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx">
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.ChromeUtil;
			
			import flash.globalization.NumberFormatter;
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			private function set Progress(value:int):void
			{
				id_ProgessBar.setProgress( value, model.totalPatientsInDB );
				id_ProgessBar.label = formatter.format( value / model.totalPatientsInDB * 100 ) + " %";
			}
			
			private function set ProgressTotal(value:int):void
			{
				id_ProgessBar.minimum = 0;
				id_ProgessBar.maximum = value;
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:NumberFormatter id="formatter" fractionalDigits="2" 
						   errorText="'value' is an invalid."/>
	</fx:Declarations>
	
	<fx:Binding source="model.lastRecordNumberInDB" destination="Progress" /> 
	<fx:Binding source="model.totalPatientsInDB" destination="ProgressTotal" /> 
	
	
	
	<s:layout>
		<s:VerticalLayout gap="6" paddingLeft="20" paddingRight="20" paddingTop="20" horizontalAlign="center" verticalAlign="middle"  />
	</s:layout>
	
	
	<s:Label text="{model.SyncHeaderLabel}" width="100%" fontSize="28" textAlign="left" />
	
	
	
	<s:SWFLoader source="assets/updater/FileLoading.swf" width="96%" />
	<mx:ProgressBar id="id_ProgessBar" width="96%" mode="manual" visible="false" />
	
	<s:HGroup width="100%" >
		<s:VGroup >
			<s:Label text="{model.SyncTotalToSyncCount}" width="100" fontSize="15" textAlign="left" />
			<s:Label text="{model.SyncTotalToSyncLabel}" width="250" fontSize="15" />
		</s:VGroup>
		<s:Group id="spacer" width="100%" />
		<s:VGroup >
			<s:Label text="{model.SyncSyncedCount}" width="100" fontSize="15" textAlign="left" />
			<s:Label text="{model.SyncSyncedLabel}" width="150" fontSize="15" />
		</s:VGroup>
		
	</s:HGroup>
	
</s:Group>
