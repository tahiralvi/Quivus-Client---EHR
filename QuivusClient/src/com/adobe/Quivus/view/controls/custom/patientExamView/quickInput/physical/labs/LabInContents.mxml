			public function areRequiredFieldsProvidedAndValid():Boolean
			{
				/* calling isGetEdited() to check whether is there any change in view or not
				just to set hasViewChanged boolean
				*/
				isGetEdited();
				
				if(UtilityFunctions.IsNullOrEmpty(id_TestCode.textInput.text ))
					return false;
				
				if(UtilityFunctions.IsNullOrEmpty(id_TestName.textInput.text ))
					return false;
				
				return true;
			}
			
			public function showNotes(loc:Point):void
			{
				if (loc)
				{
					if( recordNotesPanel )
						recordNotesPanel.removePopup();
					
					if (!recordNotesDTO)
						recordNotesDTO = new ModuleNoteDTO();
					
					recordNotesPanel 					= new NotesPanel();
					recordNotesPanel.width			= 580;
					recordNotesPanel.height			= 150;
					recordNotesPanel.HeadingLable 	= id_TestName.textInput.text;
					recordNotesPanel.VisitDateLable = model.FormatedVisitDate;
					recordNotesPanel.notesDTO	= recordNotesDTO;
					recordNotesPanel.ShowPopup( this );
					recordNotesPanel.move( loc.x, loc.y );
					
					recordNotesPanel.id_header.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						recordNotesPanel.SaveNotes();
						recordNotesPanel.removePopup();
						event.stopImmediatePropagation();
					});
					
				}
			}
			
