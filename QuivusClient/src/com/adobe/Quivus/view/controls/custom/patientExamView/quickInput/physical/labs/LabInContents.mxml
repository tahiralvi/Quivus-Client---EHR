					dispactchSelectSectionEvent();
				} */
			}
			
			private function dispactchSelectSectionEvent():void
			{
				dispatchEvent( new Event('nextSection',true,true));
			} 
			//Tahir Alvi - Aditional popup implementation 
			[Bindable]public var selectedDTO:InHouseLabTestTypeDTO;
			private var serachTerm:String;//Search term for the records
			
			private function testCodeKeyUpHandler():void
			{
				serachTerm = '';
				serachTerm = id_TestCode.textInput.text;
				//if value exceeds 4 characters then search Icd Code and map the Icd Code.
				if(serachTerm.length >= 5)
				{
					id_TestName.textInput.text 		= '';
					id_TestName.selectedIndex 		= -1;
					selectedDTO 					= null;
					id_Add.enabled 					= isGetEdited();
					var labEvent : LoadInHouseLabTestTypeByClinicIdEvent = new LoadInHouseLabTestTypeByClinicIdEvent(loadData);
					CairngormEventDispatcher.getInstance().dispatchEvent( labEvent );
					
				}else{
					id_TestName.textInput.text 		= '';
					id_TestName.selectedIndex 		= -1;
					selectedDTO 					= null;
					id_Add.enabled 					= isGetEdited();
				}
			}
			public  function loadData(val:* = null):void
			{
				if(model.inHouseLabTestTypeDTOList.length)
				{
					for(var i:uint=0; i < model.inHouseLabTestTypeDTOList.length; i++)
					{
						if(serachTerm == model.inHouseLabTestTypeDTOList[i].TestCode)
						{
							id_TestCode.textInput.text 	= model.inHouseLabTestTypeDTOList[i].TestCode;
							id_TestName.textInput.text  = model.inHouseLabTestTypeDTOList[i].TestName;
							selectedDTO					= model.inHouseLabTestTypeDTOList[i];
							id_Add.enabled 				= isGetEdited();
							return;
						}							
					}
				}
			}
			private function testNameChangeHandler():void
			{
				serachTerm = '';
				serachTerm = id_TestName.textInput.text;
			}
			private function labIn_ClickHandler(event:MouseEvent, index:uint):void
			{
				if(event.target as RichEditableText || event.target as Label)
				{
					return;
				}
				else 
				{
					if(serachTerm == null)
						return
					
					if(serachTerm.length > 2)
					{
						openLabInPopup(index);
					}
				}
			}
			private function openLabInPopup(index:int):void
			{
				var addlabInPopup:LabInPopup = new LabInPopup();
				addlabInPopup.ShowPopup( this );
				//QIPopUpManager.addPopUp( addlabInPopup, QIPopUpManager.IN_HOUSE_LAB );
				addlabInPopup.addEventListener(CloseEvent.CLOSE, function (event:CloseEvent):void
				{
					if( model.quickInputDTO.Physical.InHouseLabs.length > 0 )
					{
						hasViewChanged = true;
					}
				});
				addlabInPopup.title  = "Add LabIn";
				addlabInPopup.height = 410;
				addlabInPopup.width  = 600;
				
				//addlabInPopup.move((Capabilities.screenResolutionX/8) , addlabInPopup.y - 20);
				addlabInPopup.move(addlabInPopup.x - 25 , addlabInPopup.y - 125);
				addlabInPopup.searchAndLoadLabIn(serachTerm, index);
				
				addlabInPopup.removeEventListener( "labInAdded", onLabInAdded );
				addlabInPopup.addEventListener( "labInAdded", onLabInAdded );
				
				resetFields();
			}
			// dataProvider="{model.inHouseLabTestTypeDTOList}" labelField="TestName" labelField="TestCode"
			//Change the view and buttons when records added in the grid from popup
			private function onLabInAdded(event:Event):void
			{
				if(hasViewChanged)
					hasViewChanged = false;
				
				hasViewChanged = true;
			}
			
			private var _labInCollection:ArrayCollection
			[Bindable]
			public function get labInCollection():ArrayCollection
			{
				return _labInCollection;
			}
			
			public function set labInCollection(value:ArrayCollection):void
			{
				_labInCollection = value;
				if (_labInCollection)
				{
					_labInCollection.addEventListener(CollectionEvent.COLLECTION_CHANGE, labInCollectionChangeHandler, false, 0, true);
					
				}
				
				//model.labsReviewHistory = _labInCollection;
			}
			
			private function labInCollectionChangeHandler(event:CollectionEvent):void
			{
				if(labInCollection)
				{
					if(labInCollection.length > 1)
						hasViewChanged = true;
					else if(labInCollection.length < 1)
						hasViewChanged = false;
				}
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<validators:ComboValidator id="comboValidator" source="{id_TestCode}" property="selectedItem"/>
	</fx:Declarations>
	
	<fx:Binding source="model.quickInputDTO.Physical.InHouseLabs" destination="labInCollection"/>
	
