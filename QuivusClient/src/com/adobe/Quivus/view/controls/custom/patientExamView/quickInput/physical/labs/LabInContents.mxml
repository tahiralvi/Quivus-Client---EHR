			private function browseFileHandler():void
			{
				if (!fileToOpen)
					fileToOpen = new File();
				
				fileToOpen.browse();
				fileToOpen.addEventListener(Event.SELECT, fileSelectHandler, false, 0, true);
				
			}
			
			private function fileSelectHandler(event:Event):void
			{
				var fileStream:FileStream = new FileStream();
				fileStream.open(fileToOpen, FileMode.READ);
				
				attachmentContent = new ByteArray();
				
				fileStream.readBytes(attachmentContent, 0, fileStream.bytesAvailable);
				fileStream.close();
				
				id_AttachBtn.label = "Change";
				
				id_cbAttachement.label = fileToOpen.name;
				id_cbAttachement.visible = true;
				id_cbAttachement.selected = true;
			}
			
			protected function checkbox1_changeHandler(event:Event):void
			{
				if( false == id_cbAttachement.selected )
				{
					id_cbAttachement.visible = false;
					attachmentContent = null;
				}
			}
			
