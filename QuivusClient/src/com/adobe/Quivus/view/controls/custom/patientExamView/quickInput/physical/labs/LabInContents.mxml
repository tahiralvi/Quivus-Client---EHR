			private function editRecordClickHandler(event:DataGridActionsEvent):void
			{
				id_LabsRecordGrid.editable = true;
				
				var rowIndex:int = LabelDataGrid(event.currentTarget).selectedIndex;
				
				var itemToSetInEditableMode:IListItemRenderer = id_LabsRecordGrid.indexToItemRenderer(rowIndex);
				
				var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
				ev.columnIndex = 2;
				ev.rowIndex = rowIndex;
				ev.itemRenderer = itemToSetInEditableMode;
				ev.dataField = "InHouseLabTestType.TestCode";
				id_LabsRecordGrid.dispatchEvent(ev);
			}
			
			private function deleteRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_LAB_IN ) )
				{
					var curTar:LabelDataGrid = LabelDataGrid(event.currentTarget);
					
					var inHouseLabID:int = InHouseLabDTO(event.currentTarget.selectedItem).PatientInHouseLabTestID;
					UtilityFunctions.AskMessage(  "Do you want to delete selected record", function():void
					{
						if (inHouseLabID == 0)
						{
							model.quickInputDTO.Physical.InHouseLabs.removeItemAt(curTar.selectedIndex);
							if (model.quickInputDTO.Physical.InHouseLabs.length <= 0)
							{
								_hasGridChanged = false;
								hasViewChanged = isGetEdited();
							}
						}
						else
						{
							id_LabsRecordGrid.selectedItem.IsDeleted = true;
							model.quickInputDTO.Physical.InHouseLabs.filterFunction = filterDeletedItems;
							model.quickInputDTO.Physical.InHouseLabs.refresh();
							hasViewChanged = _hasGridChanged = true;
						}
					});
					
					
					if (model.quickInputDTO.Physical.InHouseLabs.length <= 0)
					{
						_includeGridInLayout = false;
						_includeGridInLayoutChanged = false;
					}
				}
			}
			
			private function filterDeletedItems(item:Object):Boolean
			{
				var b:Boolean = item["IsDeleted"];
				return (!b);
			}
			
			private function addRecordClick(event:Event):void
			{	
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_LAB_IN ) )
				{
					id_Add.enableAll = areRequiredFieldsProvidedAndValid();
					if( !id_Add.enableAll )
					{
						if( UtilityFunctions.IsNullOrEmpty( id_TestCode.selectedItem ) )
						{
							id_TestCode.errorString = "invalid Test Code";
							id_TestCode.setFocus();
						}
						else if	(UtilityFunctions.IsNullOrEmpty(id_TestName.selectedItem) )
						{
							id_TestName.errorString = "invalid Test Name";
							id_TestName.setFocus();
						}
						return; // invalid data
					}
					
					if (!_includeGridInLayout)
					{
						_includeGridInLayout = true;
						_includeGridInLayoutChanged = true;
						
						invalidateProperties();
					}
					
					var inHouseLabDTO:InHouseLabDTO = new InHouseLabDTO();
					//	inHouseLabDTO.InHouseLabTestType = id_TestCode.selectedItem as InHouseLabTestTypeDTO;
					inHouseLabDTO.InHouseLabTestType = selectedDTO;
					inHouseLabDTO.TestResult = id_Result.text;
					
					if(attachmentContent)
						inHouseLabDTO.ResultAttachment = AppUtils.getBase64String(attachmentContent);
					
					inHouseLabDTO.CreatedAt = new Date();
					inHouseLabDTO.CreatedBy = model.loggedInUserDTO.UserId;
					inHouseLabDTO.DictationID = Constants.GUID_FORMAT;
					inHouseLabDTO.ModifiedAt = Constants.NULL_DATE;
					
					if( model.visitDTO!=null)
					{
						inHouseLabDTO.VisitDate = model.visitDTO.VisitDate;
						inHouseLabDTO.VisitID 	= model.visitDTO.VisitId;
					}
					else if(model.quickInputDTO!= null && model.quickInputDTO.Visit!=null)
					{
						
						inHouseLabDTO.VisitDate = model.quickInputDTO.Visit.VisitDate;
						inHouseLabDTO.VisitID	= model.quickInputDTO.Visit.VisitId;
					}
					
					inHouseLabDTO.PatientID = model.loadedPatientId;
					
					if (id_Add.notesDTO)
					{
						inHouseLabDTO.Notes = id_Add.notesDTO.Note;
						inHouseLabDTO.NoteSubject = id_Add.notesDTO.NoteSubject;
					}
					
					if (id_Add.dictationDTO != null && id_Add.dictationDTO.DictationID != null)
					{
						inHouseLabDTO.DictationID = id_Add.dictationDTO.DictationID;
					}
					
					if(model.quickInputDTO.Physical== null)
						model.quickInputDTO.Physical = new PhysicalDTO();
					
					if(model.quickInputDTO.Physical.InHouseLabs== null)
						model.quickInputDTO.Physical.InHouseLabs = new ArrayCollection();
					
					model.quickInputDTO.Physical.InHouseLabs.addItem(inHouseLabDTO);
					//add for review history
					//model.labsReviewHistory.addItem(inHouseLabDTO);
					
					if(hasViewChanged)
						hasViewChanged = false;
					
					_hasGridChanged = true;
					hasViewChanged  = true;
					
					resetFields();
					id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
					id_Add.id_WriteDictation.setStyle("skinClass", QIDictationBtn);
				}
			}
			
			private var recordLevelDicPanel:DictationPopup;
			private function writeDictationClickHandler(event:Event):void
			{
				var addRecord:AddRecord = AddRecord(event.target);
				
				recordLevelDicPanel = QIDictationManager.show(addRecord, recordLevelDicPanel, addRecord.dictationDTO, addRecord.id_WriteDictation);
				QIPopUpManager.addPopUp(recordLevelDicPanel, QIPopUpManager.IN_HOUSE_LAB);
				recordLevelDicPanel.move( recordLevelDicPanel.x - 81, recordLevelDicPanel.y);
				
				recordLevelDicPanel.addEventListener(MouseEvent.CLICK, function():void
				{
					QIPopUpManager.removePopUp(recordLevelDicPanel, QIPopUpManager.IN_HOUSE_LAB);
					
					if(recordLevelDicPanel && recordLevelDicPanel.DictationID)
					{
						id_Add.id_WriteDictation.setStyle("skinClass", ImmunizationSpeakerBtn);
					}
					
				}, true, 0, false);
				
			}
			
			private function comboChangeHandler(event:Event):void
			{
				var combo:LabelComboBox = LabelComboBox(event.currentTarget);
				
				id_Add.enabled = isGetEdited();
				
				if (combo.id == "id_TestCode")
				{
					id_TestName.textInput.text = "";
					
					var selectedCodeDTO:InHouseLabTestTypeDTO = id_TestCode.selectedItem as InHouseLabTestTypeDTO;
					id_TestName.selectedItem = selectedCodeDTO;
					
					if (id_TestName.dataProvider)
						id_TestName.selectedIndex = id_TestName.dataProvider.getItemIndex(selectedCodeDTO);
					
					if (id_TestCode.dataProvider)
						id_TestCode.selectedIndex = id_TestCode.dataProvider.getItemIndex(selectedCodeDTO);
					
					id_Add.enableAll = areRequiredFieldsProvidedAndValid();
				}
					
				else if (combo.id == "id_TestName")
				{
					id_TestCode.textInput.text = "";
					
					var selectedNameDTO:InHouseLabTestTypeDTO = id_TestName.selectedItem as InHouseLabTestTypeDTO;
					id_TestCode.selectedItem = selectedNameDTO;
					
					if (id_TestCode.dataProvider)
						id_TestCode.selectedIndex = id_TestCode.dataProvider.getItemIndex(selectedNameDTO);
					
					if (id_TestName.dataProvider)
						id_TestName.selectedIndex = id_TestName.dataProvider.getItemIndex(selectedNameDTO);
					
					id_Add.enableAll = areRequiredFieldsProvidedAndValid();
				}
			}
			
			private function comboKeyUpHandler(event:Event):void
