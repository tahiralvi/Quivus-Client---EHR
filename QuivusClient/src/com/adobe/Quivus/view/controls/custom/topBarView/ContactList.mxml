			protected function contacts_clickHandler(event:MouseEvent):void
			{
				switch( event.target.id )
				{
					case "id_mail":
						var dto:ContactSearchDTO = event.currentTarget.selectedItem as ContactSearchDTO; 
						var ev:mailClickEvent = new mailClickEvent( mailClickEvent.NAME, dto, true, false, event.localX, event.localY, event.relatedObject, event.ctrlKey, event.altKey, event.shiftKey, event.buttonDown, event.delta, event.commandKey, event.controlKey, event.clickCount);
						dispatchEvent( ev );
						break;
					case "id_Message":
						var dto1:ContactSearchDTO = event.currentTarget.selectedItem as ContactSearchDTO;
						var sce:smsClickEvent = new smsClickEvent( smsClickEvent.NAME, dto1, true, false, event.localX, event.localY, event.relatedObject, event.ctrlKey, event.altKey, event.shiftKey, event.buttonDown, event.delta, event.commandKey, event.controlKey, event.clickCount);
						//var ev:mailClickEvent = new mailClickEvent( mailClickEvent.NAME, dto, true, false, event.localX, event.localY, event.relatedObject, event.ctrlKey, event.altKey, event.shiftKey, event.buttonDown, event.delta, event.commandKey, event.controlKey, event.clickCount);
						dispatchEvent( sce );
						break;
				}
				
				//event.stopImmediatePropagation();
				//Alert.show( event.currentTarget.name, event.target.id );
			}

			public function setListHeight():void
			{
				
				if(contacts &&  contacts.dataProvider && contacts.dataProvider.length < 5)
				{
					trace( "list height: " + contacts.dataProvider.length * 20);
					contacts.height= contacts.dataProvider.length * 20;
				}
				else
				{
					contacts.height= 110;
				}
			}
			
			protected function contacts_creationCompleteHandler(event:FlexEvent):void
			{
				//setListHeight();
				
				contacts.setStyle("useRollOver", true);
				
				
				contacts.setStyle("backgroundColor", 0xFFFFFF );
				contacts.setStyle( "rollOverColor", 0xF7C174 );
				contacts.setStyle( "textRollOverColor", 0x333333 );
				contacts.setStyle( "selectionColor", 0x7c632c );
				contacts.setStyle( "borderColor", 0xcccccc );
				contacts.setStyle( "borderAlpha", 0 );
			}


			protected function popupgroup1_creationCompleteHandler(event:FlexEvent):void
			{
				FlexGlobals.topLevelApplication.mainContainer.addEventListener( MouseEvent.CLICK, function(event:MouseEvent):void
				{
					removePopup();
				});
			}

