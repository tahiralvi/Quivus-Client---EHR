		<s:filters>
			<s:DropShadowFilter blurX="4.0" blurY="4.0" distance="4.0" hideObject="false" inner="false" color="0x000000" strength="1" alpha="0.5" quality="2" knockout="false" angle="90"/>
		</s:filters>
		<s:Rect minHeight="170" height="100%" radiusX="3" width="227" x="16" y="27">
			<s:fill>
				<s:LinearGradient rotation="270">
					<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="0"/>
					<s:GradientEntry alpha="1" color="#FFFFFF" ratio="0.25882352941176473"/>
					<s:GradientEntry alpha="1.0" color="#E4E4E4" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="2" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
			</s:filters>
		</s:Rect>
		
		<s:Group id="id_BodyArea" y="10" x="15">
			<s:Group x="2.5" y="19">
				<s:Rect height="19" radiusX="9" width="187" x="0.5" y="0.5">
					<s:fill>
						<s:LinearGradient rotation="90">
							<s:GradientEntry alpha="1.0" color="#89A0BE" ratio="0"/>
							<s:GradientEntry alpha="1.0" color="#5877A2" ratio="0.47058823529411764"/>
							<s:GradientEntry alpha="1.0" color="#486A9A" ratio="0.47058823529411764"/>
							<s:GradientEntry alpha="1.0" color="#4A6C9B" ratio="1"/>
						</s:LinearGradient>
					</s:fill>
					<s:stroke>
						<s:SolidColorStroke caps="none" color="#375075" joints="miter" miterLimit="4" weight="1"/>
					</s:stroke>
					<s:filters>
						<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="2" strength="1"/>
						<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
					</s:filters>
				</s:Rect>
				<s:RichText id="id_HeaderLabel" width="180" textAlign="center" color="#FFFFFF" fontFamily="Calibri" fontSize="13" tabStops="S0" text="Allergies" x="10" y="4">
