<?xml version="1.0" encoding="utf-8"?>
<custom:SlideOutPanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:custom="com.adobe.Quivus.view.controls.custom.*" 
					  xmlns:skins="com.adobe.Quivus.view.controls.skins.*" 
					  xmlns:components="com.zigron.controls.extended.components.*" 
					  xmlns:buttonSeparators="com.adobe.Quivus.view.controls.skins.buttonSeparators.*" 

					  creationComplete="slideoutpanel1_creationCompleteHandler(event)" xmlns:soapNote="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.soapNote.*" xmlns:components1="com.gazuntite.controls.extended.components.*"
					 
					  >
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.utils.ChromeUtil;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.expandButton_grey;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.expandButton_grey_expanded;
			
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			
			import spark.resize.ResizeManager;
			import spark.resize.verticalResizeHandle;
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.adobe.Quivus.events.ePrescription.SyncEPrescriptionEvent;
			import com.adobe.Quivus.model.AppModelLocator;
			import mx.events.CloseEvent;

			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			
			[Bindable]
			public var headerLabel:String;
			[Bindable]
			public var toolTipLabel:String = "Close ";

			protected function slideoutpanel1_creationCompleteHandler(event:FlexEvent):void
			{
				
			}

			protected function button1_clickHandler(event:MouseEvent):void
			{
				this.ToggleSlideOut();
				event.stopImmediatePropagation();
			}

			protected function CloseHandler(event:MouseEvent):void
			{
				//chUtil.removeWindowsCount();
				//var luiEvent : SyncEPrescriptionEvent = new SyncEPrescriptionEvent();
				//CairngormEventDispatcher.getInstance().dispatchEvent( luiEvent );
				dispatchEvent( new CloseEvent("close") );
			}
			

		]]>
		
	</fx:Script>

	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	
	<custom:HeaderContents>
		<s:Group id="id_header" width="100%" minWidth="{ChromeUtil.topLevelMainContainer.width - 32}">
			<s:layout>
				<s:VerticalLayout paddingLeft="{isSlideOut? 5:0}"  horizontalAlign="center" />
			</s:layout>
		<s:SkinnableContainer  height="22" width="100%" minWidth="550" skinClass="com.adobe.Quivus.view.controls.skins.PatientRegHeaderSkin">
			<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="left" >
				<s:Label  paddingLeft="12" color="#111111" paddingTop="6" fontFamily="Calibri Bold" text="{headerLabel}" />
				<mx:Spacer width="100%" />
			
			</s:HGroup>
			<s:HGroup horizontalAlign="right" width="100%" paddingRight="1" paddingTop="0" gap="1">
				<buttonSeparators:buttonSeparatorGrey />
				<s:HGroup paddingTop="0">
					
				<s:ToggleButton id="id_expandBtn" skinClass="com.adobe.quivus.skins.chrome.buttonSkins.expandButton_white" 
								buttonMode="true" useHandCursor="true" toolTip="{id_expandBtn.selected?'Collapse':'Expand'}"/>
				</s:HGroup>
				<buttonSeparators:buttonSeparatorGrey />
				<s:HGroup paddingTop="0" paddingRight="3">
				<s:ToggleButton id="id_slideoutBtn" skinClass="com.adobe.quivus.skins.chrome.toggleButtonSkins.slideOutBtn_white"
								buttonMode="true" useHandCursor="true" toolTip="{id_slideoutBtn.selected?'Slide-In':'Slide-Out'}" 
								width="18" height="18"  click="button1_clickHandler(event)" />
					</s:HGroup>
			</s:HGroup>
		</s:SkinnableContainer>
			</s:Group>
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		
		<s:SkinnableContainer height="22" width="100%" minWidth="550" skinClass="com.adobe.Quivus.view.controls.skins.PatientRegHeaderSkin">
			<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="center" >
				<s:Label  paddingLeft="12" color="#ffffff" paddingTop="6" fontFamily="Calibri Bold" text="{headerLabel}" />				
				
			</s:HGroup>
			
		</s:SkinnableContainer>
			
	</custom:SlideHeaderContents>
	
	<custom:Contents>
		
		<components1:ResizeableGroup id="id_contentsResizer" width="{id_header.width }" height="260" bottom="0" maxHeight="{isSlideOut? ChromeUtil.topLevelMainContainer.height-98: 500}" 
									resizeDirection="{ResizeManager.DIRECTION_VERTICAL}" resizeHandle="{new verticalResizeHandle()}"
									
									>
			
			<s:VGroup paddingTop="1" gap="0" height="100%" width="{id_header.width}" verticalAlign="middle" horizontalAlign="center"
					  paddingLeft="{isSlideOut? 10:0}" paddingBottom="25">
				
				<s:VGroup paddingTop="{isSlideOut? -2:0}" gap="-2" height="100%" width="{isSlideOut? id_header.width:id_header.width- 42 }"  verticalAlign="middle" horizontalAlign="center" >
					
					
					<soapNote:soapNoteView id="id_ePres" width="100%" height="100%" minHeight="20" />
					
					<s:HGroup paddingBottom="0" paddingRight="{isSlideOut?10:0}">
						
						<s:Button id="id_CloseBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.closeBtnSkin" 
								  click="CloseHandler(event)" buttonMode="true" 
								  useHandCursor="true" toolTip="{toolTipLabel+headerLabel.toLowerCase()}"/>
					</s:HGroup>
					
				</s:VGroup>
			</s:VGroup>
			
		</components1:ResizeableGroup>
	</custom:Contents>
	
</custom:SlideOutPanel>
