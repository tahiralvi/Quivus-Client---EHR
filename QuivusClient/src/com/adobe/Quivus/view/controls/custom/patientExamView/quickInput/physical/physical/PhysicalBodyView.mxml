<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:components="com.zigron.controls.extended.components.*" xmlns:components1="com.gazuntite.controls.extended.components.*"
		 
		 >
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.utils.Constants;
			import com.adobe.Quivus.utils.QSUtilityFunctions;
			import com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.commons.manager.QIPopUpManager;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			import mx.events.ItemClickEvent;
			
			import valueObjects.PhysicalsDTO;
			
			[Bindable]
			private var m_acDataProvider:ArrayCollection;// = createDummyData();
			
			private var m_bHasChange:Boolean;
			
			[Bindable]
			public function get hasChange():Boolean
			{
				return m_bHasChange;
			}
			
			public function set hasChange(value:Boolean):void
			{
				m_bHasChange = value;
			}

			public function get DataProvider():ArrayCollection
			{
				return m_acDataProvider;
			}
			
			public function set DataProvider(value:ArrayCollection):void
			{
				m_acDataProvider = value;
			}
			
			private var previouslySelectedItem:PhysicalSubCatRenderer;
			protected function treelist1_ItemClickEventHandler(event:ItemClickEvent):void
			{
				if( event.relatedObject is PhysicalSubCatRenderer )
				{
					var dto:PhysicalsDTO = event.currentTarget.ParentSelectedItem.data as PhysicalsDTO;
					dto.IsNormal = IsAllChildNormal( dto ) ? Constants.STRING_TRUE : Constants.STRING_FALSE;
					
					if (event.relatedObject != previouslySelectedItem)
					{
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.PHYSICAL);
						previouslySelectedItem = PhysicalSubCatRenderer(event.relatedObject);
					}
				}
				
				if (event.relatedObject is PhysicalMainCatRenderer)
				{
					QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.PHYSICAL);
				}
			}
			
			private function IsAllChildNormal( dto:PhysicalsDTO ):Boolean
			{
				var retVal:Boolean = true;
				var i:int;
				for( i = 0; i < dto.children.length; i++ )
				{
					var child:PhysicalsDTO = dto.children.getItemAt(i) as PhysicalsDTO ;
					retVal = child.IsNormal != Constants.STRING_FALSE ;
					
					if( ! retVal )
						break;
				}
				
				return retVal;
			}
			
			protected function treelist1_footerClickHandler(event:ItemClickEvent):void
			{
				var itemIndex:int = DataProvider.getItemIndex( id_TreeList.ParentSelectedItem.data );
				switch( event.item.id )
				{
					case "id_AllNormalBtn":
						trace( "id_AllNormalBtn", id_TreeList.ParentSelectedItem.label);
						var dataDTO:PhysicalsDTO = id_TreeList.ParentSelectedItem.data as PhysicalsDTO;
						var mainCatID:int = dataDTO.PhysicalMainCategoryTypeID;
						var subCatID:int = -1;
						if( dataDTO.PhysicalSubCategoryTypeID && dataDTO.PhysicalSubCategoryTypeID != 0 )
							subCatID = dataDTO.PhysicalSubCategoryTypeID
						if( QSUtilityFunctions.checkPhysicalsDTOMainCategoryNotes( mainCatID, subCatID ) )
						{
							Alert.show("This action will clear all notes/dictation in this section, Are you sure you want to clear all notes/dictation?","Clear Notes and Dictation", Alert.YES|Alert.NO, 
								FlexGlobals.topLevelApplication.mainContainer, function(event:CloseEvent):void
								{
									if( event.detail == Alert.YES)
									{
										QSUtilityFunctions.setPhysicalsDTOMainCategoryToNormal(  mainCatID, true, subCatID );
										dispatchEvent( new Event("PhysicalIsDirty", true, true) );
									}
									else if( event.detail == Alert.NO)
									{
										// NO button was clicked, do nothing
									}
								});
						}
						else
						{
							QSUtilityFunctions.setPhysicalsDTOMainCategoryToNormal( id_TreeList.ParentSelectedItem.data.PhysicalMainCategoryTypeID, false, subCatID );
						}
						
						dispatchEvent( new Event("PhysicalIsDirty", true, true) );
						break;
					case "id_PreviousBtn":
						id_TreeList.selectItemByIndex( --itemIndex );
						break;
					case "id_NextBtn":
						id_TreeList.selectItemByIndex( ++itemIndex );
						break;
				}
			}


			protected function id_TreeList_creationCompleteHandler(event:FlexEvent):void
			{
				id_TreeList.setStyle("rollOverAlpha", 0);
				id_TreeList.setStyle("useRollOver", false);
				id_TreeList.setStyle("selectionColor", 0xffffff);
				
				addEventListener( "PhysicalIsDirty", function(event:Event):void
				{
					trace("PhysicalIsDirty", id_TreeList.ParentSelectedItem.label);
					var p:PhysicalMainCatRenderer = id_TreeList.ParentSelectedItem as PhysicalMainCatRenderer;
					p.PhysicalsDto.IsDirty = true;
					p.UpdateCheckStatus();
					if( id_TreeList.ParentSelectedItem2level )
					{
						var p2:PhysicalMainCatRenderer = id_TreeList.ParentSelectedItem2level as PhysicalMainCatRenderer;
						p2.PhysicalsDto.IsDirty = true;
						p2.UpdateCheckStatus();
					}
					
					hasChange = true;
				});
				
			}
			
			public function UpdateCheckStatus():void
			{
				( id_TreeList.ParentSelectedItem as PhysicalMainCatRenderer ).UpdateCheckStatus();
				if( id_TreeList.ParentSelectedItem2level )
					( id_TreeList.ParentSelectedItem2level as PhysicalMainCatRenderer ).UpdateCheckStatus();
				
				hasChange = true;
			}
			
			private function createDummyData( maxDataSize:int = 10 ):ArrayCollection
			{
				var dummy:ArrayCollection = new ArrayCollection();
				var i:int;
				for( i = 0; i < maxDataSize; i++ )
				{
					var pDTO:Object = new Object();
					pDTO.label = "Parent " + i;
					pDTO.children = new ArrayCollection();
					var j:int;
					var add:Boolean = true;
					for( j = 0; j < maxDataSize; j++ )
					{
						add = true;
						var cDTO:Object = new Object();
						cDTO.label = "Child " + i + " " + j;
						if( i == 4 || i == 6 || i == 8 )
						{
							add = false;
							if( j == 3 || j == 5 || j == 7 )
							{
								add = true;
								cDTO.children = new ArrayCollection();
								var k:int;
								for( k = 0; k < maxDataSize; k++ )
								{
									var ccDTO:Object = new Object();
									ccDTO.label = "Child " + i + " " + j + " " + k;
									cDTO.children.addItem( ccDTO );
								}
							}
						}
						if( add )
							pDTO.children.addItem( cDTO );
					}
					dummy.addItem( pDTO );
				}
				
				return dummy;
			}

		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<!--<s:SkinnableContainer skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.physicalTreeBG" width="100%">
	<s:layout>
		<s:HorizontalLayout horizontalAlign="center" paddingLeft="3" paddingRight="3" paddingBottom="3" />				
	</s:layout>	-->
	
	<components1:ListTree id="id_TreeList"  width="100%" DataProvider="{m_acDataProvider}" MaxRows="11"
						 itemRenderer="{new ClassFactory( PhysicalMainCatRenderer )}" 
						 childItemRenderer="{new ClassFactory( PhysicalSubCatRenderer )}" 
						 footerItemRenderer="{new ClassFactory( PhysicalFooterRenderer )}"
						 itemClick="treelist1_ItemClickEventHandler(event)" 
						 footerClick="treelist1_footerClickHandler(event)"
						 skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.QIPhysicalBG"
						 creationComplete="id_TreeList_creationCompleteHandler(event)"
						 />

	<!--</s:SkinnableContainer>-->
	
</s:Group>
