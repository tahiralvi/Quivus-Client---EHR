<?xml version="1.0" encoding="utf-8"?>
<components1:CollapsiblePanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
							 xmlns:s="library://ns.adobe.com/flex/spark" 
							 title="Family Histroy" skinClass="com.adobe.quivus.skins.chrome.containerSkins.checkboxCollapsiblePanelSkin" 
							 xmlns:mx="library://ns.adobe.com/flex/mx" 
							 xmlns:components="com.zigron.controls.extended.components.*" xmlns:components1="com.gazuntite.controls.extended.components.*">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			[Bindable]
			private var model:AppModelLocator = AppModelLocator.getInstance();
			
			
			[Bindable]
			override public function set isSelected(value:Boolean):void
			{
				super.isSelected = value;
				
				model.reviewHistroy.IsFamilyReviewed = value;
			}
			
			
		]]>
	</fx:Script>
	<components:layout>
		<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5"/>
	</components:layout>
	<components1:LabelDataGrid id="id_FamilyHistroy" horizontalScrollPolicy="off" verticalScrollPolicy="on" width="100%" maxHeight="150"
							  rowCount="{id_FamilyHistroy.dataProvider.length?id_FamilyHistroy.dataProvider.length:1}"
							  columnWidths="{['20%','30%','30%','20%']}" verticalGridLines="false" dataProvider="{model.familyHistoryDTOListByPatient}"
							  >
		<components:columns>
			<mx:DataGridColumn  headerText="Disease" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" dataField="IcdCodeDescription"/>
			<mx:DataGridColumn 	headerText="Disease Type" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" dataField="FamilyHistoryTypeName"/>
			<mx:DataGridColumn  headerText="Relation"  dataField="ReletionshipTypeName" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label"/>
			<mx:DataGridColumn  headerText="Notes"  dataField="FamilyHistoryNote" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label"/>
		</components:columns>
	</components1:LabelDataGrid>
</components1:CollapsiblePanel>

