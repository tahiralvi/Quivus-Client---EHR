	<fx:Declarations>
		<mx:DateFormatter id="formatDateTime" formatString="MM/DD/YY" />
	</fx:Declarations>
	<fx:Binding source="model.quickInputDataLoadedFlag" destination="IsModelUpdated" /> 
	<fx:Binding source="id_HistoryView.id_GeneralSection.hasChange" destination="hasChange" /> 
	<fx:Binding source="id_HistoryView.id_FamilySection.hasChange" destination="hasChange"  /> 
	<fx:Binding source="id_HistoryView.id_SocialSection.hasChange" destination="hasChange"  /> 
	<fx:Binding source="model.medicalHistoryDTOListByPatient"     destination="collectionChange"  /> 
	<fx:Binding source="model.familyHistoryDTOListByPatient"     destination="collectionChange"  /> 
	<fx:Binding source="model.socialHistoryDTOListByPatient"     destination="collectionChange"  /> 
	
	
	
	<custom:HeaderContents>
		<s:Group width="100%" height="24" minWidth="{ChromeUtil.topLevelMainContainer.width - 70}">
			<s:layout>
				<s:VerticalLayout verticalAlign="bottom"  />
			</s:layout>
			<comprehensiveHistory:QIHistoryHeader id="id_Header" minWidth="500" width="100%" height="22" HeadingLable="Comprehensive History" showSaveButton="false" />
		</s:Group>
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		
		<quickInput:QISectionSlideoutHeader width="100%" label="{id_Header.HeadingLable}" />		   
		
	</custom:SlideHeaderContents>
	<custom:Contents>
		<s:VGroup width="{id_Header.width}" verticalAlign="top" gap="0" 
				  horizontalAlign="{isSlideOut? 'right':'center'}" paddingTop="{isSlideOut? -2:0}" paddingLeft="{isSlideOut? 1:1}">
			
			
			<notes:QISectionLevelNotesDictation id="id_notesDictation" width="100%" />
			
			<s:SkinnableContainer id="id_mainGroup" skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.QISectionBGSkin" height="100%"  width="{id_Header.width}"
								  visible="{model.securityProxyObject.PatientExam.QuickInput.PMH.ComprehensiveHistory.IsViewAllowed}" includeInLayout="{id_mainGroup.visible}">
				
				<s:layout>
					<s:VerticalLayout gap="3" horizontalAlign="right"  paddingLeft="3" paddingRight="5" paddingTop="5" paddingBottom="5"/>
				</s:layout>
				
				<history:HistoryView id="id_HistoryView" width="100%" visible="false" includeInLayout="false" enabled="false" />
				
				<s:HGroup width="100%">					
					<s:HGroup id="id_IndicatorGrp" width="100%" horizontalAlign="left" >
						
						<s:Button id="id_noteIndicator" label="Notes" visible="false" includeInLayout="{id_noteIndicator.visible}"
								  click="id_noteIndicator_clickHandler(event)" toolTip="View Notes" 
								  useHandCursor="true" buttonMode="true" 
								  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.notesIndicatorBtnSkin" />
						
						<s:Button id="id_dictationIndicator" label="Dictation" visible="false" includeInLayout="{id_dictationIndicator.visible}"
								  click="id_dictationIndicator_clickHandler(event)" toolTip="Play Dictation" 
								  useHandCursor="true" buttonMode="true" 
								  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.dictationIndicatorBtnSkin"/>
					</s:HGroup>
					
					<s:Group id="id_spacer" width="100%" height="2" />
					
					
					<s:Button id="id_AddMoreBtn" label="Add More" click="id_AddMoreBtn_clickHandler()" 
							  skinClass="com.adobe.quivus.skins.chrome.toggleButtonSkins.addMoreButton"
							  buttonMode="true" useHandCursor="true" toolTip="Add Comprehensive History" width="80"/>
					
					<s:Button label="Next" click="button1_clickHandler(event)" 
							  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.QInextBtnSkin" toolTip="Next Section" buttonMode="true" />
				</s:HGroup>
				<chCombined:QICombinedHistoryView  id="id_contents" width="100%" height="100%" creationComplete="id_contents_creationCompleteHandler(event)"/>
			</s:SkinnableContainer>
			<!--</s:BorderContainer>-->
			<!--</s:SkinnableContainer>-->
		</s:VGroup>
		
	</custom:Contents>
</custom:PinableSlideOutPanel>
