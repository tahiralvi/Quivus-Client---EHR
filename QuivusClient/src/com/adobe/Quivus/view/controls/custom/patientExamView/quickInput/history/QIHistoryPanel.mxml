			protected function id_contents_creationCompleteHandler(event:FlexEvent):void
			{
				id_contents.id_TabBar2.setStyle('skinClass', QIrecordingsTabBar);
				id_contents.id_VS.setStyle('skinClass', planPanel);
				
				//change the call with respective page set with default values;
				if( UtilityFunctions.IsNullOrEmpty( model.medicalHistoryCurrentPageByPatient ) )
				{
					model.medicalHistoryCurrentPageByPatient = new PageDTO();
				}
				
				if( UtilityFunctions.IsNullOrEmpty( model.familyHistoryCurrentPageByPatient ) )
				{
					model.familyHistoryCurrentPageByPatient = new PageDTO();
				}
				
				if( UtilityFunctions.IsNullOrEmpty( model.socialHistoryCurrentPageByPatient ) )
				{
					model.socialHistoryCurrentPageByPatient = new PageDTO();
				}
				
				LoadCHData();
				id_Header.id_SpinerList.enabled = false;
			}
			
			private function LoadCHData():void
			{
				QSUtilityFunctions.CheckUserPageOrSetPageToZero( model.medicalHistoryCurrentPageByPatient );
				QSUtilityFunctions.CheckUserPageOrSetPageToZero( model.familyHistoryCurrentPageByPatient );
				QSUtilityFunctions.CheckUserPageOrSetPageToZero( model.socialHistoryCurrentPageByPatient );
				
				QuivusCombineEventDispatcher.loadComprehensiveHistoryForVB();
			}
			
			private function ReLoadCHData():void
			{
				LoadCHData();
			}
			
