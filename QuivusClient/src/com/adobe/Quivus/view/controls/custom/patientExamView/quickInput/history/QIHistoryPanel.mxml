			//Tahir Alvi - 16 june, 2012
			private function saveComprehensiveHistory():void
			{
				var evt:SaveMedicalHistoryEvent = new SaveMedicalHistoryEvent( model.quickInputDTO.PatientId, model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq, model.medicalHistoryList, clearComprehensiveHistory );
				CairngormEventDispatcher.getInstance().dispatchEvent( evt );
			}
			
			private function clearComprehensiveHistory():void
			{
				id_HistoryView.clearMedicalHistory();
				id_HistoryView.clearFamilyHistory();
				id_HistoryView.clearSocialHistory();
				
				id_HistoryView.id_GeneralSection.hasChange = false;
				id_HistoryView.id_FamilySection.hasChange = false;
				id_HistoryView.id_SocialSection.hasChange = false;
				
				if(model.isQISocHistorySave)
					addNewHistoryView();
				
				ReLoadCHData();
			}
			private function addNewSocialHistory():void
			{
				id_HistoryView.removeElement( id_HistoryView.id_SocialSection );
				
				id_HistoryView 					= new HistoryView();
				id_HistoryView.percentWidth		= 100;
				id_HistoryView.visible			= false;
				id_HistoryView.includeInLayout	= false;
				id_HistoryView.enabled			= false;
				
				id_mainGroup.addElementAt( id_HistoryView, 0 );
				
				id_AddMoreBtn.label				= 'Add More';
				id_AddMoreBtn.toolTip			= "Add More";
				id_AddMoreBtn.width				= 80;
				
				id_HistoryView.showOnlySection( 0 );//show all section
			}
			
