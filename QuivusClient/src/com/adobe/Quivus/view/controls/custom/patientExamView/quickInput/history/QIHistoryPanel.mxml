			//Call later - First close the dropdown and then show alert.
			private function showAlert():void
			{
				Alert.show('Record already exists against this visit', 'Please select another date');
				id_HistoryView.enabled = false;
			}
			//If QIHistorypanel Load in Edit mode 
			private function setViewForEditMode():void
			{
				//				id_AssociateVisitzCombo.visible = false;
				//				id_VisitDatesCombo.visible = false;
				
				id_HistoryView.enabled = true;
				id_HistoryView.visible = true;
				id_HistoryView.includeInLayout = true;
				id_Header.id_SpinerList.enabled = true;
				id_AddMoreBtn.label 	= 'Close';
				id_AddMoreBtn.toolTip 	= "Close";
				id_AddMoreBtn.width		= 60;
				
			}
			
			
			protected function pinableslideoutpanel1_QSSlideStateChangeHandler(event:QSViewStateEvent):void
			{
				if(this.isSlideOut)
				{
					//id_Header.id_pmhHeader.setStyle("skinClass", QIinternalBarBorderSkin);										
					/* id_AllergiesGrid.rowHeight = 23;
					id_AllergiesGrid.headerHeight = 25; */
					
				}
			}
			// on Save Social create new Histoy complete view
			private function addNewHistoryView():void
			{
				id_mainGroup.removeElement( id_HistoryView );
				
				id_HistoryView 					= new HistoryView();
				id_HistoryView.percentWidth		= 100;
				id_HistoryView.visible			= false;
				id_HistoryView.includeInLayout	= false;
				id_HistoryView.enabled			= false;
				
				id_mainGroup.addElementAt( id_HistoryView, 0 );
				
				id_AddMoreBtn.label				= 'Add More';
				id_AddMoreBtn.toolTip			= "Add More";
				id_AddMoreBtn.width				= 80;
				
				id_HistoryView.showOnlySection( 0 );//show all section
				model.isQISocHistorySave = false;
			}
			
			[Bindable]
			public function get collectionChange():ArrayCollection
			{
				return _collectionChange;
			}
			
			public function set collectionChange(value:ArrayCollection):void
			{
				_collectionChange = value;
				if(model.medicalHistoryDTOListByPatient && model.medicalHistoryDTOListByPatient.length >0)
					hasChange = true;
				if(model.familyHistoryDTOListByPatient && model.familyHistoryDTOListByPatient.length >0)
					hasChange = true;
				if(model.socialHistoryDTOListByPatient && model.socialHistoryDTOListByPatient.length >0)
					hasChange = true;
			}
			
			
			private var _collectionChange:ArrayCollection
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				AllowMoveToNextPanel ( dispactchSelectSectionEvent );
				
			}
			
			public override function AllowMoveToNextPanel( callBack:Function ):void
			{
				if( id_HistoryView.id_GeneralSection.hasChange || id_HistoryView.id_FamilySection.hasChange || id_HistoryView.id_SocialSection.hasChange )
				{
					UtilityFunctions.AskMessage( "There are changes in the form, do you still want to leave form in current state?", function ():void
					{
						callBack(); 
					}); 
				}
				else
				{
					callBack();
				}
			}
			
			private function dispactchSelectSectionEvent():void
			{
				dispatchEvent( new SelectSection('SelectSection','id_QIHistoryPanel', true, true) )
			}
			
			
