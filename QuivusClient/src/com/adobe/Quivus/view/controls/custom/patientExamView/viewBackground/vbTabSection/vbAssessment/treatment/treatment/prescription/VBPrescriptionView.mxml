			public var securityHeaderXML:XML;
			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				securityHeaderXML	 			= <Header />;					
				securityHeaderXML.@EUserName	= "TESTUSER";
				securityHeaderXML.@EPassword	= "TESTPASS";
				securityHeaderXML.@ClinicID		= "sad";
			}
			//Tahir Alvi  - oct 25 
			private function getVisitDate(item:Object, iCol:int):String
			{
				var result:String = '';
				if(item.VisitDate)
					result = item.VisitDate;
				
				if(result == '01/01/1901' || result == '02/01/1901')
					result = 'N/A';
				
				return result;
			}
			//Tahir Alvi  - sep19 
			private function getRefillData(item:Object, iCol:int):String
			{
				var result:String;
				if(item.Refill)
					result = item.Refill;
				
				if(item.isPRN)
					result = item.isPRN;
				
				if(result.toLowerCase() == 'true')
					result = 'AS NEEDED';
				else if(item.Refill)
					result = item.Refill;
				return result;
			}
			
