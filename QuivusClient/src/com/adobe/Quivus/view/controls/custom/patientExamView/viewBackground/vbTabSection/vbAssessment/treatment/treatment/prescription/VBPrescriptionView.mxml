			public function GridRowNumber(item:Object, iCol:int):String
			{
				var strRowNum:String = "";
				
				if (id_DataGrid_inactive.dataProvider)
				{
					var rowNum:int = id_DataGrid_inactive.dataProvider.getItemIndex(item) + 1;
					strRowNum = String(rowNum);
				}
				
				return strRowNum;
			}
			public function medicineStrengthLabel(item:Object, iCol:int):String
			{
				var genName:String = "";
				var brnName:String = "";
				var strName:String = "";
				
				
				if (item.hasOwnProperty("GenericName"))
				{
					genName = item.GenericName ;
				}
				if (item.hasOwnProperty("Strength"))
				{
					strName = item.Strength;
				}
				if (item.hasOwnProperty("BrandName"))
				{
					brnName = item.BrandName;
				}
				
				return brnName +' ' + strName +' ('+genName+')';
				
			}
			
			public function prescriptionGridRowNumber(item:Object, iCol:int):String
			{
				var strRowNum:String = "";
				
				if (id_DataGrid.dataProvider)
				{
					var rowNum:int = id_DataGrid.dataProvider.getItemIndex(item) + 1;
					strRowNum = String(rowNum);
				}
				
				return strRowNum;
			}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				/* var mpiEvent : ManagePatientImmunizationEvent = new ManagePatientImmunizationEvent(  );
				CairngormEventDispatcher.getInstance().dispatchEvent( mpiEvent ); */
				if(model.prescriptionMedicationDTOList!=null){
					model.prescriptionMedicationDTOList.filterFunction=myFilter;
					model.prescriptionMedicationDTOList.refresh();
				}
			}
			
			private function myFilter(obj:*):Boolean
			{
				
				if(model.vbFilter == Constants.BY_VISIT)
				{
					if(model.vbVisitId == obj.VisitID)
					{
						return true;
					}
					else
					{
						return false;
					}
				}
				
				return true;
				
			}
			
			//////
			private function switchPageForGridView(event:*):void
			{
				
				if( UtilityFunctions.IsNullOrEmpty( model.prescriptionCurrentPageByPatient ) )
					model.prescriptionCurrentPageByPatient = new PageDTO();
				
				var pvital:PageDTO 		= model.prescriptionCurrentPageByPatient;
				pvital.fromDate 		= model.defaultFilterAndPaging.fromDate;
				pvital.toDate 			= model.defaultFilterAndPaging.toDate;
				pvital.pageSize 		= model.defaultFilterAndPaging.pageSize;
				pvital.LastVisitNumber 	= model.defaultFilterAndPaging.LastVisitNumber;
				
				var lpviEvent: LoadPatientPrescriptionByPatientIdEvent = new LoadPatientPrescriptionByPatientIdEvent(); 
				CairngormEventDispatcher.getInstance().dispatchEvent( lpviEvent );
			}
			
			protected function id_PaginationFilterView_RefreshViewHandler(event:Event):void
			{
				var lpviEvent: LoadPatientPrescriptionByPatientIdEvent = new LoadPatientPrescriptionByPatientIdEvent(); 
				CairngormEventDispatcher.getInstance().dispatchEvent( lpviEvent );
			}
			
