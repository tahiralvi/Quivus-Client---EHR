	<s:layout>
		<s:VerticalLayout gap="-1" />
	</s:layout>
	
	
	<s:Button label="Filter" click="button1_clickHandler(event)" visible="false" includeInLayout="false" id="id_applyFiler"/>
	<paging:PaginationFilterView id="id_PaginationFilterView" width="100%" Page="{model.prescriptionCurrentPageByPatient}"
								 ShowFilterControls="false"
								 GoToFirstPage="switchPageForGridView(event)" GoToNextPage="switchPageForGridView(event)" 
								 GoToPreviousPage="switchPageForGridView(event)" GoToLastPage="switchPageForGridView(event)"
								 RefreshView="id_PaginationFilterView_RefreshViewHandler(event)"
								 visible="false" includeInLayout="false"/>
	<s:Spacer height="6" />
	<s:VGroup width="100%" gap="-4">
		
		
		
		<s:ButtonBar id="id_b1" dataProvider="{viewStack}" styleName="blackButtonBarSkin" buttonMode="true" useHandCursor="true">
			<s:layout>
				<s:ButtonBarHorizontalLayout gap="2" />
			</s:layout>
		</s:ButtonBar>
		
		<mx:ViewStack id="viewStack"  width="100%"  height="100%" top="10" creationPolicy="all"  resizeToContent="true" >
			<mx:VBox label="Active Medication" width="100%" >
				
				<mx:DataGrid id="id_DataGrid" 
							 dataProvider="{model.patientMedACList}"
							 width="100%" useRollOver="false"  verticalScrollBarStyleName="VScrollBar"
							 rowCount="{id_DataGrid.dataProvider.length + 1}" 
							 maxHeight="150" 
							 verticalScrollPolicy="on">
					<mx:columns>
						<mx:DataGridColumn headerText="Sr.#" width="30" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="prescriptionGridRowNumber"/>
						<mx:DataGridColumn headerText="Visit Date"  labelFunction="getVisitDate" width="90" dataField="VisitDate" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" />
						<mx:DataGridColumn headerText="Med"  width="90" dataField="drugName" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" />
						<mx:DataGridColumn headerText="Sig" dataField="Sig" width="100"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
						<mx:DataGridColumn headerText="Qty, Qty Form" width="80" dataField="Quantity" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" />
						<mx:DataGridColumn headerText="No. of Refills" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" width="100" labelFunction="getRefillData" />
						<mx:DataGridColumn headerText="Frequency" dataField="frequency" width="70" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
						<mx:DataGridColumn headerText="Route" dataField="Route" width="70" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
						
					</mx:columns>
				</mx:DataGrid>
			</mx:VBox>
			<mx:VBox label="History" width="100%"  >
				<components1:LabelDataGrid id="id_DataGrid_inactive" 
										  dataProvider="{model.patientMedAC_inactiveList}"
										  verticalScrollPolicy="on"
										  width="100%" useRollOver="false"  verticalScrollBarStyleName="VScrollBar"
										  rowCount="{id_DataGrid.dataProvider.length + 1}" 
										  maxHeight="150" 
										  columnWidths="{['5%','10%','15%','25%','15%','15%','15%']}">
					<components1:columns>								
						<mx:DataGridColumn headerText="Sr.#"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" labelFunction="GridRowNumber"/>
						<mx:DataGridColumn headerText="Visit Date" labelFunction="getVisitDate"  dataField="VisitDate" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" />
						<mx:DataGridColumn headerText="Med"   dataField="drugName" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" />
						<mx:DataGridColumn headerText="Sig" dataField="Sig"   itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
						<mx:DataGridColumn headerText="Qty, Qty Form"  dataField="Quantity" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" />
						<mx:DataGridColumn headerText="No. of Refills" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"   labelFunction="getRefillData" />
						<mx:DataGridColumn headerText="Frequency" dataField="frequency"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
						<mx:DataGridColumn headerText="Route" dataField="Route"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
						<!--<mx:DataGridColumn headerText="">
							<mx:itemRenderer>
								<fx:Component>	
									<mx:HBox buttonMode="true" useHandCursor="true" width="60" paddingBottom="2" horizontalAlign="center" verticalAlign="middle">
