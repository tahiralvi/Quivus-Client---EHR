									</mx:HBox>
								</fx:Component>
							</mx:itemRenderer>
						</mx:DataGridColumn>-->
					</components1:columns>
				</components1:LabelDataGrid>
			</mx:VBox>
		</mx:ViewStack>
	</s:VGroup>
</s:Group>
