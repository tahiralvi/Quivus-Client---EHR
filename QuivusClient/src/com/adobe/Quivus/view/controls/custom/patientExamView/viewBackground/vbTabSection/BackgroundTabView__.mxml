			protected function id_VBViews_changeHandler(event:IndexChangedEvent):void
			{
				switch(event.oldIndex)
				{
					case 0:
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.VB_COMPREHENSIVE_HISTORY);
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.VB_IMMUNIZATION);
						break;
					
					case 1:
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.VB_HPI_CC);
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.VB_ROS);
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.VB_PHYSICAL);
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.VB_IN_HOUSE_LAB);
						break;
					
					case 2:
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.VB_DIAGNOSIS);
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.VB_PROCEDURE);
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.VB_LAB_OUT);
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.VB_RECOMMENDATION);
						QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.VB_FOLLOW_UP_INSTRUCTIONS);
						break;
				}
			}
			
			
			
