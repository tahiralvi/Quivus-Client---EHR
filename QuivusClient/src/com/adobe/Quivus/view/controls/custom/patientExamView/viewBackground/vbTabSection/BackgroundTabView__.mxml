			protected function id_PMHView_selectSectionHandler(event:SelectSection):void
			{
				var sectionId:String = event.SectionID;
				
				switch( sectionId )
				{
					case "id_allergiesBtn":
						showAllergiesPanel();
						break;
					case "id_medicalHXBtn":	
					case "id_historyBtn":	
						showMedicalHXPanel();						
						//showSocialHistoryPanel();						
						break;
					case "id_medicationBtn":	
						showMedicationPanel();
						break;
					case "id_immunizationBtn":	
						showImmunizationPanel();						
						break;
					case "id_vitalsBtn":	
						showVitalsPanel();						
						break;
					case "id_hpiBtn":	
						showHpiPanel();						
						break;
					case "id_rosBtn":	
						showROSPanel();
						break;
					case "id_physicalBtn":	
						showPhysicalPanel();
						break;
					case "id_labBtn":	
						showLabPanel();
						break;
					case "id_diagnosisBtn":	
						showDiagnosisPanel();
						break;
					case "id_prescriptionBtn":	
						showPrescriptionPanel();
						break;
					case "id_treatmentBtn":	
						showTreatmentPanel();
						break;
					case "id_planBtn":	
						showPlanPanel();
						break;
					case "id_followUpBtn":	
						showFollowUpPanel();
						break;
				}
			}
			
