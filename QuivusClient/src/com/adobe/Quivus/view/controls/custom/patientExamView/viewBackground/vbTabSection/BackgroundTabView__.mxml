			private function isNullOrEmptyPage(Page:PageDTO):Boolean
			{
				var retValue:Boolean;
				if( UtilityFunctions.IsNullOrEmpty( Page ) )
				{
					retValue = true;
				}
				else
				{
					if( UtilityFunctions.IsNullOrEmpty( Page.pageSize ) )
					{
						retValue = true;
					}
					else 
					{
						if( ! isValidVisitRangeProvided(Page) && ! isValidDateRangeProvided(Page))
						{
							retValue = true;
						}
					}
					
				}
				
				return retValue;
			}
			
			private function isValidDateRangeProvided(Page:PageDTO):Boolean
			{
				if( UtilityFunctions.IsNullOrEmpty( Page.fromDate ) || UtilityFunctions.IsNullOrEmpty( Page.toDate ) )
				{
					return false;
				}
				
				return true;
			}
			
			private function isValidVisitRangeProvided(Page:PageDTO):Boolean
			{
				if( UtilityFunctions.IsNullOrEmpty( Page.LastVisitNumber ) )
				{
					return false;
				}
				
				return true;
			}
			
			private function getFollowUpLabel(item:Object):String
			{
				var index:int = model.patientFollowupInstructionDTOListByPatient.getItemIndex(item);
				var lbl:String;
				if(index == 0)
				{
					lbl = "Upcoming";
				}
				else
				{
					lbl = "Next";
				}
				
				return lbl;
				
				//model.patientFollowupInstructionDTOListByPatient.sort = new Sort()
				
			}
			
			private function getFollowUpSortedList():void
			{
				var sort:Sort = new Sort();
				sort.compareFunction = sortFunction;
				model.patientFollowupInstructionDTOListByPatient.sort = sort;
				model.patientFollowupInstructionDTOListByPatient.refresh();
			}
			private function sortFunction(a:Object, b:Object, array:Array = null):int
			{
				if(a.dateUTC == b.dateUTC)
					//throw new Error("Invalid value for criticality ");
					return 0;
				/* if(aLevel == bLevel)
				return 0; */				
				if(a.dateUTC > b.dateUTC)
					return 1;
				
				return -1;
			}
			
			private var _diagnosisCollection:ArrayCollection = new ArrayCollection();
			[Bindable]
			public function get diagnosisCollection():ArrayCollection
			{
				return _diagnosisCollection;	
			}
			
			public function set diagnosisCollection(value:ArrayCollection):void
			{
				//_diagnosisCollection.addAll(value);
				_diagnosisCollection.removeAll();
				
				if( model.patientDiagnosisDTOAcuteListByPatientId)
					_diagnosisCollection.addAll(model.patientDiagnosisDTOAcuteListByPatientId);
				if( model.patientDiagnosisDTOChronicListByPatientId)
					_diagnosisCollection.addAll(model.patientDiagnosisDTOChronicListByPatientId);
				if( model.patientDiagnosisDTOResolvedListByPatientId)
					_diagnosisCollection.addAll(model.patientDiagnosisDTOResolvedListByPatientId);
				
			}
			
