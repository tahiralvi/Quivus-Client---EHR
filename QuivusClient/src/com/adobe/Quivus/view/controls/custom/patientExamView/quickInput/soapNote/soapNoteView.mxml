<?xml version="1.0" encoding="utf-8"?>
<components1:PopupWindow xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:custom="com.adobe.Quivus.view.controls.custom.*" 
					  xmlns:components="com.zigron.controls.extended.components.*" 
					  xmlns:buttonSeparators="com.adobe.Quivus.view.controls.skins.buttonSeparators.*"
					  skinClass="com.adobe.Quivus.view.controls.skins.titleWindowSkins.reviewAllWindowSkin"
					  
					  creationComplete="slideoutpanel1_creationCompleteHandler(event)" xmlns:components1="com.gazuntite.controls.extended.components.*"
					  
					   >
	
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.events.quickInput.ManageQuickInputEvent;
			import com.adobe.Quivus.events.visit.UpdateVisitEvent;
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.utils.Constants;
			import com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.signCoSign.popUps.AuthenticationPopUp;
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			
			import mx.binding.utils.BindingUtils;
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			import mx.managers.CursorManager;
			
			public static const REVIEW_ALL:String = "reviewAll";
			public static const SIGN_COSIGN:String = "signCoSign";
			public static const SAVE_AND_REVIEW:String = "saveAndReview";
			public static const REVIEW_AND_PRINT:String = "reviewAndPrint";
			
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			private var callback:Function;
			private var statusCallback:Function;
			private var authenticationPopUp:AuthenticationPopUp;
			private var previewWindowType:String;
			private var m_sSoapNoteText:String = "loading...";
			private var m_sSoapNoteURL:String;
			
			[Bindable]
			public function get SoapNoteText():String
			{
				return m_sSoapNoteText;
			}

			public function set SoapNoteText(value:String):void
			{
				m_sSoapNoteText = value;
			}

			[Bindable]
			public function get SoapNoteURL():String
			{
				return m_sSoapNoteURL;
			}
			
			public function set SoapNoteURL(value:String):void
			{
				m_sSoapNoteURL = value;
				id_htmlArea.location = value;
			}

			protected function slideoutpanel1_creationCompleteHandler(event:FlexEvent):void
			{
				m_sSoapNoteText = "<b>Loading...</b>";
			}
			
			public function show(value:String = "", arg_callback:Function = null, status_callback:Function = null):void
			{
				this.previewWindowType = value;
				
				ShowPopup( FlexGlobals.topLevelApplication.mainContainer );
				
				switch(value)
				{
					case REVIEW_ALL:
						this.title = "Patient History for Review";
						this.okBtn.label = "OK";
						this.okBtn.visible = false;
						this.cancelBtn.label = "Close";
						break;
					
					case SIGN_COSIGN:
						this.title = "Final Review";
						this.okBtn.label = model.signCoSignBtnLabel;
						break;
					
					case SAVE_AND_REVIEW:
						this.title = "Final Review";
						this.okBtn.label = "Save";
						break;
					case REVIEW_AND_PRINT:
						this.title = "Review and Print";
						this.okBtn.label = "OK";
						this.okBtn.visible = false;
						this.cancelBtn.label = "Close";
						break;
				}
				
				callback = arg_callback;
				statusCallback = status_callback
			}
			
			protected function id_htmlArea_completeHandler(event:Event):void
			{
				CursorManager.removeBusyCursor();
				id_htmlArea.htmlLoader.navigateInSystemBrowser = true;
			}
			
			private function refreshModel():void
			{
				if (model.quickInputDTO)
				{
					if (model.quickInputDTO.PMH)
					{
						if (model.quickInputDTO.PMH.Immunization)
						{
							model.quickInputDTO.PMH.Immunization.filterFunction = null;
							model.quickInputDTO.PMH.Immunization.refresh();
						}
					}
					
					if (model.quickInputDTO.Physical)
					{
						if (model.quickInputDTO.Physical.HPI_CC)
						{
							model.quickInputDTO.Physical.HPI_CC.filterFunction = null;
							model.quickInputDTO.Physical.HPI_CC.refresh();
						}
						
						if (model.quickInputDTO.Physical.InHouseLabs)
						{
							model.quickInputDTO.Physical.InHouseLabs.filterFunction = null;
							model.quickInputDTO.Physical.InHouseLabs.refresh();
						}
						
						if (model.quickInputDTO.Physical.Labs)
						{
							model.quickInputDTO.Physical.Labs.filterFunction = null;
							model.quickInputDTO.Physical.Labs.refresh();
						}
					}
					
					if (model.quickInputDTO.Assessment)
					{
						if (model.quickInputDTO.Assessment.Diagnosis)
						{
							model.quickInputDTO.Assessment.Diagnosis.filterFunction = null;
							model.quickInputDTO.Assessment.Diagnosis.refresh();
						}
						
						if (model.quickInputDTO.Assessment.Procedure)
						{
							model.quickInputDTO.Assessment.Procedure.filterFunction = null;
							model.quickInputDTO.Assessment.Procedure.refresh();
						}
						
						if (model.quickInputDTO.Assessment.Recommendation)
						{
							model.quickInputDTO.Assessment.Recommendation.filterFunction = null;
							model.quickInputDTO.Assessment.Recommendation.refresh();
						}
						
						if (model.quickInputDTO.Assessment.PatientFollowupInstruction)
						{
							model.quickInputDTO.Assessment.PatientFollowupInstruction.filterFunction = null;
							model.quickInputDTO.Assessment.PatientFollowupInstruction.refresh();
						}
					}
				}
			}
			
			private function okBtnClickHandler():void
			{
				refreshModel();
				var statusMessage:String = "Please wait while ";
				switch(previewWindowType)
				{
					case SIGN_COSIGN:
						if (!authenticationPopUp)
							authenticationPopUp = new AuthenticationPopUp();
						
						if (model.visitDTO)
							authenticationPopUp.visitID = model.visitDTO.VisitId;
						
						authenticationPopUp.signBtnLabel = model.signCoSignBtnLabel;
						authenticationPopUp.originName = Constants.QUICK_INPUT_MODULE_NAME;
						authenticationPopUp.onVisitSignCosignCallback = onSucessfullVisitSave;
						authenticationPopUp.ShowPopup(this);
						
						statusMessage = statusMessage + "sign / co-sign visit."
						
						break;
					
					case REVIEW_ALL:
						
						statusMessage = statusMessage + "saving visit data."
						break;
					
					case SAVE_AND_REVIEW:
						var MVDEvent:ManageQuickInputEvent = new ManageQuickInputEvent( true);
						MVDEvent.functionName = onSucessfullVisitSave;
						CairngormEventDispatcher.getInstance().dispatchEvent( MVDEvent );
						
						var uvEvent:UpdateVisitEvent = new UpdateVisitEvent(  );
						CairngormEventDispatcher.getInstance().dispatchEvent( uvEvent );
						
						statusMessage = statusMessage + "saving visit data."
						
						break;
				}
				if( statusCallback() != null )
					statusCallback( statusMessage );
			}
			
			private function cancelBtnClickHandler():void
			{
				hide();
			}
			
			public function hide(doClose:Boolean = false, actionName:String = "", visitID:int = 0):void
			{
				removePopup();
				
				if (null != callback && doClose)
					callback(actionName, visitID);
			}
			
			private function onSucessfullVisitSave(actionName:String = "", visitID:int = 0):void
			{
				hide(true, actionName, visitID);
			}
			
			public function printBtnClickHandler():void
			{
				
			}

		]]>
		
		
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	<s:VGroup gap="2" height="{Capabilities.screenResolutionY - 130}" width="{(Capabilities.screenResolutionX / 2) - 30 }" verticalAlign="top" horizontalAlign="center" paddingLeft="5" >
		
		<!--<s:BorderContainer height="452" width="100%" cornerRadius="3" backgroundColor="#999AAA" 
						   borderWeight="4" borderAlpha="1" borderColor="#999AAA" borderVisible="true" >
			<s:layout>
				<s:HorizontalLayout paddingTop="0" verticalAlign="middle" horizontalAlign="center" paddingBottom="5"  />
			</s:layout>
		-->	
			<mx:HTML id="id_htmlArea" htmlText="{SoapNoteText}" height="{Capabilities.screenResolutionY - 175}" width="{(Capabilities.screenResolutionX / 2) - 50}" complete="id_htmlArea_completeHandler(event)" x="2"/>
			
		
		<s:VGroup verticalAlign="bottom" horizontalAlign="center" paddingBottom="0" width="100%">	
			<s:HGroup horizontalAlign="center" width="100%">
				<s:Button id="okBtn" click="okBtnClickHandler()" label="OK" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.OKBtnSkin" useHandCursor="true" buttonMode="true"/>
				<s:Button id="cancelBtn" click="cancelBtnClickHandler()" label="Cancel" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.OKBtnSkin" useHandCursor="true" buttonMode="true"/>
				<!--<s:Button id="printBtn" click="printBtnClickHandler()" label="Print" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.OKBtnSkin" useHandCursor="true" buttonMode="true"/>-->
			</s:HGroup>
		</s:VGroup>
	</s:VGroup>
</components1:PopupWindow>
		
