			private var StatusWindow:PopupWindow ;
			
			
			public function ShowStatusWindow(statusMessage :String ):void
			{
				StatusWindow = UtilityFunctions.ShowStatusMessage( statusMessage, this );
			}
			
			public function RemoveStatusWindow():void
			{
				if( StatusWindow )
					StatusWindow.removePopup();
				
				StatusWindow = null;
			}
			
			
			public static function refreshPatientVisitList():void
			{
				var model:AppModelLocator = AppModelLocator.getInstance();
				var lpvEvent:LoadPatientVisitListEvent = new LoadPatientVisitListEvent(model.loadedPatientId, false );
				CairngormEventDispatcher.getInstance().dispatchEvent( lpvEvent );
			}
			
			private function onVisitSignCosignSuccess(actionName:String = "", visitID:int = 0):void
			{
				switch (actionName)
				{
					case Constants.VISIT_SIGNE:
						var signEv:PatientVisitEvent = new PatientVisitEvent(PatientVisitEvent.PATIENT_VISIT_SIGNED, true);
						signEv.visitId = visitID;
						dispatchEvent(signEv);
						break;
					
					case Constants.VISIT_COSIGNED:
						var cosignEv:PatientVisitEvent = new PatientVisitEvent(PatientVisitEvent.PATIENT_VISIT_COSIGNED, true);
						cosignEv.visitId = visitID;
						dispatchEvent(cosignEv);
						break;
				}
				
				refreshPatientVisitList();
			}
			public function PrescriptionLoaded(patientMedAC:ArrayCollection, patientChronicMedAC:ArrayCollection, patientMedAC_inactive:ArrayCollection, patientChronicMedAC_inactive:ArrayCollection):void
			{
				if(model.patientMedACList)
					model.patientMedACList.removeAll();
				else
					model.patientMedACList = new ArrayCollection();
				
				if(model.patientMedAC_inactiveList)
					model.patientMedAC_inactiveList.removeAll();
				else
					model.patientMedAC_inactiveList = new ArrayCollection();
				
				if(model.patientChronicMedAC_inactiveList)
					model.patientChronicMedAC_inactiveList.removeAll();
				else
					model.patientChronicMedAC_inactiveList = new ArrayCollection();
				
				if(model.patientChronicMedACList)
					model.patientChronicMedACList.removeAll();
				else
					model.patientChronicMedACList = new ArrayCollection();
				
				model.patientMedACList 						= patientMedAC;//prescription list
				model.patientChronicMedACList 				= patientChronicMedAC;//medication list
				model.patientMedAC_inactiveList			 	= patientMedAC_inactive;
				model.patientChronicMedAC_inactiveList	 	= patientChronicMedAC_inactive;
				
				//For QI load
				if(model.chMedicationDTOList)
					model.chMedicationDTOList.removeAll();
				else
					model.chMedicationDTOList = new ArrayCollection();
				
				if(model.prescriptionDToList)
					model.prescriptionDToList.removeAll();
				else
					model.prescriptionDToList = new ArrayCollection();
				
				model.chMedicationDTOList = patientChronicMedAC;
				model.prescriptionDToList = patientMedAC;
			}
			
			protected function PatientEncounterGrid_clickHandler(event:MouseEvent):void
			{
				//return;
				if( event.target is Button )
				{
					//Alert.show( event.target.id );
					var peDTO:PatientEncounterDTO = id_PatientEncounterGrid.selectedItem as PatientEncounterDTO;
					
					switch(  event.target.id )
					{
						case "id_Sign":
							if( QSSecurityUtil.Security.IsModuleSignable( QSSecurityUtil.VB_ENCOUNTER_LIST ) )//Tahir Alvi - on visit sign click implement security check
							{
								authenticationPopUp = new AuthenticationPopUp();
								
								if (peDTO.CanSignCosign.toLowerCase() == Constants.STRING_TRUE)
								{	
									authenticationPopUp.signBtnLabel = "Sign";
									authenticationPopUp.actionName = Constants.VISIT_SIGNE;
								}
								else if (peDTO.CanSignCosign.toLowerCase() == Constants.STRING_FALSE)
								{
									authenticationPopUp.signBtnLabel = "Cosign";
									authenticationPopUp.actionName = Constants.VISIT_COSIGNED;
								}
								
								authenticationPopUp.originName = Constants.VIEW_BACKGROUND_MODULE_NAME;
								authenticationPopUp.visitID = peDTO.VisitId;
								authenticationPopUp.onVisitSignCosignCallback = onVisitSignCosignSuccess;
								
								authenticationPopUp.ShowPopup(this);
							}
							break;
						
						case "id_Edit":
							if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.VB_ENCOUNTER_LIST ) )//Tahir Alvi - on visit edit click implement security check
							{
								if( peDTO )
								{
									//QuivusCombineEventDispatcher.loadQuickInputEvents(peDTO.VisitId,true);
									var Qimodel:QIModelLocator = 	QIModelLocator.getInstance();
									
									Qimodel.patientID = model.patientDTO.PatientId;
									Qimodel.ClinicBranchIdSeq = model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq;
									Qimodel.VisitID = peDTO.VisitId;
									Qimodel.VisitDate = peDTO.VisitDate;
									Qimodel.canCoSign =	peDTO.CanSignCosign
									Qimodel.PlaceOfServiceTypeID =	peDTO.PlaceOfServiceTypeID
									Qimodel.PlaceOfServiceTypeName = peDTO.PlaceOfServiceTypeName
									Qimodel.LoggedInUserSelectedStationID = peDTO.StationID
									Qimodel.EncounterTypeName = peDTO.VisitEncounterTypeName
									
									//Tahir Alvi - for provider ---------// LE.BranchId, LE.VisitID, LE.patientID, LE.isEditMode, LE.UserId
									var lphys:LoadPhysiciansbyClinicBranchIDEvent = new LoadPhysiciansbyClinicBranchIDEvent(model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq,
										peDTO.VisitId, int(peDTO.PatientID), 'true', model.loggedInUserDTO.UserId)
									CairngormEventDispatcher.getInstance().dispatchEvent( lphys );
								}
							}
							break;
						case "id_WriteNotes":
							break;
						case "id_View":
						case "id_Print":
							
							if( peDTO )
							{
								var soapNote:soapNoteView = new soapNoteView();
								soapNote.show(soapNoteView.REVIEW_AND_PRINT, RemoveStatusWindow, ShowStatusWindow );
								
								var callback:Function = function( note:String, isURL:Boolean = false ):void
								{
									soapNote.SoapNoteURL = note;
								}
								
								var isMale:Boolean = model.basicUserDTO.Gender.GenderName.toLowerCase() == "male";
								var isAllSelected:Boolean 	= false;
								var isTempVisit:Boolean 	= false;
								
								var evt:CairngormEvent;
								evt = new GenerateSoapNotePreviewCommonEvent( peDTO.VisitId,  
									model.sessionDTO.SessionID, 
									model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq, 
									model.userSelectedStationDTO.StationID, 
									isAllSelected,
									isMale, 
									isTempVisit,
									'0',
									peDTO.VisitProvider,
									peDTO.VisitEncounterTypeName,
									peDTO.PlaceOfServiceTypeName,
									callback);
								CairngormEventDispatcher.getInstance().dispatchEvent( evt );
								
								logger.debug( "GenerateSoapNotePreviewEvent for " + event.target.toolTip + ": model.basicUserDTO.Gender-> " + model.basicUserDTO.Gender.GenderName.toLowerCase() + ", " +
									"isMale->" + isMale ); 
								
							}
							break;
					}
				}
			}
			
		]]>
	</fx:Script>
