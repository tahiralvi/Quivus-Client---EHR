<?xml version="1.0" encoding="utf-8"?>
<components1:CollapsiblePanel xmlns:fx="http://ns.adobe.com/mxml/2009" 
							 xmlns:s="library://ns.adobe.com/flex/spark" 
							 title="Medical Histroy" skinClass="com.adobe.quivus.skins.chrome.containerSkins.checkboxCollapsiblePanelSkin" 
							 xmlns:mx="library://ns.adobe.com/flex/mx" 
							 xmlns:components="com.zigron.controls.extended.components.*" xmlns:components1="com.gazuntite.controls.extended.components.*">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<components:layout>
		<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5"/>
	</components:layout>
	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.model.AppModelLocator;
			[Bindable]
			private var model:AppModelLocator = AppModelLocator.getInstance();
			
			[Bindable]
			override public function set isSelected(value:Boolean):void
			{
				super.isSelected = value;
				
				model.reviewHistroy.IsMedicalReviewed = value;
			}
		]]>
	</fx:Script>
	<components1:LabelDataGrid id="id_MedicalHistroy" horizontalScrollPolicy="off" verticalScrollPolicy="auto" width="100%"
							  rowCount="{id_MedicalHistroy.dataProvider.length?id_MedicalHistroy.dataProvider.length:1}"
							  columnWidths="{['40%','30%','30%']}" verticalGridLines="false" dataProvider="{model.medicalHistoryDTOListByPatient}"
							  >
		<components:columns>
			<mx:DataGridColumn  headerText="Description" dataField="IcdCodeDescription" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label"/>
			<mx:DataGridColumn  headerText="Status"   dataField="IsActive"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label"/>
			<mx:DataGridColumn  headerText="Notes" dataField="MedicalHistoryNote" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" />
		</components:columns>
	</components1:LabelDataGrid>
</components1:CollapsiblePanel>

