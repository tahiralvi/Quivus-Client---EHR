			// By Moeen , to bind the values to the newQI
			public function CreateVisit(createDate:Date):void
			{
				var visit:VisitDTO = new VisitDTO(	model.patientDTO.PatientId,
					model.loggedInUserDTO.UserId,
					model.userSelectedRoleDTO.UserTypeRole.UserTypeId,
					0,
					0,
					model.userSelectedStationDTO.StationID,
					model.placeOfServiceID ,
					model.loggedInUserDTO.UserId,
					createDate,
					createDate,model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq);
				var cve:CreateVisitEvent = new CreateVisitEvent(visit);
				CairngormEventDispatcher.getInstance().dispatchEvent( cve );
			}
			// on EditVisitEvent from Viewbackground
			private function onEditVisitEvent(event:EditVisitEvent):void
			{
				QIModelLocator.getInstance().patientID 						= event.patientID;
				QIModelLocator.getInstance().ClinicBranchIdSeq 				= event.ClinicBranchIdSeq;
				QIModelLocator.getInstance().VisitID 						= event.visitId;
				QIModelLocator.getInstance().VisitDate 						= event.VisitDate;
				QIModelLocator.getInstance().canCoSign 						= event.canCoSign;
				QIModelLocator.getInstance().PlaceOfServiceTypeID 			= event.PlaceOfServiceTypeID;
				QIModelLocator.getInstance().PlaceOfServiceTypeName 		= event.PlaceOfServiceTypeName;
				QIModelLocator.getInstance().LoggedInUserSelectedStationID 	= event.LoggedInUserSelectedStationID;
				QIModelLocator.getInstance().EncounterTypeName 				= event.EncounterTypeName;
				
				var lphys:LoadPhysiciansbyClinicBranchIDEvent = new LoadPhysiciansbyClinicBranchIDEvent(model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq,
																event.visitId, event.patientID, 'true', model.loggedInUserDTO.UserId)
				CairngormEventDispatcher.getInstance().dispatchEvent( lphys );
			
			}
			private function isFemale():Boolean
			{
				if(model.loggedInUserDTO.Gender == 'Female' || model.loggedInUserDTO.Gender.toLowerCase() == 'female')
					return true;
				else 
					return false;
			}
