			private function StartNativeProcess (event:Event = null):void
			{
				try
				{
					if(NativeProcess.isSupported)
					{
						var file:File = new File();//File.desktopDirectory;
						file = File.applicationDirectory.resolvePath( "etc/TwainGui.exe" );//file.resolvePath( Constants.FTP_UTIL);
						var filePath:String = file.nativePath;
						
						var nativeProcessStartupInfo:NativeProcessStartupInfo = new NativeProcessStartupInfo();
						nativeProcessStartupInfo.executable = file;
						var process:NativeProcess = new NativeProcess();
						
						process.start(nativeProcessStartupInfo);
						process.addEventListener(ProgressEvent.STANDARD_OUTPUT_DATA, onOutputData);
						process.addEventListener(ProgressEvent.STANDARD_ERROR_DATA, onErrorData);
						process.addEventListener(NativeProcessExitEvent.EXIT, onExit);
						process.addEventListener(IOErrorEvent.STANDARD_OUTPUT_IO_ERROR, onIOError);
						process.addEventListener(IOErrorEvent.STANDARD_ERROR_IO_ERROR, onIOError);
					}
				}
				catch(e:Error)
				{
					Alert.show("unable to StartNativeProcess [ " + Constants.FTP_UTIL + " ]", "No Installed Program found");
				}
			} 
			
			public function onOutputData(event:ProgressEvent):void
			{
				Alert.show("Process onOutputData \n" + event.toString() );
			}
			
			public function onErrorData(event:ProgressEvent):void
			{
				Alert.show("Process ErrorData \n" + event.toString() );
			}
			
			public function onExit(event:NativeProcessExitEvent):void
			{
				//Alert.show( "Process exited with " +  event.exitCode );
			}
			
			public function onIOError(event:IOErrorEvent):void
			{
				Alert.show( event.toString(), "IOError" );
			}
			
