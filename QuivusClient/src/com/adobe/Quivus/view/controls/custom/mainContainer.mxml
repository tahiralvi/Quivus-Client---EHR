			private function removeCurrentSlideOut():void
			{
				if( currentSlideOut )
				{
					closeConnectors();
					
					if( id_mainBGPanel.contains( currentSlideOut ) )
					{
						id_mainBGPanel.removeElement( currentSlideOut );
						id_mainBGPanel.visible 			= false;
						id_mainBGPanel.includeInLayout 	= false;
						resetHeights();
					}
					else if( id_mainBGQLPanel.contains( currentSlideOut ) )
					{
						id_mainBGQLPanel.removeElement( currentSlideOut );
						id_mainBGQLPanel.visible 			= false;
						id_mainBGQLPanel.includeInLayout 	= false;
						resetHeights();
					}
					else if( id_mainArea.contains( currentSlideOut ) )
					{
						id_mainArea.removeElement( currentSlideOut );
					}
					currentSlideOut = null;					
				}
			}
