			[Bindable]
			public function get ApplicationInActivityLock():Boolean
			{
				return isApplicationInActivityLock;
			}
			
			public function set ApplicationInActivityLock(value:Boolean):void
			{
				isApplicationInActivityLock = value;
				if(value)
				{
					systemManager.addEventListener(FlexEvent.IDLE, userIdle);
				}
			}
			
			private function userIdle(e:FlexEvent):void
			{
				var idleCounter:int = 600 * model.isSessionInActivityTime;
				if(idleCounter > 0)
				{
					if(e.currentTarget.mx_internal::idleCounter == idleCounter && !model.isActivityWindow && !vs.selectedIndex == 0 && model.isSessionInActivityLockRule)
					{ 
						lockWindow = PopUpManager.createPopUp(this,InActiveLockWindow,true) as InActiveLockWindow;
						lockWindow.width = width;
						lockWindow.height = height;
						PopUpManager.centerPopUp(lockWindow);
						lockWindow.addEventListener('hideLockWindowEvent', onHideLockWindow);
						model.isActivityWindow = true;
					}
				}
			}
			
			private function onHideLockWindow(event:Event):void
			{
				model.hideSessionInActivityWindow = false;
				lockWindow.removeEventListener('hideLockWindowEvent', onHideLockWindow);
				PopUpManager.removePopUp(lockWindow);
				model.isActivityWindow = false;
			}
			//********************* ConfidentialityTextRule***********************
			[Bindable]
			public function get ConfidentialityRule():Boolean
			{
				return isConfidentialityRule;
			}
			
			public function set ConfidentialityRule(value:Boolean):void
			{
				isConfidentialityRule = value;
				if(value)
				{
					//vs.selectedIndex = 3;
					//Show Confidentiality popup
					_ConfidentialityWindow = new ConfidentialityWindow();
					//PopUpManager.addPopUp(_ConfidentialityWindow, ConfidentialityWindow, true);
					PopUpManager.addPopUp(_ConfidentialityWindow, this, true);
					PopUpManager.centerPopUp(_ConfidentialityWindow);
					
					ticker = new Timer(10 * 1000,1); // 10 Sec
					ticker.addEventListener(TimerEvent.TIMER_COMPLETE,onTimerComplete);
					ticker.start();
				}
			}
			//On complete timer hide the Confidentiality window
			public function onTimerComplete(event:TimerEvent):void
			{
				ticker.start();
				ticker.reset();
				//vs.selectedIndex = 1;
				PopUpManager.removePopUp(_ConfidentialityWindow);
				
			} 
