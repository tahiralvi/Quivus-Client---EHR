				<components1:LabelComboBox id="id_LotNoCmbo" prompt="Lot#" width="50%"
										  dataProvider="{model.immunizationLotNumberList}" keyUp="id_LotNoCmbo_keyUpHandler(event)" tabIndex="3" />
			</s:HGroup>
			<components1:LabelComboBox id="id_BodySideRouteCmbo" prompt="Body Side/Route" width="100%" maxChars="250"
									  dataProvider="{model.immunizationRoutList}" 
									  keyUp="id_BodySideRouteCmbo_keyUpHandler(event)" change="Cmbo_changeHandler(event)"
									  tabIndex="9" />
			<components1:LabelComboBox id="id_SiteCmbo" prompt="Site" width="100%" maxChars="250"
									  dataProvider="{model.immunizationSitesList}" 
									  keyUp="id_SiteCmbo_keyUpHandler(event)"  change="Cmbo_changeHandler(event)"
									  tabIndex="14"/>
			
		</s:VGroup>
		
		<s:VGroup width="34%">
			<s:HGroup width="100%" >
				
				<components1:LabelDateField id="id_DateAdmin" prompt="Date Admin" toolTip="Admin Date" width="50%" 
										   yearNavigationEnabled="true" editable="true" maxYear="{new Date().getFullYear()}" minYear="1901"
										   change="validateDateAdmin()" keyUp="validateDateAdmin()"
										   selectableRange="{{rangeEnd : new Date()}}" fontFamily="calibri" fontSize="11" tabIndex="4"/>
				<components1:LabelDateField id="id_NextDue" prompt="Next Due" toolTip="Next Due" width="50%" 
										   yearNavigationEnabled="true" editable="true" selectableRange="{{rangeStart:new Date()}}"
										   change="validateDate()" keyUp="validateDate()" fontFamily="calibri" fontSize="11" tabIndex="5"/>
			</s:HGroup>
			<s:HGroup width="100%" >
				<components1:LabelDateField id="id_VISDate" toolTip="Visit Date" width="50%" yearNavigationEnabled="true" textInputStyleName="optionalDateTextBox"  
										   enabled="false" editable="false" 
										   selectedDate="{model.visitDTO.VisitDate}" maxYear="{new Date().getFullYear()}" minYear="1901" tabIndex="10"/>
				<components1:LabelDateField id="id_ExpiryDate" prompt="Expiry Date" textInputStyleName="optionalDateTextBox" toolTip="Expiry Date" width="50%"  yearNavigationEnabled="true" editable="true" maxYear="{new Date().getFullYear()}" minYear="1901"
										   change="validateDate()" keyUp="validateDate()" fontFamily="calibri" fontSize="11" tabIndex="11"/>
			</s:HGroup>
			<components1:LabelComboBox id="id_SeriesCmbo" prompt="Series" width="100%" maxChars="250"
									  dataProvider="{model.immunizationSeriesList}" 
									  keyUp="id_SeriesCmbo_keyUpHandler(event)"  change="Cmbo_changeHandler(event)"
