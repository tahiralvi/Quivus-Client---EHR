			</s:HGroup>
			
		</s:VGroup>
		
		<s:VGroup width="33%">
			<s:HGroup width="100%" >
				<components1:LabelComboBox id="id_DoseCmbo" prompt="Dose" width="50%"
										  dataProvider="{model.immunizationDoseList}" keyUp="id_DoseCmbo_keyUpHandler(event)" 
										  change="id_DoseCmbo_changeHandler(event)"
										  focusOut="areRequiredFieldsProvidedAndValid()"
