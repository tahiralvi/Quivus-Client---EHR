	<s:HGroup width="100%" horizontalAlign="center" paddingBottom="5">		
		<s:Label id="id_lbl" text="No Immunization Records" color="#FFFFFF" visible="{(!id_DataGrid.dataProvider.length)}"  includeInLayout="{id_lbl.visible}" fontFamily="Calibri" fontSize="14" width="100%" textAlign="center"/>
