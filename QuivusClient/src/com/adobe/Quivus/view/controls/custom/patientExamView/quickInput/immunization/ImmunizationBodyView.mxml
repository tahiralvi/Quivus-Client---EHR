			private function recentPatientGridItemEditBeginHandler(event:DataGridEvent):void
			{
				if( event.itemRenderer.data && !event.itemRenderer.data.IsRecordEditable )
				{
					event.preventDefault();
					event.stopImmediatePropagation();
					id_DataGrid.destroyItemEditor();
					id_DataGrid.editable = false;
				}
				
				id_DataGrid.createItemEditor(event.columnIndex, event.rowIndex);
				
				if (event.columnIndex == 4)
				{
					SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).data = event.itemRenderer.data; 
				}
			}
			
