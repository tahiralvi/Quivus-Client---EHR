			[Bindable]
			public function get CombinedQIVBImmunizationList():ArrayCollection
			{
				return _CombinedQIVBImmunizationList;
			}
			
			
			public function set CombinedQIVBImmunizationList(value:ArrayCollection):void
			{
				if(_CombinedQIVBImmunizationList)
					_CombinedQIVBImmunizationList.removeAll();
				_CombinedQIVBImmunizationList = null;
				_CombinedQIVBImmunizationList = new ArrayCollection();
				
				if(model.immunizationDTOList && model.immunizationDTOList.length > 0)
					_CombinedQIVBImmunizationList.addAll(model.immunizationDTOList);
				if(model.quickInputDTO.PMH.Immunization && model.quickInputDTO.PMH.Immunization.length >0 && isRecordAddInGrid)
					_CombinedQIVBImmunizationList.addAll(model.quickInputDTO.PMH.Immunization);
				
				if(CombinedQIVBImmunizationList)
				{
					if(CombinedQIVBImmunizationList.length > 0)
					{
						if(hasViewChanged)
							hasViewChanged = false;
						
						hasViewChanged = true;
					}
				}
				model.ImmunizationsReviewHistory = _CombinedQIVBImmunizationList;
			}
			
