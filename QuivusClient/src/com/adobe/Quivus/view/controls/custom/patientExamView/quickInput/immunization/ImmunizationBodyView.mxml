			protected function id_AssociateVisitzCombo_changeHandler():void
			{
				resetForm();//reset all fields before any selection
				if(model.ImmonizationAssociatedVisit == null)
					model.ImmonizationAssociatedVisit = new AssociatedVisit();
				
				if(id_AssociateVisitzCombo.selectedIndex != -1)
