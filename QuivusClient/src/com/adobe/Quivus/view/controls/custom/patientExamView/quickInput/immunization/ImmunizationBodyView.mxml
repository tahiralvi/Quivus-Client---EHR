						model.quickInputDTO.PMH.Immunization.addItemAt(immDTO, 0);
						CombinedQIVBImmunizationList.addItemAt(immDTO, 0);
						isRecordAddInGrid = true;
					}
					hasViewChanged = _hasGridChanged = true;
					resetFields();
			//	}
