									  change="comboChangeHandler(event)" open="id_ImmunizationCmbo_OpenHandler(event)"
									  focusOut="areRequiredFieldsProvidedAndValid()"
									  skinClass="com.gazuntite.controls.extended.skins.comboBoxRegisterationRequiredSkin" tabIndex="1"/>
			<components1:LabelComboBox id="id_ManufacturerCmbo" prompt="Manufacturer" width="100%" maxChars="250"
									  dataProvider="{model.immunizationManufacturerList}" keyUp="id_ManufacturerCmbo_keyUpHandler(event)" tabIndex="8" />
			
