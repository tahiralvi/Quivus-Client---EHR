			public function saveRecords():void
			{
				
			//	if (eventObj.detail == Alert.YES) 
			//	{
				
					var immDTO:ImmunizationDTO 	= new ImmunizationDTO();
					immDTO.IsNA
					immDTO.ImmunizationType		= id_ImmunizationCmbo.selectedItem as ImmunizationTypeDTO;
					immDTO.Dose					= id_DoseCmbo.textInput.text;
					immDTO.LotNumber			= id_LotNoCmbo.textInput.text;
					immDTO.Manufacturer			= id_ManufacturerCmbo.textInput.text;
					immDTO.Rout					= id_BodySideRouteCmbo.textInput.text;
					
					var reasonOfRefusal:String = ValidationUtils.TrimString(id_ReasonOfRefusalCmbo.textInput.text);
					
					if (reasonOfRefusal.length)
					{
						model.immunizationRefusalReasonList.addItem(reasonOfRefusal);
						immDTO.RefusalReason		= reasonOfRefusal;
					}
					
					immDTO.Site					= id_SiteCmbo.textInput.text;
					immDTO.Series				= id_SeriesCmbo.textInput.text;
					
					immDTO.CreatedAt			= new Date();
					immDTO.UpdatedAt			= new Date();
					//immDTO.VisitId				= model.visitId;
					//immDTO.VisitDate 			= id_VISDate.text;
					
					//Tahir Alvi - New Feature implemented
					immDTO.VisitId 				= model.ImmonizationAssociatedVisit.ID;				
					immDTO.VisitDate 			= model.ImmonizationAssociatedVisit.VisitDate;
					//immDTO.VisitDate 			= DateField.stringToDate(formatDateTime.format(model.ImmonizationAssociatedVisit.VisitDate),"MM/DD/YYYY");
					//DateField.stringToDate(dateString,"DD/MM/YYYY");
					
					immDTO.DictationID 			= Constants.GUID_FORMAT;
					
					immDTO.CreatedBy 			= model.loggedInUserDTO.UserId;
					immDTO.ManagedBy			= model.loggedInUserDTO.UserId;
					
					immDTO.DateAdmin			= id_DateAdmin.text;//selectedDate;
					immDTO.NextDoseDue			= id_NextDue.text;//selectedDate;
					immDTO.ExpiryDate			= id_VISDate.text;//selectedDate; 
					
					immDTO.ModifiedAt 			= Constants.NULL_DATE;
					
