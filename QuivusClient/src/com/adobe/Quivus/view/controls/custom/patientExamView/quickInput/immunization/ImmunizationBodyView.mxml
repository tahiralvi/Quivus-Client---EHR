				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor width="100%" dataProvider="{outerDocument.model.immunizationTypeDTOList}" labelField="ImmunizationTypeName" />
					</fx:Component>
				</mx:itemEditor>
