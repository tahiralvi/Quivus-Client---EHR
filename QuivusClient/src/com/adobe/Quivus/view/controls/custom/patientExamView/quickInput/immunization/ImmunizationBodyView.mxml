			public function isGetEdited():Boolean
			{
				var edited:Boolean = false;
				
				if (id_ImmunizationCmbo.selectedItem != null ||
					id_DoseCmbo.textInput.text.length ||  id_DoseCmbo.selectedItem != null ||
					id_LotNoCmbo.textInput.text.length || id_LotNoCmbo.selectedItem != null ||
					id_DateAdmin.text.length || id_DateAdmin.selectedItem != null ||
					id_NextDue.text.length || id_NextDue.selectedItem != null ||
					id_ManufacturerCmbo.textInput.text.length || id_ManufacturerCmbo.selectedItem != null ||
					id_BodySideRouteCmbo.textInput.text.length > 2 || id_BodySideRouteCmbo.selectedItem != null ||
					id_ExpiryDate.text.length || id_ExpiryDate.selectedDate != null ||
					id_ReasonOfRefusalCmbo.textInput.text.length || id_ReasonOfRefusalCmbo.selectedItem != null ||
					id_SiteCmbo.textInput.text.length > 2 || id_SiteCmbo.selectedItem != null ||
					id_SeriesCmbo.textInput.text.length > 2 || id_SeriesCmbo.selectedItem != null)
					
					edited = true;
				
				//hasViewChanged = (_hasGridChanged)? _hasGridChanged : edited;
				
				return edited;
			}
			
			private function isNonRequiredFieldsLengthValid():Boolean
			{
				var result:Boolean = true;
				
				if( id_BodySideRouteCmbo.textInput.text.length > 0 && id_BodySideRouteCmbo.textInput.text.length > 200 )
				{
					result = false;
					id_BodySideRouteCmbo.setFocus();
					Alert.show("Max length for \"Body Side Route\" is 200 chars", "Invalid Input");
				}
				else if( id_SiteCmbo.textInput.text.length > 0 && id_SiteCmbo.textInput.text.length > 200 )
				{
					result = false;
					id_SiteCmbo.setFocus();
					Alert.show("Max length for Site is 200 chars", "Invalid Input");
				}
				else if( id_SeriesCmbo.textInput.text.length > 0 && id_SeriesCmbo.textInput.text.length > 200 )
				{
					result = false;
					id_SeriesCmbo.setFocus();
					Alert.show("Max length for Series is 200 chars", "Invalid Input");
				}
				
				return result;
			}
			
			public function areRequiredFieldsProvidedAndValid():Boolean
			{
				var result:Boolean = false;
				
				if ((id_ImmunizationCmbo.selectedIndex >= 0 && id_ImmunizationCmbo.selectedItem != null) &&
					(id_DoseCmbo.textInput.text.length || id_DoseCmbo.selectedIndex >= 0 && id_DoseCmbo.selectedItem != null))
				{
					result = true;
					
					if (id_RefusalChk.selected)
					{
						if (!id_ReasonOfRefusalCmbo.textInput.text.length && id_ReasonOfRefusalCmbo.selectedIndex < 0 )
						{
							result = false;
						}
					}
				}
				/* calling isGetEdited() to check whether is there any change in view or not
				just to set hasViewChanged boolean
				*/
				//isGetEdited();
				
				return result;
			}
			
