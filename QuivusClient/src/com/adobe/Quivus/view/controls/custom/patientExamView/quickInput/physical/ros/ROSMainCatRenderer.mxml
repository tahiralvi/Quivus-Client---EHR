	<s:HGroup width="100%" gap="6" horizontalAlign="right" paddingLeft="0" paddingTop="2">

		<s:RadioButton id="id_N" groupName="rbGroup" value="Yes" visible="true" 
					   skinClass="com.adobe.Quivus.view.controls.skins.toggleButtonSkins.QINormalBtn"
					   />
		<s:HGroup paddingTop="6" horizontalAlign="right">	
		<s:BitmapImage  smooth="true" source="@Embed('com/adobe/Quivus/view/controls/skins/assets/SlideOutArrow.png')" />
			</s:HGroup>
	</s:HGroup>-->
		<s:HGroup gap="-53" paddingRight="7" >
			
		
		<s:HGroup>
			<s:ToggleButton id="id_MainButton" label="{label}" click="buttonbarbutton1_clickHandler(event)" change="id_MainButton_changeHandler(event)"
							 toolTip="{label}" skinClass="com.adobe.Quivus.view.controls.skins.toggleButtonSkins.ROStoggleBtn" textAlignLast="left" />
		</s:HGroup>
		
		
		<s:HGroup width="42" gap="5" horizontalAlign="right" paddingLeft="-50" paddingTop="3">
			
			<s:HGroup width="14" horizontalAlign="left">
				
			
			<s:ToggleButton id="id_ChangeIndicator" skinClass="com.adobe.Quivus.view.controls.skins.changeIndicator"
							 width="14" height="14" includeInLayout="{id_ChangeIndicator.visible}" visible="false"/>
			<s:RadioButton id="id_R" value="R" visible="false" includeInLayout="{id_R.visible}"
						   width="14" height="14" skinClass="com.adobe.Quivus.view.controls.skins.radioButtonSkins.RRedRadioButton"
						   />
			</s:HGroup>
			<s:HGroup>
				
			<!--<s:RadioButton id="id_N" groupName="rbGroup" value="Yes" visible="{!selected}" selected="{data.IsNormal == Constants.STRING_TRUE}" 
						   skinClass="com.adobe.Quivus.view.controls.skins.toggleButtonSkins.QINormalBtn" buttonMode="true" toolTip="All Normal"
						   />-->
			<s:ToggleButton id="id_N" change="rbGroup_itemClickHandler(event)" visible="{!selected}" selected="{data.IsNormal == Constants.STRING_TRUE}" 
				skinClass="com.adobe.Quivus.view.controls.skins.toggleButtonSkins.QINormalBtn" buttonMode="true" toolTip="All Normal"
				/>
			</s:HGroup>
			<!--com.adobe.Quivus.view.controls.skins.radioButtonSkins.NRadioButton-->
			<!--<s:HGroup paddingTop="4" horizontalAlign="right">			
				<s:BitmapImage  smooth="true" source="@Embed('com/adobe/Quivus/view/controls/skins/assets/SlideOutArrow.png')" />
			</s:HGroup>-->
		</s:HGroup>
		
	<!--</s:Group>-->
		<!--</s:SkinnableContainer>-->
		</s:HGroup>
	
</s:ItemRenderer>
