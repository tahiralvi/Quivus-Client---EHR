			[Bindable]
			public function get hasChange():Boolean
			{
				return m_bHasChange;
			}
			
			public function set hasChange(value:Boolean):void
			{
				m_bHasChange = value;
				
				if( value )
				{
					id_Header.id_ChangeIndicator.visible		 = true;
					id_Header.id_ChangeIndicator.includeInLayout = true;
				}
				else
				{
					id_Header.id_ChangeIndicator.visible		 = false;
					id_Header.id_ChangeIndicator.includeInLayout = false;
				}
			}
			
			private function UpdateChange():void
			{
				try
				{
					if( model.quickInputDTO.Physical && model.quickInputDTO.Physical.Labs )
					{
						var hasData:Boolean = model.quickInputDTO.Physical.Labs.length > 0;
						hasChange =  hasData;
					}
					
					if( model.quickInputDTO.Assessment && model.quickInputDTO.Assessment.Recommendation )
					{
						var hasData:Boolean = model.quickInputDTO.Assessment.Recommendation.length > 0;
						hasChange =  hasData;
					}
					
					if( model.quickInputDTO.Assessment && model.quickInputDTO.Assessment.PatientFollowUp && model.quickInputDTO.Assessment.PatientFollowUp.FollowUpDate )
					{
						var hasData:Boolean = model.quickInputDTO.Assessment.PatientFollowUp.FollowUpDate.length > 0;
						hasChange =  hasData;
					}
				}
				catch( e:Error )
				{
					trace( "UpdateChange -> QIAssessment::Plan", e.message );
				}
			}
			
