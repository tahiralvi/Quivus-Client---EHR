			private function labOutCreationHandler():void
			{
				id_LabOutView.addEventListener("addRecordClick", labOutAddRecordClickHandler, false, 0, true);
				id_LabOutView.addEventListener("writeNotesClick", labOutWriteRecordNotesClickHandler, false, 0, true);
				//ChangeWatcher.watch(id_LabOutView, "hasViewChanged", changeWatcherHandler);
				
				id_LabOutView.id_TestType.selectedIndex = 0;
			}
			
			private function recommendationCreationHandler():void
			{
				id_RecommendationView.addEventListener("addRecordClick", recommendationAddRecordClickHandler, false, 0, true);
				id_RecommendationView.addEventListener("writeNotesClick", recommendationWriteRecordNotesClickHandler, false, 0, true);
				ChangeWatcher.watch(id_RecommendationView, "hasViewChanged", changeWatcherHandler);
			}
			
			private function changeWatcherHandler(event:PropertyChangeEvent):void
			{
				if (id_LabOutView)
					hasChange = id_LabOutView.hasViewChanged;
				
				if (id_RecommendationView)
					hasChange = hasChange || id_RecommendationView.hasViewChanged;
			}
			
			/**
			 * Ayesha: May 05 2011
			 * hiding all popUps under plan panel if its view changes
			 * */
			private function planViewsChangeHandler(event:IndexChangedEvent):void
			{
				QIPopUpManager.hideAllPopUps();
				
				if (!isSectionLevel)
				{
					if (id_LabOutView)
					{
						id_LabOutView.id_Add.id_WriteNotes.selected = false;
					}
					
					if (id_RecommendationView)
					{
						id_RecommendationView.id_Add.id_WriteNotes.selected = false;
						
					}
					
					//removeNotesPanel();
				}
				
				if( event.oldIndex == 0 )
				{
					id_LabOutView.AllowMoveToNextPanel( function():void
					{
						id_PlanViews.selectedIndex = event.newIndex;									
					});
				}
				else if( event.oldIndex == 1 )
				{
					id_LabOutView.AllowMoveToNextPanel( function():void
					{
						id_PlanViews.selectedIndex = event.newIndex;									
					});
				}
				else if( event.oldIndex == 2 )
				{
					id_FollowUp.AllowMoveToNextPanel( function():void
					{
						id_PlanViews.selectedIndex = event.newIndex;									
					});
				}
				
				event.preventDefault();
				event.stopImmediatePropagation();
			}
			
