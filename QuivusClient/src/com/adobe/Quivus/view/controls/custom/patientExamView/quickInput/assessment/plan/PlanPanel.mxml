				<s:HGroup horizontalAlign="left">
					
					<s:TabBar dataProvider="{id_PlanViews}" skinClass="com.adobe.quivus.skins.chrome.tabBarSkins.QIrecordingsTabBar"
							  buttonMode="true"/>
					
				</s:HGroup>
				
				<s:SkinnableContainer width="100%" height="100%" skinClass="com.adobe.quivus.skins.chrome.containerSkins.planPanel">
					
					<s:layout>
						<s:VerticalLayout horizontalAlign="center" paddingTop="3" paddingLeft="3" paddingRight="3" paddingBottom="3" />
					</s:layout>
					<mx:ViewStack id="id_PlanViews" width="100%" height="100%" resizeToContent="true" change="planViewsChangeHandler(event)" creationPolicy="all">
						<s:NavigatorContent width="100%" label="Lab Out" height="100%" >
							
							<lab:LabContents id="id_LabOutView" width="100%" height="100%" maxHeight="{this.maxHeight - 50}" creationComplete="labOutCreationHandler()"
											 visible="{model.securityProxyObject.PatientExam.QuickInput.Assessment.Plans.LabOut.IsViewAllowed}" includeInLayout="{id_LabOutView.visible}"/>
							
						</s:NavigatorContent>
						
						<s:NavigatorContent width="100%" label="Recommendations">
							
							<recommendation:RecommendationView id="id_RecommendationView" width="100%" creationComplete="recommendationCreationHandler()"
															   visible="{model.securityProxyObject.PatientExam.QuickInput.Assessment.Plans.Recommendation.IsViewAllowed}" includeInLayout="{id_RecommendationView.visible}"/>
							
						</s:NavigatorContent>
						
						<s:NavigatorContent width="100%" label="Follow Up" >
							
							<followUp:FollowUpMerged id="id_FollowUp" width="100%" visible="{model.securityProxyObject.PatientExam.QuickInput.Assessment.Plans.FollowUp.IsViewAllowed}" includeInLayout="{id_FollowUp.visible}"/>
							
						</s:NavigatorContent>
					</mx:ViewStack>
					
					
					<s:HGroup width="100%">					
						<s:HGroup id="id_IndicatorGrp" width="100%" horizontalAlign="left" >
							<s:Button id="id_noteIndicator" label="Notes" visible="false" includeInLayout="{id_noteIndicator.visible}"
									  click="id_noteIndicator_clickHandler(event)" toolTip="View Notes" 
									  useHandCursor="true" buttonMode="true" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.notesIndicatorBtnSkin" />
							<s:Button id="id_dictationIndicator" label="Dictation" visible="false" includeInLayout="{id_dictationIndicator.visible}"
									  click="id_dictationIndicator_clickHandler(event)" toolTip="Play Dictation" 
									  useHandCursor="true" buttonMode="true" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.dictationIndicatorBtnSkin"/>
						</s:HGroup>
						<s:Group id="id_spacer" width="100%" height="2" />
						<!--<s:Button label="Next" click="dispatchEvent( new SelectSection('SelectSection', 'id_PlanPanel', true, true) )" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.QInextBtnSkin" toolTip="Next Section" />-->
					</s:HGroup>
				</s:SkinnableContainer>
				<!--</s:BorderContainer>-->
			</s:SkinnableContainer>
			
		</s:SkinnableContainer>
	</custom:Contents>
</custom:PinableSlideOutPanel>
