<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="true"
				width="200"
				>
	
	<fx:Script>
		<![CDATA[
			
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout gap="2" paddingTop="1" />
	</s:layout>
	<s:HGroup width="200">
		<s:Label id="id_allergyName" 
				 text="{data.AllergyName == 'N/A' ? 'NO KNOWN DRUG ALLERGIES': data.AllergyName}" width="60%" />
		<s:HGroup verticalAlign="middle" horizontalAlign="right" width="40%" >			
			<s:Label id="id_label" text="{data.Status}" visible="{data.Status == 'N/A' ? false:true}" width="100%"/>
		</s:HGroup>
	</s:HGroup>
	<mx:HRule width="100%" />	
</s:ItemRenderer>
