			private const SHOW_NOTE:int			= 0;
			private const HIDE_NOTE:int			= 1;
			private const HAS_NOTE:int			= 2;
			private const DESELECT:int			= 3;
			
			private var popGrp:PopupGroup = new PopupGroup();
			private var notesBox:NotesBox;
			private static var m_ballowPopups:Boolean = true;
			private var m_bIsOpen:Boolean;
			private var m_NoteButtonState:int = 0; // 0:Show Note, 1:Hide Note 2:Has Note, 3:Deselect Button
			
			
			private var m_physicalsDTO:PhysicalsDTO;
			
			private static var m_bChangeSkin:Boolean = false;
			private var bCompClicked:Boolean=false;
			
			private function onComponentClick(event:MouseEvent):void
			{
				bCompClicked = true;
			}
			
			private function onStageClick(event:MouseEvent):void
			{
				if(!bCompClicked) //we didn't click the component, so we clicked outside it..
				{   
					clickedOutSide();
				}
				else
				{
					bCompClicked=false; //we did click the component, set to false for the next time.
				}
			}
			
			private function clickedOutSide():void
			{
				RemovePopups();
			}
			
			public function get ChangeSkin():Boolean
			{
				return m_bChangeSkin;
			}
			
			public function set ChangeSkin(value:Boolean):void
			{
				m_bChangeSkin = value;
				
				if( ( physicalsDto.Notes && physicalsDto.Notes.length > 0 ) || physicalsDto.DictationID != Constants.GUID_FORMAT)
				{
					if(physicalsDto.IsAbNormal == Constants.STRING_TRUE)
						id_Abnormal.setStyle("skinClass", ANotesRadioButton);
					
					if(physicalsDto.IsNormal == Constants.STRING_TRUE)
						id_Normal.setStyle("skinClass", NNotesRadioButton);
				}
				else
				{
					id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
					id_Normal.setStyle("skinClass", QINormalBtn);
				}
			}
			
			[Bindable]
			public function get physicalsDto():PhysicalsDTO
			{
				return m_physicalsDTO;
			}
			
			public function set physicalsDto(value:PhysicalsDTO):void
			{
				m_physicalsDTO = value;
				
				m_physicalsDTO.addEventListener("propertyChange", function(event:Event):void
				{
					ChangeSkin = false;
				});
			}
			
			
			public static function get AllowPopups():Boolean
			{
				return m_ballowPopups;
			}
			
			public static function set AllowPopups(value:Boolean):void
			{
				m_ballowPopups = value;
				
				/* if( ! value )
				popGrp.removePopup(); */
			}
			
			public override function set data(value:Object):void
			{
				super.data = value;
				physicalsDto = data as PhysicalsDTO;
			}
			
			[Bindable]
			public override function set selected(value:Boolean):void
			{
				super.selected = value;
				if( !value )
					removeNotesPopup();
			}
			
			public function RemovePopups():void
			{
				if( popGrp && popGrp.isPopUp )
				{
					removeNotesPopup();
				}
				if( popGrpN && popGrpN.isPopUp )
				{
					removeNormalNotesPopup();
				}
				
				removeDictation();
			}
			
			private function removeDictation():void
			{
				if( dictationPanel && dictationPanel.isPopUp )
				{
					dictationPanel.id_closeBtn.dispatchEvent( new MouseEvent(MouseEvent.CLICK, true, true) );
				}
				
				if( dictationPanelN && dictationPanelN.isPopUp )
				{
					dictationPanelN.id_closeBtn.dispatchEvent( new MouseEvent(MouseEvent.CLICK, true, true) );
				}
			}
			
			private function getNotesPopupPosition():Point
			{
				if( this.y < 70 )
					var pLoc:Point = new Point( id_Contents.width , id_Contents.y );
				else
					pLoc = new Point( id_Contents.width , -this.y );
				
				var loc:Point = id_Contents.localToGlobal( pLoc );
				
				return loc;
			}
			
			private function showNotes():void
			{
				id_MainButton.setStyle("color", 0xffffff);
				m_NoteButtonState				= HIDE_NOTE;
				id_Normal.selected 				= false;
				physicalsDto.IsNormal   		= Constants.STRING_FALSE;
				id_NotesSpacer.includeInLayout 	= true;
				id_NotesSpacer.visible			= true;
				var color:SolidColor 			= new SolidColor(0x666666);
				//	id_Contents.backgroundFill 		= color;
				
				RemovePopups();
				
				notesBox = new NotesBox();
				notesBox.width			= 150
				notesBox.height			= 150
				
				popGrp.addElement( notesBox );
				popGrp.ShowPopup( this ); 
				m_bIsOpen		= true;
				var loc:Point = getNotesPopupPosition();
				popGrp.move( loc.x, loc.y );
				
				id_NotesSpacer.width = notesBox.width;
				notesBox.id_BoxHeader.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					removeNotesPopup();					
					event.stopImmediatePropagation();
				}); 
				//notesBox.id_TextArea.addEventListener(FocusEvent.FOCUS_OUT, itemrenderer1_focusOutHandler );
				notesBox.id_TextArea.addEventListener( "textChanged", function(event:Event):void
				{
					NotesChanged( event );
				});
				notesBox.id_TextArea.addEventListener(TextOperationEvent.CHANGE, NotesChanged);
				
				if( physicalsDto.Notes ) 
					notesBox.id_TextArea.text = physicalsDto.Notes;
				
				notesBox.id_TextArea.setFocus();
				
				notesBox.id_BoxHeader.id_VoiceBtn.addEventListener(MouseEvent.CLICK, voiceBtnClickHandler, false, 0, true);
				
				/* if (physicalsDto && physicalsDto.DictationID)							
				{
				notesBox.id_BoxHeader.id_VoiceBtn.setStyle("skinClass", QIInnerSpeakerBtn);
				} */
				
				
			}
			
			private var dictationPanel:DictationPopup;
			private function voiceBtnClickHandler(event:MouseEvent):void
			{
				var dictationDTO:ModuleDictationDTO = new ModuleDictationDTO();
				
				if (physicalsDto)
					dictationDTO.DictationID = physicalsDto.DictationID;
				
				dictationPanel = QIDictationManager.show(notesBox.id_BoxHeader.id_VoiceBtn.parent, dictationPanel, dictationDTO, notesBox.id_BoxHeader.id_VoiceBtn);
				QIPopUpManager.addPopUp(dictationPanel, QIPopUpManager.PHYSICAL);				
				dictationPanel.move( dictationPanel.x - 81, dictationPanel.y);
				
				dictationPanel.id_closeBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					if (dictationDTO && physicalsDto && dictationDTO.DictationID)
					{
						physicalsDto.DictationID = dictationDTO.DictationID;
						
						if (dictationDTO && physicalsDto && dictationDTO.DictationID && dictationDTO.DictationID != Constants.GUID_FORMAT)
						{
							notesBox.id_BoxHeader.id_VoiceBtn.setStyle("skinClass", QIInnerSpeakerBtn);
							id_Abnormal.setStyle("skinClass", ANotesRadioButton);
							dispatchEvent( new Event("PhysicalIsDirty", true, true) );
						}
					}
					QIPopUpManager.removePopUp(dictationPanel, QIPopUpManager.PHYSICAL);
				});
				
				event.stopImmediatePropagation();
			}
			
			private function NotesChanged(event:Event):void
			{
				physicalsDto.Notes 		= event.currentTarget.text;
				physicalsDto.IsDirty 	= true;
				id_Normal.selected		= false;
				physicalsDto.IsNormal   = Constants.STRING_FALSE;
				physicalsDto.IsAbNormal = Constants.STRING_TRUE;
				
				if(notesBox.id_TextArea.text.length > 0)
				{
					id_Abnormal.setStyle("skinClass", ANotesRadioButton);
				}
				else
				{
					id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
				}
				
				dispatchEvent( new Event("PhysicalIsDirty", true, true) );
			}
			
			private function removeNotesPopup():void
			{
				id_MainButton.setStyle("color", 0x222222);
				popGrp.removePopup();
				m_bIsOpen						= false;
				id_NotesSpacer.includeInLayout 	= false;
				id_NotesSpacer.visible			= false;
				/* if( physicalsDto.Notes ) 
				id_Abnormal.selected		= physicalsDto.Notes.length > 0;
				else */
				//id_Abnormal.selected		= true;
				//var color:SolidColor = new SolidColor(0xDADBA2);
				//id_Contents.backgroundFill = color; 
				//id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
			}
			
			
			protected function itemrenderer1_focusOutHandler(event:FocusEvent):void
			{
				if( m_bIsOpen )
					removeNotesPopup();
			}
			
			private function onPhysicalIsDirty(event:Event):void
			{
				//Tahir Alvi
				//if(physicalsDto.Notes && physicalsDto.Notes.length > 0)
				if(physicalsDto.Notes && physicalsDto.Notes.length > 0 && physicalsDto.IsAbNormal == Constants.STRING_TRUE)
				{
					ChangeSkin = true; //id_NotesBtn.setStyle("skinClass", ImmunizationNotesFilledBtn);
				}
				else
				{
					ChangeSkin = false; //id_NotesBtn.setStyle("skinClass", WriteNotesBtn);
				}				
			}
			
			protected function itemrenderer1_creationCompleteHandler(event:FlexEvent):void
			{
				addEventListener("PhysicalIsDirty" , onPhysicalIsDirty );
				callLater( function():void
				{
					FlexGlobals.topLevelApplication.addEventListener(MouseEvent.CLICK,onStageClick);
					/* if( physicalsDto.IsNormal == Constants.STRING_FALSE )
					id_Abnormal.selected = true;
					else  */
					if( physicalsDto.Notes )
					{
						//id_Abnormal.selected = physicalsDto.Notes.length > 0 ;
						//physicalsDto.IsAbNormal = physicalsDto.Notes.length > 0 ? Constants.STRING_TRUE: Constants.STRING_FALSE;
						
						if( physicalsDto.Notes.length > 0 && physicalsDto.IsAbNormal == Constants.STRING_TRUE)
						{
							id_Abnormal.setStyle("skinClass", ANotesRadioButton);
						}
						else if(physicalsDto.Notes.length < 0 && physicalsDto.IsAbNormal == Constants.STRING_FALSE)
						{
							id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
						}
						else if(physicalsDto.Notes.length > 0 && physicalsDto.IsNormal == Constants.STRING_TRUE)
						{
							id_Normal.setStyle("skinClass", NNotesRadioButton);
						}else 
						{
							id_Normal.setStyle("skinClass", QINormalBtn);
						}
						
					}
					ChangeSkin = true;
				});
			}
			
			public function set selectedNew(value:Boolean):void
			{
				trace(value);
			}
			
