			protected function id_Normal_clickHandler(event:MouseEvent):void
			{
				if(  popGrpN.isPopUp )
				{
					removeNormalNotesPopup();											
				}
				
				if( physicalsDto.IsNormal && physicalsDto.IsNormal == Constants.STRING_FALSE  )
				{
					//When A is selected & notes in Notes Window.
					if( physicalsDto.Notes && physicalsDto.Notes.length > 0)
						//{
						Alert.show("This action will clear abnormal notes, Are you sure you want to clear notes?","Clear Notes", Alert.YES|Alert.NO, 
							FlexGlobals.topLevelApplication.mainContainer, function(event:CloseEvent):void
							{
								if( event.detail == Alert.YES)
								{
									physicalsDto.IsNormal 		= Constants.STRING_TRUE;
									physicalsDto.IsAbNormal 	= Constants.STRING_FALSE;
									physicalsDto.Notes 			= null;
									//id_Abnormal.selected 	= false;
									id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
									dispatchEvent( new Event("PhysicalIsDirty", true, true) );
								}
								else if( event.detail == Alert.NO)
								{
									// NO button was clicked
									id_Normal.selected = false;
									
								}
								RemovePopups();
								ChangeSkin = true;
							});
					else if(id_Abnormal.selected)
					{
						//When A is selected but no notes in Notes Window.
						physicalsDto.IsNormal 			= Constants.STRING_TRUE;
						physicalsDto.IsAbNormal 		= Constants.STRING_FALSE;
						id_Abnormal.selected = false;
						id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
						showNormalNotes();
					}
					else if(id_Normal.selected && (physicalsDto.Notes == null || physicalsDto.Notes.length == 0))
					{
						showNormalNotes();
						physicalsDto.IsNormal = Constants.STRING_TRUE;
					}
				}
				else if( physicalsDto.Notes && physicalsDto.Notes.length > 0 )
				{
					showNormalNotes();
					//id_Abnormal.selected		= physicalsDto.Notes.length > 0;
					physicalsDto.IsNormal = physicalsDto.Notes.length > 0 ? Constants.STRING_TRUE: Constants.STRING_FALSE;
					
					if( physicalsDto.Notes.length > 0)
					{
						id_Normal.setStyle("skinClass", NNotesRadioButton);
					}
					else
					{
						id_Normal.setStyle("skinClass", QINormalBtn);
					}
				}
				else if( id_Normal.selected && ( physicalsDto.Notes == null || physicalsDto.Notes.length == 0 ) )
				{
					showNormalNotes();
					physicalsDto.IsNormal = Constants.STRING_TRUE;
				}
				else if( physicalsDto.Notes == null || physicalsDto.Notes.length == 0 )
				{
					id_Abnormal.selected = false;
					ChangeSkin = true;
					physicalsDto.IsAbNormal = Constants.STRING_NULL;
				}
				else
				{
					if( !id_Normal.selected && physicalsDto.Notes ) 
						//id_Abnormal.selected		= physicalsDto.Notes.length > 0;
						physicalsDto.IsNormal = physicalsDto.Notes.length > 0 ? Constants.STRING_TRUE: Constants.STRING_FALSE;
					
					if( physicalsDto.Notes.length > 0)
					{
						id_Normal.setStyle("skinClass", NNotesRadioButton);
					}
					else
					{
						id_Normal.setStyle("skinClass", QINormalBtn);
					}
				}
				
				ChangeSkin = true;
				
				physicalsDto.IsDirty 	= true;
				
				dispatchEvent( new Event("PhysicalIsDirty", true, true) );
				
				QIPopUpManager.hideAllSectionPopUps(QIPopUpManager.PHYSICAL);
				//event.stopImmediatePropagation();
			}
			
			protected function id_NotesBtn_clickHandler(event:MouseEvent):void
			{
				if(  popGrp.isPopUp )
				{
					removeNotesPopup();										
				}
				if( physicalsDto.IsAbNormal && physicalsDto.IsAbNormal == Constants.STRING_FALSE  )
