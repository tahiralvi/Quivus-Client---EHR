				popGrpN.ShowPopup( this ); 
				m_bIsOpen		= true;
				var loc:Point = getNotesPopupPosition();
				popGrpN.move( loc.x, loc.y );
				
				id_NotesSpacer.width = notesBoxN.width;
				notesBoxN.id_BoxHeader.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					removeNormalNotesPopup();					
					event.stopImmediatePropagation();
				}); 
				//notesBoxN.id_TextArea.addEventListener(FocusEvent.FOCUS_OUT, itemrenderer2_focusOutHandler );
				notesBoxN.id_TextArea.addEventListener( "textChanged", function(event:Event):void
				{
					NormalNotesChanged( event );
				});
				notesBoxN.id_TextArea.addEventListener(TextOperationEvent.CHANGE, NormalNotesChanged);
				
				if( physicalsDto.Notes ) 
					notesBoxN.id_TextArea.text = physicalsDto.Notes;
				
				notesBoxN.id_TextArea.setFocus();
				
				notesBoxN.id_BoxHeader.id_VoiceBtn.addEventListener(MouseEvent.CLICK, voiceBtnClickHandlerN, false, 0, true);
				
				/* if (physicalsDto && physicalsDto.DictationID)							
				{
				notesBox.id_BoxHeader.id_VoiceBtn.setStyle("skinClass", QIInnerSpeakerBtn);
				} */
			}
			private var dictationPanelN:DictationPopup;
			private function voiceBtnClickHandlerN(event:MouseEvent):void
			{
				var dictationDTO:ModuleDictationDTO = new ModuleDictationDTO();
				
				if (physicalsDto)
					dictationDTO.DictationID = physicalsDto.DictationID;
				
				dictationPanelN = QIDictationManager.show(notesBoxN.id_BoxHeader.id_VoiceBtn.parent, dictationPanelN, dictationDTO, notesBoxN.id_BoxHeader.id_VoiceBtn);
				QIPopUpManager.addPopUp(dictationPanelN, QIPopUpManager.PHYSICAL);				
				dictationPanelN.move( dictationPanelN.x - 81, dictationPanelN.y);
				
				dictationPanelN.id_closeBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
				{
					if (dictationDTO && physicalsDto && dictationDTO.DictationID)
					{
						physicalsDto.DictationID = dictationDTO.DictationID;
						
						if (dictationDTO && physicalsDto && dictationDTO.DictationID && dictationDTO.DictationID != Constants.GUID_FORMAT)
						{
							notesBoxN.id_BoxHeader.id_VoiceBtn.setStyle("skinClass", QIInnerSpeakerBtn);
							id_Normal.setStyle("skinClass", NNotesRadioButton);
							dispatchEvent( new Event("PhysicalIsDirty", true, true) );
						}
					}
					QIPopUpManager.removePopUp(dictationPanel, QIPopUpManager.PHYSICAL);
				});
				
				event.stopImmediatePropagation();
			}
			protected function itemrenderer2_focusOutHandler(event:FocusEvent):void
			{
				if( m_bIsOpen )
					removeNormalNotesPopup();
			}
			private function NormalNotesChanged(event:Event):void
			{
				physicalsDto.Notes 		= event.currentTarget.text;
				physicalsDto.IsDirty 	= true;
				id_Normal.selected		= true;
				physicalsDto.IsNormal   = Constants.STRING_TRUE;
				physicalsDto.IsAbNormal = Constants.STRING_FALSE;
				
				
				if(notesBoxN.id_TextArea.text.length > 0)
				{
					id_Normal.setStyle("skinClass", NNotesRadioButton);
				}
				else
				{
					id_Normal.setStyle("skinClass", QINormalBtn);
				} 
				
				dispatchEvent( new Event("PhysicalIsDirty", true, true) );
			}

			[Bindable]
			public function get GotAbnormal():String
			{
				return m_sGotAbnormal;
			}

			public function set GotAbnormal(value:String):void
			{
				m_sGotAbnormal = value;
				
				if( value == Constants.STRING_TRUE )
				{
					id_Normal.selected = false;
					ChangeSkin		   = true;
				}
			}

			[Bindable]
			public function get GotNormal():String
			{
				return m_sGotNormal;
			}

			public function set GotNormal(value:String):void
			{
				m_sGotNormal = value;
				if( value == Constants.STRING_TRUE )
				{
					id_Abnormal.selected = false;
					ChangeSkin		   = true;
				}
			}

			
			private var m_sGotAbnormal:String;
			private var m_sGotNormal:String;
			
		]]>
	</fx:Script>
