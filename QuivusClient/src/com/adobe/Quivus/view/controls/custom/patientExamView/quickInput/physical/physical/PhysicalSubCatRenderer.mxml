						Alert.show("This action will clear normal notes, Are you sure you want to clear notes?","Clear Notes", Alert.YES|Alert.NO, 
							FlexGlobals.topLevelApplication.mainContainer, function(event:CloseEvent):void
							{
								if( event.detail == Alert.YES)
								{
									physicalsDto.IsNormal 		= Constants.STRING_FALSE;
									physicalsDto.IsAbNormal 	= Constants.STRING_TRUE;
									physicalsDto.Notes 			= null;
									//id_Abnormal.selected 	= false;
									id_Normal.setStyle("skinClass", QINormalBtn);
									dispatchEvent( new Event("PhysicalIsDirty", true, true) );
								}
								else if( event.detail == Alert.NO)
								{
									// NO button was clicked
									id_Abnormal.selected = false;
									
								}
								RemovePopups();
								ChangeSkin = true;
							});
					else
					{
						//When N is selected but no notes in Notes Window.
						physicalsDto.IsNormal 			= Constants.STRING_FALSE;
						physicalsDto.IsAbNormal 		= Constants.STRING_TRUE;
						id_Normal.selected = false;
						id_Normal.setStyle("skinClass", QINormalBtn);
						showNotes();
					}
				}else if( physicalsDto.Notes && physicalsDto.Notes.length > 0 )
				{
					showNotes();
					//id_Abnormal.selected		= physicalsDto.Notes.length > 0;
					physicalsDto.IsAbNormal = physicalsDto.Notes.length > 0 ? Constants.STRING_TRUE: Constants.STRING_FALSE;
					
					if( physicalsDto.Notes.length > 0)
					{
						id_Abnormal.setStyle("skinClass", ANotesRadioButton);
					}
					else
					{
						id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
					}
					
					
					
				}
				else if( id_Abnormal.selected && ( physicalsDto.Notes == null || physicalsDto.Notes.length == 0 ) )
				{
					showNotes();
				}
				else if( physicalsDto.Notes == null || physicalsDto.Notes.length == 0 )
				{
					//id_Abnormal.selected = false;
					ChangeSkin = true;
					physicalsDto.IsNormal = Constants.STRING_NULL;
				}
				else
				{
					if( !id_Abnormal.selected && physicalsDto.Notes ) 
