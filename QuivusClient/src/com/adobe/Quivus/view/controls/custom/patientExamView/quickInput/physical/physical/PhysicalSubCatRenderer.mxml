						physicalsDto.IsAbNormal = physicalsDto.Notes.length > 0 ? Constants.STRING_TRUE: Constants.STRING_FALSE;
					
					if( physicalsDto.Notes.length > 0)
					{
						id_Abnormal.setStyle("skinClass", ANotesRadioButton);
					}
					else
					{
						id_Abnormal.setStyle("skinClass", QIAbnormalBtnSkin);
					}
				}
				
				
				dispatchEvent( new Event("PhysicalIsDirty", true, true) );
			}
			
			private function removeNormalNotesPopup():void
			{
				id_MainButton.setStyle("color", 0x222222);
				popGrpN.removePopup();
				m_bIsOpen						= false;
				id_NotesSpacer.includeInLayout 	= false;
				id_NotesSpacer.visible			= false;
				
				var color:SolidColor = new SolidColor(0xDADBA2);
			}
			private function showNormalNotes():void
			{
				id_MainButton.setStyle("color", 0xffffff);
				m_NoteButtonState				= HIDE_NOTE;
				id_NotesSpacer.includeInLayout 	= true;
				id_NotesSpacer.visible			= true;
