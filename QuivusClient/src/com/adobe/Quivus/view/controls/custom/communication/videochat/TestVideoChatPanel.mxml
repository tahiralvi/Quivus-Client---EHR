			protected function btnShare_clickHandler(event:MouseEvent):void
			{
				var popup:ComingSoon = new ComingSoon();
				popup.ShowPopup( this );
				popup.height = 125;
				popup.width = 200;
				
				var pLoc:Point = id_CommentsTextBox.parent.localToGlobal( new Point( id_CommentsTextBox.x  , id_CommentsTextBox.y ) ); 
				popup.move(pLoc.x,pLoc.y - 300 ); 
