		public function CallDetails():void
		{
			
			if(isNewCall && clinicBranchID != 0)
			{
				id_html.location = Constants.VIDEO_CHAT_OUTGOING_URL+"?InitiatorID="+model.loggedInUserDTO.UserId+"&RecieverID="+userID+"&BranchId="+clinicBranchID+"&RecieverName="+providerName;
				//id_html.location = Constants.VIDEO_CHAT_OUTGOING_URL+"?InitiatorID="+model.loggedInUserDTO.UserId+"&RecieverID="+userID+"&BranchId="+clinicBranchID;
				return ;
			}
			if((token == "" && opentoksession == "") || (token == null && opentoksession == null) && clinicBranchID != 0)
			{
				
			if(model.m_ovideoCallInfo != null && model.m_ovideoCallInfo != "")
			{
			var userSessionInfo:Array =model.m_ovideoCallInfo.split('^');
			
			videochatSessionID = userSessionInfo[0];
			var videochatInitiatorID:String= userSessionInfo[1];
			videoChatID= userSessionInfo[2];
			var videoChatTokenID:String= userSessionInfo[3];
			
			var sessionId:String = videochatSessionID;// "2_MX44NjA0ODcyfjE5Mi4xNjguMC44NH4yMDEyLTAxLTI2IDE0OjQxOjMzLjIwNDA1NiswMDowMH4wLjQ3NDI2NTIzMjUwNn4";
			var tokenId:String = videoChatTokenID;//"";
			//id_html.location = "http://192.168.0.146:89/MainVideoPage.aspx?ID=2_MX44NjA0ODcyfjE5Mi4xNjguMC44NH4yMDEyLTAxLTI2IDE0OjQxOjMzLjIwNDA1NiswMDowMH4wLjQ3NDI2NTIzMjUwNn4&"//"http://192.168.0.146:89/MainVideoPage.aspx?ID=1234656/";//"http://localhost:50917/TestJavaScript.aspx";
			
			//id_html.location = "http://192.168.0.146:89/MainVideoPage.aspx?ID="+sessionId+"&tokenID="+tokenId;
		////	id_html.location = "localhost:52000/Web/PatientContacts1.aspx?ID="+sessionId+"&tokenID="+tokenId;
			
			id_html.location = Constants.VIDEO_CHAT_URL + "?ID="+sessionId+"&tokenID="+tokenId+"&CallerName="+userSessionInfo[4];
		}
			else
			{
				trace("TestVideoChatPanel: CallDetails");
				var getSessionEvent:GetIncomingVideoChatSessionEvent=new GetIncomingVideoChatSessionEvent(currentLoggedInUserID,model.userSelectedStationDTO.ClinicBranchID,getVideoCallDetailsDetails);
				CairngormEventDispatcher.getInstance().dispatchEvent(getSessionEvent);
			}
			}
			else
			{
			///////	id_html.location = "http://192.168.0.146:89/MainVideoPage.aspx?ID="+opentoksession+"&tokenID="+token;
			//	id_html.location = "localhost:52000/Web/PatientContacts1.aspx?ID="+opentoksession+"&tokenID="+token;
				
				id_html.location = Constants.VIDEO_CHAT_URL + "?ID="+opentoksession+"&tokenID="+token+"&CallerName="+providerName;
				
				
			}
		}
		
			

