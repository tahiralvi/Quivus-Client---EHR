<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" width="400" height="300" xmlns:videochat="com.adobe.Quivus.view.controls.custom.communication.videochat.*">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout />
	</s:layout>
	<fx:Script>
		<![CDATA[
			public function openVideo(mUserId:int, StationID:int, videoChatTokenID:String, videochatSessionID:String):void
			{
				var objTest:TestVideoChatPanel = new TestVideoChatPanel();
				
				objTest.currentLoggedInUserID 	= mUserId;
				objTest.clinicBranchID 			= StationID;
				objTest.token 					= videoChatTokenID;
				objTest.opentoksession 			= videochatSessionID;
				objTest.isNewCall 				= false;
				this.addElement(objTest);
			}
		]]>
	</fx:Script>
	
</s:Group>
