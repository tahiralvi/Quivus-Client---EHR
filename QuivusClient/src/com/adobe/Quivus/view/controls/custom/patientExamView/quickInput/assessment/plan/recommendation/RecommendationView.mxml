			public function showNotes(loc:Point):void
			{
				if (loc)
				{
					if( recordNotesPanel )
						recordNotesPanel.removePopup();
					
					if (!recordNotesDTO)
						recordNotesDTO = new ModuleNoteDTO();
					
					recordNotesPanel 					= new NotesPanel();
					recordNotesPanel.width			= 550
					recordNotesPanel.height			= 150
					recordNotesPanel.HeadingLable 	= id_Plan.textInput.text;
					recordNotesPanel.VisitDateLable = model.FormatedVisitDate;
					recordNotesPanel.notesDTO	= recordNotesDTO;
					recordNotesPanel.ShowPopup( this );
					recordNotesPanel.move( loc.x, loc.y );
					
					recordNotesPanel.id_header.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						recordNotesPanel.SaveNotes();
						recordNotesPanel.removePopup();
						event.stopImmediatePropagation();	
						
						if(recordNotesPanel.id_body.id_message.text.length > 0)
						{
							id_Add.id_WriteNotes.setStyle("skinClass", ImmunizationNotesFilledBtn);
							
						}
						else
						{
							id_Add.id_WriteNotes.setStyle("skinClass", ImmunizationWriteNotesBtn);
						}
					});
				}
			}
			
			private var _recommendationCollection:ArrayCollection;
			[Bindable]
			public function get recommendationCollection():ArrayCollection
			{
				return _recommendationCollection;
			}
			
			public function set recommendationCollection(value:ArrayCollection):void
			{
				_recommendationCollection = value;
				
				if (_recommendationCollection)
				{
					_recommendationCollection.addEventListener(CollectionEvent.COLLECTION_CHANGE, recommendationCollectionChanged, false, 0, true);
					
					if (_recommendationCollection.length)
						includeGridInLayout = true;
						
					else
						includeGridInLayout = false;
				}
				else
					includeGridInLayout = false;
			}
			
			private function recommendationCollectionChanged(event:CollectionEvent):void
			{
				if (recommendationCollection && recommendationCollection.length)
				{
					includeGridInLayout = true;
					if(hasViewChanged)
						hasViewChanged = false;
					
					hasViewChanged = true;
				}
				else
				{
					includeGridInLayout = false;
					hasViewChanged = false;
				}
			}
			
			public function get includeGridInLayout():Boolean
