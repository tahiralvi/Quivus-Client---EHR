				var validationRes:ValidationResultEvent;
				var recommendationID:int = PatientRecommendationDTO(event.currentTarget.selectedItem).PatientRecommendationID;
				
				if (event.dataField == "Plan.PlanName")
				{
					var planEditor:LabelComboBox = SparkComboBoxItemEditor(id_RecommendationGrid.itemEditorInstance).id_ComboEditor;
					
					comboValidator.error = "Invalid Plan";
					comboValidator.source = planEditor;
					
					validationRes = comboValidator.validate(planEditor.selectedItem);
					
					if (validationRes && !validationRes.results)
					{
						event.itemRenderer.data.Plan = planEditor.selectedItem;
						
						if (recommendationID != 0)
							event.itemRenderer.data.IsDirty = true;
						
						hasViewChanged = _hasGridChanged = true;
					}
					/*else
					{
					//event.itemRenderer.data.Plan = editor.previouslySelectedItem;
					id_RecommendationGrid.destroyItemEditor();
					event.stopImmediatePropagation();
					event.preventDefault();
					}*/
					id_RecommendationGrid.destroyItemEditor();
					event.stopImmediatePropagation();
					event.preventDefault();
					
				}
				else if (event.dataField == "Method.MethodName")
				{
					var methodEditor:LabelComboBox = SparkComboBoxItemEditor(id_RecommendationGrid.itemEditorInstance).id_ComboEditor;
					
					comboValidator.error = "Invalid Method";
					comboValidator.source = methodEditor;
					
					validationRes = comboValidator.validate(methodEditor.selectedItem);
					
					if (validationRes && !validationRes.results)
					{
						event.itemRenderer.data.Method = methodEditor.selectedItem;
						
						if (recommendationID != 0)
							event.itemRenderer.data.IsDirty = true;
						
						hasViewChanged = _hasGridChanged = true;
					}
					/*else
					{
					//event.itemRenderer.data.Method = editor.previouslySelectedItem;
					id_RecommendationGrid.destroyItemEditor();
					event.stopImmediatePropagation();
					event.preventDefault();
					}*/
					id_RecommendationGrid.destroyItemEditor();
					event.stopImmediatePropagation();
					event.preventDefault();
				}
					
				else if (event.dataField == "Links")
				{
					var linksEditor:LabelComboBox = SparkComboBoxItemEditor(id_RecommendationGrid.itemEditorInstance).id_ComboEditor;
					
					event.itemRenderer.data.Links = ValidationUtils.TrimString(linksEditor.textInput.text);
					
					if (recommendationID != 0)
						event.itemRenderer.data.IsDirty = true;
					
					hasViewChanged = _hasGridChanged = true;
					
					id_RecommendationGrid.destroyItemEditor();
					event.stopImmediatePropagation();
					event.preventDefault();
				}
					
				else if (event.dataField == "Duration.DurationName")
				{
					var durationEditor:LabelComboBox = SparkComboBoxItemEditor(id_RecommendationGrid.itemEditorInstance).id_ComboEditor;
					
					comboValidator.error = "Invalid Duration";
					comboValidator.source = durationEditor;
					
					validationRes = comboValidator.validate(durationEditor.selectedItem);
					
					if (validationRes && !validationRes.results)
					{
						event.itemRenderer.data.Duration = durationEditor.selectedItem;
						
						if (recommendationID != 0)
							event.itemRenderer.data.IsDirty = true;
						hasViewChanged = _hasGridChanged = true;
					}
					/*else
					{
					//event.itemRenderer.data.Duration = editor.selectedItem;
					id_RecommendationGrid.destroyItemEditor();
					event.stopImmediatePropagation();
					event.preventDefault();
					}*/
					id_RecommendationGrid.destroyItemEditor();
					event.stopImmediatePropagation();
					event.preventDefault();
				}
				else if (event.dataField == "IsDiscussedWithPatient")
				{
					hasViewChanged = _hasGridChanged = true;
				}
			}
			
			override protected function commitProperties():void
			{
				super.commitProperties();
				
				if (_includeInLayoutChanged)
				{
					_includeInLayoutChanged = false;
					
					id_RecommendationGrid.includeInLayout = _includeInLayout;
					id_RecommendationGrid.visible = _includeInLayout;
					
					if (_includeInLayout)
					{
						id_RecommendationGrid.horizontalScrollPolicy="on";
						id_RecommendationGrid.columns[0].width = 40;
						id_RecommendationGrid.columns[1].width = 40;
						id_RecommendationGrid.columns[2].width = 40;
						id_RecommendationGrid.columns[3].width = 60;
						id_RecommendationGrid.columns[4].width = 60;
						id_RecommendationGrid.columns[5].width = 70;
						id_RecommendationGrid.columns[6].width = 60;
						id_RecommendationGrid.columns[7].width = 50;
						id_RecommendationGrid.horizontalScrollPolicy="off";
						
						
						id_RecommendationGrid.invalidateProperties();
						id_RecommendationGrid.invalidateSize();
						id_RecommendationGrid.invalidateDisplayList();
					}
				}
			}
			
			private function DescriptionChangeHandler(event:Event):void
			{
				//id_Add.enableAll = ( id_DescriptionArea.text.length > 0 )
				id_Add.enableAll = !isInvalid();
			}
			
			public function associatedDiagnosisLabel(oItem:Object):String
			{
				var label:String = "";
				if( oItem is String )
				{
					id_AssociatedDiagnosis.selectedIndex = -1;
				}
				else if ( oItem is PatientDiagnosisDTO )
				{
					label += oItem.ICDCode.IcdCodeName + ", ";
					label += oItem.ICDCode.IcdCodeDescription + ", ";
					label += oItem.IsChronic ? " (Chronic) " : " (Acute) ";
				}
				return label;
			}
			
			
			protected function id_AssociatedDiagnosis_clickHandler(event:MouseEvent):void
			{
				var ldrbpid:LoadDiagnosisForRecommendationByPatientIdEvent = new LoadDiagnosisForRecommendationByPatientIdEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent(ldrbpid);
			}
			
			
			private var recordGridNotesPopUp:NotesPanel;
			private var section:String;
			
			private function onWriteNotesClick(event:Event):void
			{
				if (!recordGridNotesPopUp)
					recordGridNotesPopUp = new NotesPanel();
				
				if (!recordGridNotesPopUp.isPanelShown)
				{
					//gridNotesDTO = new ModuleNoteDTO();
					var headingLabel:String = "";
					
					//extractDataForNotes();
					
					
					var addRecord:AddRecord = AddRecord(event.target);
					
					//recordLevelDicPanel = QIDictationManager.show(addRecord, recordLevelDicPanel, addRecord.dictationDTO, addRecord.id_WriteDictation);
					
					//headingLabel = deriveComplexData(headerField);
					recordGridNotesPopUp 				= new NotesPanel();
					recordGridNotesPopUp.width			= 250;
					recordGridNotesPopUp.height			= 110;
					recordGridNotesPopUp.HeadingLable 	= id_AssociatedDiagnosis.textInput.text;
					recordGridNotesPopUp.VisitDateLable = model.FormatedVisitDate;//new Date().toDateString();
					recordGridNotesPopUp.ShowPopup(this);
					
					
					
					recordGridNotesPopUp.notesDTO		=  addRecord.notesDTO; //gridNotesDTO;
					//recordGridNotesPopUp.onNotesSaved = updateNotesData;
					
					QIPopUpManager.addPopUp(recordGridNotesPopUp, section);
					
					//var pt:Point = localToGlobal(new Point(recordGridNotesPopUp.x, recordGridNotesPopUp.y));
					
					var pt:Point = id_Add.localToGlobal(new Point(id_Add.id_WriteNotes.x ,id_Add.id_WriteNotes.y));
					
					recordGridNotesPopUp.move(pt.x - 195, pt.y + 20);
					
					//recordGridNotesPopUp.move( recordGridNotesPopUp.x , recordGridNotesPopUp.y);
					/*recordGridNotesPopUp.addEventListener("notesSaved", function(event:Event):void
					{
					updateNotesData();
					
					}, false, 0, true);*/
					
					recordGridNotesPopUp.id_header.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						//recordGridNotesPopUp.removePopup();
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
						
					}, false, 0, true);
					
					recordGridNotesPopUp.id_header.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						recordGridNotesPopUp.SaveNotes();
						//if(recordNotesDTO)
						if(recordGridNotesPopUp.id_body.id_message.text.length > 0)
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotesSelected);
							
						}
						else
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
							
						}
						recordGridNotesPopUp.removeNotePanel();
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
					});
					
					recordGridNotesPopUp.addEventListener("notesSaved", function(event:Event):void
					{
						if(recordGridNotesPopUp.id_body.id_message.text.length > 0)
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotesSelected);								
						}
						else
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
						}
					});
				}
			}
			
			public function AllowMoveToNextPanel( callBack:Function ):void
			{
				if( id_Add.enableAll )
				{
					UtilityFunctions.AskMessage( "There are changes in the form, do you still want to leave form in current state?", function ():void
					{
						callBack(); 
					}); 
				}
				else
				{
					callBack();
				}
			}
			
			public function LoadStaticData():void
			{
				if(model.planTypesList==null || model.planTypesList.length==0)
				{
					var laptEvent : LoadAllPlanTypesEvent = new LoadAllPlanTypesEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( laptEvent );
				}
				
				if(model.durationTypesList==null || model.durationTypesList.length==0)
				{
					var ladtEvent : LoadAllDurationTypesEvent = new LoadAllDurationTypesEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( ladtEvent );
				}
				
				if(model.methodTypesList==null || model.methodTypesList.length==0)
				{
					var lmtEvent : LoadAllMethodTypesEvent = new LoadAllMethodTypesEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( lmtEvent );
				}
				
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<validators:ComboValidator id="comboValidator" property="selectedItem"/>
		<mx:DateFormatter id="formatDateTime" formatString="MM/DD/YYYY" />
	</fx:Declarations>
	
	<fx:Binding source="model.quickInputDTO.Assessment.Recommendation" destination="recommendationCollection"/>
	
	<s:layout>
		<s:VerticalLayout paddingLeft="3" paddingRight="3" paddingTop="3" paddingBottom="0" verticalAlign="middle" gap="1"/>
	</s:layout>
	
	<s:HGroup width="100%" gap="1">
		<components1:LabelComboBox id="id_Plan" prompt="Select Plan" width="200" dataProvider="{model.planTypesList}" labelField="PlanName" 
								  change="comboChangeHandler()" keyUp="comboKeyUpHandler(event)"
								  skinClass="com.gazuntite.controls.extended.skins.comboBoxRegisterationRequiredSkin" tabIndex="1"/>
		
		<!--dataProvider="{model.patientAllDiagnosisForRecommendationList}" labelFunction="associatedDiagnosisLabel"-->
		<components1:LabelComboBox id="id_AssociatedDiagnosis" prompt="Associated Diagnosis" width="90%" 
								  dataProvider="{model.quickInputDTO.Assessment.Diagnosis}" labelFunction="associatedDiagnosisLabel"
								  change="comboChangeHandler()" keyUp="comboKeyUpHandler(event)" click="id_AssociatedDiagnosis_clickHandler(event)"
								  tabIndex="2"/>
		<commons:AddRecord id="id_Add" verticalAlign="middle" writeNotesClick="onWriteNotesClick(event)"  writeDictationClick="writeDictationClickHandler(event)" 
						   tabIndex="3" paddingLeft="8" enableAll="false" enabled="false"/>
		
	</s:HGroup>
	<s:HGroup width="100%" gap="2">
		<components1:LabelComboBox id="id_Links" prompt="Web Links" width="200" dataProvider="{model.linksList}"
								  maxChars="500" change="comboChangeHandler()" keyUp="comboKeyUpHandler(event)" tabIndex="5"/>
		<components1:LabelComboBox id="id_Method" prompt="Method" width="100%" dataProvider="{model.methodTypesList}" labelField="MethodName"
								  change="comboChangeHandler()" keyUp="comboKeyUpHandler(event)"
								  skinClass="com.gazuntite.controls.extended.skins.comboBoxRegisterationRequiredSkin" tabIndex="6"/>
		<components1:LabelComboBox id="id_Duration" prompt="Duration" width="100%" dataProvider="{model.durationTypesList}" labelField="DurationName"
								  change="comboChangeHandler()" keyUp="comboKeyUpHandler(event)"
								  skinClass="com.gazuntite.controls.extended.skins.comboBoxRegisterationRequiredSkin" tabIndex="7"/>
		<s:HGroup width="100%" paddingTop="5" paddingLeft="5">
			<s:Label text="Discussed with Patient?" fontFamily="Calibri" fontSize="12" color="#FFFFFF" paddingRight="8" verticalAlign="bottom"/>
			<s:HGroup gap="0" paddingLeft="5" verticalAlign="middle" horizontalAlign="center" >
				<s:RadioButton id="id_Yes"  skinClass="com.adobe.Quivus.view.controls.skins.radioButtonSkins.YRadioButton" tabIndex="8" toolTip="Yes" buttonMode="true"/>
				<s:RadioButton id="id_No"  skinClass="com.adobe.Quivus.view.controls.skins.radioButtonSkins.NRadioButton" toolTip="No" buttonMode="true"/>
			</s:HGroup>
			
		</s:HGroup>
		
		
		
	</s:HGroup>
	<components1:LabelTextArea id="id_DescriptionArea" prompt="Description" width="100%" height="50" change="DescriptionChangeHandler(event)"
							  maxChars="1500" color="#000000"
							  tabIndex="9" skinClass="com.adobe.Quivus.view.controls.skins.textAreaReqSkin"/>
	
	
	<s:HGroup width="100%" paddingBottom="0" paddingTop="1">
		<s:Button id="id_add" click="addRecordClickHandler()" enabled="{id_Add.enableAll}" buttonMode="true" useHandCursor="true"
				  toolTip="Add Record" label="Add Recommendation" width="150"
				  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.AddMoreTooltipBtn" tabIndex="10"/>
		<s:SkinnableContainer skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.tooltipBG" visible="{!id_add.enabled}" width="100%" />
		<mx:Spacer width="100%" />
		<s:Button id="id_nextBtn" label="Next" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.QInextBtnSkin"  buttonMode="true"
				  toolTip="Next Section" enabled="true"/>
		
	</s:HGroup>
	
	<components1:LabelDataGrid id="id_RecommendationGrid" width="100%" includeInLayout="{includeGridInLayout}" visible="{includeGridInLayout}"
							  editable="false" useRollOver="false" rowCount="{id_RecommendationGrid.dataProvider.length + 1}"
							  itemEditBegin="recommendationItemEditBeginHandler(event)" 
							  itemEditEnd="recommendationItemEditEndHandler(event)"
							  dataProvider="{recommendationCollection}"
							  verticalScrollPolicy="on"
							  maxHeight="150" columnWidths="{[25,'10%','20%','12%','13%','10%','10%','20%',100]}">
		<components:columns>
			
			<mx:DataGridColumn headerText="Sr.#" editable="false" labelFunction="GridRowNumber" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" />
			<mx:DataGridColumn headerText="Visit Date" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" editable="false" labelFunction="{ValidationUtils.displayVisitDateForGrid}"/>
			<mx:DataGridColumn headerText="Plan"  dataField="Plan.PlanName" editorDataField="editorText" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor  dataProvider="{outerDocument.model.planTypesList}" labelField="PlanName"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Method"  dataField="Method.MethodName" editorDataField="editorText"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor dataProvider="{outerDocument.model.methodTypesList}" labelField="MethodName"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Links"  editable="true" dataField="Links" editorDataField="editorText" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor  dataProvider="{outerDocument.model.linksList}" labelField="Links"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Duration"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" dataField="Duration.DurationName" editorDataField="editorText" >
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor  dataProvider="{outerDocument.model.durationTypesList}" labelField="DurationName"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Discussed " itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" dataField="IsDiscussedWithPatient" labelFunction="discussedWithPatientLabel" editorDataField="isYes">
				<mx:itemEditor>
					<fx:Component>
						<diagnosis:YesNoItemEditor  height="100%"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Desc" dataField="Description"  width="25" wordWrap="true" >
				<!--<mx:itemEditor>
				<fx:Component>
				<s:TextArea width="100%" height="100%" maxChars="1500" color="#000000" />
				</fx:Component>
				</mx:itemEditor>-->
			</mx:DataGridColumn>
			<commons:DataGridColumnEx data="{deleteColumnData}" headerText="" editable="false" itemRenderer="com.gazuntite.patient.visit.view.itemrenderers.DeleteRecordRenderer"/>
		</components:columns>
	</components1:LabelDataGrid>
</s:Group>
