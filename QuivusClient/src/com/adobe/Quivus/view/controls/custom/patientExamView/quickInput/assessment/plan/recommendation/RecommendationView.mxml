			private function editRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_RECOMMENDATION ) )//Tahir Alvi - implement security check 
				{
					id_RecommendationGrid.editable = true;
					
					var rowIndex:int = LabelDataGrid(event.currentTarget).selectedIndex;
					
					var itemToSetInEditableMode:IListItemRenderer = id_RecommendationGrid.indexToItemRenderer(rowIndex);
					
					var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
					ev.columnIndex = 2;
					ev.rowIndex = rowIndex;
					ev.itemRenderer = itemToSetInEditableMode;
					ev.dataField = "Plan.PlanName";
					id_RecommendationGrid.dispatchEvent(ev);
				}
			}
			
			private function filterDeletedItems(item:Object):Boolean
			{
				var b:Boolean = item["IsDeleted"];
				return (!b);
			}
			
			private function deleteRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_RECOMMENDATION ) )//Tahir Alvi - implement security check 
				{
					var curTar:LabelDataGrid = LabelDataGrid(event.currentTarget);
					
					var recommendationID:int = PatientRecommendationDTO(event.currentTarget.selectedItem).PatientRecommendationID;
					
					UtilityFunctions.AskMessage(  "Do you want to delete selected record", function():void
					{
						if (recommendationID == 0)
						{
							model.quickInputDTO.Assessment.Recommendation.removeItemAt(curTar.selectedIndex);
							if (model.quickInputDTO.Assessment.Recommendation.length <= 0)
							{
								_hasGridChanged = false;
								hasViewChanged = isGetEdited();
							}
						}
						else
						{
							id_RecommendationGrid.selectedItem.IsDeleted = true;
							model.quickInputDTO.Assessment.Recommendation.filterFunction = filterDeletedItems;
							model.quickInputDTO.Assessment.Recommendation.refresh();
							
							hasViewChanged = _hasGridChanged = true;
						}
					});
					
				}
				
			}
			
			private function itemEditKeyUpHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_RECOMMENDATION ) )//Tahir Alvi - implement security check 
				{
					
					var lblFld:String = SparkComboBoxItemEditor(event.target).labelField;
					
					if (lblFld == "Links")
					{
						if (event.searchString.length > 2)
						{
							var loadLinksEv:LoadAllLinksEvent = new LoadAllLinksEvent(event.searchString);
							CairngormEventDispatcher.getInstance().dispatchEvent(loadLinksEv);
						}
					}
				}
			}
			
			private function addRecordClickHandler():void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_RECOMMENDATION ) )//Tahir Alvi - implement security check 
				{
					var patientRecommendationDTO:PatientRecommendationDTO = new PatientRecommendationDTO();
					if( id_Plan.selectedIndex >= 0 )
					{
						patientRecommendationDTO.Plan = new PlanTypeDTO(); //(id_Plan.selectedItem);
						patientRecommendationDTO.Plan.RecommendationPlanTypeID 	= id_Plan.selectedItem.RecommendationPlanTypeID;
						patientRecommendationDTO.Plan.PlanName 					= id_Plan.selectedItem.PlanName;
					}
					else if( id_Plan.textInput.text.length > 2)//free text
					{
						patientRecommendationDTO.Plan = new PlanTypeDTO(); //(id_Plan.selectedItem);
						patientRecommendationDTO.Plan.RecommendationPlanTypeID 	= 0;
						patientRecommendationDTO.Plan.PlanName 					= id_Plan.textInput.text;
					}
					
					if( id_Method.selectedIndex >= 0 )
					{
						patientRecommendationDTO.Method = new MethodTypeDTO();
						patientRecommendationDTO.Method.RecommendationMethodTypeID = MethodTypeDTO(id_Method.selectedItem).RecommendationMethodTypeID;
						patientRecommendationDTO.Method.MethodName = MethodTypeDTO(id_Method.selectedItem).MethodName;
					}
					else if( id_Method.textInput.text.length > 2 )//free text
					{
						patientRecommendationDTO.Method = new MethodTypeDTO();
						patientRecommendationDTO.Method.RecommendationMethodTypeID = 0;
						patientRecommendationDTO.Method.MethodName = id_Method.textInput.text;
					}
					
					if( id_Duration.selectedIndex >= 0 )
					{
						patientRecommendationDTO.Duration = new DurationTypeDTO();
						patientRecommendationDTO.Duration.RecommendationDurationTypeID = DurationTypeDTO(id_Duration.selectedItem).RecommendationDurationTypeID;
						patientRecommendationDTO.Duration.DurationName = DurationTypeDTO(id_Duration.selectedItem).DurationName;
					}
					else if( id_Duration.textInput.text.length > 2 )//free text
					{
						patientRecommendationDTO.Duration = new DurationTypeDTO();
						patientRecommendationDTO.Duration.RecommendationDurationTypeID = 0;
						patientRecommendationDTO.Duration.DurationName = id_Duration.textInput.text;
					}
					
					if( id_AssociatedDiagnosis.selectedItem )
					{
						var label:String = "";
						label += id_AssociatedDiagnosis.selectedItem.ICDCode.IcdCodeName + ", ";
						label += id_AssociatedDiagnosis.selectedItem.ICDCode.IcdCodeDescription + ", ";
						label += id_AssociatedDiagnosis.selectedItem.ICDCode.IsChronic ? " (Chronic) " : " (Acute) ";
						patientRecommendationDTO.DiagnosisInfo = label;
						patientRecommendationDTO.PatientDiagnosisID = ( id_AssociatedDiagnosis.selectedItem as PatientDiagnosisDTO ).PatientDiagnosisID;
					}
					
					patientRecommendationDTO.PatientID = model.loadedPatientId;
					
					if (id_Yes.selected)
						patientRecommendationDTO.IsDiscussedWithPatient = Constants.STRING_TRUE;
					else if (id_No.selected)
						patientRecommendationDTO.IsDiscussedWithPatient = Constants.STRING_FALSE;
					
					
					patientRecommendationDTO.Description = id_DescriptionArea.text;
					
					patientRecommendationDTO.ClinicBranchID = model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq;
					patientRecommendationDTO.VisitDate = formatDateTime.format(Constants.NULL_DATE);//datetostring(Tahir)
					
					patientRecommendationDTO.CreatedAt = formatDateTime.format(new Date());//datetostring(Tahir)
					patientRecommendationDTO.ModifiedAt = new Date();
					patientRecommendationDTO.DictationID = Constants.GUID_FORMAT;
					
					
					if (id_Add.notesDTO)
					{
						patientRecommendationDTO.Note = id_Add.notesDTO.Note;
						patientRecommendationDTO.NoteSubject = id_Add.notesDTO.NoteSubject;
					}
					//H
					if (id_Add.dictationDTO && id_Add.dictationDTO.DictationID != null)
					{
						patientRecommendationDTO.DictationID = id_Add.dictationDTO.DictationID;
					}
					
					var linkRef:String = ValidationUtils.TrimString(id_Links.textInput.text);
					
					if (linkRef.length)
					{
						patientRecommendationDTO.Links = linkRef;
						model.linksList.addItem(linkRef);
					}
					
					if(model.quickInputDTO.Assessment==null)
						model.quickInputDTO.Assessment = new AssessmentDTO();
					
					if(model.quickInputDTO.Assessment.Recommendation==null)
					{
						model.quickInputDTO.Assessment.Recommendation =new ArrayCollection();
					}	
					
					model.quickInputDTO.Assessment.Recommendation.addItem(patientRecommendationDTO);
					resetFields();
					
					if(hasViewChanged)
						hasViewChanged = false;
					
					_hasGridChanged = true;
					hasViewChanged  = true;
					
					
					id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
					id_Add.id_WriteDictation.setStyle("skinClass", QIDictationBtn);
					
				}
			}
			
			private var recordLevelDicPanel:DictationPopup;
			private function writeDictationClickHandler(event:Event):void
			{
				var addRecord:AddRecord = AddRecord(event.target);
				
				recordLevelDicPanel = QIDictationManager.show(addRecord, recordLevelDicPanel, addRecord.dictationDTO, addRecord.id_WriteDictation);
				
				QIPopUpManager.addPopUp(recordLevelDicPanel, QIPopUpManager.RECOMMENDATION);
				recordLevelDicPanel.move( recordLevelDicPanel.x - 81, recordLevelDicPanel.y);
				recordLevelDicPanel.addEventListener(MouseEvent.CLICK, function():void
				{
					QIPopUpManager.removePopUp(recordLevelDicPanel, QIPopUpManager.RECOMMENDATION);
					
					if(recordLevelDicPanel && recordLevelDicPanel.DictationID)
					{
						id_Add.id_WriteDictation.setStyle("skinClass", ImmunizationSpeakerBtn);
					}
					
				}, true, 0, false);
			}
			
			private function comboKeyUpHandler(event:KeyboardEvent):void
			{
				if (event.charCode >= 32 && event.charCode <= 127 || event.charCode == 8)
				{
					if (event.currentTarget.id != "id_Links")
					{
						id_Add.enableAll = false;
					}
					if (event.currentTarget.id == "id_Plan" && ( event.currentTarget.textInput.text.length == 3 || event.currentTarget.textInput.text.length == 5) )
					{
						var laptEvent : LoadAllPlanTypesEvent = new LoadAllPlanTypesEvent();
						CairngormEventDispatcher.getInstance().dispatchEvent( laptEvent );
					}
					if (event.currentTarget.id == "id_Method" && ( event.currentTarget.textInput.text.length == 3 || event.currentTarget.textInput.text.length == 5) )
					{
						var lmtEvent : LoadAllMethodTypesEvent = new LoadAllMethodTypesEvent();
						CairngormEventDispatcher.getInstance().dispatchEvent( lmtEvent );
					}
					if (event.currentTarget.id == "id_Duration" && ( event.currentTarget.textInput.text.length == 3 || event.currentTarget.textInput.text.length == 5) )
					{
						var ladtEvent : LoadAllDurationTypesEvent = new LoadAllDurationTypesEvent();
						CairngormEventDispatcher.getInstance().dispatchEvent( ladtEvent );
					}
					if( event.currentTarget.id == "id_AssociatedDiagnosis" && ( event.currentTarget.textInput.text.length == 3 || event.currentTarget.textInput.text.length == 5) )
					{
						var ldrbpid:LoadDiagnosisForRecommendationByPatientIdEvent = new LoadDiagnosisForRecommendationByPatientIdEvent();
						CairngormEventDispatcher.getInstance().dispatchEvent(ldrbpid);
					}
					else
					{
						var searchString:String = event.currentTarget.textInput.text;
						
						if (searchString.length > 2)
						{
							var loadLinksEv:LoadAllLinksEvent = new LoadAllLinksEvent(searchString);
							CairngormEventDispatcher.getInstance().dispatchEvent(loadLinksEv);
						}
					}
					
					id_Add.enabled = true;
				}
				
				/* calling isGetEdited() to check whether is there any change in view or not
				just to set hasViewChanged boolean
				*/
				isGetEdited();
			}
			
			private function comboChangeHandler():void
			{
				id_Add.enableAll = !isInvalid();
				id_Add.enabled = isGetEdited();
			}
			
