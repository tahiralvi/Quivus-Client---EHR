			protected function id_ScrollUpBtn_clickHandler(event:MouseEvent=null):void
			{
				switch(id_ListViews.selectedIndex)
				{
					case 0 :
						id_ImmunizationScroller.viewport.verticalScrollPosition       = id_ImmunizationScroller.viewport.verticalScrollPosition- 2;
						break;
					case 1 :
						id_DiagnosisScroller.viewport.verticalScrollPosition          = id_DiagnosisScroller.viewport.verticalScrollPosition - 2;
						break;
					case 2 :
						id_ChronicMedicationScroller.viewport.verticalScrollPosition  = id_ChronicMedicationScroller.viewport.verticalScrollPosition - 2;
						break;
					case 3 :
						id_InsuranceScroller.viewport.verticalScrollPosition          = id_InsuranceScroller.viewport.verticalScrollPosition - 2;
						break;
				}
				
			}


			protected function id_ScrollDownBtn_clickHandler(event:MouseEvent):void
			{
				switch(id_ListViews.selectedIndex)
				{
					case 0 :
						id_ImmunizationScroller.viewport.verticalScrollPosition      = id_ImmunizationScroller.viewport.verticalScrollPosition + 2;
						break;
					case 1 :
						id_DiagnosisScroller.viewport.verticalScrollPosition         = id_DiagnosisScroller.viewport.verticalScrollPosition + 2;
						break;
					case 2 :
						id_ChronicMedicationScroller.viewport.verticalScrollPosition = id_ChronicMedicationScroller.viewport.verticalScrollPosition + 2;
						break;
					case 3 :
						id_InsuranceScroller.viewport.verticalScrollPosition         = id_InsuranceScroller.viewport.verticalScrollPosition + 2;
						break; 
