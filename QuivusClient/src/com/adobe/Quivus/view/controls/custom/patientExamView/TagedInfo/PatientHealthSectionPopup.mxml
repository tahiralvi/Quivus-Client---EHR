			protected function popupgroup1_creationCompleteHandler(event:FlexEvent):void
			{
				if(model.userPatientProfileBarSetting.CompleteSettings.SectionThirdData == null)
					return;
				
				var type:String = model.userPatientProfileBarSetting.CompleteSettings.SectionThirdData.CollectionType;
				
				switch( type )
				{
					/* case Constants.ALLERGIES_CATEGORY_NAME:
						id_ListViews.selectedIndex = 0;
						break; */
					case Constants.DIAGNOSIS_CATEGORY_NAME:
						id_ListViews.selectedIndex = 0;
						
						break;
					case Constants.IMMUNIZATION_CATEGORY_NAME:
						id_ListViews.selectedIndex = 1;
						
						break;
					case Constants.CHRONIC_MEDICATION_CATEGORY_NAME:
						id_ListViews.selectedIndex = 2;
						
						break;
					case Constants.INSURANCE_CATEGORY_NAME:
						id_ListViews.selectedIndex = 3;
						
						break;
				}
				
				
			}

