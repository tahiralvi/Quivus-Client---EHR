			private function showSuggestPopup(val:* = null):void
			{
			if( SearchListView )
			{
			clearSearchResults();
			}
			SearchListView 				= new patientSearchList();
			SearchListView.addEventListener( AppEventStrings.SEARCH_LIST_PATIENT_SELECTED, OnItemClick);
			var pLoc:Point = new Point( id_patientSearchBoxContainer.x + id_patientSearchTextInput.x,
			id_patientSearchBoxContainer.y + id_patientSearchTextInput.y + this.height );
			var loc:Point = this.localToGlobal( pLoc );
			
			SearchListView.minWidth = id_patientSearchBoxContainer.width;
			
			SearchListView.x = loc.x; 
			SearchListView.y = loc.y;  
			
			/* SearchListView.addEventListener(CloseEvent.CLOSE, removePopup );
			PopUpManager.addPopUp( SearchListView, FlexGlobals.topLevelApplication.mainContainer  ); *   /
			
			SearchListView.ShowPopup( this );
			
			} 
			
			private function OnItemClick(event:Event):void
			{
			try
			{
			trace("PatientExamPanelHeader::OnItemClick --> for Load Patient",SearchListView.id_SearchList.selectedItem.UserId, 
			SearchListView.id_SearchList.selectedItem.FirstName, SearchListView.id_SearchList.selectedItem.LastName);
			
			
			var selectedPatient:PatientSearchDTO = SearchListView.id_SearchList.selectedItem;
			id_emailBtn.enabled 	= selectedPatient.IsEmailIdAvailable;
			id_snailBtn.enabled 	= selectedPatient.IsSnailIdAvailable;
			id_messageBtn.enabled 	= selectedPatient.IsChatIdAvailable;
			id_commentBtn.enabled 	= selectedPatient.IsSMSNoAvalable;
			id_PhoneBtn.enabled 	= selectedPatient.IsPhoneNoAvailable;
			
			//update ui / FE event
			var ps:PatientSelectedEvent = new PatientSelectedEvent(AppEventStrings.PATIENT_SELECTED_EVENT);;
			ps.selection = selectedPatient;
			dispatchEvent( ps );
			
			//update model / BE events
			var lppEvent : LoadPatientProfilePopUpDataEvent = new LoadPatientProfilePopUpDataEvent(selectedPatient.PatientId);
			CairngormEventDispatcher.getInstance().dispatchEvent( lppEvent );
			
			if(model.userPatientProfileBarSettingTemp==null){
			var lppcsEvent : LoadPatientProfileCustomizedSettingEvent = new LoadPatientProfileCustomizedSettingEvent(selectedPatient.PatientId,true);
			CairngormEventDispatcher.getInstance().dispatchEvent( lppcsEvent );
			}else
			{
			lppcsEvent = new LoadPatientProfileCustomizedSettingEvent( selectedPatient.PatientId, false);
			CairngormEventDispatcher.getInstance().dispatchEvent( lppcsEvent );
			}
			
			clearSearchResults();
			
			id_ClosePatnBtn.visible = true;
			id_NotesBtn.visible = true;
			id_RxBtn.visible = true;
			
			id_ClosePatnBtn.enabled = true;
			id_NotesBtn.enabled = true;
			id_RxBtn.enabled = true;
			
			}
			catch(e:Error)
			{
			trace("PatientExamPanelHeader::OnItemClick", e );
			}
			}
			
			private function clearSearchResults():void
			{
			SearchListView.removePopup();
			SearchListView.id_SearchList.removeEventListener(MouseEvent.CLICK, OnItemClick);
			SearchListView = null;
			}
			
