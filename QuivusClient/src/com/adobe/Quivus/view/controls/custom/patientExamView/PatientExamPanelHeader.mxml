						<s:Button buttonMode="true" id="id_CloseBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.popupCloseBtnSkin" 
								  toolTip="Close" height="16" width="16"
								  click="id_CloseBtn_clickHandler(event)"/>
					</s:HGroup>
					
					
					<!--skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.PEemailBtn"-->
					<s:Button id="id_emailBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.Btn_email_wide" 
							  buttonMode="true" useHandCursor="true" toolTip="Email" />
					
					
					<s:Button id="id_snailBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.Btn_snail_wide"
							  buttonMode="true" useHandCursor="true" toolTip="Snailmail" />
					
					
					<s:Button id="id_messageBtn"  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.Btn_Message_wide"
							  buttonMode="true" useHandCursor="true" toolTip="SMS" />
					
					
					<s:Button id="id_commentBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.Btn_chat_wide"
							  buttonMode="true" useHandCursor="true" toolTip="Chat" />
					
					
					<s:Button id="id_PhoneBtn" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.Btn_Cell_wide"
							  buttonMode="true" useHandCursor="true" toolTip="Phone" />
