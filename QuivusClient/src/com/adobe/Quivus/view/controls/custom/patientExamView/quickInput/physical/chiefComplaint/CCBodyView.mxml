			private function editEndHandler(event:HPIEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_CCHPI ) )//Tahir Alvi - implement security check 
				{
					if (model.visitId != 0)
					{
						if (event.isEditedValueValid)
						{
							var hpiID:int = HPI_CCDTO(event.currentTarget.selectedItem).PatientHPIID;
							
							if (hpiID != 0)
								event.currentTarget.selectedItem.IsDirty = true;
							
							hasViewChanged = _hasGridChanged = true;
						}
					}
				}
			}
			
			private function filterDeletedItems(item:Object):Boolean
			{
				var b:Boolean = item["IsDeleted"];
				return (!b);
			}
			
