			private var recordLevelDicPanel:DictationPopup;
			private function writeDictationClickHandler(event:Event):void
			{
				var addRecord:AddRecord = AddRecord(event.target);
				
				recordLevelDicPanel = QIDictationManager.show(addRecord, recordLevelDicPanel, addRecord.dictationDTO, addRecord.id_WriteDictation);
				
				QIPopUpManager.addPopUp(recordLevelDicPanel, QIPopUpManager.HPI_CC);
				
				recordLevelDicPanel.move(recordLevelDicPanel.x - 81, recordLevelDicPanel.y);
				
				recordLevelDicPanel.addEventListener(MouseEvent.CLICK, function():void
				{
					QIPopUpManager.removePopUp(recordLevelDicPanel, QIPopUpManager.HPI_CC);
					
					if(recordLevelDicPanel && recordLevelDicPanel.DictationID)
					{
						id_Add.id_WriteDictation.setStyle("skinClass", ImmunizationSpeakerBtn);
					}
					
				}, true, 0, false);
				
				
			}
			
			private function deleteRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_CCHPI ) )
				{
					var curTar:List = List(event.currentTarget);
					
					if (curTar.selectedItem)
					{
						var selectedIdx:int = id_List.selectedIndex;
						var hpiID:int = HPI_CCDTO(event.currentTarget.selectedItem).PatientHPIID;
						UtilityFunctions.AskMessage(  "Do you want to delete selected record", function():void
						{
							if (hpiID == 0)
							{
								model.quickInputDTO.Physical.HPI_CC.removeItemAt(selectedIdx);
								if (model.quickInputDTO.Physical.HPI_CC.length <= 0)
								{
									hasViewChanged = _hasGridChanged = false;
									//hasViewChanged =  isGetEdited();
								}
							}
							else
							{
								event.currentTarget.selectedItem.IsDeleted = true;
								model.quickInputDTO.Physical.HPI_CC.filterFunction = filterDeletedItems;
								model.quickInputDTO.Physical.HPI_CC.refresh();
								
								hasViewChanged = _hasGridChanged = true;
							}
						});
					}
				}
			}
			
			private function listFocusOutHandler(event:FocusEvent):void
