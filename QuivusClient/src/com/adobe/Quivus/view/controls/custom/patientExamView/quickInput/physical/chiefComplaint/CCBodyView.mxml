			private function comboKeyUpHandler(event:KeyboardEvent):void
			{
				var combo:LabelComboBox = LabelComboBox(event.currentTarget);
				
				switch(combo.id)
				{
					case "id_Symptom":
						id_Add.enableAll = (id_ComplaintArea.text.length || id_Symptom.textInput.text.length) && !isNotValid;
						break;
					case "id_Location":
						break;
					case "id_Severity":
						break;
					case "id_ModifyingFactors":
						break;
					case "id_Progression":
						break;
					case "id_Duration":
						break;
					case "id_Quality":
						break;
					case "id_Context":
						break;
					case "id_Exacerbating":
						break;
					case "id_Radiation":
						break;
				}
				
				id_Add.enabled = isGetEdited() && !isNotValid;
			}
			
			private function comboChangeHandler(event:Event):void
			{
				var combo:LabelComboBox = LabelComboBox(event.currentTarget);
				
				id_Add.enabled = isGetEdited() && !isNotValid;
				
				switch(combo.id)
				{
					case "id_Symptom":
						id_Add.enableAll = (id_ComplaintArea.text.length || id_Symptom.textInput.text.length || id_Symptom.selectedIndex != -1) && !isNotValid;
						break;
				}
				
			}
			
			private function hpiFocusOutHandler(event:FocusEvent):void
			{
				var valid:FreeTextValidator = new FreeTextValidator();
				var pastDateValidator:PastDateValidator = new PastDateValidator();
				
				valid.property = "selectedItem";
				switch(event.currentTarget.id)
				{
					case "id_Symptom":
						valid.error = "Symptom can not contain more than 200 characters";
						valid.maxLength = 200;
						valid.source = id_Symptom;
						valid.validate(id_Symptom.textInput.text);
						break;
					
					case "id_Location":
						valid.error = "Location can not contain more than 200 characters";
						valid.maxLength = 200;
						valid.source = id_Location;
						valid.validate(id_Location.textInput.text);
						break;
					
					case "id_Severity":
						valid.error = "Severity can not contain more than 200 characters";
						valid.maxLength = 200;
						valid.source = id_Severity;
						valid.validate(id_Severity.textInput.text);
						break;
					
					case "id_ModifyingFactors":
						valid.error = "Modifying factors can not contain more than 200 characters";
						valid.maxLength = 200;
						valid.source = id_ModifyingFactors;
						valid.validate(id_ModifyingFactors.textInput.text);
						break;
					
					case "id_Progression":
						valid.error = "Modifying factors can not contain more than 200 characters";
						valid.maxLength = 200;
						valid.source = id_ModifyingFactors;
						valid.validate(id_ModifyingFactors.textInput.text);
						break;
					
					case "id_OnSet":
						pastDateValidator.error = "You can not enter future date";
						pastDateValidator.source = id_OnSet;
						pastDateValidator.validate(id_OnSet.text);
						break;
				}
			}
			
