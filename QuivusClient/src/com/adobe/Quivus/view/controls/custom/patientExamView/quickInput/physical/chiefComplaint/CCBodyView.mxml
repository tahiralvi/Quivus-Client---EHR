			private function addRecordClickHandler(event:Event):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_CCHPI ) )
				{
					if(model.quickInputDTO.Physical== null)
						model.quickInputDTO.Physical = new PhysicalDTO();
					
					if(model.quickInputDTO.Physical.HPI_CC==null)
						model.quickInputDTO.Physical.HPI_CC = new ArrayCollection();
					
					model.quickInputDTO.Physical.HPI_CC.addItemAt(getCCHPIDetails(), 0);
					
					hasViewChanged  = _hasGridChanged = true;
					
					resetFields();
					
					id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
					id_Add.id_WriteDictation.setStyle("skinClass", QIDictationBtn);
				}
			}
			
