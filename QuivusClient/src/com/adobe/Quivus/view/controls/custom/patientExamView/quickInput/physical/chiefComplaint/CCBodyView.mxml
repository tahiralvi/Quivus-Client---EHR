					recordGridNotesPopUp.VisitDateLable = model.FormatedVisitDate;//new Date().toDateString();
					recordGridNotesPopUp.ShowPopup(this);
					
					
					
					recordGridNotesPopUp.notesDTO		=  addRecord.notesDTO; //gridNotesDTO;
					//recordGridNotesPopUp.onNotesSaved = updateNotesData;
					
					QIPopUpManager.addPopUp(recordGridNotesPopUp, section);
					
					//var pt:Point = localToGlobal(new Point(recordGridNotesPopUp.x, recordGridNotesPopUp.y));
					
					var pt:Point = id_Add.localToGlobal(new Point(id_Add.id_WriteNotes.x ,id_Add.id_WriteNotes.y));
					
					recordGridNotesPopUp.move(pt.x - 200, pt.y + 20);
					
					//recordGridNotesPopUp.move( recordGridNotesPopUp.x , recordGridNotesPopUp.y);
					/*recordGridNotesPopUp.addEventListener("notesSaved", function(event:Event):void
					{
					updateNotesData();
					
					}, false, 0, true);*/
					
					recordGridNotesPopUp.id_header.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						//recordGridNotesPopUp.removePopup();
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
						
					}, false, 0, true);
					
					recordGridNotesPopUp.id_header.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						recordGridNotesPopUp.SaveNotes();
						//if(recordNotesDTO)//if(recordNotesPanel.id_body.id_message.text.length > 0)
						if(recordGridNotesPopUp.id_body.id_message.text.length > 0)
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotesSelected);								
						}
						else
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
						}
						recordGridNotesPopUp.removeNotePanel();
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
					});
					
					
					recordGridNotesPopUp.addEventListener("notesSaved", function(event:Event):void
					{
						if(recordGridNotesPopUp.id_body.id_message.text.length > 0)
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotesSelected);								
						}
						else
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
						}
					});
				}
			}
			
			protected function id_SavedComplaint_changeHandler(event:IndexChangeEvent):void
			{
				// TODO Auto-generated method stub
			}
			
			
			protected function id_HPICheckBox_changeHandler(event:Event):void
			{
				// TODO Auto-generated method stub
			}
			
			private var _ccCollection:ArrayCollection;
			[Bindable]
			public function get ccCollection():ArrayCollection
			{
				return _ccCollection;
			}
			
			public function set ccCollection(value:ArrayCollection):void
			{
				_ccCollection = value;
				
				if (ccCollection)
				{
					if(ccCollection.length > 1)
					{
						if(hasViewChanged)
							hasViewChanged = false;
						
						hasViewChanged = true;
					}
				}
			}
			
			
		]]>
	</fx:Script>
	<fx:Binding source="model.quickInputDTO.Physical.HPI_CC" destination="ccCollection"/>
	
	<s:layout>
		<s:VerticalLayout paddingLeft="3" paddingRight="3" paddingTop="5" paddingBottom="1" gap="8"/>
	</s:layout>
	
	
	<s:VGroup gap="1" width="100%">
		<s:HGroup id="id_NotesArea" width="100%" paddingTop="0" />
		<s:HGroup width="100%" gap="8" paddingTop="8">
			<components1:LabelTextArea id="id_ComplaintArea" prompt="Complaint" width="100%" height="22" change="complaintChangeHandler(event)" paddingTop="2" paddingLeft="2"
									  maxChars="250" color="#000000" skinClass="com.adobe.Quivus.view.controls.skins.textAreaReqSkin" tabIndex="1" toolTip="Enter Complaint"/>
			<commons:AddRecord id="id_Add"  writeNotesClick="onWriteNotesClick(event)"  writeDictationClick="writeDictationClickHandler(event)" tabIndex="2" enabled="{id_Add.enableAll}" />
		</s:HGroup>
	</s:VGroup>
	<s:VGroup width="100%">
		<s:Label id="id_HPI" text="History of Present Illness" fontFamily="Calibri" fontSize="12" color="#D5DDEA"/>
		<s:HGroup width="100%" >
			<s:VGroup width="50%" gap="2">
				<components1:LabelComboBox id="id_Symptom" prompt="Symptoms" width="100%" keyUp="comboKeyUpHandler(event)" dataProvider="{model.symptom}" focusOut="hpiFocusOutHandler(event)" change="comboChangeHandler(event)"
										  maxChars="350" skinClass="com.gazuntite.controls.extended.skins.comboBoxRegisterationRequiredSkin" tabIndex="4"
										  toolTip="Select Symptom"/>
				<components1:LabelComboBox id="id_Location"  maxChars="220" fontFamily="Calibri" prompt="Location" width="100%"  
										  keyUp="comboKeyUpHandler(event)" dataProvider="{model.location}" 
										  change="comboChangeHandler(event)" tabIndex="7"
										  toolTip="Select Location"/>
				<components1:LabelComboBox id="id_Severity"  maxChars="220" fontFamily="Calibri" prompt="Severity" width="100%" 
										  keyUp="comboKeyUpHandler(event)" dataProvider="{model.severity}" 
										  change="comboChangeHandler(event)" tabIndex="9"
										  toolTip="Select Severity"/>
				<components1:LabelComboBox id="id_ModifyingFactors" maxChars="220"  fontFamily="Calibri" prompt="Modifying Factors" width="100%"  
										  keyUp="comboKeyUpHandler(event)" dataProvider="{model.modifyingFactors}" 
										  change="comboChangeHandler(event)" tabIndex="11"
										  toolTip="Select Modifying Factors"/>
				<components1:LabelComboBox id="id_Progression"  maxChars="220" fontFamily="Calibri" prompt="Progression" width="100%"  
										  keyUp="comboKeyUpHandler(event)" dataProvider="{model.progression}" 
										  change="comboChangeHandler(event)" tabIndex="13"
										  toolTip="Select Progression"/>
			</s:VGroup>
			<s:VGroup width="50%" gap="2">
				<s:HGroup width="100%">
					<components1:LabelDateField id="id_OnSet" prompt="OnSet" width="50%"  editable="true" 
											   keyUp="validateOnSet()" yearNavigationEnabled="true"
											   change="validateOnSet()" restrict="[/ 0-9]"
											   selectableRange="{{rangeEnd : new Date()}}" tabIndex="5" toolTip="Select Onset date"/>													
					
					<components1:LabelComboBox id="id_Duration" maxChars="220" fontFamily="Calibri " prompt="Duration" width="50%"  
											  keyUp="comboKeyUpHandler(event)" dataProvider="{model.duration}" 
											  change="comboChangeHandler(event)" tabIndex="6" toolTip="Select Duration"/>
				</s:HGroup>
				<components1:LabelComboBox id="id_Quality" maxChars="220" fontFamily="Calibri " prompt="Quality" width="100%"  
										  keyUp="comboKeyUpHandler(event)" dataProvider="{model.quality}" 
										  change="comboChangeHandler(event)" tabIndex="8" toolTip="Select Quality"/>
				<components1:LabelComboBox id="id_Context" maxChars="220" fontFamily="Calibri " prompt="Context" width="100%"  
										  keyUp="comboKeyUpHandler(event)" dataProvider="{model.contextList}" 
										  change="comboChangeHandler(event)" tabIndex="10" toolTip="Select Context"/>
				<components1:LabelComboBox id="id_Exacerbating" maxChars="220" fontFamily="Calibri" prompt="Exacerbating" width="100%"  
										  keyUp="comboKeyUpHandler(event)" dataProvider="{model.exacerbating}" 
										  change="comboChangeHandler(event)" tabIndex="12" toolTip="Select Exacerbating"/>
				<components1:LabelComboBox id="id_Radiation" maxChars="220" fontFamily="Calibri " prompt="Radiation" width="100%"  
										  keyUp="comboKeyUpHandler(event)" dataProvider="{model.radiation}" 
										  change="comboChangeHandler(event)" tabIndex="14" toolTip="Select Radiation"/>
			</s:VGroup>
		</s:HGroup>
	</s:VGroup>
	<s:HGroup width="100%">
		<s:Button id="id_add" click="addRecordClickHandler(event)" enabled="{id_Add.enableAll}" buttonMode="true" useHandCursor="true" toolTip="Add Record"
				  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.AddMoreTooltipBtn" label="Add CC/HPI" tabIndex="15"  />
		<s:SkinnableContainer width="229" skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.tooltipBG" visible="{!id_add.enabled}"  />
		<!-- Tahir Alvi - Linking of HPI entries with already added complaint -->
		<s:CheckBox id="id_HPICheckBox" label="Attach HPI with" change="id_HPICheckBox_changeHandler(event)" color="#FFFFFF" visible="false" includeInLayout="{id_HPICheckBox.visible}"/>
		<components1:LabelComboBox id="id_SavedComplaint" prompt="Complaint...." width="120" change="id_SavedComplaint_changeHandler(event)" 
								  enabled="{id_HPICheckBox.selected ? true : false}" visible="false" includeInLayout="{id_SavedComplaint.visible}"/>
		<mx:Spacer width="100%"/>
		<s:Button id="id_nextBtn" label="Next" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.QInextBtnSkin" buttonMode="true" 
				  toolTip="Next Section" enabled="true" click="dispatchEvent( new SelectSection('SelectSection', 'id_CCPanel', true, true) )" />
		
	</s:HGroup>
	<s:List id="id_List"  width="100%" height="100%"  
			itemRenderer="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.physical.chiefComplaint.itemRenderers.CCItemRendererMxml"
			rollOverColor="#D5CFB8" selectionColor="#D5CFB8"
			dataProvider="{ccCollection}" verticalScrollPolicy="off" horizontalScrollPolicy="off"
			visible="{(id_List.dataProvider.length > 0)}" includeInLayout="{(id_List.dataProvider.length > 0)}" >
		<s:layout>
			<s:VerticalLayout requestedRowCount="{id_List.dataProvider.length}" requestedMinRowCount="0" 
							  paddingLeft="0" paddingRight="0" paddingTop="0" paddingBottom="0" />
		</s:layout>
	</s:List>        
	
</s:Group>
