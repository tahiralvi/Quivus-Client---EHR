	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.view.controls.skins.checkBoxSkins.checkBoxSkin;
			
			import mx.events.FlexEvent;
			import mx.managers.PopUpManager;
			private var fileToOpen:File = new File();
			//private var attachmentName:String;
			private var m_oAttachmentContent:ByteArray;
			
			public function get Content():ByteArray
			{
				return m_oAttachmentContent;
			}

			public function set Content(value:ByteArray):void
			{
				m_oAttachmentContent = value;
			}
			
			public function get FileName():String
			{
				return fileToOpen.name;
			}

			private function fileSelected(event:Event):void
			{
				var stream:FileStream = new FileStream(); // open filestream
				stream.open(fileToOpen, FileMode.READ); // open the file
				m_oAttachmentContent = new ByteArray();
				stream.readBytes( m_oAttachmentContent, 0, stream.bytesAvailable ); // read file
				
				stream.close(); // close file
				
				id_FilePathtxt.text = fileToOpen.nativePath;
			} 
			
			
			protected function BrowseBtn_clickHandler(event:MouseEvent):void
			{
				fileToOpen.browse();
				fileToOpen.addEventListener(Event.SELECT, fileSelected);
			}

		]]>
	</fx:Script>

