<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="true"
				
				creationComplete="itemrenderer1_creationCompleteHandler(event)"
				
				>
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			import valueObjects.PatientInsuracneInfoDTO;

			protected function itemrenderer1_creationCompleteHandler(event:FlexEvent):void
			{
				var dto:PatientInsuracneInfoDTO = new PatientInsuracneInfoDTO();
				dto.InsuranceOrganizationName
			}

		]]>
	</fx:Script>
	
	<s:layout>
		<s:HorizontalLayout />
	</s:layout>
	
	<s:Label text="{data.PatientInsuranceId}" width="25%"/>
	<s:Label text="{data.InsuranceOrganizationName}" width="50%"/>
	<s:Label text="{data.IsEligible}" width="25%"/>
	
</s:ItemRenderer>
