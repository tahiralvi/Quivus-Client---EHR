		<mx:columns>
			<mx:DataGridColumn headerText="Sr.#" width="30" editable="false" labelFunction="displayRowNum" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Type" width="60" dataField="IsByDate" editable="false" labelFunction="TypeLabelFunction" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" />
			<mx:DataGridColumn headerText="Method" width="60" dataField="FollowUpMethodType.MethodName" editable="false" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Service"  dataField="objServiceTypeDTO.FollowupService" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:ComboBoxItemEditor dataProvider="{outerDocument.model.serviceTypeDTOList}" labelField="FollowupServiceTypeName"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Frequency" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" width="100" labelFunction="frequencyLabelFunction" />
			<mx:DataGridColumn headerText="Nature" headerWordWrap="true" wordWrap="true" width="60" labelFunction="NatureLabelFunction" />
			<mx:DataGridColumn editable="false" width="85" itemRenderer="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.commons.VBRenderer"/>
		</mx:columns>
