			public function displayRowNum(item:Object, iCol:int):String
			{
				var strRowNum:String = "";
				
				if (id_DataGrid.dataProvider)
				{
					var rowNum:int = id_DataGrid.dataProvider.getItemIndex(item) + 1;
					strRowNum = String(rowNum);
				}
				
				return strRowNum;
			}
			
			public function NatureLabelFunction(item:PatientFollowupMergedDTO, iCol:int):String
			{
				if( item.IsAcute )
					return "Acute";
				if( item.IsChronic )
					return "Chronic";
				if( item.IsPreventive )
					return "Preventive";
				
				return "";
			}
			
			public function frequencyLabelFunction(item:Object, iCol:int):String
			{
				var label:String = "";
				var freq:PatientFollowupMergedDTO = PatientFollowupMergedDTO(item);
				
				if (freq.IsAgeSelected)
				{
					if (freq.AgeTypeDTO && freq.AgeTypeDTO.AgeTypeName)
						label += freq.AgeTypeDTO.AgeTypeName + " " ;
					
					if (freq.AgeValueTypeDTO && freq.AgeValueTypeDTO.AgeValueTypeName)
						label += freq.AgeValueTypeDTO.AgeValueTypeName;
				}
				else if (freq.IsDurationSelected)
				{
					if (!isNaN(freq.AfterDurationValue))
						label += "After " + freq.AfterDurationValue + " ";
					
					if (freq.AfterInstructionDurationTypeDTO && freq.AfterInstructionDurationTypeDTO.DurationTypeName)
						label += freq.AfterInstructionDurationTypeDTO.DurationTypeName + " ";
					
					if (!isNaN(freq.ForDurationValue))
						label += "for " + freq.ForDurationValue + " ";
					
					if (freq.ForInstructionDurationTypeDTO && freq.ForInstructionDurationTypeDTO.DurationTypeName)
						label += freq.ForInstructionDurationTypeDTO.DurationTypeName;
				} 
				
				return label;
			}
			
			public function TypeLabelFunction(item:PatientFollowupMergedDTO,iCol:int) : String
			{		
				if( item.IsByDate )
					return item.FollowUpDate ;
				else if( item.IsOnCompletion )
				{
					if( item.IsDrugselected )
						return item.DrugName.toString();
					else if( item.IsLabTestSelected )
						return '';//item.LabTestName.toString(); 
				}
				return "";
			}
			
			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				id_DataGrid.addEventListener(DataGridActionsEvent.EDIT_RECORD_CLICK, editRecordClickHandler, false, 0, true);
				id_DataGrid.addEventListener(DataGridActionsEvent.DELETE_RECORD_CLICK, deleteRecordClickHandler, false, 0, true);
				id_DataGrid.addEventListener(DataGridActionsEvent.ITEM_EDIT_KEY_UP, itemEditKeyUpHandler, false, 0, true);
			}
			
			private function editRecordClickHandler(event:DataGridActionsEvent):void
			{
				id_DataGrid.editable = true;
				var rowIndex:int = id_DataGrid.selectedIndex;
				var itemToSetInEditableMode:IListItemRenderer = id_DataGrid.indexToItemRenderer(rowIndex);
				
				var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
				ev.columnIndex = 2;
				ev.rowIndex = rowIndex;
				ev.itemRenderer = itemToSetInEditableMode;
				ev.dataField = "DateAdmin";
				id_DataGrid.dispatchEvent(ev);
			}
			
			private function deleteRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.VB_FOLLOW_UP ) )//Tahir Alvi - implement security check 
				{
					var curTar:DataGrid = DataGrid(event.currentTarget);
					
					if (curTar.selectedItem)
					{
						var followUpInstructionID:int = PatientFollowupMergedDTO(curTar.selectedItem).PatientFollowUpMergeID;
						
						if (followUpInstructionID == 0)
						{
							/* model.quickInputDTO.Assessment.PatientFollowupMerged.removeItemAt(curTar.selectedIndex);
							
							if (model.quickInputDTO.Assessment.PatientFollowupMerged.length <= 0)
							{
							_hasGridChanged = false;
							//hasViewChanged = isGetEdited();
							} */
						}
						else
						{
							UtilityFunctions.AskMessage(  "Do you want to delete selected record", function():void
							{
								id_DataGrid.selectedItem.IsDeleted = true;
								model.patientFollowupDTOListByPatientId.filterFunction   = filterDeletedItems;
								model.patientFollowupDTOListByPatientId.refresh();
								
								hasViewChanged = _hasGridChanged = true;
							});
						}
					}
				}
			}
			
			private function filterDeletedItems(item:Object):Boolean
			{
				var b:Boolean = item["IsDeleted"];
				return (!b);
			}
			
			private function itemEditKeyUpHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.VB_FOLLOW_UP ) )//Tahir Alvi - implement security check 
				{
					
				}
			}
			
