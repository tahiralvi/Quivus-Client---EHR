				</s:Rect>
				
				<s:Path data="M 156 0 L 3 0 C 1.344 0 0 1.343 0 3 L 0 147 C 0 148.657 1.344 150 3 150 L 97 150 L 97 169 C 97 170.657 98.344 172 100 172 L 156 172 C 157.656 172 159 170.657 159 169 L 159 147 L 159 145 L 159 3 C 159 1.343 157.657 0 156 0 Z" x="3" y="17">
					<s:fill>
						<s:LinearGradient rotation="90">
							<s:GradientEntry alpha="1.0" color="#CBE2EF" ratio="0"/>
							<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="0.5333333333333333"/>
