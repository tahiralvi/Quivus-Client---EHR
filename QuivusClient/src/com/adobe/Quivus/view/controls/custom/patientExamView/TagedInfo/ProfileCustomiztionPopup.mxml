			backgroundSkin: ClassReference(null); */
			backgroundAlpha: 0;
			backgroundColor: #CBE2EF;
			borderStyle: none;
			borderThickness: 0;
			
			
		
			folderClosedIcon : ClassReference(null);
			folderOpenIcon : ClassReference(null);
			defaultLeafIcon : ClassReference(null);
			
		/* 	disclosureOpenIcon :ClassReference("com.adobe.Quivus.view.controls.skins.buttonSkins.treeMinusIcon"); 
			disclosureClosedIcon :ClassReference("com.adobe.Quivus.view.controls.skins.buttonSkins.treePlusIcon"); */
			
			
			paddingLeft: 1;			
