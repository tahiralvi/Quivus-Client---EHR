				<s:Button id="id_upBtn" click="id_upBtn_clickHandler(event)" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.scrollbarUpButton_small" 
						   creationComplete="button1_creationCompleteHandler(event)" 
						   buttonMode="true" useHandCursor="true" toolTip="Scroll Up"/>
				<s:Button id="id_downBtn" click="id_downBtn_clickHandler(event)" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.scrollbarDownButton_small" 						  
						  buttonMode="true" useHandCursor="true" toolTip="Scroll Down"/>
				
				</s:HGroup>
					
					
				</s:VGroup>
				
				</s:Group>
			<s:Button buttonMode="true" id="id_CloseBtn" click="id_CloseBtn_clickHandler(event)" toolTip="Close" 
					  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.popupCloseBtnSkin" tabIndex="0" x="142" y="2"
