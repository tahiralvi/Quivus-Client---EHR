	<fx:Script>
		<![CDATA[
			import com.adobe.Quivus.events.patientProfileCustomization.ManageUserPatientProfileBarSettingEvent;
			import com.adobe.Quivus.events.staticData.LoadProfileBarStaticDataEvent;
			import com.adobe.Quivus.model.AppModelLocator;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.scrollbarDownButton;
			import com.adobe.Quivus.view.controls.skins.buttonSkins.scrollbarUpButton;
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.utils.UtilityFunctions;
			
			[Bindable]
			private var model : AppModelLocator = AppModelLocator.getInstance();
			
			protected function id_profileTree_clickHandler(event:MouseEvent):void
			{
				// ***** NOTE :: see ProfilePanelHeader.mxml for impl; ****
				trace ( id_profileTree.selectedItem );
			}

			protected function id_CloseBtn_clickHandler(event:MouseEvent):void
			{
				this.removePopup();
			}


			protected function id_profileTree_creationCompleteHandler(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				id_profileTree.setStyle("backgroundAlpha", 0);
				id_profileTree.setStyle( "backgroundColor", 0xCBE2EF );
				
			}


			protected function button1_creationCompleteHandler(event:FlexEvent):void
			{
				/* id_downBtn.visible = false;
				id_upBtn.visible = false;
				if(model.userProfileBarStaticDataList)
				{
					if(model.userProfileBarStaticDataList.length >= 4)
					{
						id_downBtn.visible = true;
						id_upBtn.visible = true;
					}
				} */
			}
			
			
			[Embed('com/adobe/Quivus/view/controls/skins/assets/Expand.png')]
			[Bindable]
			public var openIcon:Class;
			
			[Embed('com/adobe/Quivus/view/controls/skins/assets/Collapse.png')]
			[Bindable]
			public var closeIcon:Class;



			protected function id_upBtn_clickHandler(event:MouseEvent):void
			{
				if(id_profileTree.verticalScrollPosition > 0)
					id_profileTree.verticalScrollPosition--;
					
			}


			protected function id_downBtn_clickHandler(event:MouseEvent):void
			{
				
				trace("MAX "+id_profileTree.maxVerticalScrollPosition);
				trace("C "+id_profileTree.verticalScrollPosition);
				if(id_profileTree.verticalScrollPosition < id_profileTree.maxVerticalScrollPosition)
					id_profileTree.verticalScrollPosition++;
			}

			protected function popupgroup1_creationCompleteHandler(event:FlexEvent):void
			{
				if( UtilityFunctions.IsNullOrEmpty( model.userProfileBarStaticDataList ) )
				{
					var pbsdEvent : LoadProfileBarStaticDataEvent = new LoadProfileBarStaticDataEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( pbsdEvent );
				}
			}
			
		]]>
	</fx:Script>
