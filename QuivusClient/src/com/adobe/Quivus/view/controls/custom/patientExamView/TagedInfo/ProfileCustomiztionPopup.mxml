				</fx:Script>
				
				
				<s:VGroup gap="1" paddingLeft="3">
					<s:Group>
						
						<s:Label color="#111111" fontFamily="Calibri Bold" text="Change Quick View"  />
					</s:Group>
					
					
				<mx:Tree id="id_profileTree" itemRenderer="com.adobe.Quivus.view.controls.custom.itemRenderer.TreeItemRenderer"						 
						 defaultLeafIcon="{null}" chromeColor="#CBE2EF"  
						 showRoot="true" liveScrolling="false"  
						 disclosureClosedIcon="{closeIcon}"
						 disclosureOpenIcon="{openIcon}"
						 dataProvider="{model.userProfileBarStaticDataList}" click="id_profileTree_clickHandler(event)"
						 styleName="pTree" width="150" height="145" rowHeight="18" creationComplete="id_profileTree_creationCompleteHandler(event)"
						  y="20" verticalScrollPolicy="off" 

						  contentBackgroundColor="#CBE2EF" contentBackgroundAlpha="0" selectionColor="#555555" selectable="true"/>				
				
				<!--//id_profileTree.verticalScrollPosition decrement commented..-->
				<s:HGroup paddingTop="8" paddingLeft="0" paddingRight="3" gap="0" width="100%" horizontalAlign="right">
					
