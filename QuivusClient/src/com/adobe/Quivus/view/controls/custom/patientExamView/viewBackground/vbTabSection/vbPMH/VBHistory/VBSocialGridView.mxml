			private function vbSocialGridItemEditBeginHandler(event:DataGridEvent):void
			{
				if (event.columnIndex < 3 )
				{
					id_DataGrid.editable = false;
					event.preventDefault();
					event.stopImmediatePropagation();
					return; // don't allow first edit
				}
				else if (event.columnIndex > 3 )
				{
					if(id_DataGrid.selectedItem["Status"] == Constants.STRING_NO_UI)
					{
						id_DataGrid.editable = false;
						event.preventDefault();
						event.stopImmediatePropagation();
						return; //don't allow edit until yes selected
					}
				}
				
				id_DataGrid.createItemEditor(event.columnIndex, event.rowIndex);
				
				if (event.columnIndex == 3)
				{
					try
					{
						if(id_DataGrid.selectedItem["Status"] == Constants.STRING_NO_UI)
						{
							(id_DataGrid.itemEditorInstance as YesNoItemEditor).isYes = "false";
						}
						else if(id_DataGrid.selectedItem["Status"] == Constants.STRING_YES_UI)
						{
							(id_DataGrid.itemEditorInstance as YesNoItemEditor).isYes = 'true';
						}
						/* else if((id_DataGrid.itemEditorInstance).data["IsYesSelected"] == "false")
						{
						(id_DataGrid.itemEditorInstance).data["IsYesSelected"] = "No";
						} */
					}
					catch(error:*)
					{
						
					}
				}
					
					
				else if (event.columnIndex == 4)
				{
					try
					{
						if((id_DataGrid.itemEditorInstance).data["Current"] == true)
						{
							(id_DataGrid.itemEditorInstance).data["Current"] = "Yes";
						}
						else if((id_DataGrid.itemEditorInstance).data["Current"] == false)
						{
							(id_DataGrid.itemEditorInstance).data["Current"] = "No";
						}
					}
					catch(error:*)
					{
						
					}
				}
					
				else if(event.columnIndex == 5)
				{
					try
					{
						trace("Social: ",event.itemRenderer.data["Social"]);					
						if(event.itemRenderer.data["Social"] == Constants.SOCIAL_ALCOHOL_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = model.historyMediumTypesDTOData.AlcoholList;
						}
						else if(event.itemRenderer.data["Social"] == Constants.SOCIAL_DRUGS_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = model.historyMediumTypesDTOData.DrugsList;
						}
						else if(event.itemRenderer.data["Social"] == Constants.SOCIAL_TOBACCO_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = model.historyMediumTypesDTOData.TobaccoList;
						}
						else if(event.itemRenderer.data["Social"] == Constants.SOCIAL_HISTORY_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = null;
						}
						else if(event.itemRenderer.data["Social"] == Constants.SOCIAL_MERITAL_STATUS_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = null;
						}
						else if(event.itemRenderer.data["Social"] == Constants.SOCIAL_WORK_STATUS_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = null;
						}
						else if(event.itemRenderer.data["Social"] == Constants.SOCIAL_OTHER_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = null;
						}
						
					}
					catch(error:*)
					{
						
					}
				}
					
				else if(event.columnIndex == 6)
				{
					try
					{
						trace("Social: ",event.itemRenderer.data["Social"]);					
						if(event.itemRenderer.data["Social"] == Constants.SOCIAL_ALCOHOL_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = model.usageAmountDTOData.AlcoholList;
						}
						else if(event.itemRenderer.data["Social"] == Constants.SOCIAL_DRUGS_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = model.usageAmountDTOData.DrugsList;
						}
						else if(event.itemRenderer.data["Social"] == Constants.SOCIAL_TOBACCO_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = model.usageAmountDTOData.TobacooList;
						}
						else if(event.itemRenderer.data["Social"] == Constants.SOCIAL_HISTORY_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = null;
						}
						else if(event.itemRenderer.data["Social"] == Constants.SOCIAL_MERITAL_STATUS_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = null;
						}
						else if(event.itemRenderer.data["Social"] == Constants.SOCIAL_WORK_STATUS_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = null;
						}
						else if(event.itemRenderer.data["Social"] == Constants.SOCIAL_OTHER_MODULE_NAME)
						{
							SparkComboBoxItemEditor(id_DataGrid.itemEditorInstance).id_ComboEditor.dataProvider = null;
						}
						
					}
					catch(error:*)
					{
						
					}
				}
				else if (event.columnIndex == 7)
				{
