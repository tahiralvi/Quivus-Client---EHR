			private function preInitializeHandler():void
			{
				if (!deleteColumnData)
					deleteColumnData = {};
				
				deleteColumnData["noteDataFields"] = {subject: "", note: "Note", header: "Social", statusFunction:RecordLevelNotesStatus};
				deleteColumnData["dictationDataField"] = "DictationId";
				deleteColumnData["recordIDField"] = "PatientSocialHistoryID";
				deleteColumnData["section"] = QIPopUpManager.VB_COMPREHENSIVE_HISTORY;
			}
			
			private function RecordLevelNotesStatus(hasNotes:Boolean, data:Object):void
			{
				if( hasNotes ) 
					data.Status = Constants.STRING_FALSE;
				else
					data.Status = Constants.STRING_TRUE;
				
				model.socialHistoryDTOListByPatient.refresh();
			}
			
			protected function button1_clickHandler(event:MouseEvent):void
			{
				if(model.socialHistoryDTOListByPatient!=null){
					model.socialHistoryDTOListByPatient.filterFunction=myFilter;
					model.socialHistoryDTOListByPatient.refresh();
				}
			}
			
			private function myFilter(obj:*):Boolean
			{
				if(model.vbFilter == Constants.BY_VISIT)
				{
					if(model.vbVisitId == obj.VisitID)
					{
						return true;
					}
					else
					{
						return false;
					}
				}
				
				//var a:SocialhistoryVBDTO = new SocialHistoryVBDTO();
				//a.EndDate
				
				return true;
				
			}
			
			protected function getCurrentLabel(obj:Object, dgc:DataGridColumn):String
			{
				if( obj.Current == Constants.STRING_YES_UI )
					return "Present";
				if( obj.Current == Constants.STRING_NO_UI )
					return "Past";
				
				return "";
			}
			private function setVisitDate(oItem:Object,iCol:int):String
			{
				var strVisitDate:String = '';
				
				if (oItem && oItem.VisitDate)
				{
					var dateRecieved:Date = new Date(Date.parse(oItem.VisitDate));
					strVisitDate = formatDateTime.format(dateRecieved);
					var nullDate:Date = Constants.NULL_DATE;
					
					if (dateRecieved.getFullYear() <= nullDate.getFullYear() && dateRecieved.getMonth() <= nullDate.getMonth())
						strVisitDate = "";
					
					if(oItem.IsNA)
						strVisitDate = 'N/A';
				}
				return strVisitDate;
			}
			
