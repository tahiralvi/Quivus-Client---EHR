			private function deleteRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.VB_COMPREHENSIVE_HISTORY ) )//Tahir Alvi - implement security check 
				{
					var curTar:LabelDataGrid = LabelDataGrid(event.currentTarget);
					
					if (curTar.selectedItem)
					{
						var fhID:int = SocialhistoryVBDTO(curTar.selectedItem).PatientSocialHistoryID;
						
						if (fhID == 0)
						{
							model.socialHistoryDTOListByPatient.removeItemAt(curTar.selectedIndex);
							if (model.socialHistoryDTOListByPatient.length <= 0)
							{
								_hasGridChanged = false;
								//hasViewChanged = isGetEdited();
							}
						}
						else
						{
							UtilityFunctions.AskMessage(  "Do you want to delete selected record", function():void
							{
								curTar.selectedItem.IsDeleted = true;
								curTar.selectedItem.IsDirty = true;
								model.socialHistoryDTOListByPatient.filterFunction = filterDeletedItems;
								model.socialHistoryDTOListByPatient.refresh();
								
								hasViewChanged = _hasGridChanged = true;
							});
						}
					}
					
				}
				
			}
			
			private function filterDeletedItems(item:Object):Boolean
			{
				var b:Boolean = item["IsDeleted"];
				return (!b);
			}
			
			public function GridRowNumber(oItem:Object, iCol:int):String
			{
				var ret:String;
				try
				{
					var rowNumber:int = id_DataGrid.dataProvider.getItemIndex(oItem) + 1; //Sort able column fails some how, don't know why?
					ret = String(rowNumber);
				}
				catch(e:Error )
				{
					ret = "##";
				}
				return ret;
			}
			
