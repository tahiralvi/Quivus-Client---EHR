			private function setYesNoValue(value:String):void
			{
				var elm:TabSectionImpl = ( id_Views.selectedChild as NavigatorContent).getElementAt( 0 ) as TabSectionImpl;
				
				elm.id_View.Label = "You have selected \n" + value;
				elm.id_View.IsSelected = (value == Constants.STRING_YES_UI) ? true:false;
				
				elm.FamilyHistoryDto.IsYesSelected = (value == Constants.STRING_YES_UI)? Constants.STRING_TRUE:Constants.STRING_FALSE;
				
				if( value == Constants.STRING_NO_UI )
				{
					elm.id_Views.selectedIndex = 0;
				}
				else
				{
					elm.id_View.id_DetailsView.id_ICDCode.setFocus();
				}
			}
			
			private function OnTabClick(event:MouseEvent, secLabel:String):void
			{
				setSelectedTab( secLabel );
			}

			private function setSelectedTab(tabName:String):void
			{
				switch(  AppUtils.TitleCase( tabName ) )
				{
					case Constants.FAMILY_HEARTDISEASE_MODULE_NAME:
						id_Views.selectedIndex = 0;
					break;
					case Constants.FAMILY_HYPERTENSION_MODULE_NAME:
						id_Views.selectedIndex = 1;
					break;
					case Constants.FAMILY_DIABETES_MODULE_NAME:
						id_Views.selectedIndex = 2;
					break;
					case Constants.FAMILY_CANCER_MODULE_NAME:
						id_Views.selectedIndex = 3;
					break;
					case Constants.FAMILY_OTHER_MODULE_NAME:
						id_Views.selectedIndex = 4;
					break;
					
				}
				
				//AppUtils.EnableSelection( id_TabButtons, AppUtils.getButtonByLabel( id_TabButtons, tabName )  );
				callLater( AppUtils.EnableSelection, [ id_TabButtons, AppUtils.getButtonByLabel( id_TabButtons, tabName ) ] );
			}
			
			public override function set AllowContents(value:Boolean):void
			{
				super.AllowContents 		= value;
				
				if( !value )
					DeselectAllButtons();
				
				if( id_Views )
				{
					id_Views.visible 			= value;
					id_Views.includeInLayout	= value;
					
					if( value )
					{
						setSelectedTab( id_Views.selectedChild.label );
						BindTabData( id_Views.selectedChild.label );
					}
					
					/* if( ! model.isNewVisitCreated && value  ) //load data if not new visit
					{
						LoadData();
						BindTabData( Constants.FAMILY_HEARTDISEASE_MODULE_NAME );
					} */
				}
			}
			
			private function DeselectAllButtons():void
			{
				if( id_tab1 != null )
				{
					id_tab1.id_MainButton.selected = false;
					id_tab2.id_MainButton.selected = false;
					id_tab3.id_MainButton.selected = false;
					id_tab4.id_MainButton.selected = false;
					id_tab5.id_MainButton.selected = false;
				}
			}
			
			
			public function set selectFirstTab( value:Boolean ):void
			{
				if( value )
				{
					BindTabData( Constants.FAMILY_HEARTDISEASE_MODULE_NAME );
					setSelectedTab( Constants.FAMILY_HEARTDISEASE_MODULE_NAME );
				}
				isFirstTabSelected = value;
			}
			
			public function get selectFirstTab():Boolean
			{
				return isFirstTabSelected;
			}


