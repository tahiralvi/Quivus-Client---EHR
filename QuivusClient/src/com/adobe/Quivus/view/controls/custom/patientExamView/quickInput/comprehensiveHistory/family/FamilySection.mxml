			private function isPreviousYesValue():Boolean
			{
				var hasYes:Boolean = false;
				var i:int;
				for( i = 0; i < model.familyHistoryDTOListByPatient.length; i++ )
				{
					var dto:FamilyHistoryDTO = model.familyHistoryDTOListByPatient.getItemAt( i ) as FamilyHistoryDTO;
					hasYes = dto.IsYesSelected != Constants.STRING_FALSE;
					if( hasYes )
						break;
				}
				return hasYes;
			}
			
			
			private function OnYesNoClick(value:String, secLabel:String, target:OptionButton):void
			{
				setSelectedTab( secLabel );
				
				hasChange = true;
				
				
				/* callLater( function():void 
				{ */
					var elm:TabSectionImpl = (id_Views.selectedChild as NavigatorContent).getElementAt( 0 ) as TabSectionImpl;
					if( null == elm.FamilyHistoryDto )
						BindTabData( id_Views.selectedChild.label );
					
					if( ( isPreviousYesValue() || elm.FamilyHistoryDto.PatientDiseaseList.length > 0 ) && value == Constants.STRING_NO_UI )
					{
						var strAlertMessage:String = "Do you want to delete"+" "+secLabel+" "+" history?";//Tahir Alvi
						Alert.show(strAlertMessage,"Clear Data", Alert.YES|Alert.NO, 
							FlexGlobals.topLevelApplication.mainContainer, function(event:CloseEvent):void
							{
								if( event.detail == Alert.YES)
								{
									/* elm.medicalHistoryDto.MedicalHistoryNote = "";
									elm.id_NotesView.id_TextArea.text 		 = "";
									elm.medicalHistoryDto.IsNone = Constants.STRING_TRUE; */
									elm.FamilyHistoryDto.PatientDiseaseList.removeAll();
									
									/* changeTabYesNoSkin(elm.id); */
									
									//UtilityFunctions.AskMessage( "Do you realy want to delete previously \"Yes\" Selected data?", function():void 
									//{
										var family_section:int = 2;
										var delEve:DeleteComprehensiveModuleDatabyPatientIDEvent = new DeleteComprehensiveModuleDatabyPatientIDEvent( model.familyHistoryDTOListByPatient,
																														model.quickInputDTO.PatientId, family_section, 
																														elm.FamilyHistoryDto.FamilyHistoryTypeID,
																														model.userSelectedClinicBranchDTO.ClinicBranch.ClinicBranchIdSeq 
																														,loadData);
										CairngormEventDispatcher.getInstance().dispatchEvent( delEve );
									//});
									setYesNoValue(value);
								}
								else if( event.detail == Alert.NO)
								{
									setYesNoValue(Constants.STRING_YES_UI);
									target.id_Y.selected = true;
									target.id_N.selected = false;
								}
								
							});
					}
					else
					{
						setYesNoValue(value);
					}
					elm.FamilyHistoryDto.IsYesSelected = (value == Constants.STRING_YES_UI)? Constants.STRING_TRUE:Constants.STRING_FALSE;
				/* }); */
				
				elm.id_View.id_DetailsView.id_ICDCode.setFocus();
				dispatchEvent( new Event("data_added", true, true) );
			}
			
			// Tahir Alvi -- response of delete records from general history
