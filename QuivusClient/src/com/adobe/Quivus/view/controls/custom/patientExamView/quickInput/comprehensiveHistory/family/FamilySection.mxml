			private function BindTabData(tabName:String):void
			{
				switch( AppUtils.TitleCase( tabName ) )
				{
					case Constants.FAMILY_HEARTDISEASE_MODULE_NAME:
						//if( ! id_HeartDisease.FamilyHistoryDto )
							id_HeartDisease.FamilyHistoryDto = QSUtilityFunctions.getFamilyHistoryDTO(  Constants.FAMILY_HEART_DISEASE_MODULE_NAME );
							id_HeartDisease.id_View.id_DetailsView.id_TypeOfDisease.dataProvider = model.heartDiseaseDiseaseTypesDTOList ;
						break;
					case Constants.FAMILY_HYPERTENSION_MODULE_NAME:
						//if( ! id_Hypertension.FamilyHistoryDto )
							id_Hypertension.FamilyHistoryDto = QSUtilityFunctions.getFamilyHistoryDTO(  Constants.FAMILY_HYPERTENSION_MODULE_NAME );
							id_Hypertension.id_View.id_DetailsView.id_TypeOfDisease.dataProvider = model.hypertensionDiseaseTypesDTOList ;
						break;
					case Constants.FAMILY_DIABETES_MODULE_NAME:
						//if( ! id_Diabetes.FamilyHistoryDto )
							id_Diabetes.FamilyHistoryDto = QSUtilityFunctions.getFamilyHistoryDTO(  Constants.FAMILY_DIABETES_MODULE_NAME );
							id_Diabetes.id_View.id_DetailsView.id_TypeOfDisease.dataProvider = model.diabetesDiseaseTypesDTOList ;
						break;
					case Constants.FAMILY_CANCER_MODULE_NAME:
						//if( ! id_Cancer.FamilyHistoryDto )
							id_Cancer.FamilyHistoryDto = QSUtilityFunctions.getFamilyHistoryDTO(  Constants.FAMILY_CANCER_MODULE_NAME );
							id_Cancer.id_View.id_DetailsView.id_TypeOfDisease.dataProvider = model.cancerDiseaseTypesDTOList ;
						break;
					case Constants.FAMILY_OTHER_MODULE_NAME:
						//if( ! id_Other.FamilyHistoryDto )
							id_Other.FamilyHistoryDto = QSUtilityFunctions.getFamilyHistoryDTO(  Constants.FAMILY_OTHER_MODULE_NAME );
							id_Other.id_View.id_DetailsView.id_TypeOfDisease.dataProvider = model.otherDiseaseTypesDTOList ;
						break;
				}
			}
			
