			private function procedureCollectionChangeHandler(event:CollectionEvent):void
			{
				switch(event.kind)
				{
					case CollectionEventKind.ADD:
						includeGridInLayout = true;
						break;
					
					case CollectionEventKind.REMOVE:
						if (procedureCollection && procedureCollection.length < 1)
							includeGridInLayout = false;
						break;
				}
				
				if(procedureCollection)
				{
					if(procedureCollection.length > 1)
						hasViewChanged = true;
					else if(procedureCollection.length < 1)
						hasViewChanged = false;
				}
			}
			
			private var _procedureCollection:ArrayCollection;
			
			[Bindable]
			public function get procedureCollection():ArrayCollection
			{
				return _procedureCollection;
			}
			
			public function set procedureCollection(value:ArrayCollection):void
			{
				_procedureCollection = value;
				
				if (_procedureCollection)
				{
					_procedureCollection.addEventListener(CollectionEvent.COLLECTION_CHANGE, procedureCollectionChangeHandler, false, 0, true);
					
					if (_procedureCollection.length)
						includeGridInLayout = true;
						
					else
						includeGridInLayout = false;		
				}
				else
					includeGridInLayout = false;
			}
			
			[Bindable]
			public function get includeGridInLayout():Boolean
			{
				return _includeInLayout;
			}
			
			public function set includeGridInLayout(value:Boolean):void
			{
				if (_includeInLayout != value)
				{
					_includeInLayout = value;
					_includeInLayoutChanged = true;
					
					invalidateProperties();
					invalidateSize();
					invalidateDisplayList();
				}
			}
			
			private function procedureItemEditBeginHandler(event:DataGridEvent):void
			{
				var searchString:String = event.itemRenderer.data.CPTMedicalType.ProcedureCode;
				
