			private function validateCPTCode():void
			{
				if (id_CPTCode.selectedItem)
				{
					var selectedItem:CPTMedicalTypeDTO = id_CPTCode.selectedItem as CPTMedicalTypeDTO;
					
					if (selectedItem)
					{
						id_Procedure.selectedItem = selectedItem;
						_previouslySelectedItem = id_Procedure.selectedItem;
					}
					else
					{
						id_CPTCode.selectedItem = _previouslySelectedItem;
						id_Procedure.selectedItem = _previouslySelectedItem;
					}
				}
				
				id_Add.enableAll = !isInvalid();
			}
			
			private function validateProcedure():void
			{
				if (id_Procedure.selectedItem)
				{
					var selectedItem:CPTMedicalTypeDTO = id_Procedure.selectedItem as CPTMedicalTypeDTO;
					
					if (selectedItem)
					{
						id_CPTCode.selectedItem = selectedItem;
						_previouslySelectedItem = selectedItem;
					}
					else
					{
						id_CPTCode.selectedItem = _previouslySelectedItem;
						id_Procedure.selectedItem = _previouslySelectedItem;
					}
				}
				
				id_Add.enableAll = !isInvalid();
			}
			
			private function addRecordClickHandler():void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_PROCEDURES ) )//Tahir Alvi - implement security check 
				{
					id_Add.enableAll = !isInvalid();
					if( ! id_add.enabled )
					{
						return; // invalid data
					}
					
					var procedureDTO:ProcedureDTO 	= new ProcedureDTO();
					//	procedureDTO.CPTMedicalType 	= id_CPTCode.selectedItem as CPTMedicalTypeDTO;
					procedureDTO.CPTMedicalType 	= selectedDTO;
					procedureDTO.CreatedAt 			= new Date();
					procedureDTO.CreatedBy 			= model.loggedInUserDTO.UserId;
					procedureDTO.DictationID 		= Constants.GUID_FORMAT;
					procedureDTO.ModifiedAt 		= Constants.NULL_DATE;
					if( model.visitDTO!=null)
					{
						procedureDTO.VisitID 		= model.visitDTO.VisitId;
						procedureDTO.VisitDate 		= model.visitDTO.VisitDate;
					}
					else if(model.quickInputDTO		!= null && model.quickInputDTO.Visit!=null)
					{
						procedureDTO.VisitID 		= model.quickInputDTO.Visit.VisitId;
						procedureDTO.VisitDate 		= model.quickInputDTO.Visit.VisitDate;
					}
					procedureDTO.PatientID 			= model.loadedPatientId;
					
					if (id_Add.notesDTO)
					{
						procedureDTO.Notes 			= id_Add.notesDTO.Note;
						procedureDTO.NoteSubject 	= id_Add.notesDTO.NoteSubject;
					}
					
					//H
					if (id_Add.dictationDTO 		&& id_Add.dictationDTO.DictationID != null)
					{
						procedureDTO.DictationID 	= id_Add.dictationDTO.DictationID;
					}
					
					if(model.quickInputDTO.Assessment	==	null)
						model.quickInputDTO.Assessment	= new AssessmentDTO();
					
					if(model.quickInputDTO.Assessment.Procedure	==	null)
						model.quickInputDTO.Assessment.Procedure = new ArrayCollection();
					
					model.quickInputDTO.Assessment.Procedure.addItem(procedureDTO);
					
					
					if(hasViewChanged)
						hasViewChanged = false;
					
					hasViewChanged = true;
					_hasGridChanged = true;
					
					resetFields();
					id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
					id_Add.id_WriteDictation.setStyle("skinClass", QIDictationBtn);
				}
			}
			
