			protected function id_CPTCode_clickHandler(event:MouseEvent, index:uint):void
			{
				if(event.target as RichEditableText || event.target as mx.controls.Label)
				{
					return;
				}
				else 
				{
					if(serachTerm == null)
						return
					
					if(serachTerm.length > 2)
					{
						openProcedurePopup(index);
					}
				}
			}
			
			private function openProcedurePopup(index:int):void
			{
				var procedurePopup:ProcedurePopup = new ProcedurePopup();
				procedurePopup.ShowPopup( this )
				procedurePopup.title  = "Add Procedure";
				procedurePopup.height = 410;
				procedurePopup.width  = 600;
				//procedurePopup.move(procedurePopup.x-90, procedurePopup.y - 37);
				procedurePopup.addEventListener(CloseEvent.CLOSE, function (event:CloseEvent):void
				{
					isGetEdited();
				});
				procedurePopup.move((Capabilities.screenResolutionX/4)-(procedurePopup.width/2), procedurePopup.y - 37);
				
				procedurePopup.searchAndLoadLabIn(serachTerm, index);
				resetFields();
			}
			
			private function testCodeKeyUpHandler():void
			{
				serachTerm = '';
				serachTerm = id_CPTCode.textInput.text;
				//if value exceeds 4 characters then search Icd Code and map the Icd Code.
				if(serachTerm.length >= 4)
				{
					id_Procedure.textInput.text 	= '';
					id_Procedure.selectedIndex 		= -1;
					selectedDTO 					= null;
					id_Add.enabled 					= isGetEdited();
					var cptEvent : LoadCPTMedicalTypesEvent = new LoadCPTMedicalTypesEvent(serachTerm, loadData);
					CairngormEventDispatcher.getInstance().dispatchEvent( cptEvent );
					
				}else{
					id_Procedure.textInput.text 	= '';
					id_Procedure.selectedIndex 		= -1;
					selectedDTO 					= null;
					id_Add.enabled 					= isGetEdited();
				}
			}
			
			private function testNameChangeHandler():void
			{
				serachTerm = '';
				serachTerm = id_Procedure.textInput.text;
			}
			
			public  function loadData(val:* = null):void
			{
				if(model.cptMedicalTypesDTOList.length)
				{
					for(var i:uint=0; i < model.cptMedicalTypesDTOList.length; i++)
					{
						if(serachTerm == model.cptMedicalTypesDTOList[i].ProcedureCode)
						{
							id_CPTCode.textInput.text 	= model.cptMedicalTypesDTOList[i].ProcedureCode;
							id_Procedure.textInput.text = model.cptMedicalTypesDTOList[i].ProcedureDescription;
							selectedDTO					= model.cptMedicalTypesDTOList[i];
							id_Add.enabled 				= isGetEdited();
							return;
						}							
					}
				}
			}
			
			
		]]>
	</fx:Script>
	<fx:Binding source="model.quickInputDTO.Assessment.Procedure" destination="procedureCollection"/>
	<s:layout>
		<s:VerticalLayout gap="2" paddingTop="5" paddingLeft="3" paddingRight="3" paddingBottom="0"/>
	</s:layout>
	
	
	
	<s:HGroup width="100%" verticalAlign="middle">
		<components1:LabelComboBox id="id_CPTCode" 
								  prompt="CPT Code" width="150"
								  useHandCursor="true" buttonMode="true"
								  keyUp="testCodeKeyUpHandler()" 
								  click="id_CPTCode_clickHandler(event, 0)"
								  skinClass="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.assessment.diagnosis.comboBoxSearchSkin" tabIndex="1"/>
		<components1:LabelComboBox id="id_Procedure" 
								  prompt="Procedure" width="100%"
								  useHandCursor="true" buttonMode="true"
								  keyUp="testNameChangeHandler()" 
								  click="id_CPTCode_clickHandler(event, 1)"
								  skinClass="com.adobe.Quivus.view.controls.custom.patientExamView.quickInput.assessment.diagnosis.comboBoxSearchSkin" tabIndex="2"/>
		<commons:AddRecord id="id_Add" writeNotesClick="onWriteNotesClick(event)"  writeDictationClick="writeDictationClickHandler(event)" tabIndex="3"
						   enabled="false" enableAll="false"/>
	</s:HGroup>
	<s:HGroup width="100%" gap="1" horizontalAlign="left">
		<s:Button id="id_add" click="addRecordClickHandler()" enabled="false" buttonMode="true" useHandCursor="true" toolTip="Add Record"
				  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.AddMoreTooltipBtn" label="Add Procedure" tabIndex="5"/>
		
		<s:SkinnableContainer skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.tooltipBG" visible="{!id_add.enabled}" width="100%"/>
		<mx:Spacer width="100%"/>
		<s:Button label="Next" skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.QInextBtnSkin" toolTip="Next Section" buttonMode="true" 
				  click="dispatchEvent( new SelectSection('SelectSection', 'id_TreatmentPanel', true, true) )"/>
		
	</s:HGroup>
	
	
	<components1:LabelDataGrid id="id_ProcedureGrid" width="100%" editable="false" rowCount="{id_ProcedureGrid.dataProvider.length + 1}" useRollOver="false"
							  dataProvider="{procedureCollection}" includeInLayout="{includeGridInLayout}" visible="{includeGridInLayout}"
							  itemEditBegin="procedureItemEditBeginHandler(event)" itemEditEnd="procedureItemEditHandler(event)"
							  verticalScrollPolicy="on" 
							  maxHeight="150" columnWidths="{[25,'20%','30%','25%',100]}">
		<components:columns>
			
			<mx:DataGridColumn headerText="Sr.#"  labelFunction="GridRowNumber" editable="false" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="Visit Date" editable="false" labelFunction="{ValidationUtils.displayVisitDateForGrid}" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn headerText="CPT" headerStyleName="true" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" dataField="CPTMedicalType.ProcedureCode" editorDataField="editorText">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor dataProvider="{outerDocument.model.cptMedicalTypesDTOList}" labelField="ProcedureCode" width="50"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn headerText="Procedure" dataField="CPTMedicalType.ProcedureDescription" editorDataField="editorText" itemRenderer="mx.controls.Label" headerWordWrap="true" wordWrap="true">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors:SparkComboBoxItemEditor dataProvider="{outerDocument.model.cptMedicalTypesDTOList}" labelField="ProcedureDescription"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<commons:DataGridColumnEx data="{deleteColumnData}" headerText="" editable="false" itemRenderer="com.gazuntite.patient.visit.view.itemrenderers.DeleteRecordRenderer"/>
		</components:columns>
	</components1:LabelDataGrid>
</s:Group>
