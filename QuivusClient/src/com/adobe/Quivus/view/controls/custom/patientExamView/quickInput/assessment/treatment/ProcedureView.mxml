				return edited;
			}
			
			public function isInvalid():Boolean
			{
				/* calling isGetEdited() to check whether is there any change in view or not
				just to set hasViewChanged boolean
				*/
				isGetEdited();
				
				var notValid:Boolean = false;
				
				if (!ValidationUtils.isValidValueSelected(id_CPTCode))
					notValid = true;
					
				else if (!ValidationUtils.isValidValueSelected(id_Procedure))
					notValid = true;
				
				return notValid;
			}
			
			public function showNotes(loc:Point):void
			{
				if (loc)
				{
					if( recordNotesPanel )
						recordNotesPanel.removePopup();
					
					if (!recordNotesDTO)
						recordNotesDTO = new ModuleNoteDTO();
					
					recordNotesPanel 					= new NotesPanel();
					recordNotesPanel.width			= 550
					recordNotesPanel.height			= 150
					recordNotesPanel.HeadingLable 	= id_Procedure.textInput.text;
					recordNotesPanel.VisitDateLable = model.FormatedVisitDate;
					recordNotesPanel.notesDTO	= recordNotesDTO;
					recordNotesPanel.ShowPopup( this );
					recordNotesPanel.move( loc.x, loc.y );
					
					recordNotesPanel.id_header.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						recordNotesPanel.SaveNotes();
						recordNotesPanel.removePopup();
						event.stopImmediatePropagation();
						
						
						if(recordNotesPanel.id_body.id_message.text.length > 0)
						{
							id_Add.id_WriteNotes.setStyle("skinClass", ImmunizationNotesFilledBtn);
							
						}
						else
						{
							id_Add.id_WriteNotes.setStyle("skinClass", ImmunizationWriteNotesBtn);
						}
					});
				}
			}
			
