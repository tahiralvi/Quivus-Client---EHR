				do_QSViewStateChangeHandler( event );
			}
			
			private function do_QSViewStateChangeHandler(event:QSViewStateEvent):void
			{
				if( currentExpandedPanel && currentExpandedPanel != event.currentTarget && 
					event.viewState == QSViewStateEvent.EXPANDED_VIEW &&
					!currentExpandedPanel.isSlideOut && !event.currentTarget.isSlideOut )
					currentExpandedPanel.ExpandedView = false;
				
				//ignore state change if panel is in SlideOut state
				if( currentExpandedPanel != event.currentTarget && !event.currentTarget.isSlideOut )
				{
					currentExpandedPanel = event.currentTarget as SlideOutPanel;
					setSelectedById( currentExpandedPanel.id );
				}
				
				//moverEffect2.target = event.currentTarget;
				//moverEffect2.play();
			}
			
			protected function QSSlideStateChangeHandler(event:QSViewStateEvent):void
			{
				if( currentSlideOutPanel && currentSlideOutPanel != event.currentTarget && 
					event.viewState == QSViewStateEvent.VIEW_SLIDE_OUT && currentSlideOutPanel.isSlideOut )
				{
					//currentSlideOutPanel.ToggleSlideOut();
					//currentSlideOutPanel["IsNotesPanelVisible"] = false;
				}
				
				currentSlideOutPanel = event.currentTarget as SlideOutPanel;
				if( event.viewState == QSViewStateEvent.VIEW_SLIDE_IN )
					currentSlideOutPanel.ExpandedView = true;
			}
			
			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				currentIndex ++ ;
				SelectNextByIndex();
				
				addEventListener("SelectSection", function(event:SelectSection):void
				{
					SelectNextByID( event.SectionID ) ;
					
				});
				
				id_QIAllergiesPanel.id_Header.id_CloseBtn.addEventListener( MouseEvent.CLICK, function(event:MouseEvent):void
				{
					event.stopImmediatePropagation();
					currentIndex = 2 ;
					SelectNextByIndex();
					id_QIAllergiesPanel.visible 			= !id_QIAllergiesPanel.visible;
					/* id_QIAllergiesPanel.includeInLayout 	= !id_QIAllergiesPanel.visible; */
					
					
					id_QIAllergiesBtn.setStyle("skinClass", QIAllergiesBtnDeletedSkin);
					
				});
				
				id_QIHistoryPanel.id_Header.id_CloseBtn.addEventListener( MouseEvent.CLICK, function(event:MouseEvent):void
				{
					event.stopImmediatePropagation();
					currentIndex = 3 ;
					SelectNextByIndex();
					id_QIHistoryPanel.visible 				= !id_QIHistoryPanel.visible;
					/* id_QIHistoryPanel.includeInLayout 		= !id_QIHistoryPanel.visible; */
					
					
					id_QIHistoryBtn.setStyle("skinClass", QIComprehensiveHistoryBtnDeletedSkin);
				});
				
				id_QIMedicationPanel.id_Header.id_CloseBtn.addEventListener( MouseEvent.CLICK, function(event:MouseEvent):void
				{
					event.stopImmediatePropagation();
					currentIndex = 4 ;
					SelectNextByIndex();
					id_QIMedicationPanel.visible 			= !id_QIMedicationPanel.visible;
					/* id_QIMedicationPanel.includeInLayout 	= !id_QIMedicationPanel.visible; */
					
					id_QIMedicationBtn.setStyle("skinClass", QIChronicMedicationBtnDeletedSkin);
				});
				
				id_QIImmunizationPanel.id_Header.id_CloseBtn.addEventListener( MouseEvent.CLICK, function(event:MouseEvent):void
				{
					event.stopImmediatePropagation();
					/* currentIndex = 2 ;
					SelectNextByIndex(); */
					id_QIImmunizationPanel.visible 			= !id_QIImmunizationPanel.visible;
					/* id_QIImmunizationPanel.includeInLayout 	= !id_QIImmunizationPanel.visible; */
					id_QIImmunizationBtn.setStyle("skinClass", QIImmunizationBtnDeletedSkin);
				});
			}
			
			/* private function HidePanel(event:MouseEvent):void
			{
			event.currentTarget.visible = false;
