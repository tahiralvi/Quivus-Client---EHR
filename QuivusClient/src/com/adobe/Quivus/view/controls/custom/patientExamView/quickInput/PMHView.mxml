			protected function QSViewStateChangeHandler(event:QSViewStateEvent):void
			{
				//For time Being commented ---- for proper and better solution
				/* if( currentExpandedPanel == id_QIImmunizationPanel && event.viewState == QSViewStateEvent.COLLAPSED_VIEW )
