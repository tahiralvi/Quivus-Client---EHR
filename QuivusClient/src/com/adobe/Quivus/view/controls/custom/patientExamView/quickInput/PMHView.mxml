			private function ShowPanel(event:MouseEvent):void
			{
				var btn:ToggleButton = event.currentTarget as ToggleButton;
				btn.selected = false;
				getCurrentSelectedPanel().AllowMoveToNextPanel( function():void
				{
					btn.selected = true;
					
					setSelectedById( btn.id );
				});
			}
			
			private function getCurrentSelectedPanel():PinableSlideOutPanel
			{
				if( id_QIAllergiesPanel.ExpandedView )
				{
					return id_QIAllergiesPanel;
				}
				else if( id_QIHistoryPanel.ExpandedView )
				{
					return id_QIHistoryPanel;
				}
				else if( id_QIMedicationPanel.ExpandedView )
				{
					return id_QIMedicationPanel;
				}
				else if( id_QIImmunizationPanel.ExpandedView )
				{
					return id_QIImmunizationPanel;
				}
				
				return id_QIHistoryPanel;
			}
			
			private function inActivateBorders():void 
			{				
				/* id_AllergiesBorder.setStyle("borderAlpha", false);
				id_QHistoryBorder.setStyle("borderAlpha", false);
				id_QIMedicationBorder.setStyle("borderAlpha", false);
				id_QIImmunizationBorder.setStyle("borderAlpha", false); */
				id_QIAllergiesPanel.ShowFocusBorder		= false;
				id_QIHistoryPanel.ShowFocusBorder 		= false;
				id_QIMedicationPanel.ShowFocusBorder	= false;
				id_QIImmunizationPanel.ShowFocusBorder 	= false;
			}
			private function setSelectedById(tabId:String):void
			{
				DeSelectAllNavButton();
				
				switch( tabId )
				{
					case "id_QIAllergiesBtn":
					case "id_QIAllergiesPanel":
						inActivateBorders();
						id_QIAllergiesBtn.selected				= true;
						id_QIAllergiesPanel.ExpandedView 		= true;
						//id_QIAllergiesPanel.ShowFocusBorder		= true;
						id_QIAllergiesPanel.visible				= true;
						id_QIAllergiesPage.selected				= true;
						currentIndex							= 1;
						
						id_QIAllergiesBtn.setStyle("skinClass", QIAllergiesBtn);
						
						id_Scroller.viewport.verticalScrollPosition = 5;
						
						//Tahir Alvi - on load Qi manage Allergy UI
						if(model.QIAllergyDTOList && model.QIAllergyDTOList.length > 0)
						{
							if( (model.QIAllergyDTOList[0] as AllergDTO).isNKDA)
							{
								id_QIAllergiesPanel.id_isNKDA.selected 			= true;
								id_QIAllergiesPanel.id_onSet.enabled 			= false;
								id_QIAllergiesPanel.id_allergyList.enabled 		= false;
								id_QIAllergiesPanel.id_reaction.enabled 		= false;						
								id_QIAllergiesPanel.id_Yes.enabled 				= false;
								id_QIAllergiesPanel.id_No.enabled 				= false;
								id_QIAllergiesPanel.id_AllergiesGrid.visible 	= false;
								id_QIAllergiesPanel.id_nkda.visible 			= true;
							}else
							{
								id_QIAllergiesPanel.id_AllergiesGrid.visible 	= true;
								id_QIAllergiesPanel.id_isNKDA.selected 			= false;
								id_QIAllergiesPanel.id_allergyList.enabled 		= true;
								id_QIAllergiesPanel.id_reaction.enabled 		= true;						
								id_QIAllergiesPanel.id_Yes.enabled 				= true;
								id_QIAllergiesPanel.id_No.enabled 				= true;
								id_QIAllergiesPanel.id_nkda.visible 			= false;
								
							}
						}else
						{
							id_QIAllergiesPanel.id_AllergiesGrid.visible 			= false;
							id_QIAllergiesPanel.id_AllergiesGrid.includeInLayout  = false;
							id_QIAllergiesPanel.id_nkda.visible 			= false;
						}
						break;
					
					case "id_QIHistoryBtn":
					case "id_QIHistoryPanel":
						inActivateBorders();
						id_QIHistoryBtn.selected				= true;
						id_QIHistoryPanel.ExpandedView 			= true;
						//id_QIHistoryPanel.ShowFocusBorder 		= true;
						id_QIHistoryPanel.visible		 		= true;
						id_QIHistoryPage.selected				= true;
						
						id_QIHistoryPanel.id_HistoryView.id_GeneralSection.selectFirstTab = true;
						
						id_QIHistoryBtn.setStyle("skinClass", QIComprehensiveHistoryBtn);
						currentIndex							= 2;
						
						if( checkPinAll() )
							id_Scroller.viewport.verticalScrollPosition = id_QIAllergiesPanel.height;
						else
							id_Scroller.viewport.verticalScrollPosition = id_QIAllergiesPanel.height + 25;
						
						break;
					
					case "id_QIMedicationBtn":
					case "id_QIMedicationPanel":
						inActivateBorders();
						id_QIMedicationBtn.selected				= true;
						id_QIMedicationPanel.ExpandedView 		= true;
						//id_QIMedicationPanel.ShowFocusBorder	= true;
						id_QIMedicationPanel.visible		 	= true;
						id_QIMedicationPage.selected			= true;
						
						
						id_QIMedicationBtn.setStyle("skinClass", QIChronicMedicationBtn);
						currentIndex							= 3;
						
						if( checkPinAll() )
							id_Scroller.viewport.verticalScrollPosition = id_QIAllergiesPanel.height + 45;
						else
							id_Scroller.viewport.verticalScrollPosition = id_QIAllergiesPanel.height + id_QIHistoryPanel.height;
						
						break;
					
					case "id_QIImmunizationBtn":
					case "id_QIImmunizationPanel":
						inActivateBorders();
						id_QIImmunizationBtn.selected			= true;
						id_QIImmunizationPanel.ExpandedView 	= true;
						//id_QIImmunizationPanel.ShowFocusBorder 	= true;
						id_QIImmunizationPanel.visible		 	= true;
						id_QIImmunizationPage.selected			= true;
						
						id_QIImmunizationPanel.id_ImmunizationBodyView.id_AssociateVisitzCombo.setFocus();
						
						id_QIImmunizationBtn.setStyle("skinClass", QIImmunizationBtn);
						currentIndex							= 4;
						
						if( checkPinAll() )
							id_Scroller.viewport.verticalScrollPosition = id_QIAllergiesPanel.height + id_QIHistoryPanel.height + id_QIMedicationPanel.height;
						else
							id_Scroller.viewport.verticalScrollPosition = id_QIMedicationPanel.height + 65;
						
						break;
					
				}
				trace( "selected index", currentIndex );
			}
			
			private function SelectNextByIndex():void
			{
				if( currentIndex == 0 )
					currentIndex = 4;
				
				switch( currentIndex )
				{
					case 1:
						setSelectedById( "id_QIAllergiesBtn" );
						break;
					case 2:
						setSelectedById( "id_QIHistoryBtn" );
						break;
					case 3:
						setSelectedById( "id_QIMedicationBtn" );
						break;
					case 4:
						setSelectedById( "id_QIImmunizationBtn" );
						break;
					
					default:
						setSelectedById( "id_QIAllergiesBtn" );
						break;
				}
			}
			
			private function SelectNextByID( sectionID:String ):void
			{
				removeAllPopups();
				
				switch( sectionID )
				{
					case "id_QIImmunizationPanel":
						setSelectedById( "id_QIAllergiesBtn" );
						break;
					case "id_QIAllergiesPanel":
						setSelectedById( "id_QIHistoryBtn" );
						break;
					case "id_QIHistoryPanel":
						setSelectedById( "id_QIMedicationBtn" );
						break;
					case "id_QIMedicationPanel":
						setSelectedById( "id_QIImmunizationBtn" );
						break;
					
					default:
						setSelectedById( "id_QIAllergiesBtn" );
						break;
				}
			}
			
			private function DeSelectAllNavButton():void
			{
				id_QIAllergiesBtn.selected		=	false;
				id_QIHistoryBtn.selected		=	false;
				id_QIMedicationBtn.selected		=	false;
				id_QIImmunizationBtn.selected	=	false;
			}
			
			
			
			protected function pagination_itemClickHandler(event:ItemClickEvent):void
			{
				getCurrentSelectedPanel().AllowMoveToNextPanel( function():void
				{
					setSelectedById( event.item as String );
				});
			}
			
			
			protected function next_clickHandler(event:MouseEvent):void
			{
				currentIndex += 1 ;
				SelectNextByIndex()
			}
			
			
			protected function previous_clickHandler(event:MouseEvent):void
			{
				currentIndex -= 1 ;
				SelectNextByIndex()
			}
			
			
			public function ScrollUp():void
			{
				id_Scroller.viewport.verticalScrollPosition = id_Scroller.viewport.verticalScrollPosition + 15;
				removeAllPopups();
			}
			
			public function ScrollDown():void
			{
				id_Scroller.viewport.verticalScrollPosition = id_Scroller.viewport.verticalScrollPosition - 15;
				removeAllPopups();
			}
			
			public function PinAll( value:Boolean ):void
			{
				id_QIAllergiesPanel.PinView 						= value;
				id_QIAllergiesPanel.id_Header.id_Pin.selected 		= value;
				
				id_QIImmunizationPanel.PinView 						= value;
				id_QIImmunizationPanel.id_Header.id_Pin.selected 	= value;
				
				id_QIHistoryPanel.PinView 							= value;
				id_QIHistoryPanel.id_Header.id_Pin.selected 		= value;
				
				id_QIMedicationPanel.PinView 						= value;
				id_QIMedicationPanel.id_Header.id_Pin.selected 		= value;
				
				if( !value )
					currentExpandedPanel.ExpandedView = true;
				
				removeAllPopups();
			}
			
			public function checkPinAll():Boolean
			{
				return id_QIAllergiesPanel.PinView 	&&
					id_QIImmunizationPanel.PinView 	&&
					id_QIHistoryPanel.PinView 		&&
					id_QIMedicationPanel.PinView 	;
				
			}
			
			public function removeAllPopups():void
			{
				id_QIAllergiesPanel.AllowOtherPopup		= false;
				id_QIHistoryPanel.AllowOtherPopup		= false;
				id_QIImmunizationPanel.AllowOtherPopup	= false;
				id_QIMedicationPanel.AllowOtherPopup	= false;
			}
			
		]]>
	</fx:Script>
	
