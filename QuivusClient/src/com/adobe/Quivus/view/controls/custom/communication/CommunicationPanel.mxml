			private function ShowVideoPopup(panel:IVisualElement):void
			{
				ChromeUtil.restoreDefault();
				var win:PopupWindow = new PopupWindow();
				win.addElement( panel );
				win.width = 500 ;
				win.title ="Video Chat" ;
				win.height = 470;
				win.ShowPopup( this );
				win.move(Capabilities.screenResolutionX/2 + 10,60);
				win.addEventListener(CloseEvent.CLOSE,onVideoClose);
				CommunicationConstant.ISVIDEOCALL_ACTIVE = true;
				id_commInternalHeader.id_VideoChatBtn.enabled = !CommunicationConstant.ISVIDEOCALL_ACTIVE;
				//var notificationEvent:VideoCallNotificationEvent = new VideoCallNotificationEvent(
				
			}	
			
			private function onVideoClose(event:CloseEvent):void
			{
				if(idVideoChat.id_html != null)
				{
					idVideoChat.id_html.location  = Constants.VIDEO_CHAT_OUTGOING_URL+"?InitiatorID="+model.loggedInUserDTO.UserId+"&RecieverID="+userID+"&videoChatID=000&EndsessionID=00";
				}
				
				CommunicationConstant.ISVIDEOCALL_ACTIVE = false;
				id_commInternalHeader.id_VideoChatBtn.enabled = !CommunicationConstant.ISVIDEOCALL_ACTIVE;
				trace("Communication Panel: onVideoClose");
				/* var getSessionEvent:GetIncomingVideoChatSessionEvent=new GetIncomingVideoChatSessionEvent(model.loggedInUserDTO.UserId,model.userSelectedStationDTO.ClinicBranchID,getVideoCallDetailsDetails);
