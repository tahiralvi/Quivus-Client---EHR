			protected function searchproviderview1_LoadClinicUserDetailsEventHandler(event:ListVieClickEvent):void
			{
				//id_searchProviderView.
				if(id_MainCommView.selectedIndex > 0)
				id_MainCommView.selectedIndex=0;
				
				Heading="Profile";
				if(event.userId > 0)
				userID = event.userId;
				EmailAddress = EmailAddress;
				clinicBranchID = event.branchId.toString();
				
				if(idVideoChat != null)
					idVideoChat.isNewCall=false;
				
				var clinicuserIDevent: GetClinicUserIDEvent = new GetClinicUserIDEvent(event.userId,event.branchId, false, getProviderDetails);
				CairngormEventDispatcher.getInstance().dispatchEvent(clinicuserIDevent);
			}
			
			private function getProviderDetails(val:* = null):void
			{
				ProviderName = model.SearchProviderDetailsResults.FirstName +' '+model.SearchProviderDetailsResults.MiddleName+' '+ model.SearchProviderDetailsResults.LastName ; 
				id_communication.EmailAddress = model.SearchProviderDetailsResults.UserEmail;
				id_communication.userID = model.SearchProviderDetailsResults.userID;
				userSessionStatus = model.SearchProviderDetailsResults.sessionStatus;
				skinChange();
				
				if(model.SearchProviderDetailsResults.userID > 0)
					id_commInternalHeader.id_optionsBtn.enabled= true;
				else if(model.SearchProviderDetailsResults.userID > 0)
					id_commInternalHeader.id_optionsBtn.enabled= false;
			}

			private function skinChange () :void
			{
				if(userSessionStatus == "Available")
				{
					id_commInternalHeader.statusImage.visible 	  =true ;
					id_commInternalHeader.statusImage.source      = "com/adobe/Quivus/view/controls/skins/assets/available.png";
				}
				
				else if(userSessionStatus == "Offline")
				{
					id_commInternalHeader.statusImage.visible		=true ;
					id_commInternalHeader.statusImage.source 	    ="com/adobe/Quivus/view/controls/skins/assets/invisible.png" ;
				}
					
			
				else if(userSessionStatus == "Busy")
				{
					id_commInternalHeader.statusImage.visible 	    =true ;
					id_commInternalHeader.statusImage.source 	    ="com/adobe/Quivus/view/controls/skins/assets/busy.png" ;
				}
					
			
				else if(userSessionStatus == "Away")
				{
					id_commInternalHeader.statusImage.visible 	   =true ;
					id_commInternalHeader.statusImage.source       = "com/adobe/Quivus/view/controls/skins/assets/away.png";
				}
					
				else 
					id_commInternalHeader.statusImage.visible   =false ;
				
			}
