	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<custom:HeaderContents>
		<s:Group width="100%" height="22">
			<s:layout>
				<s:VerticalLayout paddingLeft="{isSlideOut? 5:0}" horizontalAlign="center" />
			</s:layout>
			
			<communication:CommunicationHeaderView id="id_header" minWidth="560" width="100%" height="22" />
			<mx:Spacer width="2" />
		</s:Group>
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		<s:SkinnableContainer height="22" width="100%" minWidth="550" styleName="lightPurpleHeaderBGContainerSkin">
			<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="center" >
				<s:Label paddingLeft="12" color="#ffffff" paddingTop="6" fontFamily="Calibri Bold" text="COMMUNICATIONS" />
			</s:HGroup>
		</s:SkinnableContainer>
	</custom:SlideHeaderContents>
	<custom:Contents>
		
		<s:VGroup gap="0" height="100%" width="{id_header.width}" verticalAlign="top" horizontalAlign="center"
				  paddingLeft="{isSlideOut? 10:0}" maxHeight="450"  >
			
			<s:BorderContainer height="100%" width="100%" cornerRadius="3" backgroundColor="#999AAA" borderAlpha="0" borderColor="#999AAA">
				<s:filters>
				<s:GlowFilter blurX="5" blurY="5" color="#00d2ff" inner="true" strength="5" alpha="1.0" quality="2" knockout="false"   />
					</s:filters>
					<s:layout>
					<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" gap="2"/>
				</s:layout>
				
				<s:HGroup height="100%" width="100%" >
					<s:SkinnableContainer width="30%" id="searchContainer" height="100%" styleName="gradientGreyHeaderWhiteBGContainerSkin">
						<view6:SearchProviderView id="id_searchProviderView" userID="{model.loggedInUserDTO.UserId}" LoadClinicUserDetailsEvent="searchproviderview1_LoadClinicUserDetailsEventHandler(event)" width="{searchContainer.width}" height="100%" />
					</s:SkinnableContainer>
					<s:SkinnableContainer width="70%" height="100%" styleName="gradientGreyHeaderWhiteBGContainerSkin" id="contactsContainer">
						<s:layout>
							<s:VerticalLayout gap="1" paddingBottom="5" paddingLeft="3" paddingRight="3" paddingTop="10"/>
						</s:layout>
						
						<communication:CommunicationInternalHeaderView id="id_commInternalHeader" ProviderName="{ProviderName}"
																	   Heading="{Heading}" sessionStatus="{userSessionStatus}" width="100%"/>
						<mx:ViewStack id="id_MainCommView" width="100%" height="100%" creationPolicy="all" >
							<s:NavigatorContent width="100%" height="100%" >
								<view2:clinicUserBasicInformation id="id_UserBasicInfo" width="100%" height="100%" />
							</s:NavigatorContent>
							<s:NavigatorContent width="100%" height="100%" >
								<view4:CommunicationView id="id_communication" width="100%" height="100%"
														EmailAddress="{EmailAddress}" userID="{userID}"/>
							</s:NavigatorContent>
							<s:NavigatorContent width="100%" height="100%">
								<view5:SMSView id="id_smsView" userID="{userID}" senderID="{model.loggedInUserDTO.UserId}" 
											   BranchID="{model.userSelectedStationDTO.ClinicBranchID.toString()}" width="100%" height="100%"/>
							</s:NavigatorContent>
							<!--<s:NavigatorContent width="100%" height="100%">
								<videochat:VideoChatView id="id_VideoChat" clinicBranchID="{clinicBranchID}" currentLoggedInUserID="{model.loggedInUserDTO.UserId}" userID="{userID}" width="100%" height="100%" />
							</s:NavigatorContent>-->
							<s:NavigatorContent width="100%" height="100%">
								<videochat:TestVideoChatPanel id="idVideoChat" isNewCall="false" 
															  clinicBranchID="{clinicBranchID}" 
															  currentLoggedInUserID="{model.loggedInUserDTO.UserId}" 
															  userID="{userID}" providerName="{ProviderName}" width="100%" height="100%" 
															  AcceptVideoCallEvent="idVideoChat_AcceptVideoCallEventHandler(event)" />
							</s:NavigatorContent>

						</mx:ViewStack>
						
					</s:SkinnableContainer>
				</s:HGroup>
				<s:HGroup horizontalAlign="right" width="100%" paddingRight="7">
					<s:Button height="8" width="40" toolTip="Scroll Up" styleName="blackScrollUpButtonSkin"
							  buttonMode="true" useHandCursor="true"/>
					<s:Button height="8" width="40" toolTip="Scroll Down" styleName="blackScrollDownButtonSkin"
							  buttonMode="true" useHandCursor="true"/>
				</s:HGroup>
			</s:BorderContainer>
			<s:HGroup horizontalAlign="center" verticalAlign="bottom" width="100%" >
				<s:Button id="id_CloseBtn" styleName="closeButtonSkin"
						  click="CloseHandler(event)" buttonMode="true" useHandCursor="true" toolTip="Close Communication Section"/>
			</s:HGroup>
			
			
		</s:VGroup>
	
	</custom:Contents>
</custom:SlideOutPanel>


