				id_communication.EmailAddress = model.SearchProviderDetailsResults.UserEmail;
				id_communication.userID = model.SearchProviderDetailsResults.userID;
				id_communication.id_Views.selectedIndex=1;
				//id_communication.addEventListener(CloseEvent.CLOSE, CloseHandler);
