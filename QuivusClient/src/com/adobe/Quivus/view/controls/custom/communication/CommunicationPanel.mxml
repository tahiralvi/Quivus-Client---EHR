			protected function slideoutpanel1_creationCompleteHandler(event:FlexEvent):void
			{
				id_header.id_slideoutBtn.addEventListener(MouseEvent.CLICK, SlideoutHandler);
				id_header.id_btnClose.addEventListener(MouseEvent.CLICK, CloseHandler);
				
				id_commInternalHeader.id_OptionPopUp.displayPopUp = true;
				//id_patientExamControls.id_emailBtn.addEventListener(MouseEvent.CLICK, onEmailClick);
				id_commInternalHeader.id_emailBtn.addEventListener(MouseEvent.CLICK,onEmailClick);
				id_commInternalHeader.id_commentBtn.addEventListener(MouseEvent.CLICK,onSMSClick);
				id_commInternalHeader.id_VideoChatBtn.addEventListener(MouseEvent.CLICK,onVideoChatClick);
				
				/* Heading=" Profile";
				 */
				if(isVideoChat)
				{
					id_MainCommView.selectedIndex=3;
				}
				id_commInternalHeader.id_OptionPopUp.displayPopUp = false;
			}
			
			private function IsStatusAvailable():void
			{
				ProviderName = model.SearchProviderDetailsResults.FirstName +' '+model.SearchProviderDetailsResults.MiddleName+' '+ model.SearchProviderDetailsResults.LastName ; 
				id_communication.EmailAddress = model.SearchProviderDetailsResults.UserEmail;
				id_communication.userID = model.SearchProviderDetailsResults.userID;
				userSessionStatus = model.SearchProviderDetailsResults.sessionStatus;
				skinChange();
				if(userSessionStatus == "Available")
				{
					if(idVideoChat != null)
					{
						idVideoChat.isNewCall = true;
						idVideoChat.clinicBranchID = parseInt(clinicBranchID);
						idVideoChat.currentLoggedInUserID = model.loggedInUserDTO.UserId;
						idVideoChat.userID = userID;
						idVideoChat.id_html.location = "";
						idVideoChat.providerName = ProviderName;
						idVideoChat.CallDetails();
					}
					ShowVideoPopup( idVideoChat );
					id_commInternalHeader.id_OptionPopUp.displayPopUp=false;
					id_commInternalHeader.id_optionsBtn.selected =false;
					
				}
				else
				{
					if(userSessionStatus == "Invisible")
					{
						Alert.show("You cannot call "+ model.SearchProviderDetailsResults.FirstName +" "+ model.SearchProviderDetailsResults.LastName+" at this time.User current Status is Offline");
					}
					else
						Alert.show("You cannot call "+ model.SearchProviderDetailsResults.FirstName +" "+ model.SearchProviderDetailsResults.LastName+" at this time.User current Status is "+ userSessionStatus);
					
					
				}
			}
			
			
			private function GenerateVideCall():void
			{
				var clinicuserIDevent: GetClinicUserIDEvent = new GetClinicUserIDEvent(userID, parseInt(clinicBranchID), false, IsStatusAvailable);
				CairngormEventDispatcher.getInstance().dispatchEvent(clinicuserIDevent);
			}
			
			
			private function onVideoChatClick(event:MouseEvent):void
			{
				if(!CommunicationConstant.ISVIDEOCALL_ACTIVE)
				{
					GenerateVideCall();
				}
				else
				{
					Alert.show("You can make one call at a time.","Information");
				}
				
