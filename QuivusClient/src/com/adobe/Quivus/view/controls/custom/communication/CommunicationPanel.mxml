				//id_commInternalHeader.ProviderName = model.SearchProviderDetailsResults.FirstName +" "+model.SearchProviderDetailsResults.MiddleName +" "+model.SearchProviderDetailsResults.LastName;
				this.ExpandedView=true;
			}
			
			
			
			protected function SlideoutHandler(event:MouseEvent):void
			{
				this.ToggleSlideOut();
				event.stopImmediatePropagation();
