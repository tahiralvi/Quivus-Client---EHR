			}
			
			private function onSMSClick(event:MouseEvent):void
			{
				Heading="SMS";
				id_MainCommView.selectedIndex = 2;
				id_commInternalHeader.id_OptionPopUp.displayPopUp=false;
				id_commInternalHeader.id_optionsBtn.selected =false;
				//dispatchEvent(CloseHandler);
				if(idVideoChat != null)
					idVideoChat.isNewCall=false;
				
				if(id_smsView != null)
				{
					id_smsView.BranchID = model.userSelectedStationDTO.ClinicBranchID.toString();
					id_smsView.senderID = model.loggedInUserDTO.UserId;
					id_smsView.userID = userID;
				}
				//id_commInternalHeader.ProviderName = model.SearchProviderDetailsResults.FirstName +" "+model.SearchProviderDetailsResults.MiddleName +" "+model.SearchProviderDetailsResults.LastName;
			}
			
			private function onEmailClick(event:MouseEvent):void
			{	
				Heading = "Email";
