						//		id_Height.width 		= id_Height.doubleModeOn? 130 : 80;
						/* id_Height.width         = 80;
						*/						//	id_Height.maxValues 	= [269.99, 99.99];
						//	id_Height.stepSizes 	= id_Height.doubleModeOn?[1]:[1];
						
						id_Weight.maxValues = [999.9];
						
						//	hgtLbl += id_Height.doubleModeOn? "(Feet/Inch)" : "(Inch)";
						hgtLbl += "(Inch)";
						wgtLbl += "(lbs)";
						tempLbl += "(F)";
						
						convertInEnglishUnits();
					}
					else
					{
						//		id_Height.doubleModeOn = false;
						/* id_Height.width = 70; */
						
						//	id_Height.stepSizes = [0.01,0];
						//	id_Height.maxValues = [9999.99];
						id_Weight.maxValues = [9999.99];
						
						hgtLbl += "(Cm)";
						wgtLbl += "(Kg)";
						tempLbl += "(C)";
						
						convertInMetricUnits();
						
					}
					
					id_Height.label = hgtLbl;
					id_Weight.label = wgtLbl;
					id_Temperature.label = tempLbl;
				}
			}
			
			public function LoadDataMode():void
			{
				if( model.quickInputDTO.Physical!=null && model.quickInputDTO.Physical.Vitals!=null)
				{
					id_Header.id_english.selected 	= !model.quickInputDTO.Physical.Vitals.IsMetricDisplaySelected;
					id_Header.id_metric.selected 	=  model.quickInputDTO.Physical.Vitals.IsMetricDisplaySelected;
					
					var hgtLbl:String = "Height ";
					var wgtLbl:String = "Weight ";
					var tempLbl:String = "Temp ";
					
					if ( !model.quickInputDTO.Physical.Vitals.IsMetricDisplaySelected )
					{
						_englishMode = true;
						
						
						if (_englishMode)
						{
							id_Weight.maxValues = [999.9];
							
							hgtLbl += "(Inch)";
							wgtLbl += "(lbs)";
							tempLbl += "(F)";
							
							//						convertInEnglishUnits();
						}
					}
					else
					{
						_englishMode = false;
						
						id_Weight.maxValues = [9999.99];
						
						hgtLbl += "(Cm)";
						wgtLbl += "(Kg)";
						tempLbl += "(C)";
						
						//						convertInMetricUnits();
						id_Height.label = hgtLbl;
						id_Weight.label = wgtLbl;
						id_Temperature.label = tempLbl;
						
					}
					id_Height.values 		= [Number(model.quickInputDTO.Physical.Vitals.Height), 0];
					id_Weight.values 		= [Number( model.quickInputDTO.Physical.Vitals.Weight ), 0];
					id_Temperature.values 	= [Number( model.quickInputDTO.Physical.Vitals.Temperature ), 0];
					id_Respiratory.values 	= [Number(model.quickInputDTO.Physical.Vitals.Respiration), 0];
					id_Pulse.values 	  	= [Number( model.quickInputDTO.Physical.Vitals.Pulse ), 0];
					id_BloodPressure.values = [Number(model.quickInputDTO.Physical.Vitals.BPSys), Number(model.quickInputDTO.Physical.Vitals.BPDys)];
					id_oxygen.text	 		= (model.quickInputDTO.Physical.Vitals.Oxygen);
				}
			}
			
