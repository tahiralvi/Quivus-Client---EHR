			private function alertsCloseHandler(event:CloseEvent):void
			{				
				if (vital)
				{
					switch(event.detail)
					{
						case Alert.YES:
							vital.selected = false;
							
							if (hasFocus)
								//hasFocus.setFocus();
								focusManager.setFocus(hasFocus);
							break;
						
						case Alert.NO:
							vital.selected = true;
							
							if (inputStepper == vital.firstNumericStepper){
								vital.reset(true, false); 
								resetData();
							}
							else{
								vital.reset(false, true);
							}
							
							//vital.setFocus();
							break;	
					}
					
					registerFocusOutHandlers();
				}
			}
			private function resetData():void
			{
				switch(selectedUnit)
				{
					case 1:
						model.quickInputDTO.Physical.Vitals.Height = '';
						break;
					case 2:
						model.quickInputDTO.Physical.Vitals.Weight = '';
						break;
					case 3:
						model.quickInputDTO.Physical.Vitals.Temperature = '';
						break;
					case 4:
						model.quickInputDTO.Physical.Vitals.Pulse = '';
						break;
					case 5:
						model.quickInputDTO.Physical.Vitals.Respiration = '';
						break;
					case 6:
						model.quickInputDTO.Physical.Vitals.BPDys = '';
						break;
					default:
						break;
				}
			}
			private function registerFocusOutHandlers():void
			{
				id_Height.addEventListener(FocusEvent.FOCUS_OUT, validateHeight, false, 0, true);
				id_Weight.addEventListener(FocusEvent.FOCUS_OUT, validateWeight, false, 0, true);
				id_Temperature.addEventListener(FocusEvent.FOCUS_OUT, validateTemperature, false, 0, true);
				id_Pulse.addEventListener(FocusEvent.FOCUS_OUT, validatePulse, false, 0, true);
				id_Respiratory.addEventListener(FocusEvent.FOCUS_OUT, validateRespiratory, false, 0, true);
				id_BloodPressure.addEventListener(FocusEvent.FOCUS_OUT, validateBloodPressure, false, 0, true);
			}
			
			private function unRegisterFocusOutHandlers():void
			{
				id_Height.removeEventListener(FocusEvent.FOCUS_OUT, validateHeight);
				id_Weight.removeEventListener(FocusEvent.FOCUS_OUT, validateWeight);
				id_Temperature.removeEventListener(FocusEvent.FOCUS_OUT, validateTemperature);
				id_Pulse.removeEventListener(FocusEvent.FOCUS_OUT, validatePulse);
				id_Respiratory.removeEventListener(FocusEvent.FOCUS_OUT, validateRespiratory);
				id_BloodPressure.removeEventListener(FocusEvent.FOCUS_OUT, validateBloodPressure);
			}
			
