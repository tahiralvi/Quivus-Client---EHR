			private function vitalHeaderClickHandler(event:VitalsHeaderEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_VITALS ) )
				{
					
					if (event.type == VitalsHeaderEvent.METRIC_UNIT_SELECTED)
					{
						englishMode = false;
					}
					else if (event.type == VitalsHeaderEvent.ENGLISH_UNIT_SELECTED)
					{
						englishMode = true;
					}
					else if (event.type == VitalsHeaderEvent.CLEAR_CLICKED)
					{
						(PhysicalHeight[0]   > 	 0 || PhysicalHeight[1] > 0) ||
							PhysicalWeight 		 >	 0;
						PhysicalTemperature  > 	 0;
						PhysicalPulse 		 >   0;
						PhysicalRespiration  >   0;
						PhysicalBPSys 		 >   0.0;
						PhysicalBPDys 		 >   0.0;
						id_BMI.value 		 >   0.0;
						id_oxygen.text 		 != "";
						
						
						UtilityFunctions.AskMessage("Do You Want To Clear All Values?", function():void
						{
							id_Height.values 			= [0.0, 0.0];
							id_Weight.values 			= [0.0, 0.0];
							id_Temperature.values 		= [0.0, 0.0];
							id_Pulse.values 			= [0.0, 0.0];
							id_Respiratory.values 		= [0.0, 0.0];
							id_BloodPressure.values 	= [0.0, 0.0];
							
							PhysicalHeight 			= [0.0, 0.0];
							PhysicalWeight 			= 0.0;
							PhysicalTemperature 	= 0.0;
							PhysicalPulse 			= 0.0;
							PhysicalRespiration 	= 0.0;
							PhysicalBPSys 			= 0.0;
							PhysicalBPDys 			= 0.0;
							id_BMI.value 			= 0.0;
							Oxygen 					= "";
							id_oxygen.text 			= "";
							
							if (notesPanel && notesPanel.notesDTO)
							{
								notesPanel.notesDTO.Note = "";
								notesPanel.notesDTO.NoteSubject = "";
								notesPanel.id_body.id_subject.text = "";
								notesPanel.id_body.id_message.text = "";
							}
						});
					}
					else if (event.type == VitalsHeaderEvent.IMPORT_VITALS_CLICKED)
					{
						var lmrV:LoadPatientMostRecentVitalsEvent = new LoadPatientMostRecentVitalsEvent();
						CairngormEventDispatcher.getInstance().dispatchEvent(lmrV);
						showImportVitalsPopup();
					}
					
					//M
					if(model.quickInputDTO){
						if(model.quickInputDTO.Physical){
							if(model.quickInputDTO.Physical.Vitals){
								if(model.quickInputDTO.Physical.Vitals.IsMetricDisplaySelected){
									model.quickInputDTO.Physical.Vitals.IsMetricDisplaySelected = !this.englishMode;
								}
							}
						}
					}
					
				}
			}
			
