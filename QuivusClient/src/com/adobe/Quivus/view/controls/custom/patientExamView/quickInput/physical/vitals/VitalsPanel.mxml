			//Mansoor
			//Date 19 Mar 2011
			protected function OnRecentVitalGridClick(event:Event):void
			{
				var selectedItem:RecentVitalDTO = model.patientPreviousVitalsList[ event.currentTarget.selectedIndex ] as RecentVitalDTO;
				//var selectedItem:VitalDTO = model.vitalDTOListByPatient[ event.currentTarget.selectedIndex ] as VitalDTO;
				
				this.englishMode = !selectedItem.IsMetricDisplaySelected;
				
				if (englishMode)
					id_Header.id_english.selected = true;
				else
					id_Header.id_metric.selected = true;
				
				if(selectedItem.Height != null && selectedItem.Height != '')
					this.PhysicalHeight = [selectedItem.Height, 0];
				
				if(selectedItem.Weight != null && selectedItem.Weight != '')
					this.PhysicalWeight = Number(selectedItem.Weight);
				
				if(selectedItem.Temperature != null && selectedItem.Temperature != '')
					this.PhysicalTemperature = Number(selectedItem.Temperature);
				
				if(selectedItem.Pulse != null && selectedItem.Pulse != '')
					this.PhysicalPulse = Number(selectedItem.Pulse);
				
				if(selectedItem.Respiration != null && selectedItem.Respiration != '')
					this.PhysicalRespiration = Number(selectedItem.Respiration);
				
				if(selectedItem.BPSys != null && selectedItem.BPSys != '')
					this.PhysicalBPSys = Number(selectedItem.BPSys);		
				
				if(selectedItem.BPDys != null && selectedItem.BPDys != '')
					this.PhysicalBPDys = Number(selectedItem.BPDys);
				
				// zahid
				if(selectedItem.Oxygen != null && selectedItem.Oxygen != '')
					this.Oxygen = selectedItem.Oxygen;
				// zahid
				
				//close the import panel
				if( importVitalsPanel && id_NotesArea.contains( importVitalsPanel ) )
				{
					id_NotesArea.removeElement( importVitalsPanel );
					id_Header.id_import.selected = false;
				}
				
				importVitalsPanel.removePopup();
			}
			
			private function convertInEnglishUnits():void
			{
				if(model.quickInputDTO.Physical.Vitals == null)
					return;
				
				var w:Number = UnitConverter.kilogramsToPounds(Number(model.quickInputDTO.Physical.Vitals.Weight));
				var h:Number = UnitConverter.centimetersToInches(Number(model.quickInputDTO.Physical.Vitals.Height));
				var t:Number = UnitConverter.celsiusToFahrenheit(Number(model.quickInputDTO.Physical.Vitals.Temperature));
				
				this.PhysicalWeight = w;
