				if( UtilityFunctions.IsNullOrEmpty( model.DiagnosisResolvedCurrentPageByPatient ) )
					model.DiagnosisResolvedCurrentPageByPatient = new PageDTO();
				
				var pvital:PageDTO 		= model.DiagnosisResolvedCurrentPageByPatient;
				pvital.fromDate 		= model.defaultFilterAndPaging.fromDate;
				pvital.toDate 			= model.defaultFilterAndPaging.toDate;
				pvital.pageSize 		= model.defaultFilterAndPaging.pageSize;
				pvital.LastVisitNumber 	= model.defaultFilterAndPaging.LastVisitNumber;
				
				var lpdbp:LoadPatientDiagnosisResolvedByPatientIdEvent = new LoadPatientDiagnosisResolvedByPatientIdEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( lpdbp );
			}
			
			
			protected function id_PaginationFilterView4Acute_RefreshViewHandler(event:Event):void
			{
				var lpdbp:LoadPatientDiagnosisAcuteByPatientIdEvent = new LoadPatientDiagnosisAcuteByPatientIdEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( lpdbp );
			}
			
			protected function id_PaginationFilterView4Chronic_RefreshViewHandler(event:Event):void
			{
				var lpdbp:LoadPatientDiagnosisChronicByPatientIdEvent = new LoadPatientDiagnosisChronicByPatientIdEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( lpdbp );
			}
			
			protected function id_PaginationFilterView4Resolved_RefreshViewHandler(event:Event):void
			{
				var lpdbp:LoadPatientDiagnosisResolvedByPatientIdEvent = new LoadPatientDiagnosisResolvedByPatientIdEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( lpdbp );
			}
			
			protected function slideoutpanel1_focusInHandler(event:FocusEvent):void
			{
				// TODO Auto-generated method stub
				id_VBViews2.selectedIndex = 0;
			}
			
		]]>
	</fx:Script>
