			public function SelectNextByIndex():void
			{
				if( currentIndex == 0 )
					currentIndex = 1;
				
				switch( currentIndex )
				{
					case 1:
						showAllergiesPanel();
						break;
					case 2:
					case 3:
						showPastMedicalHXPanel();
						break;
						/* showHistoryPanel();			
						break; */
					case 4:
						showMedicationPanel();
						break;
					case 5:
						showImmunizationPanel();
						break;
					case 6:
						showVitalsPanel();
						break;
					case 7:
						showHpiPanel();
						break;
					case 8:
						showROSPanel();
						break;
					case 9:
						showPhysicalPanel();
						break;
					case 10:
						showLabPanel();
						break;
					case 11:
						showDiagnosisPanel();
						break;
					case 12:
						showPrescriptionPanel();
						break;
					case 13:
						showTreatmentPanel();
						break;
					case 14:
						showPlanPanel();
						break;
					case 15:
						showFollowUpPanel();
						break;
					
					default:
						break;
				}
			}
			
			
