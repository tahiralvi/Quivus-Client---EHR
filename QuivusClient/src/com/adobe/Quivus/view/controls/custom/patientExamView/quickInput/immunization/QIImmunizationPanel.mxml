	<fx:Binding source="model.quickInputDataLoadedFlag" destination="IsModelUpdated" /> 
	
	<fx:Binding source="id_ImmunizationBodyView.hasViewChanged" destination="hasChange"  /> 
	
	<custom:HeaderContents>
		<s:Group width="100%" height="24" minWidth="{ChromeUtil.topLevelMainContainer.width - 70}">
			<s:layout>
				<s:VerticalLayout verticalAlign="bottom" />
			</s:layout>
			<quickInput:PMHSectionHeader id="id_Header" width="100%" HeadingLable="Immunization" />						   
		</s:Group>
	</custom:HeaderContents>
	<custom:SlideHeaderContents>
		
		<quickInput:QISectionSlideoutHeader width="100%" label="{id_Header.HeadingLable}" />
	</custom:SlideHeaderContents>
	<custom:Contents>
		
		<s:SkinnableContainer id="sc_immunization" skinClass="com.adobe.Quivus.view.controls.skins.SkinnableContainers.QISectionBGSkin" width="{id_Header.width}" 
							  visible="{model.securityProxyObject.PatientExam.QuickInput.PMH.Immunization.IsViewAllowed}" includeInLayout="{sc_immunization.visible}">
			<s:layout>
				<s:VerticalLayout  verticalAlign="top" gap="0"   horizontalAlign="{isSlideOut? 'right':'center'}" paddingRight="3"
								   paddingTop="{isSlideOut? -2:0}" paddingLeft="{isSlideOut? 1:1}"/>
			</s:layout>
