									  skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.popupCloseBtnSkin" 
									  toolTip="Close" height="16" width="16" click="id_CloseBtn_clickHandler(event)"
									  />
						</s:HGroup>
						<s:ToggleButton id="id_ImportVisitBtn" skinClass="com.adobe.gazuntite.skins.chrome.toggleButtonSkins.importVisitPopUpButton"
										width="24" toolTip="Import Visit" useHandCursor="true" buttonMode="true" enabled="false" height="19" />
						<!--skinClass="com.adobe.Quivus.view.controls.skins.toggleButtonSkins.PE_importVisitBtn" -->
						<s:ToggleButton id="id_RxBtn"  skinClass="com.adobe.gazuntite.skins.chrome.toggleButtonSkins.prescriptionPopUpButton"
										width="24" toolTip="Prescription" enabled="false" visible="true" buttonMode="true" useHandCursor="true" height="19"/>			
						<!--skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.PE_RXBtn" -->
						<s:ToggleButton id="id_NotesBtn" width="24" skinClass="com.adobe.gazuntite.skins.chrome.toggleButtonSkins.notesPopUpButton"
										toolTip="View Notes" enabled="false" visible="true" buttonMode="true" useHandCursor="true" height="19"/>
						<!--skinClass="com.adobe.Quivus.view.controls.skins.buttonSkins.PE_notesBtn"-->
						
						<!--<s:Button id="id_ClosePatnBtn" width="24" skinClass="com.adobe.quivus.skins.chrome.buttonSkins.closePatientPopUpButton"
						toolTip="Close Patient" enabled="true" visible="true" buttonMode="true" useHandCursor="true" height="19"
						/>-->
					</s:SkinnableContainer>
				</s:PopUpAnchor>
				
			</s:VGroup>
			
			
			<buttonSeparators:buttonSeparator  />
			
			<s:HGroup paddingBottom="1" paddingTop="0" paddingRight="2">		 
				<s:ToggleButton id="id_expandBtn" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.expandButton_white" 
								width="19" height="21"	buttonMode="true" useHandCursor="true" toolTip="{id_expandBtn.selected?'Collapse':'Expand'}"/>
			</s:HGroup>
			
			
			<buttonSeparators:buttonSeparator includeInLayout="false" visible="false"/>
			
			<s:HGroup paddingBottom="1" paddingTop="0" paddingRight="2" includeInLayout="false" visible="false">
				<s:ToggleButton id="id_slideoutBtn" skinClass="com.adobe.gazuntite.skins.chrome.toggleButtonSkins.slideOutBtn_white"
								buttonMode="true" useHandCursor="true" toolTip="{id_slideoutBtn.selected?'Slide-In':'Slide-Out'}" 
