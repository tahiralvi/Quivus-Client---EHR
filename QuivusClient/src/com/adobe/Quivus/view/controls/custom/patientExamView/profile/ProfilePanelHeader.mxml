			public function OnMoveHandler(event:MoveEvent):void
			{
				//First section popups
				if( m_oTagProfileCustomPanel1stSection && m_oTagProfileCustomPanel1stSection.isPopUp )
				{
					TagProfileCustomBtn_clickHandler1stSec( null );
				}
				
				if( m_oTagUserInfoPanel && m_oTagUserInfoPanel.isPopUp )
				{
					TagUserInfoBtn_clickHandler( null );
				}
				//2nd section
				if( m_oTagProfileCustomPanel2ndSection && m_oTagProfileCustomPanel2ndSection.isPopUp )
				{
					TagProfileCustomBtn_clickHandler2ndSec( null );
				}
				
				//3rd section
				if( m_oTagHealthCustomPanel && m_oTagHealthCustomPanel.isPopUp )
				{
					allergyPopUpButton_clickHandler( null );
				}
				
				if( m_oTagPatientHealthPanel && m_oTagPatientHealthPanel.isPopUp )
				{
					ThirdSectionBtn_clickHandler( null );
				}
				
				//ClosePopups();
				
			}
			
			public function ClosePopups():void
			{
				//First section popups
				if( m_oTagProfileCustomPanel1stSection && m_oTagProfileCustomPanel1stSection.isPopUp )
				{
					m_oTagProfileCustomPanel1stSection.removePopup();
				}
				
				if( m_oTagUserInfoPanel && m_oTagUserInfoPanel.isPopUp )
				{
					m_oTagUserInfoPanel.removePopup();
				}
				//2nd section
				if( m_oTagProfileCustomPanel2ndSection && m_oTagProfileCustomPanel2ndSection.isPopUp )
				{
					m_oTagProfileCustomPanel2ndSection.removePopup();
				}
				
				//3rd section
				if( m_oTagHealthCustomPanel && m_oTagHealthCustomPanel.isPopUp )
				{
					m_oTagHealthCustomPanel.removePopup();
				}
				
				if( m_oTagPatientHealthPanel && m_oTagPatientHealthPanel.isPopUp )
				{
					m_oTagPatientHealthPanel.removePopup();
				}
				
			}
			
