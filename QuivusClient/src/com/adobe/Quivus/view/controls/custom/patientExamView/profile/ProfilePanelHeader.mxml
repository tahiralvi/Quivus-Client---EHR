			protected function TagProfileCustomBtn_clickHandler1stSec(event:MouseEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleViewable( QSSecurityUtil.PATIENT_PROFILE ) )//Tahir Alvi - 
				{
					if( m_oTagProfileCustomPanel1stSection && m_oTagProfileCustomPanel1stSection.isPopUp )
					{
						m_oTagProfileCustomPanel1stSection.removePopup();
						id_FirstAreaCustomBtn.selected = false;
						if( event )
							event.stopImmediatePropagation();
						return;
						//id_firstLbl.setStyle("borderAlpha", 0);
					}							
					
					
					m_oTagProfileCustomPanel1stSection = new ProfileCustomiztionPopup();
					m_oTagProfileCustomPanel1stSection.addEventListener(FlexEvent.CREATION_COMPLETE, function(event:Event):void
					{
						m_oTagProfileCustomPanel1stSection.id_profileTree.addEventListener( MouseEvent.CLICK, OnProfileTreeClick1stSec );
						m_oTagProfileCustomPanel1stSection.id_SetAsDefault.addEventListener( MouseEvent.CLICK, OnSetAsDefaultClick1stSec );
					});
					var pLoc:Point = new Point( this.x + id_1stSecFieldArea.x + id_FirstAreaCustomBtn.x,
						//this.y + id_FirstAreaCustomBtn.y + id_1stSecFieldArea.y + id_img1.height );
						this.y + id_FirstAreaCustomBtn.y + id_FirstAreaCustomBtn.height/2 );
					
					var loc:Point = this.localToGlobal( pLoc );
					m_oTagProfileCustomPanel1stSection.x = loc.x - 5;//loc.x + id_FirstAreaCustomBtn.width-25;
					m_oTagProfileCustomPanel1stSection.y = loc.y + 3;
					m_oTagProfileCustomPanel1stSection.ShowPopup( this );
					
					m_oTagProfileCustomPanel1stSection.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:Event):void
					{
						//firstArea_inactivate();
						id_FirstAreaCustomBtn.selected = false;
						if( event )
							event.stopImmediatePropagation();
					});
					
					
					
				}
				if( event )
					event.stopImmediatePropagation();
				
				//id_firstLbl.setStyle("borderAlpha", 1);
			}
			
