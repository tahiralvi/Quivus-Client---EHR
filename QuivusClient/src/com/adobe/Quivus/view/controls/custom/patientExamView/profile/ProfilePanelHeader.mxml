			protected function id_ThirdSectionCustomBtn_clickHandler(event:MouseEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleViewable( QSSecurityUtil.PATIENT_PROFILE ) )//Tahir Alvi 
				{
					if( allergyPanel && allergyPanel.isPopUp )
					{
						allergyPanel.removePopup();
						id_ThirdSectionCustomBtn.selected = false;
						event.stopImmediatePropagation();
						return;
					}
					
					allergyPanel = new AllergyCustomizationPopUp();
					var locPoint:Point = id_ThirdSectionCustomBtn.parent.localToGlobal(new Point( id_ThirdSectionCustomBtn.x ,
						id_ThirdSectionCustomBtn.y  ));
					allergyPanel.move(locPoint.x - 22  ,locPoint.y -16);
					allergyPanel.ShowPopup(this);
					allergyPanel.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:Event):void
					{
						id_ThirdSectionCustomBtn.selected = false;
						
						if( event )
							event.stopImmediatePropagation();
					});
					
				}
			}
			
			protected function id_optionsBtn_clickHandler(event:MouseEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleViewable( QSSecurityUtil.PATIENT_PROFILE ) )//Tahir Alvi 
				{
					id_OptionPopUp.displayPopUp = !id_OptionPopUp.displayPopUp;
					id_OptionPopUp.setFocus();
				}
				
				if( event )
					event.stopImmediatePropagation();
			}
			
			protected function group1_clickHandler(event:MouseEvent):void
			{
				if(! QSSecurityUtil.Security.IsModuleViewable( QSSecurityUtil.PATIENT_PROFILE ) )//Tahir Alvi 
				{
					if( event )
					event.stopImmediatePropagation();
				}
				
			}
			
