			protected function allergyPopUpButton_clickHandler(event:MouseEvent):void
			{				
				if( m_oTagHealthCustomPanel && m_oTagHealthCustomPanel.isPopUp )
				{
					m_oTagHealthCustomPanel.removePopup();
					allergyPopUpButton.selected = false;
					event.stopImmediatePropagation();
					return;
				}
				m_oTagHealthCustomPanel = new ProfileCustomiztionPopup();
				//m_oTagHealthCustomPanel.id_profileTree.verticalScrollPolicy = "off";
				//m_oTagHealthCustomPanel.id_downBtn.visible = false;
				//m_oTagHealthCustomPanel.id_upBtn.visible = false;
				m_oTagHealthCustomPanel.id_profileTree.dataProvider = model.userProfileBarHealthStaticDataList;
				
				m_oTagHealthCustomPanel.addEventListener(FlexEvent.CREATION_COMPLETE, function(event:Event):void
				{
					m_oTagHealthCustomPanel.id_profileTree.addEventListener( MouseEvent.CLICK, OnProfileHealthTreeClick );
					m_oTagHealthCustomPanel.id_SetAsDefault.addEventListener( MouseEvent.CLICK, OnSetAsDefaultHealthSecClick );
					m_oTagHealthCustomPanel.id_profileTree.showRoot = false;
				});
				( allergyPopUpButton.x + id_rightBtns.x + this.x ,
					allergyPopUpButton.y  );
				
				var pLoc:Point = new Point( this.x + id_rightBtns.x,
					this.y + id_rightBtns.y );
				var loc:Point = this.localToGlobal( pLoc );
				m_oTagHealthCustomPanel.x = loc.x;
				m_oTagHealthCustomPanel.y = loc.y;
				m_oTagHealthCustomPanel.ShowPopup( this );
				m_oTagHealthCustomPanel.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:Event):void
				{
					allergyPopUpButton.selected = false;
					if( event )
						event.stopImmediatePropagation();
				});
				
				if( event )
					event.stopImmediatePropagation();  
			}
			
