			/* allergies */
			
			protected function ThirdSectionBtn_clickHandler(event:MouseEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleViewable( QSSecurityUtil.PATIENT_PROFILE ) )//Tahir Alvi - on contact button  click implement security check
				{
					if( m_oTagPatientHealthPanel && m_oTagPatientHealthPanel.isPopUp )
					{
						m_oTagPatientHealthPanel.removePopup();
						allergyPopUpButton.selected = false;
						event.stopImmediatePropagation();
						
						if(m_oTagPatientHealthPanel.m_oAddAllergyPanel && m_oTagPatientHealthPanel.m_oAddAllergyPanel.isPopUp)
						{
							m_oTagPatientHealthPanel.m_oAddAllergyPanel.removePopup();
							allergyPopUpButton.selected = false;
						}
						if( event )
							event.stopImmediatePropagation();
						return;
					}
					else
					{
						m_oTagPatientHealthPanel = new PatientHealthSectionPopup();
						//var pLoc:Point = new Point( id_ThirdSectionBtn.x + this.x + id_ThirdSection.x,
						
						
						
						var pLoc:Point = new Point( allergyPopUpButton.x + id_rightBtns.x + this.x + id_allergyBtn.x + id_IconsBtn.x ,
							allergyPopUpButton.y  );
						
						var loc:Point = localToGlobal( pLoc );
						m_oTagPatientHealthPanel.x = loc.x - 220 ;
						m_oTagPatientHealthPanel.y = loc.y -  10 ;
						m_oTagPatientHealthPanel.ShowPopup( this );
						
						m_oTagPatientHealthPanel.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:Event):void
						{
							allergyPopUpButton.selected = false;
						});
					}
				}
				
				
				if( event )
					event.stopImmediatePropagation();
				event.preventDefault();
			}
			
			
			protected function OnProfileTreeClick1stSec(event:MouseEvent):void
			{
				var tree:Tree = event.currentTarget as Tree;
				trace( tree.selectedItem );
				var vo:SubCategoryVO = tree.selectedItem as SubCategoryVO;
				if( vo )
				{
					var e:ManageUserPatientProfileBarSettingEvent = new ManageUserPatientProfileBarSettingEvent( model.FirstSectionDTO.SectionNo, model.FirstSectionDTO.UserUserProfileCategoryID, vo.subCategoryId,false );
					CairngormEventDispatcher.getInstance().dispatchEvent( e );
				}
			}
			
			protected function OnSetAsDefaultClick1stSec(event:MouseEvent):void
			{
				var tree:Tree = m_oTagProfileCustomPanel1stSection.id_profileTree;
				trace( tree.selectedItem );
				var vo:SubCategoryVO = tree.selectedItem as SubCategoryVO;
				if( vo )
				{
					var e:ManageUserPatientProfileBarSettingEvent = new ManageUserPatientProfileBarSettingEvent( model.FirstSectionDTO.SectionNo, model.FirstSectionDTO.UserUserProfileCategoryID, vo.subCategoryId,true );
					CairngormEventDispatcher.getInstance().dispatchEvent( e );
				}
			}
			
			
