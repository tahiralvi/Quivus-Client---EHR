	</s:layout>
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			import valueObjects.ImmunizationDTO;
			import valueObjects.PatientDiagnosisInfoDTO;
			
			protected function itemrenderer1_creationCompleteHandler(event:FlexEvent):void
			{
				trace("HealthSectionImmunizationRenderer, ",data.ImmunizationType.ImmunizationTypeName);
				//var dto:ImmunizationDTO ;
			}
			
		]]>
	</fx:Script>
	<s:HGroup>
		<s:Label text="{data.ImmunizationType.ImmunizationTypeName}" width="100%" />
