				id_Add.id_WriteDictation.setStyle("skinClass", QIDictationBtn);
				
			}
			
			public function isInvalid():Boolean
			{
				var notValid:Boolean = false;
				
				
				if( id_ByDate.selected )
				{
					if(id_FollowUpDate != null && id_FollowUpDate.textInput.text.length < 2 )
					{
						notValid = true;
					}
					
				}
				else if( id_OnCompletion.selected )
				{
					if( id_rbLabTest.selected )
					{
						if(id_ddlLabs.selectedIndex < 0)
						{
							notValid = true;
						}
					}
					else if( id_rbDrug.selected )
					{
						if(id_ddlDrugs.selectedIndex < 0)
						{
							notValid = true;
						}
					}
				}
				
				if( id_Service.textInput.text.length == 0 )
				{
					notValid = true;
				}
				else if (id_FreqAge.selected)
				{
					if (!ValidationUtils.isValidValueSelected(id_AgeType))
					{
						notValid = true;
					}	
					else if (!ValidationUtils.isValidValueSelected(id_AgeValue))
					{
						notValid = true;
					}
				}
					
				else if (id_FreqDuration.selected)
				{
					ValidationUtils.Trim(id_AfterDurationValue);
					ValidationUtils.Trim(id_ForDurationValue);
					
					var afterVal:Number = Number(id_AfterDurationValue.text);
					var forVal:Number = Number(id_ForDurationValue.text);
					
					if (isNaN(afterVal))
					{
						notValid = true;
					}
					else if (!ValidationUtils.isValidValueSelected(id_AfterDurationType))
					{
						notValid = true;
					}
					else if (isNaN(forVal))
					{
						notValid = true;
					}
					else if (!ValidationUtils.isValidValueSelected(id_ForDurationType))
					{
						notValid = true;
					}
				}
				
				/* if( notValid == false )
				dispatchEvent( new Event("data_added", true, true) ); */
				
				return notValid;
			}
			
			public function isGetEdited():Boolean
			{
				var edited:Boolean = false;
				
				if (id_Service.textInput.text.length || id_Service.selectedItem != null)
					edited = true;
				
				if (id_FreqAge.selected)
				{
					if (id_AgeType.textInput.text.length || id_AgeType.selectedItem ||
						id_AgeValue.textInput.text.length || id_AgeValue.selectedItem)
						edited = true;	
				}
					
				else if (id_FreqDuration.selected)
				{
					if (id_AfterDurationType.textInput.text.length || id_AfterDurationType.selectedItem ||
						id_AfterDurationValue.text.length ||
						id_ForDurationType.textInput.text.length || id_ForDurationType.selectedItem ||
						id_ForDurationValue.text.length)
						
						edited = true;
				}
				
				//hasViewChanged = (_hasGridChanged)? _hasGridChanged : edited;
				
				return edited;
			}
			
			
			
