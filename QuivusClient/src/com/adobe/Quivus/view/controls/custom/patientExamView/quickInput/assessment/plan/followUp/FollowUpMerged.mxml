			private function editRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.QI_FOLLOW_UP ) )//Tahir Alvi - implement security check 
				{
					id_DataGrid.editable = true;
					var rowIndex:int = id_DataGrid.selectedIndex;
					var itemToSetInEditableMode:IListItemRenderer = id_DataGrid.indexToItemRenderer(rowIndex);
					
					var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
					ev.columnIndex = 2;
					ev.rowIndex = rowIndex;
					ev.itemRenderer = itemToSetInEditableMode;
					ev.dataField = "DateAdmin";
					id_DataGrid.dispatchEvent(ev);
					
				}
			}
			
			private function addRecordClickHandler():void
			{
				if( isInvalid() )
				{
					id_Add.enableAll = false;
					return;
				}
				if( null == model.quickInputDTO.Assessment.PatientFollowupMerged )
					model.quickInputDTO.Assessment.PatientFollowupMerged = new ArrayCollection();
				
				if(null == PatientFollowup.FollowUpMethodType)
					PatientFollowup.FollowUpMethodType = new FollowUpMethodTypeDTO();
				
			//	PatientFollowup.FollowUpMethodType.FollowUpMethodTypeID = 0;
				if(id_Office.selected)
				{
					PatientFollowup.FollowUpMethodType.MethodName = Constants.OFFICE_FOLLOWUP_METHOD_NAME;//(QSUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.OFFICE_FOLLOWUP_METHOD_NAME) as FollowUpMethodTypeDTO) ;
					PatientFollowup.FollowUpMethodType.FollowUpMethodTypeID = 1;
				}
				else if(id_Phone.selected)
				{
					PatientFollowup.FollowUpMethodType.MethodName = Constants.PHONE_FOLLOWUP_METHOD_NAME; //(QSUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.PHONE_FOLLOWUP_METHOD_NAME) as FollowUpMethodTypeDTO) ;
					PatientFollowup.FollowUpMethodType.FollowUpMethodTypeID = 2;
				}
				else if(id_Email.selected)
				{
					PatientFollowup.FollowUpMethodType.MethodName = Constants.EMAIL_FOLLOWUP_METHOD_NAME;//(QSUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.EMAIL_FOLLOWUP_METHOD_NAME) as FollowUpMethodTypeDTO) ;
					PatientFollowup.FollowUpMethodType.FollowUpMethodTypeID = 3;
				}
				else if(id_Chat.selected)
				{
					PatientFollowup.FollowUpMethodType.MethodName = Constants.CHAT_FOLLOWUP_METHOD_NAME;//(QSUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.CHAT_FOLLOWUP_METHOD_NAME) as FollowUpMethodTypeDTO) ;
					PatientFollowup.FollowUpMethodType.FollowUpMethodTypeID = 4;
				}
				else if(id_Video.selected)
				{
					PatientFollowup.FollowUpMethodType.MethodName = Constants.VIDEO_FOLLOWUP_METHOD_NAME;//(QSUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.VIDEO_FOLLOWUP_METHOD_NAME) as FollowUpMethodTypeDTO) ;
					PatientFollowup.FollowUpMethodType.FollowUpMethodTypeID = 5;
				}
				
				model.quickInputDTO.Assessment.PatientFollowupMerged.addItem(PatientFollowup);
				if(hasViewChanged)
					hasViewChanged = false;
				
				hasViewChanged = true;
				resetFields();
			}
			
