			public function labelFunction(item:Object) : String
			{		
				if( item )
					return item.LabTestDescription + ", " + item.TestCode  ;
				else
					return "";
			}
			
			public function TypeLabelFunction(item:PatientFollowupMergedDTO,iCol:int) : String
			{		
				if( item.IsByDate )
					return item.FollowUpDate ;
				else if( item.IsOnCompletion )
				{
					if( item.IsDrugselected && item.DrugName)
						return item.DrugName.toString();
					else if( item.IsLabTestSelected && item.LabTestName )
						return item.LabTestName.toString(); 
				}
				return "";
			}
			
