			private function bindData():void
			{
				if( isInvalid() )
				{
					trace( "followup data is invalid" );
					id_Add.enableAll = false;
					return;
				}
				id_Add.enableAll = true;
				
				if(PatientFollowup ==  null)
				{
					PatientFollowup = new PatientFollowupMergedDTO();
				}
				
				if( id_ByDate.selected )
				{
					PatientFollowup.IsByDate 				= true;				
					PatientFollowup.IsOnCompletion 			= false;
					
					if(id_FollowUpDate != null && id_FollowUpDate.textInput.text.length > 2 )
					{
						PatientFollowup.FollowUpDate = id_FollowUpDate.textInput.text;//.selectedDate;
					}
					
				}
				else if( id_OnCompletion.selected )
				{
					PatientFollowup.IsByDate 				= false;				
					PatientFollowup.IsOnCompletion 			= true;
					
					if(id_ddlLabs.selectedItem)
					{
						PatientFollowup.LabTestID 				= (id_ddlLabs.selectedItem as FollowupLabsDTO).PatientFollowUpLabID;// .LabTestType.LabTestTypeID; on W. Baber 					
						PatientFollowup.LabTestName 			= (id_ddlLabs.selectedItem as FollowupLabsDTO).LabTestDescription;// .LabTestType.LabTestTypeID; on W. Baber 					
						//PatientFollowup.IsInHouseLabTestSelected = (id_ddlLabs.selectedItem as FollowupLabsDTO).IsInHouseLab;
						PatientFollowup.IsLabTestSelected 		= true;
						PatientFollowup.IsDrugselected 			= false;
					}
					else
					{
						PatientFollowup.LabTestID = -1;
					}
					
					if(id_ddlDrugs.selectedItem)
					{	
						PatientFollowup.DrugID = (id_ddlDrugs.selectedItem as MedicationDTO).PatientMedicationID ;//.PatientMedicationPrescribedID;on W. Baber 
						PatientFollowup.DrugName = (id_ddlDrugs.selectedItem as MedicationDTO).GenericName ;//.PatientMedicationPrescribedID;on W. Baber 
						PatientFollowup.IsDrugselected =  true;
						
						PatientFollowup.IsLabTestSelected =  false;
					}
					else
					{
						PatientFollowup.DrugID = -1;
					}
					//handle null exception on save visit
					//Tahir Alvi
					// 05-09-2012
					/* if(null == PatientFollowup.FollowUpMethodType)
						PatientFollowup.FollowUpMethodType = new FollowUpMethodTypeDTO();
					
					PatientFollowup.FollowUpMethodType.FollowUpMethodTypeID = 0; */
				}
				
				
				//M
				if(id_Office.selected)
				{
					PatientFollowup.FollowUpMethodType = (QSUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.OFFICE_FOLLOWUP_METHOD_NAME) as FollowUpMethodTypeDTO) ;
				}
				else if(id_Phone.selected)
				{
					PatientFollowup.FollowUpMethodType = (QSUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.PHONE_FOLLOWUP_METHOD_NAME) as FollowUpMethodTypeDTO) ;
				}
				else if(id_Email.selected)
				{
					PatientFollowup.FollowUpMethodType = (QSUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.EMAIL_FOLLOWUP_METHOD_NAME) as FollowUpMethodTypeDTO) ;
				}
				else if(id_Chat.selected)
				{
					PatientFollowup.FollowUpMethodType = (QSUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.CHAT_FOLLOWUP_METHOD_NAME) as FollowUpMethodTypeDTO) ;
				}
				else if(id_Video.selected)
				{
					PatientFollowup.FollowUpMethodType = (QSUtilityFunctions.getFollowupMethodTypeDTOByName(Constants.VIDEO_FOLLOWUP_METHOD_NAME) as FollowUpMethodTypeDTO) ;
				}
				
				
				PatientFollowup.IsAcute = id_Acute.selected;
				PatientFollowup.IsChronic = id_Chronic.selected;
				PatientFollowup.IsPreventive = id_Preventive.selected;
				
				if( id_Service.selectedIndex >= 0 )
				{
					PatientFollowup.objServiceTypeDTO = id_Service.selectedItem as ServiceTypeDTO;
				}
				else
				{
					var serviceDto:ServiceTypeDTO 		= new ServiceTypeDTO();
					serviceDto.FollowupService 	  		= id_Service.textInput.text;
					PatientFollowup.objServiceTypeDTO 	= serviceDto;
				}
				
				if (id_FreqAge.selected)
				{
					PatientFollowup.IsAgeSelected = true;
					PatientFollowup.IsDurationSelected = false;
					
					PatientFollowup.AgeTypeDTO = id_AgeType.selectedItem as InstructionAgeTypeDTO;
					PatientFollowup.AgeValueTypeDTO = id_AgeValue.selectedItem as InstructionAgeValueTypeDTO;
				}
				else if (id_FreqDuration.selected)
				{
					PatientFollowup.IsAgeSelected = false;
					PatientFollowup.IsDurationSelected = true;
					
					PatientFollowup.AfterDurationValue = parseInt(id_AfterDurationValue.text);
					PatientFollowup.AfterInstructionDurationTypeDTO = id_AfterDurationType.selectedItem as InstructionDurationTypeDTO;
					
					PatientFollowup.ForDurationValue = parseInt(id_ForDurationValue.text);
					PatientFollowup.ForInstructionDurationTypeDTO = id_ForDurationType.selectedItem as InstructionDurationTypeDTO;
				}
				
				PatientFollowup.IsPRN = id_PRN.selected;
				
				PatientFollowup.VisitDate = model.visitDTO.VisitDate;
				PatientFollowup.VisitID = model.visitDTO.VisitId;;
				PatientFollowup.PatientID = model.visitDTO.PatientId;
				PatientFollowup.CreatedBy = model.loggedInUserDTO.UserId;
				PatientFollowup.CreatedAt = new Date();
				PatientFollowup.ModifiedAt = Constants.NULL_DATE;
				PatientFollowup.DictationID = Constants.GUID_FORMAT;
				
				if (id_Add.notesDTO)
				{
					PatientFollowup.Notes 		= id_Add.notesDTO.Note;
					PatientFollowup.NoteSubject = id_Add.notesDTO.NoteSubject;
				}
				
				if (id_Add.dictationDTO != null && id_Add.dictationDTO.DictationID != null)
				{
					PatientFollowup.DictationID = id_Add.dictationDTO.DictationID;
				}
				
				
			}
			
