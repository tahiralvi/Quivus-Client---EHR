			public function NatureLabelFunction(item:PatientFollowupMergedDTO, iCol:int):String
			{
				if( item.IsAcute )
					return "Acute";
				if( item.IsChronic )
					return "Chronic";
				if( item.IsPreventive )
					return "Preventive";
				
				return "";
			}
			
			public function frequencyLabelFunction(item:Object, iCol:int):String
			{
				var label:String = "";
				var freq:PatientFollowupMergedDTO = PatientFollowupMergedDTO(item);
				
				if (freq.IsAgeSelected)
				{
					if (freq.AgeTypeDTO && freq.AgeTypeDTO.AgeTypeName)
						label += freq.AgeTypeDTO.AgeTypeName + " " ;
					
					if (freq.AgeValueTypeDTO && freq.AgeValueTypeDTO.AgeValueTypeName)
						label += freq.AgeValueTypeDTO.AgeValueTypeName;
				}
				else if (freq.IsDurationSelected)
				{
					if (!isNaN(freq.AfterDurationValue))
						label += "After " + freq.AfterDurationValue + " ";
					
					if (freq.AfterInstructionDurationTypeDTO && freq.AfterInstructionDurationTypeDTO.DurationTypeName)
						label += freq.AfterInstructionDurationTypeDTO.DurationTypeName + " ";
					
					if (!isNaN(freq.ForDurationValue))
						label += "for " + freq.ForDurationValue + " ";
					
					if (freq.ForInstructionDurationTypeDTO && freq.ForInstructionDurationTypeDTO.DurationTypeName)
						label += freq.ForInstructionDurationTypeDTO.DurationTypeName;
				} 
				
				return label;
			}
			
			public function displayRowNum(oItem:Object,iCol:int):String
			{
				var rowNumber:int = id_DataGrid.dataProvider.getItemIndex(oItem) + 1;
				return String(rowNumber);
			}
			
			private function id_OptionType_changeHandler(event:ItemClickEvent):void
			{
				bindData();
			}
			
			
			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				id_DataGrid.addEventListener(DataGridActionsEvent.EDIT_RECORD_CLICK, editRecordClickHandler, false, 0, true);
				id_DataGrid.addEventListener(DataGridActionsEvent.DELETE_RECORD_CLICK, deleteRecordClickHandler, false, 0, true);
				id_DataGrid.addEventListener(DataGridActionsEvent.ITEM_EDIT_KEY_UP, itemEditKeyUpHandler, false, 0, true);
			}
			
			private function preInitialize():void
			{
				if (!deleteColumnData)
					deleteColumnData = {};
				
				deleteColumnData["noteDataFields"] 		= {subject: "NoteSubject", note: "Notes", header: "objServiceTypeDTO.FollowupService"};
				deleteColumnData["dictationDataField"] 	= "DictationID";
				deleteColumnData["recordIDField"] 		= "PatientFollowUpMergeID";
				deleteColumnData["section"] 			= QIPopUpManager.FOLLOW_UP_INSTRUCTIONS;
			}
			
			
			////////////////////////////// Notes and Dictation /////////////////////////////////////////////////
			
			private var recordGridNotesPopUp:NotesPanel;
			private var section:String = QIPopUpManager.FOLLOW_UP_INSTRUCTIONS;
			
			private function onWriteNotesClick(event:Event):void
			{
				if (!recordGridNotesPopUp)
					recordGridNotesPopUp = new NotesPanel();
				
				if (!recordGridNotesPopUp.isPanelShown)
				{
					var headingLabel:String = "";
					
					var addRecord:AddRecord = AddRecord(event.target);
					
					recordGridNotesPopUp 				= new NotesPanel();
					recordGridNotesPopUp.width			= 250;
					recordGridNotesPopUp.height			= 110;
					recordGridNotesPopUp.HeadingLable 	= "Follow Up";
					recordGridNotesPopUp.VisitDateLable = model.FormatedVisitDate;//new Date().toDateString();
					recordGridNotesPopUp.ShowPopup(this);
					
					recordGridNotesPopUp.notesDTO		=  addRecord.notesDTO; //gridNotesDTO;
					
					QIPopUpManager.addPopUp(recordGridNotesPopUp, section);
					
					var pt:Point = id_Add.localToGlobal(new Point(id_Add.id_WriteNotes.x ,id_Add.id_WriteNotes.y));
					
					recordGridNotesPopUp.move(pt.x - 195, pt.y + 20);
					
					recordGridNotesPopUp.id_header.id_CloseBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
						
					}, false, 0, true);
					
					recordGridNotesPopUp.id_header.id_SaveBtn.addEventListener(MouseEvent.CLICK, function(event:MouseEvent):void
					{
						recordGridNotesPopUp.SaveNotes();
						if(recordGridNotesPopUp.id_body.id_message.text.length > 0)
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotesSelected);
							
						}
						else
						{
							id_Add.id_WriteNotes.setStyle("skinClass", QIWriteNotes);
							
						}
						recordGridNotesPopUp.removeNotePanel();
						QIPopUpManager.removePopUp(recordGridNotesPopUp, section);
					});
				}
			}
			
			private var recordLevelDicPanel:DictationPopup;
			private function writeDictationClickHandler(event:Event):void
			{
				var addRecord:AddRecord = AddRecord(event.target);
				
				recordLevelDicPanel = QIDictationManager.show(addRecord, recordLevelDicPanel, addRecord.dictationDTO, addRecord.id_WriteDictation);
				
				QIPopUpManager.addPopUp(recordLevelDicPanel, QIPopUpManager.LAB_OUT);
				recordLevelDicPanel.move( recordLevelDicPanel.x - 81, recordLevelDicPanel.y);
				recordLevelDicPanel.addEventListener(MouseEvent.CLICK, function():void
				{
					QIPopUpManager.removePopUp(recordLevelDicPanel, QIPopUpManager.LAB_OUT);
					
					if(recordLevelDicPanel && recordLevelDicPanel.DictationID)
					{
						id_Add.id_WriteDictation.setStyle("skinClass", ImmunizationSpeakerBtn);
					}
					
				}, true, 0, false);
				
			}
			
			private var _follUpCollection:ArrayCollection;
			[Bindable]
			public function get follUpCollection():ArrayCollection
			{
				return _follUpCollection;
			}
			
			public function set follUpCollection(value:ArrayCollection):void
			{
				_follUpCollection = value;
				if (_follUpCollection && _follUpCollection.length >0)
				{	
					if(hasViewChanged)
						hasViewChanged = false;
					
					hasViewChanged = true;
				}
				else if(_follUpCollection.length < 1)
				{
					hasViewChanged = false;
				}
			}
			
			
			public function AllowMoveToNextPanel( callBack:Function ):void
			{
				if( id_Add.enableAll )
				{
					UtilityFunctions.AskMessage( "There are changes in the form, do you still want to leave form in current state?", function ():void
					{
						callBack(); 
					}); 
				}
				else
				{
					callBack();
				}
			}
			
			
			public function LoadStaticData():void
			{
				if(model.followUpMethodTypeList==null || model.followUpMethodTypeList.length==0)
				{
					var lfmtEvent : LoadFollowUpMethodTypeEvent = new LoadFollowUpMethodTypeEvent();
					CairngormEventDispatcher.getInstance().dispatchEvent( lfmtEvent );
				}
			}
			
		]]>
	</fx:Script>
