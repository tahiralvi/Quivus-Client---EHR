			private function itemEditKeyUpHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.VB_IMMUNIZATION ) )//Tahir Alvi - implement security check 
				{
					var lblFld:String = SparkComboBoxItemEditor(event.target).labelField;
					
					if (lblFld == "Dose")
					{
						
						if( event.searchString.length > 2 )
						{
							var doseEvent : LoadImmunizationDoseStaticDataEvent = new LoadImmunizationDoseStaticDataEvent( event.searchString );
							CairngormEventDispatcher.getInstance().dispatchEvent( doseEvent );					
						}
					}
					else if (lblFld == "LotNumber")
					{
						if( event.searchString.length > 0 )
						{
							var lotNumberEvent : LoadImmunizationLotNumberStaticDataEvent = new LoadImmunizationLotNumberStaticDataEvent( event.searchString );
							CairngormEventDispatcher.getInstance().dispatchEvent( lotNumberEvent );					
						}
					}
				}
			}
			
			private function editRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.VB_IMMUNIZATION ) )//Tahir Alvi - implement security check 
				{
					id_ImmunizationGrid.editable = true;
					var rowIndex:int = id_ImmunizationGrid.selectedIndex;
					var itemToSetInEditableMode:IListItemRenderer = id_ImmunizationGrid.indexToItemRenderer(rowIndex);
					
					var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
					ev.columnIndex = 2;
					ev.rowIndex = rowIndex;
					ev.itemRenderer = itemToSetInEditableMode;
					ev.dataField = "DateAdmin";
					
					id_ImmunizationGrid.dispatchEvent(ev);
				}
			}
			
			private function deleteRecordClickHandler(event:DataGridActionsEvent):void
			{
				if( QSSecurityUtil.Security.IsModuleEditable( QSSecurityUtil.VB_IMMUNIZATION ) )//Tahir Alvi - implement security check 
				{
					var curTar:LabelDataGrid = LabelDataGrid(event.currentTarget);
					
					if (curTar.selectedItem)
					{
						var immunizationID:int = ImmunizationDTO(curTar.selectedItem).PatientImmunizationId;
						
						if (immunizationID == 0)
						{
							model.immunizationDTOList.removeItemAt(curTar.selectedIndex);
							if (model.immunizationDTOList.length <= 0)
							{
								_hasGridChanged = false;
								//hasViewChanged = isGetEdited();
							}
						}
						else
						{
							UtilityFunctions.AskMessage(  "Do you want to delete selected record", function():void
							{
								curTar.selectedItem.IsDeleted = true;
								model.immunizationDTOList.filterFunction = filterDeletedItems;
								model.immunizationDTOList.refresh();
								
								hasViewChanged = _hasGridChanged = true;
							});
						}
					}
				}
			}
			
			private function filterDeletedItems(item:Object):Boolean
			{
				var b:Boolean = item["IsDeleted"];
				return (!b);
			}
			
			private function recentPatientGridItemEditBeginHandler(event:DataGridEvent):void 
			{	
				id_ImmunizationGrid.createItemEditor(event.columnIndex, event.rowIndex);
				
				if ( event.columnIndex == 3 || event.columnIndex == 4 || event.columnIndex == 5)
				{
					SparkComboBoxItemEditor(id_ImmunizationGrid.itemEditorInstance).data = event.itemRenderer.data; 
				} 
				
				if (event.columnIndex == 3 ) // == "ImmunizationType.ImmunizationTypeName")
				{
					var dto:ImmunizationTypeDTO = event.itemRenderer.data.ImmunizationType as ImmunizationTypeDTO;
					var col:ArrayCollection     = model.immunizationTypeDTOList;
					
					var i:int;
					if(col)
					{
						for( i = 0; i < col.length; i ++ )
						{
							var item:ImmunizationTypeDTO = col.getItemAt( i ) as ImmunizationTypeDTO;
							if( dto.ImmunizationTypeId == item.ImmunizationTypeId )
							{
								SparkComboBoxItemEditor(id_ImmunizationGrid.itemEditorInstance).id_ComboEditor.selectedItem = item;
								break;
							}
						}
					}
				}
			}
			
			
			
			
