			private function switchPageForGridView(event:*):void
			{
				
				if( UtilityFunctions.IsNullOrEmpty( model.immunizationCurrentPageByPatient ) )
					model.immunizationCurrentPageByPatient = new PageDTO();
				
				var pvital:PageDTO 		= model.immunizationCurrentPageByPatient;
				pvital.fromDate 		= model.defaultFilterAndPaging.fromDate;
				pvital.toDate 			= model.defaultFilterAndPaging.toDate;
				pvital.pageSize 		= model.defaultFilterAndPaging.pageSize;
				pvital.LastVisitNumber 	= model.defaultFilterAndPaging.LastVisitNumber;
				
				var lpviEvent: LoadPatientImmunizationEvent = new LoadPatientImmunizationEvent( model.loadedPatientId ); 
				CairngormEventDispatcher.getInstance().dispatchEvent( lpviEvent );
			}
			
