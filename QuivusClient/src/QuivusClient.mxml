			private function localDBStartUp():void
			{
				//Mansoor move DB file
				var dbFile:File = File.applicationDirectory.resolvePath("db/" + Constants.REGISTERATION_STATIC_DATA_DB_NAME);
				var dbWorkFile:File = File.applicationStorageDirectory.resolvePath("temp/"+model.appVersion + "/" + Constants.REGISTERATION_STATIC_DATA_DB_NAME);
				
				if(!dbWorkFile.exists && dbFile.exists)
				{
