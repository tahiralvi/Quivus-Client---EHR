			protected function windowedapplication1_preinitializeHandler(event:FlexEvent):void
			{
				//Load Application Configuration File
				LoadConfigurations();
				
				
				QSCommonController.getInstance();
				SearchPatientController.getInstance();
				QIController.getInstance();
				AppController.getInstance();
				SMSController.getInstance();
				EmailController.getInstance();
				SearchProviderController.getInstance();
				VBController.getInstance();
				
				
				//myLogging();
				CursorManager.setBusyCursor();
				
				QuivusServiceLocator.getInstance().getQuivusManagerServiceInstance();				
				QuivusServiceLocator.getInstance().getStreamingServiceInstance();
				/* QuivusServiceLocator.getInstance().getQuivusManagerServiceInstance();
				QuivusServiceLocator.getInstance().getQuivusManagerServiceInstance(); */
				
				addEventListener(KeyboardEvent.KEY_DOWN, function(event:KeyboardEvent):void
				{
					if( event.ctrlKey && event.keyCode == Keyboard.L )
					{
						try
						{
							var file:File = File.applicationStorageDirectory.resolvePath( ( LogTarget as FileTarget).DEFAULT_LOG_PATH + ".html" );
							if( Log.isDebug() )
								logger.debug( "Loading Log File ...." + file.nativePath );
							file.openWithDefaultApplication();
						}
						catch(e:Error)
						{
							logger.error( "Unable to Load Log File ...." + file.nativePath );
						}
					}
				});
			}
			
