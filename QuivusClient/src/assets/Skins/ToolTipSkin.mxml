<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009" 
			 blendMode="normal" x="0" y="0">
	
	<s:states>
		<s:State name="normal"/>
	</s:states>
	
	<!-- border --> 
	<!--- @private -->
	
	
	<!-- fill -->
	<!--- Defines the appearance of the TextInput component's background. -->
	<s:Group id="id_bg" width="100%" height="100%" minHeight="30">
		
		
		<s:Rect id="id_rect" height="{id_bg.height-10}" radiusX="3" radiusY="3" width="100%" x="0" y="0">
			<s:filters>
				<s:DropShadowFilter alpha="0.5" angle="90" blurX="3" blurY="3" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			</s:filters>
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#96F2FF" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#6FC9FF" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
			
		</s:Rect>
		<s:Path data="M 3.818 0 L 0 9.271 L 14.509 0 L 3.818 0 Z" height="10" width="17" winding="nonZero" x="9" y="4" rotation="180" scaleX="-1">
			<s:fill>
				<s:SolidColor color="#96F2FF"/>
			</s:fill>
			
		</s:Path>
		
		<!--		<s:RichEditableText id="textDisplay" fontFamily="Calibri" fontSize="12" x="0" y="-45"
		verticalAlign="middle"
		widthInChars="10" color="#000000" 
		editable="false"/>-->
		
	</s:Group>
	
	<!-- shadow -->
	<!--- @private -->
	<s:Rect left="1" top="1" right="1" height="1" id="shadow" radiusX="5" radiusY="5">
		<s:fill>
			<s:SolidColor color="0xD4D4FF" alpha="0.5" />
		</s:fill>
	</s:Rect>
	
	<!-- text -->
	<!--- @copy spark.components.supportClasses.SkinnableTextBase#textDisplay -->
	
	
</s:SparkSkin>
