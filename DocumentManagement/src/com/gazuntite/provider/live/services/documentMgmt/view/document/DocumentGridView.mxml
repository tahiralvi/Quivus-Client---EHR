			<mx:dataProvider>
				<!--<mx:GroupingCollection2 id="id_GroupCol" source="{DataProvider}" childrenField="">
				<mx:grouping>
				<mx:Grouping>
				<mx:GroupingField name="SectionName"/>
				<mx:GroupingField name="SectionName"/>
				</mx:Grouping>
				</mx:grouping>
				</mx:GroupingCollection2>-->
				<mx:HierarchicalData id="id_GroupCol" source="{DataProvider}" 
									 childrenField="ChildDocument"/>
			</mx:dataProvider>
			
