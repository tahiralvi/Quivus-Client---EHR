				<mx:AdvancedDataGridColumn width="80" dataField="SectionName" itemRenderer="mx.controls.Label"  	
										   headerText="Doc. Type" headerRenderer="com.gazuntite.provider.live.services.documentMgmt.view.itemRenderer.MyCustomHeader" />
				<mx:AdvancedDataGridColumn width="100" dataField="PatientFullName" itemRenderer="mx.controls.Label" 
										   headerText="Patient" headerRenderer="com.gazuntite.provider.live.services.documentMgmt.view.itemRenderer.MyCustomHeader"/>
				<mx:AdvancedDataGridColumn width="80" dataField="StrUploadedDate" itemRenderer="mx.controls.Label" 
										   headerText="Date" headerRenderer="com.gazuntite.provider.live.services.documentMgmt.view.itemRenderer.MyCustomHeader"/>
				<mx:AdvancedDataGridColumn width="100" dataField="DocumentName" itemRenderer="mx.controls.Label" 
										   headerText="Doc. Name" headerRenderer="com.gazuntite.provider.live.services.documentMgmt.view.itemRenderer.MyCustomHeader"/>
				<mx:AdvancedDataGridColumn width="100" dataField="UploadedByUserFullName"  
										   headerText="Uploaded By" headerRenderer="com.gazuntite.provider.live.services.documentMgmt.view.itemRenderer.MyCustomHeader"
										   itemRenderer="com.gazuntite.provider.live.services.documentMgmt.view.itemRenderer.NameRenderer"/>
				<mx:AdvancedDataGridColumn dataField="CommentNote" itemRenderer="mx.controls.Label" wordWrap="true"
										   headerText="Notes"  headerRenderer="com.gazuntite.provider.live.services.documentMgmt.view.itemRenderer.MyCustomHeader"/>
				<mx:AdvancedDataGridColumn width="100" headerText="" 		itemRenderer="com.gazuntite.provider.live.services.documentMgmt.view.itemRenderer.EditDeleteRenderer" />
				
