<?xml version="1.0" encoding="utf-8"?>
<s:MXAdvancedDataGridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
								  xmlns:s="library://ns.adobe.com/flex/spark" 
								  xmlns:mx="library://ns.adobe.com/flex/mx" 
								  focusEnabled="true"
								  >
	<fx:Script>
		<![CDATA[
			
			public override function set data(value:Object):void
			{
				super.data = value;
				if( value && value.hasOwnProperty("UploadedByUserFullName") )
					if( value.UploadedByUserFullName && data.UploadedByUserFullName != '')
						lblData.visible = true;
			}

		]]>
	</fx:Script>
	<s:Label id="lblData" visible="false" top="4" left="0" right="0" bottom="0" text="{listData.label}" toolTip="{listData.label}"/>
</s:MXAdvancedDataGridItemRenderer>
