			public function LoadData(data:PatientDocumentDTO):void
			{
				ClearInfo();
				var token:Array = data.ServerFilePath.split( '.' );
				var type:String = "." + token[ token.length - 1 ];
				
				setDocumentIcon( type, data.ServerFilePath );
				
				
				editMode = true;
				id_savebtn.label 	= "Update";
				pdDTO = data;
				
				id_PatientName.text = data.PatientFullName;
				id_PatientName.enabled = false;
				
				id_quivusId.text 	= data.QuivusId;
				id_quivusId.enabled = false;
				
				id_gender.text 		= data.GenderName;
				id_gender.enabled 	= false;
				
				selectedPatientId 	= data.PatientID;
				//selectedPatientName	= data.PatientFirstName+"|"+data.PatientMiddleName+"|"+data.PatientLastName;
				selectedPatientName = "";
				if( ! UtilityFunctions.IsNullOrEmpty( data.PatientFirstName ) )
					selectedPatientName	+= data.PatientFirstName+"|";
				if( ! UtilityFunctions.IsNullOrEmpty( data.PatientMiddleName ) )
					selectedPatientName	+= data.PatientMiddleName+"|";
				if( ! UtilityFunctions.IsNullOrEmpty( data.PatientLastName ) )
					selectedPatientName	+= data.PatientLastName;
				
				documentId			= data.DocumentId;
				id_note.text 		= data.CommentNote;
				
				id_DocumentName.text = data.DocumentName;
				
				callLater( function():void
				{
					if( data.SectionParentId == 0 )
					{
						setSubSecTypeSelectedById( data.SectionId );
					}
					else
					{
						setSecTypeSelectedById( data.SectionId );
					}
					//Change Request @ https://zigron.basecamphq.com/projects/4449228-quivus/todo_items/119823831/comments
					//user can change section or sub-section and once updated document should be placed in updated section/sub section.
					/* id_SectionTypesCmbo.enabled 	= false; //
					id_SubSectionTypesCmbo.enabled 	= false; */
				});
			}
			
