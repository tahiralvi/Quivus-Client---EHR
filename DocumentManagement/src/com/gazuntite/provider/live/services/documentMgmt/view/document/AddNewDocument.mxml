			SearchListView.addEventListener( "SearchListPatientSelected", OnItemClick);
			SearchListView.ShowPopup( this );
			
			}
			
			private function OnItemClick(event:Event):void
			{
			try
			{
			trace("LoadPatient",SearchListView.id_SearchList.selectedItem.UserId, 
			SearchListView.id_SearchList.selectedItem.FirstName, SearchListView.id_SearchList.selectedItem.LastName);
			
			var selectedPatient:LPatientSearchDTO = SearchListView.id_SearchList.selectedItem;
			
			var fName:String = selectedPatient.FirstName ? selectedPatient.FirstName :"";
			var mName:String = selectedPatient.MiddleName? selectedPatient.MiddleName:"";
			var lName:String = selectedPatient.LastName  ? selectedPatient.LastName  :"";
			
			id_PatientName.text 	= fName + " " + mName + " " + lName;
			id_PatientName.enabled 	= false;
			
			id_quivusId.text 	= selectedPatient.QuivusID;
			id_quivusId.enabled = false;
			
			id_gender.text 		= selectedPatient.GenderName;
			id_gender.enabled 	= false;
			
			selectedPatientId 	= selectedPatient.PatientId;
			selectedPatientName	= selectedPatient.FirstName+"|"+selectedPatient.MiddleName+"|"+selectedPatient.LastName;
			}
			catch(e:Error)
			{
			trace("patientExamControls", e );
			}
			}
			
