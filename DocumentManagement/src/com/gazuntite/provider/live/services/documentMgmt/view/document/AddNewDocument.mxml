				documentId			= 0;
				
				id_PatientName.text 	= ""
				id_PatientName.enabled 	= false;
				
				id_quivusId.text 	= "";
				id_quivusId.enabled = false;
				
				id_gender.text 		= "";
				id_gender.enabled 	= false;
				
				selectedPatientId 	= -1;
				selectedPatientName	= "";
				id_note.text 		= "";
				
				id_FileName.text 	= "";
				id_FileName.enabled = false;
				
				//id_ReferredBy.text 	= "";
				
				
				id_Image.source 	= null;
				
				id_SectionTypesCmbo.selectedIndex 	= -1;
				id_SectionTypesCmbo.selectedIndex	= -1;
				id_Provider.selectedIndex 			= -1;
				
				id_SectionTypesCmbo.enabled 		= true;
				id_SectionTypesCmbo.textInput.text 	= "";
				id_SubSectionTypesCmbo.enabled 		= true;
				id_SubSectionTypesCmbo.textInput.text = "";
				
			}
			
			public function IsValid():Boolean
			{
				var isValid:Boolean = true;
				
				if( isValid && ( id_PatientName.text == "" || id_quivusId.text == "" || id_gender.text	== "" || selectedPatientId 	== -1 ) )
				{
					isValid = false;
					Alert.show( "Please Select Patient", "Invalid document data", 4, this);
				}
				
				if( isValid && ( id_SectionTypesCmbo.selectedIndex == -1 || id_SubSectionTypesCmbo.selectedIndex == -1 ) )
				{
					isValid = false;
					Alert.show( "Please Select Section/Sub-Section", "Invalid document data", 4, this);
				}
				
				if( isValid && !editMode && ( null == fileReference || id_FileName.text == "") )
				{
					isValid = false;
					Alert.show( "Please Select Document", "Invalid document data", 4, this);
				}
				
				return isValid;
				
			}
			
			private function setSecTypeSelectedById( id:int ):void
			{
				var len:int = model.documentSectionTypeDTOList.length;
				
				for( var i:int = 0; i < len; i ++ )
				{
					var dto:DocumentSectionTypeDTO = model.documentSectionTypeDTOList.getItemAt( i ) as DocumentSectionTypeDTO;
					if( dto.SectionId == id )
					{
						id_SectionTypesCmbo.selectedItem = dto;
						id_SubSectionTypesCmbo.selectedIndex = 0;
						break;
					}
				}
			}
			
			private function setSubSecTypeSelectedById( id:int ):void
			{
				var len:int = model.documentSectionTypeDTOList.length;
				id_SectionTypesCmbo.dataProvider = model.documentSectionTypeDTOList;
				for( var i:int = 0; i < len; i ++ )
				{
					var pdto:DocumentSectionTypeDTO = model.documentSectionTypeDTOList.getItemAt( i ) as DocumentSectionTypeDTO;
					if( pdto.children )
					{
						var lis:ArrayCollection = pdto.children;
						for( var j:int = 0; j < lis.length; j++ )
						{
							var dto:DocumentSectionTypeDTO = lis.getItemAt( j ) as DocumentSectionTypeDTO;
							if( dto.SectionId == id )
							{
								id_SectionTypesCmbo.selectedIndex = i;
								id_SubSectionTypesCmbo.dataProvider = pdto.children;
								id_SubSectionTypesCmbo.selectedIndex = j;
								return;
							}
						}
					}
					else if( pdto.SectionId == id )
					{
						id_SectionTypesCmbo.selectedIndex = id;
						id_SubSectionTypesCmbo.selectedIndex = 0;
						return;
					}
				}
			}
			
			
