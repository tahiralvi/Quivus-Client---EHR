			protected function id_browse_clickHandler(event:MouseEvent):void
			{
				fileReference=new FileReference();
				fileReference.addEventListener(Event.SELECT, onFileSelected);
				
				
				var imagesFilter:FileFilter 	= new FileFilter("Images ( *.bmp,*.jpg,*.jpeg,*.tiff,*.gif,*.png )", "*.bmp;*.jpg;*.jpeg;*.tiff;*.gif;*.png"); 
				var docFilter:FileFilter 		= new FileFilter("Documents ( *.pdf,*.doc,*.docx,*.wpd )", "*.pdf;*.doc;*.docx;*.wpd");
				var allTypeFilter:FileFilter 	= new FileFilter("All Files (Documents, Images)","*.pdf;*.doc;*.docx;*.wpd;*.jpg;*.jpeg;*.tiff;*.gif;*.png");
				
				
				if(s!=null && s.connected && dataChannelSocket!=null && dataChannelSocket.connected)
				{
					fileReference.browse([docFilter, imagesFilter, allTypeFilter]);
				}
				else
				{
					upLoad();
					fileReference.browse([docFilter, imagesFilter, allTypeFilter]);
				} 
			}
			
			public function onFileSelected(event:Event):void
			{
				try
				{
					trace("onFileSelected");
					fileReference.addEventListener(Event.COMPLETE, onFileLoaded);
					fileReference.load();
				}
				catch(e:Error)
				{
					trace("ERROR IN onFileSelected", e.errorID, e.name, e.message);
				}
				
			}
			
			protected function onFileLoaded(event:Event):void
			{
				try
				{
					var fileReference:FileReference=event.target as FileReference;
					trace("File loaded");
					var data:ByteArray=fileReference.data;
					mLoader = new Loader();
					mLoader.loadBytes(data); 
					//mLoader.contentLoaderInfo.addEventListener(Event.COMPLETE, onLoaderComplete);
					
					//saveToServer(data,fileReference.name,435,3,3);
					id_FileName.text = fileReference.name;
					setDocumentIcon( fileReference.type, data );
				}
				catch(e:Error)
				{
					trace("ERROR IN onFileLoaded", e.errorID, e.name, e.message);
				}
			}
			
			private function setDocumentIcon( type:String, data:Object=null ):void
			{
				switch( type.toLowerCase() )
				{
					case ".pdf":
						id_Image.source = PDF_ICON;
						break;
					case ".doc":
					case ".docx":
						id_Image.source = WORD_ICON;
						break;
					case ".wpd":
						id_Image.source = WPD_ICON;
						break;
					default:
						id_Image.source = data;
						
				}
			}
			
			protected function id_savebtn_clickHandler(event:MouseEvent):void
			{
				if( IsValid() )
				{
					var secID:DocumentSectionTypeDTO = id_SectionTypesCmbo.selectedItem as DocumentSectionTypeDTO;
					var subSec:DocumentSectionTypeDTO = id_SubSectionTypesCmbo.selectedItem as DocumentSectionTypeDTO;
					
					if( selectedPatientId > 0 &&  secID != null )
					{
						var note:String = id_note.text;
						
						var subSection:int =0;
						if(subSec!=null)
							subSection = subSec.SectionId;	
						
						var fileName:String;
						
						if( editMode && fileReference == null) //fileReference will be null if user have not selected new file, 
						{
							fileName = id_DocumentName.text;
							
							UpdateDocumentOnServer( note, fileName, selectedPatientId, subSection, secID.SectionId );
						}
						else
						{
							fileName = fileReference.name;
							
							saveToServer( note, fileName, selectedPatientId, subSection, secID.SectionId );
						}
					}
				}
			}
			
			private function UpdateDocumentOnServer(note:String, fileName:String, patientId:int, subSecId:int, sectionId:int):void
			{
				this.pdDTO.DocumentName				= fileName;
				pdDTO.CommentNote					= note;
				
				var df:DateFormatter 				= new DateFormatter();
				df.formatString 					= "DD-M-YYYY";
				pdDTO.ModifiedAt					= df.format( new Date() );
				
				if(subSecId==0)
				{
					pdDTO.SectionId					= sectionId;
					pdDTO.SectionName = (id_SectionTypesCmbo.selectedItem as DocumentSectionTypeDTO).SectionName;
				}
				else
				{
					pdDTO.SectionId					= subSecId;
					pdDTO.SectionName= (id_SubSectionTypesCmbo.selectedItem as DocumentSectionTypeDTO).SectionName;
				}
				pdDTO.IsDirty = true;
				
				// following all properties are added on request of Back End ( sami )
				// I think back end need it as echo back, 
				//ask back end to change the impl. on their end.
				pdDTO.PatientID  					= patientId;
				pdDTO.UploadedByUserId				= model.loggedInUserId;
				pdDTO.UploadedByUserTypeId			= model.loggedInUserProviderTypeId;
				pdDTO.UploadedByClinicBranchId		= model.loggedInUserSelectedBranchId;
				//pdDTO.UploadedDate					= date.fullYear+"-"+(date.month+1)+"-"+date.getDate();
				//pdDTO.CreatedBy						= model.loggedInUserId;
				//pdDTO.CreatedAt						= date.fullYear+"-"+(date.month+1)+"-"+date.getDate();
				pdDTO.StationName					= model.loggedInUserSelectedStationName;
				pdDTO.PracticeName					= model.loggedInUserSelectedPracticeName
				pdDTO.PatientFullName				= selectedPatientName;
				
				
				
				
				var mpd:ManagePatientDocumentEvent = new ManagePatientDocumentEvent(pdDTO, editMode);
				CairngormEventDispatcher.getInstance().dispatchEvent( mpd ); 
				
				dispatchEvent( new Event(DMEventStrings.DOCUMENT_CLOSE, true) );
				
				ClearInfo();
			}
			
