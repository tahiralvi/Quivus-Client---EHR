				<s:Button buttonMode="true" id="id_savebtn" label="Save" click="id_savebtn_clickHandler(event)" fontFamily="Calibri" fontSize="12"
						  styleName="blackButtonSkin" toolTip="{id_savebtn.label}" width="60" />
				<s:Button buttonMode="true" id="button3" label="Cancel" fontFamily="Calibri" fontSize="12"
						  click="cancel_clickHandler(event)" width="60"
						  styleName="blackButtonSkin" toolTip="Cancel"/>
			</s:HGroup>
			<s:HGroup width="100%" visible="false" includeInLayout="false" >
				<s:RichText color="#ffffff" fontSize="11" fontFamily="Calibri Bold" />
				<s:CheckBox buttonMode="true" id="checkbox0" selected="false" styleName="lightGreyCheckBoxSkin" />	
				<s:RichText color="#FFFFFF" fontFamily="Calibri" fontSize="11" id="richtext1" text="Preferred Provider" width="88" />
				<s:RichText color="#FFCB00" fontSize="11" id="richtext0" tabStops="S0 S50 S100 S150" text="Dr. Allan Peterson" whiteSpaceCollapse="preserve" fontFamily="Calibri Bold"/>
			</s:HGroup>
		</s:VGroup>
		
		
		<s:VGroup height="200" width="30%" gap="10" >
			<s:SkinnableContainer  styleName="gradientGreyImageBGContainerSkin" buttonMode="true" useHandCursor="true" height="145" width="100%" toolTip="Upload Documents">
				<mx:Image id="id_Image" width="100%"  height="140" verticalCenter="0" horizontalCenter="0" useHandCursor="true" buttonMode="true" />
			</s:SkinnableContainer>
			<s:HGroup  width="100%" visible="true">
				<s:TextArea id="ta"  visible="false" width="1"  />
				<components:LabelTextInput  id="id_FileName" prompt="Select or Scan Doc" width="105" toolTip="Select or Scan" required="true" />

				<s:Button buttonMode="true" id="id_browse" click="id_browse_clickHandler(event)"   label="Browse Document"  fontFamily="Calibri" fontSize="12"
						  styleName="folderButtonSkin" toolTip="Browse Document" width="25" />
				<s:Button buttonMode="true" id="button5"  label="Scan Document" fontFamily="Calibri" fontSize="12" 
						  click="button5_clickHandler(event)" visible="{DMConstant.BUILD_TYPE == DMConstant.NATIVE_BUILD}" 
						  includeInLayout="{DMConstant.BUILD_TYPE == DMConstant.NATIVE_BUILD}"
						  styleName="scanButtonSkin" toolTip="Scan Document" width="25"/>
				
				
			</s:HGroup>
		</s:VGroup>
		
	</s:SkinnableContainer>
</s:Group>

