			id_patientSearchBoxContainer.y + id_patientSearchBoxContainer1.y + id_patientSearchBoxContainer2.y + id_patientSearchTextInput.y + id_patientSearchTextInput.height + 5 );
			var loc:Point 			= this.localToGlobal( pLoc );
			SearchListView.x 		= loc.x; 
