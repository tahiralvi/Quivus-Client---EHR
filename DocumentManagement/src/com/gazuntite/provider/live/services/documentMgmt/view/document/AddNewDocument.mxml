			private function getProviderName( value:Object ):String
			{
				var name:String = "";
				if( value )
				{
					var o:ProviderDTO = value as ProviderDTO;
					name =  o.MiddleName && o.MiddleName.length  ?  
						o.FirstName + " " + o.MiddleName + " " + o.LastName  :  
						o.FirstName + " " + o.LastName   ;
				}
				else
				{
					trace( "AddNewDocument::LabelFunction::getProviderName --> ( NO VALUE ) -> value: ", value )
				}
				
				return name;
			}
			
			
