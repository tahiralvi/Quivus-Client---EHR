<?xml version="1.0" encoding="utf-8"?>
<s:MXAdvancedDataGridItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
								  xmlns:s="library://ns.adobe.com/flex/spark" 
								  xmlns:mx="library://ns.adobe.com/flex/mx" 
								  focusEnabled="true" >
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.provider.live.services.administration.event.AdminActionsEvent;

			private function onEditClick(event:MouseEvent):void
			{
				dispatchEvent(new AdminActionsEvent(AdminActionsEvent.EDIT_RECORD_CLICK, true));
			}
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:HorizontalLayout horizontalAlign="center"/>
	</s:layout>
	
	<s:Button id="id_Edit" width="12" height="12" click="onEditClick(event)" styleName="editButtonSkin"
			  buttonMode="true" toolTip="Edit" />
	
</s:MXAdvancedDataGridItemRenderer>
