<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:document="com.zigron.provider.live.services.documentMgmt.view.document.*"
		 xmlns:lab="com.zigron.provider.live.services.elab.view.lab.*" 
		 xmlns:LiveGridView="com.gazuntite.common.view.LiveGridView.*" 
		 xmlns:roleManagement="com.gazuntite.provider.live.services.administration.view.roleManagement.*"
		 width="100%" height="100%" initialize="init()"> 
	
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.util.xml.XmlConstants;
			import com.gazuntite.provider.live.services.administration.event.AdminActionsEvent;
			import com.gazuntite.provider.live.services.administration.event.generalSetting.LoadClinicGeneralSettingAdminEvent;
			import com.gazuntite.provider.live.services.administration.event.generalSetting.ManageGeneralSettingEvent;
			import com.gazuntite.provider.live.services.administration.model.AdminAppModelLocator;
			
			import mx.controls.Alert;
			import mx.events.CloseEvent;
			import mx.managers.CursorManager;
			
			import spark.events.IndexChangeEvent;
			import spark.events.TextOperationEvent;
			
			[Bindable]
			public var model : AdminAppModelLocator = AdminAppModelLocator.getInstance();
			
			private var bIsEdited:Boolean;
			
			[Bindable]
			private var expiryArray:ArrayCollection;
			[Bindable]
			private var alertExpiryArray:ArrayCollection;
			[Bindable]
			private var passwordHistoryCountArray:ArrayCollection;
			[Bindable]
			private var attempCountArray:ArrayCollection;
			[Bindable]
			private var lockSessionArray:ArrayCollection;
			
			private var expiryTotal:int 					= 91; //max 90 days
			private var alertExpiryTotal:int 				= 16; //max 15 days
			private var passwordHistoryCountTotal:int 		= 6;  //max 5  last password
			private var attempCountTotal:int 				= 6;  //max 5  attempts
			private var lockSessionTotal:int 				= 31; //max 30 min
			[Bindable] private var eightCharsPassword:String 			= 'Chr(a-z) = 04, Chr (A-Z) = 01, Digit (0-9) = 02, Symbol (#$!) = 01'; 
			[Bindable] private var fourteenCharsPassword:String 		= 'Chr(a-z) = 06, Chr (A-Z) = 03, Digit (0-9) = 03, Symbol (#$!) = 02'; 
			
			// at initlize
			private function init():void
			{
				dd_PassMinimumLength.setFocus();
				expiryArray 				= new ArrayCollection();
				alertExpiryArray 			= new ArrayCollection();
				passwordHistoryCountArray 	= new ArrayCollection();
				attempCountArray 			= new ArrayCollection();
				lockSessionArray 			= new ArrayCollection();
				
				for(var i:int=1; i < expiryTotal; i++)
				{
					expiryArray.addItem(i);
				}
				
				for(var a:int=1; a < alertExpiryTotal; a++)
				{
					alertExpiryArray.addItem(a);
				}
				
				for(var b:int=1; b < passwordHistoryCountTotal; b++)
				{
					passwordHistoryCountArray.addItem(b);
				}
				for(var c:int=1; c < attempCountTotal; c++)
				{
					attempCountArray.addItem(c);
				}
				for(var d:int=1; d < lockSessionTotal; d++)
				{
					lockSessionArray.addItem(d);
				}
			}
			
			//Update the General Setting click handler
			protected function save_clickHandler(event:MouseEvent):void
			{
				model.GeneralSetting.PasswordCharSetRule 				= chb_PasswordCharSetRule.selected ? XmlConstants.STRING_TRUE : XmlConstants.STRING_FALSE;
				model.GeneralSetting.PassMinimumLength 					= dd_PassMinimumLength.selectedIndex == 0 ? 8:14;
				model.GeneralSetting.PasswordExpiryRule 				= chb_PasswordExpiryRule.selected ? XmlConstants.STRING_TRUE : XmlConstants.STRING_FALSE;
				model.GeneralSetting.ExpireAfterEveryRule 				= chb_PasswordExpiryRule.selected ? XmlConstants.STRING_TRUE : XmlConstants.STRING_FALSE;
				model.GeneralSetting.ExpireAfterEvery 					= dd_PasswordExpiryRule.selectedIndex + 1;
				model.GeneralSetting.AlertUserResetPasswordRule 		= chb_AlertUserResetPasswordRule.selected  ? XmlConstants.STRING_TRUE : XmlConstants.STRING_FALSE;
				model.GeneralSetting.AlertUserResetPasswordDayCount 	= dd_AlertUserResetPasswordDayCount.selectedIndex + 1;
				model.GeneralSetting.PasswordHistoryRule 				= chb_PasswordHistoryRule.selected  ? XmlConstants.STRING_TRUE : XmlConstants.STRING_FALSE;
				model.GeneralSetting.PasswordHistoryCount 				= dd_PasswordHistoryCount.selectedIndex + 1;
				model.GeneralSetting.AccountLockFailureAttemptRule 		= chb_AccountLockFailureAttemptRule.selected ? XmlConstants.STRING_TRUE : XmlConstants.STRING_FALSE;
				model.GeneralSetting.AttemptCount 						= dd_AttemptCount.selectedIndex + 1;
				model.GeneralSetting.SessionInActivityLockRule 			= chb_SessionInActivityLockRule.selected ? XmlConstants.STRING_TRUE : XmlConstants.STRING_FALSE;
				model.GeneralSetting.LockSessionAfter 					= dd_LockSessionAfter.selectedIndex + 1;
				model.GeneralSetting.ConfidentialityNotificationRule 	= chb_ConfidentialityNotificationRule.selected ? XmlConstants.STRING_TRUE : XmlConstants.STRING_FALSE;
				model.GeneralSetting.ConfidentialityText 				= ta_ConfidentialityText.text;
				
				model.GeneralSetting.ClinicId   						= model.loggedInUserSelectedBranchId;
				model.GeneralSetting.ModifiedBy 						= model.loggedInUserId;
				
				var mgs:ManageGeneralSettingEvent 						= new ManageGeneralSettingEvent(callback);
				CairngormEventDispatcher.getInstance().dispatchEvent( mgs );
				CursorManager.setBusyCursor();
			}
			
			//On success of manage call result
			private function callback(val:*=null):void
			{
				loadGeneralSettings();
				dispatchEvent( new Event(AdminActionsEvent.GENERAL_SETTING_UPDATE, true, true ));
			}
			//On cancel of general settings
			protected function cancel_clickHandler(event:MouseEvent):void
			{
				Alert.show('Are you sure to reset all changes', 'Confirmation', Alert.YES | Alert.NO, this, confirmAction)
				
			}
			//Confirmation alert
			protected function confirmAction(event:CloseEvent):void
			{
				if(event.detail == Alert.YES)
				{
					loadGeneralSettings();// load all default/saved seetings
				}
				else
				{
					return;
				}
			}
			//Load general settings
			private function loadGeneralSettings():void
			{
				IsEdited = false;
				var lgs:LoadClinicGeneralSettingAdminEvent = new LoadClinicGeneralSettingAdminEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( lgs );	
				CursorManager.setBusyCursor();
			}
			
			[Bindable]
			public function get IsEdited():Boolean
			{
				return bIsEdited;
			}
			
			public function set IsEdited(value:Boolean):void
			{
				bIsEdited = value;
			}
			
			protected function dropdown_changeHandler(event:IndexChangeEvent):void
			{
				IsEdited = true;
			}
			
			protected function ta_ConfidentialityText_changeHandler(event:TextOperationEvent):void
			{
				IsEdited = true;
			}
			
			protected function chb_changeHandler(event:Event):void
			{
				IsEdited = true;
			}
			
			// change password option dropdown hanler
			protected function dd_PassMinimumLength_changeHandler(event:IndexChangeEvent):void
			{
				if(dd_PassMinimumLength.selectedIndex == 0)
					lbl_passwordHint.text = eightCharsPassword;
				else if(dd_PassMinimumLength.selectedIndex == 1)
					lbl_passwordHint.text = fourteenCharsPassword;
				
				addEventListener(IndexChangeEvent.CHANGE, dropdown_changeHandler);
				
				if(event)
					event.stopImmediatePropagation();
			}
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout gap="3" paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="40" />
	</s:layout>
	
	<s:CheckBox id="chb_PasswordCharSetRule"  
				selected="{model.GeneralSetting.PasswordCharSetRule  ? true:false }"  
				label="Password Character set Rule" toolTip="Password Character set Rule"
				change="chb_changeHandler(event)"/>
	<s:SkinnableContainer width="100%" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.greyBlockContainer">
		<s:layout>
			<s:HorizontalLayout  paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5"/>
		</s:layout>
		
		<s:HGroup width="20%"  verticalAlign="middle">
			<s:DropDownList id="dd_PassMinimumLength" 
							fontFamily="GridCalibri" fontSize="12" width="100"
							selectedIndex="{model.GeneralSetting.PassMinimumLength == 8 ? 0:1}"
							enabled="{chb_PasswordCharSetRule.selected}"
							toolTip="Password minimum length" 
							change="dropdown_changeHandler(event)">
				<mx:ArrayCollection>
					<fx:String>8</fx:String>
					<fx:String>14</fx:String>
				</mx:ArrayCollection>
			</s:DropDownList>
			<s:Label text="character(s)" fontFamily="Calibri" fontSize="11" />
			<s:Spacer width="20"/>
			<s:Label id="lbl_passwordHint" text="{dd_PassMinimumLength.selectedIndex == 0?eightCharsPassword : fourteenCharsPassword}" toolTip="{dd_PassMinimumLength.selectedIndex == 0?eightCharsPassword : fourteenCharsPassword}"/>
		</s:HGroup>
		
	</s:SkinnableContainer>
	
	<s:HGroup width="100%">
		
		<s:VGroup width="100%">
			<s:CheckBox id="chb_PasswordExpiryRule" 
						selected="{model.GeneralSetting.PasswordExpiryRule ? true:false }" 
						label="Password Expiry Rule" toolTip="Password Expiry Rule"
						change="chb_changeHandler(event)"/>
			<s:SkinnableContainer width="100%" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.greyBlockContainer">
				<s:layout>
					<s:VerticalLayout  paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
				</s:layout>
				<s:HGroup width="100%"  >
					<s:VGroup width="50%"  verticalAlign="middle">
						<s:Label text="Expire after every" fontFamily="Calibri" fontSize="11"/>
						<s:HGroup width="100%"  verticalAlign="middle">
							<s:DropDownList id="dd_PasswordExpiryRule"  width="100%" fontFamily="GridCalibri" fontSize="12" 
											enabled="{chb_PasswordExpiryRule.selected}"
											dataProvider="{expiryArray}"  
											selectedIndex="{model.GeneralSetting.ExpireAfterEvery - 1}"
											toolTip="Password Expiry Rule"
											change="dropdown_changeHandler(event)"/>
							<s:Label text="day(s)" fontFamily="Calibri" fontSize="11" />
						</s:HGroup>
					</s:VGroup>
					
					<s:VGroup width="50%"  verticalAlign="middle">
						<s:CheckBox id="chb_AlertUserResetPasswordRule"
									selected="{model.GeneralSetting.AlertUserResetPasswordRule ? true:false}"  
									label="Alert User To reset Passwrod" toolTip="Alert User To reset Password"
									enabled="{chb_PasswordExpiryRule.selected}" 
									change="chb_changeHandler(event)"/>
						
						<s:HGroup width="100%"  verticalAlign="middle">
							<s:DropDownList id="dd_AlertUserResetPasswordDayCount"  fontFamily="GridCalibri" fontSize="12"
											enabled="{chb_AlertUserResetPasswordRule.selected &amp;&amp;  chb_PasswordExpiryRule.selected }"  
											dataProvider="{alertExpiryArray}"  width="100%"
											selectedIndex="{model.GeneralSetting.AlertUserResetPasswordDayCount - 1}"
											toolTip="Alert User Reset Password Day Count"
											change="dropdown_changeHandler(event)"/>
							<s:Label text="day(s)" fontFamily="Calibri" fontSize="11" />
						</s:HGroup>
					</s:VGroup>
					
				</s:HGroup>
			</s:SkinnableContainer>
		</s:VGroup>
		
		<s:VGroup width="100%">
			<s:CheckBox id="chb_PasswordHistoryRule" 
						selected="{model.GeneralSetting.PasswordHistoryRule ? true:false}"  
						label="Password History Re-use Rule" toolTip="Password History Re-use Rule"
						change="chb_changeHandler(event)"/>
			
			<s:SkinnableContainer width="100%"  skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.greyBlockContainer">
				<s:layout>
					<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
				</s:layout>
				<s:Label text="Keep the History of Last Password" fontFamily="Calibri" fontSize="11"/>
				
				<s:HGroup width="100%" verticalAlign="middle">
					<s:DropDownList id="dd_PasswordHistoryCount" width="100%" fontFamily="GridCalibri" fontSize="12"
									enabled="{chb_PasswordHistoryRule.selected}" 
									dataProvider="{passwordHistoryCountArray}"
									selectedIndex="{model.GeneralSetting.PasswordHistoryCount - 1}"
									toolTip="Password History Count" 
									change="dropdown_changeHandler(event)"/>
					<s:Label text="password(s)" fontFamily="Calibri" fontSize="11" />
				</s:HGroup>
				
			</s:SkinnableContainer>
			
		</s:VGroup>
	</s:HGroup>
	
	<s:HGroup width="100%" verticalAlign="bottom">
		
		<s:VGroup width="33%">
			
			<s:CheckBox id="chb_AccountLockFailureAttemptRule" 
						selected="{model.GeneralSetting.AccountLockFailureAttemptRule ? true:false}" 
						label="Account Lock After Failure" toolTip="Account Lock After Failure"
						change="chb_changeHandler(event)"/>
			
			<s:SkinnableContainer width="100%" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.greyBlockContainer">
				<s:layout>
					<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
				</s:layout>
				<s:HGroup width="100%"  verticalAlign="middle">
					<s:DropDownList id="dd_AttemptCount" width="100%" fontFamily="GridCalibri" fontSize="12"
									enabled="{chb_AccountLockFailureAttemptRule.selected}" 
									dataProvider="{attempCountArray}"
									selectedIndex="{model.GeneralSetting.AttemptCount - 1}"
									toolTip="Attempt Count" 
									change="dropdown_changeHandler(event)"/>
					<s:Label text="attempt(s)" fontFamily="Calibri" fontSize="11" />
				</s:HGroup>	
			</s:SkinnableContainer>
		</s:VGroup>
		
		<s:VGroup width="33%">
			<s:CheckBox id="chb_SessionInActivityLockRule" 
						selected="{model.GeneralSetting.SessionInActivityLockRule ? true:false}" 
						label="Session In-Activity After"
						change="chb_changeHandler(event)"/>
			
			<s:SkinnableContainer width="100%" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.greyBlockContainer">
				<s:layout>
					<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
				</s:layout>
				<s:HGroup  verticalAlign="middle" width="100%">
					<s:DropDownList id="dd_LockSessionAfter" width="100%" fontFamily="GridCalibri" fontSize="12"
									enabled="{chb_SessionInActivityLockRule.selected}" 
									dataProvider="{lockSessionArray}"
									selectedIndex="{model.GeneralSetting.LockSessionAfter - 1}"
									toolTip="Lock Session "
									change="dropdown_changeHandler(event)"/>
					<s:Label text="minute(s)" fontFamily="Calibri" fontSize="11" />
				</s:HGroup>
			</s:SkinnableContainer>
		</s:VGroup>
		
		
		<s:VGroup width="33%">
			<s:CheckBox id="chb_ConfidentialityNotificationRule" 
						selected="{model.GeneralSetting.ConfidentialityNotificationRule ? true:false}" 
						label="Confidentiality Notification" toolTip="Confidentiality Notification"
						change="chb_changeHandler(event)"/>
			
			<s:SkinnableContainer width="100%" skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.greyBlockContainer">
				<s:layout>
					<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
				</s:layout>
				<s:TextArea id="ta_ConfidentialityText"  fontFamily="Calibri" fontSize="11"
							text="{model.GeneralSetting.ConfidentialityText}" 
							width="100%" height="35" maxChars="500"
							enabled="{chb_ConfidentialityNotificationRule.selected}"
							change="ta_ConfidentialityText_changeHandler(event)"/>
			</s:SkinnableContainer>
		</s:VGroup>
	</s:HGroup>
	<s:HGroup width="100%" horizontalAlign="right">
		<s:Button label="Save" click="save_clickHandler(event)" 
				  useHandCursor="true" buttonMode="true"   styleName="blackButtonSkin" width="60" toolTip="Save General Setting" enabled="{IsEdited}"/>
		<s:Button label="Cancel"   
				  styleName="blackButtonSkin" useHandCursor="true" buttonMode="true"  width="60" toolTip="Reset General Setting" click="cancel_clickHandler(event)"/>
	</s:HGroup>
	
	
</s:Group>
