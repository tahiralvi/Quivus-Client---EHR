<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" >
	
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			
			
			private var m_acDataProvider:ArrayCollection;
			
			
			[Bindable]
			public function get DataProvider():ArrayCollection
			{
				return m_acDataProvider;
			}
			
			public function set DataProvider(value:ArrayCollection):void
			{
				m_acDataProvider = value;
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:VGroup width="100%" height="100%">
		<mx:Tree width="100%" height="100%" dataProvider="{DataProvider}"  alternatingItemColors="[#E0E8EF,#FFFFFF]" horizontalScrollBarStyleName="VScrollBar"
				 itemRenderer="com.gazuntite.provider.live.services.administration.view.itemRenderer.RoleRightTreeItemRenderer" />
		
	</s:VGroup>
</s:Group>
