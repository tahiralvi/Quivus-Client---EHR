	<s:layout>
		<s:HorizontalLayout />
	</s:layout>
	
	<s:Rect id="indentationSpacer" width="{treeListData.indent}" percentHeight="100" alpha="0">
		<s:fill>
			<s:SolidColor color="0xFFFFFF" />
		</s:fill>
	</s:Rect>
	
	<s:Group id="disclosureGroup">
		<s:BitmapImage source="{treeListData.disclosureIcon}" visible="{treeListData.hasChildren}" />
	</s:Group>
	
	<s:BitmapImage source="{treeListData.icon}" />
	
	<s:Label id="labelField" text="{treeListData.label}" paddingTop="2" width="185" fontFamily="Calibri" fontSize="12" />
	
	<s:Group id="spacer" width="100%" />
	
	<s:CheckBox label="View" toolTip="View" selected="{data.IsViewAllowed == XmlConstants.STRING_TRUE ? true:false}" width="60" change="checkbox1_changeHandler(event)" buttonMode="true" useHandCursor="true"/>
	<s:CheckBox label="Edit" toolTip="Edit" selected="{data.IsEditAllowed == XmlConstants.STRING_TRUE ? true:false}" width="60" change="checkbox2_changeHandler(event)" buttonMode="true" useHandCursor="true"/>
	<s:CheckBox id="id_Sign" toolTip="Sign" label="Sign" selected="{data.IsSignAllowed == XmlConstants.STRING_TRUE ? true:false}" width="60" change="checkbox3_changeHandler(event)" buttonMode="true" useHandCursor="true"
				visible="{data.IsSignAllowed}" includeInLayout="{id_Sign.visible}"/>
	<s:CheckBox id="id_Import" toolTip="Import" label="Import" selected="{data.IsImportAllowed == XmlConstants.STRING_TRUE ? true:false}" width="60" change="checkbox4_changeHandler(event)" buttonMode="true" useHandCursor="true"
				visible="{data.IsImportAllowed}" includeInLayout="{id_Import.visible}"/>
	
</s:MXTreeItemRenderer>
