			//On edit check box change handler
			protected function checkbox2_changeHandler(event:Event):void
			{
				data.IsEditAllowed = event.currentTarget.selected ? XmlConstants.STRING_TRUE:XmlConstants.STRING_FALSE;
				data.IsDirty  = XmlConstants.STRING_TRUE;
				
				if(data.children)
				{
					var i:int;
					for(i=0;i<data.children.length;i++)
					{
						data.children[i].IsEditAllowed=data.IsEditAllowed;
						data.IsDirty  = data.IsDirty;
						
						//for 2nd level children
						if(data.children[i].children)
						{
							for(var c:uint=0; c<data.children[i].children.length; c++)
							{
								data.children[i].children[c].IsEditAllowed=data.IsEditAllowed;	
								data.children[i].children[c].IsDirty=data.IsDirty;
								
								//for 3rd level children
								if(data.children[i].children[c].children)
								{
									for(var d:uint=0; d<data.children[i].children[c].children.length; d++)
									{
										data.children[i].children[c].children[d].IsEditAllowed=data.IsEditAllowed;	
										data.children[i].children[c].children[d].IsDirty=data.IsDirty;
									}
								}
							}
						}
					}
				}
			}
			//On sign check box change handler
			protected function checkbox3_changeHandler(event:Event):void
			{
