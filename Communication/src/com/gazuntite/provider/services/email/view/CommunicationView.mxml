			protected function btnDelete_clickHandler(event:MouseEvent):void
			{ 
			//	dgEmailInbox.selectedItems[][]
			if(id_MailInbox.dgEmailInbox.rowCount > 0)
			{
				var emailID:String = "";
				
				for (var i:int = 0; i < id_MailInbox.dgEmailInbox.selectedItems.length; i++)
				{
					emailID	+=id_MailInbox.dgEmailInbox.selectedItems[i].EmailID+"^";					
				}
				
				if(emailID.length > 0)
				{
					emailID=emailID.substring(0,emailID.length-1);
					///////////// Change USer ID later On
					var emailDeleteEvent : DeleteEmailEvent = new DeleteEmailEvent(emailID,model.loggedInUserId,GetEmailValuesCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent(emailDeleteEvent);
				}
				else
					Alert.show("Select any Email to Delete.","Email Sending Error" ,4,FlexGlobals.topLevelApplication.mainContainer);
			}
			else
				Alert.show("No Email to Delete.","Email Sending Error" ,4,FlexGlobals.topLevelApplication.mainContainer);
			}
			
			public  function GetEmailValuesCallBack(val:* = null):void
			{
				
				if(model.IsInbox)
				{
					GetInboxData();
					id_MailInbox.id_SenderorRecieverName.headerText="From";
					var emailEvent : GetEmailEvent = new GetEmailEvent(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,10,model.currentPage,model.IsInbox,id_MailInbox.EnableNavigateCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent(emailEvent);
					
				}
				else if(!model.IsInbox)
				{
					
					id_MailInbox.visible=true;
					id_MailInbox.id_SenderorRecieverName.headerText="To";
					var emailSentEvent : GetSentEmailEvent = new GetSentEmailEvent(model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,10,model.currentPage,model.IsInbox,id_MailInbox.EnableNavigateCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent(emailSentEvent);
				}
					//btnSentItem_clickHandler(event);
			}
			
