				<emailview:SendMailView id="id_SendMail" width="100%" height="100%"
										RefreshEmailEvent="id_SendMail_RefreshEmailEventHandler(event)" EmailAddress="{EmailAddress}" userID="{userID}" senderID="{model.loggedInUserId}" stationdID="{model.loggedInUserSelectedStationID}" branchID="{model.loggedInUserSelectedBranchId}" click="id_SendMail_clickHandler(event)"/>
			</s:NavigatorContent>
			<s:NavigatorContent>
				<emailview:ReadEmailView id="id_ReadMail" emailID="{emailID}"  width="100%" height="100%"
										 ReplyEmailEvent="id_ReadMail_ReplyEmailEventHandler(event)" RefreshEmailEvent="id_ReadMail_RefreshEmailEventHandler(event)" />
			</s:NavigatorContent>
		</mx:ViewStack>
		
		
		<!--</s:VGroup>-->
		
