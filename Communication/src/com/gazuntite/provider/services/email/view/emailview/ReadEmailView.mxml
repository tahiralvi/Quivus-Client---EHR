			}
			
			
			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{ 
				
				//////////////////////user id, branch id, station id need to get dynamically ///////////////////////
				
				if(emailID > 0)
				{
				var emailViewEvent:ViewEmailEvent = new ViewEmailEvent(emailID,model.loggedInUserId,model.loggedInUserSelectedBranchId,model.loggedInUserSelectedStationID,model.IsInbox,GetEmailValuesCallBack);
				CairngormEventDispatcher.getInstance().dispatchEvent(emailViewEvent);
				event.stopImmediatePropagation();
				}
				//callLater(GetEmailValuesCallBack);
				
				//callLater(GetEmailValuesCallBack,null);
			 	//GetEmailValues();
				fileToDownload.addEventListener(Event.COMPLETE, fileRef_complete);
				fileToDownload.addEventListener(ProgressEvent.PROGRESS, fileRef_progress);
			}

			public  function GetEmailValuesCallBack(val:* = null):void
			{
					//Alert.show("Values Got");
				txtMailBody.text = model.message;
				lblSubject.text = model.subject;
				lblSenderAddress.text = model.from;
				lblRecieverAddress.text = model.sendto;
				btnAttachmentDownload.visible= model.hasAttachment;
				lblSentDate.text=model.mailSentAt;
				
				if(!model.hasAttachment)
				{
					btnAttachmentDownload.visible = false;
					id_attachmentImage.visible = false;
					id_AttachmentGrid.visible = false;
					id_AttachmentGrid.includeInLayout = false;
				}
				else
				{
					
					btnAttachmentDownload.visible = true;
					id_attachmentImage.visible = true;
					id_AttachmentGrid.visible = true;
					id_AttachmentGrid.includeInLayout = true;
					if(model.fileName != "")
					{
						id_AttachmentGrid.dataProvider == null;
						fileAttachmentArray.removeAll();
						var fileArrary:Array = model.fileName.split(';',10);
						for(var filesLength:int;filesLength < fileArrary.length;filesLength++)
						{
							if(fileArrary[filesLength].toString().length > 0)
							fileAttachmentArray.addItem(new AttachmentArray(true,fileArrary[filesLength]));
						}
						id_AttachmentGrid.dataProvider=fileAttachmentArray;
					}
				}
			}

			protected function btnClose_clickHandler(event:MouseEvent):void
			{
				
				
			//	var refreshEmail:RefreshInboxPanel  = new RefreshInboxPanel();
			//	dispatchEvent( refreshEmail );
				
				txtMailBody.text = "";
				lblSubject.text = "";
				lblSenderAddress.text = "";
				lblRecieverAddress.text = "";
				lblSentDate.text = "";
				var refreshEmail:RefreshInboxPanel  = new RefreshInboxPanel();
				dispatchEvent( refreshEmail );
				
				/* dispatchEvent(new CloseEvent(CloseEvent.CLOSE)); */
				//this.visible=false;
				//PopUpManager.removePopUp(this);
			}


			
			private var fileToDownload:FileReference= new FileReference();
			private var fileDownloadCount:int=0;
			
			public function OnDownloadClick():void
			{
				fileDownloadCount=0;
				DownloadFile();
			}
			
			
			
			public function DownloadFile():void
			{
				if(fileAttachmentArray.length > 0)
				{
					var filesName:String = "";
					while(fileDownloadCount < fileAttachmentArray.length)
					{
						if(ListCollectionView(id_AttachmentGrid.dataProvider).getItemAt(fileDownloadCount)["isSelected"] == true)
						{
							filesName += ListCollectionView(id_AttachmentGrid.dataProvider).getItemAt(fileDownloadCount)["fileName"].toString()+";";
							DownloadFileExample();
							fileDownloadCount++;
							break;
							
						}
						fileDownloadCount++;
					}
				}
				
				
			}
			
			private function fileRef_progress(event:ProgressEvent):void {
				downloadProgress.setProgress(event.bytesLoaded, event.bytesTotal);	
			}
			
			public function DownloadFileExample():void
			{
				var request:URLRequest = new URLRequest();
				if(model.fileName.length > 0)
				{
					var filesAttached:Array= model.fileName.split(';',50);
				
				var fileparts:Array= filesAttached[fileDownloadCount].toString().split('.',2); //model.fileName.split('.',2);
				if(fileparts.length > 1)
				{
					downloadProgress.visible=true;
					downloadProgress.includeInLayout = true;
					downloadProgress.setProgress(0,100);
				var getDownload:String =EmailConstant.RESTFULL_SERVICE_BASE_URL + EmailServiceMethods.GET_ATTACHMENT_EMAIL;
				request.url = getDownload +"/"+model.emailID+"/"+fileparts[0].toString()+"/"+fileparts[1].toString();
				try
				{
					fileToDownload.download(request, filesAttached[fileDownloadCount]);
				}
				catch (error:Error)
				{
					trace("Unable to download file.");
				}
				}
				}
			}
			
			
			private function fileRef_complete(evt:Event):void 
			{
				//fileDownloadCount= fileDownloadCount+1;
				HasAttachment=true;
				Alert.show("File Downloaded","Download Complete",4,FlexGlobals.topLevelApplication.mainContainer);
				DownloadFile();
			}

		]]>
