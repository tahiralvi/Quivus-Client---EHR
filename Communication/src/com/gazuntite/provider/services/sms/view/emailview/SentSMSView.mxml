							   />
			<mx:DataGridColumn headerText="To" dataField="userID" editable="false"  
							   itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/> <!--editorDataField="editorText"-->
			<mx:DataGridColumn headerText="Text"  itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true" dataField="Message" editable="false" />  <!--editorDataField="editorText"-->
			
			
		</CheckBoxGrid1:columns>
	</CheckBoxGrid1:CheckBoxDataGrid>
	
