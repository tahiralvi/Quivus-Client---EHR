			<buttonSkins:navSeparator/>
			<s:Button id="btnPrevious" label="Previous" click="btnPrevious_clickHandler(event)" buttonMode="true" 
					  toolTip="Previous"  styleName="blackPreviousNextButtonSkin"/>
			<buttonSkins:navSeparator/>
			<s:Button id="btnNext" label="Next" click="btnNext_clickHandler(event)" buttonMode="true" 
