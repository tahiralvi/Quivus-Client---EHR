		dataProvider="{model.smsResultList.ALLSentSMS}" 
		draggableColumns="false" 
		useRollOver="false"
		columnWidths="{['10%' ,'30%','60%']}"
		allowMultipleSelection="true"
		minHeight="150"
		verticalScrollPolicy="off"
		maxHeight="250" 
		>
		<CheckBoxGrid1:columns>
			<mx:DataGridColumn id="chkHeader" dataField="isSelected" 
