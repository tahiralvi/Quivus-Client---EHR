			protected function btnGotoFirst_clickHandler(event:MouseEvent):void
			{
				CallServer(model.currentPage=1);
				//var smsView:SentSMSView=new SentSMSView();
				
			}
			
			protected function btnGotoLast_clickHandler(event:MouseEvent):void
			{
				CallServer(model.currentPage=model.totalPage);
			}
			
			protected function btnPrevious_clickHandler(event:MouseEvent):void
			{
				CallServer(model.currentPage -=1);
			}
			
			
			protected function btnNext_clickHandler(event:MouseEvent):void
			{
				CallServer(model.currentPage +=1);
			}

			protected function btnRefresh_clickHandler(event:MouseEvent):void
			{
				CallServer(model.currentPage=1);
			}
			
			private function CallServer(currentPage:int):void
			{
				//var smsSentEvent:GetSentSMSEvent =new GetSentSMSEvent(model.loggedInUserSelectedBranchId,model.loggedInUserId,model.currentPage,GetSMSValuesCallBack);
				var smsSentEvent:GetSentSMSEvent =new GetSentSMSEvent(parseInt(clinicBranchID),userID,model.currentPage,GetSMSValuesCallBack);
				CairngormEventDispatcher.getInstance().dispatchEvent(smsSentEvent);
			}
			
			public  function GetSMSValuesCallBack(val:* = null):void
			{
				EnableNavigationButtons(model.currentPage,model.totalPage);
			}
			
			public function  EnableNavigationButtons(currentPage:int, totalPages:int ):void //currentPage:int, totalPages:int ):void
			{
				
				//currentPage =model.currentPage;
				//totalPages = model.totalPage;
				
				btnGotoFirst.enabled = currentPage != 1;
				btnGotoLast.enabled 		= currentPage != totalPages;
				btnNext.enabled 		=  currentPage != totalPages;
				btnPrevious.enabled 	=  currentPage != 1;
