			protected function btnDelete_clickHandler(event:MouseEvent):void
			{

				if(id_SentSMS != null)
				{
					var selection:ArrayCollection = new ArrayCollection( id_SentSMS.dgSentSMS.selectedItems );
					
				//var allRows:int =	 id_SentSMS.model.smsResultList.ALLSentSMS.length;
				var smsID:String = "";
				if(selection.length > 0)
				{
				for (var i:int = 0; i < selection.length; i++)
				{
					//if(ListCollectionView(id_SentSMS.dgSentSMS.dataProvider).getItemAt(i)["isSelected"]==true)
						smsID	+=  ListCollectionView(selection).getItemAt(i)["smsID"]+"^";//ListCollectionView(id_SentSMS.dgSentSMS.dataProvider).getItemAt(i)["smsID"]+"^";
				}
				
				
				if(smsID.length > 0)
				{
					//var smsID:String = "28^31";	
					smsID = smsID.substring(0,smsID.length);
					var smsDeleteEvent : DeleteSMSEvent = new DeleteSMSEvent(smsID,id_SentSMS.model.loggedInUserId,id_SentSMS.GetSMSValuesCallBack);
					CairngormEventDispatcher.getInstance().dispatchEvent(smsDeleteEvent);
				}
				else
					Alert.show("No SMS is selected for deletion.","SMS Sending Error" ,4,FlexGlobals.topLevelApplication.mainContainer);
				
				viewstack1.selectedIndex=1;
				}
				else
					Alert.show("No row to delete.","SMS Sending Error" ,4,FlexGlobals.topLevelApplication.mainContainer);
				}
			}
			
			protected function CloseHandler(event:MouseEvent):void
			{
				//chUtil.removeWindowsCount();
				dispatchEvent( new CloseEvent(CloseEvent.CLOSE) );
			}
			
