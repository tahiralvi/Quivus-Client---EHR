			public function resetButtons():void
			{
				btnCompose.selected			= false ;
				btnSentSMS.selected			= false ;
				btnDelete.enabled 			= false ;
				
			}


			protected function id_Test_clickHandler(event:MouseEvent):void
			{
				// TODO Auto-generated method stub
			}


			protected function btnCompose_clickHandler(event:MouseEvent):void
			{
				viewstack1.selectedIndex=0;
				resetButtons () ;
				btnCompose.selected = true ;
				
				if(id_Compose != null)
				{
					id_Compose.senderID = senderID;
					id_Compose.userID = userID;
					id_Compose.BranchID = BranchID;
				}
				
			}


			protected function btnSentSMS_clickHandler(event:MouseEvent):void
			{
				viewstack1.selectedIndex=1;
