			private var ListOnlyPopup:ElabDoOnlyView;
			private var ProcessOnlyPopup:ElabDoOnlyView;
			
			[Bindable]
			public var model : ELabsAppModelLocator = ELabsAppModelLocator.getInstance();
			
			[Bindable]
			private var m_oDataProvider:ArrayCollection ;
			
			[Bindable]
			public function get DataProvider():ArrayCollection
			{
				return m_oDataProvider;
			}
			
			public function set DataProvider(value:ArrayCollection):void
			{
				m_oDataProvider = value;			
			}

			protected function ListOnlyHandler(event:Event):void
			{
				if( ListOnlyPopup && ListOnlyPopup.isPopUp )
				{
					ListOnlyPopup.removePopup();
					ListOnlyPopup.removeEventListener( ListOnlySelectionEvent.LIST_ONLY_SELECTION, ListOnlySelectionEventHandler );
					ListOnlyPopup = null;
				}
				
				ListOnlyPopup = new ElabDoOnlyView();
				ListOnlyPopup.title = "List Only";
				//ListOnlyPopup.DataProvider = model.LabOrdersListDto;
				ListOnlyPopup.addEventListener( ListOnlySelectionEvent.LIST_ONLY_SELECTION, ListOnlySelectionEventHandler );
				
				var pLoc:Point 			= new Point( id_FilterGridView.id_ListOnly.x - 10,
					id_FilterGridView.y + id_FilterGridView.y + id_FilterGridView.height - 12);
				var loc:Point 			= this.localToGlobal( pLoc );
				
				ListOnlyPopup.x 		= loc.x; 
				ListOnlyPopup.y 		= loc.y; 
				
				ListOnlyPopup.ShowPopup( this );
				ListOnlyPopup.id_FromDate.setFocus();
			}

			protected function GoToPageHandler(event:Event):void
			{
				switch( event.type )
				{
					case FilterViewForGrid.GOTO_FIRST_PAGE:
						ELabsQuivusCombineEventDispatcher.LoadLabOrdersListByClinic( 1 );
						break;
					case FilterViewForGrid.GOTO_NEXT_PAGE:
						++model.CurrentPageNo; 
						ELabsQuivusCombineEventDispatcher.LoadLabOrdersListByClinic( model.CurrentPageNo ); 
						break;
					case FilterViewForGrid.GOTO_PREVIOUS_PAGE:
						--model.CurrentPageNo;
						ELabsQuivusCombineEventDispatcher.LoadLabOrdersListByClinic( model.CurrentPageNo ); 
						break;
					case FilterViewForGrid.GOTO_LAST_PAGE:
						ELabsQuivusCombineEventDispatcher.LoadLabOrdersListByClinic( model.TotalPageNo ); 
						break;
				}
				id_FilterGridView.EnableNavigationButtons( model.CurrentPageNo, model.TotalPageNo );
			}

			protected function RefreshViewHandler(event:Event = null ):void
			{
				ELabsQuivusCombineEventDispatcher.LoadLabOrdersListByClinic( 1 );
			}

			protected function EditLabClickHandler(event:Event):void
			{
				// TODO Auto-generated method stub
			}


			protected function id_LabsGridView_creationCompleteHandler(event:FlexEvent):void
			{
				addEventListener("EditLabClick", EditLabClickHandler);
			}
			
			protected function ListOnlySelectionEventHandler(event:ListOnlySelectionEvent):void
			{
				var sel:Object 		= event.selection as Object;
				var from:String		= event.from;
				var to:String		= event.to;
				
				if( sel || ( ! UtilityFunctions.IsNullOrEmpty( from.length ) && ! UtilityFunctions.IsNullOrEmpty( to.length ) ) )
				{
					var searchStr:String = "";
					searchStr += UtilityFunctions.getDelimitedValue( event.from );
					searchStr += UtilityFunctions.getDelimitedValue( event.to );
					searchStr += UtilityFunctions.getDelimitedValue( sel.methodID );
					searchStr += UtilityFunctions.getDelimitedValue( sel.patientID );
					searchStr += UtilityFunctions.getDelimitedValue( sel.LaboratoryID );
					
					var e:ListOnlyLabsEvent = new ListOnlyLabsEvent( model.LoggedInUserSelectedBranchId, model.CurrentPageNo, false, searchStr ); 
					CairngormEventDispatcher.getInstance().dispatchEvent( e );
				}
				else
				{
					Alert.show( "Please Select Field / Date Range", "Invalid Data", Alert.OK, FlexGlobals.topLevelApplication.mainContainer);
				}
			}
			
			private function GridRowNumber(item:Object, iCol:int):String
			{
				var strRowNum:String = "";
				
				if (id_LabsGridView.dataProvider)
				{
					var rowNum:int = id_LabsGridView.dataProvider.getItemIndex(item) + 1;
					strRowNum = String(rowNum);
				}
				
				return strRowNum;
			}


			protected function id_ProcessOrder_creationCompleteHandler(event:FlexEvent):void
			{
				id_ProcessOrder.id_BatchProcess.addEventListener(MouseEvent.CLICK, OnBatchProcessClick);
				id_ProcessOrder.id_ProcessOnly.addEventListener(MouseEvent.CLICK, OnProcessOnlyClick);
			}
			
			protected function OnBatchProcessClick(event:MouseEvent):void
			{
				if( id_ProcessOrder.id_ForDate.selectedDate )
				{
					var xData:XML = model.LabOrderListDto.getListIDsXML( id_LabsGridView.selectedItems );
					var evt:ProcessLabOrderEvent = new ProcessLabOrderEvent( xData, id_ProcessOrder.id_ForDate.selectedDate, loadLabOrder );
					CairngormEventDispatcher.getInstance().dispatchEvent( evt );
					
					//ELabsQuivusCombineEventDispatcher.LoadLabOrdersListByClinic( 1 );
				}
				else
				{
					Alert.show("please select date","Select Date", Alert.OK, FlexGlobals.topLevelApplication.mainContainer);
				}
			}
			//Tahir Alvi - When Batch process is done successfully a message should be displayed that shows the user about the successful batch processing is done.
			protected function loadLabOrder(val:*=null):void
			{
				ELabsQuivusCombineEventDispatcher.LoadLabOrdersListByClinic( 1 );//When the Batch Process is clicked for any selected date, the records are still displayed in the data grid unless refresh button is not clicked.
				Alert.show("Batch process succesfully done","Info", Alert.OK, FlexGlobals.topLevelApplication.mainContainer);
			}
			
			protected function OnProcessOnlyClick(event:MouseEvent):void
			{
				if( ProcessOnlyPopup && ProcessOnlyPopup.isPopUp )
				{
					ProcessOnlyPopup.removePopup();
					ProcessOnlyPopup.removeEventListener( ListOnlySelectionEvent.LIST_ONLY_SELECTION, ProcessOnlySelectionEventHandler );
					ProcessOnlyPopup = null;
				}
				
				ProcessOnlyPopup = new ElabDoOnlyView();
				ProcessOnlyPopup.title = "Process Lab Order By Criteria"
				//ProcessOnlyPopup.DataProvider = model.LabOrdersListDto;
				ProcessOnlyPopup.addEventListener( ListOnlySelectionEvent.LIST_ONLY_SELECTION, ProcessOnlySelectionEventHandler );
				
				var pLoc:Point 			= new Point( id_ProcessOrder.id_ProcessOnly.x - 10,
					id_ProcessOrder.y + id_ProcessOrder.y + id_ProcessOrder.height - 12);
				var loc:Point 			= this.localToGlobal( pLoc );
				
				ProcessOnlyPopup.x 		= loc.x; 
				ProcessOnlyPopup.y 		= loc.y; 
				
				ProcessOnlyPopup.ShowPopup( this );
				ProcessOnlyPopup.id_FromDate.setFocus();
			}

			protected function ProcessOnlySelectionEventHandler(event:ListOnlySelectionEvent):void
			{
				var sel:Object 		= event.selection as Object;
				var from:String		= event.from;
				var to:String		= event.to;
				
				if( sel || ( ! UtilityFunctions.IsNullOrEmpty( from.length ) && ! UtilityFunctions.IsNullOrEmpty( to.length ) ) )
				{
					var searchStr:String = "";
					
					searchStr += UtilityFunctions.getDelimitedValue( event.from );
					searchStr += UtilityFunctions.getDelimitedValue( event.to );
					searchStr += UtilityFunctions.getDelimitedValue( sel.methodID );
					searchStr += UtilityFunctions.getDelimitedValue( sel.patientID );
					searchStr += UtilityFunctions.getDelimitedValue( sel.LaboratoryID );
					
					
					var evt:ProcessLabOrderByCriteriaEvent = new ProcessLabOrderByCriteriaEvent( searchStr );
					CairngormEventDispatcher.getInstance().dispatchEvent( evt );
				}
				else
				{
					Alert.show( "Please Select Field / Date Range", "Invalid Data", Alert.OK, FlexGlobals.topLevelApplication.mainContainer);
				}
			}

			protected function cc(event:FlexEvent):void
			{
				ELabsQuivusCombineEventDispatcher.LoadLabOrdersListByClinic( 1 );
				
				
				addEventListener( ElabActionEvent.VIEW_DOCUMENT, viewDocumentClickHandler);
				addEventListener( ElabActionEvent.EDIT_RECORD_CLICK, editRecordClickHandler);
				addEventListener( ElabActionEvent.SAVE_RECORD_CLICK, saveRecordClickHandler);
				addEventListener(DataGridActionsEvent.ITEM_EDIT_KEY_UP, itemEditKeyUpHandler, false, 0, true);
				
				id_FilterGridView.id_FieldsCmbo.setFocus();
			}


			
			
			protected function id_FilterGridView_SearchClickHandler(event:Event):void
			{
				if( id_FilterGridView.id_FieldsCmbo.selectedItem && id_FilterGridView.id_SearchTextInput.text.length > 2 )
					ELabsQuivusCombineEventDispatcher.SearchOrdersListByClinic( id_FilterGridView.id_SearchTextInput.text, 1, id_FilterGridView.id_FieldsCmbo.selectedItem.ID );
				else
					Alert.show("Please select Order Type and provide text to Search", "Invalid input", Alert.OK, FlexGlobals.topLevelApplication.mainContainer);
			}
			
			
			
			//Grid Edit Handlers...
			
			private var editableRowIndex:int = -1;
			
			private function saveRecordClickHandler(event:ElabActionEvent):void
			{
				id_LabsGridView.editable = false;
				event.stopImmediatePropagation();
				event.preventDefault();
				
				var lab:LabDTO = id_LabsGridView.selectedItem as LabDTO;
				var e:ManageLabsEvent = new ManageLabsEvent( lab );
				CairngormEventDispatcher.getInstance().dispatchEvent( e );
				
				editableRowIndex = -1;
				RefreshViewHandler();
					
				
			}
			
			private function deleteRecordClickHandler(event:ElabActionEvent):void
			{
				var curTar:LabelDataGrid = LabelDataGrid(event.currentTarget);
				
				if (curTar.selectedItem)
				{
					var ID:int = 0//TypeDTO(curTar.selectedItem).PatientImmunizationId;
					UtilityFunctions.AskMessage(  "Do you want to delete selected record", function():void
					{
						if (ID == 0)
						{
							//model.quickInputDTO.PMH.Immunization.removeItemAt(curTar.selectedIndex);
							//if (model.quickInputDTO.PMH.Immunization.length <= 0)
							{
								_hasGridChanged = false;
								//hasViewChanged = isGetEdited();
							}
						}
						else
						{
							id_LabsGridView.selectedItem.IsDeleted = true;
							//model.quickInputDTO.PMH.Immunization.filterFunction = filterDeletedItems;
							//model.quickInputDTO.PMH.Immunization.refresh();
							
							hasViewChanged = _hasGridChanged = true;
							
						}
					});
				}
			}
			
			private function itemEditKeyUpHandler(event:DataGridActionsEvent):void
			{
				if (event.data)
				{
					var lblFld:String = SparkComboBoxItemEditor(event.target).labelField;
					
					if (lblFld == "label")
					{
						if(event.searchString.length > 2)
						{
							var LoadTestTypes : LoadTestTypeByNameEvent = new LoadTestTypeByNameEvent(event.searchString);
							CairngormEventDispatcher.getInstance().dispatchEvent( LoadTestTypes );
						}
					}
				}
			}
			
			private function GridItemEditBeginHandler(event:DataGridEvent):void
			{
				if( id_LabsGridView.editable)
				{
					if( editableRowIndex != id_LabsGridView.selectedIndex )
					{
						id_LabsGridView.editable = false;
						event.stopImmediatePropagation();
						event.preventDefault();
						return;
					}
					else if( editableRowIndex == id_LabsGridView.selectedIndex )
					{
						id_LabsGridView.editable = true;
					}
				}
				
				id_LabsGridView.createItemEditor(event.columnIndex, event.rowIndex);
				
				if (   event.columnIndex == 0 // row Numbers
					|| event.columnIndex == 1 // Order Number
					|| event.columnIndex == 2 // Order Date
					|| event.columnIndex == 3 // Patient
					|| event.columnIndex == 5 // Provider 
					|| event.columnIndex == 7 // Buttons
				)
				{
					id_LabsGridView.destroyItemEditor();
					event.stopImmediatePropagation();
					event.preventDefault();
				}
				
				else if (event.columnIndex == 4)
				{
					SparkComboBoxItemEditor(id_LabsGridView.itemEditorInstance).data = event.itemRenderer.data; 
				}
			}
			
			private function viewDocumentClickHandler(event:ElabActionEvent):void
			{
				var docType:String;
				trace( event.target.data.Method.Name );
				
				switch(event.target.data.Method.Name)
				{
					case "HL7":
						docType = "hl7";
						break;
					default:
						docType = "pdf";
						break;
				}
				
				var orderID:int = parseInt( event.target.data.OrderID );
				
				var evt:LoadOrderDocumentEvent = new LoadOrderDocumentEvent( orderID, docType, ShowDocumentInViewer);
				CairngormEventDispatcher.getInstance().dispatchEvent( evt );
			}
			
			private function ShowDocumentInViewer(url:String):void
			{
			 	var evt:OpenFileOrWithNativeAppEvent = new OpenFileOrWithNativeAppEvent(true, true);
			 	evt.FileName = "Quivus Lab Order";
			 	evt.FileURL = url;
				
				dispatchEvent( evt );
			}
			
			private function editRecordClickHandler(event:ElabActionEvent):void
			{
				var rowIndex:int = id_LabsGridView.selectedIndex;
				id_LabsGridView.editable = true;
				editableRowIndex = rowIndex;
				var itemToSetInEditableMode:IListItemRenderer = id_LabsGridView.indexToItemRenderer(rowIndex);
				var ev:DataGridEvent = new DataGridEvent(DataGridEvent.ITEM_EDIT_BEGINNING, true);
				ev.columnIndex = 4;
				ev.rowIndex = rowIndex;
				ev.itemRenderer = itemToSetInEditableMode;
				ev.dataField = "Test.Name";
				id_LabsGridView.dispatchEvent(ev);
			}
			
			private function GridItemEditEndHandler(event:DataGridEvent):void
			{
				var validationRes:ValidationResultEvent;
				//var ID:String = (id_LabsGridView.selectedItem as LabDTO).ID ;
				
				if (event.dataField == "Test.Name")
				{
					var cbTestName:LabelComboBox = SparkComboBoxItemEditor(id_LabsGridView.itemEditorInstance).id_ComboEditor;
					if( cbTestName.selectedItem )
					{
						event.itemRenderer.data.Test.Name = cbTestName.selectedItem.Name;
						event.itemRenderer.data.Test.ID   = cbTestName.selectedItem.ID;
						event.itemRenderer.data.IsDirty   = true;
						
						hasViewChanged = _hasGridChanged = true;
					}
				}	
				else if (event.dataField == "LabName")
				{
					var cbLabName:LabelComboBox = SparkComboBoxItemEditor(id_LabsGridView.itemEditorInstance).id_ComboEditor;
					if( cbLabName.selectedItem )
					{
						event.itemRenderer.data.LabName = cbLabName.selectedItem.Name;
						event.itemRenderer.data.LabID 		= cbLabName.selectedItem.ID;
						event.itemRenderer.data.IsDirty = true;
						
						hasViewChanged = _hasGridChanged = true;
					}
				}
					
				
				id_LabsGridView.destroyItemEditor();
				event.stopImmediatePropagation();
				event.preventDefault();
			}
			
			[Bindable]
			public function get hasViewChanged():Boolean
			{
				return _hasViewChanged;
			}
			
			public function set hasViewChanged(value:Boolean):void
			{
				_hasViewChanged = value;
			}
			
			private function filterDeletedItems(item:Object):Boolean
			{
				var b:Boolean = item["IsDeleted"];
				return (!b);
			}
			
			private var _hasGridChanged:Boolean;
			private var _hasViewChanged:Boolean;
			//Grid Handler end...

		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout gap="1" paddingLeft="5" paddingRight="5" paddingBottom="5" paddingTop="5" />
	</s:layout>
	
	<LiveGridView1:FilterViewForGrid id="id_FilterGridView" width="100%"
									ListOnly="ListOnlyHandler(event)"
									GoToFirstPage="GoToPageHandler(event)"
									GoToLastPage="GoToPageHandler(event)"
									GoToNextPage="GoToPageHandler(event)"
									GoToPreviousPage="GoToPageHandler(event)"
									RefreshView="RefreshViewHandler(event)"
									SearchClick="id_FilterGridView_SearchClickHandler(event)"
									DataProvider="{model.OrderSearchFieldsList.Fields}"
									labelField="Name" height="15%"/>
	
	<components1:LabelDataGrid id="id_LabsGridView" width="100%" 
				 dataProvider="{model.LabOrderListDto.Labs}"
				 rowCount="{id_LabsGridView.dataProvider.length + 1}"
				 itemEditBegin="GridItemEditBeginHandler(event)" 
				 itemEditEnd="GridItemEditEndHandler(event)"
				 variableRowHeight="true" verticalScrollPolicy="auto"
				 creationComplete="id_LabsGridView_creationCompleteHandler(event)" 
				 columnWidths="{[30,'10%','10%','12%','13%','15%','15%','15%']}" maxHeight="150" height="75%">  
		<components1:columns>
			
			<!--<mx:DataGridColumn width="50" dataField="ID" 				headerText="" textAlign="center" itemRenderer="mx.controls.CheckBox"  rendererIsEditor="true" editorDataField="selected"/>-->  
			<mx:DataGridColumn headerText="Sr.#"  							labelFunction="GridRowNumber" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn dataField="ID"  					headerText="Order #"  	itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn dataField="OrderDate" 			headerText="Date" 		itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn dataField="Patient.FullName" 	headerText="Patient" 	itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
			<mx:DataGridColumn dataField="Test.Name" 			headerText="Test"  		itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors1:SparkComboBoxItemEditor dataProvider="{outerDocument.model.TestTypeList}" width="50" />
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn  dataField="Provider.FullName" 	headerText="Provider" /> 
			<mx:DataGridColumn  dataField="LabName" 				headerText="Lab"  	itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true">
				<mx:itemEditor>
					<fx:Component>
						<itemEditors1:SparkComboBoxItemEditor dataProvider="{outerDocument.model.LaboratoryListDto.Laboratories}" width="50"/>
					</fx:Component>
				</mx:itemEditor>
			</mx:DataGridColumn>
			<mx:DataGridColumn  headerText="" itemRenderer="com.gazuntite.provider.live.services.elab.view.renderers.EditButtonRenderer" />
		</components1:columns>
	</components1:LabelDataGrid>
	
	<lab:ProcessOrder id="id_ProcessOrder" width="100%" height="10%" creationComplete="id_ProcessOrder_creationCompleteHandler(event)" />
</s:SkinnableContainer>
