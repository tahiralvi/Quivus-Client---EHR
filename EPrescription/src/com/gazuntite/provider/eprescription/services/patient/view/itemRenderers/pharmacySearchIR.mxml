<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="true">
	
	<s:HGroup width="100%" paddingLeft="5" paddingBottom="2" paddingRight="2" paddingTop="2">				
		
		<s:HGroup gap="4">			
			<s:Label text="NCPDPID: " width="50" fontFamily="Calibri" color="#666666" />
			<s:Label text="{data.NCPDPID}" fontFamily="Calibri" color="#333333"/>
		</s:HGroup>
		<s:Spacer width="10" />
		<s:HGroup gap="4">
			<s:Label text="Name: " width="50" fontFamily="Calibri" color="#666666" />
			<s:Label text="{data.StoreName}" fontFamily="Calibri" color="#333333"/>
		</s:HGroup>
		
	</s:HGroup>
</s:ItemRenderer>
