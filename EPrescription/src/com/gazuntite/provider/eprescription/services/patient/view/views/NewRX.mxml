				<components1:LabelTextInput id="id_duration" prompt="Duration" width="100%" restrict="[0-9]" maxChars="3" editable="false"
										   paddingLeft="3" paddingTop="5" paddingRight="3" paddingBottom="3"  toolTip="Duration" text=""/>
				<s:HGroup width="75%" verticalAlign="middle">						
					<components1:LabelTextInput id="id_refills" prompt="#Refills" width="70%"   restrict="[0-9]" maxChars="2" toolTip="Refills" />
					<s:CheckBox id="id_chk_PRN" label="PRN" selected="false" width="30%" change="id_chk_PRN_clickHandler(event)" toolTip="PRN" />
				</s:HGroup>
			</s:HGroup>
			<s:HGroup width="100%">
				<components1:LabelComboBox id="id_substitution" prompt="Substitution" width="100%"   toolTip="Substitution" />
				<components1:LabelComboBox id="id_type" prompt="Type" width="75%"  required="true" toolTip="Type">
					<components:dataProvider>
						<s:ArrayList>
							<fx:Object label="OTC" data="OTC"/>
							<fx:Object label="History" data="History"/>	
						</s:ArrayList>
					</components:dataProvider>
				</components1:LabelComboBox>
			</s:HGroup>
			<s:HGroup width="100%" verticalAlign="middle">
				<components1:LabelComboBox id="id_associatedVisit" prompt="Select Associated Visit" required="true" width="100%"   labelField="VisitDate" 										  
										  toolTip="Associated Visit"  />
				<!--<s:Button  id="id_btnVisit" label="Create Visit" width="100" buttonMode="true" toolTip="" click="id_btnVisit_clickHandler(event)" 
				skinClass="com.zigron.provider.eprescription.services.patient.view.skins.buttonSkins.favoritePharmaciesLinkBtn"/>-->
				<s:CheckBox id="id_chkNAVisit" label="N/A Visit" click="id_chkNAVisit_clickHandler(event)" toolTip="N/A Visit"/>
				<s:CheckBox id="id_chkCreateVisit" label="Create New Visit" click="id_chkCreateVisit_clickHandler(event)" toolTip="Create New Visit"/>
				<s:Label text="Active" fontFamily="Calibri" color="#333333" />
				<s:HGroup gap="0">						
					<s:RadioButton id="id_isActiveBtn" styleName="yesRadioButtonSkin"  buttonMode="true" toolTip="Active" group="{id_Active}"/>
					<s:RadioButton id="id_isInActiveBtn" styleName="noRadioButtonSkin" buttonMode="true" toolTip="Inactive" group="{id_Active}"/>
				</s:HGroup>
			</s:HGroup>
			<s:Spacer height="8" />
			<s:HGroup width="100%">
				<s:VGroup width="100%" horizontalAlign="left">
					<s:Button  id="id_btnSIG" label="Generate SIG" width="100" buttonMode="true" toolTip="Generate SIG" click="id_btnSIG_clickHandler(event)" 
							   skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.favoritePharmaciesLinkBtn"/>
					<components1:LabelTextArea id="id_sig" height="70" width="100%" prompt="SIG" maxChars="140"  restrict="[A-Z a-z 0-9]" toolTip="SIG"/>
				</s:VGroup>  
			</s:HGroup>
			<s:Spacer height="8" />
			<s:HGroup width="100%" horizontalAlign="left" gap="3" verticalAlign="middle">
				<s:Button id="id_sendBtn"  
						  label="Send" styleName="blackButtonSkin" width="60" buttonMode="true" toolTip="Send" click="sendBtn_clickHandler(event)" enabled="{id_rbPrescription.selected}"/>
				<s:Button id="id_saveBtn" 
						  label="Save" styleName="blackButtonSkin" width="60" buttonMode="true" toolTip="Save" click="saveBtn_clickHandler(event)" enabled="{id_rbPrescription.selected}"/>
				<s:Button label="Print" 
						  styleName="blackButtonSkin" width="60" buttonMode="true" toolTip="Print" visible="false" enabled="{id_rbPrescription.selected}"/>
				<s:Button label="Fax" 
						  styleName="blackButtonSkin" width="60" buttonMode="true" toolTip="Fax" visible="false" enabled="{id_rbPrescription.selected}"/>
				<s:Spacer width="100%" />
				<s:Button id="id_addChronicBtn" 
						  label="Add Chronic" styleName="addMoreToggleButtonSkin" buttonMode="true" toolTip="Add to Chronic Medication" width="90" 
						  click="addChronicBtn_clickHandler(event)" enabled="{id_rbChronicMedication.selected}"/> 
			</s:HGroup>
		</s:SkinnableContainer>
	</s:HGroup>
</s:Group>
