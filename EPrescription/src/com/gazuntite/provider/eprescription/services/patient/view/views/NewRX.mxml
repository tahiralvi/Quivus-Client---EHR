			public function VisitCreated(response:XML):void
			{
				//trace("visit created ");
				//trace(response.toXMLString() );
				encounterId = response;
				
				if(encounterId == "0")
				{
					var alert:Alert = Alert.show("Unable to create visit", "Alert", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						
					});
					return;
				}
				
				AssignSummary(true, true, encounterId);	// encounterId for New visit
			}
			//Tahir Alvi -  on Create new visit Visit change handler
			protected function id_chkCreateVisit_clickHandler(event:MouseEvent):void
			{
				if(id_chkCreateVisit.selected)
				{
					id_associatedVisit.enabled = false;
					id_chkNAVisit.selected     = false;
				}
				else
				{
					id_associatedVisit.enabled = true;
				}
			}
			//Tahir Alvi -  on N/A Visit change handler
			protected function id_chkNAVisit_clickHandler(event:MouseEvent):void
			{
				if(id_chkNAVisit.selected)
				{
					id_associatedVisit.enabled = false;
					id_chkCreateVisit.selected = false;
				}
				else
				{
					id_associatedVisit.enabled = true;
				}
			}
			//radio button change handler
			protected function id_rbChangeHandler(event:Event):void
			{
				var rb:RadioButton = event.currentTarget as RadioButton;
				
				if(rb.label == 'Prescription') // on selection of Prescription radio button
				{
					setFormAsPrescription();
				}
				else							// on selection of Chronic Medication radio button
				{
					setFormAsChronicMedication();
				}
			}
			private function setFormAsPrescription():void
			{
				id_dose.required 			= true;
				id_dosageForm.required 		= true;
				id_dosageForm.prompt 		= 'Dosage Form';
				id_quantity.required    	= true;
				id_quantityForm.required    = true;
				id_quantityForm.prompt    	= 'Quantity Form';
				id_frequency.required    	= true;
				id_frequency.prompt    		= 'Frequency';
				id_route.required    		= true;
				id_route.prompt    			= 'Route';
				id_refills.required    		= true;
				id_substitution.required    = true;
				id_substitution.prompt      = 'Substitution';
				id_type.required			= true;
			}
			private function setFormAsChronicMedication():void
			{
				id_dose.required 			= false;
				id_dosageForm.required 		= false;
				id_dosageForm.prompt 		= 'Dosage Form';
				id_quantity.required    	= false;
				id_quantityForm.required    = false;
				id_quantityForm.prompt    	= 'Quantity Form';
				id_frequency.required    	= false;
				id_frequency.prompt    		= 'Frequency';
				id_route.required    		= false;
				id_route.prompt    			= 'Route';
				id_refills.required    		= false;
				id_substitution.required    = false;
				id_substitution.prompt      = 'Substitution';
			}
			/**	Tahir Alvi - 28 Sep, 2012
			 * Medication section > When Medicine name, Generic Name, NDC and Strength are 
			 * populated> As soon as any of the first three fields is Edited (Remove, add or 
			 * change a few characters/digits), the other three should be cleared automatically; 
			 * should be populated with data matching with the edited values, if exists.
			 * */
			protected function id_medicine_changeHandler(event:TextOperationEvent):void
			{
				if((id_medicine.text.length > 0 && (isCycle1Start || isCycle2Start || isCycle3Start)) ||(id_genericName.text.length > 0 && (isCycle1Start || isCycle2Start || isCycle3Start)) || (id_ndc.text.length > 0 && (isCycle1Start || isCycle2Start || isCycle3Start)))
					clearMedicineSection();
			}
			private function clearMedicineSection():void
			{
				isCycle1Start 				= false;
				isCycle2Start				= false;
				isCycle3Start				= false;
				id_medicine.text 			= '';
				id_genericName.text		 	= '';
				id_ndc.text					= '';
				if(id_strength.dataProvider)
					id_strength.dataProvider.removeAll();
			}
			
			// get NDC name and gen name according to Strength
			protected function id_strength_changeHandler(event:IndexChangeEvent):void
			{
				if(id_strength.selectedItem != null)
				{
					isCycle1Start = true;
					getNDCField(id_strength.selectedItem.STRENGTH_ID, id_genericName.text, '0', '0');
					id_medicine.text = '';
					id_ndc.text		 = '';
				}
			}
			
		]]>
