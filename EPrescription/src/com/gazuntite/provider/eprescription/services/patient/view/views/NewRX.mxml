			//GetNDCByDRUGIDProductID/{StrengthID}/{GENPRODUCT_ID}/{NDC}/{DrugID}
			public function getNDCField(strengthID:String = '0', ProductId:String="0", _ndc:String="0", drugId:String="0"):void
			{
				var getNDCByDRUGIDProductIDEvent: GetNDCByDRUGIDProductIDEvent = new GetNDCByDRUGIDProductIDEvent(strengthID, ProductId, _ndc, drugId, function(response:XML):void
				{
					medArrayCol = new ArrayCollection();
					for(var i:int=0; i<response.NDC.length(); i++)
					{
						var FORMATTED_NDC:String 	= response.NDC[i].@FORMATTED_NDC.toString();
						var NDC:String 				= response.NDC[i].@NDC.toString();					
						
						medArrayCol.addItem({ FORMATTED_NDC:FORMATTED_NDC, NDC:NDC});
						id_ndc.text = NDC;
						
						if(isCycle1Start && i==0)// cycle 1
						{
							PopulateMedicineField('0','0','0', NDC);// cycle 1 last call and complete hirarchey
							isCycle1Start = false;
						}
						
						if(isCycle3Start && i==0)// cycle 3
						{
							PopulateProductGenericField('0','0', NDC);// cycle 3 impl
						}
						
						break; // select top 1
					} 			
				}
				);				
				getNDCByDRUGIDProductIDEvent.data = securityHeaderXML; 				
				CairngormEventDispatcher.getInstance().dispatchEvent(getNDCByDRUGIDProductIDEvent);	
			}
			//GetProductByDrugID/{DrugID}/{productGenName}/{NDC}
			public function PopulateProductGenericField(drugId:String="0", medicineName:String="0", ndc:String="0"):void
			{
				var GENPRODUCT_ID:String;
				var medicineProductSearchEvent: GetProductByDrugIDEvent = new GetProductByDrugIDEvent(drugId, medicineName, ndc,  function(response:XML):void
				{
					for(var i:uint=0; i<response.Product.length(); i++)
					{
						var GenericName:String 	= response.Product[i].@GenericName.toString();
						GENPRODUCT_ID 			= response.Product[i].@GENPRODUCT_ID.toString();					
						csa_code 				= response.Product[i].@CSA_CODE.toString();
						
						if(csa_code == "1" || csa_code == "2")
						{
							var alert:Alert = Alert.show("This medication contains controlled substance", "Alert", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void
							{
								
								if(chk1 && chk5)
									checkPrescriberServiceLevels = true;
								else
									checkPrescriberServiceLevels = false;
							});
						}
						
						//prodArrayCol.addItem({ GenericName:GenericName, GENPRODUCT_ID:GENPRODUCT_ID});
						id_genericName.text = GenericName;
						
						if(isCycle2Start && i == 0) //cycle 2 impl
						{
							PopulateMedicineField('0','0','0',ndc);
						}
						
						if(isCycle3Start && i == 0) //cycle 3 impl
						{
							GetMedStrength('0',ndc);
						}
					}
				});
				medicineProductSearchEvent.data = securityHeaderXML; 				
				CairngormEventDispatcher.getInstance().dispatchEvent(medicineProductSearchEvent); 				
			}
			
