					if (!toSetFocus)
						toSetFocus = id_medicine;					
				} 
				
				/* if (id_ndc.text.length == 0)
				{
				success = false;
				errorStr += "NDC code is must \n";	
				//id_ndc.setFocus();
				if (!toSetFocus)
				toSetFocus = id_ndc;
				} */
				
				if(!id_chk_PRN.selected)
				{
					if (id_refills.text.length == 0)
					{
						id_refills.text = "0";
						/* success = false;
						errorStr += "Please enter refills \n";	
						id_refills.setFocus(); */
					}
				}
				
				if(! (id_type.selectedItem ))
				{
					success = false;
					errorStr += "Please Select Type \n";	
					if (!toSetFocus)
						toSetFocus = id_type;
				} 
				//Tahir Alvi - Select at least one type of visit before submit - associate/new visit/ NA visit 
				if(!id_chkCreateVisit.selected && !id_chkNAVisit.selected)
				{
					if(! (id_associatedVisit.selectedItem ))
					{
						success = false;
						errorStr += "Please Select Associated Visit \n";	
						
						if (!toSetFocus)
							toSetFocus = id_associatedVisit;
					}
				}
				
				if(success == false)
				{
					var alert:Alert = Alert.show(errorStr, "Required Fields", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						if (toSetFocus)
							toSetFocus.setFocus();
					});
					//PopUpManager.centerPopUp (alert);
				}
				return success;
			}
			
			protected function addChronicBtn_clickHandler(event:MouseEvent):void
			{
				if(!ValidateAddChronic() )
				{
					return;
				}
				//Tahir Alvi - select at least one type of visit
				if(!id_associatedVisit.selectedItem && id_chkCreateVisit.selected == false && id_chkNAVisit.selected == false)
				{
					var alert:Alert = Alert.show("Please Select an associate Visit, N/A visit or create new one", "Required Fields", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						id_associatedVisit.setFocus();
					});
					return;
				}
				
				if(id_chkCreateVisit.selected && id_chkCreateVisit.label == 'Create New Visit')
				{
					//	trace(createVisitXML() );
					var getStaticLists: CreateVisitEvent = new CreateVisitEvent(patient_ID, VisitCreated);				
					getStaticLists.data = createVisitXML(); 				
					CairngormEventDispatcher.getInstance().dispatchEvent(getStaticLists);
				}
				else if (id_chkCreateVisit.selected && id_chkCreateVisit.label == 'This Visit')
				{
					AssignSummary(false, true, thisVisitID.toString())
				}
				else if(id_chkNAVisit.selected)
				{
					AssignSummary(false, true, '-1');	
				}
				else
				{
					AssignSummary(false, true);	
				}
			}
			
