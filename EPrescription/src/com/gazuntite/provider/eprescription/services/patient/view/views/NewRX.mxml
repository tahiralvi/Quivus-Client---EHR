			public function ValidateNEWRX():Boolean
			{
				var success:Boolean = new Boolean();
				var errorStr:String = new String();
				success = true;	
				
				var toSetFocus:Object;
				if (id_PatientName.text.length == 0)
				{
					success = false;
					errorStr += "Please select patient \n";
					
					if (!toSetFocus)
						toSetFocus = id_patientSearchView;
					//id_patientSearchView.setFocus();
				}
				if (id_PharmacyName.text.length == 0)
				{
					success = false;
					errorStr += "Please select pharmacy \n";	
					if (!toSetFocus)
						toSetFocus = id_pharmacy;
				}
				
				if (id_medicine.text.length == 0)
				{
					success = false;
					errorStr += "Please select medicine \n";	
					if (!toSetFocus)
						toSetFocus = id_medicine;					
				} 
				
				if(! (id_strength.selectedItem))
				{
					success = false;
					errorStr += "Please Select Strength \n";
					if (!toSetFocus)
						toSetFocus = id_strength;
					
				} 
				
				if (id_ndc.text.length == 0)
				{
					success = false;
					errorStr += "NDC code is must \n";	
					//id_ndc.setFocus();
					if (!toSetFocus)
						toSetFocus = id_ndc;
				}
				
				if (id_dose.text.length == 0 || id_dose.text == '0' || id_dose.text == '00'|| id_dose.text == '000')
				{
					success = false;
					errorStr += "Please enter dose \n";	
					//id_dose.setFocus();
					
					if (!toSetFocus)
						toSetFocus = id_dose;
				}
				/* if (parseInt(id_dose.text) > 18)
				{
				success = false;
				errorStr += "Maximum dose cannot exceed 18 \n";	
				
				if (!toSetFocus)
				toSetFocus = id_dose;
				} */
				
				if(! (id_dosageForm.selectedItem))
				{
					success = false;
					errorStr += "Please Select Dosage Form \n";
					//id_dosageForm.setFocus();
					if (!toSetFocus)
						toSetFocus = id_dosageForm;
					
				}
				if (id_quantity.text.length == 0)
				{
					success = false;
					errorStr += "Please enter quantity \n";	
					//id_quantity.setFocus();
					if (!toSetFocus)
						toSetFocus = id_quantity;
				}
				if(! (id_quantityForm.selectedItem ))
				{
					success = false;
					errorStr += "Please Select Quantity Form \n";	
					//id_quantityForm.setFocus();
					if (!toSetFocus)
						toSetFocus = id_quantityForm;
				}
				if(! (id_frequency.selectedItem ))
				{
					success = false;
					errorStr += "Please Select Frequency \n";	
					//id_frequency.setFocus();
					if (!toSetFocus)
						toSetFocus = id_frequency;
				}
				if(! (id_route.selectedItem ))
				{
					success = false;
					errorStr += "Please Select Route \n";	
					//id_route.setFocus();
					if (!toSetFocus)
						toSetFocus = id_route;
				}
				
				if(!id_chk_PRN.selected)
				{
					if (id_refills.text.length == 0)
					{
						id_refills.text = "0";
						/* success = false;
						errorStr += "Please enter refills \n";	
						id_refills.setFocus(); */
					}
				}
				if(! (id_substitution.selectedItem ))
				{
					success = false;
					errorStr += "Please Select Substitution \n";	
					//id_substitution.setFocus();
					if (!toSetFocus)
						toSetFocus = id_substitution;
				}
				
				/* 	if(! (id_type.selectedItem ))
				{
				success = false;
				errorStr += "Please Select Type \n";	
				id_type.setFocus();
				} */
				
				if(!id_chkCreateVisit.selected && !id_chkNAVisit.selected)
				{
					if(! (id_associatedVisit.selectedItem ))
					{
						success = false;
						errorStr += "Please Select Associated Visit \n";	
						//id_associatedVisit.setFocus();
						if (!toSetFocus)
							toSetFocus = id_associatedVisit;
					}
				}
				
				if (id_sig.text.length == 0)
				{
					success = false;
					errorStr += "Please enter SIG \n";	
					//id_quantity.setFocus();
					if (!toSetFocus)
						toSetFocus = id_sig;
				}
				
				if(success == false)
				{
					var alert:Alert = Alert.show(errorStr, "Required Fields", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						if (toSetFocus)
							toSetFocus.setFocus();
					});
					
					//PopUpManager.centerPopUp (alert);
				}
				return success;
			}
			
			protected function id_frequency_changeHandler(event:IndexChangeEvent):void
			{
				calculateDuration();
			}
			
			public function calculateDuration():void
			{
				if(id_dose.text.length != 0 && id_quantity.text.length != 0)
				{
					var dose:int 		= parseInt(id_dose.text);
					var quantity:int 	= parseInt(id_quantity.text);
					var duration:Number;
					var eachday:Number;
					var freq:Number;
					
					if(id_frequency.selectedItem.Abbreviation == "TID")
					{
						freq = 3;
					}
					else if(id_frequency.selectedItem.Abbreviation == "3X/W")
					{
						freq = 3/7;
					}
					else if(id_frequency.selectedItem.Abbreviation == "QID")
					{
						freq = 4;
					}
					else if(id_frequency.selectedItem.Abbreviation == "5X/D")
					{
						freq = 5;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q18H")
					{
						freq = 24/18;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q36H")
					{
						freq = 24/36;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q48H")
					{
						freq = 24/48;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q72H")
					{
						freq = 24/72;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q7D")
					{
						freq = 1/7;
					}
					else if(id_frequency.selectedItem.Abbreviation == "every other day")
					{
						freq = 0.5;
					}
					else if(id_frequency.selectedItem.Abbreviation == "once a day")
					{
						freq = 1;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q1MO")
					{
						freq = 1/30;
					}
					else if(id_frequency.selectedItem.Abbreviation == "1X/W")
					{
						freq = 1/7;
					}
					else if(id_frequency.selectedItem.Abbreviation == "BID")
					{
						freq = 2;
					}
					else if(id_frequency.selectedItem.Abbreviation == "2X/W")
					{
						freq = 2/7;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q15MIN")
					{
						freq = 60*24 / 15;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q1H")
					{
						freq = 24;
					}
					else if(id_frequency.selectedItem.Abbreviation == "10X/D") //10 times a day
					{
						freq = 10;
					}
					else if(id_frequency.selectedItem.Abbreviation == "12X/D")
					{
						freq = 12;
					}
					else if(id_frequency.selectedItem.Abbreviation == "16X/D")
					{
						freq = 16;
					}
					else if(id_frequency.selectedItem.Abbreviation == "6X/D")
					{
						freq = 6;
					}
					else if(id_frequency.selectedItem.Abbreviation == "7X/D")
					{
						freq = 7;
					}
					else if(id_frequency.selectedItem.Abbreviation == "8X/D")
					{
						freq = 8;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q16H") //every 16 hours
					{
						freq = 24/16;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q2W") //every 2 weeks
					{
						freq = 1/14;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q30MIN") //every 30 minutes
					{
						freq = 60*24 / 30;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q40H") //every 40 hours
					{
						freq = 24 / 40;
					}
					else if(id_frequency.selectedItem.Abbreviation == "QY") //yearly
					{
						freq = 1/365;
					}
					else if(id_frequency.selectedItem.Abbreviation == "9X/D")
					{
						freq = 9;
					}
					else if(id_frequency.selectedItem.Abbreviation == "9X/D")
					{
						freq = 9;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q3W")
					{
						freq = 1/21;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q5D")
					{
						freq = 1/5;
					}
					else if(id_frequency.selectedItem.Abbreviation == "Q60H")
					{
						freq = 24 / 60;
					}
					else
					{
						freq = 1;
					}
					
					eachday = dose * freq;
					duration = quantity/eachday;
					duration = Math.round(duration);
					id_duration.text = duration.toString();
				}
			}
			
