				{
					var selectedPatient:PatientDTO 	= event.selection as PatientDTO;
					fName = selectedPatient.FirstName ? selectedPatient.FirstName :"";
					mName = selectedPatient.MiddleName? selectedPatient.MiddleName:"";
					lName = selectedPatient.LastName  ? selectedPatient.LastName  :"";
