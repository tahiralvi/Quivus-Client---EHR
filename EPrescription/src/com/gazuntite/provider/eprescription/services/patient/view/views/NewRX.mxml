			//--Tahir Alvi ----------  load data from Quivus Client (Set View Mode and data for QI)-------------------------------
			public function loadSelectedPatientData(patientDto:PatientDTO, _thisVisitID:int):void
			{
				model.patientGaxenID			= '';
				gaxenPatiendId					= '';
				thisVisitID 					= _thisVisitID;
				var selectedPatient:PatientDTO 	= patientDto;
				fName 							= selectedPatient.FirstName ? selectedPatient.FirstName :"";
				mName 							= selectedPatient.MiddleName? selectedPatient.MiddleName:"";
				lName 							= selectedPatient.LastName  ? selectedPatient.LastName  :"";
				gaxenPatiendId 					= selectedPatient.GAXENID;
				patient_ID 						= selectedPatient.ID.toString();
				id_medicationBG.enabled 		= true;
				id_pharmacySearchBG.enabled 	= true;
				
				//Load patient Visits
				var loadPatientVisitsEvent: LoadPatientVisitsEvent = new LoadPatientVisitsEvent(selectedPatient.ID.toString(), clinicBranchID, VisitsLoaded);				
				CairngormEventDispatcher.getInstance().dispatchEvent(loadPatientVisitsEvent);
				
				var patientAddressEvent: GetAddressBookByPartyRegGuidEvent = new GetAddressBookByPartyRegGuidEvent(selectedPatient.RecGuid, function(response:XML):void
				{
					for(var i:uint = 0; i<response.AddressDTOlist.length(); i++)
					{
						id_address.text = response.AddressDTOlist.AddressDTO.StreetName + ", " + response.AddressDTOlist.AddressDTO.CityName + ", " + response.AddressDTOlist.AddressDTO.StateName;
						id_address.toolTip = id_address.text;
					}
					id_phone.text = ValidationUtils.setPhoneNumberMasking(response.PhoneDTOlist.PhoneDTO[0].PhoneNumber);
					id_phone.toolTip = id_phone.text;
				});				
				CairngormEventDispatcher.getInstance().dispatchEvent(patientAddressEvent);
				
				id_PatientName.text 			= fName + " " + mName + " " + lName;
				id_PatientName.toolTip  		= id_PatientName.text;
				//patientID 					= selectedPatient.ID;
				patientID 						= selectedPatient.UserID;
				id_quivusId.text 				= selectedPatient.QuivusID;	
				id_quivusId.toolTip 			= selectedPatient.QuivusID;	
				id_dob.toolTip 					= AppUtils.formatDate(selectedPatient.DOB);					
				id_dob.text 					= AppUtils.formatDate(selectedPatient.DOB);					
				id_gender.text 					= selectedPatient.Gender;
				id_gender.toolTip 				= selectedPatient.Gender;
				
				if(id_PharmacyName.text != "")
					id_addPharmacyBtn.enabled = true;
				
				//reset patient search field
				id_patientSearchView.id_textInput.text = "";
				
				//GET Patient INsurance.....
				var rpEvent : LoadPatientInsuancePatientIdEvent = new LoadPatientInsuancePatientIdEvent(patientID.toString(), InsuranceLoaded);				
				CairngormEventDispatcher.getInstance().dispatchEvent( rpEvent );
				
				//----select Prescription or Medication view according to View----
				id_rbChronicMedication.visible 			= false;
				id_rbPrescription.visible 				= false;
				
				if(isMedicationMode)
				{
					setFormAsChronicMedication();
					id_saveBtn.visible    					= false;
					id_sendBtn.visible    					= false;
					id_addChronicBtn.enabled				= true;
					
				}
				else if(isPrescriptionMode)
				{
					setFormAsPrescription();
					id_saveBtn.visible    					= false;
					id_saveBtn.includeInLayout				= false;
					id_sendBtn.enabled    					= true;
					id_addChronicBtn.visible				= false;
				}
				
				id_chkCreateVisit.label = 'This Visit';
				id_chkNAVisit.label		= 'N/A';
			}
			// ----- Visit load call back function ------------------
			public function VisitsLoaded(response:XML):void
			{
				var response:XML = AppUtils.removeDefaultNamespaceFromXML(response);
				visitArray.removeAll();
				
				if(id_associatedVisit.dataProvider)//Tahir Alvi - takle exception on null
					id_associatedVisit.dataProvider.removeAll();
				
				for(var i:uint=0; i<response.Visits.PatientVisitDTO.length(); i++)
				{
					var VisitDateLbl:String = AppUtils.formatDate(response.Visits.PatientVisitDTO[i].VisitDate.toString());
					var VisitDate:String = response.Visits.PatientVisitDTO[i].VisitDate.toString();
					var VisitID:String = response.Visits.PatientVisitDTO[i].VisitID.toString();
					//trace(VisitDate);
					visitArray.addItem({VisitDate:VisitDate, VisitID:VisitID, VisitDateLbl:VisitDateLbl});
				}
				id_associatedVisit.dataProvider = visitArray;
				id_associatedVisit.labelField = "VisitDateLbl";
			}
			// Insurance load call back handler
			public function InsuranceLoaded(response:XML):void
			{
				insuranceCol = new ArrayCollection();
				
				for(var i:uint = 0; i < response.PatientInsuranceList.PatientInsuranceDTO.length(); i++)
				{
					var fp_obj:Object = new Object();
					fp_obj.PayerID 				= response.PatientInsuranceList.PatientInsuranceDTO[i].InsuranceOrganization.InsuranceOrganizationID.toString();
					fp_obj.PayerName			= response.PatientInsuranceList.PatientInsuranceDTO[i].InsuranceOrganization.InsuranceOrganizationName.toString();
					fp_obj.CardholderID 		= response.PatientInsuranceList.PatientInsuranceDTO[i].PolicyNumber.toString();
					fp_obj.CardholderLastName 	= response.PatientInsuranceList.PatientInsuranceDTO[i].InsuredPersonName.toString();
					fp_obj.GroupID 				= response.PatientInsuranceList.PatientInsuranceDTO[i].GroupNumber.toString();
					
					//<Insurance PayerID="" PayerName="" CardholderID=""  CardholderLastName="" GroupID=""/>
					var InsuranceXML:XML 				= <Insurance />
					InsuranceXML.@PayerID				= fp_obj.PayerID;
					InsuranceXML.@PayerName				= fp_obj.PayerName;
					InsuranceXML.@CardholderID			= fp_obj.CardholderID;
					InsuranceXML.@CardholderLastName	= fp_obj.CardholderLastName;
					InsuranceXML.@GroupID				= fp_obj.GroupID;
					
					InsurancesXML.appendChild(InsuranceXML);
					insuranceCol.addItem(fp_obj);
				}
			}
			// pharmacy search button click handler 
			protected function pharmacy_clickHandler(event:MouseEvent):void
			{
				var pharmacyname:String = id_pharmacy.text;
				
				if(pharmacyname == "")
				{
					pharmacyname = "0";
				}
				
				if(!pharmacySearch)
				{
					pharmacySearch = new pharmacySearchPopup();
				}
				
				pharmacySearch.addEventListener("SelectButtonClicked", selectPharmacy);
				
				var pLoc:Point = new Point( this.x , this.y );
				var loc:Point = this.localToGlobal( pLoc );
				pharmacySearch.x = loc.x ; 
				pharmacySearch.y = loc.y ;			
				
				pharmacySearch.ncpdid 	= pharmacyname;
				pharmacySearch.inSearchPopup 	= true;
				
				pharmacySearch.ShowPopup(this);
				pharmacySearch.id_pharmacySearch.ti_npcid.text = pharmacyname;
				pharmacySearch.id_pharmacySearch.searchPharmacy();
				//reset pharmacy search field
				id_pharmacy.text = "";
			}
			//  Select pharmacy list item click handler
			public function selectPharmacy(event:Event):void
			{
				if(pharmacySearch.id_pharmacySearch._Phone == "")
				{
					var alert:Alert = Alert.show("This Pharmacy does not have phone number, please select Other Pharmacy", "Alert", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
						id_PharmacyName.text 		= "";
						id_NPCDID.text 				= "";
						id_pharmacyAddress.text 	= "";
						id_pharmacyPhone.text		= "";
						return;
					});
					return;
				}
				
				var servicelevels:int = parseInt(pharmacySearch.id_pharmacySearch._ServiceLevel);
				if(servicelevels % 2 != 1)
				{
					var alert2:Alert = Alert.show("This Pharmacy does not allow NewRX", "Alert", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
