<?xml version="1.0" encoding="utf-8"?>
<components1:PopupGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:extended="com.adobe.Quivus.view.controls.extended.*" 
		 xmlns:components="com.gazuntite.controls.extended.components.*" 
		 creationComplete="popupgroup1_creationCompleteHandler(event)"
		 xmlns:components1="com.gazuntite.controls.extended.components.*" >
	<fx:Metadata>
	 	[Event(name="PharmacySelectedEvent", type="com.gazuntite.provider.eprescription.services.patient.view.events.PharmacySelectedEvent")] 
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			import com.gazuntite.provider.eprescription.services.patient.view.events.PharmacySelectedEvent;
			
			protected function id_SearchList_clickHandler(event:MouseEvent):void
			{
				// TODO Auto-generated method stub
				if( event.target is spark.components.Button )
				{
					event.stopImmediatePropagation();
					return;
				}
				
				var evt:PharmacySelectedEvent = new PharmacySelectedEvent( PharmacySelectedEvent.PHARMACY_SELECTED);
				this.dispatchEvent( evt );
				closeHandler(); 
			}
			public function closeHandler( event:MouseEvent = null ):void
			{
				//this.removePopup();
				var e:CloseEvent = new CloseEvent( "closeSearchBox", true );
				dispatchEvent( e );
			}

			protected function popupgroup1_creationCompleteHandler(event:FlexEvent):void
			{
				FlexGlobals.topLevelApplication.addEventListener(MouseEvent.MOUSE_DOWN, function(event:MouseEvent):void
				{
					closeHandler()
				});
			}

		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
		
	<components:layout>
		<s:VerticalLayout gap="0" paddingBottom="0" paddingLeft="0" paddingTop="-7" verticalAlign="top" horizontalAlign="center" />
	</components:layout>
	

	<s:SkinnableContainer id="id_listBorder" width="100%" minWidth="250" height="100%" 
						      styleName="greyishWhiteBGContainerSkin">
		

		<s:layout>
			<s:HorizontalLayout gap="0" paddingTop="2" paddingLeft="2" paddingRight="2"
								paddingBottom="0" verticalAlign="top" horizontalAlign="left" />
		</s:layout>
		
		
		<s:List id="id_SearchList"  width="100%" height="100%" minHeight="125" minWidth="180" 
				 itemRenderer="com.gazuntite.provider.eprescription.services.patient.view.itemRenderers.pharmacySearchIR"	
				 click="id_SearchList_clickHandler(event)"
				 styleName="whiteListBoxBlueScrollerSkin"
				/>
		<!--dataProvider="{model.SearchPatientResults.Patients}" 
		click="id_SearchList_clickHandler(event)" 
		creationComplete="id_SearchList_creationCompleteHandler(event)"
		itemRenderer="com.zigron.provider.search.services.patient.view.search.itemRenderer.PatientSearchListRenderer" -->
	</s:SkinnableContainer>
	<s:Button id="id_CloseBtn" styleName="closeButtonSkin"
			  click="closeHandler(event)" buttonMode="true" useHandCursor="true" toolTip="Close Patient Search" />
</components1:PopupGroup>
